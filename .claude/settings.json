{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre_commit_lint.py",
            "if": "Bash(*git *)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre_push_test.py",
            "if": "Bash(*git *)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre_pr_draft.py",
            "if": "Bash(*gh *)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre_pr_review.py",
            "if": "Bash(*gh *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post_commit_review.py",
            "if": "Bash(*git *)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post_pr_create_changelog.py",
            "if": "Bash(*gh *)"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git -c 'user.name=Claude \\(Opus\\)' -c user.email=noreply@anthropic.com -c commit.gpgsign=false commit -q -m ' *)"
    ]
  }
}
