use miden::core::mem
use miden::core::word
use miden::core::crypto::hashes::eidos

use {WORD_NUM_ELEMENTS, DOUBLE_WORD_NUM_ELEMENTS} from miden::protocol_utils::constants

# ERRORS
# =================================================================================================

const ERR_MEM_NUM_WORDS_NOT_U32 = "number of words to pipe to memory must be a u32"

const ERR_MEM_WORDS_NOT_STRICTLY_SORTED = "words must be strictly sorted in ascending order"

# PUBLIC PROCEDURES
# =================================================================================================

#! Writes `num_elements` elements from the advice stack to memory starting at `dest_ptr` and returns
#! their commitment.
#!
#! The elements committed to are an arbitrary-length list, so their count need not be
#! word-aligned. For efficiency, the commitment is computed using `pipe_double_words_to_memory`,
#! which requires that the elements must already be on the advice stack and that they are padded to
#! the next double-word boundary (e.g. via `adv.push_mapvaln.8`). The exact logical length is bound
#! into the Eidos chaining word, so these zeros only fill unused lanes of the final double word.
#!
#! Inputs:
#!   Operand stack: [num_elements, dest_ptr]
#!   Advice stack:  [[ELEMENTS]]
#! Outputs:
#!   Operand stack: [COMPUTED_COMMITMENT]
#!
#! Where:
#! - num_elements is the number of elements to write, matching the number of committed elements.
#!   It must be a valid u32. The caller must check this precondition.
#! - dest_ptr is the memory pointer at which the elements are written.
#! - COMPUTED_COMMITMENT is the commitment over the written elements.
#!
#! Invocation: exec
pub proc pipe_elements_preimage_to_memory(num_elements: u32, dest_ptr: ptr<felt>) -> word
    dup eq.0
    if.true
        exec.eidos::empty_felt_sequence_digest
        # => [COMPUTED_COMMITMENT, num_elements, dest_ptr]

        movup.4 drop movup.4 drop
        # => [COMPUTED_COMMITMENT]
    else
        dup u32lte.DOUBLE_WORD_NUM_ELEMENTS
        if.true
            # a short preimage occupies exactly one padded advice double word
            exec.eidos::init
            # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, dest_ptr]

            adv_pipe exec.eidos::compress
            exec.eidos::digest
            movup.4 drop
            # => [COMPUTED_COMMITMENT]
        else
            # round the physical range up to a complete double word
            dup u32divmod.DOUBLE_WORD_NUM_ELEMENTS neq.0 add mul.DOUBLE_WORD_NUM_ELEMENTS
            # => [padded_num_elements, num_elements, dest_ptr]

            # compute end_ptr = dest_ptr + padded_num_elements
            dup.2 add
            # => [end_ptr, num_elements, dest_ptr]

            movup.2
            # => [dest_ptr, end_ptr, num_elements]

            # Initialize Eidos with the exact logical length.
            movup.2 exec.eidos::init
            # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, dest_ptr, end_ptr]

            # write the elements to memory while hashing them
            exec.mem::pipe_double_words_to_memory
            # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, dest_ptr']

            # extract the computed commitment from the hasher state
            exec.eidos::digest
            # => [COMPUTED_COMMITMENT, dest_ptr']

            movup.4 drop
            # => [COMPUTED_COMMITMENT]
        end
    end
end

#! Writes `num_words` words from the advice stack to memory starting at `write_ptr` and returns
#! their commitment, while it asserts that the words are unique and sorted.
#!
#! The words are sorted in ascending order as defined by `word::lt`. The commitment is equal to
#! the sequential Eidos hash of the words, which makes it compatible with commitments over sorted
#! lists of words, e.g. `MastForest::interface_commitment`.
#!
#! The words on the advice stack must be padded with a zero word to an even number of words, e.g.
#! via `adv.push_mapvaln.8`. The padding word is written to memory at `end_ptr`, but it is not part
#! of the commitment. An empty sequence needs no advice.
#!
#! Inputs:
#!   Operand stack: [num_words, write_ptr]
#!   Advice stack:  [WORD_0, ..., WORD_n, PADDING]
#! Outputs:
#!   Operand stack: [COMMITMENT, end_ptr]
#!
#! Where:
#! - num_words is the number of words to write.
#! - write_ptr is the word-aligned memory address at which the words are written.
#! - COMMITMENT is the commitment over the written words.
#! - end_ptr is the memory address immediately after the written words.
#!
#! Panics if:
#! - num_words is not a u32.
#! - the words are not unique and sorted in ascending order.
#!
#! Invocation: exec
pub proc pipe_strictly_sorted_words_to_memory(
    num_words: u32,
    write_ptr: ptr<word>
) -> (word, ptr<word>)
    u32assert.err=ERR_MEM_NUM_WORDS_NOT_U32
    # => [num_words, write_ptr]

    mul.WORD_NUM_ELEMENTS
    # => [num_elements, write_ptr]

    dup.1 dup.1 add
    # => [end_ptr, num_elements, write_ptr]

    dup.2 movdn.3 movdn.2
    # => [num_elements, write_ptr, end_ptr, start_ptr]

    # initialize Eidos with the number of elements of all words
    dup eq.0 swap exec.eidos::init
    # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, is_empty, write_ptr, end_ptr, start_ptr]

    movup.12
    if.true
        # Eidos hashes an empty sequence with one compression of the zero block
        exec.eidos::compress
    end
    # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, write_ptr, end_ptr, start_ptr]

    # the loop runs while there are unwritten words, so that a final word is hashed together with
    # its zero padding
    dup.12 dup.14 u32lt
    # => [should_loop, BLOCK_LO, BLOCK_HI, CHAINING_WORD, write_ptr, end_ptr, start_ptr]

    while.true
        adv_pipe
        # => [WORD_0, WORD_1, CHAINING_WORD, write_ptr', end_ptr, start_ptr]

        # WORD_1 is a word (and not padding) if write_ptr' - 4 < end_ptr
        dup.12 sub.WORD_NUM_ELEMENTS dup.14 u32lt
        # => [has_word_1, WORD_0, WORD_1, CHAINING_WORD, write_ptr', end_ptr, start_ptr]

        if.true
            # assert WORD_0 < WORD_1
            dupw dupw.2 exec.word::lt assert.err=ERR_MEM_WORDS_NOT_STRICTLY_SORTED
        end
        # => [WORD_0, WORD_1, CHAINING_WORD, write_ptr', end_ptr, start_ptr]

        # WORD_0 has a previous word if start_ptr != write_ptr' - 8
        dup.12 sub.DOUBLE_WORD_NUM_ELEMENTS dup.15 neq
        # => [has_previous_word, WORD_0, WORD_1, CHAINING_WORD, write_ptr', end_ptr, start_ptr]

        if.true
            # the previous word is located before WORD_0, which is located at write_ptr' - 8
            dup.12 sub.12 exec.assert_previous_word_lower
            # => [WORD_0, WORD_1, CHAINING_WORD, write_ptr', end_ptr, start_ptr]
        end

        exec.eidos::compress
        # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, write_ptr', end_ptr, start_ptr]

        dup.12 dup.14 u32lt
        # => [should_loop, BLOCK_LO, BLOCK_HI, CHAINING_WORD, write_ptr', end_ptr, start_ptr]
    end
    # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, write_ptr, end_ptr, start_ptr]

    exec.eidos::digest
    # => [COMMITMENT, write_ptr, end_ptr, start_ptr]

    movup.4 drop movup.5 drop
    # => [COMMITMENT, end_ptr]
end

#! Writes `num_pairs` (KEY, VALUE) pairs from the advice stack to memory starting at `write_ptr`
#! and returns their commitment, while it asserts that the keys are unique and sorted.
#!
#! The keys must be unique and sorted in ascending order as defined by `word::lt`. The values are
#! not checked. The commitment is equal to the sequential Eidos hash of the words of all pairs.
#!
#! Inputs:
#!   Operand stack: [num_pairs, write_ptr]
#!   Advice stack:  [KEY_0, VALUE_0, ..., KEY_n, VALUE_n]
#! Outputs:
#!   Operand stack: [COMMITMENT, end_ptr]
#!
#! Where:
#! - num_pairs is the number of key-value pairs to write.
#! - write_ptr is the word-aligned memory address at which the pairs are written.
#! - COMMITMENT is the commitment over the written pairs.
#! - end_ptr is the memory address immediately after the written pairs.
#!
#! Panics if:
#! - num_pairs is not a u32.
#! - the keys are not unique and sorted in ascending order.
#!
#! Invocation: exec
pub proc pipe_strictly_sorted_key_value_pairs_to_memory(
    num_pairs: u32,
    write_ptr: ptr<word>
) -> (word, ptr<word>)
    u32assert.err=ERR_MEM_NUM_WORDS_NOT_U32
    # => [num_pairs, write_ptr]

    mul.DOUBLE_WORD_NUM_ELEMENTS
    # => [num_elements, write_ptr]

    dup dup.2 add
    # => [end_ptr, num_elements, write_ptr]

    dup.2 movdn.3 movdn.2
    # => [num_elements, write_ptr, end_ptr, start_ptr]

    # initialize Eidos with the number of elements of all pairs
    dup eq.0 swap exec.eidos::init
    # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, is_empty, write_ptr, end_ptr, start_ptr]

    movup.12
    if.true
        # Eidos hashes an empty sequence with one compression of the zero block
        exec.eidos::compress
    end
    # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, write_ptr, end_ptr, start_ptr]

    dup.13 dup.13 neq
    # => [should_loop, BLOCK_LO, BLOCK_HI, CHAINING_WORD, write_ptr, end_ptr, start_ptr]

    while.true
        adv_pipe
        # => [KEY, VALUE, CHAINING_WORD, write_ptr', end_ptr, start_ptr]

        # KEY has a previous key if start_ptr != write_ptr - 8
        dup.12 sub.DOUBLE_WORD_NUM_ELEMENTS dup.15 neq
        # => [has_previous_key, KEY, VALUE, CHAINING_WORD, write_ptr', end_ptr, start_ptr]

        if.true
            # the previous key is located one pair before KEY, which is located at
            # write_ptr' - 8
            dup.12 sub.16 exec.assert_previous_word_lower
            # => [KEY, VALUE, CHAINING_WORD, write_ptr', end_ptr, start_ptr]
        end

        exec.eidos::compress
        # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, write_ptr', end_ptr, start_ptr]

        dup.13 dup.13 neq
        # => [should_loop, BLOCK_LO, BLOCK_HI, CHAINING_WORD, write_ptr', end_ptr, start_ptr]
    end
    # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, end_ptr, end_ptr, start_ptr]

    exec.eidos::digest
    # => [COMMITMENT, end_ptr, end_ptr, start_ptr]

    movup.5 drop movup.5 drop
    # => [COMMITMENT, end_ptr]
end

# HELPER PROCEDURES
# =================================================================================================

#! Asserts that the word at previous_ptr is lower than WORD.
#!
#! Inputs:  [previous_ptr, WORD]
#! Outputs: [WORD]
#!
#! Where:
#! - previous_ptr is the memory address of the previous word.
#! - WORD is the word that must be greater than the previous word.
#!
#! Panics if:
#! - the previous word is not lower than WORD.
proc assert_previous_word_lower(previous_ptr: ptr<word>, current_word: word) -> word
    padw movup.4 mem_loadw_le
    # => [PREVIOUS_WORD, WORD]

    dupw.1 exec.word::lt assert.err=ERR_MEM_WORDS_NOT_STRICTLY_SORTED
    # => [WORD]
end
