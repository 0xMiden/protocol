use miden::core::mem
use miden::core::crypto::hashes::eidos

#! Writes `num_elements` elements from the advice stack to memory starting at `dest_ptr` and returns
#! their commitment.
#!
#! The elements committed to are an arbitrary-length list, so their count need not be
#! word-aligned. For efficiency, the commitment is computed using `pipe_double_words_to_memory`,
#! which requires that the elements must already be on the advice stack and that they are padded to
#! the next multiple of 8 (e.g. via `adv.push_mapvaln.8`). The exact logical length is bound into
#! the Eidos chaining word, so these zeros only fill unused lanes of the final physical block.
#!
#! Inputs:
#!   Operand stack: [num_elements, dest_ptr]
#!   Advice stack:  [[ELEMENTS]]
#! Outputs:
#!   Operand stack: [COMPUTED_COMMITMENT]
#!
#! Where:
#! - num_elements is the number of elements to write, matching the number of committed elements.
#! - dest_ptr is the memory pointer at which the elements are written.
#! - COMPUTED_COMMITMENT is the commitment over the written elements.
#!
#! Invocation: exec
pub proc pipe_elements_preimage_to_memory(num_elements: u32, dest_ptr: ptr<felt>) -> word
    dup eq.0
    if.true
        drop drop
        exec.eidos::empty_felt_sequence_digest
        # => [COMPUTED_COMMITMENT]
    else
        dup u32lt.9
        if.true
            # A short preimage occupies exactly one padded advice block.
            exec.eidos::init
            # => [BLOCK_LO, BLOCK_HI, CV, dest_ptr]

            adv_pipe compress
            exec.eidos::digest
            movup.4 drop
            # => [COMPUTED_COMMITMENT]
        else
            # Round the physical range up to a complete 8-Felt block.
            dup u32divmod.8 neq.0 add mul.8
            # => [padded_num_elements, num_elements, dest_ptr]

            # compute end_ptr = dest_ptr + padded_num_elements
            dup.2 add
            # => [end_ptr, num_elements, dest_ptr]

            movup.2
            # => [dest_ptr, end_ptr, num_elements]

            # Initialize Eidos with the exact logical length.
            movup.2 exec.eidos::init
            # => [BLOCK_LO, BLOCK_HI, CV, dest_ptr, end_ptr]

            # write the elements to memory while hashing them
            exec.mem::pipe_double_words_to_memory
            # => [BLOCK_LO, BLOCK_HI, CV, dest_ptr']

            # extract the computed commitment from the hasher state
            exec.eidos::digest
            # => [COMPUTED_COMMITMENT, dest_ptr']

            movup.4 drop
            # => [COMPUTED_COMMITMENT]
        end
    end
end
