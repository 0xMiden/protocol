use {
    Bool,
    NoteMetadata,
    NoteRecipient,
    NoteScriptRoot,
    NoteStorageCommitment,
    NoteType,
} from miden::protocol_utils::types
use miden::core::crypto::hashes::poseidon2

# ERRORS
# =================================================================================================

const ERR_NOTE_METADATA_UNSUPPORTED_VERSION = "note metadata has an unsupported version"

const ERR_NOTE_METADATA_NON_ZERO_RESERVED_BIT = "note metadata has a non-zero reserved bit"

const ERR_NOTE_INVALID_RECIPIENT_PREIMAGE =
    "recipient preimage in the advice map does not hash to the note recipient"

# CONSTANTS
# =================================================================================================

# The maximum number of storage values associated with a single note.
pub const MAX_NOTE_STORAGE_ITEMS = 1024

#! Version 1 of the note metadata encoding.
pub const NOTE_METADATA_VERSION_1 = 1

#! The mask for the version bits in the first felt of the note metadata.
const NOTE_METADATA_VERSION_MASK = 0x3f # 0b0011_1111

#! The mask for the reserved bit in the first felt of the note metadata.
const NOTE_METADATA_RESERVED_BIT_MASK = 0x80 # 0b1000_0000

# Note type constants. These encode the note type in the lower byte of the metadata.
# See NoteType in the Rust protocol crate for details.

#! The note type of private notes.
pub const NOTE_TYPE_PRIVATE = 0

#! The note type of public notes.
pub const NOTE_TYPE_PUBLIC = 1

#! The maximum attachment scheme value.
pub const MAX_ATTACHMENT_SCHEME = 65534

#! The maximum number of words in an attachment.
pub const MAX_ATTACHMENT_WORDS = 256

#! The maximum total number of words across all attachments in a note.
pub const MAX_ATTACHMENT_TOTAL_WORDS = 512

#! The reserved value to signal a `None` note attachment scheme.
pub const ATTACHMENT_SCHEME_NONE = 1

# PROCEDURES
# =================================================================================================

#! Extracts the version from the provided metadata.
#!
#! Inputs:  [METADATA]
#! Outputs: [version]
#!
#! Where:
#! - METADATA is the metadata of a note.
#! - version is the version of the note metadata encoding.
pub proc metadata_into_version(metadata: NoteMetadata) -> u8
    movdn.3 drop drop drop
    # => [sender_id_suffix_type_version]

    u32split swap drop
    # => [lo32]

    u32and.NOTE_METADATA_VERSION_MASK
    # => [version]
end

#! Extracts the note type from the provided metadata.
#!
#! The note type is encoded as a single bit at the 6th position from the right side (LSB) of the
#! first felt of the metadata, where 0 = Private and 1 = Public.
#!
#! Inputs:  [METADATA]
#! Outputs: [note_type]
#!
#! Where:
#! - METADATA is the metadata of a note, laid out on the stack as
#!   [sender_id_suffix_type_version, sender_id_prefix, tag, attachment_schemes].
#!   The first felt (sender_id_suffix_type_version) has the following bit layout:
#!   [sender_id_suffix (56 bits) | reserved (1 bit) | note_type (1 bit) | version (6 bits)]
#! - note_type is the type of the note (0 for private, 1 for public).
#!
#! Invocation: exec
pub proc metadata_into_note_type(metadata: NoteMetadata) -> NoteType
    movdn.3 drop drop drop
    # => [sender_id_suffix_type_version]

    u32split swap drop
    # => [lo32]

    u32shr.6
    # => [shifted]

    u32and.1
    # => [note_type]
end

#! Extracts the reserved bit from the provided metadata.
#!
#! Inputs:  [METADATA]
#! Outputs: [reserved_bit]
#!
#! Where:
#! - METADATA is the metadata of a note.
#! - reserved_bit is 1 if the reserved bit is set, 0 otherwise.
proc metadata_into_reserved_bit(metadata: NoteMetadata) -> Bool
    movdn.3 drop drop drop
    # => [sender_id_suffix_type_version]

    u32split swap drop
    # => [lo32]

    u32and.NOTE_METADATA_RESERVED_BIT_MASK neq.0
    # => [reserved_bit]
end

#! Validates that note metadata is well formed and consumes it.
#!
#! WARNING: This procedure should not be exposed to or called from user code (e.g. miden::protocol
#! or miden::standards) as this would make the calling code only accept note metadata version 1.
#!
#! Inputs:  [METADATA]
#! Outputs: []
#!
#! Where:
#! - METADATA is the metadata of a note.
#!
#! Panics if:
#! - the metadata encodes an unknown version.
#! - the metadata has its reserved bit set.
pub proc validate_metadata(metadata: NoteMetadata)
    # the version defines how the rest of the metadata is decoded, so assert it first
    dupw exec.metadata_into_version
    # => [version, METADATA]

    eq.NOTE_METADATA_VERSION_1 assert.err=ERR_NOTE_METADATA_UNSUPPORTED_VERSION
    # => [METADATA]

    exec.metadata_into_reserved_bit
    # => [reserved_bit]

    assertz.err=ERR_NOTE_METADATA_NON_ZERO_RESERVED_BIT
    # => []
end

#! Returns the script root and storage commitment of a note from the preimage of its recipient in
#! the advice map.
#!
#! The preimage is always present for input notes. For output notes, it is present for public notes
#! and for notes whose recipient was computed with `note::compute_and_store_recipient`.
#!
#! Inputs:
#!   Operand stack: [RECIPIENT]
#!   Advice map: {
#!     RECIPIENT: [SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT],
#!     SERIAL_SCRIPT_COMMITMENT: [SERIAL_COMMITMENT, SCRIPT_ROOT],
#!   }
#! Outputs:
#!   Operand stack: [SCRIPT_ROOT, STORAGE_COMMITMENT]
#!
#! Where:
#! - RECIPIENT is the recipient of the note.
#! - SCRIPT_ROOT is the script root of the note.
#! - STORAGE_COMMITMENT is the commitment to the storage of the note.
#!
#! Panics if:
#! - the advice map does not contain the preimage of the recipient.
#! - the preimage in the advice map does not hash to the recipient.
#!
#! Invocation: exec
pub proc get_recipient_preimage(
    recipient: NoteRecipient
) -> (NoteScriptRoot, NoteStorageCommitment)
    adv.push_mapval padw adv_loadw padw adv_loadw
    # => [STORAGE_COMMITMENT, SERIAL_SCRIPT_COMMITMENT, RECIPIENT]

    swapw dupw.1 dupw.1 exec.poseidon2::merge
    # => [RECOMPUTED_RECIPIENT, SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT, RECIPIENT]

    movupw.3 assert_eqw.err=ERR_NOTE_INVALID_RECIPIENT_PREIMAGE
    # => [SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT]

    adv.push_mapval padw adv_loadw padw adv_loadw
    # => [SCRIPT_ROOT, SERIAL_COMMITMENT, SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT]

    dupw movdnw.3 swapw
    # => [SERIAL_COMMITMENT, SCRIPT_ROOT, SERIAL_SCRIPT_COMMITMENT, SCRIPT_ROOT, STORAGE_COMMITMENT]

    exec.poseidon2::merge
    assert_eqw.err=ERR_NOTE_INVALID_RECIPIENT_PREIMAGE
    # => [SCRIPT_ROOT, STORAGE_COMMITMENT]
end
