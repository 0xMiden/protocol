use {
    Bool,
    NoteAttachmentCount,
    NoteAttachmentListCommitment,
    NoteMetadata,
    NoteRecipient,
    NoteScriptRoot,
    NoteSerialNumber,
    NoteStorageCommitment,
    NoteType,
} from miden::protocol_utils::types
use {WORD_NUM_ELEMENTS} from miden::protocol_utils::constants
use miden::core::crypto::hashes::eidos
use miden::core::mem

# ERRORS
# =================================================================================================

const ERR_NOTE_METADATA_UNSUPPORTED_VERSION = "note metadata has an unsupported version"

const ERR_NOTE_METADATA_NON_ZERO_RESERVED_BIT = "note metadata has a non-zero reserved bit"

const ERR_NOTE_RECIPIENT_PREIMAGE_MISMATCH =
    "recipient preimage in the advice map does not hash to the note recipient"

const ERR_NOTE_ATTACHMENT_LIST_LENGTH_MISMATCH =
    "attachment list in the advice map does not match its number of attachments"

# CONSTANTS
# =================================================================================================

# The maximum number of storage values associated with a single note.
pub const MAX_NOTE_STORAGE_ITEMS = 1024

#! Version 1 of the note metadata encoding.
pub const NOTE_METADATA_VERSION_1 = 1

#! The mask for the version bits in the first felt of the note metadata.
const NOTE_METADATA_VERSION_MASK = 0x3f # 0b0011_1111

#! The mask for the reserved bit in the first felt of the note metadata.
const NOTE_METADATA_RESERVED_BIT_MASK = 0x80 # 0b1000_0000

# Note type constants. These encode the note type in the lower byte of the metadata.
# See NoteType in the Rust protocol crate for details.

#! The note type of private notes.
pub const NOTE_TYPE_PRIVATE = 0

#! The note type of public notes.
pub const NOTE_TYPE_PUBLIC = 1

#! The maximum attachment scheme value.
pub const MAX_ATTACHMENT_SCHEME = 65534

#! The maximum number of words in an attachment.
pub const MAX_ATTACHMENT_WORDS = 256

#! The maximum total number of words across all attachments in a note.
pub const MAX_ATTACHMENT_TOTAL_WORDS = 512

#! The maximum number of attachments per note.
pub const MAX_ATTACHMENTS_PER_NOTE = 4

#! The attachment scheme value that is reserved to represent an absent attachment.
pub const ATTACHMENT_RESERVED_SCHEME = 0

#! The number of elements of an attachment list entry: the attachment scheme padded to a word,
#! followed by the attachment commitment.
pub const ATTACHMENT_LIST_ENTRY_SIZE = 8

#! The reserved value to signal a `None` note attachment scheme.
pub const ATTACHMENT_SCHEME_NONE = 1

# PROCEDURES
# =================================================================================================

#! Extracts the version from the provided metadata.
#!
#! Inputs:  [METADATA]
#! Outputs: [version]
#!
#! Where:
#! - METADATA is the metadata of a note.
#! - version is the version of the note metadata encoding.
pub proc metadata_into_version(metadata: NoteMetadata) -> u8
    movdn.3 drop drop drop
    # => [sender_id_suffix_type_version]

    u32split swap drop
    # => [lo32]

    u32and.NOTE_METADATA_VERSION_MASK
    # => [version]
end

#! Extracts the note type from the provided metadata.
#!
#! The note type is encoded as a single bit at the 6th position from the right side (LSB) of the
#! first felt of the metadata, where 0 = Private and 1 = Public.
#!
#! Inputs:  [METADATA]
#! Outputs: [note_type]
#!
#! Where:
#! - METADATA is the metadata of a note, laid out on the stack as
#!   [sender_id_suffix_type_version, sender_id_prefix, tag, attachment_schemes].
#!   The first felt (sender_id_suffix_type_version) has the following bit layout:
#!   [sender_id_suffix (56 bits) | reserved (1 bit) | note_type (1 bit) | version (6 bits)]
#! - note_type is the type of the note (0 for private, 1 for public).
#!
#! Invocation: exec
pub proc metadata_into_note_type(metadata: NoteMetadata) -> NoteType
    movdn.3 drop drop drop
    # => [sender_id_suffix_type_version]

    u32split swap drop
    # => [lo32]

    u32shr.6
    # => [shifted]

    u32and.1
    # => [note_type]
end

#! Extracts the reserved bit from the provided metadata.
#!
#! Inputs:  [METADATA]
#! Outputs: [reserved_bit]
#!
#! Where:
#! - METADATA is the metadata of a note.
#! - reserved_bit is 1 if the reserved bit is set, 0 otherwise.
proc metadata_into_reserved_bit(metadata: NoteMetadata) -> Bool
    movdn.3 drop drop drop
    # => [sender_id_suffix_type_version]

    u32split swap drop
    # => [lo32]

    u32and.NOTE_METADATA_RESERVED_BIT_MASK neq.0
    # => [reserved_bit]
end

#! Validates that note metadata is well formed and consumes it.
#!
#! WARNING: This procedure should not be exposed to or called from user code (e.g. miden::protocol
#! or miden::standards) as this would make the calling code only accept note metadata version 1.
#!
#! Inputs:  [METADATA]
#! Outputs: []
#!
#! Where:
#! - METADATA is the metadata of a note.
#!
#! Panics if:
#! - the metadata encodes an unknown version.
#! - the metadata has its reserved bit set.
pub proc validate_metadata(metadata: NoteMetadata)
    # the version defines how the rest of the metadata is decoded, so assert it first
    dupw exec.metadata_into_version
    # => [version, METADATA]

    eq.NOTE_METADATA_VERSION_1 assert.err=ERR_NOTE_METADATA_UNSUPPORTED_VERSION
    # => [METADATA]

    exec.metadata_into_reserved_bit
    # => [reserved_bit]

    assertz.err=ERR_NOTE_METADATA_NON_ZERO_RESERVED_BIT
    # => []
end

#! Recovers a note's serial number, script root and storage commitment from the given recipient
#! via the advice provider.
#!
#! Requires the recipient preimage in the advice provider. Always present for input notes and
#! must be present for public output notes.
#!
#! Inputs:  [RECIPIENT]
#! Outputs: [SERIAL_NUM, NOTE_SCRIPT_ROOT, STORAGE_COMMITMENT]
#!
#! Where:
#! - RECIPIENT is the recipient of the note for which to recover the preimage.
#! - SERIAL_NUM is the recovered note serial number.
#! - NOTE_SCRIPT_ROOT is the recovered note script root.
#! - STORAGE_COMMITMENT is the recovered note storage commitment.
#!
#! Panics if:
#! - the advice map has no preimage for the recipient (or an intermediate hash).
#! - a preimage does not hash to the commitment it claims to open, or the serial number is not
#!   padded with the empty word.
#!
#! Invocation: exec
pub proc get_recipient_preimage(
    recipient: NoteRecipient
) -> (NoteSerialNumber, NoteScriptRoot, NoteStorageCommitment)
    # push the advice map entry for RECIPIENT
    adv.push_mapval
    # OS => [RECIPIENT]
    # AS => [SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT]

    padw adv_loadw padw adv_loadw swapw
    # => [SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT, RECIPIENT]

    # re-hash the preimage and assert it reproduces RECIPIENT, keeping the preimage words
    dupw.1 dupw.1 exec.eidos::hash_double_word
    # => [RECOMPUTED_RECIPIENT, SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT, RECIPIENT]

    movupw.3 assert_eqw.err=ERR_NOTE_RECIPIENT_PREIMAGE_MISMATCH
    # => [SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT]

    # push the advice map entry for SERIAL_SCRIPT_COMMITMENT
    adv.push_mapval
    # OS => [SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT]
    # AS => [SERIAL_COMMITMENT, SCRIPT_ROOT]

    padw adv_loadw padw adv_loadw
    # => [SCRIPT_ROOT, SERIAL_COMMITMENT, SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT]

    swapw
    # => [SERIAL_COMMITMENT, SCRIPT_ROOT, SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT]

    dupw.1 dupw.1 exec.eidos::hash_double_word
    # => [RECOMPUTED_SERIAL_SCRIPT_COMMITMENT, SERIAL_COMMITMENT, SCRIPT_ROOT, SERIAL_SCRIPT_COMMITMENT, STORAGE_COMMITMENT]

    movupw.3 assert_eqw.err=ERR_NOTE_RECIPIENT_PREIMAGE_MISMATCH
    # => [SERIAL_COMMITMENT, SCRIPT_ROOT, STORAGE_COMMITMENT]

    # push the advice map entry for SERIAL_COMMITMENT
    adv.push_mapval
    # OS => [SERIAL_COMMITMENT, SCRIPT_ROOT, STORAGE_COMMITMENT]
    # AS => [SERIAL_NUM, EMPTY_WORD]

    padw adv_loadw padw adv_loadw
    # => [SERIAL_NUM_PADDING, SERIAL_NUM, SERIAL_COMMITMENT, SCRIPT_ROOT, STORAGE_COMMITMENT]

    # assert the serial number is padded with the empty word
    padw assert_eqw.err=ERR_NOTE_RECIPIENT_PREIMAGE_MISMATCH
    # => [SERIAL_NUM, SERIAL_COMMITMENT, SCRIPT_ROOT, STORAGE_COMMITMENT]

    padw dupw.1 exec.eidos::hash_double_word
    # => [RECOMPUTED_SERIAL_COMMITMENT, SERIAL_NUM, SERIAL_COMMITMENT, SCRIPT_ROOT, STORAGE_COMMITMENT]

    movupw.2 assert_eqw.err=ERR_NOTE_RECIPIENT_PREIMAGE_MISMATCH
    # => [SERIAL_NUM, SCRIPT_ROOT, STORAGE_COMMITMENT]
end

#! Writes the attachment list with the provided commitment from the advice map to memory, starting
#! at the provided address, and verifies it against the commitment.
#!
#! The list holds num_attachments entries `[attachment_scheme, 0, 0, 0, ATTACHMENT_COMMITMENT]`. The
#! caller must bound num_attachments so that the list fits into the memory at dest_ptr. The entries
#! themselves are not validated.
#!
#! Inputs:
#!   Operand stack: [num_attachments, ATTACHMENT_LIST_COMMITMENT, dest_ptr]
#!   Advice map: {
#!     ATTACHMENT_LIST_COMMITMENT: [[ATTACHMENT_LIST_ELEMENTS]],
#!   }
#! Outputs:
#!   Operand stack: [list_end_ptr]
#!
#! Where:
#! - num_attachments is the number of attachments in the list.
#! - ATTACHMENT_LIST_COMMITMENT is the commitment to the attachment list.
#! - dest_ptr is the word-aligned memory address to which the first list entry is written.
#! - list_end_ptr is the memory address after the last written list entry.
#! - ATTACHMENT_LIST_ELEMENTS are the elements of the list entries.
#!
#! Panics if:
#! - the advice map has no entry for ATTACHMENT_LIST_COMMITMENT.
#! - the number of list elements does not match num_attachments.
#! - the hash of the list elements does not match ATTACHMENT_LIST_COMMITMENT.
#!
#! Invocation: exec
pub proc pipe_attachment_list_to_memory(
    num_attachments: NoteAttachmentCount,
    attachment_list_commitment: NoteAttachmentListCommitment,
    dest_ptr: ptr<word>
) -> ptr<word>
    # push the list elements from the advice map onto the advice stack
    movdn.4 adv.push_mapvaln
    # OS => [ATTACHMENT_LIST_COMMITMENT, num_attachments, dest_ptr]
    # AS => [num_elements, [ATTACHMENT_LIST_ELEMENTS]]

    # assert the list holds an entry per attachment
    adv_push movup.5 mul.ATTACHMENT_LIST_ENTRY_SIZE dup movup.2
    assert_eq.err=ERR_NOTE_ATTACHMENT_LIST_LENGTH_MISMATCH
    # OS => [num_elements, ATTACHMENT_LIST_COMMITMENT, dest_ptr]
    # AS => [[ATTACHMENT_LIST_ELEMENTS]]

    u32div.WORD_NUM_ELEMENTS movup.5 swap
    # OS => [num_words, dest_ptr, ATTACHMENT_LIST_COMMITMENT]
    # AS => [[ATTACHMENT_LIST_ELEMENTS]]

    # write the list elements to memory and assert that they hash to ATTACHMENT_LIST_COMMITMENT
    exec.mem::pipe_double_words_preimage_to_memory
    # OS => [list_end_ptr]
    # AS => []
end
