use {BatchNoteTreeRoot, InputNotesCommitment} from miden::batch_kernel::types
use miden::core::crypto::hashes::eidos

use miden::batch_kernel::memory
use {NOTE_ENTRY_FELT_LEN, UNERASED, WORD_NUM_ELEMENTS} from miden::batch_kernel::memory

# ERRORS
# =================================================================================================

const ERR_BATCH_INPUT_NOTE_NOT_CONSUMED =
    "an input-note list entry was not consumed by any transaction"

const ERR_BATCH_OUTPUT_NOTE_NOT_CREATED =
    "an output-note list entry was not created by any transaction"

# CONSTANTS
# =================================================================================================

# Felt offset of the BLOCK_HI word within a stored Eidos hasher state.
const HASHER_BLOCK_HI_OFFSET = WORD_NUM_ELEMENTS

# Felt offset of the chaining word within a stored Eidos hasher state.
const HASHER_CV_OFFSET = 2 * WORD_NUM_ELEMENTS

# ASSERTIONS
# =================================================================================================

#! Asserts every output-note list entry was created by exactly one transaction (with the per-tx
#! binding, this proves the list is exactly the union of the per-transaction output notes, so a host
#! cannot fabricate an erasure with a note no transaction creates).
#!
#! The matching input-note check (every entry consumed exactly once) is done by
#! [`assert_all_input_notes_consumed`].
#!
#! Inputs:  []
#! Outputs: []
#!
#! Panics if:
#! - an output-note list entry was not created by any transaction.
proc assert_all_output_notes_created()
    exec.memory::get_num_output_notes
    # => [num_output_notes]

    # Iterate from num_output_notes - 1 down to 0.
    dup neq.0
    while.true
        sub.1
        # => [output_note_idx]

        dup exec.memory::get_output_note_is_created
        # => [is_created, output_note_idx]

        assert.err=ERR_BATCH_OUTPUT_NOTE_NOT_CREATED

        dup neq.0
        # => [should_loop, output_note_idx]
    end
    drop
end

# INPUT NOTES COMMITMENT
# =================================================================================================

#! Asserts every input-note list entry was consumed by exactly one transaction and returns the
#! number of entries that are not erased.
#!
#! Inputs:  []
#! Outputs: [num_unerased_input_notes]
#!
#! Panics if:
#! - an input-note list entry was not consumed by any transaction.
proc assert_all_input_notes_consumed() -> u32
    push.0 exec.memory::get_num_input_notes
    # => [num_input_notes, num_unerased_input_notes]

    # Iterate from num_input_notes - 1 down to 0.
    dup neq.0
    while.true
        sub.1
        # => [input_note_idx, num_unerased_input_notes]

        dup exec.memory::get_input_note_is_consumed
        # => [is_consumed, input_note_idx, num_unerased_input_notes]

        assert.err=ERR_BATCH_INPUT_NOTE_NOT_CONSUMED
        # => [input_note_idx, num_unerased_input_notes]

        dup exec.memory::get_input_note_erasure_state eq.UNERASED
        # => [is_unerased, input_note_idx, num_unerased_input_notes]

        movup.2 add swap
        # => [input_note_idx, num_unerased_input_notes']

        dup neq.0
        # => [should_loop, input_note_idx, num_unerased_input_notes']
    end
    drop
    # => [num_unerased_input_notes]
end

#! Returns the Eidos hasher state stored at `hasher_state_ptr`.
#!
#! Inputs:  [hasher_state_ptr]
#! Outputs: [BLOCK_LO, BLOCK_HI, CV]
proc load_hasher_state(hasher_state_ptr: ptr<eidos::State>) -> eidos::State
    padw dup.4 add.HASHER_CV_OFFSET mem_loadw_le
    # => [CV, hasher_state_ptr]

    padw dup.8 add.HASHER_BLOCK_HI_OFFSET mem_loadw_le
    # => [BLOCK_HI, CV, hasher_state_ptr]

    padw dup.12 mem_loadw_le
    # => [BLOCK_LO, BLOCK_HI, CV, hasher_state_ptr]

    movup.12 drop
end

#! Stores an Eidos hasher state at `hasher_state_ptr`.
#!
#! Inputs:  [BLOCK_LO, BLOCK_HI, CV, hasher_state_ptr]
#! Outputs: []
proc store_hasher_state(state: eidos::State, hasher_state_ptr: ptr<eidos::State>)
    movup.12
    # => [hasher_state_ptr, BLOCK_LO, BLOCK_HI, CV]

    dup movdn.5
    # => [hasher_state_ptr, BLOCK_LO, hasher_state_ptr, BLOCK_HI, CV]

    mem_storew_le dropw
    # => [hasher_state_ptr, BLOCK_HI, CV]

    dup movdn.5
    # => [hasher_state_ptr, BLOCK_HI, hasher_state_ptr, CV]

    add.HASHER_BLOCK_HI_OFFSET mem_storew_le dropw
    # => [hasher_state_ptr, CV]

    add.HASHER_CV_OFFSET mem_storew_le dropw
end

#! Absorbs input note `input_note_idx`'s 8-felt `(NULLIFIER, NOTE_ID_OR_EMPTY)` tuple into the
#! hasher state at `hasher_state_ptr` (one Eidos compression, matching `Hasher::hash_elements`).
#!
#! Both the tuple and the hasher state are passed in memory rather than on the operand stack.
#!
#! Inputs:
#!   Operand stack: [input_note_idx, hasher_state_ptr]
#!   Memory:
#!     input-note list entry `input_note_idx` |-> [NULLIFIER, NOTE_ID_OR_EMPTY]
#!     hasher_state_ptr                       |-> [BLOCK_LO, BLOCK_HI, CV]
#! Outputs:
#!   Operand stack: []
#!   Memory:
#!     hasher_state_ptr |-> [BLOCK_LO', BLOCK_HI', CV']
proc absorb_input_entry(input_note_idx: u32, hasher_state_ptr: ptr<eidos::State>)
    # The entry occupies one double word [entry_ptr, entry_ptr + NOTE_ENTRY_FELT_LEN).
    exec.memory::get_input_note_entry_ptr
    # => [entry_ptr, hasher_state_ptr]

    dup add.NOTE_ENTRY_FELT_LEN swap
    # => [entry_ptr, end_ptr, hasher_state_ptr]

    dup.2 exec.load_hasher_state
    # => [BLOCK_LO, BLOCK_HI, CV, entry_ptr, end_ptr, hasher_state_ptr]

    exec.eidos::absorb_double_words_from_memory
    # => [BLOCK_LO', BLOCK_HI', CV', end_ptr, end_ptr, hasher_state_ptr]

    movup.12 drop movup.12 drop
    # => [BLOCK_LO', BLOCK_HI', CV', hasher_state_ptr]

    exec.store_hasher_state
end

#! Absorbs input-note list entry `input_note_idx` into the batch hasher unless it was erased.
#!
#! Inputs:
#!   Operand stack: [input_note_idx, hasher_state_ptr]
#!   Memory:
#!     input-note list entry `input_note_idx` |-> [NULLIFIER, NOTE_ID_OR_EMPTY]
#!     its flag word                          |-> [erasure_state, is_consumed, 0, 0]
#!     hasher_state_ptr                       |-> [BLOCK_LO, BLOCK_HI, CV]
#! Outputs:
#!   Operand stack: [input_note_idx + 1, hasher_state_ptr]
#!   Memory:
#!     hasher_state_ptr |-> the hasher state
proc process_input_entry(
    input_note_idx: u32,
    hasher_state_ptr: ptr<eidos::State>
) -> (u32, ptr<eidos::State>)
    # Absorb the entry unless it was erased (created-and-consumed in this batch).
    dup exec.memory::get_input_note_erasure_state
    # => [erasure_state, input_note_idx, hasher_state_ptr]

    eq.UNERASED
    # => [is_unerased, input_note_idx, hasher_state_ptr]

    if.true
        dup.1 dup.1 exec.absorb_input_entry
    end
    add.1
end

#! Computes INPUT_NOTES_COMMITMENT as the sequential Eidos hash of the non-erased
#! `(NULLIFIER, NOTE_ID_OR_EMPTY)` entries of the nullifier-sorted input-note list (erased entries
#! are skipped), matching `build_input_note_commitment`.
#!
#! Eidos binds the message length into its initial chaining word, so the non-erased entries are
#! counted first, by [`assert_all_input_notes_consumed`], which also enforces the epilogue invariant
#! that every entry was consumed exactly once. With no non-erased entries this is the digest of the
#! empty felt sequence.
#!
#! The entries are read from memory; only the commitment is returned on the operand stack.
#!
#! Inputs:
#!   Operand stack: []
#!   Memory:
#!     the nullifier-sorted input-note list and its parallel flag array
#! Outputs:
#!   Operand stack: [INPUT_NOTES_COMMITMENT]
#!
#! Panics if:
#! - [`assert_all_input_notes_consumed`] fails to verify.
@locals(12) # the three words of an Eidos hasher state: BLOCK_LO, BLOCK_HI and CV.
proc compute_input_notes_commitment() -> InputNotesCommitment
    exec.assert_all_input_notes_consumed
    # => [num_unerased_input_notes]

    dup eq.0
    if.true
        drop exec.eidos::empty_felt_sequence_digest
        # => [INPUT_NOTES_COMMITMENT]
    else
        # Initialize the hasher state over the non-erased entries in this procedure's local memory.
        mul.NOTE_ENTRY_FELT_LEN exec.eidos::init
        locaddr.0 movdn.12
        # => [BLOCK_LO, BLOCK_HI, CV, hasher_state_ptr]

        exec.store_hasher_state

        exec.memory::get_num_input_notes
        locaddr.0 push.0
        # => [input_note_idx, hasher_state_ptr, num_input_notes]

        dup dup.3 neq
        # => [should_loop, input_note_idx, hasher_state_ptr, num_input_notes]

        while.true
            exec.process_input_entry
            # => [input_note_idx+1, hasher_state_ptr, num_input_notes]

            dup dup.3 neq
            # => [should_loop, input_note_idx+1, hasher_state_ptr, num_input_notes]
        end
        # => [input_note_idx, hasher_state_ptr, num_input_notes]

        drop swap drop
        # => [hasher_state_ptr]

        exec.load_hasher_state
        exec.eidos::digest
        # => [INPUT_NOTES_COMMITMENT]
    end
end

# BATCH NOTE TREE ROOT
# =================================================================================================

#! Computes the batch note tree root.
#!
#! Placeholder: returns the empty word until the batch note tree is wired up.
#!
#! Inputs:  []
#! Outputs: [BATCH_NOTE_TREE_ROOT]
#!
#! TODO: hash the batch's output notes into the batch note tree (SMT) root.
proc compute_batch_note_tree_root() -> BatchNoteTreeRoot
    padw
end

# EPILOGUE
# =================================================================================================

#! Verifies the note-tracking results and computes the batch's note commitments.
#!
#! Asserts every output-note list entry was created, then computes the input-notes commitment and
#! the batch note tree root. The per-input-entry invariant (consumed exactly once) is enforced
#! while computing the input-notes commitment.
#!
#! Inputs:  []
#! Outputs: [INPUT_NOTES_COMMITMENT, BATCH_NOTE_TREE_ROOT]
#!
#! Panics if:
#! - [`assert_all_output_notes_created`] or [`compute_input_notes_commitment`] fails to verify.
#!
#! TODO: authenticate unauthenticated, non-erased input notes against BLOCK_COMMITMENT's chain MMR.
pub proc finalize() -> (InputNotesCommitment, BatchNoteTreeRoot)
    exec.assert_all_output_notes_created
    exec.compute_batch_note_tree_root
    # => [BATCH_NOTE_TREE_ROOT]

    exec.compute_input_notes_commitment
    # => [INPUT_NOTES_COMMITMENT, BATCH_NOTE_TREE_ROOT]
end
