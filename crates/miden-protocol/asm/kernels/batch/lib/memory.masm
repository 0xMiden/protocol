# MEMORY LAYOUT
# =================================================================================================
#
# Below is the memory layout used by the batch kernel:
#
# +-------------------+-------------------------+----------------------------------------------------------------------+
# | Address range     | Constant                | Contents                                                             |
# +-------------------+-------------------------+----------------------------------------------------------------------+
# | 0                 | NUM_TRANSACTIONS_PTR    | num_transactions (1 felt).                                           |
# | 1                 | NUM_INPUT_NOTES_PTR     | number of entries in the nullifier-sorted input-note list.           |
# | 2                 | NUM_OUTPUT_NOTES_PTR    | number of entries in the note-id-sorted output-note list.            |
# | 4..8196           | TX_TUPLES_PTR           | Layer 1 piped data: `[TX_ID, account_id_suffix, account_id_prefix,   |
# |                   |                         | 0, 0]` per transaction (8 felts each, up to 1024 transactions).      |
# | 8196..24580       | TX_HEADERS_PTR          | Layer 2 piped data: `[INIT, FINAL, INPUT_NOTES_COMMITMENT,           |
# |                   |                         | OUTPUT_NOTES_COMMITMENT]` (16 felts per transaction, up to 1024).    |
# | 24580..32772      | INPUT_NOTES_PTR         | nullifier-sorted input-note list: `[NULLIFIER, NOTE_ID_OR_EMPTY]`    |
# |                   |                         | per note (8 felts each, up to 1024 notes).                           |
# | 32772..36868      | INPUT_NOTE_FLAGS_PTR    | parallel input-note flags: `[erasure_state, is_consumed, 0, 0]` per  |
# |                   |                         | note (4 felts each).                                                 |
# | 36868..45060      | OUTPUT_NOTES_PTR        | note-id-sorted output-note list: `[NOTE_ID, 0, 0, 0, 0]` per note    |
# |                   |                         | (8 felts each, up to 1024 notes).                                    |
# | 45060..49156      | OUTPUT_NOTE_FLAGS_PTR   | parallel output-note flags: `[will_be_erased, is_created,            |
# |                   |                         | erased_by_input_note_idx, 0]` per note (4 felts each).               |
#
# +-------------------+-------------------------+----------------------------------------------------------------------+

# GENERAL CONSTANTS
# =================================================================================================

# The number of felts in a word.
pub const WORD_NUM_ELEMENTS = 4

# BOOK KEEPING
# =================================================================================================

# Single-felt slot holding `num_transactions` after Layer 1 verification.
const NUM_TRANSACTIONS_PTR = 0

# NOTE LIST BOOKKEEPING
# =================================================================================================

# Single-felt slot holding the number of entries in the nullifier-sorted input-note list.
const NUM_INPUT_NOTES_PTR = 1

# Single-felt slot holding the number of entries in the note-id-sorted output-note list.
const NUM_OUTPUT_NOTES_PTR = 2

# PIPED DATA REGIONS
# =================================================================================================

# Base of the Layer 1 piped data region. Per transaction, 8 felts:
#   `[TX_ID, account_id_suffix, account_id_prefix, 0, 0]`.
pub const TX_TUPLES_PTR = 4

# Number of felts each transaction occupies in TX_TUPLES_PTR.
const TX_TUPLE_FELT_LEN = 8

# Number of words in a Layer 1 tuple (a TX_ID word plus an account-id word).
pub const TX_TUPLE_NUM_WORDS = 2

# Base of the Layer 2 piped data region. Per transaction, 16 felts:
#   `[INIT, FINAL, INPUT_NOTES_COMMITMENT, OUTPUT_NOTES_COMMITMENT]`.
# This must match the felt-sequence layout of `TransactionId::new`.
const TX_HEADERS_PTR = 8196

# Number of felts each transaction occupies in TX_HEADERS_PTR.
pub const TX_HEADER_FELT_LEN = 16

# Number of words a transaction header occupies in TX_HEADERS_PTR.
pub const TX_HEADER_NUM_WORDS = TX_HEADER_FELT_LEN / WORD_NUM_ELEMENTS

# Felt offset within a transaction header where INPUT_NOTES_COMMITMENT starts.
const TX_HEADER_INPUT_NOTES_OFFSET = 8

# Felt offset within a transaction header where OUTPUT_NOTES_COMMITMENT starts.
const TX_HEADER_OUTPUT_NOTES_OFFSET = 12

# SORTED NOTE LISTS
# =================================================================================================

# Base of the nullifier-sorted input-note list. Per note, an 8-felt sorted-array entry
#   `[NULLIFIER, NOTE_ID_OR_EMPTY]`
# where the KEY word is the nullifier (the `sorted_array` lookup key) and the VALUE word is the
# note id (for unauthenticated notes) or the empty word. The VALUE word doubles as the second half
# of the `(nullifier, note_id_or_empty)` tuple hashed into INPUT_NOTES_COMMITMENT.
pub const INPUT_NOTES_PTR = 24580

# Number of felts each note occupies in INPUT_NOTES_PTR / OUTPUT_NOTES_PTR (KEY word + VALUE word).
pub const NOTE_ENTRY_FELT_LEN = 8

# Number of words in a sorted note list entry (a KEY word plus a VALUE word).
pub const NOTE_ENTRY_NUM_WORDS = 2

# Offset of the VALUE word within a sorted note list entry.
pub const NOTE_ENTRY_VALUE_OFFSET = 4

# Base of the parallel input-note flags array. Per note, one word
#   `[erasure_state, is_consumed, 0, 0]`
# where `erasure_state` is an [`InputNoteErasureState`] and `is_consumed` is 0 or 1. Both are
# reachable only through the accessors below.
const INPUT_NOTE_FLAGS_PTR = 32772

# Number of felts each note occupies in the flag arrays (one word).
const NOTE_FLAGS_FELT_LEN = 4

# Felt offset of the `erasure_state` field within an input-note flag word.
const INPUT_NOTE_ERASURE_STATE_OFFSET = 0

# Felt offset of the `is_consumed` flag within an input-note flag word.
const INPUT_NOTE_IS_CONSUMED_OFFSET = 1

# Erasure state of an input note, i.e. whether it is created and consumed within this batch and so
# excluded from INPUT_NOTES_COMMITMENT.
#
# - `UNERASED`: the note is not created within this batch, so it stays in the commitment.
# - `ERASURE_EXPECTED`: the note id matches an output note created within this batch (its
#   "creator"), which has not been processed yet.
# - `ERASED`: the creator output note has been processed, so the note is erased.
pub enum InputNoteErasureState : u8 {
    UNERASED = 0,
    ERASURE_EXPECTED = 1,
    ERASED = 2,
}

# Base of the note-id-sorted output-note list. Per note, an 8-felt sorted-array entry
#   `[NOTE_ID, 0, 0, 0, 0]`
# where the KEY word is the note id (the `sorted_array` lookup key); the VALUE word is unused.
pub const OUTPUT_NOTES_PTR = 36868

# Base of the parallel output-note flags array. Per note, one word
#   `[will_be_erased, is_created, erased_by_input_note_idx, 0]`
# where `erased_by_input_note_idx` is only meaningful when `will_be_erased` is 1, which is why the
# two are read and written together by [`get_output_note_erasure`] / [`set_output_note_erasure`].
const OUTPUT_NOTE_FLAGS_PTR = 45060

# Felt offset of the `will_be_erased` flag within an output-note flag word.
const OUTPUT_NOTE_WILL_BE_ERASED_OFFSET = 0

# Felt offset of the `is_created` flag within an output-note flag word.
const OUTPUT_NOTE_IS_CREATED_OFFSET = 1

# Felt offset of the `erased_by_input_note_idx` field within an output-note flag word.
const OUTPUT_NOTE_ERASED_BY_OFFSET = 2

# CAPACITY LIMITS
# =================================================================================================

# Maximum number of transactions in a batch. The Layer 1/2 piped-data regions are sized to hold
# exactly this many transactions.
pub const MAX_TRANSACTIONS_PER_BATCH = 1024

# Maximum number of entries in a sorted note list and in a single transaction's note set. The
# input/output note regions and the per-transaction scratch space each hold exactly this many
# entries. Equals `MAX_INPUT_NOTES_PER_BATCH` = `MAX_OUTPUT_NOTES_PER_BATCH` in `src/constants.rs`.
pub const MAX_NOTES_PER_BATCH = 1024


# NUM TRANSACTIONS
# =================================================================================================

#! Stores `num_transactions`.
#!
#! Inputs:  [num_transactions]
#! Outputs: []
pub proc set_num_transactions
    mem_store.NUM_TRANSACTIONS_PTR
end

#! Returns `num_transactions`.
#!
#! Inputs:  []
#! Outputs: [num_transactions]
pub proc get_num_transactions
    mem_load.NUM_TRANSACTIONS_PTR
end

# TRANSACTION TUPLE / HEADER ACCESSORS
# =================================================================================================

#! Returns a pointer to transaction `tx_index`'s entry in TX_TUPLES_PTR.
#!
#! Inputs:  [tx_index]
#! Outputs: [tx_tuple_ptr]
pub proc get_tx_tuple_ptr
    mul.TX_TUPLE_FELT_LEN add.TX_TUPLES_PTR
end

#! Returns the verified `tx_id` for transaction `tx_index` (loaded from TX_TUPLES_PTR).
#!
#! Inputs:  [tx_index]
#! Outputs: [TX_ID]
pub proc get_tx_id
    exec.get_tx_tuple_ptr
    # => [tx_tuple_ptr]
    padw movup.4
    # => [PAD, tx_tuple_ptr]
    mem_loadw_le
    # => [TX_ID]
end

#! Returns a pointer to transaction `tx_index`'s entry in TX_HEADERS_PTR.
#!
#! Inputs:  [tx_index]
#! Outputs: [tx_header_ptr]
pub proc get_tx_header_ptr
    mul.TX_HEADER_FELT_LEN add.TX_HEADERS_PTR
end

#! Returns the verified per-transaction INPUT_NOTES_COMMITMENT for transaction `tx_index`.
#!
#! Inputs:  [tx_index]
#! Outputs: [INPUT_NOTES_COMMITMENT_idx]
pub proc get_tx_input_notes_commitment
    exec.get_tx_header_ptr add.TX_HEADER_INPUT_NOTES_OFFSET
    # => [input_notes_commitment_ptr]
    padw movup.4
    # => [PAD, input_notes_commitment_ptr]
    mem_loadw_le
    # => [INPUT_NOTES_COMMITMENT]
end

#! Returns the verified per-transaction OUTPUT_NOTES_COMMITMENT for transaction `tx_index`.
#!
#! Inputs:  [tx_index]
#! Outputs: [OUTPUT_NOTES_COMMITMENT_idx]
pub proc get_tx_output_notes_commitment
    exec.get_tx_header_ptr add.TX_HEADER_OUTPUT_NOTES_OFFSET
    # => [output_notes_commitment_ptr]
    padw movup.4
    # => [PAD, output_notes_commitment_ptr]
    mem_loadw_le
    # => [OUTPUT_NOTES_COMMITMENT]
end

# SORTED NOTE LIST ACCESSORS
# =================================================================================================

#! Stores the number of entries in the nullifier-sorted input-note list.
#!
#! Inputs:  [num_input_notes]
#! Outputs: []
pub proc set_num_input_notes
    mem_store.NUM_INPUT_NOTES_PTR
end

#! Returns the number of entries in the nullifier-sorted input-note list.
#!
#! Inputs:  []
#! Outputs: [num_input_notes]
pub proc get_num_input_notes
    mem_load.NUM_INPUT_NOTES_PTR
end

#! Stores the number of entries in the note-id-sorted output-note list.
#!
#! Inputs:  [num_output_notes]
#! Outputs: []
pub proc set_num_output_notes
    mem_store.NUM_OUTPUT_NOTES_PTR
end

#! Returns the number of entries in the note-id-sorted output-note list.
#!
#! Inputs:  []
#! Outputs: [num_output_notes]
pub proc get_num_output_notes
    mem_load.NUM_OUTPUT_NOTES_PTR
end

#! Returns the end pointer of the nullifier-sorted input-note list (base + num_input_notes * 8),
#! as required by `sorted_array::find_key_value`.
#!
#! Inputs:  []
#! Outputs: [input_notes_end_ptr]
pub proc get_input_notes_end_ptr
    exec.get_num_input_notes mul.NOTE_ENTRY_FELT_LEN add.INPUT_NOTES_PTR
end

#! Returns the end pointer of the note-id-sorted output-note list (base + num_output_notes * 8).
#!
#! Inputs:  []
#! Outputs: [output_notes_end_ptr]
pub proc get_output_notes_end_ptr
    exec.get_num_output_notes mul.NOTE_ENTRY_FELT_LEN add.OUTPUT_NOTES_PTR
end

#! Returns a pointer to input-note entry index in INPUT_NOTES_PTR.
#!
#! Inputs:  [input_note_idx]
#! Outputs: [input_note_ptr]
pub proc get_input_note_entry_ptr
    mul.NOTE_ENTRY_FELT_LEN add.INPUT_NOTES_PTR
end

#! Returns a pointer to output-note entry index in OUTPUT_NOTES_PTR.
#!
#! Inputs:  [output_note_idx]
#! Outputs: [output_note_ptr]
pub proc get_output_note_entry_ptr
    mul.NOTE_ENTRY_FELT_LEN add.OUTPUT_NOTES_PTR
end

#! Returns a pointer to input-note flag word index in INPUT_NOTE_FLAGS_PTR.
#!
#! Inputs:  [input_note_idx]
#! Outputs: [input_note_flags_ptr]
proc get_input_note_flags_ptr
    mul.NOTE_FLAGS_FELT_LEN add.INPUT_NOTE_FLAGS_PTR
end

#! Returns a pointer to output-note flag word index in OUTPUT_NOTE_FLAGS_PTR.
#!
#! Inputs:  [output_note_idx]
#! Outputs: [output_note_flags_ptr]
proc get_output_note_flags_ptr
    mul.NOTE_FLAGS_FELT_LEN add.OUTPUT_NOTE_FLAGS_PTR
end

# NOTE FLAG ACCESSORS
# =================================================================================================

#! Returns the [`InputNoteErasureState`] of input note `input_note_idx`.
#!
#! Inputs:  [input_note_idx]
#! Outputs: [erasure_state]
pub proc get_input_note_erasure_state
    exec.get_input_note_flags_ptr add.INPUT_NOTE_ERASURE_STATE_OFFSET
    # => [erasure_state_ptr]

    mem_load
end

#! Sets the [`InputNoteErasureState`] of input note `input_note_idx`.
#!
#! Inputs:  [input_note_idx, erasure_state]
#! Outputs: []
pub proc set_input_note_erasure_state
    exec.get_input_note_flags_ptr add.INPUT_NOTE_ERASURE_STATE_OFFSET
    # => [erasure_state_ptr, erasure_state]

    mem_store
end

#! Returns whether input note `input_note_idx` has been consumed by a transaction.
#!
#! Inputs:  [input_note_idx]
#! Outputs: [is_consumed]
pub proc get_input_note_is_consumed
    exec.get_input_note_flags_ptr add.INPUT_NOTE_IS_CONSUMED_OFFSET
    # => [is_consumed_ptr]

    mem_load
end

#! Sets whether input note `input_note_idx` has been consumed by a transaction.
#!
#! Inputs:  [input_note_idx, is_consumed]
#! Outputs: []
pub proc set_input_note_is_consumed
    exec.get_input_note_flags_ptr add.INPUT_NOTE_IS_CONSUMED_OFFSET
    # => [is_consumed_ptr, is_consumed]

    mem_store
end

#! Returns whether output note `output_note_idx` has been created by a transaction.
#!
#! Inputs:  [output_note_idx]
#! Outputs: [is_created]
pub proc get_output_note_is_created
    exec.get_output_note_flags_ptr add.OUTPUT_NOTE_IS_CREATED_OFFSET
    # => [is_created_ptr]

    mem_load
end

#! Sets whether output note `output_note_idx` has been created by a transaction.
#!
#! Inputs:  [output_note_idx, is_created]
#! Outputs: []
pub proc set_output_note_is_created
    exec.get_output_note_flags_ptr add.OUTPUT_NOTE_IS_CREATED_OFFSET
    # => [is_created_ptr, is_created]

    mem_store
end

#! Returns whether output note `output_note_idx` erases an input note, together with the index of
#! the input note it erases.
#!
#! `erased_by_input_note_idx` is only meaningful when `will_be_erased` is 1, which is why the two
#! are returned together.
#!
#! Inputs:  [output_note_idx]
#! Outputs: [will_be_erased, erased_by_input_note_idx]
pub proc get_output_note_erasure
    exec.get_output_note_flags_ptr
    # => [output_note_flags_ptr]

    dup add.OUTPUT_NOTE_ERASED_BY_OFFSET mem_load
    # => [erased_by_input_note_idx, output_note_flags_ptr]

    swap add.OUTPUT_NOTE_WILL_BE_ERASED_OFFSET mem_load
    # => [will_be_erased, erased_by_input_note_idx]
end

#! Sets whether output note `output_note_idx` erases an input note, and which input note that is.
#!
#! Inputs:  [output_note_idx, will_be_erased, erased_by_input_note_idx]
#! Outputs: []
pub proc set_output_note_erasure
    exec.get_output_note_flags_ptr
    # => [output_note_flags_ptr, will_be_erased, erased_by_input_note_idx]

    dup movdn.2
    # => [output_note_flags_ptr, will_be_erased, output_note_flags_ptr, erased_by_input_note_idx]

    add.OUTPUT_NOTE_WILL_BE_ERASED_OFFSET mem_store
    # => [output_note_flags_ptr, erased_by_input_note_idx]

    add.OUTPUT_NOTE_ERASED_BY_OFFSET mem_store
end

#! Converts a pointer to an input-note entry (as returned by `sorted_array::find_key_value`) into
#! its index `(input_note_ptr - INPUT_NOTES_PTR) / NOTE_ENTRY_FELT_LEN`.
#!
#! Inputs:  [input_note_ptr]
#! Outputs: [input_note_idx]
pub proc get_input_note_idx_from_ptr
    sub.INPUT_NOTES_PTR div.NOTE_ENTRY_FELT_LEN
end

#! Converts a pointer to an output-note entry into its index
#! `(output_note_ptr - OUTPUT_NOTES_PTR) / NOTE_ENTRY_FELT_LEN`.
#!
#! Inputs:  [output_note_ptr]
#! Outputs: [output_note_idx]
pub proc get_output_note_idx_from_ptr
    sub.OUTPUT_NOTES_PTR div.NOTE_ENTRY_FELT_LEN
end
