# CONSTANTS
# =================================================================================================

pub use {DOUBLE_WORD_NUM_ELEMENTS, MAX_ASSETS_PER_NOTE, WORD_NUM_ELEMENTS}
    from miden::protocol_utils::constants

# The maximum number of storage items associated with a single note.
pub const MAX_NOTE_STORAGE_ITEMS = 1024

# The maximum number of notes that can be consumed in a single transaction.
pub const MAX_INPUT_NOTES_PER_TX = 1024

# The size of the memory segment allocated to each note.
pub const NOTE_MEM_SIZE = 1024

# The depth of the Merkle tree used to commit to notes produced in a block.
pub const NOTE_TREE_DEPTH = 16

# The maximum number of notes that can be created in a single transaction.
pub const MAX_OUTPUT_NOTES_PER_TX = 1024

# The maximum number of procedure roots in each code patch list of a single transaction.
pub const MAX_CODE_PATCH_ROOTS = 512

# The number of field elements per account procedure data entry (procedure MAST root).
pub const ACCOUNT_PROCEDURE_DATA_LENGTH = 4

#! The number of field elements in an account header.
pub const ACCOUNT_HEADER_NUM_ELEMENTS = 4 * WORD_NUM_ELEMENTS

#! The number of field elements contributed by each note to the input notes commitment.
pub const INPUT_NOTES_COMMITMENT_NUM_BLOCK_ELEMENTS = DOUBLE_WORD_NUM_ELEMENTS

#! The number of field elements contributed by each note to the output notes commitment.
pub const OUTPUT_NOTES_COMMITMENT_NUM_BLOCK_ELEMENTS = DOUBLE_WORD_NUM_ELEMENTS

