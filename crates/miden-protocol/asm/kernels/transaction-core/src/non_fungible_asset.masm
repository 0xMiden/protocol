use miden::protocol_utils::account_id
use miden::tx_kernel_core::asset

# ERRORS
# =================================================================================================

const ERR_NON_FUNGIBLE_ASSET_ID_COMPOSITION_MUST_BE_NON_FUNGIBLE = "non-fungible asset ID's composition must be non-fungible"

const ERR_NON_FUNGIBLE_ASSET_FAUCET_IS_NOT_ORIGIN="the origin of the non-fungible asset is not this faucet"

const ERR_NON_FUNGIBLE_ASSET_CLASS_SUFFIX_MUST_MATCH_HASH0="the asset class suffix in a non-fungible asset ID must match hash0 of the asset value"

const ERR_NON_FUNGIBLE_ASSET_CLASS_PREFIX_MUST_MATCH_HASH1="the asset class prefix in a non-fungible asset ID must match hash1 of the asset value"

# PROCEDURES
# =================================================================================================

#! Validates that a non fungible asset is well formed.
#!
#! The value itself is not validated since any value is valid.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE]
#! Outputs: [ASSET_ID, ASSET_VALUE]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to validate.
#! - ASSET_VALUE is the value of the asset to validate.
#!
#! Panics if:
#! - the asset ID's account ID is not valid.
#! - the asset ID's faucet ID is not a non-fungible one.
#! - the asset class suffix of the asset ID does not match hash0 of the value.
#! - the asset class prefix of the asset ID does not match hash1 of the value.
pub proc validate
    exec.validate_id
    # => [asset_class_suffix, asset_class_prefix, faucet_id_suffix, faucet_id_prefix, hash0, hash1, hash2, hash3]

    # assert that hash0 matches asset_class_suffix and hash1 matches asset_class_prefix
    dup.4 dup.1 assert_eq.err=ERR_NON_FUNGIBLE_ASSET_CLASS_SUFFIX_MUST_MATCH_HASH0
    dup.5 dup.2 assert_eq.err=ERR_NON_FUNGIBLE_ASSET_CLASS_PREFIX_MUST_MATCH_HASH1
    # => [asset_class_suffix, asset_class_prefix, faucet_id_suffix, faucet_id_prefix, ASSET_VALUE]
end

#! Validates that a non fungible asset's ID is well formed.
#!
#! Inputs:  [ASSET_ID]
#! Outputs: [ASSET_ID]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to validate.
#!
#! Panics if:
#! - the asset ID's account ID is not valid.
#! - the asset ID's metadata is not valid.
#! - the asset ID's composition is not non-fungible.
pub proc validate_id
    exec.asset::validate_issuer
    # => [ASSET_ID]

    exec.asset::is_non_fungible_asset_id
    assert.err=ERR_NON_FUNGIBLE_ASSET_ID_COMPOSITION_MUST_BE_NON_FUNGIBLE
    # => [ASSET_ID]
end

#! Validates that a non-fungible asset is associated with the provided faucet_id.
#!
#! The value itself is not validated since any value is valid.
#!
#! Inputs:  [faucet_id_suffix, faucet_id_prefix, ASSET_ID, ASSET_VALUE]
#! Outputs: [ASSET_ID, ASSET_VALUE]
#!
#! Where:
#! - faucet_id_{suffix,prefix} are the suffix and prefix of the faucet's account ID.
#! - ASSET_ID is the asset ID of the asset to validate.
pub proc validate_origin
    movdn.9 movdn.9
    # => [ASSET_ID, ASSET_VALUE, faucet_id_suffix, faucet_id_prefix]

    # assert the non-fungible asset ID is valid
    exec.validate
    # => [ASSET_ID, ASSET_VALUE, faucet_id_suffix, faucet_id_prefix]

    # assert the origin of the asset is the faucet_id provided via the stack
    exec.asset::id_to_faucet_id
    # => [asset_faucet_id_suffix, asset_faucet_id_prefix, ASSET_ID, ASSET_VALUE, faucet_id_suffix, faucet_id_prefix]

    movup.11 movup.11
    # => [faucet_id_suffix, faucet_id_prefix, asset_faucet_id_suffix, asset_faucet_id_prefix, ASSET_ID, ASSET_VALUE]

    exec.account_id::is_equal assert.err=ERR_NON_FUNGIBLE_ASSET_FAUCET_IS_NOT_ORIGIN
    # => [ASSET_ID, ASSET_VALUE]
end
