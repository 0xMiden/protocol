# Contains procedures for the built-in fungible asset.

use miden::protocol_utils::account_id
use miden::tx_kernel_core::asset

# RE-EXPORTS
# =================================================================================================

pub use {FUNGIBLE_ASSET_MAX_AMOUNT as MAX_AMOUNT} from miden::protocol_utils::asset

# ERRORS
# =================================================================================================

const ERR_VAULT_FUNGIBLE_MAX_AMOUNT_EXCEEDED="adding the fungible asset to the vault would exceed the max amount"

const ERR_FUNGIBLE_ASSET_ID_COMPOSITION_MUST_BE_FUNGIBLE = "fungible asset ID's composition must be fungible"

const ERR_FUNGIBLE_ASSET_FAUCET_IS_NOT_ORIGIN="the origin of the fungible asset is not this faucet"

const ERR_FUNGIBLE_ASSET_AMOUNT_EXCEEDS_MAX_AMOUNT="fungible asset amount exceeds the maximum allowed amount"

const ERR_FUNGIBLE_ASSET_VALUE_MOST_SIGNIFICANT_ELEMENTS_MUST_BE_ZERO="fungible asset value elements 1, 2 and 3 must be zeros"

const ERR_FUNGIBLE_ASSET_ID_ASSET_CLASS_MUST_BE_ZERO="fungible asset ID asset class prefix and suffix must be zero"

const ERR_VAULT_FUNGIBLE_ASSET_AMOUNT_LESS_THAN_AMOUNT_TO_WITHDRAW="failed to remove the fungible asset from the vault since the amount of the asset in the vault is less than the amount to remove"

# PROCEDURES
# =================================================================================================

#! Merges two fungible assets.
#!
#! WARNING: This procedure assumes the assets have been validated.
#!
#! Inputs:  [ASSET_VALUE_0, ASSET_VALUE_1]
#! Outputs: [MERGED_ASSET_VALUE]
#!
#! Where:
#! - ASSET_VALUE_{0, 1} are the assets to merge.
#! - MERGED_ASSET_VALUE is the merged asset.
#!
#! Panics if:
#! - adding the two asset values would exceed MAX_AMOUNT.
pub proc merge
    # extract amounts from assets
    exec.asset::fungible_value_into_amount movdn.4 exec.asset::fungible_value_into_amount
    # => [amount_1, amount_0]

    # compute max_add_amount = MAX_AMOUNT - amount_0
    # this is the amount that can at most be added to amount_0 still have a valid asset
    dup push.MAX_AMOUNT dup.3 sub
    # => [max_add_amount, amount_1, amount_1, amount_0]

    # assert it is safe to add the amounts together, i.e. amount_1 <= max_add_amount
    lte assert.err=ERR_VAULT_FUNGIBLE_MAX_AMOUNT_EXCEEDED
    # => [amount_1, amount_0]

    # add the amounts
    add
    # => [merged_amount]

    # reconstruct the asset value
    push.0.0.0 movup.3
    # => [MERGED_ASSET_VALUE]
end

#! Computes ASSET_VALUE_0 - ASSET_VALUE_1 and returns the result.
#!
#! For instance, split(40, 100) returns 60. The operand order matches the `sub` instruction.
#!
#! WARNING: This procedure assumes the assets have been validated.
#!
#! Inputs:  [ASSET_VALUE_1, ASSET_VALUE_0]
#! Outputs: [NEW_ASSET_VALUE]
#!
#! Where:
#! - ASSET_VALUE_{0, 1} are the assets to split.
#! - NEW_ASSET_VALUE is the result of the split computation.
#!
#! Panics if:
#! - ASSET_VALUE_0 does not contain at least the amount of ASSET_VALUE_1.
pub proc split
    # extract amounts from assets
    exec.asset::fungible_value_into_amount movdn.4 exec.asset::fungible_value_into_amount swap
    # => [amount_1, amount_0]

    # assert amount_1 <= amount_0 so we can safely subtract
    dup dup.2
    # => [amount_0, amount_1, amount_1, amount_0]

    lte assert.err=ERR_VAULT_FUNGIBLE_ASSET_AMOUNT_LESS_THAN_AMOUNT_TO_WITHDRAW
    # => [amount_1, amount_0]

    sub
    # => [new_amount]

    # reconstruct the asset value
    push.0.0.0 movup.3
    # => [NEW_ASSET_VALUE]
end

#! Returns 1 if ASSET_VALUE_0 is less than ASSET_VALUE_1, 0 otherwise.
#!
#! WARNING: This procedure assumes the assets have been validated and that it is never called when
#! ASSET_VALUE_0 = ASSET_VALUE_1.
#!
#! Inputs:  [ASSET_VALUE_1, ASSET_VALUE_0]
#! Outputs: [is_lt]
#!
#! Where:
#! - ASSET_VALUE_{0, 1} are the assets to compare.
#! - is_lt is 1 if ASSET_VALUE_0 is less than ASSET_VALUE_1.
pub proc lt
    exec.asset::fungible_value_into_amount movdn.4 exec.asset::fungible_value_into_amount swap
    # => [amount_1, amount_0]

    lt
    # => [amount_0 < amount_1]
end

#! Validates that a fungible asset is well formed.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE]
#! Outputs: [ASSET_ID, ASSET_VALUE]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to validate.
#! - ASSET_VALUE is the value of the asset to validate.
#!
#! Panics if:
#! - the asset ID is invalid (see validate_id).
#! - the three most significant elements in the value are not 0.
#! - the amount exceeds MAX_AMOUNT.
pub proc validate
    exec.validate_id
    # => [ASSET_ID, ASSET_VALUE]

    dupw.1
    # => [ASSET_VALUE, ASSET_ID, ASSET_VALUE]

    # assuming the asset is valid, its layout is:
    # => [amount, 0, 0, 0, ASSET_ID, ASSET_VALUE]

    # assert amount <= MAX_AMOUNT
    lte.MAX_AMOUNT
    assert.err=ERR_FUNGIBLE_ASSET_AMOUNT_EXCEEDS_MAX_AMOUNT
    # => [0, 0, 0, ASSET_ID, ASSET_VALUE]

    # assert the last three elements are zeros
    eq.0 assert.err=ERR_FUNGIBLE_ASSET_VALUE_MOST_SIGNIFICANT_ELEMENTS_MUST_BE_ZERO
    eq.0 assert.err=ERR_FUNGIBLE_ASSET_VALUE_MOST_SIGNIFICANT_ELEMENTS_MUST_BE_ZERO
    eq.0 assert.err=ERR_FUNGIBLE_ASSET_VALUE_MOST_SIGNIFICANT_ELEMENTS_MUST_BE_ZERO
    # => [ASSET_ID, ASSET_VALUE]
end

#! Validates that a fungible asset ID is well formed.
#!
#! Inputs:  [ASSET_ID]
#! Outputs: [ASSET_ID]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to validate.
#!
#! Panics if:
#! - the asset ID's account ID is not valid.
#! - the asset ID's metadata is not valid.
#! - the asset ID's composition is not fungible.
pub proc validate_id
    exec.asset::validate_issuer
    # => [ASSET_ID]

    exec.asset::is_fungible_asset_id
    assert.err=ERR_FUNGIBLE_ASSET_ID_COMPOSITION_MUST_BE_FUNGIBLE
    # => [ASSET_ID]

    exec.asset::id_to_asset_class
    # => [asset_class_suffix, asset_class_prefix, ASSET_ID]

    eq.0 assert.err=ERR_FUNGIBLE_ASSET_ID_ASSET_CLASS_MUST_BE_ZERO
    eq.0 assert.err=ERR_FUNGIBLE_ASSET_ID_ASSET_CLASS_MUST_BE_ZERO
    # => [ASSET_ID]
end

#! Validates that a fungible asset is associated with the provided faucet_id.
#!
#! Inputs:  [faucet_id_suffix, faucet_id_prefix, ASSET_ID, ASSET_VALUE]
#! Outputs: [ASSET_ID, ASSET_VALUE]
#!
#! Where:
#! - faucet_id_{suffix,prefix} are the suffix and prefix of the faucet's account ID.
#! - ASSET_ID is the asset ID of the asset to validate.
#! - ASSET_VALUE is the value of the asset to validate.
pub proc validate_origin
    movdn.9 movdn.9
    # => [ASSET_ID, ASSET_VALUE, faucet_id_suffix, faucet_id_prefix]

    # assert the fungible asset ID and value are valid
    exec.validate
    # => [ASSET_ID, ASSET_VALUE, faucet_id_suffix, faucet_id_prefix]

    # assert the origin of the asset is the faucet_id provided via the stack
    exec.asset::id_to_faucet_id
    # => [asset_faucet_id_suffix, asset_faucet_id_prefix, ASSET_ID, ASSET_VALUE, faucet_id_suffix, faucet_id_prefix]

    movup.11 movup.11
    # => [faucet_id_suffix, faucet_id_prefix, asset_faucet_id_suffix, asset_faucet_id_prefix, ASSET_ID, ASSET_VALUE]

    exec.account_id::eq assert.err=ERR_FUNGIBLE_ASSET_FAUCET_IS_NOT_ORIGIN
    # => [ASSET_ID, ASSET_VALUE]
end
