use {Bool} from miden::protocol_utils::types
use {
    CodeWitnessKind,
    CodeWitnessVerificationHint,
    CREATED_PROCS_WITNESS_KIND,
    DEPENDENCIES_WITNESS_KIND,
    NEW_WITNESS_VERIFICATION_HINT,
    PRESENT_TOP_LEVEL_WITNESS_KIND,
    ProcedureRoot,
} from miden::tx_kernel_core::types
use miden::protocol_utils::account_id
use miden::tx_kernel_core::memory
use miden::tx_kernel_core::note
use {NOTE_TYPE_PUBLIC} from miden::tx_kernel_core::note
use miden::core::collections::smt
use miden::core::word

# ERRORS
# =================================================================================================

const ERR_CODE_PATCH_INVALID_HINT =
    "code patch hint must be a code witness verification hint with a u32 index"

const ERR_CODE_PATCH_HINT_INDEX_OUT_OF_BOUNDS =
    "code patch hint index must be less than the number of roots in the list"

const ERR_CODE_PATCH_HINT_ROOT_MISMATCH =
    "procedure root at the code patch hint index does not match the hinted procedure root"

const ERR_CODE_PATCH_NUM_REFERENCED_NOT_U32 = "number of referenced procedure roots must be a u32"

# EVENTS
# =================================================================================================

# Event emitted before the kernel verifies a top-level procedure root.
const CODE_BEFORE_PROC_ROOT_VERIFIED_EVENT = event("miden::protocol::code::before_proc_root_verified")

# PUBLIC PROCEDURES
# =================================================================================================

#! Verifies the top-level procedure roots that the transaction created before the auth procedure.
#!
#! These are the procedure roots of the code of a new public account and the script roots of the
#! public output notes created so far. The auth procedure must not change these, so that the code
#! patch is complete when the auth procedure executes. See `verify_top_level_root` for details.
#!
#! TODO: verify the procedures that `account::upgrade` adds (see the code tree follow-ups).
#!
#! Inputs:  []
#! Outputs: []
pub proc verify_before_auth()
    exec.verify_new_account_code
    # => []

    exec.memory::get_num_output_notes
    # => [num_output_notes]

    dup neq.0
    # => [should_loop, num_output_notes]

    while.true
        sub.1
        # => [note_idx]

        dup exec.verify_output_note
        # => [note_idx]

        dup neq.0
        # => [should_loop, note_idx]
    end

    drop
    # => []
end

#! Verifies the script root of the output note with the provided index if the note is public.
#!
#! Inputs:  [note_idx]
#! Outputs: []
#!
#! Where:
#! - note_idx is the index of the output note.
#!
#! Panics if:
#! - the recipient preimage in the advice map is invalid (see `note::get_recipient_preimage`).
#! - the verification of the script root fails (see `verify_top_level_root`).
pub proc verify_output_note(note_idx: u16)
    exec.memory::get_output_note_ptr
    # => [note_ptr]

    dup exec.memory::get_output_note_metadata
    # => [METADATA, note_ptr]

    exec.note::metadata_into_note_type eq.NOTE_TYPE_PUBLIC
    # => [is_public, note_ptr]

    if.true
        exec.memory::get_output_note_recipient
        # => [RECIPIENT]

        exec.note::get_recipient_preimage swapw dropw
        # => [SCRIPT_ROOT]

        exec.verify_top_level_root
        # => []
    else
        drop
        # => []
    end
end

# HELPER PROCEDURES
# =================================================================================================

#! Verifies the procedure roots of the native account code if the account is new and public.
#!
#! Inputs:  []
#! Outputs: []
proc verify_new_account_code()
    exec.memory::get_native_account_id drop exec.account_id::is_public
    # => [is_public]

    exec.memory::is_new_account and
    # => [is_new_public_account]

    if.true
        exec.memory::get_num_account_procedures
        # => [num_procedures]

        # the body executes at least once, which is safe because an account has at least two
        # procedures
        do
            sub.1
            # => [proc_idx]

            padw dup.4 exec.memory::get_account_procedure_ptr mem_loadw_le
            # => [PROC_ROOT, proc_idx]

            exec.verify_top_level_root
            # => [proc_idx]
        while
            dup neq.0
            # => [should_loop, proc_idx]
        end

        drop
        # => []
    end
end

#! Verifies a top-level procedure root and puts it into one of the code patch lists.
#!
#! A top-level procedure root is the script root of a public output note or a procedure root of
#! the code of a new public account. The host answers the emitted event through the advice stack.
#! It either proves that the root was verified before, or it provides the code witness of the root
#! and, if the root is absent, the procedures that its code references:
#!
#!   [index, hint]
#!   if hint requests a new witness and PROC_ROOT is absent:
#!     [num_referenced]
#!     num_referenced times: [REFERENCED_PROC_ROOT, index, hint]
#!
#! The values are listed in the order in which the kernel reads them, and index and hint are the
#! hint of the root (see `read_code_witness_verification_hint`). The witnesses are provided through
#! the merkle store and the advice map.
#!
#! The kernel cannot read MAST, so it cannot check that the host provides all referenced
#! procedures. Instead, the node checks that the code patch is complete.
#!
#! The root is put into the following list:
#! - an absent root into the CREATED_PROCS_WITNESS_KIND list.
#! - a present root into the PRESENT_TOP_LEVEL_WITNESS_KIND list, because the code patch does not
#!   need it.
#!
#! The referenced procedures are verified in the same way, but a present referenced procedure goes
#! into the DEPENDENCIES_WITNESS_KIND list (see `verify_referenced_root`).
#!
#! Inputs:  [PROC_ROOT]
#! Outputs: []
#!
#! Where:
#! - PROC_ROOT is the top-level procedure root.
#!
#! Panics if:
#! - a hint is invalid (see `read_code_witness_verification_hint` and `verify_existing_code_witness`).
#! - a code witness is invalid.
#! - a code patch list exceeds the maximum number of procedure roots.
proc verify_top_level_root(proc_root: ProcedureRoot)
    emit.CODE_BEFORE_PROC_ROOT_VERIFIED_EVENT
    exec.read_code_witness_verification_hint
    # => [hint, index, PROC_ROOT]

    dup eq.NEW_WITNESS_VERIFICATION_HINT
    # => [is_new_witness, hint, index, PROC_ROOT]

    if.true
        drop drop dupw exec.verify_witness
        # => [is_present, PROC_ROOT]

        if.true
            push.PRESENT_TOP_LEVEL_WITNESS_KIND exec.memory::append_code_patch_root
            # => []
        else
            push.CREATED_PROCS_WITNESS_KIND exec.memory::append_code_patch_root
            # => []

            exec.verify_referenced_roots
            # => []
        end
    else
        exec.verify_existing_code_witness drop dropw
        # => []
    end
end

#! Verifies the procedures that an absent top-level procedure root references.
#!
#! Inputs:
#!   Operand stack: []
#!   Advice stack: [num_referenced, [REFERENCED_PROC_ROOT, index, hint]*]
#! Outputs:
#!   Operand stack: []
#!
#! Where:
#! - num_referenced is the number of referenced procedure roots.
#! - REFERENCED_PROC_ROOT is a referenced procedure root.
#! - index and hint are the hint for the referenced procedure root (see
#!   `read_code_witness_verification_hint`).
#!
#! Panics if:
#! - num_referenced is not a u32.
#! - a hint is invalid (see `read_code_witness_verification_hint`).
#! - the verification of a referenced root fails (see `verify_referenced_root`).
proc verify_referenced_roots()
    adv_push u32assert.err=ERR_CODE_PATCH_NUM_REFERENCED_NOT_U32
    # => [num_remaining]

    dup neq.0
    # => [should_loop, num_remaining]

    while.true
        padw adv_loadw exec.read_code_witness_verification_hint
        # => [hint, index, REFERENCED_PROC_ROOT, num_remaining]

        exec.verify_referenced_root
        # => [num_remaining]

        sub.1 dup neq.0
        # => [should_loop, num_remaining - 1]
    end

    drop
    # => []
end

#! Verifies a procedure root that a created procedure references and puts it into one of the code
#! patch lists.
#!
#! The root is put into the following list:
#! - an absent root into the CREATED_PROCS_WITNESS_KIND list.
#! - a present root into the DEPENDENCIES_WITNESS_KIND list. This includes a root that is already
#!   in the PRESENT_TOP_LEVEL_WITNESS_KIND list, because the code patch must commit to it as a
#!   dependency.
#!
#! Inputs:  [hint, index, PROC_ROOT]
#! Outputs: []
#!
#! Where:
#! - hint and index are the hint for the procedure root (see
#!   `read_code_witness_verification_hint`).
#! - PROC_ROOT is the referenced procedure root.
#!
#! Panics if:
#! - the hint is invalid (see `verify_existing_code_witness`).
#! - the code witness is invalid.
#! - a code patch list exceeds the maximum number of procedure roots.
proc verify_referenced_root(
    hint: CodeWitnessVerificationHint,
    index: u32,
    proc_root: ProcedureRoot
)
    dup eq.NEW_WITNESS_VERIFICATION_HINT
    # => [is_new_witness, hint, index, PROC_ROOT]

    if.true
        drop drop dupw exec.verify_witness
        # => [is_present, PROC_ROOT]

        push.CREATED_PROCS_WITNESS_KIND push.DEPENDENCIES_WITNESS_KIND movup.2
        # => [is_present, dependencies_kind, created_procs_kind, PROC_ROOT]

        # If is_present dependencies_kind remains.
        # If !is_present created_procs_kind remains.
        cdrop
        # => [witness_kind, PROC_ROOT]

        exec.memory::append_code_patch_root
        # => []
    else
        # A root in the created procedures or dependencies list is already part of the code patch.
        # A root in the present top-level list is not and we must add the root to the dependencies,
        # so the code patch commits to it.
        exec.verify_existing_code_witness eq.PRESENT_TOP_LEVEL_WITNESS_KIND
        # => [is_present_top_level, PROC_ROOT]

        if.true
            push.DEPENDENCIES_WITNESS_KIND exec.memory::append_code_patch_root
            # => []
        else
            dropw
            # => []
        end
    end
end

#! Reads the hint for a procedure root from the advice stack.
#!
#! Inputs:
#!   Operand stack: []
#!   Advice stack: [index, hint]
#! Outputs:
#!   Operand stack: [hint, index]
#!
#! Where:
#! - hint is the verification hint of the root.
#! - index is the index of the root in the code patch list that contains it. It is unused for
#!   NEW_WITNESS_VERIFICATION_HINT. It is not bounded here, because
#!   `verify_existing_code_witness` asserts that it is less than the number of roots in the list,
#!   which is at most MAX_CODE_PATCH_ROOTS.
#!
#! Panics if:
#! - hint is not a code witness verification hint.
#! - index is not a u32.
proc read_code_witness_verification_hint() -> (CodeWitnessVerificationHint, u32)
    adv_push adv_push
    # => [hint, index]

    u32assert2.err=ERR_CODE_PATCH_INVALID_HINT
    dup u32lte.NEW_WITNESS_VERIFICATION_HINT assert.err=ERR_CODE_PATCH_INVALID_HINT
    # => [hint, index]
end

#! Verifies the code witness of a procedure root against the code tree root of the reference block.
#!
#! Inputs:  [PROC_ROOT]
#! Outputs: [is_present]
#!
#! Where:
#! - PROC_ROOT is the procedure root.
#! - is_present is 1 if the procedure root is present in the code tree, 0 otherwise.
#!
#! Panics if:
#! - the merkle store or the advice map does not contain the code witness of the root.
proc verify_witness(proc_root: ProcedureRoot) -> Bool
    exec.memory::get_code_tree_root swapw
    # => [PROC_ROOT, CODE_TREE_ROOT]

    exec.smt::get swapw dropw
    # => [VALUE]

    # the code tree only contains the empty word and the value of present procedure roots
    exec.word::eqz not
    # => [is_present]
end

#! Asserts that a procedure root is at the hinted index of a code patch list.
#!
#! The caller must make sure that hint is not NEW_WITNESS_VERIFICATION_HINT, so that the hint is
#! the kind of the code patch list that contains the root.
#!
#! Inputs:  [hint, index, PROC_ROOT]
#! Outputs: [witness_kind, PROC_ROOT]
#!
#! Where:
#! - hint is the verification hint of the root.
#! - index is the index of the root in the code patch list.
#! - PROC_ROOT is the procedure root.
#! - witness_kind is the kind of the code patch list that contains the root.
#!
#! Panics if:
#! - index is not less than the number of roots in the list.
#! - the root at the index is not PROC_ROOT.
proc verify_existing_code_witness(
    hint: CodeWitnessVerificationHint,
    index: u32,
    proc_root: ProcedureRoot
) -> (CodeWitnessKind, ProcedureRoot)
    dup exec.memory::get_code_patch_list_ptr
    # => [list_ptr, witness_kind, index, PROC_ROOT]

    dup.2 dup.1 exec.memory::get_code_patch_num_roots
    # => [num_roots, index, list_ptr, witness_kind, index, PROC_ROOT]

    # assert index < num_roots
    u32lt assert.err=ERR_CODE_PATCH_HINT_INDEX_OUT_OF_BOUNDS
    # => [list_ptr, witness_kind, index, PROC_ROOT]

    movup.2 exec.memory::get_code_patch_root
    # => [STORED_PROC_ROOT, witness_kind, PROC_ROOT]

    movup.4 movdn.8
    # => [STORED_PROC_ROOT, PROC_ROOT, witness_kind]

    dupw.1 assert_eqw.err=ERR_CODE_PATCH_HINT_ROOT_MISMATCH
    # => [PROC_ROOT, witness_kind]

    movup.4
    # => [witness_kind, PROC_ROOT]
end
