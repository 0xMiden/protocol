use miden::protocol_utils::account_id
use miden::tx_kernel_core::fungible_asset
use miden::tx_kernel_core::non_fungible_asset
use miden::protocol_utils::asset as asset_utils

# ERRORS
# =================================================================================================

const ERR_VAULT_UNSUPPORTED_ASSET_COMPOSITION = "asset composition Custom is not yet supported"

const ERR_VAULT_MERGE_COMPOSITION_NONE = "assets with composition none cannot be merged"

const ERR_VAULT_SPLIT_COMPOSITION_NONE = "assets with composition none cannot be split"

const ERR_VAULT_LT_COMPOSITION_NONE = "assets with composition none cannot be compared"

const ERR_FAUCET_IS_NOT_ASSET_ORIGIN = "the faucet is not the origin of the asset"

# CONSTANT ACCESSORS
# =================================================================================================

pub use {ASSET_SIZE, ASSET_VALUE_MEMORY_OFFSET, COMPOSITION_CUSTOM, COMPOSITION_FUNGIBLE, COMPOSITION_NONE, FUNGIBLE_ASSET_MAX_AMOUNT, id_to_faucet_id, id_into_faucet_id, id_to_asset_class, id_into_asset_class, id_to_composition, id_into_composition, load, store, validate_metadata, fungible_value_into_amount_unchecked}
    from miden::protocol_utils::asset

# PROCEDURES
# =================================================================================================

#! Returns the asset callbacks flag from an asset ID.
#!
#! Inputs:  [ASSET_ID]
#! Outputs: [has_callbacks, ASSET_ID]
#!
#! Where:
#! - ASSET_ID is the asset ID from which to extract the metadata.
#! - has_callbacks is 1 if callbacks are enabled and 0 if disabled.
pub proc id_to_has_callbacks
    # => [asset_class_suffix, asset_class_prefix, faucet_id_suffix_and_metadata, faucet_id_prefix]
    dup.3 exec.account_id::asset_callback_flag
    # => [has_callbacks, ASSET_ID]
end

#! Returns a boolean indicating whether the asset is fungible.
#!
#! Inputs:  [ASSET_ID]
#! Outputs: [is_fungible_asset, ASSET_ID]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to check.
#! - is_fungible_asset is a boolean indicating whether the asset is fungible.
pub proc is_fungible_asset_id
    # => [ASSET_ID]
    exec.id_to_composition
    # => [asset_composition, ASSET_ID]

    eq.COMPOSITION_FUNGIBLE
    # => [is_fungible_asset, ASSET_ID]
end

#! Validates that an asset ID is well formed.
#!
#! Inputs:  [ASSET_ID]
#! Outputs: [ASSET_ID]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to validate.
#!
#! Panics if:
#! - the asset ID is not a valid fungible or non-fungible asset ID (see
#!   fungible_asset::validate_id and non_fungible_asset::validate_id).
pub proc validate_id
    # check if the asset ID is fungible
    exec.is_fungible_asset_id
    # => [is_fungible_asset, ASSET_ID]

    if.true
        exec.fungible_asset::validate_id
        # => [ASSET_ID]
    else
        exec.non_fungible_asset::validate_id
        # => [ASSET_ID]
    end
    # => [ASSET_ID]
end

#! Validates the issuer (faucet ID) and metadata in an asset ID.
#!
#! Inputs:  [ASSET_ID]
#! Outputs: [ASSET_ID]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to validate.
#!
#! Panics if:
#! - the asset metadata is invalid (not 0 or 1).
#! - the faucet ID in the key is not a valid account ID.
pub proc validate_issuer
    # => [asset_class_suffix, asset_class_prefix, faucet_id_suffix_and_metadata, faucet_id_prefix]
    dup.3 dup.3 exec.asset_utils::split_suffix_and_metadata
    # => [asset_metadata, faucet_id_suffix, faucet_id_prefix, ASSET_ID]

    exec.asset_utils::validate_metadata
    # => [faucet_id_suffix, faucet_id_prefix, ASSET_ID]

    exec.account_id::validate
    # => [ASSET_ID]
end

#! Returns a boolean indicating whether the asset is non-fungible.
#!
#! Inputs:  [ASSET_ID]
#! Outputs: [is_non_fungible_asset, ASSET_ID]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to check.
#! - is_non_fungible_asset is a boolean indicating whether the asset is non-fungible.
pub proc is_non_fungible_asset_id
    # => [ASSET_ID]
    exec.id_to_composition
    # => [asset_composition, ASSET_ID]

    eq.COMPOSITION_NONE
    # => [is_non_fungible_asset, ASSET_ID]
end

#! Asserts that the asset's composition is supported by the kernel today (i.e. not Custom).
#!
#! Inputs:  [ASSET_ID]
#! Outputs: [ASSET_ID]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to check.
#!
#! Panics if:
#! - the asset's composition is Custom.
pub proc assert_supported_composition
    exec.id_to_composition
    # => [asset_composition, ASSET_ID]

    neq.COMPOSITION_CUSTOM
    assert.err=ERR_VAULT_UNSUPPORTED_ASSET_COMPOSITION
    # => [ASSET_ID]
end

#! Validates that an asset is well formed.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE]
#! Outputs: [ASSET_ID, ASSET_VALUE]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to validate.
#! - ASSET_VALUE is the value of the asset to validate.
#!
#! Panics if:
#! - the asset is not a valid fungible or non-fungible asset (see fungible_asset::validate and
#!   non_fungible_asset::validate_id).
pub proc validate
    # check if the asset is fungible
    exec.is_fungible_asset_id
    # => [is_fungible_asset, ASSET_ID, ASSET_VALUE]

    # if the asset is fungible, validate the fungible asset
    if.true
        exec.fungible_asset::validate
        # => [ASSET_ID, ASSET_VALUE]
    else
        # if the asset is non fungible, validate the non fungible asset
        exec.non_fungible_asset::validate
        # => [ASSET_ID, ASSET_VALUE]
    end
    # => [ASSET_ID, ASSET_VALUE]
end

#! Validates that an asset is well formed and originates from the provided faucet_id.
#!
#! Inputs:  [faucet_id_suffix, faucet_id_prefix, ASSET_ID, ASSET_VALUE]
#! Outputs: [ASSET_ID, ASSET_VALUE]
#!
#! Where:
#! - faucet_id_{suffix,prefix} are the suffix and prefix of the faucet's account ID.
#! - ASSET_ID is the asset ID of the asset to validate.
#! - ASSET_VALUE is the value of the asset to validate.
#!
#! Panics if:
#! - the asset is not well formed (see validate).
#! - the asset's faucet ID does not match the provided faucet_id.
pub proc validate_origin
    movdn.9 movdn.9
    # => [ASSET_ID, ASSET_VALUE, faucet_id_suffix, faucet_id_prefix]

    # assert the asset ID and value are valid
    exec.validate
    # => [ASSET_ID, ASSET_VALUE, faucet_id_suffix, faucet_id_prefix]

    # assert the origin of the asset is the faucet_id provided via the stack
    exec.id_to_faucet_id
    # => [asset_faucet_id_suffix, asset_faucet_id_prefix, ASSET_ID, ASSET_VALUE, faucet_id_suffix, faucet_id_prefix]

    movup.11 movup.11
    # => [faucet_id_suffix, faucet_id_prefix, asset_faucet_id_suffix, asset_faucet_id_prefix, ASSET_ID, ASSET_VALUE]

    exec.account_id::eq assert.err=ERR_FAUCET_IS_NOT_ASSET_ORIGIN
    # => [ASSET_ID, ASSET_VALUE]
end

#! Merges two values for the same asset and returns the combined value.
#!
#! WARNING: This procedure assumes both asset values have the same asset ID and have already been
#! validated. The `asset_composition` must be taken from the asset ID.
#!
#! Inputs:  [asset_composition, CURRENT_ASSET_VALUE, OTHER_ASSET_VALUE]
#! Outputs: [MERGED_ASSET_VALUE]
#!
#! Where:
#! - asset_composition is the asset composition of the asset whose values are being merged.
#! - CURRENT_ASSET_VALUE and OTHER_ASSET_VALUE are the two asset values to merge.
#! - MERGED_ASSET_VALUE is the combined value.
#!
#! Panics if:
#! - the asset's composition is None.
#! - the asset's composition is Custom (not yet supported).
#! - the underlying merge operation panics (see fungible_asset::merge).
pub proc merge
    dup neq.COMPOSITION_NONE assert.err=ERR_VAULT_MERGE_COMPOSITION_NONE
    # => [asset_composition, CURRENT_ASSET_VALUE, OTHER_ASSET_VALUE]

    eq.COMPOSITION_FUNGIBLE
    # => [is_fungible_asset, CURRENT_ASSET_VALUE, OTHER_ASSET_VALUE]

    if.true
        exec.fungible_asset::merge
        # => [MERGED_ASSET_VALUE]
    else
        push.0 assert.err="merging assets with custom composition is not yet supported"
    end
    # => [MERGED_ASSET_VALUE]
end

#! Computes OTHER_ASSET_VALUE - CURRENT_ASSET_VALUE for the asset with the given composition.
#!
#! WARNING: This procedure assumes both asset values belong to the same asset and have already been
#! validated. The `asset_composition` must be taken from the asset ID.
#!
#! Inputs:  [asset_composition, CURRENT_ASSET_VALUE, OTHER_ASSET_VALUE]
#! Outputs: [SPLIT_ASSET_VALUE]
#!
#! Where:
#! - asset_composition is the asset composition of the asset whose values are being split.
#! - CURRENT_ASSET_VALUE is the value subtracted from OTHER_ASSET_VALUE.
#! - OTHER_ASSET_VALUE is the value being subtracted from.
#! - SPLIT_ASSET_VALUE is OTHER_ASSET_VALUE - CURRENT_ASSET_VALUE.
#!
#! Panics if:
#! - the asset's composition is None.
#! - the asset's composition is Custom (not yet supported).
#! - the underlying split operation panics (see fungible_asset::split).
pub proc split
    dup neq.COMPOSITION_NONE assert.err=ERR_VAULT_SPLIT_COMPOSITION_NONE
    # => [asset_composition, CURRENT_ASSET_VALUE, OTHER_ASSET_VALUE]

    eq.COMPOSITION_FUNGIBLE
    # => [is_fungible_asset, CURRENT_ASSET_VALUE, OTHER_ASSET_VALUE]

    if.true
        exec.fungible_asset::split
        # => [SPLIT_ASSET_VALUE]
    else
        push.0 assert.err="splitting assets with custom composition is not yet supported"
    end
    # => [SPLIT_ASSET_VALUE]
end

#! Returns 1 if OTHER_ASSET_VALUE is less than CURRENT_ASSET_VALUE, 0 otherwise.
#!
#! WARNING: This procedure assumes both asset values belong to the asset identified by ASSET_ID
#! and have already been validated.
#!
#! Inputs:  [ASSET_ID, CURRENT_ASSET_VALUE, OTHER_ASSET_VALUE]
#! Outputs: [is_lt]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset whose values are being compared.
#! - CURRENT_ASSET_VALUE and OTHER_ASSET_VALUE are the two asset values to compare.
#! - is_lt is 1 if OTHER_ASSET_VALUE < CURRENT_ASSET_VALUE.
#!
#! Panics if:
#! - the asset's composition is None.
#! - the asset's composition is Custom (not yet supported).
pub proc lt
    exec.id_to_composition
    # => [asset_composition, ASSET_ID, CURRENT_ASSET_VALUE, OTHER_ASSET_VALUE]

    dup neq.COMPOSITION_NONE assert.err=ERR_VAULT_LT_COMPOSITION_NONE
    # => [asset_composition, ASSET_ID, CURRENT_ASSET_VALUE, OTHER_ASSET_VALUE]

    eq.COMPOSITION_FUNGIBLE
    # => [is_fungible_asset, ASSET_ID, CURRENT_ASSET_VALUE, OTHER_ASSET_VALUE]

    if.true
        dropw
        # => [CURRENT_ASSET_VALUE, OTHER_ASSET_VALUE]

        exec.fungible_asset::lt
        # => [is_lt]
    else
        push.0 assert.err="comparing assets with custom composition is not yet supported"
    end
    # => [is_lt]
end
