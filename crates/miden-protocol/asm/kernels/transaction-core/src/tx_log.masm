use miden::core::crypto::hashes::poseidon2
use miden::core::mem
use miden::core::word
use miden::tx_kernel_core::memory
use {MAX_LOGS_PER_TX, MAX_LOG_PAYLOAD_WORDS, MAX_LOG_PAYLOAD_WORDS_PER_TX, WORD_NUM_ELEMENTS}
    from miden::protocol_utils::constants

# CONSTANTS
# =================================================================================================

# Hash domains shared with TransactionLog and TransactionLogs in Rust.
const LOG_DOMAIN = 0x020005
const LOGS_DOMAIN = 0x020003
const PRIVATE_LOGS_DOMAIN = 0x020004

# Transaction log bookkeeping occupies 1300..1312. Only the salt is initialized by the prologue;
# the counters, dirty flag, and cached commitment start at zero. Address 1307 is alignment padding.
pub const SALT_PTR = 1300
const NUM_LOGS_PTR = 1304
const PAYLOAD_WORDS_PTR = 1305
const DIRTY_PTR = 1306
const COMMITMENT_PTR = 1308

# The ordered individual transaction log commitments occupy 3000..3256 (64 words).
const LOG_COMMITMENTS_PTR = 3000

# add_log locals: two topic elements, two padding elements, then at most 256 payload words.
const TOPIC_0_LOC = 0
const TOPIC_1_LOC = 1
const PAYLOAD_LOC = 4

# The account type is bit four of the native account prefix's low 32 bits.
const ACCOUNT_TYPE_MASK_U32 = 0x10

const TX_LOG_ADDED_EVENT = event("miden::protocol::tx::log_added")

# ERRORS
# =================================================================================================

const ERR_TX_LOG_COUNT = "transaction exceeds 64 logs"
const ERR_TX_LOG_PAYLOAD = "log payload must contain at most 256 complete words"
const ERR_TX_LOG_TOTAL_PAYLOAD = "transaction log payloads exceed 512 words"
const ERR_TX_LOG_PREIMAGE = "log payload does not match its commitment"
const ERR_TX_LOG_SALT = "private transaction logs require a nonzero secret salt"

# PUBLIC PROCEDURES
# =================================================================================================

#! Adds a transaction log for the active account after verifying its payload and the transaction limits.
#! The caller must authenticate the account procedure before invoking this procedure.
#!
#! Inputs:  [topic_0, topic_1, PAYLOAD_COMMITMENT]
#! Outputs: []
#!
#! Panics if:
#! - the transaction log count or payload size exceeds its limit.
#! - the payload does not consist of complete words or does not match PAYLOAD_COMMITMENT.
#!
#! Invocation: exec
@locals(1028)
pub proc add_log(topic_0: felt, topic_1: felt, payload_commitment: word)
    # Save the topic while validating the payload from advice.
    loc_store.TOPIC_0_LOC loc_store.TOPIC_1_LOC
    # => [PAYLOAD_COMMITMENT]

    mem_load.NUM_LOGS_PTR u32lt.MAX_LOGS_PER_TX assert.err=ERR_TX_LOG_COUNT
    # => [PAYLOAD_COMMITMENT]

    adv.push_mapvaln adv_push u32assert.err=ERR_TX_LOG_PAYLOAD
    u32divmod.WORD_NUM_ELEMENTS
    # => [remainder, num_words, PAYLOAD_COMMITMENT]

    # Check alignment and both payload limits before reading any payload elements.
    assertz.err=ERR_TX_LOG_PAYLOAD
    dup u32lte.MAX_LOG_PAYLOAD_WORDS assert.err=ERR_TX_LOG_PAYLOAD
    # => [num_words, PAYLOAD_COMMITMENT]

    dup mem_load.PAYLOAD_WORDS_PTR add
    dup u32lte.MAX_LOG_PAYLOAD_WORDS_PER_TX assert.err=ERR_TX_LOG_TOTAL_PAYLOAD
    mem_store.PAYLOAD_WORDS_PTR
    # => [num_words, PAYLOAD_COMMITMENT]

    # Copy and hash in one pass. The checked word count fits in the 1024 payload locals.
    locaddr.PAYLOAD_LOC swap exec.mem::pipe_words_to_memory
    # => [RATE0, RATE1, CAPACITY, end_ptr, PAYLOAD_COMMITMENT]

    exec.poseidon2::squeeze_digest movup.4 drop
    # => [COMPUTED_PAYLOAD_COMMITMENT, PAYLOAD_COMMITMENT]

    # Retain the verified commitment for the event and the individual transaction log hash.
    dupw.1 assert_eqw.err=ERR_TX_LOG_PREIMAGE
    # => [PAYLOAD_COMMITMENT]

    loc_load.TOPIC_1_LOC loc_load.TOPIC_0_LOC exec.memory::get_account_id
    # => [emitter_suffix, emitter_prefix, topic_0, topic_1, PAYLOAD_COMMITMENT]

    emit.TX_LOG_ADDED_EVENT
    push.LOG_DOMAIN exec.poseidon2::merge_in_domain
    # => [LOG_COMMITMENT]

    mem_load.NUM_LOGS_PTR mul.WORD_NUM_ELEMENTS add.LOG_COMMITMENTS_PTR mem_storew_le dropw
    # => []

    # Appending invalidates the commitment cached by get_commitment.
    mem_load.NUM_LOGS_PTR add.1 mem_store.NUM_LOGS_PTR
    push.1 mem_store.DIRTY_PTR
    # => []

end

#! Returns the transaction log commitment included in the transaction proof.
#! Appending another transaction log invalidates the cache.
#! Nonempty private transaction logs are committed with the secret salt.
#! Before the first transaction log, the cached commitment is the empty word.
#!
#! Inputs:  []
#! Outputs: [LOGS_COMMITMENT]
#!
#! Invocation: exec
pub proc get_commitment() -> word
    mem_load.DIRTY_PTR
    # => [is_dirty]

    if.true
        exec.compute_commitment mem_storew_le.COMMITMENT_PTR
        # => [LOGS_COMMITMENT]

        push.0 mem_store.DIRTY_PTR
        # => [LOGS_COMMITMENT]

    else
        padw mem_loadw_le.COMMITMENT_PTR
        # => [LOGS_COMMITMENT]

    end
end

# HELPER PROCEDURES
# =================================================================================================

#! Computes the commitment after at least one transaction log has been added.
#! Visibility is determined by the native account, including during FPI.
#!
#! Inputs:  []
#! Outputs: [LOGS_COMMITMENT]
#!
#! Panics if the native account is private and the secret salt is zero.
proc compute_commitment() -> word
    push.LOGS_DOMAIN mem_load.NUM_LOGS_PTR mul.WORD_NUM_ELEMENTS push.LOG_COMMITMENTS_PTR
    exec.poseidon2::hash_elements_in_domain
    # => [LOGS_COMMITMENT]

    exec.memory::get_native_account_id drop u32split swap drop
    u32and.ACCOUNT_TYPE_MASK_U32 eq.0
    # => [is_private, LOGS_COMMITMENT]

    if.true
        padw mem_loadw_le.SALT_PTR
        exec.word::testz not assert.err=ERR_TX_LOG_SALT
        # => [SECRET_SALT, LOGS_COMMITMENT]

        swapw push.PRIVATE_LOGS_DOMAIN exec.poseidon2::merge_in_domain
        # => [PRIVATE_LOGS_COMMITMENT]

    end
end
