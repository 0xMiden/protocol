use {
    AccountId,
    AccountProcedureRoot,
    Asset,
    Bool,
    NoteAttachmentCommitment,
    NoteAttachmentScheme,
    StorageSlotId,
} from miden::protocol_utils::types
use miden::tx_kernel_core::tx
use miden::tx_kernel_core::asset
use miden::tx_kernel_core::account
use miden::tx_kernel_core::memory
use miden::protocol_utils::account_id
use miden::core::word

# CONSTANTS
# ==================================================================================================

# The index of the local memory slot that contains the procedure root of the callback.
const CALLBACK_PROC_ROOT_LOC = 0

# The index of the local memory slot that holds the top callback output while the foreign context
# is ended.
const CALLBACK_TOP_OUTPUT_LOC = 4

# The name of the storage slot where the procedure root for the on_before_asset_added_to_account callback
# is stored.
pub const ON_BEFORE_ASSET_ADDED_TO_ACCOUNT_PROC_ROOT_SLOT =
    word(
        "miden::protocol::faucet::callback::on_before_asset_added_to_account"
    )

# The name of the storage slot where the procedure root for the on_before_note_sealed callback is
# stored.
pub const ON_BEFORE_NOTE_SEALED_PROC_ROOT_SLOT =
    word(
        "miden::protocol::faucet::callback::on_before_note_sealed"
    )

# PROCEDURES
# ==================================================================================================

#! Invokes the `on_before_asset_added_to_account` callback on the faucet that issued the asset,
#! if the asset's issuer has callbacks enabled.
#!
#! The callback invocation is skipped in these cases:
#! - If the issuing faucet's account ID has the asset callback flag disabled.
#! - If the faucet does not have the callback storage slot.
#! - If the callback storage slot contains the empty word.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE]
#! Outputs: []
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset being added.
#! - ASSET_VALUE is the value of the asset being added.
pub proc on_before_asset_added_to_account(asset: Asset)
    # derive the callback flag from the asset metadata, carried in the asset ID
    exec.asset::id_to_has_callbacks
    # => [has_callbacks, ASSET_ID, ASSET_VALUE]

    if.true
        exec.asset::id_to_faucet_id
        # => [faucet_id_suffix, faucet_id_prefix, ASSET_ID, ASSET_VALUE]

        push.ON_BEFORE_ASSET_ADDED_TO_ACCOUNT_PROC_ROOT_SLOT[0..2]
        # => [slot_id_suffix, slot_id_prefix, faucet_id_suffix, faucet_id_prefix, ASSET_ID,
        #     ASSET_VALUE]

        exec.invoke_callback
        # => [callback_outputs(16)]

        dropw dropw dropw dropw
        # => []
    else
        dropw dropw
        # => []
    end
    # => []
end

#! Invokes the `on_before_note_sealed` callback on the provided faucet for the output note with the
#! provided index and returns the attachment the callback returns for the note.
#!
#! The faucet's account ID is expected to have the asset callback flag enabled.
#!
#! The callback invocation is skipped in these cases:
#! - If the faucet does not have the callback storage slot.
#! - If the callback storage slot contains the empty word.
#!
#! Inputs:  [faucet_id_suffix, faucet_id_prefix, note_idx]
#! Outputs: [attachment_scheme, ATTACHMENT_COMMITMENT]
#!
#! Where:
#! - faucet_id_{suffix,prefix} are the suffix and prefix felts of the ID of the faucet whose
#!   callback is invoked.
#! - note_idx is the index of the output note that is being sealed.
#! - attachment_scheme is the scheme of the attachment returned by the callback, or 0 if the
#!   callback returns no attachment or its invocation was skipped.
#! - ATTACHMENT_COMMITMENT is the commitment to the elements of the returned attachment.
#!
#! Panics if:
#! - the callback procedure root is not part of the faucet's account code.
pub proc on_before_note_sealed(
    faucet_id: AccountId,
    note_idx: u16
) -> (NoteAttachmentScheme, NoteAttachmentCommitment)
    # pad the note index to the 8 elements of the callback inputs
    repeat.7
        push.0 movdn.3
    end
    # => [faucet_id_suffix, faucet_id_prefix, note_idx, pad(7)]

    push.ON_BEFORE_NOTE_SEALED_PROC_ROOT_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, faucet_id_suffix, faucet_id_prefix, note_idx, pad(7)]

    exec.invoke_callback
    # => [attachment_scheme, ATTACHMENT_COMMITMENT, pad(11)]

    # drop the padding of the callback outputs
    swapdw dropw dropw
    # => [attachment_scheme, ATTACHMENT_COMMITMENT, pad(3)]

    movup.5 drop movup.5 drop movup.5 drop
    # => [attachment_scheme, ATTACHMENT_COMMITMENT]
end

#! Invokes a callback by starting a foreign context against the faucet, reading the callback
#! procedure root from the provided slot ID in the faucet's storage, and invoking it via `dyncall`
#! with the callback inputs padded to 16 elements.
#!
#! If the faucet does not have the callback storage slot, or if the slot contains the empty word,
#! the callback is skipped, its inputs are consumed and 16 zeros are returned in place of its
#! outputs. Both conditions are evaluated only after the foreign context has been started, so a
#! faucet whose account ID has the asset callback flag enabled is loaded as a foreign account
#! whenever one of its assets is added to an account vault and once for every sealed output note
#! holding its assets, even when it registers no callback procedure root.
#!
#! The callback cannot modify account or note state, so it affects the transaction only through
#! its return values. See `memory::assert_not_in_asset_callback`.
#!
#! Inputs:  [slot_id_suffix, slot_id_prefix, faucet_id_suffix, faucet_id_prefix, callback_inputs(8)]
#! Outputs: [callback_outputs(16)]
#!
#! Where:
#! - slot_id* is the ID of the slot that contains the callback procedure root.
#! - faucet_id_{suffix,prefix} are the suffix and prefix felts of the ID of the faucet whose
#!   callback is invoked.
#! - callback_inputs are the first 8 elements passed to the callback, followed by 8 zeros.
#! - callback_outputs are the 16 elements returned by the callback, or 16 zeros if the callback
#!   invocation was skipped.
#!
#! Panics if:
#! - the callback procedure root is not part of the faucet's account code.
@locals(5)
proc invoke_callback(
    slot_id: StorageSlotId,
    faucet_id: AccountId,
    callback_inputs: [felt; 8]
) -> [felt; 16]
    exec.maybe_start_faucet_callback_context
    # => [was_foreign_context_started, should_invoke_callback, PROC_ROOT, callback_inputs(8)]

    # keep was_foreign_context_started below the 16 elements passed to the callback
    movdn.13
    # => [should_invoke_callback, PROC_ROOT, callback_inputs(8), was_foreign_context_started]

    # only invoke the callback if the procedure root is not the empty word
    if.true
        # verify the callback root is part of the faucet's account code before invoking it
        dupw exec.account::assert_procedure_in_active_account drop
        # => [PROC_ROOT, callback_inputs(8), was_foreign_context_started]

        # prepare for dyncall by storing procedure root in local memory
        loc_storew_le.CALLBACK_PROC_ROOT_LOC dropw
        # => [callback_inputs(8), was_foreign_context_started]

        # pad the callback inputs to 16 elements
        padw padw swapdw
        # => [callback_inputs(8), pad(8), was_foreign_context_started]

        # invoke the callback while the flag rejects account and note state changes
        push.1 exec.memory::set_asset_callback_in_progress_flag
        # => [callback_inputs(8), pad(8), was_foreign_context_started]

        locaddr.CALLBACK_PROC_ROOT_LOC
        dyncall
        # => [callback_outputs(16), was_foreign_context_started]

        push.0 exec.memory::set_asset_callback_in_progress_flag
        # => [callback_outputs(16), was_foreign_context_started]

        # store the top callback output so the flag comes within reach of movup.15
        loc_store.CALLBACK_TOP_OUTPUT_LOC
        # => [remaining_callback_outputs(15), was_foreign_context_started]

        movup.15 exec.maybe_end_faucet_callback_context
        # => [remaining_callback_outputs(15)]

        loc_load.CALLBACK_TOP_OUTPUT_LOC
        # => [callback_outputs(16)]
    else
        # drop proc root and callback inputs
        dropw dropw dropw
        # => [was_foreign_context_started]

        exec.maybe_end_faucet_callback_context
        # => []

        # return zeros in place of the callback outputs
        padw padw padw padw
        # => [callback_outputs(16)]
    end
    # => [callback_outputs(16)]
end

#! Prepares the invocation of a faucet callback.
#!
#! If the faucet is the active account, no foreign context is started, otherwise a foreign context
#! is started against the faucet.
#!
#! The callback procedure root is fetched from the faucet's storage and a flag is computed that
#! signals whether the callback should be invoked. The callback should be invoked if the storage
#! slot exists and contains a non-empty procedure root.
#!
#! Inputs:  [slot_id_suffix, slot_id_prefix, faucet_id_suffix, faucet_id_prefix]
#! Outputs: [was_foreign_context_started, should_invoke_callback, PROC_ROOT]
#!
#! Where:
#! - slot_id_suffix and slot_id_prefix identify the storage slot containing the callback procedure root.
#! - faucet_id_{suffix,prefix} are the suffix and prefix felts of the ID of the faucet whose
#!   callback is invoked.
#! - should_invoke_callback is 1 if the callback should be invoked, 0 otherwise.
#! - PROC_ROOT is the procedure root of the callback, or the empty word if not found.
#! - was_foreign_context_started is 1 if the faucet is not the active account, 0 otherwise.
proc maybe_start_faucet_callback_context(
    slot_id: StorageSlotId,
    faucet_id: AccountId
) -> (Bool, Bool, AccountProcedureRoot)
    # move slot IDs past the faucet ID
    movdn.3 movdn.3
    # => [faucet_id_suffix, faucet_id_prefix, slot_id_suffix, slot_id_prefix]

    # check if the faucet is the active account
    dup.1 dup.1 exec.should_start_foreign_context
    # => [should_start_foreign_context, faucet_id_suffix, faucet_id_prefix, slot_id_suffix,
    #     slot_id_prefix]

    # store the flag for return as was_foreign_context_started
    dup movdn.5
    # => [should_start_foreign_context, faucet_id_suffix, faucet_id_prefix, slot_id_suffix,
    #     slot_id_prefix, was_foreign_context_started]

    if.true
        # if the faucet is not the active account, start a context against the faucet
        exec.tx::start_foreign_context
        # => [slot_id_suffix, slot_id_prefix, was_foreign_context_started]
    else
        # if the faucet is the active account, the account context is already the issuing faucet's context
        drop drop
        # => [slot_id_suffix, slot_id_prefix, was_foreign_context_started]
    end

    # try to find the callback procedure root in the faucet's storage
    exec.account::find_item
    # => [is_found, PROC_ROOT, was_foreign_context_started]

    movdn.4 exec.word::testz not
    # => [is_non_empty_word, PROC_ROOT, is_found, was_foreign_context_started]

    # should_invoke_callback = is_found && is_non_empty_word
    movup.5 and
    # => [should_invoke_callback, PROC_ROOT, was_foreign_context_started]

    movup.5
    # => [was_foreign_context_started, should_invoke_callback, PROC_ROOT]
end

#! Ends a callback context against the faucet if a foreign context was previously started.
#!
#! This pops the top of the account stack, making the previous account the active account.
#!
#! This wrapper exists only for uniformity with maybe_start_faucet_callback_context.
#!
#! Inputs:  [was_foreign_context_started]
#! Outputs: []
#!
#! Where:
#! - was_foreign_context_started is 1 if a foreign context was started, 0 otherwise.
proc maybe_end_faucet_callback_context(was_foreign_context_started: Bool)
    # if a foreign context was started, end it
    if.true
        exec.tx::end_foreign_context
    end
end

#! Returns 1 if the provided faucet ID is not the ID of the active account and a foreign context
#! should be started, 0 otherwise.
#!
#! Inputs:  [faucet_id_suffix, faucet_id_prefix]
#! Outputs: [should_start_foreign_context]
proc should_start_foreign_context(faucet_id: AccountId) -> Bool
    exec.account::get_id
    # => [active_account_id_suffix, active_account_id_prefix, faucet_id_suffix, faucet_id_prefix]

    # start a foreign context if the IDs are *not* equal
    exec.account_id::eq
    not
    # => [should_start_foreign_context]
end
