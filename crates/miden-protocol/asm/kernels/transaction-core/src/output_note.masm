    AccountId,
    Asset,
    Bool,
    NoteAssetsCommitment,
    NoteAttachmentCommitment,
    NoteAttachmentCount,
    NoteAttachmentListCommitment,
    NoteAttachmentScheme,
    NoteAttachmentsCommitment,
    NoteMetadata,
    NoteRecipient,
    NoteTag,
    NoteType,
} from miden::protocol_utils::types
use {OutputNoteData} from miden::tx_kernel_core::types
use miden::tx_kernel_core::account
use miden::tx_kernel_core::asset
use {ASSET_SIZE, ASSET_VALUE_MEMORY_OFFSET} from miden::tx_kernel_core::asset
use miden::tx_kernel_core::callbacks
use miden::tx_kernel_core::fungible_asset
use miden::tx_kernel_core::memory
use miden::tx_kernel_core::note
use miden::protocol_utils::account_id
use {MAX_OUTPUT_NOTES_PER_TX, WORD_NUM_ELEMENTS} from miden::tx_kernel_core::constants
use {
    ATTACHMENT_LIST_ENTRY_SIZE,
    ATTACHMENT_RESERVED_SCHEME,
    MAX_ATTACHMENTS_PER_NOTE,
    MAX_ATTACHMENT_SCHEME,
    MAX_ATTACHMENT_TOTAL_WORDS,
    MAX_ATTACHMENT_WORDS,
    NOTE_METADATA_VERSION_1,
    NOTE_TYPE_PUBLIC,
} from miden::tx_kernel_core::note
use miden::core::word
use miden::core::mem

# CONSTANTS
# =================================================================================================

# The default value of felt[3] in the metadata when a new note is created.
# All zeros means no attachment schemes are set.
const ATTACHMENT_DEFAULT_SCHEMES = 0

# ERRORS
# =================================================================================================

const ERR_TX_NUMBER_OF_OUTPUT_NOTES_EXCEEDS_LIMIT =
    "number of output notes in the transaction exceeds the maximum limit of 1024"

const ERR_OUTPUT_NOTE_IS_SEALED = "sealed output notes cannot be modified"

const ERR_NOTE_INVALID_TYPE = "invalid note type"

const ERR_OUTPUT_NOTE_INDEX_OUT_OF_BOUNDS =
    "requested output note index should be less than the total number of created output notes"

const ERR_OUTPUT_NOTE_ATTACHMENT_SCHEME_MAX_EXCEEDED = "attachment scheme must not exceed 65534"

const ERR_OUTPUT_NOTE_ATTACHMENT_SCHEME_CANNOT_BE_ZERO = "attachment scheme must not be 0"

const ERR_OUTPUT_NOTE_ATTACHMENT_SIZE_MAX_EXCEEDED = "attachment num_words must not exceed 256"

const ERR_OUTPUT_NOTE_ATTACHMENT_SIZE_MUST_BE_MULTIPLE_OF_WORD_SIZE =
    "number of elements in an attachment must be a multiple of 4"

const ERR_OUTPUT_NOTE_ATTACHMENT_SIZE_CANNOT_BE_ZERO = "attachment num_words cannot be zero"

const ERR_OUTPUT_NOTE_TOO_MANY_ATTACHMENTS = "number of attachments per note cannot exceed 4"

const ERR_OUTPUT_NOTE_TOTAL_ATTACHMENT_WORDS_EXCEEDED =
    "total number of attachment words per note cannot exceed 512"

const ERR_OUTPUT_NOTE_CALLBACK_ATTACHMENT_LIST_COMMITMENT_WITHOUT_ATTACHMENTS =
    "note callback returned a non-empty attachment list commitment with 0 attachments"

const ERR_OUTPUT_NOTE_CALLBACK_ATTACHMENT_LIST_LENGTH_MISMATCH =
    "attachment list returned by a note callback does not match its number of attachments"

const ERR_OUTPUT_NOTE_CALLBACK_ATTACHMENT_LIST_ENTRY_PADDING_NOT_ZERO =
    "attachment list returned by a note callback must pad each attachment scheme with zeros"

const ERR_NON_FUNGIBLE_ASSET_ALREADY_EXISTS =
    "non-fungible asset that already exists in the note cannot be added again"

const ERR_NOTE_TAG_MUST_BE_U32 =
    "the note's tag must fit into a u32 so the 32 most significant bits of the felt must be zero"

# EVENTS
# =================================================================================================

# Event emitted before a new note is created.
const NOTE_BEFORE_CREATED_EVENT = event("miden::protocol::note::before_created")
# Event emitted after a new note is created.
const NOTE_AFTER_CREATED_EVENT = event("miden::protocol::note::after_created")

# Event emitted before an asset is added to a note.
const NOTE_BEFORE_ADD_ASSET_EVENT = event("miden::protocol::note::before_add_asset")
# Event emitted after an asset is added to a note.
const NOTE_AFTER_ADD_ASSET_EVENT = event("miden::protocol::note::after_add_asset")

# Event emitted before an attachment is added to a note.
const NOTE_BEFORE_ADD_ATTACHMENT_EVENT = event("miden::protocol::note::before_add_attachment")

# OUTPUT NOTE PROCEDURES
# =================================================================================================

#! Creates a new note and returns the index of the note.
#!
#! All attachments are by default set to empty words and the number of attachments is 0.
#!
#! Inputs:  [tag, note_type, RECIPIENT]
#! Outputs: [note_idx]
#!
#! Where:
#! - tag is the note tag which can be used by the recipient(s) to identify notes intended for them.
#! - note_type is the type of the note, which defines how the note is to be stored (e.g., on-chain
#!   or off-chain).
#! - RECIPIENT defines spend conditions for the note.
#! - note_idx is the index of the created note.
#!
#! Panics if:
#! - the note_type is unknown.
#! - the note tag is not a u32.
#! - the number of output notes exceeds the maximum limit of 1024.
pub proc create(tag: NoteTag, note_type: NoteType, recipient: NoteRecipient) -> u16
    emit.NOTE_BEFORE_CREATED_EVENT
    # => [tag, note_type, RECIPIENT]

    exec.build_metadata
    # => [NOTE_METADATA, RECIPIENT]

    # get the index for the next note to be created and increment counter
    exec.increment_num_output_notes dup movdn.9
    # => [note_idx, NOTE_METADATA, RECIPIENT, note_idx]

    # get a pointer to the memory address at which the note will be stored
    exec.memory::get_output_note_ptr
    # => [note_ptr, NOTE_METADATA, RECIPIENT, note_idx]

    movdn.4
    # => [NOTE_METADATA, note_ptr, RECIPIENT, note_idx]

    # emit event to signal that a new note is created
    emit.NOTE_AFTER_CREATED_EVENT

    # Zeroed memory does not contain the canonical commitment of an empty asset list. Mark the
    # cache dirty so its first read computes and stores the commitment.
    dup.4 push.1 swap exec.memory::set_output_note_dirty_flag
    # => [NOTE_METADATA, note_ptr, RECIPIENT, note_idx]

    # set the metadata for the output note
    dup.4
    # => [note_ptr, NOTE_METADATA, note_ptr, RECIPIENT, note_idx]

    exec.memory::set_output_note_metadata dropw
    # => [note_ptr, RECIPIENT, note_idx]

    # set the RECIPIENT for the output note
    exec.memory::set_output_note_recipient dropw
    # => [note_idx]
end

#! Returns the information about assets in the output note with the specified index.
#!
#! The provided output note index is expected to be less than the total number of output notes.
#!
#! Inputs:  [note_index]
#! Outputs: [ASSETS_COMMITMENT, num_assets]
#!
#! Where:
#! - note_index is the index of the output note whose assets info should be returned.
#! - num_assets is the number of assets in the specified note.
#! - ASSETS_COMMITMENT is a sequential hash of the assets in the specified note.
pub proc get_assets_info(note_index: u16) -> (NoteAssetsCommitment, u8)
    # get the note data pointer based on the index of the requested note
    exec.memory::get_output_note_ptr
    # => [note_data_ptr]

    # get the number of assets in the note
    dup exec.memory::get_output_note_num_assets swap
    # => [note_data_ptr, num_assets]

    # get the assets commitment
    dup exec.note::compute_output_note_assets_commitment
    # => [ASSETS_COMMITMENT, note_data_ptr, num_assets]

    # next we should store the assets in the advice map using the computed assets commitment to be
    # able to get the assets later (in the `miden::protocol::output_note::get_assets` procedure)

    # get the start and the end pointers of the asset data
    #
    # notice that if the number of assets is odd, the asset data end pointer will be shifted one
    # word further to make the assets number even (the same way it is done in the
    # `note::compute_output_note_assets_commitment` procedure)
    movup.4 exec.memory::get_output_note_asset_data_ptr
    # => [assets_start_ptr, ASSETS_COMMITMENT, num_assets]

    movdn.4 dup.4
    # => [assets_start_ptr, ASSETS_COMMITMENT, assets_start_ptr, num_assets]

    dup.6 mul.ASSET_SIZE add
    # => [assets_end_ptr, ASSETS_COMMITMENT, assets_start_ptr, num_assets]

    movdn.5
    # => [ASSETS_COMMITMENT, assets_start_ptr, assets_end_ptr, num_assets]

    # store the assets data to the advice map using ASSETS_COMMITMENT as a key
    adv.insert_mem
    # => [ASSETS_COMMITMENT, assets_start_ptr, assets_end_ptr, num_assets]

    # remove asset pointers from the stack
    movup.4 drop movup.4 drop
    # => [ASSETS_COMMITMENT, num_assets]
end

#! Returns the commitment over all attachments in the note with the provided index.
#!
#! Inputs:  [note_index]
#! Outputs: [ATTACHMENTS_COMMITMENT]
#!
#! Where:
#! - note_index is the index of the output note whose attachments commitment should be returned.
#! - ATTACHMENTS_COMMITMENT is the commitment to all attachments of the note.
pub proc get_attachments_commitment(note_index: u16) -> NoteAttachmentsCommitment
    # get the note data pointer based on the index of the requested note
    exec.memory::get_output_note_ptr
    # => [note_ptr]

    dup exec.memory::get_output_note_num_attachments
    # => [num_attachments, note_ptr]

    dup.1 exec.memory::get_output_note_attachment_commitment_ptr
    # => [start_ptr, num_attachments, note_ptr]

    # compute start_ptr and end_ptr for the attachment commitments in memory
    dup movup.2 mul.WORD_NUM_ELEMENTS add swap
    # => [start_ptr, end_ptr, note_ptr]

    movup.2 exec.note::compute_attachments_commitment
    # => [ATTACHMENTS_COMMITMENT, start_ptr, end_ptr]

    # store the attachment commitments to the advice map using ATTACHMENTS_COMMITMENT as a key
    adv.insert_mem
    # => [ATTACHMENTS_COMMITMENT, start_ptr, end_ptr]

    # remove pointers from the stack
    movup.4 drop movup.4 drop
    # => [ATTACHMENTS_COMMITMENT]
end

#! Adds the asset to the note specified by the index.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, note_idx]
#! Outputs: []
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to add.
#! - ASSET_VALUE is the value of the asset to add.
#! - note_idx is the index of the note to which the asset is added.
#!
#! Panics if:
#! - the asset ID or value are malformed (e.g., invalid faucet ID).
#! - the max amount of fungible assets is exceeded.
#! - the non-fungible asset already exists in the note.
#! - the total number of ASSETs exceeds the maximum of 16.
#! - the output note is sealed.
pub proc add_asset(asset: Asset, note_idx: u16)
    # reject assets with a Custom composition; only None and Fungible are supported today
    exec.asset::assert_supported_composition
    # => [ASSET_ID, ASSET_VALUE, note_idx]

    # validate the asset
    exec.asset::validate
    # => [ASSET_ID, ASSET_VALUE, note_idx]

    dup.8 exec.memory::get_output_note_ptr
    exec.memory::is_output_note_sealed assertz.err=ERR_OUTPUT_NOTE_IS_SEALED
    # => [ASSET_ID, ASSET_VALUE, note_idx]

    # emit event to signal that a new asset is going to be added to the note
    emit.NOTE_BEFORE_ADD_ASSET_EVENT
    # => [ASSET_ID, ASSET_VALUE, note_idx]

    movup.8 exec.memory::get_output_note_ptr dup
    # => [note_ptr, note_ptr, ASSET_ID, ASSET_VALUE]

    movdn.9 movdn.9
    # => [ASSET_ID, ASSET_VALUE, note_ptr, note_ptr]

    # add the asset to the note
    exec.add_asset_raw
    # => [note_ptr]

    # emit event to signal that a new asset was added to the note
    emit.NOTE_AFTER_ADD_ASSET_EVENT
    # => [note_ptr]

    # update the assets commitment dirty flag to signal that the current assets commitment is not
    # valid anymore
    push.1 swap exec.memory::set_output_note_dirty_flag
    # => []
end

#! Adds an attachment to the note specified by the index. Attachments are append-only.
#!
#! The attachment elements are fetched from the advice map using ATTACHMENT_COMMITMENT as the key.
#! The number of words (num_words) is derived from the element count and the commitment is verified
#! by hashing the fetched elements.
#!
#! Inputs:
#!   Operand Stack: [attachment_scheme, ATTACHMENT_COMMITMENT, note_idx]
#!   Advice map: {
#!     ATTACHMENT_COMMITMENT: [[ATTACHMENT_ELEMENTS]],
#!   }
#! Outputs: []
#!
#! Where:
#! - attachment_scheme is the user-defined scheme of the attachment.
#! - ATTACHMENT_COMMITMENT is the hash commitment to the attachment elements.
#! - note_idx is the index of the note to which the attachment is added.
#!
#! Panics if:
#! - the attachment scheme is 0 or exceeds 65534.
#! - the number of elements is not a multiple of 4, or num_words is zero or exceeds 256.
#! - the computed hash of fetched attachment elements does not match ATTACHMENT_COMMITMENT.
#! - the note already has 4 attachments.
#! - the output note is sealed.
pub proc add_attachment(
    attachment_scheme: NoteAttachmentScheme,
    attachment_commitment: NoteAttachmentCommitment,
    note_idx: u16
)
    # validate attachment_scheme does not exceed max
    dup u32assert.err=ERR_OUTPUT_NOTE_ATTACHMENT_SCHEME_MAX_EXCEEDED
    u32lte.MAX_ATTACHMENT_SCHEME assert.err=ERR_OUTPUT_NOTE_ATTACHMENT_SCHEME_MAX_EXCEEDED
    # => [attachment_scheme, ATTACHMENT_COMMITMENT, note_idx]

    # assert the scheme is not 0 which the kernel uses to represent absent attachments
    dup neq.ATTACHMENT_RESERVED_SCHEME assert.err=ERR_OUTPUT_NOTE_ATTACHMENT_SCHEME_CANNOT_BE_ZERO
    # => [attachment_scheme, ATTACHMENT_COMMITMENT, note_idx]

    movdn.4
    # => [ATTACHMENT_COMMITMENT, attachment_scheme, note_idx]

    # validate preimage for commitment is available and number of committed words is within limits
    dupw exec.validate_attachment
    # => [num_words, ATTACHMENT_COMMITMENT, attachment_scheme, note_idx]

    movup.5
    # => [attachment_scheme, num_words, ATTACHMENT_COMMITMENT, note_idx]

    # get note_ptr from note_idx
    movup.6 exec.memory::get_output_note_ptr
    # => [note_ptr, attachment_scheme, num_words, ATTACHMENT_COMMITMENT]

    dup exec.memory::is_output_note_sealed assertz.err=ERR_OUTPUT_NOTE_IS_SEALED
    # => [note_ptr, attachment_scheme, num_words, ATTACHMENT_COMMITMENT]

    # update and validate total attachment words
    dup exec.memory::get_output_note_total_attachment_words
    # => [total_num_words, note_ptr, attachment_scheme, num_words, ATTACHMENT_COMMITMENT]

    movup.3 add
    # => [new_total_num_words, note_ptr, attachment_scheme, ATTACHMENT_COMMITMENT]

    dup u32lte.MAX_ATTACHMENT_TOTAL_WORDS assert.err=ERR_OUTPUT_NOTE_TOTAL_ATTACHMENT_WORDS_EXCEEDED
    # => [new_total_num_words, note_ptr, attachment_scheme, ATTACHMENT_COMMITMENT]

    dup.1 exec.memory::set_output_note_total_attachment_words
    # => [note_ptr, attachment_scheme, ATTACHMENT_COMMITMENT]

    # validate current number of attachments < 4
    dup exec.memory::get_output_note_num_attachments
    # => [num_attachments, note_ptr, attachment_scheme, ATTACHMENT_COMMITMENT]

    dup lt.MAX_ATTACHMENTS_PER_NOTE assert.err=ERR_OUTPUT_NOTE_TOO_MANY_ATTACHMENTS
    # => [num_attachments, note_ptr, attachment_scheme, ATTACHMENT_COMMITMENT]

    # emit event
    emit.NOTE_BEFORE_ADD_ATTACHMENT_EVENT
    # => [num_attachments, note_ptr, attachment_scheme, ATTACHMENT_COMMITMENT]

    # --- Add attachment in output note memory ---

    movup.6 movup.6 movup.6 movup.6
    # => [ATTACHMENT_COMMITMENT, num_attachments, note_ptr, attachment_scheme]

    # use attachment_idx = num_attachments
    dup.4 dup.6
    # => [note_ptr, attachment_idx, ATTACHMENT_COMMITMENT, num_attachments, note_ptr, attachment_scheme]

    # store commitment in note memory
    exec.memory::set_output_note_attachment_commitment
    # => [num_attachments, note_ptr, attachment_scheme]

    # increment number of attachments
    dup add.1
    # => [new_num_attachments, num_attachments, note_ptr, attachment_scheme]

    dup.2 exec.memory::set_output_note_num_attachments
    # => [num_attachments, note_ptr, attachment_scheme]

    exec.set_attachment_schemes
    # => []
end

#! Invokes the `on_before_note_sealed` callback of each distinct faucet with the asset callback flag
#! enabled among the assets of the note specified by the index, and then seals the note.
#!
#! If the note is already sealed, the procedure returns without invoking any callback. The callbacks
#! are invoked in the order in which each faucet first occurs among the note's assets. Each callback
#! can return a list of attachments, which are appended to the note in list order right after the
#! callback returns, so the note's attachments, metadata and ID are final only once the last
#! callback returned. Once the note is sealed, its assets and attachments cannot be modified.
#!
#! Inputs:  [note_idx]
#! Outputs: []
#!
#! Where:
#! - note_idx is the index of the note to seal.
#!
#! Panics if:
#! - a callback procedure root is not part of its faucet's account code.
#! - an invoked callback panics.
#! - a callback returns 0 attachments with a non-empty attachment list commitment.
#! - an attachment list returned by a callback is invalid (see `add_attachment_list`).
pub proc seal(note_idx: u16)
    dup exec.memory::get_output_note_ptr
    # => [note_ptr, note_idx]

    dup exec.memory::is_output_note_sealed
    # => [is_sealed, note_ptr, note_idx]

    if.true
        drop drop
        # => []
    else
        swap dup.1
        # => [note_ptr, note_idx, note_ptr]

        exec.invoke_on_before_note_sealed_callbacks
        # => [note_ptr]

        exec.memory::seal_output_note
        # => []
    end
    # => []
end

#! Assert that the provided note index is less than the total number of output notes.
#!
#! Inputs:  [note_index]
#! Outputs: [note_index]
pub proc assert_note_index_in_bounds(note_index: u16) -> u16
    # assert that the provided note index is less than the total number of notes
    dup exec.memory::get_num_output_notes
    # => [output_notes_num, note_index, note_index]

    u32assert2.err=ERR_OUTPUT_NOTE_INDEX_OUT_OF_BOUNDS
    u32lt assert.err=ERR_OUTPUT_NOTE_INDEX_OUT_OF_BOUNDS
    # => [note_index]
end

# HELPER PROCEDURES
# =================================================================================================

#! Validates the attachment commitment against the advice data.
#!
#! Fetches the attachment elements from the advice map using ATTACHMENT_COMMITMENT as the key,
#! derives num_words from the element count, pipes the elements to local memory to compute the
#! commitment, and asserts the computed commitment matches the provided commitment.
#!
#! Inputs:
#!   Operand Stack: [ATTACHMENT_COMMITMENT]
#!   Advice map: {
#!     ATTACHMENT_COMMITMENT: [[ATTACHMENT_ELEMENTS]],
#!   }
#! Outputs: [num_words]
#!
#! Panics if:
#! - the number of elements is not a multiple of 4, or num_words is zero or exceeds 256.
#! - the computed hash of fetched elements does not match ATTACHMENT_COMMITMENT.
@locals(1024)
proc validate_attachment(attachment_commitment: NoteAttachmentCommitment) -> u16
    # push the attachment elements from the advice map onto the advice stack
    adv.push_mapvaln
    # OS => [ATTACHMENT_COMMITMENT]
    # AS => [num_elements, [ATTACHMENT_ELEMENTS]]

    # derive num_words from num_elements
    adv_push u32assert.err=ERR_OUTPUT_NOTE_ATTACHMENT_SIZE_MAX_EXCEEDED
    u32divmod.WORD_NUM_ELEMENTS
    # OS => [remainder, num_words, ATTACHMENT_COMMITMENT]
    # AS => [[ATTACHMENT_ELEMENTS]]

    # assert the number of elements is a multiple of WORD_NUM_ELEMENTS
    eq.0 assert.err=ERR_OUTPUT_NOTE_ATTACHMENT_SIZE_MUST_BE_MULTIPLE_OF_WORD_SIZE
    # OS => [num_words, ATTACHMENT_COMMITMENT]
    # AS => [[ATTACHMENT_ELEMENTS]]

    # validate 0 < num_words <= 256
    dup neq.0 assert.err=ERR_OUTPUT_NOTE_ATTACHMENT_SIZE_CANNOT_BE_ZERO
    dup u32lte.MAX_ATTACHMENT_WORDS assert.err=ERR_OUTPUT_NOTE_ATTACHMENT_SIZE_MAX_EXCEEDED
    # OS => [num_words, ATTACHMENT_COMMITMENT]
    # AS => [[ATTACHMENT_ELEMENTS]]

    # --- Pipe elements from advice stack to local memory while hashing ---

    # we use local memory because pipe_preimage_to_memory needs to write to memory, but we only
    # need to assert that the preimage is available, the exact content itself is unimportant

    # save num_words to return it later
    dup movdn.5
    # OS => [num_words, ATTACHMENT_COMMITMENT, num_words]
    # AS => [[ATTACHMENT_ELEMENTS]]

    # SAFETY: we have allocated 1024 elements of local memory which is sufficient for the largest
    # possible attachment with 256 words
    locaddr.0 swap
    # OS => [num_words, dest_ptr, ATTACHMENT_COMMITMENT, num_words]
    # AS => [[ATTACHMENT_ELEMENTS]]

    # validate the sequential hash over the attachment elements is ATTACHMENT_COMMITMENT
    exec.mem::pipe_preimage_to_memory drop
    # OS => [num_words]
end

#! Builds the provided inputs into the NOTE_METADATA word.
#!
#! - The sender ID is set to the native account's ID.
#! - Attachment num_words and schemes are initialized to 0 (no attachments).
#!
#! Inputs:  [tag, note_type]
#! Outputs: [NOTE_METADATA]
#!
#! Where:
#! - tag is the note tag which can be used by the recipient(s) to identify notes intended for them.
#! - note_type is the type of the note, which defines how the note is to be stored (e.g., on-chain
#!   or off-chain).
#! - NOTE_METADATA is the metadata associated with a note.
pub proc build_metadata(tag: NoteTag, note_type: NoteType) -> NoteMetadata
    # Validate that note type is private (0) or public (1).
    # --------------------------------------------------------------------------------------------
    dup.1
    u32assert.err=ERR_NOTE_INVALID_TYPE u32lte.NOTE_TYPE_PUBLIC
    assert.err=ERR_NOTE_INVALID_TYPE
    # => [tag, note_type]

    # Validate the note tag fits into a u32.
    # --------------------------------------------------------------------------------------------

    # this implies the upper 32 bits are zero, which initializes the attachment num_words to 0
    u32assert.err=ERR_NOTE_TAG_MUST_BE_U32
    # => [attachment_num_words_and_tag, note_type]

    # Merge note type, version, and sender ID suffix.
    # --------------------------------------------------------------------------------------------

    exec.account::get_id
    # => [sender_id_suffix, sender_id_prefix, attachment_num_words_and_tag, note_type]

    # The lower 8 bits of the account ID suffix are guaranteed to be zero by construction.
    # Encode note_type at bit 6 and version at bits 0..=5.
    # Shifting note_type left by 6 is equivalent to multiplying by 64.
    movup.3 mul.64 add.NOTE_METADATA_VERSION_1 add
    # => [sender_id_suffix_type_version, sender_id_prefix, tag]

    # Build metadata.
    # --------------------------------------------------------------------------------------------

    # push default absent attachment schemes (four u16 zeros encoded into a zero felt)
    push.ATTACHMENT_DEFAULT_SCHEMES movdn.3
    # => [sender_id_suffix_type_version, sender_id_prefix, attachment_num_words_and_tag, attachment_schemes]
    # => [NOTE_METADATA]
end

#! Sets an output note's attachment scheme in the note metadata.
#!
#! WARNING: The attachment scheme must be valid.
#!
#! Inputs:  [num_attachments, note_ptr, attachment_scheme]
#! Outputs: []
#!
#! Where:
#! - num_attachments is the number of attachments the note had before this attachment was added.
#! - attachment_scheme is the user-defined scheme of the attachment.
#! - note_ptr is the memory address at which the output note data begins.
proc set_attachment_schemes(
    num_attachments: NoteAttachmentCount,
    note_ptr: ptr<OutputNoteData>,
    attachment_scheme: NoteAttachmentScheme
)
    # the schemes are stored as follows in the third felt:
    # 3rd felt: [
    #   attachment_3_scheme (16 bits) | attachment_2_scheme (16 bits) |
    #   attachment_1_scheme (16 bits) | attachment_0_scheme (16 bits)
    # ]
    # -> current scheme needs to be shifted left by num_attachments * 16
    # Prepare scheme and num_words.
    # --------------------------------------------------------------------------------------------
    movup.2 swap
    # => [num_attachments, attachment_scheme, note_ptr]

    # shift the scheme left by num_attachments * 16 bits using felt multiplication
    # u32shl cannot be used because the shift may be >= 32
    # left shift is done with multiplication by 2^(num_attachments * 16)
    mul.16 pow2 mul
    # => [attachment_scheme_shifted, note_ptr]

    # Fetch and update metadata.
    # --------------------------------------------------------------------------------------------

    dup.1 exec.memory::get_output_note_metadata
    # => [METADATA, attachment_scheme_shifted, note_ptr]
    # => [
    #   [sender_id_suffix_type_version, sender_id_prefix, tag, attachment_schemes],
    #   attachment_scheme_shifted, note_ptr
    # ]

    # merge scheme into existing schemes
    # (using add instead of u32or because the shifted values exceed u32; this is safe because the
    # bit ranges of the tag, existing sizes, and the new size do not overlap)
    movup.3 movup.4
    add movdn.3
    # => [[sender_id_suffix_type_version, sender_id_prefix, tag, new_attachment_schemes], note_ptr]
    # => [METADATA, note_ptr]

    movup.4 exec.memory::set_output_note_metadata dropw
    # => []
end

#! Increments the number of output notes by one. Returns the index of the next note to be created.
#!
#! Inputs:  []
#! Outputs: [note_idx]
#!
#! Where:
#! - note_idx is the index of the next note to be created.
proc increment_num_output_notes() -> u16
    # get the current number of output notes
    exec.memory::get_num_output_notes
    # => [note_idx]

    # assert that there is space for a new note
    dup push.MAX_OUTPUT_NOTES_PER_TX lt
    assert.err=ERR_TX_NUMBER_OF_OUTPUT_NOTES_EXCEEDS_LIMIT
    # => [note_idx]

    # increment the number of output notes
    dup add.1 exec.memory::set_num_output_notes
    # => [note_idx]
end

#! Adds the asset to the note specified by the ptr.
#!
#! This procedure attempts to find an asset with the same ID in the note's assets.
#! - If the asset is not found, the asset is appended at the end and the number of assets is
#!   incremented.
#! - If the asset is found and the asset is
#!   - fungible: the existing asset and the new asset are merged together.
#!   - non-fungible: the procedure panics since non-fungible assets cannot be merged.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, note_ptr]
#! Outputs: []
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to add.
#! - ASSET_VALUE is the value of the asset to add.
#! - note_ptr is the pointer to the note the asset will be added to.
#!
#! Panics if
#! - asset is fungible and adding the two asset values would exceed FUNGIBLE_ASSET_MAX_AMOUNT.
#! - asset is non-fungible and the note already contains an asset with the same ID.
proc add_asset_raw(asset: Asset, note_ptr: ptr<OutputNoteData>)
    dup.8 exec.memory::get_output_note_asset_data_ptr movdn.8
    # => [ASSET_ID, ASSET_VALUE, asset_ptr, note_ptr]

    # get the number of assets in the output note
    dup.9 exec.memory::get_output_note_num_assets
    # => [num_assets, ASSET_ID, ASSET_VALUE, asset_ptr, note_ptr]

    # compute the pointer at which we should stop iterating
    mul.ASSET_SIZE dup.9 add movdn.9
    # => [ASSET_ID, ASSET_VALUE, asset_ptr, asset_end_ptr, note_ptr]

    # initialize loop variable is_existing_asset to false
    push.0 movdn.8
    # => [ASSET_ID, ASSET_VALUE, is_existing_asset, asset_ptr, asset_end_ptr, note_ptr]

    # enter loop if asset_ptr != asset_end_ptr
    dup.10 dup.10 neq
    # => [has_assets, ASSET_ID, ASSET_VALUE, is_existing_asset, asset_ptr, asset_end_ptr, note_ptr]

    while.true
        padw dup.13 mem_loadw_le
        # => [STORED_ASSET_ID, ASSET_ID, ASSET_VALUE, is_existing_asset, asset_ptr, asset_end_ptr, note_ptr]

        exec.word::test_eq
        # => [is_matching_id, STORED_ASSET_ID, ASSET_ID, ASSET_VALUE, is_existing_asset, asset_ptr, asset_end_ptr, note_ptr]

        # set is_existing_asset = is_matching_id
        swap.13 drop dropw
        # => [ASSET_ID, ASSET_VALUE, is_existing_asset, asset_ptr, asset_end_ptr, note_ptr]

        # if is_existing_asset, increment asset_ptr by 0 (so the ptr points to the existing asset
        # after the loop)
        # if !is_existing_asset, increment asset_ptr by ASSET_SIZE
        dup.8 not mul.ASSET_SIZE
        # => [asset_size_or_0, ASSET_ID, ASSET_VALUE, is_existing_asset, asset_ptr, asset_end_ptr, note_ptr]

        # compute asset_ptr + asset_size_or_0
        movup.10 add movdn.9
        # => [ASSET_ID, ASSET_VALUE, is_existing_asset, asset_ptr, asset_end_ptr, note_ptr]

        # continue looping if (!is_existing_asset) && asset_ptr != asset_end_ptr
        dup.10 dup.10 neq
        # => [is_end_reached, ASSET_ID, ASSET_VALUE, is_existing_asset, asset_ptr, asset_end_ptr, note_ptr]

        dup.9 not and
        # => [should_loop, ASSET_ID, ASSET_VALUE, is_existing_asset, asset_ptr, asset_end_ptr, note_ptr]
    end
    # => [ASSET_ID, ASSET_VALUE, is_existing_asset, asset_ptr, asset_end_ptr, note_ptr]

    # after the loop:
    # if is_existing_asset: asset_ptr points to the entry where the existing asset is stored
    # if !is_existing_asset: asset_ptr points to the entry where the asset can be appended,
    #    i.e. asset_ptr = asset_end_ptr

    # discard asset end ptr
    movup.10 drop
    # => [ASSET_ID, ASSET_VALUE, is_existing_asset, asset_ptr, note_ptr]

    movup.8
    # => [is_existing_asset, ASSET_ID, ASSET_VALUE, asset_ptr, note_ptr]

    if.true
        # if the asset exists, do not increment num assets

        # abort if the asset is non-fungible since it cannot be merged
        exec.asset::is_fungible_asset_id
        assert.err=ERR_NON_FUNGIBLE_ASSET_ALREADY_EXISTS
        # => [ASSET_ID, ASSET_VALUE, asset_ptr, note_ptr]

        # if the asset is fungible, merge the asset values
        # overwrite asset ID on the stack with the stored asset value
        # note that asset_ptr already stores ASSET_ID so there is no need to overwrite it
        dup.8 add.ASSET_VALUE_MEMORY_OFFSET mem_loadw_le
        # => [STORED_ASSET_VALUE, ASSET_VALUE, asset_ptr, note_ptr]

        # merge the two fungible assets
        exec.fungible_asset::merge
        # => [MERGED_ASSET_VALUE, asset_ptr, note_ptr]

        # store the merged asset value
        movup.4 add.ASSET_VALUE_MEMORY_OFFSET mem_storew_le dropw drop
        # => []
    else
        # if the asset does not exist, increment num assets and append the asset

        # increment number of assets
        # this panics if the max allowed number of assets is exceeded
        # this implicitly validates that asset_ptr is not out of bounds
        movup.9 exec.memory::increment_output_note_num_assets
        # => [ASSET_ID, ASSET_VALUE, asset_ptr]

        # store ASSET_ID
        dup.8 mem_storew_le dropw
        # => [ASSET_VALUE, asset_ptr]

        # store ASSET_VALUE
        movup.4 add.ASSET_VALUE_MEMORY_OFFSET mem_storew_le dropw
        # => []
    end
end

#! Invokes the `on_before_note_sealed` callback of each distinct faucet with the asset callback flag
#! enabled among the assets of the specified note, in the order in which each faucet first occurs
#! among the note's assets, and appends the attachments each callback returns to the note.
#!
#! Inputs:  [note_ptr, note_idx]
#! Outputs: []
#!
#! Where:
#! - note_ptr is the memory address at which the output note data begins.
#! - note_idx is the index of the note whose callbacks are invoked.
#!
#! Panics if:
#! - a callback procedure root is not part of its faucet's account code.
#! - an invoked callback panics.
#! - a callback returns 0 attachments with a non-empty attachment list commitment.
#! - an attachment list returned by a callback is invalid (see `add_attachment_list`).
proc invoke_on_before_note_sealed_callbacks(note_ptr: ptr<OutputNoteData>, note_idx: u16)
    dup exec.memory::get_output_note_asset_data_ptr
    # => [assets_start_ptr, note_ptr, note_idx]

    swap exec.memory::get_output_note_num_assets
    # => [num_assets, assets_start_ptr, note_idx]

    # compute the pointer at which we should stop iterating
    mul.ASSET_SIZE dup.1 add
    # => [assets_end_ptr, assets_start_ptr, note_idx]

    dup.1
    # => [asset_ptr, assets_end_ptr, assets_start_ptr, note_idx]

    # enter the loop if the note has assets
    dup dup.2 neq
    # => [has_assets, asset_ptr, assets_end_ptr, assets_start_ptr, note_idx]

    while.true
        padw dup.4 mem_loadw_le
        # => [ASSET_ID, asset_ptr, assets_end_ptr, assets_start_ptr, note_idx]

        exec.asset::id_to_has_callbacks
        # => [has_callbacks, ASSET_ID, asset_ptr, assets_end_ptr, assets_start_ptr, note_idx]

        if.true
            exec.asset::id_into_faucet_id
            # => [faucet_id_suffix, faucet_id_prefix, asset_ptr, assets_end_ptr, assets_start_ptr,
            #     note_idx]

            dup.5 dup.3 dup.6 movup.4 movup.4
            # => [faucet_id_suffix, faucet_id_prefix, assets_start_ptr, asset_ptr, note_idx,
            #     asset_ptr, assets_end_ptr, assets_start_ptr, note_idx]

            exec.maybe_invoke_on_before_note_sealed_callback
            # => [asset_ptr, assets_end_ptr, assets_start_ptr, note_idx]
        else
            dropw
            # => [asset_ptr, assets_end_ptr, assets_start_ptr, note_idx]
        end
        # => [asset_ptr, assets_end_ptr, assets_start_ptr, note_idx]

        add.ASSET_SIZE
        # => [asset_ptr, assets_end_ptr, assets_start_ptr, note_idx]

        # continue looping while asset_ptr != assets_end_ptr
        dup dup.2 neq
        # => [should_loop, asset_ptr, assets_end_ptr, assets_start_ptr, note_idx]
    end
    # => [asset_ptr, assets_end_ptr, assets_start_ptr, note_idx]

    dropw
    # => []
end

#! Invokes the `on_before_note_sealed` callback of the provided faucet for the specified note and
#! appends the attachments the callback returns to the note, unless the callback for this faucet was
#! already invoked.
#!
#! Inputs:  [faucet_id_suffix, faucet_id_prefix, assets_start_ptr, asset_ptr, note_idx]
#! Outputs: []
#!
#! Where:
#! - faucet_id_{suffix,prefix} are the suffix and prefix felts of the ID of the faucet that issued
#!   the asset at asset_ptr.
#! - assets_start_ptr is the memory address of the note's first asset.
#! - asset_ptr is the memory address of the note asset issued by the faucet.
#! - note_idx is the index of the note whose callback is invoked.
#!
#! Panics if:
#! - the callback procedure root is not part of the faucet's account code.
#! - the invoked callback panics.
#! - the callback returns 0 attachments with a non-empty attachment list commitment.
#! - the attachment list returned by the callback is invalid (see `add_attachment_list`).
proc maybe_invoke_on_before_note_sealed_callback(
    faucet_id: AccountId,
    assets_start_ptr: ptr<Asset>,
    asset_ptr: ptr<Asset>,
    note_idx: u16
)
    # check whether the faucet already occurs among the preceding assets in kernel memory;
    # the callback flag is a bit of the faucet ID, so all assets of a faucet share it
    dup.1 dup.1 movup.5 movup.5
    # => [assets_start_ptr, asset_ptr, faucet_id_suffix, faucet_id_prefix, faucet_id_suffix,
    #     faucet_id_prefix, note_idx]

    exec.has_asset_from_faucet
    # => [is_preceding_faucet, faucet_id_suffix, faucet_id_prefix, note_idx]

    if.true
        # the callback of this faucet was already invoked
        drop drop drop
        # => []
    else
        dup.2 movdn.3
        # => [faucet_id_suffix, faucet_id_prefix, note_idx, note_idx]

        exec.callbacks::on_before_note_sealed
        # => [num_attachments, ATTACHMENT_LIST_COMMITMENT, note_idx]

        # append the attachments returned by the callback, unless it returned none
        dup neq.0
        # => [has_attachments, num_attachments, ATTACHMENT_LIST_COMMITMENT, note_idx]

        if.true
            exec.add_attachment_list
            # => []
        else
            # a callback that returns no attachment must not return a list commitment either
            drop exec.word::eqz
            assert.err=ERR_OUTPUT_NOTE_CALLBACK_ATTACHMENT_LIST_COMMITMENT_WITHOUT_ATTACHMENTS
            # => [note_idx]

            drop
            # => []
        end
    end
end

#! Appends the attachments of the provided attachment list to the note specified by the index, in
#! list order.
#!
#! The list holds two words per attachment, `[attachment_scheme, 0, 0, 0]` followed by the
#! attachment's commitment, and ATTACHMENT_LIST_COMMITMENT is the sequential hash of its elements.
#! The list elements are fetched from the advice map using ATTACHMENT_LIST_COMMITMENT as the key and
#! the commitment is verified by hashing them. Each attachment is added via `add_attachment`.
#!
#! Inputs:
#!   Operand Stack: [num_attachments, ATTACHMENT_LIST_COMMITMENT, note_idx]
#!   Advice map: {
#!     ATTACHMENT_LIST_COMMITMENT: [[ATTACHMENT_LIST_ELEMENTS]],
#!     ATTACHMENT_COMMITMENT: [[ATTACHMENT_ELEMENTS]], for each listed attachment
#!   }
#! Outputs: []
#!
#! Where:
#! - num_attachments is the number of attachments in the list.
#! - ATTACHMENT_LIST_COMMITMENT is the commitment to the attachment list.
#! - note_idx is the index of the note to which the attachments are added.
#!
#! Panics if:
#! - num_attachments exceeds 4.
#! - the number of list elements does not match num_attachments.
#! - the computed hash of the list elements does not match ATTACHMENT_LIST_COMMITMENT.
#! - the three elements after the attachment scheme of an entry are not all zero.
#! - a listed attachment is invalid or exceeds the note's attachment limits (see `add_attachment`).
@locals(32)
proc add_attachment_list(
    num_attachments: NoteAttachmentCount,
    attachment_list_commitment: NoteAttachmentListCommitment,
    note_idx: u16
)
    # bound num_attachments by the note's attachment limit, so the list fits into local memory
    dup u32assert.err=ERR_OUTPUT_NOTE_TOO_MANY_ATTACHMENTS
    u32lte.MAX_ATTACHMENTS_PER_NOTE assert.err=ERR_OUTPUT_NOTE_TOO_MANY_ATTACHMENTS
    # => [num_attachments, ATTACHMENT_LIST_COMMITMENT, note_idx]

    # push the list elements from the advice map onto the advice stack
    movdn.4 adv.push_mapvaln
    # OS => [ATTACHMENT_LIST_COMMITMENT, num_attachments, note_idx]
    # AS => [num_elements, [ATTACHMENT_LIST_ELEMENTS]]

    # assert the list holds an entry per attachment
    adv_push movup.5 mul.ATTACHMENT_LIST_ENTRY_SIZE dup movup.2
    assert_eq.err=ERR_OUTPUT_NOTE_CALLBACK_ATTACHMENT_LIST_LENGTH_MISMATCH
    # OS => [num_elements, ATTACHMENT_LIST_COMMITMENT, note_idx]
    # AS => [[ATTACHMENT_LIST_ELEMENTS]]

    # SAFETY: we have allocated 32 elements of local memory which is sufficient for the list of up
    # to 4 attachments
    u32div.WORD_NUM_ELEMENTS locaddr.0 swap
    # OS => [num_words, list_ptr, ATTACHMENT_LIST_COMMITMENT, note_idx]
    # AS => [[ATTACHMENT_LIST_ELEMENTS]]

    # validate the sequential hash over the list elements is ATTACHMENT_LIST_COMMITMENT
    exec.mem::pipe_double_words_preimage_to_memory
    # OS => [list_end_ptr, note_idx]
    # AS => []

    locaddr.0
    # => [entry_ptr, list_end_ptr, note_idx]

    dup dup.2 neq
    # => [has_entries, entry_ptr, list_end_ptr, note_idx]

    while.true
        # load the attachment scheme of the entry and assert that the rest of its word is zero
        padw dup.4 mem_loadw_le
        # => [attachment_scheme, padding(3), entry_ptr, list_end_ptr, note_idx]

        movdn.3
        assertz.err=ERR_OUTPUT_NOTE_CALLBACK_ATTACHMENT_LIST_ENTRY_PADDING_NOT_ZERO
        assertz.err=ERR_OUTPUT_NOTE_CALLBACK_ATTACHMENT_LIST_ENTRY_PADDING_NOT_ZERO
        assertz.err=ERR_OUTPUT_NOTE_CALLBACK_ATTACHMENT_LIST_ENTRY_PADDING_NOT_ZERO
        # => [attachment_scheme, entry_ptr, list_end_ptr, note_idx]

        # load the attachment commitment of the entry
        padw dup.5 add.WORD_NUM_ELEMENTS mem_loadw_le
        # => [ATTACHMENT_COMMITMENT, attachment_scheme, entry_ptr, list_end_ptr, note_idx]

        movup.4 dup.7 movdn.5
        # => [attachment_scheme, ATTACHMENT_COMMITMENT, note_idx, entry_ptr, list_end_ptr, note_idx]

        exec.add_attachment
        # => [entry_ptr, list_end_ptr, note_idx]

        add.ATTACHMENT_LIST_ENTRY_SIZE
        # => [entry_ptr, list_end_ptr, note_idx]

        # continue looping while entry_ptr != list_end_ptr
        dup dup.2 neq
        # => [has_entries, entry_ptr, list_end_ptr, note_idx]
    end
    # => [entry_ptr, list_end_ptr, note_idx]

    drop drop drop
    # => []
end

#! Returns whether any of the assets in the provided memory range was issued by the provided faucet.
#!
#! Inputs:  [start_ptr, end_ptr, faucet_id_suffix, faucet_id_prefix]
#! Outputs: [is_found]
#!
#! Where:
#! - start_ptr is the memory address of the first asset in the range.
#! - end_ptr is the memory address right after the last asset in the range.
#! - faucet_id_{suffix,prefix} are the suffix and prefix felts of the faucet ID to look for.
#! - is_found is 1 if an asset in the range was issued by the faucet, 0 otherwise.
proc has_asset_from_faucet(start_ptr: ptr<Asset>, end_ptr: ptr<Asset>, faucet_id: AccountId) -> Bool
    # initialize the loop variable is_found to false
    push.0 movdn.4
    # => [asset_ptr, end_ptr, faucet_id_suffix, faucet_id_prefix, is_found]

    # enter the loop if the range is non-empty
    dup dup.2 neq
    # => [should_loop, asset_ptr, end_ptr, faucet_id_suffix, faucet_id_prefix, is_found]

    while.true
        padw dup.4 mem_loadw_le
        # => [ASSET_ID, asset_ptr, end_ptr, faucet_id_suffix, faucet_id_prefix, is_found]

        exec.asset::id_into_faucet_id
        # => [asset_faucet_id_suffix, asset_faucet_id_prefix, asset_ptr, end_ptr, faucet_id_suffix,
        #     faucet_id_prefix, is_found]

        dup.5 dup.5 exec.account_id::eq
        # => [is_matching_faucet, asset_ptr, end_ptr, faucet_id_suffix, faucet_id_prefix, is_found]

        # set is_found = is_matching_faucet
        swap.5 drop
        # => [asset_ptr, end_ptr, faucet_id_suffix, faucet_id_prefix, is_found]

        add.ASSET_SIZE
        # => [asset_ptr, end_ptr, faucet_id_suffix, faucet_id_prefix, is_found]

        # continue looping while (!is_found) && asset_ptr != end_ptr
        dup dup.2 neq dup.5 not and
        # => [should_loop, asset_ptr, end_ptr, faucet_id_suffix, faucet_id_prefix, is_found]
    end
    # => [asset_ptr, end_ptr, faucet_id_suffix, faucet_id_prefix, is_found]

    dropw
    # => [is_found]
end
