use {Asset, AssetId, AssetValue, Bool, StorageMapKey} from miden::protocol_utils::types
use {Commitment} from miden::tx_kernel_core::types
use miden::tx_kernel_core::account
use miden::tx_kernel_core::asset
use miden::tx_kernel_core::link_map
use miden::tx_kernel_core::memory
use miden::core::crypto::hashes::eidos
use miden::core::word
use {ASSET_SIZE, COMPOSITION_NONE} from miden::tx_kernel_core::asset
use {STORAGE_SLOT_TYPE_MAP, STORAGE_SLOT_TYPE_VALUE} from miden::tx_kernel_core::constants
use {
    ACCOUNT_UPDATE_BODY_BLOCK_BALANCE_PTR,
    ACCOUNT_UPDATE_ASSET_PTR,
} from miden::tx_kernel_core::memory

# ERRORS
# =================================================================================================

const ERR_ACCOUNT_DELTA_NONCE_MUST_BE_INCREMENTED_IF_STATE_CHANGED =
    "nonce in delta must have been incremented if account vault, storage or code changed"

const ERR_ACCOUNT_PATCH_NONCE_MUST_BE_INCREMENTED_IF_STATE_CHANGED =
    "final nonce in patch must have been incremented if account vault, storage or code changed"

const ERR_ACCOUNT_DELTA_TOO_MANY_ADDED_ASSETS =
    "number of added assets in the transaction exceeds the maximum limit of 1024"

const ERR_ACCOUNT_DELTA_TOO_MANY_REMOVED_ASSETS =
    "number of removed assets in the transaction exceeds the maximum limit of 1024"

const ERR_ACCOUNT_STORAGE_SLOT_TYPE_IS_INVALID =
    "account storage slot has an unsupported type"

const ERR_ACCOUNT_PATCH_COMMITMENT_BODY_BLOCK_COUNT_MISMATCH =
    "advised account patch commitment body block count does not match the committed blocks"

const ERR_ACCOUNT_DELTA_COMMITMENT_BODY_BLOCK_COUNT_MISMATCH =
    "advised account delta commitment body block count does not match the committed blocks"

# EVENTS
# =================================================================================================

const ACCOUNT_PUSH_PATCH_COMMITMENT_BODY_BLOCK_COUNT_EVENT =
    event(
        "miden::protocol::account::push_patch_commitment_body_block_count"
    )

const ACCOUNT_PUSH_DELTA_COMMITMENT_BODY_BLOCK_COUNT_EVENT =
    event(
        "miden::protocol::account::push_delta_commitment_body_block_count"
    )

const ACCOUNT_BEFORE_ASSET_DELTA_COMPUTATION =
    event(
        "miden::protocol::account::before_asset_delta_computation"
    )

const ACCOUNT_ON_ASSET_DELTA_COMPUTATION_EVENT =
    event(
        "miden::protocol::account::on_asset_delta_computation"
    )

# CONSTANTS
# =================================================================================================

# Eidos chaining-word bases for the registered patch and delta selectors. The runtime message
# length is added to the second element.
const ACCOUNT_DELTA_INIT_CHAINING_WORD_BASE = [
    13503953893981159680,
    11912009168875159552,
    11170449401267093504,
    6620516959492505600
]
const ACCOUNT_PATCH_INIT_CHAINING_WORD_BASE = [
    13503953893981159424,
    11912009168875159552,
    11170449401267093504,
    6620516959492505600
]

# Commitments to empty account delta and patch sequences. Each constant is
# `compress(init(selector, [0, 0, 0]), [0; 8])`, the canonical empty Felt-sequence schedule.
const EMPTY_ACCOUNT_DELTA_COMMITMENT = [
    8292991568228380395,
    1876249661191940156,
    3896705554151638940,
    6474550384860585012
]
const EMPTY_ACCOUNT_PATCH_COMMITMENT = [
    8993446452386704821,
    7499964366539394952,
    1842532860888739401,
    4352486794573617518
]

#! The domain of an asset in a delta or patch commitment.
const DOMAIN_ASSET = 1
#! The domain of a value storage slot in a delta or patch commitment.
const DOMAIN_VALUE = 2
#! The domain of a map storage slot in a delta or patch commitment.
const DOMAIN_MAP = 3
#! The domain of the account code in a delta or patch commitment.
const DOMAIN_CODE = 4

#! The version of the delta commitment layout.
const DELTA_VERSION_1 = 1

#! The version of the patch commitment layout.
const PATCH_VERSION_1 = 1

#! The delta operation indicating that an asset was added.
const DELTA_OP_ADD = 1

#! The delta operation indicating that an asset was removed.
const DELTA_OP_REMOVE = 2

#! The patch operation indicating an update to a slot.
const PATCH_OP_UPDATE = 1

#! Locals in commit_asset_delta. The last region is a buffer of removed assets that is hashed after
#! the added-assets section.
const COMMIT_ASSET_DELTA_HAS_NEXT_LOC = 0
const COMMIT_ASSET_DELTA_ITER_LOC = 1
const COMMIT_ASSET_DELTA_NUM_ADDED_LOC = 2
const COMMIT_ASSET_DELTA_NUM_REMOVED_LOC = 3
const COMMIT_ASSET_DELTA_REMOVED_ASSETS_LOC = 4

#! Locals in commit_asset_patch.
const COMMIT_ASSET_PATCH_HAS_NEXT_LOC = 0
const COMMIT_ASSET_PATCH_ITER_LOC = 1
const COMMIT_ASSET_PATCH_NUM_CHANGED_LOC = 2

#! The maximum number of assets that can be removed in a single transaction.
#!
#! This limit is arbitrary and can be increased accordingly with the number of locals of
#! commit_asset_delta.
const MAX_ASSETS_PER_DELTA_OP = 1024

# PROCEDURES
# =================================================================================================

# DELTA & PATCH COMPUTATION
# -------------------------------------------------------------------------------------------------

#! Computes the commitment to the native account's patch.
#!
#! See the Rust function `AccountPatch::to_commitment` for a detailed description of how it is computed.
#!
#! Inputs:  []
#! Outputs: [PATCH_COMMITMENT]
#!
#! Where:
#! - PATCH_COMMITMENT is the commitment to the account patch.
#!
#! Panics if:
#! - the vault, storage or code patch is not empty but the nonce increment is zero.
#!
#! Invocation: exec
pub proc compute_patch_commitment() -> Commitment
    emit.ACCOUNT_PUSH_PATCH_COMMITMENT_BODY_BLOCK_COUNT_EVENT
    adv_push
    u32assert.err=ERR_ACCOUNT_PATCH_COMMITMENT_BODY_BLOCK_COUNT_MISMATCH
    # => [num_body_blocks]

    dup neg
    # => [negative_num_body_blocks, num_body_blocks]

    mem_store.ACCOUNT_UPDATE_BODY_BLOCK_BALANCE_PTR
    # => [num_body_blocks]

    # the advised count excludes the fixed metadata header block
    add.1 mul.8
    # => [num_elements]

    push.ACCOUNT_PATCH_INIT_CHAINING_WORD_BASE
    exec.prepare_commitment_chaining_word
    # => [CHAINING_WORD]

    # the high word of the metadata header is empty
    padw
    # => [EMPTY_WORD, CHAINING_WORD]

    exec.memory::get_native_account_id
    # => [native_account_id_suffix, native_account_id_prefix, EMPTY_WORD, CHAINING_WORD]

    # get the nonce of the account and assume it is the final nonce
    # we later assert that the nonce was incremented (unless the patch is empty)
    exec.memory::get_native_account_nonce
    push.PATCH_VERSION_1
    # => [patch_version, final_nonce, native_account_id_suffix, native_account_id_prefix, EMPTY_WORD, CHAINING_WORD]
    # => [METADATA, EMPTY_WORD, CHAINING_WORD]

    exec.eidos::compress dropw dropw
    # => [CHAINING_WORD]

    # save the metadata digest for a later check
    dupw
    # => [CHAINING_WORD, METADATA_DIGEST]

    exec.commit_asset_patch
    # => [CHAINING_WORD, METADATA_DIGEST]

    exec.commit_storage_patch
    # => [CHAINING_WORD, METADATA_DIGEST]

    exec.commit_code_section
    # => [CHAINING_WORD, METADATA_DIGEST]

    mem_load.ACCOUNT_UPDATE_BODY_BLOCK_BALANCE_PTR
    assertz.err=ERR_ACCOUNT_PATCH_COMMITMENT_BODY_BLOCK_COUNT_MISMATCH
    # => [PATCH_COMMITMENT, METADATA_DIGEST]

    exec.was_nonce_incremented not
    # => [!was_nonce_incremented, PATCH_COMMITMENT, METADATA_DIGEST]

    if.true
        # if the nonce wasn't incremented, then the vault, storage and code patches must be empty,
        # which is the case if the patch commitment is equal to METADATA_DIGEST
        assert_eqw.err=ERR_ACCOUNT_PATCH_NONCE_MUST_BE_INCREMENTED_IF_STATE_CHANGED
        # => []

        push.EMPTY_ACCOUNT_PATCH_COMMITMENT
        # => [PATCH_COMMITMENT]
    else
        # drop the metadata digest
        swapw dropw
        # => [PATCH_COMMITMENT]
    end
end

#! Computes the commitment to the native account's delta.
#!
#! See the Rust function `AccountDelta::to_commitment` for a detailed description of how it is computed.
#!
#! Inputs:  []
#! Outputs: [DELTA_COMMITMENT]
#!
#! Where:
#! - DELTA_COMMITMENT is the commitment to the account delta.
#!
#! Panics if:
#! - the vault, storage or code delta is not empty but the nonce increment is zero.
#!
#! Invocation: exec
pub proc compute_delta_commitment() -> Commitment
    emit.ACCOUNT_PUSH_DELTA_COMMITMENT_BODY_BLOCK_COUNT_EVENT
    adv_push
    u32assert.err=ERR_ACCOUNT_DELTA_COMMITMENT_BODY_BLOCK_COUNT_MISMATCH
    # => [num_body_blocks]

    dup neg
    # => [negative_num_body_blocks, num_body_blocks]

    mem_store.ACCOUNT_UPDATE_BODY_BLOCK_BALANCE_PTR
    # => [num_body_blocks]

    # the advised count excludes the fixed metadata header block
    add.1 mul.8
    # => [num_elements]

    push.ACCOUNT_DELTA_INIT_CHAINING_WORD_BASE
    exec.prepare_commitment_chaining_word
    # => [CHAINING_WORD]

    # the high word of the metadata header is empty
    padw
    # => [EMPTY_WORD, CHAINING_WORD]

    exec.memory::get_native_account_id
    # => [native_acct_id_suffix, native_acct_id_prefix, EMPTY_WORD, CHAINING_WORD]

    # the delta of the nonce is equal to was_nonce_incremented
    exec.was_nonce_incremented push.DELTA_VERSION_1
    # => [delta_version, nonce_delta, native_acct_id_suffix, native_acct_id_prefix, EMPTY_WORD, CHAINING_WORD]
    # => [METADATA, EMPTY_WORD, CHAINING_WORD]

    exec.eidos::compress dropw dropw
    # => [CHAINING_WORD]

    # save the metadata digest for a later check
    dupw
    # => [CHAINING_WORD, METADATA_DIGEST]

    exec.commit_asset_delta
    # => [CHAINING_WORD, METADATA_DIGEST]

    exec.commit_storage_patch
    # => [CHAINING_WORD, METADATA_DIGEST]

    exec.commit_code_section
    # => [CHAINING_WORD, METADATA_DIGEST]

    mem_load.ACCOUNT_UPDATE_BODY_BLOCK_BALANCE_PTR
    assertz.err=ERR_ACCOUNT_DELTA_COMMITMENT_BODY_BLOCK_COUNT_MISMATCH
    # => [DELTA_COMMITMENT, METADATA_DIGEST]

    exec.was_nonce_incremented not
    # => [!was_nonce_incremented, DELTA_COMMITMENT, METADATA_DIGEST]

    if.true
        # if the nonce wasn't incremented, then the vault, storage and code deltas must be empty,
        # which is the case if the delta commitment is equal to METADATA_DIGEST
        assert_eqw.err=ERR_ACCOUNT_DELTA_NONCE_MUST_BE_INCREMENTED_IF_STATE_CHANGED
        # => []

        push.EMPTY_ACCOUNT_DELTA_COMMITMENT
        # => [DELTA_COMMITMENT]
    else
        # drop the metadata digest
        swapw dropw
        # => [DELTA_COMMITMENT]
    end
end

#! Adds a number of emitted blocks to the patch or delta commitment's body-block balance.
#!
#! The balance starts at the negated advised count. The u32 message-length check bounds that count
#! below 2^29, and the transaction cycle limit places the same bound on the number of blocks the
#! kernel can emit. The final balance is therefore zero exactly
#! when the two counts agree; field wraparound cannot make unequal counts compare equal.
#!
#! Inputs:  [num_blocks]
#! Outputs: []
#!
#! Invocation: exec
proc consume_commitment_body_blocks(num_blocks: u32)
    mem_load.ACCOUNT_UPDATE_BODY_BLOCK_BALANCE_PTR
    add
    mem_store.ACCOUNT_UPDATE_BODY_BLOCK_BALANCE_PTR
end

#! Compresses one patch or delta body block and accounts for it in the advised message length.
#!
#! Inputs:  [BLOCK_LO, BLOCK_HI, CHAINING_WORD]
#! Outputs: [CHAINING_WORD']
#!
#! Invocation: exec
proc compress_commitment_body_block(state: eidos::State) -> eidos::Digest
    exec.eidos::compress dropw dropw
    # => [CHAINING_WORD']

    mem_load.ACCOUNT_UPDATE_BODY_BLOCK_BALANCE_PTR
    add.1
    mem_store.ACCOUNT_UPDATE_BODY_BLOCK_BALANCE_PTR
end

#! Prepares a patch or delta chaining word from its selector base and message length.
#!
#! Inputs:  [CHAINING_WORD_BASE, num_elements]
#! Outputs: [CHAINING_WORD]
#!
#! Invocation: exec
proc prepare_commitment_chaining_word(
    chaining_word_base: eidos::ChainingValue,
    num_elements: u32
) -> eidos::ChainingValue
    movup.4
    # => [num_elements, CHAINING_WORD_BASE]

    u32assert.err="account commitment length must fit in a u32"
    movup.2
    # => [base_1, num_elements, base_0, base_2, base_3]

    add swap
    # => [CHAINING_WORD]
end

#! Updates the patch or delta chaining word with the storage slot patches.
#!
#! Inputs:  [CHAINING_WORD]
#! Outputs: [CHAINING_WORD]
proc commit_storage_patch(chaining_word: eidos::ChainingValue) -> eidos::ChainingValue
    exec.memory::get_native_num_storage_slots movdn.4
    # => [CHAINING_WORD, num_storage_slots]

    push.0 movdn.4
    # => [CHAINING_WORD, slot_idx = 0, num_storage_slots]

    # loop if num_storage_slots != 0
    dup.5 neq.0
    # => [should_loop, CHAINING_WORD, slot_idx, num_storage_slots]

    while.true
        dup.4
        # => [slot_idx, CHAINING_WORD, slot_idx, num_storage_slots]

        exec.commit_slot_patch
        # => [CHAINING_WORD, slot_idx, num_storage_slots]

        # increment slot index
        movup.4 add.1
        # => [next_slot_idx, CHAINING_WORD, num_storage_slots]

        dup movdn.5
        # => [next_slot_idx, CHAINING_WORD, next_slot_idx, num_storage_slots]

        # continue if next_slot_idx != num_storage_slots
        # we use neq instead of lt for efficiency
        dup.6 neq
        # => [should_loop, CHAINING_WORD, next_slot_idx, num_storage_slots]
    end
    # => [CHAINING_WORD, next_slot_idx, num_storage_slots]

    # clean the stack
    movup.4 drop movup.4 drop
    # => [CHAINING_WORD]
end

#! Updates the patch or delta chaining word with the storage slot at the provided index.
#!
#! Inputs:  [slot_idx, CHAINING_WORD]
#! Outputs: [CHAINING_WORD]
proc commit_slot_patch(slot_idx: u8, chaining_word: eidos::ChainingValue) -> eidos::ChainingValue
    dup exec.account::get_native_storage_slot_type
    # => [storage_slot_type, slot_idx, CHAINING_WORD]

    # check if slot is of type value
    dup push.STORAGE_SLOT_TYPE_VALUE eq
    # => [is_value_slot_type, storage_slot_type, slot_idx, CHAINING_WORD]

    if.true
        drop
        # => [slot_idx, CHAINING_WORD]

        exec.commit_value_slot_patch
    else
        # reject any type that is neither value nor map instead of defaulting to map
        push.STORAGE_SLOT_TYPE_MAP eq assert.err=ERR_ACCOUNT_STORAGE_SLOT_TYPE_IS_INVALID
        # => [slot_idx, CHAINING_WORD]

        exec.commit_map_slot_patch
    end
    # => [CHAINING_WORD]
end

#! Updates the chaining word with the native account's code commitment, if the account is new or
#! its code is upgraded.
#!
#! Inputs:  [CHAINING_WORD]
#! Outputs: [CHAINING_WORD]
proc commit_code_section(chaining_word: eidos::ChainingValue) -> eidos::ChainingValue
    exec.memory::is_new_account
    # => [is_new_account, CHAINING_WORD]

    dup exec.memory::has_code_upgrade or
    # => [has_code, is_new_account, CHAINING_WORD]

    if.true
        # a new account cannot be upgraded, so its code is the current code and the code of an
        # existing account is the pending upgrade
        exec.memory::get_code_upgrade_commitment
        exec.memory::get_account_code_commitment
        # => [CURRENT_CODE_COMMITMENT, UPGRADE_CODE_COMMITMENT, is_new_account, CHAINING_WORD]

        movup.8
        # => [is_new_account, CURRENT_CODE_COMMITMENT, UPGRADE_CODE_COMMITMENT, CHAINING_WORD]

        # If is_new_account CURRENT_CODE_COMMITMENT remains.
        # If !is_new_account UPGRADE_CODE_COMMITMENT remains.
        cdropw
        # => [CODE_COMMITMENT, CHAINING_WORD]

        push.0.0.0.DOMAIN_CODE
        # => [[domain_code, 0, 0, 0], CODE_COMMITMENT, CHAINING_WORD]

        exec.compress_commitment_body_block
        # => [CHAINING_WORD]
    else
        drop
        # => [CHAINING_WORD]
    end
end

#! Returns the storage delta operation for the native account's storage slots.
#!
#! In the absence of storage upgrades, every slot of a new account is considered _created_, and
#! every slot of an existing account is considered _updated_.
#!
#! Inputs:  []
#! Outputs: [patch_op]
proc get_storage_slot_patch_op() -> u8
    # negate the is_new_account flag to get the patch operation
    # `is_new_account` maps to Create = 0
    # `!is_new_account` maps to Update = 1
    exec.memory::is_new_account not
end

#! Updates the patch or delta chaining word with the value storage slot at the provided index.
#!
#! Inputs:  [slot_idx, CHAINING_WORD]
#! Outputs: [CHAINING_WORD]
proc commit_value_slot_patch(slot_idx: u8, chaining_word: eidos::ChainingValue) -> eidos::ChainingValue
    exec.account::get_item_patch
    # => [INIT_VALUE, CURRENT_VALUE, slot_id_suffix, slot_id_prefix, CHAINING_WORD]

    exec.word::test_eq
    # => [has_not_changed, INIT_VALUE, CURRENT_VALUE, slot_id_suffix, slot_id_prefix, CHAINING_WORD]

    # do not commit the slot if the operation is Update and the value hasn't changed
    # in particular, this means we commit the patch if the slot was created or removed
    exec.get_storage_slot_patch_op eq.PATCH_OP_UPDATE and
    # => [should_not_commit, INIT_VALUE, CURRENT_VALUE, slot_id_suffix, slot_id_prefix, CHAINING_WORD]

    not
    # => [should_commit, INIT_VALUE, CURRENT_VALUE, slot_id_suffix, slot_id_prefix, CHAINING_WORD]

    # only include in delta if the slot's value has changed or the account is new
    if.true
        # drop init value
        dropw
        # => [CURRENT_VALUE, slot_id_suffix, slot_id_prefix, CHAINING_WORD]

        # build value slot metadata
        movup.5 movup.5
        # => [slot_id_suffix, slot_id_prefix, CURRENT_VALUE, CHAINING_WORD]

        exec.get_storage_slot_patch_op push.DOMAIN_VALUE
        # => [[domain_value, patch_op, slot_id_suffix, slot_id_prefix], CURRENT_VALUE, CHAINING_WORD]

        exec.compress_commitment_body_block
        # => [CHAINING_WORD]
    else
        # drop init value, current value and slot name
        dropw dropw drop drop
        # => [CHAINING_WORD]
    end
    # => [CHAINING_WORD]
end

#! Updates the patch or delta chaining word with the map storage slot at the provided index.
#!
#! Inputs:  [slot_idx, CHAINING_WORD]
#! Outputs: [CHAINING_WORD]
#!
#! Locals:
#! - 0: slot_id_suffix
#! - 1: slot_id_prefix
#! - 2: has_next
#! - 3: iter
#! - 4: num_changed_entries
@locals(5)
proc commit_map_slot_patch(slot_idx: u8, chaining_word: eidos::ChainingValue) -> eidos::ChainingValue
    # initialize num_changed_entries = 0
    # this is necessary because this procedure can be called multiple times and the second
    # invocation shouldn't reuse the first invocation's value
    push.0 loc_store.4
    # => [slot_idx, CHAINING_WORD]

    dup exec.account::get_native_slot_id
    # => [slot_id_suffix, slot_id_prefix, slot_idx, CHAINING_WORD]

    loc_store.0 loc_store.1
    # => [slot_idx, CHAINING_WORD]

    exec.memory::get_account_patch_storage_map_ptr
    # => [account_patch_storage_map_ptr, CHAINING_WORD]

    exec.link_map::iter
    # => [has_next, iter, CHAINING_WORD]

    # enter loop if the link map is not empty
    while.true
        exec.link_map::next_key_double_value
        # => [KEY, INIT_VALUE, NEW_VALUE, has_next, iter, CHAINING_WORD]

        # store has_next
        movup.12 loc_store.2
        # => [KEY, INIT_VALUE, NEW_VALUE, iter, CHAINING_WORD]

        # store iter
        movup.12 loc_store.3
        # => [KEY, INIT_VALUE, NEW_VALUE, CHAINING_WORD]

        swapw.2
        # => [NEW_VALUE, INIT_VALUE, KEY, CHAINING_WORD]

        exec.word::test_eq not
        # => [was_changed, NEW_VALUE, INIT_VALUE, KEY, CHAINING_WORD]

        # if the key-value pair has actually changed, update the hasher
        if.true
            # drop the initial value
            swapw dropw swapw
            # => [KEY, NEW_VALUE, CHAINING_WORD]

            # increment number of changed entries in local
            loc_load.4 add.1 loc_store.4
            # => [KEY, NEW_VALUE, CHAINING_WORD]

            exec.eidos::compress dropw dropw
            # => [CHAINING_WORD]
        else
            # discard the key and init and new value words loaded from the map
            dropw dropw dropw
            # => [CHAINING_WORD]
        end
        # => [CHAINING_WORD]

        # load iter and has_next
        loc_load.3
        # => [iter, CHAINING_WORD]

        loc_load.2
        # => [has_next, iter, CHAINING_WORD]
    end

    # drop iter
    drop
    # => [CHAINING_WORD]

    loc_load.4 eq.0
    # => [is_num_changed_entries_zero, CHAINING_WORD]

    # omit the map slot trailer if the operation is Update and the number of changed entries is
    # zero
    # in particular, this means we commit the trailer if the slot was created or removed
    exec.get_storage_slot_patch_op eq.PATCH_OP_UPDATE and
    # => [should_not_commit, CHAINING_WORD]

    not
    # => [should_commit, CHAINING_WORD]

    if.true
        # account for the changed entries and the map trailer together
        loc_load.4 add.1 exec.consume_commitment_body_blocks
        # => [CHAINING_WORD]

        # build the high block word holding the number of changed entries
        push.0.0.0 loc_load.4
        # => [[num_changed_entries, 0, 0, 0], CHAINING_WORD]

        # build the map slot metadata as the low block word
        loc_load.1 loc_load.0 exec.get_storage_slot_patch_op push.DOMAIN_MAP
        # => [[domain_map, patch_op, slot_id_suffix, slot_id_prefix], [num_changed_entries, 0, 0, 0], CHAINING_WORD]

        exec.eidos::compress dropw dropw
        # => [CHAINING_WORD]
    end
end

#! Updates the account-delta chaining word with the asset vault delta.
#!
#! It iterates the asset delta link map once and processes the added assets first. It writes the
#! removed assets into local memory to enable a subsequent iteration over linear memory rather than
#! a second expensive link map iteration that would have to skip added assets.
#!
#! Inputs:  [CHAINING_WORD]
#! Outputs: [CHAINING_WORD]
#!
#! Locals:
#! - 0: has_next
#! - 1: iter
#! - 2: num_added_assets
#! - 3: num_removed_assets
#! - 4..8196: removed_assets (MAX_ASSETS_PER_DELTA_OP * ASSET_SIZE elements)
@locals(8196)
proc commit_asset_delta(chaining_word: eidos::ChainingValue) -> eidos::ChainingValue
    # initialize num_added_assets = 0 and num_removed_assets = 0
    # this is necessary because this procedure can be called multiple times and the second
    # invocation shouldn't reuse the first invocation's values
    push.0 loc_store.COMMIT_ASSET_DELTA_NUM_ADDED_LOC
    push.0 loc_store.COMMIT_ASSET_DELTA_NUM_REMOVED_LOC

    # signal to the host that delta computation is starting so it can reset its accumulating
    # vault delta. this is necessary because compute_delta_commitment can be invoked multiple times
    # in a single transaction (e.g. by auth and the epilogue) and each invocation re-emits the
    # ACCOUNT_ON_ASSET_DELTA_COMPUTATION events.
    emit.ACCOUNT_BEFORE_ASSET_DELTA_COMPUTATION

    # Iterate asset delta.
    # Add added assets into the hasher.
    # Store removed assets to memory for later processing.
    # ---------------------------------------------------------------------------------------------

    push.ACCOUNT_UPDATE_ASSET_PTR
    # => [asset_delta_map_ptr, CHAINING_WORD]

    exec.link_map::iter
    # => [has_next, iter, CHAINING_WORD]

    # enter loop if the link map is not empty
    while.true
        exec.link_map::next_key_double_value
        # => [ASSET_ID, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, has_next, iter, CHAINING_WORD]

        # store has_next and iter
        movup.12 loc_store.COMMIT_ASSET_DELTA_HAS_NEXT_LOC
        movup.12 loc_store.COMMIT_ASSET_DELTA_ITER_LOC
        # => [ASSET_ID, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, CHAINING_WORD]

        movdnw.2 exec.word::test_eq not
        # => [has_asset_changed, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID, CHAINING_WORD]

        if.true
            exec.compute_asset_delta
            # => [delta_op, ASSET_ID, DELTA_ASSET_VALUE, CHAINING_WORD]

            emit.ACCOUNT_ON_ASSET_DELTA_COMPUTATION_EVENT
            # => [delta_op, ASSET_ID, DELTA_ASSET_VALUE, CHAINING_WORD]

            eq.DELTA_OP_ADD
            # => [is_addition, ASSET_ID, DELTA_ASSET_VALUE, CHAINING_WORD]

            if.true
                loc_load.COMMIT_ASSET_DELTA_NUM_ADDED_LOC
                dup neq.MAX_ASSETS_PER_DELTA_OP
                assert.err=ERR_ACCOUNT_DELTA_TOO_MANY_ADDED_ASSETS

                # increment num_added_assets
                add.1
                loc_store.COMMIT_ASSET_DELTA_NUM_ADDED_LOC
                # => [ASSET_ID, DELTA_ASSET_VALUE, CHAINING_WORD]

                exec.eidos::compress dropw dropw
                # => [CHAINING_WORD]
            else
                loc_load.COMMIT_ASSET_DELTA_NUM_REMOVED_LOC
                # => [num_removed_assets, ASSET_ID, DELTA_ASSET_VALUE, CHAINING_WORD]

                # make sure we do not write outside the assigned number of locals
                dup neq.MAX_ASSETS_PER_DELTA_OP
                assert.err=ERR_ACCOUNT_DELTA_TOO_MANY_REMOVED_ASSETS
                # => [num_removed_assets, ASSET_ID, DELTA_ASSET_VALUE, CHAINING_WORD]

                # compute the pointer at which to store the removed asset as
                # locaddr.removed_assets_ptr + num_removed_assets * ASSET_SIZE
                mul.ASSET_SIZE
                locaddr.COMMIT_ASSET_DELTA_REMOVED_ASSETS_LOC
                add
                # => [removed_assets_ptr, ASSET_ID, DELTA_ASSET_VALUE, CHAINING_WORD]

                exec.asset::store
                # => [CHAINING_WORD]

                # increment num_removed_assets
                loc_load.COMMIT_ASSET_DELTA_NUM_REMOVED_LOC
                add.1
                loc_store.COMMIT_ASSET_DELTA_NUM_REMOVED_LOC
                # => [CHAINING_WORD]
            end
        else
            # discard the values loaded from the map
            dropw dropw dropw
            # => [CHAINING_WORD]
        end
        # => [CHAINING_WORD]

        # load iter and has_next
        loc_load.COMMIT_ASSET_DELTA_ITER_LOC
        loc_load.COMMIT_ASSET_DELTA_HAS_NEXT_LOC
        # => [has_next, iter, CHAINING_WORD]
    end

    # drop iter
    drop
    # => [CHAINING_WORD]

    # Add the added assets trailer if num_added_assets != 0.
    # ---------------------------------------------------------------------------------------------

    loc_load.COMMIT_ASSET_DELTA_NUM_ADDED_LOC push.DELTA_OP_ADD
    exec.commit_asset_count_trailer
    # => [CHAINING_WORD]

    # Hash the removed assets.
    # ---------------------------------------------------------------------------------------------

    locaddr.COMMIT_ASSET_DELTA_REMOVED_ASSETS_LOC dup
    # => [start_ptr, start_ptr, CHAINING_WORD]

    loc_load.COMMIT_ASSET_DELTA_NUM_REMOVED_LOC
    # => [num_removed_assets, start_ptr, start_ptr, CHAINING_WORD]

    mul.ASSET_SIZE add
    # => [end_ptr, start_ptr, CHAINING_WORD]

    # The memory absorber needs block lanes even for an empty range.
    movdn.5 movdn.4
    # => [CHAINING_WORD, start_ptr, end_ptr]

    padw padw
    # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, start_ptr, end_ptr]

    exec.eidos::absorb_double_words_from_memory
    # => [BLOCK_LO, BLOCK_HI, CHAINING_WORD, end_ptr, end_ptr]

    exec.eidos::digest
    # => [CHAINING_WORD, end_ptr, end_ptr]

    movup.4 drop movup.4 drop
    # => [CHAINING_WORD]

    # Add the removed assets trailer if num_removed_assets != 0.
    # ---------------------------------------------------------------------------------------------

    loc_load.COMMIT_ASSET_DELTA_NUM_REMOVED_LOC push.DELTA_OP_REMOVE
    exec.commit_asset_count_trailer
    # => [CHAINING_WORD]
end

#! Compresses a trailer that commits to the number of assets affected by the given delta operation.
#! If num_assets is zero, this is a no-op and the chaining word is preserved.
#!
#! Inputs:  [delta_op, num_assets, CHAINING_WORD]
#! Outputs: [CHAINING_WORD]
#!
#! Where:
#! - delta_op is the delta operation (DELTA_OP_ADD or DELTA_OP_REMOVE).
#! - num_assets is the number of assets affected by delta_op (added or removed).
proc commit_asset_count_trailer(
    delta_op: u8,
    num_assets: u32,
    chaining_word: eidos::ChainingValue
) -> eidos::ChainingValue
    dup.1 neq.0
    # => [is_non_zero, delta_op, num_assets, CHAINING_WORD]

    if.true
        # Account for the asset blocks and their trailer together.
        dup.1 add.1 exec.consume_commitment_body_blocks

        # build the metadata
        push.0 movdn.2 push.DOMAIN_ASSET
        # => [[domain, delta_op, num_assets, 0], CHAINING_WORD]

        # prepend the empty word that follows the metadata word as the second hasher input
        padw swapw
        # => [[domain, delta_op, num_assets, 0], EMPTY_WORD, CHAINING_WORD]

        exec.eidos::compress dropw dropw
        # => [CHAINING_WORD]
    else
        # discard delta_op and num_assets
        drop drop
        # => [CHAINING_WORD]
    end
end

#! Updates the account-patch chaining word with the asset vault patches.
#!
#! Inputs:  [CHAINING_WORD]
#! Outputs: [CHAINING_WORD]
#!
#! Locals:
#! - 0: has_next
#! - 1: iter
#! - 2: num_changed_assets
@locals(3)
proc commit_asset_patch(chaining_word: eidos::ChainingValue) -> eidos::ChainingValue
    # initialize num_changed_assets = 0
    # this is necessary because this procedure can be called multiple times and the second
    # invocation shouldn't reuse the first invocation's values
    push.0 loc_store.COMMIT_ASSET_PATCH_NUM_CHANGED_LOC

    # Iterate and hash asset patches.
    # ---------------------------------------------------------------------------------------------

    push.ACCOUNT_UPDATE_ASSET_PTR
    # => [asset_delta_map_ptr, CHAINING_WORD]

    exec.link_map::iter
    # => [has_next, iter, CHAINING_WORD]

    # enter loop if the link map is not empty
    while.true
        exec.link_map::next_key_double_value
        # => [ASSET_ID, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, has_next, iter, CHAINING_WORD]

        # store has_next and iter
        movup.12 loc_store.COMMIT_ASSET_PATCH_HAS_NEXT_LOC
        movup.12 loc_store.COMMIT_ASSET_PATCH_ITER_LOC
        # => [ASSET_ID, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, CHAINING_WORD]

        movdnw.2 exec.word::test_eq not
        # => [has_asset_changed, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID, CHAINING_WORD]

        if.true
            # increment num_changed_assets
            loc_load.COMMIT_ASSET_PATCH_NUM_CHANGED_LOC
            add.1
            loc_store.COMMIT_ASSET_PATCH_NUM_CHANGED_LOC
            # => [INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID, CHAINING_WORD]

            # drop initial value
            dropw swapw
            # => [ASSET_ID, FINAL_ASSET_VALUE, CHAINING_WORD]

            exec.eidos::compress dropw dropw
            # => [CHAINING_WORD]
        else
            # discard the values loaded from the map
            dropw dropw dropw
            # => [CHAINING_WORD]
        end
        # => [CHAINING_WORD]

        # load iter and has_next
        loc_load.COMMIT_ASSET_PATCH_ITER_LOC
        loc_load.COMMIT_ASSET_PATCH_HAS_NEXT_LOC
        # => [has_next, iter, CHAINING_WORD]
    end

    # drop iter
    drop
    # => [CHAINING_WORD]

    # Add the asset patch trailer if num_changed_assets != 0.
    # ---------------------------------------------------------------------------------------------

    loc_load.COMMIT_ASSET_PATCH_NUM_CHANGED_LOC neq.0
    if.true
        # Account for the changed assets and their trailer together.
        loc_load.COMMIT_ASSET_PATCH_NUM_CHANGED_LOC add.1
        exec.consume_commitment_body_blocks

        padw push.0.0
        loc_load.COMMIT_ASSET_PATCH_NUM_CHANGED_LOC
        push.DOMAIN_ASSET
        # => [[domain, num_changed_assets, 0, 0], EMPTY_WORD, CHAINING_WORD]

        exec.eidos::compress dropw dropw
        # => [CHAINING_WORD]
    end
end

# ACCOUNT UPDATE BOOKKEEPING
# -------------------------------------------------------------------------------------------------

#! Returns a flag indicating whether the account's nonce was incremented.
#!
#! Inputs:  []
#! Outputs: [was_nonce_incremented]
#!
#! Where:
#! - was_nonce_incremented is the boolean flag indicating whether the account nonce was incremented.
pub proc was_nonce_incremented() -> Bool
    exec.memory::get_init_nonce
    # => [init_nonce]

    exec.memory::get_native_account_nonce
    # => [current_nonce, init_nonce]

    neq
    # => [was_nonce_incremented]
end

#! Adds the given asset update to the patch.
#!
#! Assumes the assets are valid, so it should be called after asset_vault::add_asset.
#!
#! Inputs:  [ASSET_ID, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE]
#! Outputs: []
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset that is added.
#! - INITIAL_ASSET_VALUE is the value of the asset before the update.
#! - FINAL_ASSET_VALUE is the value of the asset after the update.
pub proc update_asset(
    asset_id: AssetId,
    initial_asset_value: AssetValue,
    final_asset_value: AssetValue
)
    swapw dupw.1 push.ACCOUNT_UPDATE_ASSET_PTR
    # => [asset_delta_map_ptr, ASSET_ID, INITIAL_ASSET_VALUE, ASSET_ID, FINAL_ASSET_VALUE]

    # retrieve the current patch entry
    exec.link_map::get
    # => [contains_key, STORED_INITIAL_VALUE, STORED_FINAL_VALUE, INITIAL_ASSET_VALUE, ASSET_ID, FINAL_ASSET_VALUE]

    movdn.12
    # => [STORED_INITIAL_VALUE, STORED_FINAL_VALUE, INITIAL_ASSET_VALUE, contains_key, ASSET_ID, FINAL_ASSET_VALUE]

    swapw dropw
    # => [STORED_INITIAL_VALUE, INITIAL_ASSET_VALUE, contains_key, ASSET_ID, FINAL_ASSET_VALUE]

    movup.8
    # => [contains_key, STORED_INITIAL_VALUE, INITIAL_ASSET_VALUE, ASSET_ID, FINAL_ASSET_VALUE]

    # If contains_key STORED_INITIAL_VALUE remains.
    # If !contains_key INITIAL_ASSET_VALUE remains.
    cdropw
    # => [NEW_INITIAL_VALUE, ASSET_ID, FINAL_ASSET_VALUE]

    swapw push.ACCOUNT_UPDATE_ASSET_PTR
    # => [asset_delta_map_ptr, ASSET_ID, NEW_INITIAL_VALUE, FINAL_ASSET_VALUE]

    exec.link_map::set drop
    # => []
end

#! Computes the delta between two asset values and returns the resulting delta op and delta value.
#!
#! This procedure assumes the provided INITIAL_ASSET_VALUE and FINAL_ASSET_VALUE are NOT equal.
#!
#! This procedure computes the delta as follows:
#! - If the composition of the asset is none:
#!   - If the initial value is the empty word, the final value must be non-empty, so the asset was
#!     added.
#!   - Conversely, if the initial value is not the empty word, the final value must be empty
#!     according to the asset vault guarantees, so the asset was removed.
#! - If the composition is not none:
#!   - Compute the delta as `GREATER_ASSET_VALUE - LESSER_ASSET_VALUE` using `asset::lt` to find
#!     the larger value and `asset::split` for the computation itself.
#!   - Since the procedure assumes the values are not equal, the final value must be less than or
#!     greater than the initial value. If the final value is larger than the initial one, value
#!     was added; if it is smaller, value was removed.
#!
#! Inputs:  [INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID]
#! Outputs: [delta_op, ASSET_ID, DELTA_ASSET_VALUE]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset whose delta is computed.
#! - INITIAL_ASSET_VALUE is the value of the asset in the account vault at the beginning of the
#!   transaction.
#! - FINAL_ASSET_VALUE is the value of the asset in the account vault at the time the procedure is
#!   called.
#! - delta_op is the delta operation (addition or removal) for the asset.
#! - DELTA_ASSET_VALUE is the resulting delta between the initial and final asset value.
#!
#! Panics if:
#! - the asset's composition is Custom (not yet supported).
proc compute_asset_delta(
    initial_asset_value: AssetValue,
    final_asset_value: AssetValue,
    asset_id: AssetId
) -> (u8, Asset)
    dupw.2
    # => [ASSET_ID, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID]

    exec.asset::id_to_composition
    # => [asset_composition, ASSET_ID, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID]

    eq.COMPOSITION_NONE
    # => [is_composition_none, ASSET_ID, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID]

    if.true
        dropw
        # => [INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID]

        # the asset was removed if the initial value is not the empty word (in which case the final
        # word must be empty)
        exec.word::testz not
        # => [was_removed, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID]

        # compute delta_op as was_removed + 1
        dup add.1
        # => [delta_op, was_removed, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID]

        movdn.13
        # => [was_removed, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID, delta_op]

        # if was_removed INITIAL_ASSET_VALUE is selected
        # if !was_removed FINAL_ASSET_VALUE is selected
        cdropw
        # => [DELTA_ASSET_VALUE, ASSET_ID, delta_op]

        swapw movup.8
        # => [delta_op, ASSET_ID, DELTA_ASSET_VALUE]
    else
        dupw.2 dupw.2 movupw.2
        # => [ASSET_ID, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID]

        exec.asset::lt
        # => [is_final_lt_initial, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID]

        # compute delta_op as is_final_lt_initial + 1
        dup add.1
        # => [delta_op, is_final_lt_initial, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID]

        movdn.13
        # => [is_final_lt_initial, INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE, ASSET_ID, delta_op]

        # place the greater asset at the deeper position in the stack
        # if is_final_lt_initial the stack becomes [FINAL_ASSET_VALUE, INITIAL_ASSET_VALUE]
        # if !is_final_lt_initial the stack remains [INITIAL_ASSET_VALUE, FINAL_ASSET_VALUE]
        cswapw
        # => [LESSER_ASSET_VALUE, GREATER_ASSET_VALUE, ASSET_ID, delta_op]

        dupw.2 exec.asset::id_into_composition
        # => [asset_composition, LESSER_ASSET_VALUE, GREATER_ASSET_VALUE, ASSET_ID, delta_op]

        # compute the delta as greater - lesser
        exec.asset::split
        # => [DELTA_ASSET_VALUE, ASSET_ID, delta_op]

        swapw movup.8
        # => [delta_op, ASSET_ID, DELTA_ASSET_VALUE]
    end
end

#! Updates the storage map patch of the given slot index with the given key-value pair and its
#! previous value.
#!
#! The layout of a link map entry for a given KEY is: [KEY, INIT_VALUE, NEW_VALUE] where INIT_VALUE
#! represents the initial value for the given KEY at the beginning of transaction execution and
#! NEW_VALUE is the new value. The delta entry is a NOOP if INIT_VALUE and NEW_VALUE are equal.
#!
#! Inputs:  [slot_index, KEY, PREV_VALUE, NEW_VALUE]
#! Outputs: []
#!
#! Where:
#! - slot_index is the slot index of the storage map slot.
#! - KEY is the key in the storage map that is being updated.
#! - PREV_VALUE is the previous value of the key in the storage map that is being updated.
#! - NEW_VALUE is the new value of the key in the storage map that is being updated.
@locals(8)
pub proc set_map_item(slot_index: u8, key: StorageMapKey, prev_value: word, new_value: word)
    # retrieve the link map ptr to the storage map patch for the provided index
    exec.memory::get_account_patch_storage_map_ptr
    # => [account_patch_storage_map_ptr, KEY, PREV_VALUE, NEW_VALUE]

    # store map ptr in local
    loc_store.0
    # => [KEY, PREV_VALUE, NEW_VALUE]

    # store KEY in local
    loc_storew_le.4
    # => [KEY, PREV_VALUE, NEW_VALUE]

    loc_load.0
    # => [account_patch_storage_map_ptr, KEY, PREV_VALUE, NEW_VALUE]

    # retrieve the current patch
    exec.link_map::get
    # => [contains_key, VALUE0, VALUE1, PREV_VALUE, NEW_VALUE]

    movdn.12
    # => [VALUE0, VALUE1, PREV_VALUE, contains_key, NEW_VALUE]

    # VALUE1 was the previous "new value" if this key was already updated, so in any case,
    # we can drop it since this update overwrites the previous one
    swapw dropw
    # => [VALUE0, PREV_VALUE, contains_key, NEW_VALUE]

    movup.8
    # => [contains_key, VALUE0, PREV_VALUE, NEW_VALUE]

    # contains_key determines whether this is the first update to this KEY
    # if this is the first update, PREV_VALUE is the *initial* value of the key-value pair
    # if this is not the first update, VALUE0 is the initial value, so we want to store it back
    # use cdropw to selectively keep the word that represents the initial value
    # If contains_key VALUE0 remains.
    # If !contains_key PREV_VALUE remains.
    cdropw
    # => [INITIAL_VALUE, NEW_VALUE]

    # load key and index from locals
    padw loc_loadw_le.4 loc_load.0
    # => [account_patch_storage_map_ptr, KEY, INITIAL_VALUE, NEW_VALUE]

    exec.link_map::set drop
    # => []
end
