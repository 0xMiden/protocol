# xreserve::burn_policy
#
# Checks the required note attachments, the withdrawal destination and the minimum burn amount.

use miden::protocol::active_account
use miden::protocol::active_note
use miden::standards::assets::fungible_asset
use miden::standards::attachments::network_account_target
use {MIN_BURN_AMOUNT_SLOT} from miden::standards::faucets::policies::burn::min_burn_amount
use xreserve::domain_config

# CONSTANTS
# =================================================================================================

const XUSDC_BURN_WITHDRAWAL_ATTACHMENT_SCHEME = 5
const XUSDC_BURN_WITHDRAWAL_ATTACHMENT_NUM_WORDS = 3
const BURN_NOTE_NUM_ATTACHMENTS = 2

# check_burn_policy locals, sized to the expected content. A larger attachment overflows its
# region, but the word count assert that follows the write aborts before anything reads it.
const CHECK_BURN_POLICY_COMMITMENTS_LOC = 0
# the withdrawal attachment: [dest_domain, 0, 0, 0], then the recipient as a double word
const CHECK_BURN_POLICY_WITHDRAWAL_LOC = 8
const CHECK_BURN_POLICY_RECIPIENT_LOW_LOC = 12
const CHECK_BURN_POLICY_RECIPIENT_HIGH_LOC = 16

# ERRORS
# =================================================================================================

const ERR_XRESERVE_BURN_NOTE_WITHDRAWAL_MISSING = "burn note withdrawal attachment is missing"
const ERR_XRESERVE_BURN_NOTE_TARGET_NOT_THIS_FAUCET = "burn note routing target is not this faucet"
const ERR_XRESERVE_BURN_NOTE_ATTACHMENT_COUNT = "burn note must carry exactly two attachments"
const ERR_XRESERVE_BURN_NOTE_WITHDRAWAL_WORDS = "burn note withdrawal attachment must contain exactly three words"
const ERR_XRESERVE_BURN_NOTE_DOMAIN_NOT_U32 = "burn note destination domain is not a valid u32"
const ERR_XRESERVE_BURN_NOTE_DOMAIN_IS_FAUCET_DOMAIN = "burn note destination domain must not be the faucet's own domain"
const ERR_XRESERVE_BURN_NOTE_RECIPIENT_NOT_U32 = "burn note destination recipient limb is not a valid u32"
const ERR_XRESERVE_BURN_NOTE_DOMAIN_PADDING_NOT_ZERO = "burn note destination domain word padding must be zero"
const ERR_XRESERVE_BURN_AMOUNT_BELOW_MIN = "amount to be burned must meet or exceed specified minimum burn amount"

# POLICY PROCEDURE
# =================================================================================================

#! Checks the required note attachments, the withdrawal destination and the minimum burn amount.
#!
#! A burn is accepted only if the withdrawal attester can pay it out, because the burned xUSDC
#! cannot be recovered afterwards.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, pad(8)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ASSET_ID is the burned asset's identifier.
#! - ASSET_VALUE is the fungible asset value word `[amount, 0, 0, 0]`.
#!
#! Panics if:
#! - no note is active, or either the routing or withdrawal attachment is missing.
#! - the note does not have exactly two attachments.
#! - the routing attachment does not target this faucet.
#! - the withdrawal attachment does not contain exactly three words.
#! - the destination domain is not a u32 or is the faucet's configured domain.
#! - the destination domain word padding is not zero.
#! - a destination recipient limb is not a u32.
#! - the attachment content does not match the commitment in the note.
#! - the burn amount is below the configured minimum.
#!
#! Invocation: call
@locals(20)
@account_procedure
pub proc check_burn_policy
    dropw
    exec.fungible_asset::value_into_amount
    push.MIN_BURN_AMOUNT_SLOT[0..2] exec.active_account::get_item
    # => [min_burn_amount, 0, 0, 0, amount, pad(15)]

    movdn.4 drop drop drop
    lte assert.err=ERR_XRESERVE_BURN_AMOUNT_BELOW_MIN
    # => [pad(16)]

    push.XUSDC_BURN_WITHDRAWAL_ATTACHMENT_SCHEME exec.active_note::find_attachment
    assert.err=ERR_XRESERVE_BURN_NOTE_WITHDRAWAL_MISSING
    # => [withdrawal_idx, pad(16)]

    # check the number of attachments on the note
    locaddr.CHECK_BURN_POLICY_COMMITMENTS_LOC exec.active_note::write_attachment_commitments_to_memory
    eq.BURN_NOTE_NUM_ATTACHMENTS assert.err=ERR_XRESERVE_BURN_NOTE_ATTACHMENT_COUNT
    # => [withdrawal_idx, pad(16)]

    # the one remaining attachment must route the note to this faucet
    exec.network_account_target::active_account_matches_target_account
    assert.err=ERR_XRESERVE_BURN_NOTE_TARGET_NOT_THIS_FAUCET
    # => [withdrawal_idx, pad(16)]

    # check the number of words inside the withdrawal attachment
    locaddr.CHECK_BURN_POLICY_WITHDRAWAL_LOC exec.active_note::write_attachment_to_memory
    eq.XUSDC_BURN_WITHDRAWAL_ATTACHMENT_NUM_WORDS assert.err=ERR_XRESERVE_BURN_NOTE_WITHDRAWAL_WORDS
    # => [pad(16)]

    # the destination domain must be a u32 other than this faucet's own domain
    padw loc_loadw_le.CHECK_BURN_POLICY_WITHDRAWAL_LOC
    # => [dest_domain, padding_0, padding_1, padding_2, pad(16)]

    u32assert.err=ERR_XRESERVE_BURN_NOTE_DOMAIN_NOT_U32
    exec.domain_config::get_configured_domain
    # => [faucet_domain, dest_domain, padding_0, padding_1, padding_2, pad(16)]

    neq assert.err=ERR_XRESERVE_BURN_NOTE_DOMAIN_IS_FAUCET_DOMAIN
    # => [padding_0, padding_1, padding_2, pad(16)]

    assertz.err=ERR_XRESERVE_BURN_NOTE_DOMAIN_PADDING_NOT_ZERO
    assertz.err=ERR_XRESERVE_BURN_NOTE_DOMAIN_PADDING_NOT_ZERO
    assertz.err=ERR_XRESERVE_BURN_NOTE_DOMAIN_PADDING_NOT_ZERO
    # => [pad(16)]

    # every recipient limb must be a u32
    padw loc_loadw_le.CHECK_BURN_POLICY_RECIPIENT_LOW_LOC
    u32assertw.err=ERR_XRESERVE_BURN_NOTE_RECIPIENT_NOT_U32 dropw
    # => [pad(16)]

    padw loc_loadw_le.CHECK_BURN_POLICY_RECIPIENT_HIGH_LOC
    u32assertw.err=ERR_XRESERVE_BURN_NOTE_RECIPIENT_NOT_U32 dropw
    # => [pad(16)]
end
