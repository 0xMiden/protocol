# Role-gated pause admin component.
#
# Wraps `pausable::pause` / `pausable::unpause` with role checks against separate
# `PAUSER` and `UNPAUSER` roles in RoleBasedAccessControl, and forwards `is_paused`
# as a read-only view.
#
# Role symbols are stored in this component's own storage slot (encoded by the Rust
# component at install time) and read by MASM at call time, so role-identifier
# encoding stays consistent with the Rust encoder.
#
# Companion components required:
# - `RoleBasedAccessControl` : provides role membership storage and the
#   `assert_sender_has_role` procedure used to validate the sender.
# - `Pausable`               : provides the `is_paused` storage slot that
#   pause/unpause write to.

pub use ::miden::standards::utils::pausable_rbac::pause
pub use ::miden::standards::utils::pausable_rbac::unpause
pub use ::miden::standards::utils::pausable_rbac::is_paused
