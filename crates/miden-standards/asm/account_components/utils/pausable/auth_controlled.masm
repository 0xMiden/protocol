# Auth-controlled pause admin component.
#
# Wraps `pausable::pause` / `pausable::unpause` / `pausable::is_paused` as `Invocation: call`
# procedures with no explicit auth check; authorization is delegated to the account's own
# auth component.
#
# Companion components required:
# - `BasicPausable` : provides the `is_paused` storage slot that pause/unpause write to.

pub use ::miden::standards::utils::pausable::auth_controlled::pause
pub use ::miden::standards::utils::pausable::auth_controlled::unpause
pub use ::miden::standards::utils::pausable::auth_controlled::is_paused
