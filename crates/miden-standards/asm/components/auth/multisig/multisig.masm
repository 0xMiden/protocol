# The MASM code of the Multi-Signature Authentication Component.
#
# See the `AuthMultisig` Rust type's documentation for more details.

use miden::protocol::active_account
use miden::protocol::tx
use miden::standards::auth::multisig

pub use {update_signers_and_threshold} from miden::standards::auth::multisig
pub use {get_threshold_and_num_approvers} from miden::standards::auth::multisig
pub use {set_procedure_threshold} from miden::standards::auth::multisig
pub use {get_signer_at} from miden::standards::auth::multisig
pub use {is_signer} from miden::standards::auth::multisig

#! Authenticate a transaction with multi-signature support, paying the transaction fee in the
#! process.
#!
#! It resolves the AUTH_ARGS into the block the summary binds, the summary salt, the max fee and
#! the fee conversion info, verifies the approver signatures against the transaction summary and
#! only then pays the transaction fee by creating a public TX_FEE note (on chains with a zero
#! verification base fee no note is created). The approvers thus sign the max fee the summary
#! binds rather than the exact fee, so their signatures stay valid when the fee changes while
#! they are being collected, and the transaction fails if the fee and the sponsorships of its
#! network output notes together exceed the max fee.
#! The fee note's serial number uses the block bound by the summary and the initial nonce, so it
#! stays unchanged at a newer execution reference block when the account nonce is unchanged.
#!
#! Inputs:
#!   Operand stack: [AUTH_ARGS]
#!   Advice map: { AUTH_ARGS: [PARAMS_WORD, SALT, CONVERSION_INFO] }
#! Outputs:
#!   Operand stack: []
#!
#! Where:
#! - AUTH_ARGS and its preimage are as described in `multisig::resolve_auth_args`.
#!
#! Panics if:
#! - insufficient number of valid signatures (below threshold).
#! - the approval expired at or before the transaction reference block, see
#!   `multisig::assert_approval_not_expired`.
#! - the transaction fee and the sponsored fees exceed the max fee, see
#!   `multisig::pay_fee_within_max_fee`.
#!
#! Invocation: call
@auth_script
pub proc auth_tx_multisig(auth_args: word)
    exec.multisig::resolve_auth_args
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT]

    # reject an expired approval before any signature is verified.
    # ---------------------------------------------------------------------------------------------

    dup.5 exec.tx::get_reference_block_number
    # => [reference_block_num, approval_expiration_block_num, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT]

    exec.multisig::assert_approval_not_expired movdn.11
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]

    # Keep the fee payment inputs below the summary inputs: the fee is paid after the signatures
    # are verified, and the fee note's serial number uses the signed block and the initial nonce,
    # which must be read before auth_tx increments it.
    # ---------------------------------------------------------------------------------------------

    dup.6 movdn.11
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, max_fee, approval_expiration_delta]

    exec.active_account::get_nonce movdn.11
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, initial_nonce, max_fee, approval_expiration_delta]

    dup.4 movdn.11
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    movdn.10 movdn.10 movdn.10 movdn.10
    # => [bound_block_num, approval_expiration_block_num, max_fee, SALT, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    # Authenticate the transaction.
    # ---------------------------------------------------------------------------------------------

    exec.multisig::auth_tx
    # => [TX_SUMMARY_COMMITMENT, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    # Pay the transaction fee now that the transaction is authorized, and assert it stays within
    # the max fee the approvers signed.
    # ---------------------------------------------------------------------------------------------

    movdnw.2
    # => [CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta, TX_SUMMARY_COMMITMENT]

    exec.multisig::pay_fee_within_max_fee
    # => [approval_expiration_delta, TX_SUMMARY_COMMITMENT]

    # Record the transaction for replay protection.
    # ---------------------------------------------------------------------------------------------

    movdn.4
    # => [TX_SUMMARY_COMMITMENT, approval_expiration_delta]

    exec.multisig::record_and_assert_new_tx
    # => [approval_expiration_delta]

    # apply the approval expiration after tx summary extractions since the host cross-checks
    # the kernel expiration delta against the transaction summary delta
    # ---------------------------------------------------------------------------------------------

    exec.multisig::apply_approval_expiration
    # => []
end
