use {AuthArgs} from miden::standards::types
use miden::protocol::active_account
use miden::protocol::asset
use miden::protocol::native_account
use miden::protocol::note
use miden::protocol::output_note
use miden::protocol::tx
use miden::standards::assets::fungible_asset
use miden::standards::fee
use miden::standards::note as std_note
use miden::standards::notes::tx_fee
use {NOTE_TYPE_PUBLIC} from miden::protocol::note

# Same empty vault root as the transaction kernel's EMPTY_SMT_ROOT.
const EMPTY_VAULT_ROOT = [3975378004049472045, 2532873049833957132, 2640800763532531478, 11158234471980764993]
const TX_FEE_TAG = 0xFEE
const POST_FEE_CYCLES = 4096
const FEE_NOTE_IDX = 0
const FEE_ASSET = 4
const REQUIRED_FEE = 12

const ERR_PASSTHROUGH_STATE_CHANGED = "passthrough account state must remain unchanged"
const ERR_PASSTHROUGH_VAULT_NOT_EMPTY = "passthrough account vault must be empty"
const ERR_PASSTHROUGH_AUTH_ARGS = "passthrough auth expects a fee note index and zero reserved arguments"
const ERR_PASSTHROUGH_FEE_NOTE = "passthrough requires a public sealed native TX_FEE note"
const ERR_PASSTHROUGH_INSUFFICIENT_FEE = "passthrough fee note does not cover the transaction"

#! Authorizes a permissionless transaction only when the account remains unchanged and empty.
#! On deployment only, increments the nonce after checking the same state invariants.
#! The transaction creates its own fee note, for example by consuming CREATE_NOTE. No second fee
#! note is generated by this auth component. AUTH_ARGS[0] identifies the fee output; the remaining
#! arguments must be zero. The fee index is ignored on a chain with zero fees.
#! Inputs: [AUTH_ARGS, pad(12)]
#! Outputs: [pad(16)]
@auth_script
@locals(13)
pub proc auth_passthrough(auth_args: AuthArgs)
    loc_store.FEE_NOTE_IDX
    assertz.err=ERR_PASSTHROUGH_AUTH_ARGS
    assertz.err=ERR_PASSTHROUGH_AUTH_ARGS
    assertz.err=ERR_PASSTHROUGH_AUTH_ARGS

    # Read the final state before changing the deployment nonce. This also rejects pending code
    # upgrades and nonce changes made by the transaction itself.
    exec.native_account::has_state_changed assertz.err=ERR_PASSTHROUGH_STATE_CHANGED
    exec.active_account::get_vault_root push.EMPTY_VAULT_ROOT
    assert_eqw.err=ERR_PASSTHROUGH_VAULT_NOT_EMPTY

    exec.active_account::get_nonce eq.0
    if.true
        exec.native_account::incr_nonce drop
    end

    push.POST_FEE_CYCLES exec.fee::apply_cycle_margins
    padw movup.4 exec.tx::compute_fee
    dup loc_store.REQUIRED_FEE neq.0
    if.true
        loc_load.FEE_NOTE_IDX exec.output_note::is_sealed
        assert.err=ERR_PASSTHROUGH_FEE_NOTE
        loc_load.FEE_NOTE_IDX exec.output_note::get_metadata
        dupw exec.note::metadata_into_note_type eq.NOTE_TYPE_PUBLIC
        assert.err=ERR_PASSTHROUGH_FEE_NOTE
        exec.note::metadata_into_tag eq.TX_FEE_TAG assert.err=ERR_PASSTHROUGH_FEE_NOTE

        loc_load.FEE_NOTE_IDX exec.std_note::output_note_get_recipient_preimage
        procref.tx_fee::main assert_eqw.err=ERR_PASSTHROUGH_FEE_NOTE
        padw assert_eqw.err=ERR_PASSTHROUGH_FEE_NOTE

        loc_load.FEE_NOTE_IDX exec.output_note::get_attachments_commitment
        padw assert_eqw.err=ERR_PASSTHROUGH_FEE_NOTE

        loc_load.FEE_NOTE_IDX exec.output_note::get_assets_info
        dropw eq.1 assert.err=ERR_PASSTHROUGH_FEE_NOTE
        loc_load.FEE_NOTE_IDX locaddr.FEE_ASSET exec.output_note::get_assets drop
        locaddr.FEE_ASSET exec.asset::load
        exec.tx::get_fee_asset_id assert_eqw.err=ERR_PASSTHROUGH_FEE_NOTE
        exec.fungible_asset::value_into_amount_unchecked
        loc_load.REQUIRED_FEE swap lte assert.err=ERR_PASSTHROUGH_INSUFFICIENT_FEE
    end
end
