# The MASM code of the AuthNetworkAccountWithFees authentication component.
#
# See the `AuthNetworkAccountWithFees` Rust type's documentation for more details.

use miden::core::word
use miden::protocol::active_account
use miden::protocol::native_account
use miden::standards::auth::note_script_allowlist
use miden::standards::auth::tx_script_allowlist
use miden::standards::fees::fee_manager

# CONSTANTS
# =================================================================================================

# The slots reuse AuthNetworkAccount's standardized names, so off-chain services identify a
# fee-managed network account exactly like a plain one.
const ALLOWED_NOTE_SCRIPTS_SLOT = word("miden::standards::auth::network_account::allowed_note_scripts")

const ALLOWED_TX_SCRIPTS_SLOT = word("miden::standards::auth::network_account::allowed_tx_scripts")

# AUTH PROCEDURE
# =================================================================================================

#! Authenticates a transaction against a fee-managed network account.
#!
#! Runs the AuthNetworkAccount checks first -- the tx script and every input note must be
#! allowlisted -- then settles the transaction's fees, then increments the nonce when the account
#! state changed or the account is new. The two gates are independent: the allowlists decide what
#! may run, fee settlement what it costs.
#!
#! Settlement lives here, in the auth procedure, because the kernel invokes it unconditionally: a
#! note script could not be trusted to call it, since a feature note that skipped the call would
#! be exactly the note that never paid.
#!
#! Inputs:  [AUTH_ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the transaction script root, if any, is not allowlisted.
#! - an input note's script root is not allowlisted.
#! - fee settlement fails (see `fee_manager::settle_fees`).
#!
#! Invocation: call
@auth_script
pub proc auth_network_transaction_with_fees(auth_args: word)
    dropw
    # => [pad(16)]

    push.ALLOWED_TX_SCRIPTS_SLOT[0..2]
    exec.tx_script_allowlist::assert_tx_script_allowed
    # => [pad(16)]

    push.ALLOWED_NOTE_SCRIPTS_SLOT[0..2]
    exec.note_script_allowlist::assert_all_input_notes_allowed
    # => [pad(16)]

    exec.fee_manager::settle_fees
    # => [pad(16)]

    # increment the nonce iff the account state changed or the account is new
    exec.native_account::get_initial_commitment
    exec.active_account::compute_commitment
    exec.word::eq not
    # => [has_account_state_changed, pad(16)]

    exec.active_account::get_nonce eq.0 or
    # => [should_increment_nonce, pad(16)]

    if.true
        exec.native_account::incr_nonce drop
    end
    # => [pad(16)]
end
