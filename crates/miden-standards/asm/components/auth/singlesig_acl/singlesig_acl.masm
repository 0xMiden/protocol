# The MASM code of the signature-based authentication Account Component with an exempt-list ACL.
#
# See the `AuthSingleSigAcl` Rust type's documentation for more details.

use miden::protocol::active_account
use miden::protocol::native_account
use miden::standards::auth::signature
use miden::standards::fee
use miden::core::word

# CONSTANTS
# ================================================================================================

# The slot in this component's storage layout where the public key commitment is stored.
const PUBLIC_KEY_COMMITMENT_SLOT = word("miden::standards::auth::singlesig_acl::pub_key")

# The slot in this component's storage layout where the corresponding signature scheme id is stored.
const SCHEME_ID_SLOT = word("miden::standards::auth::singlesig_acl::scheme")

# The slot where the map of procedure roots exempt from requiring a signature is stored.
# Map entries: `PROC_ROOT => [1, 0, 0, 0]`
const EXEMPT_PROCEDURE_ROOTS_SLOT = word("miden::standards::auth::singlesig_acl::exempt_procedure_roots")

# Local memory address (word) where the auth args are stashed while the ACL loop runs, so the
# signature branch can decode the fee conversion info they commit to.
const AUTH_ARGS_LOC = 0

# Estimated upper bound on the number of cycles the exempt (no-signature) branch spends after
# pay_fee returns: the account commitment comparison and the nonce increment.
const ACL_EXEMPT_POST_FEE_CYCLES = 1024

#! Authenticate a transaction using the signature scheme specified by scheme_id, paying the
#! transaction fee when a signature is required.
#!
#! Supported schemes:
#! - 1 => ecdsa_k256_keccak
#! - 2 => falcon512_poseidon2
#!
#! Authentication is required if a non-auth kernel-detected procedure not on the exempt list
#! was called.
#!
#! Notice that asset removal from the account vault uses a kernel-tracked procedure, so any
#! transaction which moves assets out of the account will be authenticated unless all the
#! procedures required for that are explicitly added to the exempt list.
#!
#! If authentication is required, the configured signature is verified. Otherwise, the nonce
#! is conditionally incremented when the account state changed or the account is new.
#!
#! Both branches pay the transaction fee by creating and funding a public TX_FEE note (see
#! miden::standards::fee::pay_fee); on chains with a zero verification base fee no note is
#! created.
#!
#! On the authenticated (signature) branch, the payment asset and conversion rate are committed
#! to by the AUTH_ARGS (see miden::standards::fee::load_conversion_info; native fee asset at rate
#! 1/1 for plain native payment), and the fee is paid before the transaction summary is created,
#! so the fee note and the vault withdrawal funding it are covered by the signature.
#!
#! The exempt (no-signature) branch always pays in the native fee asset at rate 1/1 (see
#! miden::standards::fee::native_conversion_info), mirroring the network account component: with
#! no signer to authorize a conversion rate, the caller-supplied AUTH_ARGS cannot be trusted to
#! select the payment asset, so the branch ignores any committed conversion info and pays plainly
#! in the kernel-attested native asset. Paying on the exempt branch also means exempt
#! transactions cannot evade fees on fee-charging chains. Note that the fee payment withdraws
#! from the vault, so on fee-charging chains the account state always changes and the nonce
#! always increments.
#!
#! Inputs:  [AUTH_ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Invocation: call
@locals(4)
@auth_script
pub proc auth_tx_acl(auth_args: word)
    # Stash the auth args in local memory so the signature branch can later decode the fee
    # conversion info they commit to; the ACL loop below does not need them on the stack.
    # ---------------------------------------------------------------------------------------------

    loc_storew_le.AUTH_ARGS_LOC dropw
    # => [pad(16)]

    # ------ Iterate procedures to determine whether any non-exempt proc was called ------

    # By default we assume no authentication required, look for conditions to change that
    push.0
    # => [auth_required, pad(16)]

    exec.active_account::get_num_procedures
    # => [num_procedures, auth_required, pad(16)]

    # Iterate indices from `num_procedures-1` down to `1`. That way we can skip the
    # authentication procedure itself located at index `0`.
    dup neq.1
    # => [should_continue, num_procedures, auth_required, pad(16)]
    while.true
        sub.1
        # => [i, auth_required, pad(16)]

        # Get the procedure root at index i.
        dup exec.active_account::get_procedure_root dupw
        # => [PROC_ROOT, PROC_ROOT, i, auth_required, pad(16)]

        exec.native_account::was_procedure_called
        # => [was_called, PROC_ROOT, i, auth_required, pad(16)]

        if.true
            # Look up the proc root in the exempt map. Exempt procedure entries have
            # `[1, 0, 0, 0]` as their values.
            push.EXEMPT_PROCEDURE_ROOTS_SLOT[0..2]
            # => [slot_suffix, slot_prefix, PROC_ROOT, i, auth_required, pad(16)]

            exec.native_account::get_initial_map_item
            # => [[is_exempt, 0, 0, 0], i, auth_required, pad(16)]

            movdn.3 drop drop drop
            # => [is_exempt, i, auth_required, pad(16)]

            # If the called procedure is not exempt, auth is required.
            neq.1
            # => [is_not_exempt, i, auth_required, pad(16)]

            movup.2 or
            # => [auth_required', i, pad(16)]

            swap
            # => [i, auth_required', pad(16)]
        else
            # Procedure was not called; discard the duplicated root.
            dropw
            # => [i, auth_required, pad(16)]
        end

        dup neq.1
        # => [should_continue, i, auth_required, pad(16)]
    end
    # => [i = 1, auth_required, pad(16)]

    drop
    # => [auth_required, pad(16)]

    # If authentication is required, pay the fee and perform signature verification
    if.true
        # Decode the fee conversion info committed to by the stashed auth args.
        # -----------------------------------------------------------------------------------------

        padw loc_loadw_le.AUTH_ARGS_LOC
        # => [AUTH_ARGS, pad(16)]

        exec.fee::load_conversion_info
        # => [CONVERSION_INFO, pad(16)]

        # Fetch the signature scheme id from storage.
        # -----------------------------------------------------------------------------------------

        push.SCHEME_ID_SLOT[0..2] exec.native_account::get_initial_item
        # => [scheme_id, 0, 0, 0, CONVERSION_INFO, pad(16)]

        movdn.3 drop drop drop
        # => [scheme_id, CONVERSION_INFO, pad(16)]

        # Pay the transaction fee before the summary is created so that the TX_FEE note and
        # the vault withdrawal funding it are covered by the signed transaction summary.
        # -----------------------------------------------------------------------------------------

        dup exec.signature::estimate_authentication_cycles
        # => [num_extra_cycles, scheme_id, CONVERSION_INFO, pad(16)]

        swap movdn.5
        # => [num_extra_cycles, CONVERSION_INFO, scheme_id, pad(16)]

        exec.fee::pay_fee
        # => [scheme_id, pad(16)]

        # Fetch public key commitment from storage.
        # -----------------------------------------------------------------------------------------

        push.PUBLIC_KEY_COMMITMENT_SLOT[0..2] exec.native_account::get_initial_item
        # => [PK_COMM, scheme_id, pad(16)]

        exec.signature::authenticate_transaction
    else
        # ------ Pay the transaction fee in the native fee asset ------

        # with no signer to authorize a committed conversion rate, the exempt branch ignores the
        # auth args and pays plainly in the kernel-attested native fee asset (mirroring the
        # network account component), so exempt transactions cannot evade fees
        exec.fee::native_conversion_info
        # => [CONVERSION_INFO, pad(16)]

        push.ACL_EXEMPT_POST_FEE_CYCLES
        # => [num_extra_cycles, CONVERSION_INFO, pad(16)]

        exec.fee::pay_fee
        # => [pad(16)]

        # ------ Check if initial account commitment differs from current commitment ------

        exec.native_account::get_initial_commitment
        # => [INITIAL_COMMITMENT, pad(16)]

        exec.active_account::compute_commitment
        # => [CURRENT_COMMITMENT, INITIAL_COMMITMENT, pad(16)]

        exec.word::eq not
        # => [has_account_state_changed, pad(16)]

        # check if this is a new account (i.e., nonce == 0); this check is needed because new
        # accounts are initialized with a non-empty state, and thus, unless the account was
        # modified during the transaction, the initial and current state commitments will be
        # the same

        exec.active_account::get_nonce eq.0
        # => [is_new_account, has_account_state_changed, pad(16)]

        or
        # => [should_increment_nonce, pad(16)]

        if.true
            exec.native_account::incr_nonce drop
        end
    end
    # => [pad(16)]
end
