# The MASM code of the Hot/Cold/Guardian Authentication Component.
#
# See the `AuthHotColdGuardian` Rust type's documentation for more details.

use miden::protocol::active_account
use miden::protocol::tx
use miden::standards::auth::hot_cold_guardian
use miden::standards::auth::multisig
use {MULTISIG_POST_FEE_CYCLES} from miden::standards::auth::multisig
use miden::standards::fee

pub use {update_hot_keys} from miden::standards::auth::hot_cold_guardian
pub use {rotate_cold_key} from miden::standards::auth::hot_cold_guardian
pub use {update_guardian_public_key} from miden::standards::auth::hot_cold_guardian
pub use {set_procedure_policy} from miden::standards::auth::hot_cold_guardian
pub use {update_delay_config} from miden::standards::auth::hot_cold_guardian
pub use {get_num_hot_keys} from miden::standards::auth::hot_cold_guardian
pub use {get_hot_key_at} from miden::standards::auth::hot_cold_guardian
pub use {get_cold_key} from miden::standards::auth::hot_cold_guardian
pub use {get_procedure_policy} from miden::standards::auth::hot_cold_guardian
pub use {get_delay_config} from miden::standards::auth::hot_cold_guardian

#! Authenticate a transaction with the hot, cold and guardian key categories, paying the
#! transaction fee in the process.
#!
#! The fee is paid as in the multisig component: after the signatures are verified and within the
#! max fee the summary binds, which is estimated on every execution and used unless the auth args
#! carry one (see `multisig::estimate_max_fee`). The estimate counts every hot key, the cold key
#! and the guardian as signers.
#!
#! Inputs:
#!   Operand stack: [AUTH_ARGS]
#!   Advice map: {
#!     AUTH_ARGS: [[bound_block_num, approval_expiration_block_num, max_fee, 0], SALT, CONVERSION_INFO]
#!   }
#! Outputs:
#!   Operand stack: []
#!
#! Where:
#! - AUTH_ARGS and its preimage are as described in `multisig::resolve_auth_args`.
#!
#! Panics if:
#! - the guardian signature is missing, or fewer key categories signed than the called procedures
#!   require.
#! - the approval expired at or before the transaction reference block, see
#!   `multisig::assert_approval_not_expired`.
#! - the transaction fee and the sponsored fees exceed the max fee, see `fee::pay_bounded_fee`.
#!
#! Invocation: call
@auth_script
pub proc auth_tx_hot_cold_guardian(auth_args: word)
    exec.multisig::resolve_auth_args
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT]

    # reject an expired approval before any signature is verified.
    # ---------------------------------------------------------------------------------------------

    dup.5 exec.tx::get_reference_block_number
    # => [reference_block_num, approval_expiration_block_num, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT]

    exec.multisig::assert_approval_not_expired movdn.11
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]

    # Estimate the max fee and use it unless the auth args carry one: an unsigned execution sets
    # the estimate as the summary's max fee, and the signed execution passes it back. The estimate
    # runs on every execution so that its foreign account reads affect the summary on both.
    # ---------------------------------------------------------------------------------------------

    exec.hot_cold_guardian::get_initial_num_hot_keys
    # => [num_hot_keys, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]

    # count the cold key and the guardian as signers
    add.2
    # => [num_of_signers, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]

    # this flow spends no cycles beyond the multisig flow the estimate covers
    push.0
    # => [num_extra_cycles, num_of_signers, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]

    exec.multisig::estimate_max_fee
    # => [estimated_max_fee, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]

    movup.7 dup eq.0
    # => [is_max_fee_unset, max_fee, estimated_max_fee, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, SALT, approval_expiration_delta]

    movup.2 swap cdrop
    # => [max_fee, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, SALT, approval_expiration_delta]

    movdn.6
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]

    dup.6 movdn.11
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, max_fee, approval_expiration_delta]

    # the fee note's serial number uses the initial nonce, read before auth_tx increments it
    exec.active_account::get_nonce movdn.11
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, initial_nonce, max_fee, approval_expiration_delta]

    dup.4 movdn.11
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    movdn.10 movdn.10 movdn.10 movdn.10
    # => [bound_block_num, approval_expiration_block_num, max_fee, SALT, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    # Authenticate the transaction with the key categories and the guardian.
    # ---------------------------------------------------------------------------------------------

    exec.hot_cold_guardian::auth_tx
    # => [TX_SUMMARY_COMMITMENT, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    # Pay the transaction fee now that the transaction is authorized, and assert it stays within
    # the max fee the signers signed.
    # ---------------------------------------------------------------------------------------------

    movdnw.2
    # => [CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta, TX_SUMMARY_COMMITMENT]

    push.MULTISIG_POST_FEE_CYCLES
    # => [num_extra_cycles, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta, TX_SUMMARY_COMMITMENT]

    exec.fee::pay_bounded_fee
    # => [approval_expiration_delta, TX_SUMMARY_COMMITMENT]

    # Record the transaction for replay protection.
    # ---------------------------------------------------------------------------------------------

    movdn.4
    # => [TX_SUMMARY_COMMITMENT, approval_expiration_delta]

    exec.multisig::record_and_assert_new_tx
    # => [approval_expiration_delta]

    # apply the approval expiration after tx summary extractions since the host cross-checks
    # the kernel expiration delta against the transaction summary delta
    # ---------------------------------------------------------------------------------------------

    exec.multisig::apply_approval_expiration
    # => []
end
