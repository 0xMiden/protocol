# The MASM code of the Hot/Cold/Guardian Authentication Component.
#
# See the `AuthHotColdGuardian` Rust type's documentation for more details.

use miden::protocol::tx
use miden::standards::auth::hot_cold_guardian
use miden::standards::auth::multisig
use miden::standards::auth::signature
use miden::standards::fee

pub use {update_hot_keys} from miden::standards::auth::hot_cold_guardian
pub use {rotate_cold_key} from miden::standards::auth::hot_cold_guardian
pub use {update_guardian_public_key} from miden::standards::auth::hot_cold_guardian
pub use {set_procedure_policy} from miden::standards::auth::hot_cold_guardian
pub use {update_delay_config} from miden::standards::auth::hot_cold_guardian
pub use {get_num_hot_keys} from miden::standards::auth::hot_cold_guardian
pub use {get_default_threshold} from miden::standards::auth::hot_cold_guardian
pub use {get_hot_key_at} from miden::standards::auth::hot_cold_guardian
pub use {get_cold_key} from miden::standards::auth::hot_cold_guardian
pub use {get_procedure_policy} from miden::standards::auth::hot_cold_guardian
pub use {get_delay_config} from miden::standards::auth::hot_cold_guardian

#! Authenticate a transaction with the hot, cold and guardian key categories, paying the
#! transaction fee in the process.
#!
#! The fee is paid before the transaction summary is created, so the fee note is covered by the
#! user and guardian signatures. The cycle estimate counts every hot key, the cold key and the
#! guardian as signers.
#!
#! Inputs:
#!   Operand stack: [AUTH_ARGS]
#!   Advice map: { AUTH_ARGS: [BLOCK_WORD, SALT, CONVERSION_INFO] }
#! Outputs:
#!   Operand stack: []
#!
#! Where:
#! - AUTH_ARGS and its preimage are as described in `multisig::resolve_auth_args`.
#!
#! Panics if:
#! - the guardian signature is missing, or fewer key categories signed than the called procedures
#!   require.
#! - the approval expired at or before the transaction reference block, see
#!   `multisig::assert_approval_not_expired`.
#!
#! Invocation: call
@auth_script
pub proc auth_tx_hot_cold_guardian(auth_args: word)
    exec.multisig::resolve_auth_args
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, SALT]

    # reject an expired approval before any signature is verified.
    # ---------------------------------------------------------------------------------------------

    dup.5 exec.tx::get_reference_block_number
    # => [reference_block_num, approval_expiration_block_num, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, SALT]

    exec.multisig::assert_approval_not_expired movdn.10
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, SALT, approval_expiration_delta]

    # Pay the transaction fee before the summary is created so that the TX_FEE note and the
    # vault withdrawal funding it are covered by the signatures.
    # ---------------------------------------------------------------------------------------------

    exec.hot_cold_guardian::get_initial_config drop
    # => [num_hot_keys, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, SALT, approval_expiration_delta]

    # count the cold key and the guardian as signers
    add.2
    # => [num_of_signers, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, SALT, approval_expiration_delta]

    exec.signature::estimate_multisig_authentication_cycles
    # => [num_extra_cycles, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, SALT, approval_expiration_delta]

    # use the signed block for the fee note.
    dup.5 movdn.5
    # => [num_extra_cycles, CONVERSION_INFO, bound_block_num, bound_block_num, approval_expiration_block_num, SALT, approval_expiration_delta]

    exec.fee::pay_fee drop
    # => [bound_block_num, approval_expiration_block_num, SALT, approval_expiration_delta]

    # Authenticate the transaction with the key categories and the guardian, then record it for
    # replay protection.
    # ---------------------------------------------------------------------------------------------

    exec.hot_cold_guardian::auth_tx
    # => [TX_SUMMARY_COMMITMENT, approval_expiration_delta]

    exec.multisig::record_and_assert_new_tx
    # => [approval_expiration_delta]

    # apply the approval expiration after tx summary extractions since the host cross-checks
    # the kernel expiration delta against the transaction summary delta
    # ---------------------------------------------------------------------------------------------

    exec.multisig::apply_approval_expiration
    # => []
end
