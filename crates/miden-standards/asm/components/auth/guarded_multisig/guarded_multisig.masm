# The MASM code of the Multi-Signature Authentication component integrated with a state guardian.
#
# See the `AuthGuardedMultisig` Rust type's documentation for more details.

use miden::protocol::active_account
use miden::protocol::tx
use miden::standards::auth::multisig
use {MULTISIG_POST_FEE_CYCLES} from miden::standards::auth::multisig
use miden::standards::fee
use miden::standards::auth::guardian

pub use {update_signers_and_threshold} from miden::standards::auth::multisig
pub use {get_threshold_and_num_approvers} from miden::standards::auth::multisig
pub use {set_procedure_threshold} from miden::standards::auth::multisig
pub use {get_signer_at} from miden::standards::auth::multisig
pub use {is_signer} from miden::standards::auth::multisig

pub use {update_guardian_public_key} from miden::standards::auth::guardian

#! Authenticate a transaction with multi-signature support and optional guardian verification,
#! paying the transaction fee in the process.
#!
#! The fee is paid as in the multisig component, after the approver and guardian signatures are
#! verified, and must stay within the max fee the summary binds. A max fee estimated by this
#! component counts the guardian as one more signer.
#!
#! The guardian must not be an approver, otherwise a single signature would satisfy both the
#! multisig and the guardian check, so this procedure re-checks the invariant that
#! `AuthGuardedMultisigConfig::new` enforces at deployment time. Both sides are read from the
#! current account state, so a guardian rotation or an approver-set update performed by this
#! transaction is covered.
#!
#! Inputs:
#!   Operand stack: [AUTH_ARGS]
#!   Advice map: { AUTH_ARGS: [PARAMS_WORD, SALT, CONVERSION_INFO] }
#! Outputs:
#!   Operand stack: []
#!
#! Where:
#! - AUTH_ARGS and its preimage are as described in `multisig::resolve_auth_args`.
#!
#! Panics if:
#! - insufficient number of valid approver or guardian signatures.
#! - the approval expired at or before the transaction reference block, see
#!   `multisig::assert_approval_not_expired`.
#! - the configured guardian public key is one of the approver public keys.
#! - the transaction fee and the sponsored fees exceed the max fee, see `fee::pay_bounded_fee`.
#! - the max fee is estimated with a zero fee margin.
#!
#! Invocation: call
@auth_script
pub proc auth_tx_guarded_multisig(auth_args: word)
    exec.multisig::resolve_auth_args
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, fee_margin_percent, SALT]

    # reject an expired approval before any signature is verified.
    # ---------------------------------------------------------------------------------------------

    dup.5 exec.tx::get_reference_block_number
    # => [reference_block_num, approval_expiration_block_num, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, fee_margin_percent, SALT]

    exec.multisig::assert_approval_not_expired movdn.12
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, fee_margin_percent, SALT, approval_expiration_delta]

    # Estimate the max fee unless the auth args carry one: an unsigned execution binds the
    # estimate into the summary, and the signed execution passes it back.
    # ---------------------------------------------------------------------------------------------

    movup.7
    # => [fee_margin_percent, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]

    dup.7 eq.0
    # => [is_max_fee_unset, fee_margin_percent, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]

    if.true
        exec.multisig::get_initial_threshold_and_num_approvers drop
        # => [num_of_signers, fee_margin_percent, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]

        # count the guardian as a signer; this overestimates a guardian rotation, which skips it
        add.1
        # => [num_of_signers, fee_margin_percent, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]

        exec.multisig::estimate_max_fee
        # => [max_fee, CONVERSION_INFO, bound_block_num, approval_expiration_block_num, 0, SALT, approval_expiration_delta]

        swap.7 drop
        # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]
    else
        drop
        # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, approval_expiration_delta]
    end

    # check a guardian rotation before the fee note exists, since a rotation must not create notes
    exec.guardian::assert_rotation_policy movdn.11
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, is_rotation, approval_expiration_delta]

    # Keep the fee payment inputs below the summary inputs and the rotation flag: the fee is paid
    # after the signatures are verified, and the fee note's serial number uses the signed block
    # and the initial nonce, which must be read before auth_tx increments it.
    # ---------------------------------------------------------------------------------------------

    dup.6 movdn.12
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, is_rotation, max_fee, approval_expiration_delta]

    exec.active_account::get_nonce movdn.12
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, is_rotation, initial_nonce, max_fee, approval_expiration_delta]

    dup.4 movdn.12
    # => [CONVERSION_INFO, bound_block_num, approval_expiration_block_num, max_fee, SALT, is_rotation, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    movdn.11 movdn.11 movdn.11 movdn.11
    # => [bound_block_num, approval_expiration_block_num, max_fee, SALT, is_rotation, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    # Authenticate the transaction with the approvers and the guardian.
    # ---------------------------------------------------------------------------------------------

    exec.multisig::auth_tx
    # => [TX_SUMMARY_COMMITMENT, is_rotation, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    dupw movup.8
    # => [is_rotation, TX_SUMMARY_COMMITMENT, TX_SUMMARY_COMMITMENT, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    exec.guardian::verify_signature
    # => [TX_SUMMARY_COMMITMENT, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    exec.guardian::get_guardian_public_key
    # => [GUARDIAN_PUBLIC_KEY, TX_SUMMARY_COMMITMENT, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    exec.multisig::assert_not_approver_public_key
    # => [TX_SUMMARY_COMMITMENT, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta]

    # Pay the transaction fee now that the transaction is authorized, and assert it stays within
    # the max fee the approvers signed.
    # ---------------------------------------------------------------------------------------------

    movdnw.2
    # => [CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta, TX_SUMMARY_COMMITMENT]

    push.MULTISIG_POST_FEE_CYCLES
    # => [num_extra_cycles, CONVERSION_INFO, bound_block_num, initial_nonce, max_fee, approval_expiration_delta, TX_SUMMARY_COMMITMENT]

    exec.fee::pay_bounded_fee
    # => [approval_expiration_delta, TX_SUMMARY_COMMITMENT]

    # Record the transaction for replay protection.
    # ---------------------------------------------------------------------------------------------

    movdn.4
    # => [TX_SUMMARY_COMMITMENT, approval_expiration_delta]

    exec.multisig::record_and_assert_new_tx
    # => [approval_expiration_delta]

    # apply the approval expiration after tx summary extractions since the host cross-checks
    # the kernel expiration delta against the transaction summary delta
    # ---------------------------------------------------------------------------------------------

    exec.multisig::apply_approval_expiration
    # => []
end
