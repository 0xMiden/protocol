# The MASM code of the Price Reader Manager Account Component.
#
# Holds which oracle account this account reads. Pair with an `Authority` component, which gates
# the setter. The conversion procedures are `exec`-invoked by other components on the same account
# and are therefore not part of this component's interface.
#
# See the `PriceReaderManager` Rust type's documentation for more details.

pub use {set_oracle} from miden::standards::oracle::price_reader_manager
