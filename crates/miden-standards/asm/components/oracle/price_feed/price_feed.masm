# The MASM code of the Price Feed Account Component.
#
# The published-price implementation behind a `PriceOracle`: `publish_price` maintains the prices
# and `compute_conversion_rate` is the dispatch target registered through
# `PriceOracle::set_implementation`.
#
# See the `PriceFeed` Rust type's documentation for more details.

pub use {compute_conversion_rate} from miden::standards::oracle::price_feed
pub use {publish_price} from miden::standards::oracle::price_feed
