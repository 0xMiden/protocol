# The MASM code of the `allow_all` Transfer Policy Account Component.
#
# Exposes the `check_send_policy` and `check_receive_policy` procedures so their MAST roots can be
# registered as the active (or allowed) send and receive policies on a `TokenPolicyManager`.
# Storage-free.

pub use {check_send_policy} from miden::standards::faucets::policies::transfer::allow_all
pub use {check_receive_policy} from miden::standards::faucets::policies::transfer::allow_all
