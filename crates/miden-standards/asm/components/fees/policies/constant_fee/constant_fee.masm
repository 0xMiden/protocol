# The MASM code of the `constant_fee` Fee Policy Account Component.
#
# Exposes:
# - `compute_note_fee`: the procedure whose MAST root is registered as the active (or allowed)
#   fee policy on a `FeeManager`.
# - `build_default_note_fee_lookup_key`: the default lookup-key builder; the procedure's MAST
#   root is stored in the `active_lookup_key_builder_proc_root` slot for dynamic invocation.
#
# Owns the `fee_asset_id`, `fee_schedule`, `active_lookup_key_builder_proc_root`, and
# `allowed_lookup_key_builder_proc_roots` slots.
#
# See the `ConstantFeePolicy` Rust type's documentation for more details.

pub use {compute_note_fee} from miden::standards::fees::policies::constant_fee
pub use {build_default_note_fee_lookup_key} from miden::standards::fees::policies::constant_fee
