# The MASM code of the `constant_fee` Fee Policy Account Component.
#
# Exposes the `compute_note_fee` procedure so its MAST root can be registered as the active
# (or allowed) fee policy on a `FeeManager`, and the `build_note_fee_lookup_key` procedure so its
# MAST root can be stored in the `lookup_key_proc_root` slot for dynamic invocation. Owns the
# `fee_asset_id`, `fee_schedule`, and `lookup_key_proc_root` slots.
#
# See the `ConstantFeePolicy` Rust type's documentation for more details.

pub use {compute_note_fee} from miden::standards::fees::policies::constant_fee
pub use {build_note_fee_lookup_key} from miden::standards::fees::policies::constant_fee
