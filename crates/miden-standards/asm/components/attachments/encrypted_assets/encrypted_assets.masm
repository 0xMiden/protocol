# The MASM code of the encrypted asset attachments account component.
#
# Installs the issuer key slots that `miden::standards::attachments::encrypted_assets::new` reads,
# and exposes the `get_issuer_key` accessor and the authority-gated `set_issuer_key`.

pub use {get_issuer_key} from miden::standards::attachments::encrypted_assets
pub use {set_issuer_key} from miden::standards::attachments::encrypted_assets
