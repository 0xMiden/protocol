# miden::standards::oracle::price_oracle
#
# The user-facing price oracle interface: a single procedure answering "how much of one asset is
# another worth".
#
# A rate is returned rather than a converted amount, matching the `ConversionRate` vocabulary the
# fee standard already uses. Consumers apply it with `fee::convert_amount`, which computes
# `ceil(amount * num / den)` at 128-bit intermediate precision, so this standard does not restate
# that arithmetic and both paths share one rounding convention.
#
# WARNING: the body of `get_conversion_rate` MUST NOT change. Consumers reach it over FPI by its
# MAST root, which is a hash of that body, so any edit rewrites the address every consumer resolved
# against. The body is deliberately trivial: it reads a procedure root from storage and dispatches
# to it, which is what lets the rate provider be replaced while the address stays put.
#
# The wrapper is a stable address, NOT a gate. A dispatch target must itself be an account
# procedure to be `dyncall` reachable, which also makes it reachable directly over FPI, so an
# rate provider cannot rely on the wrapper having run first: every guarantee it needs, including
# its transaction expiration delta, has to be enforced in its own body.

use miden::protocol::active_account
use miden::protocol::native_account
use miden::standards::access::authority
use {AccountProcedureRoot, AssetId} from miden::protocol::types
use {ConversionRate} from miden::standards::fee

# CONSTANTS - slot names
# =================================================================================================

# Procedure root of the rate provider `get_conversion_rate` dispatches to.
# Layout: [RATE_PROVIDER_PROC_ROOT]
pub const ACTIVE_RATE_PROVIDER_PROC_ROOT_SLOT = word("miden::standards::oracle::price_oracle::active_rate_provider_proc_root")

# PUBLIC INTERFACE
# =================================================================================================

#! Returns the rate converting the source asset into the target asset.
#!
#! WARNING: do not edit this procedure. See the module documentation: its MAST root is the address
#! consumers resolve against, and the body exists only to keep that address stable across
#! rate provider changes.
#!
#! A rate of `den = 0` means the active rate provider cannot price this pair. It is returned rather
#! than raised as a failure so a caller valuing many assets can decide what an unpriceable one
#! means, instead of losing the whole transaction. Handing such a rate to `fee::convert_amount`
#! aborts on its zero-denominator assertion, so ignoring the case still fails closed.
#!
#! Inputs:  [SOURCE_ASSET_ID, TARGET_ASSET_ID, pad(8)]
#! Outputs: [num, den, pad(14)]
#!
#! Where:
#! - SOURCE_ASSET_ID is the asset being converted from.
#! - TARGET_ASSET_ID is the asset being converted to.
#! - num and den express the rate: `amount` of the source asset is worth
#!   `ceil(amount * num / den)` of the target asset.
#! - den is 0 when the pair cannot be priced, in which case num is 0 as well.
#!
#! A rate provider must not derive a rate from data it considers too old to rely on: it reports
#! `den = 0` for a stale pair exactly as it does for one it has never priced. Freshness is enforced
#! there rather than reported here, because only the rate provider knows the age of its inputs and
#! how often they are refreshed.
#!
#! Panics if:
#! - no rate provider is configured.
#! - the active rate provider aborts.
#!
#! Invocation: call
@locals(4) # rate provider procedure root
@account_procedure
pub proc get_conversion_rate(source: AssetId, target: AssetId) -> ConversionRate
    push.ACTIVE_RATE_PROVIDER_PROC_ROOT_SLOT[0..2] exec.active_account::get_item
    # => [RATE_PROVIDER_PROC_ROOT, SOURCE_ASSET_ID, TARGET_ASSET_ID, pad(8)]

    loc_storew_le.0 dropw
    # => [SOURCE_ASSET_ID, TARGET_ASSET_ID, pad(8)]

    locaddr.0
    # => [rate_provider_proc_root_ptr, SOURCE_ASSET_ID, TARGET_ASSET_ID, pad(8)]

    dyncall
    # => [num, den, pad(14)]
end

# CONFIGURATION PROCEDURES
# =================================================================================================

#! Sets the rate provider `get_conversion_rate` dispatches to.
#!
#! The root must belong to a procedure of this account, since `dyncall` can only reach the account's
#! own procedures.
#!
#! Inputs:  [RATE_PROVIDER_PROC_ROOT, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - RATE_PROVIDER_PROC_ROOT is the procedure root of the rate provider.
#!
#! Panics if:
#! - the caller is not authorized per the installed `Authority`.
#!
#! Invocation: call
@account_procedure
pub proc set_rate_provider(rate_provider_proc_root: AccountProcedureRoot)
    exec.authority::assert_authorized
    # => [RATE_PROVIDER_PROC_ROOT, pad(12)]

    push.ACTIVE_RATE_PROVIDER_PROC_ROOT_SLOT[0..2] exec.native_account::set_item
    # => [OLD_ROOT, pad(12)]

    dropw
    # => [pad(12)]
end
