# miden::standards::oracle::price_oracle
#
# The user-facing price oracle interface: a single procedure returning the rate between two assets.
#
# The rate is returned as a `ConversionRate`. Callers apply it with `fee::convert_amount`.
# Alongside it comes the time the rate was observed, so a caller can enforce a freshness bound
# tighter than the rate provider's own.
#
# `get_conversion_rate` is a stable MAST root that invokes the rate provider dynamically.

use miden::core::word
use miden::protocol::active_account
use miden::protocol::native_account
use miden::standards::access::authority
use {AccountProcedureRoot, AssetId} from miden::protocol::types
use {ConversionRate} from miden::standards::fee

# CONSTANTS - errors
# =================================================================================================

const ERR_PRICE_ORACLE_RATE_PROVIDER_ROOT_IS_ZERO = "rate provider procedure root must be non-zero"
const ERR_PRICE_ORACLE_RATE_PROVIDER_NOT_IN_ACCOUNT = "rate provider procedure is not part of this account"
const ERR_PRICE_ORACLE_LAST_UPDATED_NOT_U32 = "rate provider returned a last_updated value that is not a u32"
const ERR_PRICE_ORACLE_LAST_UPDATED_DEN_MISMATCH = "rate provider must return a zero last_updated exactly when the rate denominator is zero"

# CONSTANTS - slot names
# =================================================================================================

# Procedure root of the rate provider `get_conversion_rate` dispatches to.
# Layout: [RATE_PROVIDER_PROC_ROOT]
pub const ACTIVE_RATE_PROVIDER_PROC_ROOT_SLOT = word("miden::standards::oracle::price_oracle::active_rate_provider_proc_root")

# PUBLIC INTERFACE
# =================================================================================================

#! Returns the rate converting the source asset into the target asset, and when that rate was last
#! updated.
#!
#! Inputs:  [SOURCE_ASSET_ID, TARGET_ASSET_ID, pad(8)]
#! Outputs: [last_updated, num, den, pad(13)]
#!
#! Where:
#! - SOURCE_ASSET_ID is the asset being converted from.
#! - TARGET_ASSET_ID is the asset being converted to.
#! - last_updated is a unix timestamp of when the rate was observed, or 0 when the active rate
#!   provider cannot price the pair.
#! - num and den express the rate, and are only valid when last_updated is non-zero.
#!
#! Panics if:
#! - no rate provider is configured.
#! - the active rate provider aborts.
#! - the active rate provider returns a last_updated that is not a u32.
#! - exactly one of last_updated and den returned by the active rate provider is zero.
#!
#! Invocation: call
@locals(4)
@account_procedure
pub proc get_conversion_rate(source: AssetId, target: AssetId) -> (u32, ConversionRate)
    push.ACTIVE_RATE_PROVIDER_PROC_ROOT_SLOT[0..2] exec.active_account::get_item
    # => [RATE_PROVIDER_PROC_ROOT, SOURCE_ASSET_ID, TARGET_ASSET_ID, pad(8)]

    loc_storew_le.0 dropw
    # => [SOURCE_ASSET_ID, TARGET_ASSET_ID, pad(8)]

    locaddr.0
    # => [rate_provider_proc_root_ptr, SOURCE_ASSET_ID, TARGET_ASSET_ID, pad(8)]

    dyncall
    # => [last_updated, num, den, pad(13)]

    # callers apply u32 ops to last_updated, so the interface guarantees its bound once here
    u32assert.err=ERR_PRICE_ORACLE_LAST_UPDATED_NOT_U32
    # => [last_updated, num, den, pad(13)]

    # last_updated also marks whether the pair is priced, so it must agree with den: a caller that
    # skips the check then still hands `fee::convert_amount` a zero den and aborts
    dup eq.0 dup.3 eq.0
    # => [is_den_zero, is_unpriced, last_updated, num, den, pad(13)]

    assert_eq.err=ERR_PRICE_ORACLE_LAST_UPDATED_DEN_MISMATCH
    # => [last_updated, num, den, pad(13)]
end

# CONFIGURATION PROCEDURES
# =================================================================================================

#! Sets the rate provider `get_conversion_rate` dispatches to.
#!
#! Inputs:  [RATE_PROVIDER_PROC_ROOT, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - RATE_PROVIDER_PROC_ROOT is the procedure root of the rate provider.
#!
#! Panics if:
#! - the caller is not authorized per the installed `Authority`.
#! - the root is zero, which would leave the oracle unable to answer.
#! - the root is not a procedure of this account, since `dyncall` could never reach it.
#!
#! Invocation: call
@account_procedure
pub proc set_rate_provider(rate_provider_proc_root: AccountProcedureRoot)
    exec.authority::assert_authorized
    # => [RATE_PROVIDER_PROC_ROOT, pad(12)]

    exec.word::testz assertz.err=ERR_PRICE_ORACLE_RATE_PROVIDER_ROOT_IS_ZERO
    # => [RATE_PROVIDER_PROC_ROOT, pad(12)]

    dupw exec.active_account::has_procedure
    assert.err=ERR_PRICE_ORACLE_RATE_PROVIDER_NOT_IN_ACCOUNT
    # => [RATE_PROVIDER_PROC_ROOT, pad(12)]

    push.ACTIVE_RATE_PROVIDER_PROC_ROOT_SLOT[0..2] exec.native_account::set_item
    # => [OLD_ROOT, pad(12)]

    dropw
    # => [pad(12)]
end
