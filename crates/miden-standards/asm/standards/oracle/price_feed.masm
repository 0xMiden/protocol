# miden::standards::oracle::price_feed
#
# `PriceFeed` publishes unit prices for fungible assets, all quoted in a single quote unit.
#
# A price is a `(price, exponent)` pair: the real value of one unit of the priced asset is
# `price * 10^(-exponent)`, expressed in the feed's quote unit. Consumers read prices through
# `get_price` over FPI and are responsible for turning a unit price into a notional value; this
# component deliberately does NOT multiply by an asset amount.
#
# The quote unit lives in a value slot written once at deployment time and has no setter, so a
# consumer that verified the quote at configuration time can rely on it not changing underneath.
#
# `get_price` applies its own transaction expiration delta rather than relying on the consumer to
# do so. FPI reads reflect the transaction's reference block, which the executor picks, so a feed
# that does not bound the reference block lets a stale price be presented as current.

use miden::core::sys
use miden::protocol::active_account
use miden::protocol::native_account
use miden::protocol::tx
use miden::standards::access::authority
use {Bool, StorageMapKey} from miden::protocol::types

# CONSTANTS - slot names
# =================================================================================================

# Quote unit every price published by this feed is denominated in. Layout: [QUOTE_ID]
pub const QUOTE_SLOT = word("miden::standards::oracle::price_feed::quote")

# Published prices. Layout: FAUCET_ID => [price, exponent, timestamp, 0]
pub const PRICES_SLOT = word("miden::standards::oracle::price_feed::prices")

# CONSTANTS - expiration
# =================================================================================================

# Transaction expiration delta, in blocks, applied by `get_price`.
#
# Bounds how far the transaction's reference block may lag the block the transaction is included
# in, which in turn bounds how stale the price read over FPI can be. Sized for a price that is
# expected to be refreshed on the order of every 30 seconds.
const PRICE_EXPIRATION_BLOCK_DELTA = 10

# ERRORS
# =================================================================================================

const ERR_PRICE_FEED_KEY_NOT_CANONICAL = "faucet id key must be [prefix, suffix, 0, 0]"
const ERR_PRICE_FEED_PRICE_ZERO = "published price must be non-zero"
const ERR_PRICE_FEED_EXPONENT_OR_TIMESTAMP_NOT_U32 = "price exponent and timestamp must be valid u32 values"

# INTERNAL PROCEDURES
# =================================================================================================

#! Asserts that a faucet id key has the canonical `[prefix, suffix, 0, 0]` shape.
#!
#! The two trailing felts carry no information, so leaving them unconstrained would let the same
#! faucet be published and read under different keys.
#!
#! Inputs:  [FAUCET_ID]
#! Outputs: [FAUCET_ID]
#!
#! Where:
#! - FAUCET_ID is the storage map key of the priced asset's faucet.
#!
#! Panics if:
#! - either of the two trailing felts of FAUCET_ID is non-zero.
#!
#! Invocation: exec
proc assert_canonical_faucet_id(faucet_id: StorageMapKey) -> StorageMapKey
    dup.2 assertz.err=ERR_PRICE_FEED_KEY_NOT_CANONICAL
    # => [FAUCET_ID]

    dup.3 assertz.err=ERR_PRICE_FEED_KEY_NOT_CANONICAL
    # => [FAUCET_ID]
end

# PUBLIC INTERFACE
# =================================================================================================

#! Returns the published price of the asset issued by the given faucet.
#!
#! Applies this feed's transaction expiration delta before reading, so the caller cannot widen how
#! stale the returned price may be.
#!
#! An asset with no published price reads back as the empty word, which yields `is_tracked = 0`.
#! `publish_price` rejects a zero price, so a zero `price` unambiguously means "not tracked".
#!
#! Inputs:  [FAUCET_ID, pad(12)]
#! Outputs: [is_tracked, price, exponent, timestamp, pad(12)]
#!
#! Where:
#! - FAUCET_ID is the faucet of the priced asset, as the word [prefix, suffix, 0, 0].
#! - is_tracked is 1 if this feed publishes a price for the asset, 0 otherwise.
#! - price is the price of one unit of the asset in the feed's quote unit, scaled by exponent.
#! - exponent is the decimal exponent of price; the real value is `price * 10^(-exponent)`.
#! - timestamp is the block timestamp, in seconds, at which the price was published.
#!
#! Panics if:
#! - FAUCET_ID is not of the form [prefix, suffix, 0, 0].
#!
#! Invocation: call
@account_procedure
pub proc get_price(faucet_id: StorageMapKey) -> (Bool, felt, felt, u32)
    push.PRICE_EXPIRATION_BLOCK_DELTA exec.tx::update_expiration_block_delta
    # => [FAUCET_ID, pad(12)]

    exec.assert_canonical_faucet_id
    # => [FAUCET_ID, pad(12)]

    push.PRICES_SLOT[0..2] exec.active_account::get_map_item
    # => [price, exponent, timestamp, 0, pad(12)]

    dup neq.0
    # => [is_tracked, price, exponent, timestamp, 0, pad(12)]

    # discard the value word's trailing zero only after `is_tracked` has been derived, so the
    # operand stack never dips below the 16-felt call frame and grows back past it
    movup.4 drop
    # => [is_tracked, price, exponent, timestamp, pad(12)]
end

#! Returns the quote unit every price published by this feed is denominated in.
#!
#! Inputs:  [pad(16)]
#! Outputs: [QUOTE_ID, pad(12)]
#!
#! Where:
#! - QUOTE_ID identifies the unit prices are quoted in. It is an opaque word by design: quote units
#!   such as USD have no faucet on Miden, so an account id cannot represent them.
#!
#! Invocation: call
@account_procedure
pub proc get_quote_id() -> word
    push.QUOTE_SLOT[0..2] exec.active_account::get_item
    # => [QUOTE_ID, pad(16)]

    swapw dropw
    # => [QUOTE_ID, pad(12)]
end

#! Publishes the price of the asset issued by the given faucet, overwriting any previous entry.
#!
#! Inputs:  [FAUCET_ID, price, exponent, timestamp, pad(9)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - FAUCET_ID is the faucet of the priced asset, as the word [prefix, suffix, 0, 0].
#! - price is the price of one unit of the asset in this feed's quote unit, scaled by exponent.
#! - exponent is the decimal exponent of price; the real value is `price * 10^(-exponent)`.
#! - timestamp is the block timestamp, in seconds, at which the price was observed.
#!
#! Panics if:
#! - the caller is not authorized per the installed `Authority`.
#! - FAUCET_ID is not of the form [prefix, suffix, 0, 0].
#! - price is zero, which is reserved to mean "not tracked".
#! - exponent or timestamp is not a valid u32.
#!
#! Invocation: call
@account_procedure
pub proc publish_price(faucet_id: StorageMapKey, price: felt, exponent: u32, timestamp: u32)
    exec.authority::assert_authorized
    # => [FAUCET_ID, price, exponent, timestamp, pad(9)]

    exec.assert_canonical_faucet_id
    # => [FAUCET_ID, price, exponent, timestamp, pad(9)]

    dup.4 neq.0 assert.err=ERR_PRICE_FEED_PRICE_ZERO
    # => [FAUCET_ID, price, exponent, timestamp, pad(9)]

    dup.5 dup.7 u32assert2.err=ERR_PRICE_FEED_EXPONENT_OR_TIMESTAMP_NOT_U32 drop drop
    # => [FAUCET_ID, price, exponent, timestamp, pad(9)]

    # the felt below timestamp is caller-supplied padding, so it is replaced with a zero to
    # complete the value word rather than trusted to already be zero
    movup.7 drop push.0 movdn.7
    # => [FAUCET_ID, price, exponent, timestamp, 0, pad(8)]

    push.PRICES_SLOT[0..2] exec.native_account::set_map_item
    # => [OLD_VALUE, pad(8)]

    dropw
    # => [pad(8)]

    # the frame dipped to the stack's 16-felt floor above, so its depth is restored explicitly
    exec.sys::truncate_stack
    # => [pad(16)]
end
