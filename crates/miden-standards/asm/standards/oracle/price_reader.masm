# miden::standards::oracle::price_reader
#
# Consumer-side helpers for reading a `price_oracle` over FPI.
#
# The oracle's procedure root is not configuration: it is embedded here with `procref`, which
# resolves the stable wrapper's MAST root at assembly time. That is the practical payoff of keeping
# that wrapper's body fixed - a consumer needs to know only which account to ask, never which
# implementation it runs.
#
# Freshness is offered as a helper rather than enforced. How stale a rate may be is a consumer
# decision: a spending limit and a liquidation engine do not want the same bound, so this module
# hands back the timestamp and lets the caller pick.

use miden::protocol::tx
use miden::standards::oracle::price_oracle
use {AccountId, AssetId} from miden::protocol::types
use {ConversionRate} from miden::standards::fee

# ERRORS
# =================================================================================================

const ERR_PRICE_READER_TIMESTAMP_OR_MAX_AGE_NOT_U32 = "rate timestamp and maximum age must be valid u32 values"
const ERR_PRICE_READER_TIMESTAMP_IN_FUTURE = "rate timestamp is after the current block timestamp"
const ERR_PRICE_READER_RATE_STALE = "conversion rate is older than the configured maximum age"

# PROCEDURES
# =================================================================================================

#! Reads the rate converting the source asset into the target asset from the given oracle account.
#!
#! A rate of `den = 0` means the oracle cannot price this pair. Callers valuing a single asset can
#! pass the rate straight to `fee::convert_amount`, whose zero-denominator assertion aborts; callers
#! valuing many assets can branch on it and decide what an unpriceable one means to them.
#!
#! Inputs:  [SOURCE_ASSET_ID, TARGET_ASSET_ID, oracle_id_suffix, oracle_id_prefix]
#! Outputs: [num, den, timestamp]
#!
#! Where:
#! - SOURCE_ASSET_ID is the asset being converted from.
#! - TARGET_ASSET_ID is the asset being converted to.
#! - oracle_id_{suffix,prefix} identify the oracle account to read.
#! - num and den express the rate: `amount` of the source asset is worth
#!   `ceil(amount * num / den)` of the target asset.
#! - timestamp is the block timestamp, in seconds, of the stalest input the rate was derived from.
#!
#! Panics if:
#! - the oracle account has no implementation configured, or its implementation aborts.
#!
#! Invocation: exec
@locals(10) # source asset id (4) + target asset id (4) + oracle account id (2)
pub proc get_conversion_rate(source: AssetId, target: AssetId, oracle_account_id: AccountId)
    -> (ConversionRate, u32)
    movup.8 loc_store.8 movup.8 loc_store.9
    # => [SOURCE_ASSET_ID, TARGET_ASSET_ID]

    # the arguments are cached because `tx::execute_foreign_procedure` consumes a full 16-felt
    # input frame, so the frame has to be rebuilt from the bottom up
    loc_storew_le.0 dropw
    # => [TARGET_ASSET_ID]

    loc_storew_le.4 dropw
    # => []

    padw padw
    # => [pad(8)]

    padw loc_loadw_le.4
    # => [TARGET_ASSET_ID, pad(8)]

    padw loc_loadw_le.0
    # => [SOURCE_ASSET_ID, TARGET_ASSET_ID, pad(8)]

    procref.price_oracle::get_conversion_rate
    # => [GET_CONVERSION_RATE_ROOT, SOURCE_ASSET_ID, TARGET_ASSET_ID, pad(8)]

    loc_load.9 loc_load.8
    # => [oracle_id_suffix, oracle_id_prefix, GET_CONVERSION_RATE_ROOT, SOURCE_ASSET_ID,
    #     TARGET_ASSET_ID, pad(8)]

    exec.tx::execute_foreign_procedure
    # => [num, den, timestamp, pad(13)]

    movdnw.3 dropw dropw dropw
    # => [num, den, timestamp, 0]

    movup.3 drop
    # => [num, den, timestamp]
end

#! Asserts that a rate is neither dated in the future nor older than the given maximum age.
#!
#! Inputs:  [timestamp, max_age_secs]
#! Outputs: []
#!
#! Where:
#! - timestamp is the rate's freshness, as returned by `get_conversion_rate`.
#! - max_age_secs is the largest age, in seconds, the caller accepts.
#!
#! Panics if:
#! - timestamp or max_age_secs is not a valid u32.
#! - timestamp is after the current block timestamp.
#! - the rate is older than max_age_secs.
#!
#! Invocation: exec
pub proc assert_fresh(timestamp: u32, max_age_secs: u32)
    u32assert2.err=ERR_PRICE_READER_TIMESTAMP_OR_MAX_AGE_NOT_U32
    # => [timestamp, max_age_secs]

    exec.tx::get_block_timestamp
    # => [now, timestamp, max_age_secs]

    # future timestamps are rejected explicitly rather than left to wrap around in the subtraction
    dup.1 dup.1 u32lte assert.err=ERR_PRICE_READER_TIMESTAMP_IN_FUTURE
    # => [now, timestamp, max_age_secs]

    swap sub
    # => [age, max_age_secs]

    swap u32lte assert.err=ERR_PRICE_READER_RATE_STALE
    # => []
end
