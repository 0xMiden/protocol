# miden::standards::oracle::price_reader_manager
#
# Holds which oracle an account reads and exposes conversions over it.
#
# That is the whole configuration: the oracle's procedure root is resolved at assembly time from
# the stable wrapper (see [`price_reader`]), so swapping the oracle's pricing implementation never
# touches a consumer's storage.
#
# The conversion procedures are `exec`-invoked by other components installed on the same account,
# so the oracle read happens in the native account's context.

use miden::core::sys
use miden::protocol::active_account
use miden::protocol::asset
use miden::protocol::native_account
use miden::standards::access::authority
use miden::standards::assets::fungible_asset
use miden::standards::fee
use miden::standards::oracle::price_reader
use {COMPOSITION_FUNGIBLE} from miden::protocol::asset
use {AccountId, Asset, AssetId} from miden::protocol::types
use {ConversionRate} from miden::standards::fee

# CONSTANTS - slot names
# =================================================================================================

# Oracle account this reader queries. Layout: [prefix, suffix, 0, 0]
pub const ORACLE_SLOT = word("miden::standards::oracle::price_reader_manager::oracle")

# ERRORS
# =================================================================================================

const ERR_PRICE_READER_MANAGER_ORACLE_NOT_CONFIGURED = "price oracle account is not configured"
const ERR_PRICE_READER_MANAGER_ORACLE_ID_INVALID = "price oracle account id must be non-zero"
const ERR_PRICE_READER_MANAGER_ASSET_NOT_FUNGIBLE = "the asset being converted must be fungible"
const ERR_PRICE_READER_MANAGER_TARGET_NOT_FUNGIBLE = "the target asset must be fungible"

# INTERNAL PROCEDURES
# =================================================================================================

#! Reads the configured oracle account id.
#!
#! Inputs:  []
#! Outputs: [oracle_id_suffix, oracle_id_prefix]
#!
#! Panics if:
#! - no oracle account is configured.
#!
#! Invocation: exec
proc read_oracle_id() -> AccountId
    push.ORACLE_SLOT[0..2] exec.active_account::get_item
    # => [oracle_id_prefix, oracle_id_suffix, 0, 0]

    dup neq.0 assert.err=ERR_PRICE_READER_MANAGER_ORACLE_NOT_CONFIGURED
    # => [oracle_id_prefix, oracle_id_suffix, 0, 0]

    movdn.3 movdn.3 drop drop swap
    # => [oracle_id_suffix, oracle_id_prefix]
end

# CONVERSION PROCEDURES
# =================================================================================================

#! Returns the rate converting the source asset into the target asset, read from the configured
#! oracle.
#!
#! Inputs:  [SOURCE_ASSET_ID, TARGET_ASSET_ID]
#! Outputs: [num, den, timestamp]
#!
#! Where:
#! - SOURCE_ASSET_ID is the asset being converted from.
#! - TARGET_ASSET_ID is the asset being converted to.
#! - num and den express the rate; den is 0 when the oracle cannot price the pair.
#! - timestamp is the block timestamp, in seconds, of the stalest input the rate was derived from.
#!
#! Panics if:
#! - no oracle account is configured.
#!
#! Invocation: exec
pub proc get_conversion_rate(source: AssetId, target: AssetId) -> (ConversionRate, u32)
    exec.read_oracle_id
    # => [oracle_id_suffix, oracle_id_prefix, SOURCE_ASSET_ID, TARGET_ASSET_ID]

    movdn.9 movdn.9
    # => [SOURCE_ASSET_ID, TARGET_ASSET_ID, oracle_id_suffix, oracle_id_prefix]

    exec.price_reader::get_conversion_rate
    # => [num, den, timestamp]
end

#! Converts a fungible asset's amount into the target asset.
#!
#! Applies the rate with `fee::convert_amount`, which rounds up and rejects a zero denominator, so
#! an asset the oracle cannot price aborts here. Callers that want to handle that case instead of
#! aborting should use `get_conversion_rate` and branch on `den`.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, TARGET_ASSET_ID]
#! Outputs: [converted_amount, timestamp]
#!
#! Where:
#! - ASSET_ID and ASSET_VALUE are the id and value words of the asset being converted.
#! - TARGET_ASSET_ID is the asset the amount is expressed in on the way out.
#! - converted_amount is `ceil(amount * num / den)`, in the target asset's base units.
#! - timestamp is the block timestamp, in seconds, of the stalest input the rate was derived from.
#!
#! Panics if:
#! - either asset is not fungible.
#! - no oracle account is configured.
#! - the oracle cannot price the pair.
#! - the converted amount overflows a fungible asset amount.
#!
#! Invocation: exec
@locals(2) # asset amount (1) + rate timestamp (1)
pub proc convert_asset_amount(asset: Asset, target: AssetId) -> (felt, u32)
    # both sides are checked before the value word is read as an amount: for a non-fungible asset
    # that word carries data, not a quantity, so converting it would produce a plausible number out
    # of something that was never one
    dupw exec.asset::id_into_composition eq.COMPOSITION_FUNGIBLE
    assert.err=ERR_PRICE_READER_MANAGER_ASSET_NOT_FUNGIBLE
    # => [ASSET_ID, ASSET_VALUE, TARGET_ASSET_ID]

    dupw.2 exec.asset::id_into_composition eq.COMPOSITION_FUNGIBLE
    assert.err=ERR_PRICE_READER_MANAGER_TARGET_NOT_FUNGIBLE
    # => [ASSET_ID, ASSET_VALUE, TARGET_ASSET_ID]

    swapw exec.asset::fungible_value_into_amount loc_store.0
    # => [ASSET_ID, TARGET_ASSET_ID]

    exec.get_conversion_rate
    # => [num, den, timestamp]

    movup.2 loc_store.1
    # => [num, den]

    loc_load.0
    # => [amount, num, den]

    exec.fee::convert_amount
    # => [converted_amount]

    loc_load.1
    # => [timestamp, converted_amount]

    swap
    # => [converted_amount, timestamp]
end

#! Converts a fungible asset into the target asset.
#!
#! The amount-only [`convert_asset_amount`] is the same conversion without the asset words; this
#! procedure exists because a caller that goes on to move the result wants an asset, not a number.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, TARGET_ASSET_ID]
#! Outputs: [TARGET_ASSET_ID, TARGET_ASSET_VALUE, timestamp]
#!
#! Where:
#! - ASSET_ID and ASSET_VALUE are the id and value words of the asset being converted.
#! - TARGET_ASSET_ID is the asset the result is denominated in, returned unchanged.
#! - TARGET_ASSET_VALUE is the converted amount as the value word [amount, 0, 0, 0].
#! - timestamp is the block timestamp, in seconds, of the stalest input the rate was derived from.
#!
#! Panics if:
#! - either asset is not fungible.
#! - no oracle account is configured.
#! - the oracle cannot price the pair.
#! - the converted amount overflows a fungible asset amount.
#!
#! Invocation: exec
@locals(5) # target asset id (4) + rate timestamp (1)
pub proc convert_asset(asset: Asset, target: AssetId) -> (Asset, u32)
    dupw.2 loc_storew_le.0 dropw
    # => [ASSET_ID, ASSET_VALUE, TARGET_ASSET_ID]

    exec.convert_asset_amount
    # => [converted_amount, timestamp]

    swap loc_store.4
    # => [converted_amount]

    exec.fungible_asset::create_value
    # => [TARGET_ASSET_VALUE]

    padw loc_loadw_le.0
    # => [TARGET_ASSET_ID, TARGET_ASSET_VALUE]

    loc_load.4 movdn.8
    # => [TARGET_ASSET_ID, TARGET_ASSET_VALUE, timestamp]
end

# CONFIGURATION PROCEDURES
# =================================================================================================

#! Sets the oracle account this reader queries.
#!
#! Inputs:  [oracle_id_suffix, oracle_id_prefix, pad(14)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - oracle_id_{suffix,prefix} identify the oracle account.
#!
#! Panics if:
#! - the caller is not authorized per the installed `Authority`.
#! - the oracle account id prefix is zero.
#!
#! Invocation: call
@account_procedure
pub proc set_oracle(oracle_account_id: AccountId)
    exec.authority::assert_authorized
    # => [oracle_id_suffix, oracle_id_prefix, pad(14)]

    dup.1 neq.0 assert.err=ERR_PRICE_READER_MANAGER_ORACLE_ID_INVALID
    # => [oracle_id_suffix, oracle_id_prefix, pad(14)]

    swap push.0.0 movdn.3 movdn.3
    # => [ORACLE_ACCOUNT_ID, pad(14)]

    push.ORACLE_SLOT[0..2] exec.native_account::set_item
    # => [OLD_VALUE, pad(14)]

    dropw
    # => [pad(14)]

    exec.sys::truncate_stack
    # => [pad(16)]
end
