# miden::standards::fees
#
# Fee collection for the fee manager account. `collect_sponsored_fees` walks the transaction's
# input notes and credits the fees prepaid by FEE_SPONSORSHIP notes to the account vault, pricing
# each feature note through the active fee policy owned by the `fee_manager` module.

use miden::core::word

use miden::protocol::input_note
use miden::protocol::native_account
use miden::protocol::tx
use miden::protocol::asset

use miden::standards::assets::fungible_asset
use miden::standards::note
use miden::standards::note::note_id
use miden::standards::notes::fee_sponsorship
use {NUM_ASSETS as SPONSORSHIP_NUM_ASSETS} from miden::standards::notes::fee_sponsorship

pub mod fee_manager
pub mod policies

# CONSTANTS
# =================================================================================================

# Local memory offset at which `collect_sponsored_fees` caches the collected fee asset ID. It is
# initialized to the empty word, which doubles as a "no fee collected yet" marker.
const FEE_ASSET_ID_LOC = 0

# Local memory offset at which `assert_neighbor_sponsors` stages a paired FEE_SPONSORSHIP note's
# storage items to read its sponsored feature note ID. Sized for the note's storage items padded to
# the next multiple of 8 felts.
const SPONSORSHIP_STORAGE_LOC = 0

# ERRORS
# =================================================================================================

const ERR_FEE_MANAGER_UNEXPECTED_SPONSORSHIP_NOTE = "encountered a FEE_SPONSORSHIP note that is not paired with a feature note requiring a fee"

const ERR_FEE_MANAGER_FEATURE_NOTE_MISSING_SPONSORSHIP = "feature note is not paired with a FEE_SPONSORSHIP note at the following input note index"

const ERR_FEE_MANAGER_SPONSORSHIP_WRONG_ASSET = "FEE_SPONSORSHIP note asset does not match the fee asset the account accepts"

const ERR_FEE_MANAGER_SPONSORSHIP_WRONG_FEATURE_NOTE = "paired FEE_SPONSORSHIP note does not sponsor the neighboring feature note"

const ERR_FEE_MANAGER_SPONSORSHIP_FEE_TOO_LOW = "FEE_SPONSORSHIP note fee amount does not cover the required fee"

const ERR_FEE_MANAGER_INCONSISTENT_FEE_ASSET = "feature notes priced in different fee assets cannot be collected in the same transaction"

const ERR_FEE_MANAGER_SPONSORSHIP_WRONG_NUM_ASSETS = "FEE_SPONSORSHIP note must carry exactly one asset"

# PUBLIC INTERFACE
# =================================================================================================

#! Collects the fees prepaid by the FEE_SPONSORSHIP notes among the transaction's input notes and
#! credits the aggregated fee directly to the account's vault.
#!
#! Walks the input notes. Every note that is not a FEE_SPONSORSHIP note is a "feature note". For a
#! feature note whose fee (per the active fee policy) is non-zero, a FEE_SPONSORSHIP note must sit
#! at the immediately following input-note index, forming a 1:1 feature-note -> sponsorship-note
#! pairing. For each such pair this procedure prices the feature note through the active fee policy
#! (the same computation as `fee_manager::estimate_note_fee`), asserts the sponsorship note actually
#! sponsors that feature note (its stored feature note ID matches the feature note's ID), moves the
#! fee the paired sponsorship note carries (the value of its single fee asset) into the vault,
#! asserts the moved amount covers the required amount, and adds it to the running total. A feature
#! note whose fee is 0 requires no sponsorship and contributes nothing.
#!
#! TODO: Only a single sponsorship note per feature note is supported. Topping up an
#! under-sponsored feature note with additional sponsorship notes is tracked in
#! https://github.com/0xMiden/protocol/issues/3318.
#!
#! All collected fees must be charged in the same asset (the fee asset ID is recorded on the first
#! collection and every subsequent collection is asserted to match it), so the aggregated total is
#! unambiguous. Each sponsorship asset is credited to the account vault as it is collected; if no
#! fee was collected the vault is left untouched.
#!
#! Because a matched pair advances the walk by two, a FEE_SPONSORSHIP note is only ever seen as a
#! feature note's sponsor. Encountering one as the current note means it is unpaired (or pairs a
#! zero-fee feature note), which is rejected.
#!
#! Prices notes through the active account's fee policy and credits the active account's vault, so
#! it must be invoked while the fee manager account is the active account (e.g. from that account's
#! own auth procedure).
#!
#! Inputs:  []
#! Outputs: [collected_fee_amount]
#!
#! Where:
#! - collected_fee_amount is the total amount of collected fees.
#!
#! Panics if:
#! - the active fee policy is not set.
#! - a FEE_SPONSORSHIP note is encountered as a current note rather than as a feature note's
#!   sponsor.
#! - a feature note with a non-zero fee is not followed by a FEE_SPONSORSHIP note at the next
#!   input-note index.
#! - a paired FEE_SPONSORSHIP note does not sponsor the neighboring feature note.
#! - a paired FEE_SPONSORSHIP note does not carry exactly one asset.
#! - a paired FEE_SPONSORSHIP note's asset is not the fee asset the fee is charged in.
#! - a paired FEE_SPONSORSHIP note's fee amount is less than the feature note's required fee.
#! - the collected feature notes are not all priced in the same fee asset.
#! - adding a sponsorship asset to the vault overflows the fungible asset maximum.
#!
#! Invocation: exec
@locals(4)
pub proc collect_sponsored_fees
    # initialize the collected fee asset ID to the empty word so it doubles as a "no fee collected
    # yet" marker; it is recorded on the first collection and asserted constant thereafter
    padw loc_storew_le.FEE_ASSET_ID_LOC dropw
    # => []

    push.0 exec.tx::get_num_input_notes push.0
    # => [note_idx = 0, num_input_notes, total_fee_amount = 0]

    # loop if note_idx != num_input_notes
    dup.1 dup.1 neq
    # => [should_loop, note_idx, num_input_notes, total_fee_amount]

    while.true
        # check if the input note is a sponsorship note
        dup exec.input_note::get_script_root
        # => [FEATURE_NOTE_SCRIPT_ROOT, note_idx, num_input_notes, total_fee_amount]

        procref.fee_sponsorship::main exec.word::test_eq
        # => [is_sponsorship, SPONSORSHIP_ROOT, FEATURE_NOTE_SCRIPT_ROOT, note_idx, num_input_notes, total_fee_amount]

        # reject unpaired sponsorship notes
        assertz.err=ERR_FEE_MANAGER_UNEXPECTED_SPONSORSHIP_NOTE
        dropw
        # => [FEATURE_NOTE_SCRIPT_ROOT, note_idx, num_input_notes, total_fee_amount]

        # price the feature note through the active fee policy
        dup.4 movdn.4 exec.estimate_input_note_fee
        # => [FEE_ASSET_ID, required_fee_amount, note_idx, num_input_notes, total_fee_amount]

        dup.4 eq.0
        # => [is_required_fee_zero, FEE_ASSET_ID, required_fee_amount, note_idx, num_input_notes, total_fee_amount]

        if.true
            # a zero-fee feature note needs no sponsorship; drop its fee asset ID and advance past it
            dropw drop add.1
            # => [note_idx+1, num_input_notes, total_fee_amount]
        else
            # record the fee asset ID on the first collection, or assert it matches the previously
            # recorded one so all collected fees share the same asset
            padw loc_loadw_le.FEE_ASSET_ID_LOC exec.word::testz
            # => [is_unset, COLLECTED_FEE_ASSET_ID, FEE_ASSET_ID, required_fee_amount, note_idx, num_input_notes, total_fee_amount]

            if.true
                # first collection: drop the empty marker and cache this fee asset ID
                dropw loc_storew_le.FEE_ASSET_ID_LOC dropw
                # => [required_fee_amount, note_idx, num_input_notes, total_fee_amount]
            else
                # subsequent collection: all collected fees must share the same asset
                exec.word::eq assert.err=ERR_FEE_MANAGER_INCONSISTENT_FEE_ASSET
                # => [required_fee_amount, note_idx, num_input_notes, total_fee_amount]
            end
            # => [required_fee_amount, note_idx, num_input_notes, total_fee_amount]

            # find and verify the neighboring FEE_SPONSORSHIP note that sponsors this feature note
            dup.2 dup.2 exec.assert_neighbor_sponsors
            # => [neighbor_note_idx, required_fee_amount, note_idx, num_input_notes, total_fee_amount]

            padw loc_loadw_le.FEE_ASSET_ID_LOC movup.4
            # => [neighbor_note_idx, FEE_ASSET_ID, required_fee_amount, note_idx, num_input_notes, total_fee_amount]

            # move the sponsored fee into the vault and assert it covers the required amount
            exec.move_and_check_sponsored_fee
            # => [fee_amount, note_idx, num_input_notes, total_fee_amount]

            # add the collected amount to the running total and advance past both notes of the pair.
            # advancing by two is safe with neq as the loop condition because the neighbor index was
            # asserted to be in bounds by assert_neighbor_sponsors
            movup.3 add movdn.2 add.2
            # => [note_idx+2, num_input_notes, total_fee_amount]
        end
        # => [note_idx, num_input_notes, total_fee_amount]

        dup.1 dup.1 neq
        # => [should_loop, note_idx, num_input_notes, total_fee_amount]
    end
    # => [note_idx, num_input_notes, total_fee_amount]

    # drop the loop variables
    drop drop
    # => [total_fee_amount]
end

# HELPER PROCEDURES
# =================================================================================================

#! Prices the input note at the given index through the active fee policy.
#!
#! The note's script root is supplied by the caller (which already fetched it for the sponsorship
#! check) so it is not fetched a second time here. The remaining note parameters are read from the
#! note and forwarded to the policy.
#!
#! Inputs:  [NOTE_SCRIPT_ROOT, note_index]
#! Outputs: [FEE_ASSET_ID, required_fee_amount]
#!
#! Where:
#! - NOTE_SCRIPT_ROOT is the script root of the input note at note_index.
#! - note_index is the index of the input note whose fee is priced.
#! - FEE_ASSET_ID is the ID of the asset the fee is charged in.
#! - required_fee_amount is the fee amount charged for the note, or 0 if the policy prices it to 0.
#!
#! Invocation: exec
proc estimate_input_note_fee
    # gather the note's real commitments, keeping NOTE_SCRIPT_ROOT as the top parameter word
    dup.4 exec.input_note::get_storage_info movup.4 drop swapw
    # => [NOTE_SCRIPT_ROOT, STORAGE_COMMITMENT, note_index]

    dup.8 exec.input_note::get_initial_assets_info movup.4 drop movdnw.2
    # => [NOTE_SCRIPT_ROOT, STORAGE_COMMITMENT, ASSETS_COMMITMENT, note_index]

    dup.12 exec.input_note::get_attachments_commitment movdnw.3
    # => [NOTE_SCRIPT_ROOT, STORAGE_COMMITMENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, note_index]

    exec.fee_manager::estimate_note_fee_internal
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8), note_index]

    # drop the policy's call-boundary padding
    movupw.3 dropw movupw.2 dropw
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, note_index]

    # reduce the fee asset value to its amount, keeping the fee asset ID on top
    swapw exec.fungible_asset::value_into_amount movdn.4
    # => [FEE_ASSET_ID, required_fee_amount, note_index]

    # drop note_index, which the caller tracks itself
    movup.5 drop
    # => [FEE_ASSET_ID, required_fee_amount]
end

#! Asserts that the input note following the feature note at `note_index` is a FEE_SPONSORSHIP note
#! that sponsors it, returning the sponsor's input-note index.
#!
#! The sponsor must sit at the immediately following input-note index, be a FEE_SPONSORSHIP note,
#! and name the feature note at `note_index` as the note it sponsors.
#!
#! Inputs:  [note_index, num_input_notes]
#! Outputs: [neighbor_note_index]
#!
#! Where:
#! - note_index is the index of the feature note whose sponsor is looked up.
#! - num_input_notes is the total number of input notes, used for the bounds check.
#! - neighbor_note_index is the index of the verified FEE_SPONSORSHIP note, i.e. note_index + 1.
#!
#! Panics if:
#! - note_index + 1 is out of bounds (no note follows the feature note).
#! - the following note is not a FEE_SPONSORSHIP note.
#! - the following FEE_SPONSORSHIP note does not sponsor the feature note at note_index.
#!
#! Invocation: exec
@locals(8)
proc assert_neighbor_sponsors
    # the sponsor sits at the next input-note index
    dup add.1
    # => [neighbor_note_index, note_index, num_input_notes]

    # assert the neighbor index is in bounds
    dup dup.3 neq assert.err=ERR_FEE_MANAGER_FEATURE_NOTE_MISSING_SPONSORSHIP
    # => [neighbor_note_index, note_index, num_input_notes]

    # assert the neighbor is a FEE_SPONSORSHIP note
    dup exec.input_note::get_script_root procref.fee_sponsorship::main exec.word::eq
    assert.err=ERR_FEE_MANAGER_FEATURE_NOTE_MISSING_SPONSORSHIP
    # => [neighbor_note_index, note_index, num_input_notes]

    # stage the sponsorship note's storage to read the feature note it sponsors
    dup locaddr.SPONSORSHIP_STORAGE_LOC swap exec.note::input_note_get_storage
    # => [neighbor_note_index, note_index, num_input_notes]

    # the sponsored feature note ID is the first storage word
    padw loc_loadw_le.SPONSORSHIP_STORAGE_LOC
    # => [SPONSORED_FEATURE_NOTE_ID, neighbor_note_index, note_index, num_input_notes]

    # assert the neighboring sponsorship note pays for the feature note at note_index
    dup.5 exec.note_id::compute_input_note_id exec.word::eq
    assert.err=ERR_FEE_MANAGER_SPONSORSHIP_WRONG_FEATURE_NOTE
    # => [neighbor_note_index, note_index, num_input_notes]

    # drop note_index and num_input_notes, keeping the verified neighbor index
    swap drop swap drop
    # => [neighbor_note_index]
end

#! Moves the single asset of the FEE_SPONSORSHIP note at `neighbor_note_index` into the account
#! vault and returns the sponsored fee amount, asserting it is charged in the expected fee asset and
#! covers the required fee.
#!
#! Inputs:  [neighbor_note_index, REQUIRED_ASSET_ID, required_fee_amount]
#! Outputs: [fee_amount]
#!
#! Where:
#! - neighbor_note_index is the index of the FEE_SPONSORSHIP note whose asset is collected.
#! - REQUIRED_ASSET_ID is the ID of the asset the fee must be charged in.
#! - required_fee_amount is the fee the sponsored amount must cover.
#! - fee_amount is the sponsored amount moved into the vault.
#!
#! Panics if:
#! - the sponsorship note does not carry exactly one asset.
#! - the sponsorship note's asset is not the fee asset the fee is charged in.
#! - the sponsored amount is less than the required fee.
#! - adding the asset to the vault overflows the fungible asset maximum.
#!
#! Invocation: exec
proc move_and_check_sponsored_fee
    # move the sponsorship note's single asset into the vault
    exec.move_assets_to_vault
    # => [ASSET_ID, ASSET_VALUE, REQUIRED_ASSET_ID, required_fee_amount]

    # the moved asset must be the fee asset the fee is charged in
    dupw.2 exec.word::eq assert.err=ERR_FEE_MANAGER_SPONSORSHIP_WRONG_ASSET
    # => [ASSET_VALUE, FEE_ASSET_ID, required_fee_amount]

    swapw dropw
    # => [ASSET_VALUE, required_fee_amount]

    exec.fungible_asset::value_into_amount
    # => [fee_amount, required_fee_amount]

    # assert the sponsored amount covers the required fee
    dup movup.2
    # => [required_fee_amount, fee_amount, fee_amount]

    gte assert.err=ERR_FEE_MANAGER_SPONSORSHIP_FEE_TOO_LOW
    # => [fee_amount]
end

#! Removes all assets from the input note at `note_index`, asserts it carries exactly one asset, and
#! moves that asset into the native account's vault.
#!
#! Inputs:  [note_index]
#! Outputs: [ASSET_ID, ASSET_VALUE]
#!
#! Where:
#! - note_index is the index of the input note whose asset is moved.
#! - ASSET_ID is the ID of the moved asset.
#! - ASSET_VALUE is the value of the moved asset.
#!
#! Panics if:
#! - the note does not carry exactly SPONSORSHIP_NUM_ASSETS assets.
#! - adding the asset to the vault overflows the fungible asset maximum.
#!
#! Invocation: exec
@locals(8)
proc move_assets_to_vault
    # remove all remaining assets from the note into the local buffer
    locaddr.0 exec.input_note::remove_all_assets
    # => [num_assets]

    # the note must carry exactly one asset
    eq.SPONSORSHIP_NUM_ASSETS assert.err=ERR_FEE_MANAGER_SPONSORSHIP_WRONG_NUM_ASSETS
    # => []

    # load the single asset from the buffer
    locaddr.0 exec.asset::load
    # => [ASSET_ID, ASSET_VALUE]

    # add the asset to the native account vault, keeping a copy as the return value
    dupw.1 dupw.1 exec.native_account::add_asset dropw
    # => [ASSET_ID, ASSET_VALUE]
end
