# miden::standards::fees
#
# Fee collection and sponsorship-note creation for the fee manager account.
#
# `collect_sponsored_fees` walks the transaction's input notes and credits the fees prepaid by
# FEE_SPONSORSHIP notes to the account vault, pricing each feature note through the active fee policy
# owned by the `fee_manager` module.
#
# `create_network_note_sponsorships` walks the transaction's output notes and, for every note targeted at a
# network account, creates a paired FEE_SPONSORSHIP note funded with the fee that account charges.
#
# `estimate_network_note_sponsorships` walks the same notes and prices them the same way, but creates
# nothing, so a caller can charge for those notes before it pays for them.

use miden::core::word
use miden::core::crypto::hashes::poseidon2

use miden::protocol::input_note
use miden::protocol::native_account
use miden::protocol::output_note
use miden::protocol::tx
use miden::protocol::asset
use {WORD_NUM_ELEMENTS} from miden::protocol::constants
use {NOTE_TYPE_PUBLIC} from miden::protocol::note

use miden::standards::assets::fungible_asset
use miden::standards::attachments::network_account_target
use miden::standards::note
use miden::standards::note_tag
use miden::standards::notes::fee_sponsorship
use {NUM_ASSETS as SPONSORSHIP_NUM_ASSETS, FEATURE_NOTE_ID_ITEM_OFFSET} from miden::standards::notes::fee_sponsorship
use {NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME, NETWORK_ACCOUNT_TARGET_ATTACHMENT_NUM_WORDS}
    from miden::standards::attachments::network_account_target

use {Asset, AssetId, Bool} from miden::protocol::types

pub mod fee_manager
pub mod policies

# CONSTANTS
# =================================================================================================

# Number of entries in each of the fee tables that `collect_sponsored_fees` builds. Sized for the
# transaction kernel's MAX_INPUT_NOTES_PER_TX limit.
const FEE_TABLE_NUM_ENTRIES = 1024

# Local memory offsets of the two fee tables, both indexed by input note index. The collected table
# directly follows the required table, so a note's collected entry sits FEE_TABLE_NUM_ENTRIES above
# its required entry.
const REQUIRED_FEE_TABLE_LOC = 0
const COLLECTED_FEE_TABLE_LOC = REQUIRED_FEE_TABLE_LOC + FEE_TABLE_NUM_ENTRIES

# Local memory offset at which `collect_sponsored_fees` caches the expected fee asset ID.
const COLLECT_FEE_ASSET_ID_LOC = 2048

# Local memory offset at which `collect_sponsored_fees` caches the input note count.
const COLLECT_NUM_INPUT_NOTES_LOC = 2052

# Mask that rounds a u32 element count down to a multiple of the word size.
const WORD_ALIGNMENT_MASK = 0xFFFFFFFC

# Local memory offset at which `get_sponsored_feature_note_id` stages a FEE_SPONSORSHIP note's
# storage items to read its sponsored feature note ID. Sized for the note's storage items padded to
# the next multiple of 8 felts.
const SPONSORSHIP_STORAGE_LOC = 0
const SPONSORSHIP_FEATURE_NOTE_ID_LOC = SPONSORSHIP_STORAGE_LOC + FEATURE_NOTE_ID_ITEM_OFFSET

# Local memory offset at which `handle_network_note_sponsorship` caches the expected fee asset ID.
const EXPECTED_FEE_ASSET_ID_LOC = 0

# Local memory offsets used by `compute_sponsorship_fee` (in its own local frame).
const COMPUTE_ATTACHMENT_WORD_LOC = 0
const COMPUTE_NOTE_IDX_LOC = 4
const COMPUTE_TARGET_ID_SUFFIX_LOC = 5
const COMPUTE_TARGET_ID_PREFIX_LOC = 6

# Local memory offsets used by `create_sponsorship_note` (in its own local frame).
const CREATE_FEE_ASSET_ID_LOC = 0
const CREATE_FEE_ASSET_VALUE_LOC = 4
const CREATE_FEATURE_NOTE_ID_LOC = 8
const CREATE_TARGET_ID_PREFIX_LOC = 12
const CREATE_NOTE_IDX_LOC = 13

# ERRORS
# =================================================================================================

const ERR_FEE_MANAGER_NETWORK_TARGET_WRONG_NUM_WORDS = "network account target attachment must consist of exactly one word"

const ERR_FEE_MANAGER_SPONSORED_NOTE_NOT_FOUND = "the feature note sponsored by the FEE_SPONSORSHIP note is not an input note of this transaction"

const ERR_FEE_MANAGER_INPUT_NOTE_FEE_NOT_COVERED = "the FEE_SPONSORSHIP notes bound to an input note do not cover its required fee"

const ERR_FEE_MANAGER_SPONSORSHIP_WRONG_ASSET = "FEE_SPONSORSHIP note asset does not match the fee asset the account accepts"

const ERR_FEE_MANAGER_SPONSORSHIP_WRONG_NUM_ASSETS = "FEE_SPONSORSHIP note must carry exactly one asset"

const ERR_FEE_MANAGER_TARGET_FEE_ASSET_MISMATCH = "target account's fee asset does not match the expected fee asset"

const ERR_FEE_MANAGER_EXPECTED_FEE_ASSET_MISMATCH = "expected fee asset does not match the fee asset configured in the fee manager"

# PUBLIC INTERFACE
# =================================================================================================

#! Collects the fees prepaid by the FEE_SPONSORSHIP notes among the transaction's input notes and
#! credits the aggregated fee directly to the account's vault.
#!
#! Walks the input notes. Every note that is not a FEE_SPONSORSHIP note is a "feature note", priced
#! through the active fee policy. Every FEE_SPONSORSHIP note names the feature note it pays for,
#! and the fee it carries is moved into the vault and credited to its feature note. Once every
#! input note has been visited it asserts each note's collected fee covers its required fee.
#!
#! Sponsorships are bound to feature notes by note ID and so they can be placed at an arbitrary
#! input note index. Several of them may sponsor the same feature note. A feature note priced at 0
#! needs no sponsorship and a FEE_SPONSORSHIP note requires no fee of its own, so both trivially
#! satisfy the coverage check.
#!
#! All fees are collected in the single expected fee asset supplied by the caller, which typically
#! reads it from the fee manager's fee asset ID slot. Each sponsorship asset is credited to the
#! account vault as it is collected; if no fee was collected the vault is untouched.
#!
#! The sponsored feature note must be among the input notes. That rules out reclaiming a
#! FEE_SPONSORSHIP note in a network transaction to avoid creating reclaim transaction that are
#! more expensive than the value they reclaim.
#!
#! Prices notes through the active account's fee policy and credits the active account's vault, so
#! it must be invoked while the fee manager account is the active account (e.g. from that account's
#! own auth procedure).
#!
#! Inputs:  [FEE_ASSET_ID]
#! Outputs: [collected_fee_amount]
#!
#! Where:
#! - FEE_ASSET_ID is the ID of the asset fees are collected in; it must be the fee asset
#!   configured in the fee manager (asserted below, so fees cannot be priced in one asset and
#!   collected in another).
#! - collected_fee_amount is the total amount of collected fees.
#!
#! Panics if:
#! - FEE_ASSET_ID does not match the fee manager's configured fee asset.
#! - the active fee policy is not set.
#! - the active fee policy returns a fee asset other than the fee manager's configured fee asset.
#! - a FEE_SPONSORSHIP note sponsors a note that is not an input note of this transaction.
#! - a FEE_SPONSORSHIP note does not carry exactly one asset.
#! - a FEE_SPONSORSHIP note's asset is not the expected fee asset.
#! - an input note's required fee is not covered by the FEE_SPONSORSHIP notes bound to it.
#! - adding a sponsorship asset to the vault overflows the fungible asset maximum.
#!
#! Locals:
#! - 0..1024: [required_fee_0, ..., required_fee_idx], where `idx` is an input note index.
#! - 1024..2048: [collected_fee_0, ..., collected_fee_idx]
#! - 2048..2052: FEE_ASSET_ID
#! - 2052: num_input_notes
#!
#! Only the collected fees have to be zeroized: each note's required fee is written exactly once
#! below, by the fee policy for a feature note and as a zero for a FEE_SPONSORSHIP note.
#!
#! Invocation: exec
@locals(2053)
pub proc collect_sponsored_fees(fee_asset_id: AssetId) -> felt
    # the expected fee asset must be the one the fee manager prices fees in, otherwise fees
    # could be priced in one asset and collected in another
    dupw exec.fee_manager::read_fee_asset_id exec.word::eq
    assert.err=ERR_FEE_MANAGER_EXPECTED_FEE_ASSET_MISMATCH
    # => [FEE_ASSET_ID]

    # cache the expected fee asset ID for the per-note sponsorship asset checks
    loc_storew_le.COLLECT_FEE_ASSET_ID_LOC dropw
    # => []

    push.0 exec.tx::get_num_input_notes
    # => [num_input_notes, total_fee_amount = 0]

    dup loc_store.COLLECT_NUM_INPUT_NOTES_LOC
    # => [num_input_notes, total_fee_amount]

    # the fee tables are procedure-local memory, which must be assumed to contain garbage
    # zeroize the collected entries this invocation uses (based on num_input_notes), so that
    # the sum of collected fees starts at 0
    # the required fee table is overwritten below, so it is not zeroized explicitly
    locaddr.COLLECTED_FEE_TABLE_LOC dup.1 exec.zeroize_elements
    # => [num_notes_left, total_fee_amount]

    # walk the notes from the last one down to the first so the loop condition is a zero check
    dup neq.0
    # => [should_loop, num_notes_left, total_fee_amount]

    while.true
        sub.1
        # => [note_idx, total_fee_amount]

        dup exec.is_sponsorship_note
        # => [is_sponsorship, note_idx, total_fee_amount]

        if.true
            # a FEE_SPONSORSHIP note owes no fee of its own, so its required_fee is zero
            push.0 locaddr.REQUIRED_FEE_TABLE_LOC dup.2 add mem_store
            # => [note_idx, total_fee_amount]

            dup exec.get_sponsored_feature_note_id exec.input_note::find_note
            # => [is_found, feature_note_idx, note_idx, total_fee_amount]

            # a sponsorship note that is reclaimed does not need its feature note present and
            # asserting is_found means we do not allow reclaiming sponsorship notes in network
            # transaction, as this could be an attack vector: the cost of the reclaiming tx may be
            # greater than the reclaim value
            assert.err=ERR_FEE_MANAGER_SPONSORED_NOTE_NOT_FOUND
            # => [feature_note_idx, note_idx, total_fee_amount]

            padw loc_loadw_le.COLLECT_FEE_ASSET_ID_LOC dup.5
            # => [note_idx, FEE_ASSET_ID, feature_note_idx, note_idx, total_fee_amount]

            # move the fee this sponsorship carries into the vault
            exec.move_sponsored_fee_to_vault
            # => [fee_amount, feature_note_idx, note_idx, total_fee_amount]

            # compute the pointer at which the feature note's collected fees are stored
            swap locaddr.COLLECTED_FEE_TABLE_LOC add
            # => [collected_ptr, fee_amount, note_idx, total_fee_amount]

            # load the collected amount
            dup mem_load
            # => [collected_amount, collected_ptr, fee_amount, note_idx, total_fee_amount]

            # add and store back the updated collected amount
            dup.2 add swap mem_store
            # => [fee_amount, note_idx, total_fee_amount]

            # add the fee_amount to the running total
            movup.2 add swap
            # => [note_idx, total_fee_amount]
        else
            # price the feature note through the active fee policy and record what it owes
            dup exec.estimate_input_note_fee
            # => [required_fee_amount, note_idx, total_fee_amount]

            dup.1 locaddr.REQUIRED_FEE_TABLE_LOC add mem_store
            # => [note_idx, total_fee_amount]
        end
        # => [num_notes_left, total_fee_amount]

        dup neq.0
        # => [should_loop, num_notes_left, total_fee_amount]
    end
    # => [num_notes_left, total_fee_amount]

    drop
    # => [total_fee_amount]

    locaddr.REQUIRED_FEE_TABLE_LOC loc_load.COLLECT_NUM_INPUT_NOTES_LOC exec.assert_input_note_fees_covered
    # => [total_fee_amount]
end

#! Creates a FEE_SPONSORSHIP note for every network output note in this transaction.
#!
#! Walks the transaction's output notes as they stood when this procedure was called. For each note
#! that carries a `NetworkAccountTarget` attachment (i.e. is targeted at a network account), it reads
#! the target account ID, asks that account's fee policy what the note costs via an FPI call to its
#! `estimate_note_fee` procedure, and, if the fee is non-zero, creates a FEE_SPONSORSHIP output note
#! bound to the network note (as its companion) carrying exactly the estimated fee asset. The fee
#! asset is removed from the native account's vault to fund the note. Until fee asset conversion
#! exists, the target's fee must use the expected fee asset supplied by the caller, which typically
#! reads it from this account's fee manager.
#!
#! The created sponsorship note is public, tagged for the target network account, names the native
#! account as its reclaimer, and has reclaim disabled. Its serial number is derived from the
#! companion note ID, making it unique per network note. Exactly one sponsorship note is created per
#! network output note; a pre-existing sponsorship for the same note is not detected.
#!
#! Must be invoked while the native (fee-paying) account is the active account, since it removes the
#! fee asset from that account's vault and creates notes from it.
#!
#! Inputs:  [FEE_ASSET_ID]
#! Outputs: [total_sponsored_fee_amount]
#!
#! Where:
#! - FEE_ASSET_ID is the ID of the asset sponsorship notes are funded with, typically read from
#!   the fee manager's fee asset ID slot.
#! - total_sponsored_fee_amount is the total amount moved into the created sponsorship notes.
#!
#! Panics if:
#! - a network output note's target ID attachment does not consist of exactly one word.
#! - the target account's fee policy requires a network output note's recipient preimage and it
#!   is unavailable or does not hash to the recipient.
#! - the target account's active fee policy is not set.
#! - a target account charges a non-zero fee in an asset other than the expected fee asset.
#! - the native account's vault does not hold enough of the fee asset.
#!
#! Invocation: exec
pub proc create_network_note_sponsorships(fee_asset_id: AssetId) -> felt
    push.0 movdn.4
    # => [FEE_ASSET_ID, total_sponsored_fee_amount = 0]

    # get the output note count before any sponsorship notes were created, since creating them
    # increments the count
    exec.tx::get_num_output_notes
    # => [num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount]

    push.0
    # => [note_idx = 0, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount]

    dup.1 dup.1 neq
    # => [should_loop, note_idx, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount]

    while.true
        # only network output notes are sponsored
        dup exec.is_network_note
        # => [is_network_note, attachment_idx, note_idx, num_output_notes, FEE_ASSET_ID,
        #     total_sponsored_fee_amount]

        if.true
            dup.1
            # => [note_idx, attachment_idx, note_idx, num_output_notes, FEE_ASSET_ID,
            #     total_sponsored_fee_amount]

            # pass a copy of the expected fee asset ID along with the note parameters, and ask for
            # the sponsorship note to be created
            dupw.1 movup.5 movup.5 push.1 movdn.6
            # => [note_idx, attachment_idx, FEE_ASSET_ID, is_create = 1, note_idx, num_output_notes,
            #     FEE_ASSET_ID, total_sponsored_fee_amount]

            exec.handle_network_note_sponsorship
            # => [sponsored_fee_amount, note_idx, num_output_notes, FEE_ASSET_ID,
            #     total_sponsored_fee_amount]

            movup.7 add movdn.6
            # => [note_idx, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount]
        else
            # do not sponsor non-network output notes
            drop
            # => [note_idx, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount]
        end

        add.1
        # => [note_idx+1, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount]

        dup.1 dup.1 neq
        # => [should_loop, note_idx, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount]
    end
    # => [note_idx, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount]

    drop drop dropw
    # => [total_sponsored_fee_amount]
end

#! Estimates the FEE_SPONSORSHIP notes that this transaction's network output notes require.
#!
#! Walks the transaction's output notes exactly as `create_network_note_sponsorships` does and
#! prices each network note through its target account's fee policy, but creates no note and moves
#! nothing out of the vault. A note the target prices to zero needs no sponsorship note and so is
#! counted in neither return value.
#!
#! Inputs:  [FEE_ASSET_ID]
#! Outputs: [total_sponsored_fee_amount, num_sponsorship_notes]
#!
#! Where:
#! - FEE_ASSET_ID is the ID of the asset the sponsorship notes are funded with, typically read
#!   from the fee manager's fee asset ID slot.
#! - total_sponsored_fee_amount is the total amount those notes will carry.
#! - num_sponsorship_notes is the number of notes `create_network_note_sponsorships` will create.
#!
#! Panics if:
#! - a network output note's target ID attachment does not consist of exactly one word.
#! - the target account's fee policy requires a network output note's recipient preimage and it
#!   is unavailable or does not hash to the recipient.
#! - the target account's active fee policy is not set.
#! - a target account charges a non-zero fee in an asset other than the expected fee asset.
#!
#! Invocation: exec
pub proc estimate_network_note_sponsorships(fee_asset_id: AssetId) -> (felt, felt)
    push.0 movdn.4
    # => [FEE_ASSET_ID, num_sponsorship_notes = 0]

    push.0 movdn.4
    # => [FEE_ASSET_ID, total_sponsored_fee_amount = 0, num_sponsorship_notes]

    exec.tx::get_num_output_notes
    # => [num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount, num_sponsorship_notes]

    push.0
    # => [note_idx = 0, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount,
    #     num_sponsorship_notes]

    dup.1 dup.1 neq
    # => [should_loop, note_idx, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount,
    #     num_sponsorship_notes]

    while.true
        # only network output notes are sponsored
        dup exec.is_network_note
        # => [is_network_note, attachment_idx, note_idx, num_output_notes, FEE_ASSET_ID,
        #     total_sponsored_fee_amount, num_sponsorship_notes]

        if.true
            dup.1
            # => [note_idx, attachment_idx, note_idx, num_output_notes, FEE_ASSET_ID,
            #     total_sponsored_fee_amount, num_sponsorship_notes]

            # pass a copy of the expected fee asset ID along with the note parameters, and ask for
            # the note to only be priced
            dupw.1 movup.5 movup.5 push.0 movdn.6
            # => [note_idx, attachment_idx, FEE_ASSET_ID, is_create = 0, note_idx, num_output_notes,
            #     FEE_ASSET_ID, total_sponsored_fee_amount, num_sponsorship_notes]

            exec.handle_network_note_sponsorship
            # => [sponsored_fee_amount, note_idx, num_output_notes, FEE_ASSET_ID,
            #     total_sponsored_fee_amount, num_sponsorship_notes]

            # a note priced to zero is sponsored by no note
            dup neq.0 movup.9 add movdn.8
            # => [sponsored_fee_amount, note_idx, num_output_notes, FEE_ASSET_ID,
            #     total_sponsored_fee_amount, num_sponsorship_notes]

            movup.7 add movdn.6
            # => [note_idx, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount,
            #     num_sponsorship_notes]
        else
            # do not sponsor non-network output notes
            drop
            # => [note_idx, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount,
            #     num_sponsorship_notes]
        end

        add.1
        # => [note_idx+1, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount,
        #     num_sponsorship_notes]

        dup.1 dup.1 neq
        # => [should_loop, note_idx, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount,
        #     num_sponsorship_notes]
    end
    # => [note_idx, num_output_notes, FEE_ASSET_ID, total_sponsored_fee_amount,
    #     num_sponsorship_notes]

    drop drop dropw
    # => [total_sponsored_fee_amount, num_sponsorship_notes]
end

# HELPER PROCEDURES
# =================================================================================================

#! Writes zeros over the given number of elements starting at the given pointer.
#!
#! The element count is rounded up to the next multiple of the word size so the range can be cleared
#! a word at a time; up to three elements past the requested count may therefore be zeroed, which
#! callers must account for when sizing the region. The pointer must be word-aligned.
#!
#! Inputs:  [num_elements, start_ptr]
#! Outputs: []
#!
#! Where:
#! - start_ptr is the word-aligned address of the first element to clear.
#! - num_elements is the number of elements to clear.
#!
#! Invocation: exec
proc zeroize_elements
    # the number of elements is bounded by the kernel's input note limit, so it is a valid u32
    # rounds up to the next multiple of WORD_NUM_ELEMENTS by adding 3 and masking out the two least
    # significant bits
    add.3 u32and.WORD_ALIGNMENT_MASK
    # => [rounded_num_elements, start_ptr]

    # compute end_ptr
    dup.1 add swap
    # => [start_ptr, end_ptr]

    padw movup.4
    # => [start_ptr, EMPTY_WORD, end_ptr]

    # loop if start_ptr != end_ptr
    dup.5 dup.1 neq
    # => [should_loop, start_ptr, EMPTY_WORD, end_ptr]

    while.true
        # compute the pointer for the next iteration by moving one word ahead
        dup add.WORD_NUM_ELEMENTS movdn.5
        # => [current_ptr, EMPTY_WORD, next_ptr, end_ptr]

        # zeroize the word
        mem_storew_le movup.4
        # => [next_ptr, EMPTY_WORD, end_ptr]

        # continue looping if next_ptr != end_ptr
        dup.5 dup.1 neq
        # => [should_loop, next_ptr, EMPTY_WORD, end_ptr]
    end
    # => [next_ptr, EMPTY_WORD, end_ptr]

    drop dropw drop
    # => []
end

#! Returns whether the input note at the given index is a FEE_SPONSORSHIP note.
#!
#! Inputs:  [note_idx]
#! Outputs: [is_sponsorship]
#!
#! Where:
#! - note_idx is the index of the input note to inspect.
#! - is_sponsorship is 1 if the note's script is the FEE_SPONSORSHIP script, 0 otherwise.
#!
#! Invocation: exec
proc is_sponsorship_note
    exec.input_note::get_script_root
    procref.fee_sponsorship::main
    # => [SPONSORSHIP_NOTE_SCRIPT_ROOT, NOTE_SCRIPT_ROOT]

    exec.word::eq
    # => [is_sponsorship]
end

#! Returns the ID of the feature note that the FEE_SPONSORSHIP note at the given index pays for.
#!
#! Inputs:  [note_index]
#! Outputs: [FEATURE_NOTE_ID]
#!
#! Where:
#! - note_index is the index of the FEE_SPONSORSHIP note whose sponsored note is read.
#! - FEATURE_NOTE_ID is the ID of the note it sponsors.
#!
#! Invocation: exec
@locals(8)
proc get_sponsored_feature_note_id
    # write the sponsorship note's storage items to memory
    locaddr.SPONSORSHIP_STORAGE_LOC swap exec.note::input_note_get_storage
    # => []

    # load the sponsored feature note ID
    padw loc_loadw_le.SPONSORSHIP_FEATURE_NOTE_ID_LOC
    # => [FEATURE_NOTE_ID]
end

#! Asserts that every input note's required fee is covered by the fees collected for it.
#!
#! Notes that neither require nor were sponsored a fee pass trivially, which covers zero-fee feature
#! notes as well as the FEE_SPONSORSHIP notes themselves.
#!
#! Inputs:  [num_input_notes, required_fee_table_ptr]
#! Outputs: []
#!
#! Where:
#! - num_input_notes is the number of entries in each table.
#! - required_fee_table_ptr is the address of the required-fee table built by
#!   `collect_sponsored_fees`; the matching collected fee sits FEE_TABLE_NUM_ENTRIES above it.
#!
#! Panics if:
#! - an input note's required fee exceeds the fee collected for it.
#!
#! Invocation: exec
proc assert_input_note_fees_covered
    # walking entry pointers rather than note indices keeps the loop free of address arithmetic
    dup.1 add swap
    # => [entry_ptr, end_ptr]

    dup.1 dup.1 neq
    # => [should_loop, entry_ptr, end_ptr]

    while.true
        dup add.FEE_TABLE_NUM_ENTRIES mem_load dup.1 mem_load
        # => [required_fee_amount, collected_fee_amount, entry_ptr, end_ptr]

        # assert collected_fee_amount >= required_fee_amount
        gte assert.err=ERR_FEE_MANAGER_INPUT_NOTE_FEE_NOT_COVERED
        # => [entry_ptr, end_ptr]

        add.1 dup.1 dup.1 neq
        # => [should_loop, entry_ptr, end_ptr]
    end
    # => [entry_ptr, end_ptr]

    drop drop
    # => []
end

#! Prices the input note at the given index through the active fee policy.
#!
#! The note's parameters are read from the note and forwarded to the policy along with a timeframe
#! and priority of 0.
#!
#! Inputs:  [note_index]
#! Outputs: [required_fee_amount]
#!
#! Where:
#! - note_index is the index of the input note whose fee is priced.
#! - required_fee_amount is the fee amount charged for the note, or 0 if the policy prices it to 0.
#!
#! Invocation: exec
proc estimate_input_note_fee
    dup exec.input_note::get_recipient
    # => [RECIPIENT, note_index]

    # pass a timeframe and priority of 0, along with the fee policy padding
    padw swapw
    # => [RECIPIENT, timeframe = 0, priority = 0, pad(2), note_index]

    dup.8 exec.input_note::get_attachments_commitment swapw
    # => [RECIPIENT, ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2), note_index]

    movup.12 exec.input_note::get_initial_assets_info movup.4 drop swapw
    # => [RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]

    exec.fee_manager::estimate_note_fee_internal
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]

    # drop the policy's call-boundary padding
    movupw.3 dropw movupw.2 dropw
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE]

    # the manager asserts the estimate is denominated in its configured fee asset, so only the
    # fee amount is needed here
    dropw exec.fungible_asset::value_into_amount
    # => [required_fee_amount]
end

#! Moves the single asset of the FEE_SPONSORSHIP note at `note_index` into the account vault and
#! returns the sponsored fee amount, asserting it is charged in the expected fee asset.
#!
#! Whether the amount suffices is not decided here: several sponsorship notes may be bound to the
#! same feature note, so coverage is only checked once every input note has been visited.
#!
#! Inputs:  [note_index, FEE_ASSET_ID]
#! Outputs: [fee_amount]
#!
#! Where:
#! - note_index is the index of the FEE_SPONSORSHIP note whose asset is collected.
#! - FEE_ASSET_ID is the ID of the asset the fee must be charged in.
#! - fee_amount is the sponsored amount moved into the vault.
#!
#! Panics if:
#! - the sponsorship note does not carry exactly one asset.
#! - the sponsorship note's asset is not the expected fee asset.
#! - adding the asset to the vault overflows the fungible asset maximum.
#!
#! Invocation: exec
proc move_sponsored_fee_to_vault
    # move the sponsorship note's single asset into the vault
    exec.move_asset_to_vault
    # => [ASSET_ID, ASSET_VALUE, FEE_ASSET_ID]

    # the moved asset must be the fee asset the fee is charged in
    movupw.2 exec.word::eq assert.err=ERR_FEE_MANAGER_SPONSORSHIP_WRONG_ASSET
    # => [ASSET_VALUE]

    exec.fungible_asset::value_into_amount
    # => [fee_amount]
end

#! Removes all assets from the input note at `note_index`, asserts it carries exactly one asset, and
#! moves that asset into the native account's vault.
#!
#! Inputs:  [note_index]
#! Outputs: [ASSET_ID, ASSET_VALUE]
#!
#! Where:
#! - note_index is the index of the input note whose asset is moved.
#! - ASSET_ID is the ID of the moved asset.
#! - ASSET_VALUE is the value of the moved asset.
#!
#! Panics if:
#! - the note does not carry exactly SPONSORSHIP_NUM_ASSETS assets.
#! - adding the asset to the vault overflows the fungible asset maximum.
#!
#! Invocation: exec
@locals(8)
proc move_asset_to_vault
    # remove all remaining assets from the note into the local buffer
    locaddr.0 exec.input_note::remove_all_assets
    # => [num_assets]

    # the note must carry exactly one asset
    eq.SPONSORSHIP_NUM_ASSETS assert.err=ERR_FEE_MANAGER_SPONSORSHIP_WRONG_NUM_ASSETS
    # => []

    # load the single asset from the buffer
    locaddr.0 exec.asset::load
    # => [ASSET_ID, ASSET_VALUE]

    # add the asset to the native account vault, keeping a copy as the return value
    dupw.1 dupw.1 exec.native_account::add_asset dropw
    # => [ASSET_ID, ASSET_VALUE]
end

#! Returns whether the output note at the given index is a network note, along with the index of its
#! network account target attachment.
#!
#! Inputs:  [note_idx]
#! Outputs: [is_network_note, attachment_idx]
#!
#! Where:
#! - note_idx is the index of the output note to inspect.
#! - is_network_note is 1 if the note carries a `NetworkAccountTarget` attachment, 0 otherwise.
#! - attachment_idx is the index of that attachment; only meaningful if is_network_note is 1.
#!
#! Invocation: exec
proc is_network_note(note_idx: u16) -> (Bool, u8)
    push.NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME
    # => [attachment_scheme, note_idx]

    exec.output_note::find_attachment
    # => [is_found, attachment_idx]
end

#! Prices the network output note at the given index and, when asked to, creates its
#! FEE_SPONSORSHIP note.
#!
#! See [`create_network_note_sponsorships`] for the full behaviour; this procedure handles a single
#! network note. A network note the target account prices to zero needs no sponsorship note, so
#! none is created for it. When is_create is 0 the note is only priced: the vault and the output
#! notes are left untouched.
#!
#! Inputs:  [note_idx, attachment_idx, EXPECTED_FEE_ASSET_ID, is_create]
#! Outputs: [sponsored_fee_amount]
#!
#! Where:
#! - note_idx is the index of the network output note to sponsor.
#! - attachment_idx is the index of the note's network account target attachment.
#! - EXPECTED_FEE_ASSET_ID is the ID of the asset the sponsorship note must be funded with.
#! - is_create is 1 to create the sponsorship note, 0 to only price it.
#! - sponsored_fee_amount is the amount the sponsorship note carries, or zero if the target prices
#!   the note to zero and so it needs none.
#!
#! Panics if:
#! - the note's target ID attachment does not consist of exactly one word.
#! - the target account's fee policy requires the note's recipient preimage and it is unavailable
#!   or does not hash to the recipient.
#! - the target account's active fee policy is not set.
#! - the target account charges a non-zero fee in an asset other than the expected fee asset.
#! - is_create is 1 and the native account's vault does not hold enough of the fee asset.
#!
#! Invocation: exec
@locals(4)
proc handle_network_note_sponsorship(
    note_idx: u16,
    attachment_idx: u8,
    expected_fee_asset_id: AssetId,
    is_create: Bool
) -> felt
    # cache the expected fee asset ID for the target fee asset check
    movdn.5 movdn.5 loc_storew_le.EXPECTED_FEE_ASSET_ID_LOC dropw
    # => [note_idx, attachment_idx, is_create]

    dup movdn.3
    # => [note_idx, attachment_idx, is_create, note_idx]

    exec.compute_sponsorship_fee
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, target_id_prefix, is_create, note_idx]

    exec.fungible_asset::to_amount
    # => [fee_amount, FEE_ASSET_ID, FEE_ASSET_VALUE, target_id_prefix, is_create, note_idx]

    movdn.11 dup.11 eq.0
    # => [is_zero_fee, FEE_ASSET_ID, FEE_ASSET_VALUE, target_id_prefix, is_create, note_idx,
    #     fee_amount]

    if.true
        # if the price of the note is zero, it needs no sponsorship note
        dropw dropw drop drop drop
        # => [fee_amount]
    else
        # reject a target whose fee asset differs from the expected fee asset
        dupw padw loc_loadw_le.EXPECTED_FEE_ASSET_ID_LOC exec.word::eq
        assert.err=ERR_FEE_MANAGER_TARGET_FEE_ASSET_MISMATCH
        # => [FEE_ASSET_ID, FEE_ASSET_VALUE, target_id_prefix, is_create, note_idx, fee_amount]

        movup.9
        # => [is_create, FEE_ASSET_ID, FEE_ASSET_VALUE, target_id_prefix, note_idx, fee_amount]

        if.true
            exec.create_sponsorship_note
            # => [fee_amount]
        else
            # only pricing the note: discard the inputs of the note creation
            dropw dropw drop drop
            # => [fee_amount]
        end
    end
end

#! Computes the fee the target network account charges for the output note at the given index.
#!
#! Reads the note's target account ID from its network account target attachment, gathers the
#! note's recipient and commitments, and asks the target account's active fee policy for the fee
#! via an FPI call to its `estimate_note_fee` procedure, passing a timeframe and priority of 0.
#! The target account prefix is returned alongside the fee asset so the caller can tag the
#! sponsorship note without re-reading the attachment.
#!
#! Inputs:  [note_idx, attachment_idx]
#! Outputs: [FEE_ASSET_ID, FEE_ASSET_VALUE, target_id_prefix]
#!
#! Where:
#! - note_idx is the index of the network output note whose fee is computed.
#! - attachment_idx is the index of the note's network account target attachment.
#! - FEE_ASSET_ID is the ID of the asset the fee is charged in.
#! - FEE_ASSET_VALUE is the fee as an asset value word [fee_amount, 0, 0, 0].
#! - target_id_prefix is the prefix felt of the target account ID.
#!
#! Panics if:
#! - the note's target ID attachment does not consist of exactly one word.
#! - the target account's fee policy requires the note's recipient preimage and it is unavailable
#!   or does not hash to the recipient.
#! - the target account's active fee policy is not set.
#!
#! Invocation: exec
@locals(7)
proc compute_sponsorship_fee(note_idx: u16, attachment_idx: u8) -> (Asset, felt)
    # the note index is needed repeatedly below, so cache it
    dup loc_store.COMPUTE_NOTE_IDX_LOC
    # => [note_idx, attachment_idx]

    # copy the network account target attachment into local memory, then read the target ID
    swap locaddr.COMPUTE_ATTACHMENT_WORD_LOC
    # => [dest_ptr, attachment_idx, note_idx]

    exec.output_note::write_attachment_to_memory
    # => [num_words]

    eq.NETWORK_ACCOUNT_TARGET_ATTACHMENT_NUM_WORDS
    assert.err=ERR_FEE_MANAGER_NETWORK_TARGET_WRONG_NUM_WORDS
    # => []

    padw loc_loadw_le.COMPUTE_ATTACHMENT_WORD_LOC
    # => [NETWORK_ACCOUNT_TARGET_ATTACHMENT]

    exec.network_account_target::into_target_id
    # => [target_id_suffix, target_id_prefix]

    loc_store.COMPUTE_TARGET_ID_SUFFIX_LOC
    loc_store.COMPUTE_TARGET_ID_PREFIX_LOC
    # => []

    # pass a timeframe and priority of 0, along with the FPI input padding
    padw
    # => [timeframe = 0, priority = 0, pad(2)]

    loc_load.COMPUTE_NOTE_IDX_LOC exec.output_note::get_attachments_commitment
    # => [ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]

    loc_load.COMPUTE_NOTE_IDX_LOC exec.output_note::get_assets_info movup.4 drop
    # => [ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]

    loc_load.COMPUTE_NOTE_IDX_LOC exec.output_note::get_recipient
    # => [RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]

    procref.fee_manager::estimate_note_fee
    # => [ESTIMATE_NOTE_FEE_ROOT, RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe,
    #     priority, pad(2)]

    loc_load.COMPUTE_TARGET_ID_PREFIX_LOC loc_load.COMPUTE_TARGET_ID_SUFFIX_LOC
    # => [target_id_suffix, target_id_prefix, ESTIMATE_NOTE_FEE_ROOT, RECIPIENT, ASSETS_COMMITMENT,
    #     ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]

    exec.tx::execute_foreign_procedure
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]

    swapdw dropw dropw
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE]

    # return the target prefix below the fee asset so the caller can build the note tag
    loc_load.COMPUTE_TARGET_ID_PREFIX_LOC movdn.8
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, target_id_prefix]
end

#! Creates and funds the FEE_SPONSORSHIP note for a network output note priced to a non-zero fee.
#!
#! Removes the fee asset from the native account's vault, derives a serial number unique to the
#! sponsored note, builds the sponsorship note tagged for the target account with the native account
#! as reclaimer (reclaim disabled), creates it, and funds it with the fee asset.
#!
#! Inputs:  [FEE_ASSET_ID, FEE_ASSET_VALUE, target_id_prefix, note_idx]
#! Outputs: []
#!
#! Where:
#! - FEE_ASSET_ID is the ID of the asset the fee is charged in.
#! - FEE_ASSET_VALUE is the fee as an asset value word [fee_amount, 0, 0, 0].
#! - target_id_prefix is the prefix felt of the target account ID, used to tag the note.
#! - note_idx is the index of the sponsored network output note, used to derive the serial number.
#!
#! Panics if:
#! - the native account's vault does not hold enough of the fee asset.
#!
#! Invocation: exec
@locals(14)
proc create_sponsorship_note(fee_asset: Asset, target_id_prefix: felt, note_idx: u16)
    # cache the fee asset; it funds the sponsorship note once created
    loc_storew_le.CREATE_FEE_ASSET_ID_LOC swapw
    # => [FEE_ASSET_VALUE, FEE_ASSET_ID, target_id_prefix, note_idx]

    loc_storew_le.CREATE_FEE_ASSET_VALUE_LOC swapw
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, target_id_prefix, note_idx]

    # cache the target prefix (for the note tag) and note index (for the serial number)
    movup.8 loc_store.CREATE_TARGET_ID_PREFIX_LOC
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, note_idx]

    movup.8 loc_store.CREATE_NOTE_IDX_LOC
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE]

    # remove the fee asset from the native account's vault before placing it into the note
    exec.native_account::remove_asset
    dropw
    # => []

    # derive a unique serial for the sponsorship note from the feature note ID
    loc_load.CREATE_NOTE_IDX_LOC exec.output_note::compute_note_id
    # => [FEATURE_NOTE_ID]

    loc_storew_le.CREATE_FEATURE_NOTE_ID_LOC
    # => [FEATURE_NOTE_ID]

    exec.poseidon2::hash
    # => [SERIAL_NUM]

    push.NOTE_TYPE_PUBLIC
    # => [note_type, SERIAL_NUM]

    loc_load.CREATE_TARGET_ID_PREFIX_LOC exec.note_tag::create_account_target
    # => [tag, note_type, SERIAL_NUM]

    # reclaim disabled; the native account is the reclaimer
    push.0
    # => [reclaim_block_height, tag, note_type, SERIAL_NUM]

    exec.native_account::get_id
    # => [reclaimer_id_suffix, reclaimer_id_prefix, reclaim_block_height, tag, note_type, SERIAL_NUM]

    padw loc_loadw_le.CREATE_FEATURE_NOTE_ID_LOC
    # => [FEATURE_NOTE_ID, reclaimer_id_suffix, reclaimer_id_prefix, reclaim_block_height, tag,
    #     note_type, SERIAL_NUM]

    exec.fee_sponsorship::prepare_note
    # => [tag, note_type, RECIPIENT]

    exec.output_note::create
    # => [sponsorship_note_idx]

    # fund the freshly created sponsorship note with the fee asset
    padw loc_loadw_le.CREATE_FEE_ASSET_VALUE_LOC
    padw loc_loadw_le.CREATE_FEE_ASSET_ID_LOC
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, sponsorship_note_idx]

    exec.output_note::add_asset
    # => []
end
