# miden::standards::fees::policies::zero_fee
#
# Zero fee policy: estimates every note at zero fee. Storage-free; suitable for accounts that do
# not charge fees.

# POLICY PROCEDURES
# =================================================================================================

#! Fee policy estimating every note at zero fee.
#!
#! Inputs:  [NOTE_SCRIPT_ROOT, STORAGE_COMMITMENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT]
#! Outputs: [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
#!
#! Where:
#! - FEE_ASSET_ID and FEE_ASSET_VALUE are both the zero word: no fee is charged in any asset.
#!
#! Invocation: dynexec
# TODO(call invocation)
@account_procedure
pub proc compute_note_fee
    # dropping the note parameters below the minimum stack depth pulls in zeros, which form the
    # all-zero fee asset output
    dropw dropw dropw dropw
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
end
