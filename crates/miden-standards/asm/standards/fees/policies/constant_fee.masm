# miden::standards::fees::policies::constant_fee
#
# Constant fee policy: derives the fee from a fixed fee schedule. Designed to be registered on a
# `FeeManager` (see `miden::standards::fees::fee_manager`), which dispatches fee estimation to
# `compute_note_fee` via `dyncall`.
#
# Storage layout:
# - `fee_asset_id` word: the ID of the asset the fee is charged in.
# - `fee_schedule` map: LOOKUP_KEY => [fee_amount, 0, 0, 1]. The last element is a set-marker
#   distinguishing scheduled entries (including explicit 0 fees) from the zero word returned for
#   unset keys; lookup keys without a schedule entry abort fee computation.
# - `lookup_key_proc_root` word: the root of the procedure that builds the fee schedule lookup
#   key from the note parameters. The built-in `build_note_fee_lookup_key` keys on the note's
#   script root, recovered from RECIPIENT via the advice provider.

use miden::core::word

use miden::protocol::active_account

use miden::standards::note

use {Asset, NoteRecipient, StorageMapKey} from miden::protocol::types

# CONSTANTS
# =================================================================================================

# Slot holding the ID of the asset the fee is charged in.
const FEE_ASSET_ID_SLOT = word("miden::standards::fees::policies::constant_fee::fee_asset_id")

# Slot holding the fee schedule.
# Map entries: LOOKUP_KEY => [fee_amount, 0, 0, 1]
const FEE_SCHEDULE_SLOT = word("miden::standards::fees::policies::constant_fee::fee_schedule")

# Slot holding the root of the procedure that builds the fee schedule lookup key. Must be a
# procedure of this account (validated at dispatch) with the `build_note_fee_lookup_key` interface
# (not checkable on-chain; the deployer's responsibility).
const LOOKUP_KEY_PROC_ROOT_SLOT = word("miden::standards::fees::policies::constant_fee::lookup_key_proc_root")

# Local memory pointer used to pass the lookup-key procedure root to `dyncall`.
const LOOKUP_KEY_PROC_ROOT_PTR = 0

# ERRORS
# =================================================================================================

const ERR_LOOKUP_KEY_PROC_ROOT_NOT_SET = "lookup key procedure root is not set"
const ERR_LOOKUP_KEY_PROC_ROOT_NOT_IN_ACCOUNT = "lookup key procedure root is not a procedure of this account"
const ERR_NOTE_SCRIPT_NOT_IN_FEE_SCHEDULE = "note script has no fee schedule entry"

# POLICY PROCEDURES
# =================================================================================================

#! Fee policy returning the constant fee scheduled for the note.
#!
#! The fee amount is looked up in the fee schedule under a key built from the note parameters by
#! the lookup-key procedure whose root is stored in the `lookup_key_proc_root` slot (invoked via
#! `dyncall`). The built-in `build_note_fee_lookup_key` derives the key from just the note's
#! script root, which it recovers from RECIPIENT via the advice provider, and ignores the
#! remaining parameters, including timeframe and priority. Lookup keys without a schedule entry
#! abort; to make one free, schedule an explicit 0 fee.
#!
#! Inputs:  [RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]
#! Outputs: [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
#!
#! Where:
#! - RECIPIENT is the recipient of the note whose fee is estimated.
#! - ASSETS_COMMITMENT is the commitment to the note's assets.
#! - ATTACHMENTS_COMMITMENT is the commitment to the note's attachments.
#! - timeframe is the timeframe the fee is estimated for.
#! - priority is the priority the fee is estimated for.
#! - FEE_ASSET_ID is the ID of the asset the fee is charged in.
#! - FEE_ASSET_VALUE is the fee as an asset value word [fee_amount, 0, 0, 0].
#!
#! Panics if:
#! - the lookup-key procedure root is not set.
#! - the lookup-key procedure root is not a procedure of this account.
#! - the lookup-key procedure requires the note's recipient preimage and the advice map has no
#!   preimage for the recipient (or the intermediate hash), or a preimage does not hash to the
#!   commitment it claims to open.
#! - the computed lookup key has no fee schedule entry.
#!
#! Invocation: call
@locals(4)
@account_procedure
pub proc compute_note_fee(
    recipient: NoteRecipient,
    assets_commitment: word,
    attachments_commitment: word,
    timeframe: u32,
    priority: u32
) -> Asset
    push.LOOKUP_KEY_PROC_ROOT_SLOT[0..2] exec.active_account::get_item
    # => [LOOKUP_KEY_PROC_ROOT, RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe,
    #     priority, pad(2)]

    exec.word::testz
    assertz.err=ERR_LOOKUP_KEY_PROC_ROOT_NOT_SET

    dupw exec.active_account::has_procedure
    assert.err=ERR_LOOKUP_KEY_PROC_ROOT_NOT_IN_ACCOUNT

    loc_storew_le.LOOKUP_KEY_PROC_ROOT_PTR dropw
    locaddr.LOOKUP_KEY_PROC_ROOT_PTR
    # => [lookup_key_proc_root_ptr, RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT,
    #     timeframe, priority, pad(2)]

    dyncall
    # => [LOOKUP_KEY, pad(12)]

    push.FEE_SCHEDULE_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, LOOKUP_KEY, pad(12)]

    exec.active_account::get_map_item
    # => [FEE_SCHEDULE_ENTRY, pad(12)]

    # replace the set-marker (word element 3) with 0, recovering the plain asset value word
    push.0 swap.4
    # => [marker, FEE_ASSET_VALUE, pad(12)]

    # unset keys read as the zero word, whose marker element is 0
    assert.err=ERR_NOTE_SCRIPT_NOT_IN_FEE_SCHEDULE
    # => [FEE_ASSET_VALUE, pad(12)]

    push.FEE_ASSET_ID_SLOT[0..2] exec.active_account::get_item
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(12)]

    # drop the excess padding to restore the stack depth for the call boundary
    movupw.3 dropw
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
end

# LOOKUP-KEY PROCEDURES
# =================================================================================================

#! Builds the fee schedule lookup key from the note parameters.
#!
#! This is the built-in lookup-key procedure: the key is the note's script root, recovered from
#! RECIPIENT via the advice provider; the remaining parameters are ignored.
#!
#! Inputs:  [RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]
#! Outputs: [LOOKUP_KEY, pad(12)]
#!
#! Panics if:
#! - the advice map has no preimage for the recipient (or the intermediate hash).
#! - a preimage does not hash to the commitment it claims to open.
#!
#! Invocation: call
@account_procedure
pub proc build_note_fee_lookup_key(
    recipient: NoteRecipient,
    assets_commitment: word,
    attachments_commitment: word,
    timeframe: u32,
    priority: u32
) -> StorageMapKey
    exec.note::get_recipient_preimage
    # => [NOTE_SCRIPT_ROOT, STORAGE_COMMITMENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT,
    #     timeframe, priority, pad(2)]

    # keep the script root as the lookup key, dropping the recovered storage commitment and the
    # remaining note parameters
    swapw.3 dropw dropw dropw movup.4 drop movup.4 drop
    # => [LOOKUP_KEY, pad(12)]
end
