# miden::standards::fees::policies::constant_fee
#
# Constant fee policy: derives the fee from a fixed per-note-script fee schedule. Designed to be
# registered on a `FeeManager` (see `miden::standards::fees::fee_manager`), which dispatches fee
# estimation to `compute_note_fee` via `dyncall`.
#
# Storage layout:
# - `fee_asset_id` word: the ID of the asset the fee is charged in.
# - `fee_schedule` map: NOTE_SCRIPT_ROOT => [fee_amount, 0, 0, 1]. The last element is a
#   set-marker distinguishing scheduled entries (including explicit 0 fees) from the zero word
#   returned for unset keys; note scripts without a schedule entry abort fee computation.

use miden::protocol::active_account

use {Asset, NoteScriptRoot, StorageMapKey} from miden::protocol::types

# CONSTANTS
# =================================================================================================

# Slot holding the ID of the asset the fee is charged in.
const FEE_ASSET_ID_SLOT = word("miden::standards::fees::policies::constant_fee::fee_asset_id")

# Slot holding the per-note-script fee schedule.
# Map entries: NOTE_SCRIPT_ROOT => [fee_amount, 0, 0, 1]
const FEE_SCHEDULE_SLOT = word("miden::standards::fees::policies::constant_fee::fee_schedule")

# ERRORS
# =================================================================================================

const ERR_NOTE_SCRIPT_NOT_IN_FEE_SCHEDULE = "note script has no fee schedule entry"

# POLICY PROCEDURES
# =================================================================================================

#! Fee policy returning the constant fee scheduled for the note's script root.
#!
#! The fee amount is looked up in the fee schedule under a key built from the note parameters.
#! This policy derives the key from just NOTE_SCRIPT_ROOT and ignores the remaining parameters;
#! note scripts without a schedule entry abort. To make a note script free, schedule an
#! explicit 0 fee for it.
#!
#! Inputs:  [NOTE_SCRIPT_ROOT, STORAGE_COMMITMENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT]
#! Outputs: [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
#!
#! Where:
#! - NOTE_SCRIPT_ROOT is the root of the script of the note whose fee is estimated.
#! - STORAGE_COMMITMENT is the commitment to the note's storage (ignored by this policy).
#! - ASSETS_COMMITMENT is the commitment to the note's assets (ignored by this policy).
#! - ATTACHMENTS_COMMITMENT is the commitment to the note's attachments (ignored by this
#!   policy).
#! - FEE_ASSET_ID is the ID of the asset the fee is charged in.
#! - FEE_ASSET_VALUE is the fee as an asset value word [fee_amount, 0, 0, 0].
#!
#! Panics if:
#! - the note's script root has no fee schedule entry.
#!
#! Invocation: call
@account_procedure
pub proc compute_note_fee(
    note_script_root: NoteScriptRoot,
    storage_commitment: word,
    assets_commitment: word,
    attachments_commitment: word
) -> Asset
    exec.build_note_fee_lookup_key
    # => [LOOKUP_KEY, pad(12)]

    push.FEE_SCHEDULE_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, LOOKUP_KEY, pad(12)]

    exec.active_account::get_map_item
    # => [FEE_SCHEDULE_ENTRY, pad(12)]

    # replace the set-marker (word element 3) with 0, recovering the plain asset value word
    push.0 swap.4
    # => [marker, FEE_ASSET_VALUE, pad(12)]

    # unset keys read as the zero word, whose marker element is 0
    assert.err=ERR_NOTE_SCRIPT_NOT_IN_FEE_SCHEDULE
    # => [FEE_ASSET_VALUE, pad(12)]

    push.FEE_ASSET_ID_SLOT[0..2] exec.active_account::get_item
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(12)]

    # drop the excess padding to restore the stack depth for the call boundary
    movupw.3 dropw
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
end

# HELPER PROCEDURES
# =================================================================================================

#! Builds the fee schedule lookup key from the note parameters.
#!
#! This policy's lookup key is just NOTE_SCRIPT_ROOT; the remaining parameters are ignored.
#!
#! Inputs:  [NOTE_SCRIPT_ROOT, STORAGE_COMMITMENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT]
#! Outputs: [LOOKUP_KEY]
#!
#! Invocation: exec
proc build_note_fee_lookup_key(
    note_script_root: NoteScriptRoot,
    storage_commitment: word,
    assets_commitment: word,
    attachments_commitment: word
) -> StorageMapKey
    swapw.3 dropw dropw dropw
    # => [LOOKUP_KEY]
end
