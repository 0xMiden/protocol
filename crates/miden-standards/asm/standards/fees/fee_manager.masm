# miden::standards::fees::fee_manager
#
# Fee estimation reads the procedure root of the active fee policy and dispatches fee estimation
# to it via `dyncall`. The actual fee computation logic lives in fee policy components (e.g.
# `miden::standards::fees::policies::constant_fee`), and the active policy can be switched to any
# allowlisted policy root through the authority-gated `set_fee_policy`. The policy returns the full
# fee asset; the configured fee asset ID is read back and the policy's result is asserted to be
# denominated in it, so a policy misconfigured with a different fee asset aborts fee estimation.
#
# Fee collection tallies the fees prepaid by the FEE_SPONSORSHIP notes among the transaction's
# input notes, pricing each feature note through the active fee policy.

use miden::core::word

use miden::protocol::active_account
use miden::protocol::native_account

use miden::standards::access::authority

use {AccountProcedureRoot, Asset, AssetId, NoteRecipient} from miden::protocol::types

# DEPENDENCY NOTE
# `set_fee_policy` consults the account-wide [`Authority`] component (installed separately) via
# `exec.authority::assert_authorized`. This module itself is authority-agnostic and stores no
# authority discriminator.

# CONSTANTS
# =================================================================================================

# Active fee policy root slot. Layout: [PROC_ROOT]
const ACTIVE_FEE_POLICY_PROC_ROOT_SLOT = word("miden::standards::auth::network_account::active_fee_policy_proc_root")

# Allowlist map slot for fee policy roots. Map entries: [PROC_ROOT] -> [1, 0, 0, 0]
const ALLOWED_FEE_POLICY_PROC_ROOTS_SLOT = word("miden::standards::auth::network_account::allowed_fee_policy_proc_roots")

# Slot holding the ID of the asset fees are charged in. Layout: [FEE_ASSET_ID]
const FEE_ASSET_ID_SLOT = word("miden::standards::auth::network_account::fee_asset_id")

# Local memory pointer used to pass a policy root to `dyncall`.
const POLICY_PROC_ROOT_PTR = 0

# ERRORS
# =================================================================================================

const ERR_TIMEFRAME_OR_PRIORITY_NOT_U32 = "timeframe and priority must be u32 values"
const ERR_FEE_POLICY_ROOT_IS_ZERO = "fee policy root is zero"
const ERR_FEE_POLICY_ROOT_NOT_IN_ACCOUNT = "fee policy root is not a procedure of this account"
const ERR_FEE_POLICY_ROOT_NOT_ALLOWED = "fee policy root is not allowed"
const ERR_ACTIVE_FEE_POLICY_NOT_SET = "active fee policy is not set"

const ERR_FEE_POLICY_FEE_ASSET_MISMATCH = "fee policy returned a fee asset that does not match the fee asset configured in the fee manager"

# PUBLIC INTERFACE
# =================================================================================================

#! Returns the estimated fee for a note with the given parameters.
#!
#! Thin `call`-able wrapper around [`estimate_note_fee_internal`]. External callers (typically an
#! authentication component on another account, via FPI) `call` into this procedure to learn the
#! fee this account charges for the note.
#!
#! Policies that price on the note's script root or storage commitment recover them from RECIPIENT
#! via the advice provider, so the recipient preimage must be present in the advice map.
#!
#! Inputs:  [RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]
#! Outputs: [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
#!
#! Where:
#! - RECIPIENT is the recipient of the note whose fee is estimated.
#! - ASSETS_COMMITMENT is the commitment to the note's assets.
#! - ATTACHMENTS_COMMITMENT is the commitment to the note's attachments.
#! - timeframe is an opaque pricing input; its meaning is defined by the active fee policy.
#! - priority is an opaque pricing input; its meaning is defined by the active fee policy.
#! - FEE_ASSET_ID is the ID of the asset the fee is charged in.
#! - FEE_ASSET_VALUE is the fee as an asset value word [fee_amount, 0, 0, 0].
#!
#! Panics if:
#! - timeframe or priority is not a u32 value.
#! - the active fee policy is not set.
#! - the active fee policy requires the note's recipient preimage and it is unavailable or does
#!   not hash to the recipient.
#! - the active fee policy aborts the fee computation.
#! - the active fee policy returns a fee asset other than the configured fee asset.
#!
#! Invocation: call
@account_procedure
pub proc estimate_note_fee(
    recipient: NoteRecipient,
    assets_commitment: word,
    attachments_commitment: word,
    timeframe: u32,
    priority: u32
) -> Asset
    # enforce the declared types of the caller-supplied timeframe and priority
    movup.13 movup.13 u32assert2.err=ERR_TIMEFRAME_OR_PRIORITY_NOT_U32 movdn.13 movdn.13
    # => [RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]

    exec.estimate_note_fee_internal
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
end

#! Returns the ID of the asset fees are charged in.
#!
#! Inputs:  [pad(16)]
#! Outputs: [FEE_ASSET_ID, pad(12)]
#!
#! Invocation: call
@account_procedure
pub proc get_fee_asset_id() -> AssetId
    exec.read_fee_asset_id
    # => [FEE_ASSET_ID, pad(16)]

    swapw dropw
    # => [FEE_ASSET_ID, pad(12)]
end

#! Returns active fee policy root.
#!
#! Inputs:  [pad(16)]
#! Outputs: [FEE_POLICY_ROOT, pad(12)]
#!
#! Invocation: call
@account_procedure
pub proc get_fee_policy() -> AccountProcedureRoot
    exec.get_fee_policy_root
    # => [FEE_POLICY_ROOT, pad(16)]

    swapw dropw
    # => [FEE_POLICY_ROOT, pad(12)]
end

#! Sets active fee policy root.
#!
#! Inputs:  [NEW_POLICY_ROOT, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the caller is not authorized per the installed [`Authority`].
#! - NEW_POLICY_ROOT is zero.
#! - NEW_POLICY_ROOT is not a procedure of this account.
#! - NEW_POLICY_ROOT is not in the allowed roots map.
#!
#! Invocation: call
@account_procedure
pub proc set_fee_policy(new_policy_root: AccountProcedureRoot)
    exec.authority::assert_authorized
    # => [NEW_POLICY_ROOT, pad(12)]

    exec.assert_allowed_fee_policy_root
    # => [NEW_POLICY_ROOT, pad(12)]

    push.ACTIVE_FEE_POLICY_PROC_ROOT_SLOT[0..2] exec.native_account::set_item dropw
    # => [pad(16)]
end

# HELPER PROCEDURES
# =================================================================================================

#! Estimates the fee for a note by executing the active fee policy.
#!
#! This internal entry point trusts its caller to supply u32 timeframe and priority values; the
#! `call`-able [`estimate_note_fee`] wrapper enforces them.
#!
#! Inputs:  [RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]
#! Outputs: [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
#!
#! Where:
#! - RECIPIENT is the recipient of the note whose fee is estimated.
#! - ASSETS_COMMITMENT is the commitment to the note's assets.
#! - ATTACHMENTS_COMMITMENT is the commitment to the note's attachments.
#! - timeframe is an opaque pricing input; its meaning is defined by the active fee policy.
#! - priority is an opaque pricing input; its meaning is defined by the active fee policy.
#! - FEE_ASSET_ID is the ID of the asset the fee is charged in.
#! - FEE_ASSET_VALUE is the fee as an asset value word [fee_amount, 0, 0, 0].
#!
#! Panics if:
#! - the active fee policy is not set.
#! - the active fee policy requires the note's recipient preimage and it is unavailable or does
#!   not hash to the recipient.
#! - the active fee policy aborts the fee computation.
#! - the active fee policy returns a fee asset other than the configured fee asset.
#!
#! Invocation: exec
pub proc estimate_note_fee_internal(
    recipient: NoteRecipient,
    assets_commitment: word,
    attachments_commitment: word,
    timeframe: u32,
    priority: u32
) -> Asset
    exec.execute_fee_policy
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
end

#! Executes the active fee policy by dynamic invocation.
#!
#! All note parameters are forwarded to the active fee policy (via `dyncall`), which derives the
#! fee asset from them; the returned fee asset ID is asserted to match the fee asset ID in the
#! fee-policy storage, so the policy cannot charge in an asset the account is not configured with.
#!
#! Inputs:  [RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]
#! Outputs: [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
#!
#! Where:
#! - RECIPIENT is the recipient of the note whose fee is estimated.
#! - ASSETS_COMMITMENT is the commitment to the note's assets.
#! - ATTACHMENTS_COMMITMENT is the commitment to the note's attachments.
#! - timeframe is an opaque pricing input; its meaning is defined by the active fee policy.
#! - priority is an opaque pricing input; its meaning is defined by the active fee policy.
#! - FEE_ASSET_ID is the ID of the asset the fee is charged in.
#! - FEE_ASSET_VALUE is the fee as an asset value word [fee_amount, 0, 0, 0].
#!
#! Panics if:
#! - the active fee policy is not set.
#! - the active fee policy requires the note's recipient preimage and it is unavailable or does
#!   not hash to the recipient.
#! - the active fee policy aborts the fee computation.
#! - the active fee policy returns a fee asset other than the configured fee asset.
#!
#! Invocation: exec
@locals(4)
proc execute_fee_policy(
    recipient: NoteRecipient,
    assets_commitment: word,
    attachments_commitment: word,
    timeframe: u32,
    priority: u32
) -> Asset
    exec.get_fee_policy_root
    # => [FEE_POLICY_ROOT, RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe,
    #     priority, pad(2)]

    exec.word::testz
    assertz.err=ERR_ACTIVE_FEE_POLICY_NOT_SET
    # => [FEE_POLICY_ROOT, RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe,
    #     priority, pad(2)]

    loc_storew_le.POLICY_PROC_ROOT_PTR dropw
    # => [RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, priority, pad(2)]

    locaddr.POLICY_PROC_ROOT_PTR
    # => [policy_root_ptr, RECIPIENT, ASSETS_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe,
    #     priority, pad(2)]

    dyncall
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]

    # the policy must return the fee asset this manager is configured with
    dupw exec.read_fee_asset_id exec.word::eq
    assert.err=ERR_FEE_POLICY_FEE_ASSET_MISMATCH
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
end

#! Reads active fee policy root from storage.
#!
#! Inputs:  []
#! Outputs: [FEE_POLICY_ROOT]
#!
#! Invocation: exec
proc get_fee_policy_root() -> AccountProcedureRoot
    push.ACTIVE_FEE_POLICY_PROC_ROOT_SLOT[0..2] exec.active_account::get_item
    # => [FEE_POLICY_ROOT]
end

#! Reads the fee asset ID from storage.
#!
#! Inputs:  []
#! Outputs: [FEE_ASSET_ID]
#!
#! Invocation: exec
pub proc read_fee_asset_id() -> AssetId
    push.FEE_ASSET_ID_SLOT[0..2] exec.active_account::get_item
    # => [FEE_ASSET_ID]
end

#! Validates a fee policy root at config time.
#!
#! Inputs:  [FEE_POLICY_ROOT]
#! Outputs: [FEE_POLICY_ROOT]
#!
#! Panics if:
#! - policy root is zero.
#! - policy root is not present in this account's procedures.
#! - policy root is not in the allowed fee policy roots map.
#!
#! Invocation: exec
proc assert_allowed_fee_policy_root(policy_root: AccountProcedureRoot) -> AccountProcedureRoot
    exec.word::testz
    assertz.err=ERR_FEE_POLICY_ROOT_IS_ZERO
    # => [FEE_POLICY_ROOT]

    dupw exec.active_account::has_procedure
    assert.err=ERR_FEE_POLICY_ROOT_NOT_IN_ACCOUNT
    # => [FEE_POLICY_ROOT]

    dupw
    push.ALLOWED_FEE_POLICY_PROC_ROOTS_SLOT[0..2]
    exec.active_account::get_map_item
    # => [ALLOWED_FLAG, FEE_POLICY_ROOT]

    exec.word::eqz
    assertz.err=ERR_FEE_POLICY_ROOT_NOT_ALLOWED
    # => [FEE_POLICY_ROOT]
end
