#! miden::standards::fees::fee_manager
#!
#! Holds the price list a network account charges for consuming a note, and the ID of the asset it
#! accepts fees in.
#!
#! The component holds no runtime asset path. It answers "what does this note cost?" and nothing
#! else. Moving the fee is the job of the sponsorship note and the account's auth procedure.
#!
#! Requires that the account also installs the [`Authority`] component, whose `assert_authorized`
#! gates the admin procedures.

use miden::core::word
use miden::protocol::active_account
use miden::protocol::input_note
use miden::protocol::native_account
use miden::protocol::note
use miden::protocol::output_note
use miden::protocol::tx
use {NOTE_TYPE_PUBLIC} from miden::protocol::note
use miden::protocol::account_id
use {ALWAYS} from miden::standards::note::execution_hint
use miden::standards::access::authority
use miden::standards::attachments::fee_sponsorship
use miden::standards::attachments::network_account_target
use {NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME} from miden::standards::attachments::network_account_target
use miden::standards::note::note_id
use miden::standards::notes::fee as fee_note
use miden::standards::notes::network_sponsorship

# CONSTANTS
# ================================================================================================

#! The storage slot holding the ASSET_ID word of the asset this account accepts fees in.
const FEE_ASSET_ID_SLOT = word("miden::standards::fees::fee_manager::fee_asset_id")

#! The storage slot holding the fee schedule, a map of
#! NOTE_SCRIPT_ROOT -> [app_fee, protocol_fee, enabled, 0].
const FEE_SCHEDULE_SLOT = word("miden::standards::fees::fee_manager::fee_schedule")

#! The storage slot holding the spawn schedule, a map of
#! PARENT_NOTE_SCRIPT_ROOT -> CHILD_NOTE_SCRIPT_ROOT.
#!
#! The kernel never learns an output note's script root: `output_note::create` takes only a
#! recipient, into which the script root is hashed irreversibly. An account that wants to price a
#! note it is about to spawn must therefore declare what it spawns, which is what this map is.
const SPAWN_SCHEDULE_SLOT = word("miden::standards::fees::fee_manager::spawn_schedule")

# ERRORS
# ================================================================================================

const ERR_FEE_MANAGER_ENABLED_NOT_BOOLEAN="the enabled flag of a fee schedule entry must be 0 or 1"

const ERR_FEE_MANAGER_SCRIPT_NOT_PRICED="the note script root is not priced by this account's fee schedule"

const ERR_FEE_MANAGER_SPONSORSHIP_NOT_ONE_ASSET="a NETWORK_SPONSORSHIP note must carry exactly one asset"

const ERR_FEE_MANAGER_SPONSORSHIP_WRONG_ASSET="a NETWORK_SPONSORSHIP note must carry the fee asset this account accepts"

const ERR_FEE_MANAGER_INSUFFICIENT_SPONSORSHIP="the feature note is not covered by enough sponsorship"

const ERR_FEE_MANAGER_SPAWNED_NOTE_NOT_FOUND="the spawn schedule declares a downstream note but this transaction created no note targeted at another account"

const ERR_FEE_MANAGER_MULTIPLE_SPAWNING_NOTES="this account cannot settle more than one spawning feature note per transaction"

# PROCEDURES
# ================================================================================================

#! Returns the ASSET_ID of the asset this account accepts fees in.
#!
#! Inputs:  []
#! Outputs: [FEE_ASSET_ID]
#!
#! Invocation: exec
proc fee_asset_id
    push.FEE_ASSET_ID_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix]

    exec.active_account::get_item
    # => [FEE_ASSET_ID]
end

#! Returns the fee schedule entry for the provided note script root.
#!
#! An absent entry reads back as the empty word, whose `enabled` felt is 0. That is what makes an
#! unpriced script distinguishable from a genuinely free one, which is stored as
#! `[0, 0, 1, 0]`.
#!
#! Inputs:  [NOTE_SCRIPT_ROOT]
#! Outputs: [app_fee, protocol_fee, enabled, 0]
#!
#! Where:
#! - app_fee is the portion the account keeps for performing the note's business logic.
#! - protocol_fee is the portion forwarded to the batch builder.
#! - enabled is 1 if the script is priced, 0 if the entry is absent or disabled.
#!
#! Invocation: exec
proc fee_entry
    # => [NOTE_SCRIPT_ROOT]
    push.FEE_SCHEDULE_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, NOTE_SCRIPT_ROOT]

    exec.active_account::get_map_item
    # => [app_fee, protocol_fee, enabled, 0]
end

#! Returns the script root of the note that the provided note script spawns, or the empty word if
#! it spawns nothing.
#!
#! Inputs:  [PARENT_NOTE_SCRIPT_ROOT]
#! Outputs: [CHILD_NOTE_SCRIPT_ROOT]
#!
#! Invocation: exec
proc spawn_entry
    push.SPAWN_SCHEDULE_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, PARENT_NOTE_SCRIPT_ROOT]

    exec.active_account::get_map_item
    # => [CHILD_NOTE_SCRIPT_ROOT]
end

#! Returns the ASSET_ID of the asset this account accepts fees in.
#!
#! Exposed so that a note creator, or an upstream network account pricing a note it is about to
#! spawn, can discover the fee asset over a foreign procedure invocation.
#!
#! Inputs:  [pad(16)]
#! Outputs: [FEE_ASSET_ID, pad(12)]
#!
#! Invocation: call
@account_procedure
pub proc get_fee_asset_id
    exec.fee_asset_id
    # => [FEE_ASSET_ID, pad(16)]

    # a call must return with a stack depth of exactly 16, so drop the word the read pushed us over by
    swapw dropw
    # => [FEE_ASSET_ID, pad(12)]
end

#! Returns the fee this account requires to accept the note with the provided parameters.
#!
#! The estimator is flat: it looks the script root up in the fee schedule and ignores the storage
#! commitment, the attachments commitment and the timeframe. Those parameters are nonetheless part
#! of the signature, so that a richer estimator can replace this one without changing any caller,
#! and so that the procedure remains callable over a foreign procedure invocation to price a note
#! that does not exist yet.
#!
#! Inputs:  [NOTE_SCRIPT_ROOT, STORAGE_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, pad(3)]
#! Outputs: [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
#!
#! Where:
#! - timeframe is the number of blocks for which the estimate should remain valid. Ignored.
#! - FEE_ASSET_VALUE is `[fee_amount, 0, 0, 0]`, the value word of the required fungible asset.
#!
#! Panics if:
#! - the note script root is not priced by this account.
#!
#! Invocation: call
@account_procedure
pub proc estimate_note_fee
    # => [NOTE_SCRIPT_ROOT, STORAGE_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe, pad(3)]
    swapw dropw
    # => [NOTE_SCRIPT_ROOT, ATTACHMENTS_COMMITMENT, timeframe, pad(3)]

    swapw dropw
    # => [NOTE_SCRIPT_ROOT, timeframe, pad(3)]

    movup.4 drop
    # => [NOTE_SCRIPT_ROOT, pad(3)]

    exec.fee_entry
    # => [app_fee, protocol_fee, enabled, 0, pad(3)]

    movup.2 assert.err=ERR_FEE_MANAGER_SCRIPT_NOT_PRICED
    # => [app_fee, protocol_fee, 0, pad(3)]

    add
    # => [fee_amount, 0, pad(3)]

    swap drop
    # => [fee_amount, pad(3)]

    push.0.0.0 movup.3
    # => [FEE_ASSET_VALUE, pad(15)]

    exec.fee_asset_id
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(15)]

    # A call must return with a stack depth of exactly 16. Dropping an operand never shrinks the
    # stack below 16 (a zero shifts in from below), so the reads above left us eight elements over.
    swapdw dropw dropw
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]
end

#! Prices the note script with the provided root.
#!
#! Inputs:  [NOTE_SCRIPT_ROOT, app_fee, protocol_fee, enabled, pad(9)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the caller is not authorized per the installed [`Authority`].
#! - enabled is not 0 or 1.
#!
#! Invocation: call
@locals(8)
@account_procedure
pub proc set_fee
    exec.authority::assert_authorized
    # => [NOTE_SCRIPT_ROOT, app_fee, protocol_fee, enabled, pad(9)]

    # enabled must be a boolean, i.e. enabled * (enabled - 1) == 0
    dup.6 dup sub.1 mul assertz.err=ERR_FEE_MANAGER_ENABLED_NOT_BOOLEAN
    # => [NOTE_SCRIPT_ROOT, app_fee, protocol_fee, enabled, pad(9)]

    loc_storew_le.0 dropw
    # => [app_fee, protocol_fee, enabled, pad(9)]

    push.0 movdn.3
    # => [app_fee, protocol_fee, enabled, 0, pad(9)]

    loc_storew_le.4 dropw
    # => [pad(9)]

    padw loc_loadw_le.4
    # => [FEE_ENTRY, pad(9)]

    padw loc_loadw_le.0
    # => [NOTE_SCRIPT_ROOT, FEE_ENTRY, pad(9)]

    push.FEE_SCHEDULE_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, NOTE_SCRIPT_ROOT, FEE_ENTRY, pad(9)]

    exec.native_account::set_map_item dropw
    # => [pad(16)]
end

#! Removes the price of the note script with the provided root.
#!
#! Inputs:  [NOTE_SCRIPT_ROOT, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the caller is not authorized per the installed [`Authority`].
#!
#! Invocation: call
@account_procedure
pub proc remove_fee
    exec.authority::assert_authorized
    # => [NOTE_SCRIPT_ROOT, pad(12)]

    padw swapw
    # => [NOTE_SCRIPT_ROOT, EMPTY_WORD, pad(12)]

    push.FEE_SCHEDULE_SLOT[0..2]
    # => [slot_id_suffix, slot_id_prefix, NOTE_SCRIPT_ROOT, EMPTY_WORD, pad(12)]

    exec.native_account::set_map_item dropw
    # => [pad(16)]
end

# FEE SETTLEMENT
# ================================================================================================

#! Returns the total sponsorship bound to the provided feature note ID by this transaction's input
#! notes.
#!
#! Every input note carrying the NETWORK_SPONSORSHIP script root, whose fee sponsorship attachment
#! names FEATURE_NOTE_ID, contributes its single fee asset. Sponsorship is summed rather than
#! matched one-to-one, which is what makes a second sponsorship note a top-up rather than a way to
#! block the feature note it names.
#!
#! Inputs:  [FEATURE_NOTE_ID]
#! Outputs: [sponsored_amount]
#!
#! Where:
#! - FEATURE_NOTE_ID is the ID of the feature note whose sponsorship should be summed.
#! - sponsored_amount is the total amount of the fee asset sponsoring that note.
#!
#! Panics if:
#! - a sponsorship note bound to this feature note carries anything other than exactly one asset.
#! - that asset is not the fee asset this account accepts.
#!
#! Invocation: exec
@locals(24)
proc sponsored_amount
    loc_storew_le.0 dropw
    # => []

    exec.fee_asset_id loc_storew_le.4 dropw
    # => []

    push.0 loc_store.8
    # => []

    exec.tx::get_num_input_notes
    # => [note_idx]

    dup neq.0
    # => [should_loop, note_idx]

    while.true
        # => [note_idx]
        sub.1 dup loc_store.9
        # => [note_idx]

        exec.input_note::get_script_root
        # => [NOTE_SCRIPT_ROOT]

        procref.network_sponsorship::main
        # => [SPONSORSHIP_SCRIPT_ROOT, NOTE_SCRIPT_ROOT]

        exec.word::eq
        # => [is_sponsorship]

        if.true
            loc_load.9 exec.fee_sponsorship::input_note_bound_note_id
            # => [BOUND_NOTE_ID]

            padw loc_loadw_le.0
            # => [FEATURE_NOTE_ID, BOUND_NOTE_ID]

            exec.word::eq
            # => [is_bound_to_this_feature_note]

            if.true
                loc_load.9 locaddr.12
                # => [dest_ptr, note_idx]

                exec.input_note::get_assets
                # => [num_assets]

                eq.1 assert.err=ERR_FEE_MANAGER_SPONSORSHIP_NOT_ONE_ASSET
                # => []

                padw loc_loadw_le.12
                # => [SPONSORSHIP_ASSET_ID]

                padw loc_loadw_le.4
                # => [FEE_ASSET_ID, SPONSORSHIP_ASSET_ID]

                exec.word::eq assert.err=ERR_FEE_MANAGER_SPONSORSHIP_WRONG_ASSET
                # => []

                # the asset value word sits directly after the asset ID word
                loc_load.16 loc_load.8 add loc_store.8
                # => []
            end
        end

        loc_load.9 dup neq.0
        # => [should_loop, note_idx]
    end
    # => [note_idx]

    drop loc_load.8
    # => [sponsored_amount]
end

#! Moves `amount` of this account's fee asset out of the vault and into the output note at
#! `note_idx`.
#!
#! Inputs:  [amount, note_idx]
#! Outputs: []
#!
#! Panics if:
#! - the account vault does not hold `amount` of the fee asset.
#!
#! Invocation: exec
@locals(4)
proc fund_note_with_fee_asset
    loc_store.0
    # => [note_idx]

    push.0.0.0 loc_load.0 exec.fee_asset_id
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, note_idx]

    exec.native_account::remove_asset dropw
    # => [note_idx]

    push.0.0.0 loc_load.0 exec.fee_asset_id
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, note_idx]

    exec.output_note::add_asset
    # => []
end

#! Finds the output note this transaction created that is targeted at some *other* network account.
#!
#! Inputs:  []
#! Outputs: [is_found, note_idx, target_id_suffix, target_id_prefix]
#!
#! Where:
#! - is_found is 1 if such a note exists, 0 otherwise, in which case the remaining outputs are
#!   meaningless.
#! - note_idx is the index of the first such output note.
#! - target_id_{suffix, prefix} identify the network account it is routed at.
#!
#! Invocation: exec
@locals(12)
proc find_downstream_note
    exec.tx::get_num_output_notes loc_store.4
    push.0 loc_store.5
    push.0 loc_store.6
    # => []

    loc_load.4 neq.0
    # => [should_loop]

    while.true
        loc_load.5
        # => [note_idx]

        push.NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME
        # => [attachment_scheme, note_idx]

        exec.output_note::find_attachment
        # => [is_found, attachment_idx]

        if.true
            loc_load.5 swap locaddr.8
            # => [dest_ptr, attachment_idx, note_idx]

            exec.output_note::write_attachment_to_memory drop
            # => []

            padw loc_loadw_le.8
            # => [NETWORK_ACCOUNT_TARGET_ATTACHMENT]

            exec.network_account_target::into_target_id
            # => [target_id_suffix, target_id_prefix]

            dup.1 dup.1 exec.active_account::get_id exec.account_id::is_equal
            # => [targets_this_account, target_id_suffix, target_id_prefix]

            if.true
                drop drop
                # => []
            else
                loc_store.0 loc_store.1
                loc_load.5 loc_store.7
                push.1 loc_store.6
                # => []
            end
        else
            drop
            # => []
        end

        loc_load.5 add.1 loc_store.5
        # => []

        loc_load.6 not
        loc_load.5 loc_load.4 lt
        and
        # => [should_loop]
    end
    # => []

    loc_load.1 loc_load.0 loc_load.7 loc_load.6
    # => [is_found, note_idx, target_id_suffix, target_id_prefix]
end

#! Asks the account with the provided ID what it charges to accept a note bearing the provided
#! script root, over a foreign procedure invocation.
#!
#! Only the returned amount is used; the returned asset ID is discarded and this account's own fee
#! asset is used instead, so a hostile downstream cannot redirect the asset type. The amount is
#! likewise untrusted: the caller must check the sponsorship covers it before paying it out.
#!
#! Inputs:  [CHILD_NOTE_SCRIPT_ROOT, target_id_suffix, target_id_prefix]
#! Outputs: [fee_amount]
#!
#! Invocation: exec
@locals(8)
proc estimate_downstream_fee
    loc_storew_le.0 dropw
    loc_store.4 loc_store.5
    # => []

    push.0 padw padw padw loc_loadw_le.0
    # => [CHILD_NOTE_SCRIPT_ROOT, STORAGE_COMMITMENT, ATTACHMENTS_COMMITMENT, timeframe]

    procref.estimate_note_fee
    # => [FOREIGN_PROC_ROOT, foreign_procedure_inputs(13)]

    loc_load.5 loc_load.4
    # => [foreign_id_suffix, foreign_id_prefix, FOREIGN_PROC_ROOT, foreign_procedure_inputs(13)]

    exec.tx::execute_foreign_procedure
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]

    # the foreign procedure returns 16 elements; drop the asset ID, keep the amount, drop the rest
    dropw loc_store.6 dropw dropw drop drop drop
    # => []

    loc_load.6
    # => [fee_amount]
end

#! Creates a sponsorship note for the downstream network note this transaction spawned, funding it
#! from the account vault.
#!
#! The caller must already have established that the upstream sponsorship covers `fee_amount`, since
#! the asset is taken out of the vault. Without that check the account would front the downstream
#! leg's liquidity, and a hostile downstream account could name an arbitrary amount.
#!
#! Inputs:  [fee_amount, child_note_idx, target_id_suffix, target_id_prefix]
#! Outputs: []
#!
#! Invocation: exec
@locals(16)
proc sponsor_downstream_note
    loc_store.0 loc_store.1 loc_store.2 loc_store.3
    # => []

    loc_load.1 exec.note_id::compute_output_note_id
    loc_storew_le.4 dropw
    # => []

    # reclaim is disabled on a chained sponsorship: its sponsor is this account, not a user
    push.0 loc_store.8
    # => []

    procref.network_sponsorship::main
    # => [SPONSORSHIP_SCRIPT_ROOT]

    loc_load.1 add.1 exec.active_account::get_nonce exec.active_account::get_id
    # => [SERIAL_NUM, SPONSORSHIP_SCRIPT_ROOT]

    push.1 locaddr.8
    # => [storage_ptr, num_storage_items, SERIAL_NUM, SPONSORSHIP_SCRIPT_ROOT]

    exec.note::compute_and_store_recipient
    # => [RECIPIENT]

    push.NOTE_TYPE_PUBLIC push.0
    # => [tag, note_type, RECIPIENT]

    exec.output_note::create loc_store.12
    # => []

    # route the sponsorship at the downstream account
    loc_load.12 push.ALWAYS loc_load.3 loc_load.2
    # => [target_id_suffix, target_id_prefix, exec_hint_tag, note_idx]

    exec.network_account_target::new
    # => [attachment_scheme, NOTE_ATTACHMENT, note_idx]

    exec.output_note::add_word_attachment
    # => []

    # bind it to the note it pays for
    loc_load.12 padw loc_loadw_le.4
    # => [CHILD_NOTE_ID, note_idx]

    exec.fee_sponsorship::new
    # => [attachment_scheme, NOTE_ATTACHMENT, note_idx]

    exec.output_note::add_word_attachment
    # => []

    # fund it out of the vault, where the upstream sponsorship was already deposited
    loc_load.12 loc_load.0
    # => [fee_amount, note_idx]

    exec.fund_note_with_fee_asset
    # => []
end

#! Settles the fees of the current transaction.
#!
#! Asserts that every feature note this account consumed is covered by enough sponsorship, then
#! forwards the summed protocol portion to the batch builder in a single FEE note. The application
#! portion, and any surplus the sponsor overpaid, stay with the account.
#!
#! A feature note that spawns a downstream network note must be covered for that note's fee too:
#! the required amount is `app_fee + protocol_fee + downstream_fee`, where the downstream fee comes
#! from asking the downstream account itself, over FPI, what it charges. The downstream sponsorship
#! is then funded out of the vault. Folding the downstream fee into the coverage check *before*
#! paying it out is what keeps this account from fronting the next hop's liquidity, and is what
#! bounds the payout a hostile downstream account can name: an inflated estimate fails the check
#! rather than draining the vault.
#!
#! This is the mirror image of the check inside the sponsorship note's own script. Consuming a
#! sponsorship without its feature note costs the *sponsor*, so that note guards it. Consuming a
#! feature note without sponsorship costs the *account*, so the account guards this.
#!
#! Must be called from the account's auth procedure, which the kernel invokes unconditionally. A
#! note script could not be trusted to call it: a feature note that skipped the call would be
#! exactly the note that never paid.
#!
#! Note that the downstream note is located by its network account target attachment, not by its
#! script root, which the kernel does not record for output notes. A parent note that spawns a note
#! other than the one it declared in the spawn schedule is therefore mispriced rather than rejected.
#! Only script roots the account operator has priced can be consumed at all, so the parent script is
#! reviewed before it is priced; that review must confirm it spawns what it declares, and routes it
#! at an honest account.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Panics if:
#! - a feature note's script root is not priced by this account.
#! - a feature note is not covered by enough sponsorship, including the downstream fee it spawns.
#! - more than one consumed feature note spawns a downstream note.
#! - a feature note declares a downstream note that this transaction did not create.
#!
#! Invocation: exec
@locals(24)
pub proc settle_fees
    push.0 loc_store.4
    push.0 loc_store.6
    push.0 loc_store.19
    # => []

    exec.tx::get_num_input_notes
    # => [note_idx]

    dup neq.0
    # => [should_loop, note_idx]

    while.true
        # => [note_idx]
        sub.1 dup loc_store.5
        # => [note_idx]

        exec.input_note::get_script_root loc_storew_le.8
        # => [NOTE_SCRIPT_ROOT]

        procref.network_sponsorship::main
        # => [SPONSORSHIP_SCRIPT_ROOT, NOTE_SCRIPT_ROOT]

        exec.word::eq not
        # => [is_feature_note]

        if.true
            padw loc_loadw_le.8
            # => [NOTE_SCRIPT_ROOT]

            exec.fee_entry
            # => [app_fee, protocol_fee, enabled, 0]

            movup.2 assert.err=ERR_FEE_MANAGER_SCRIPT_NOT_PRICED
            # => [app_fee, protocol_fee, 0]

            movup.2 drop swap
            # => [protocol_fee, app_fee]

            dup loc_load.4 add loc_store.4
            # => [protocol_fee, app_fee]

            add loc_store.20
            # => []

            # does this feature note spawn a downstream network note?
            padw loc_loadw_le.8 exec.spawn_entry
            # => [CHILD_NOTE_SCRIPT_ROOT]

            loc_storew_le.12
            # => [CHILD_NOTE_SCRIPT_ROOT]

            exec.word::eqz not
            # => [spawns_downstream_note]

            if.true
                # only one spawning feature note per transaction is supported: the downstream note
                # is located by attachment rather than by script root, so a second one could not be
                # matched to its parent
                loc_load.19 add.1 dup loc_store.19
                eq.1 assert.err=ERR_FEE_MANAGER_MULTIPLE_SPAWNING_NOTES
                # => []

                push.1 loc_store.6
                # => []

                exec.find_downstream_note
                # => [is_found, note_idx, target_id_suffix, target_id_prefix]

                assert.err=ERR_FEE_MANAGER_SPAWNED_NOTE_NOT_FOUND
                # => [note_idx, target_id_suffix, target_id_prefix]

                loc_store.7 loc_store.17 loc_store.18
                # => []

                loc_load.18 loc_load.17 padw loc_loadw_le.12
                # => [CHILD_NOTE_SCRIPT_ROOT, target_id_suffix, target_id_prefix]

                exec.estimate_downstream_fee loc_store.16
                # => []

                # the sponsorship must cover the downstream leg too, or this account would front it
                loc_load.16 loc_load.20 add loc_store.20
                # => []
            end
            # => []

            loc_load.20
            # => [required]

            loc_load.5 exec.note_id::compute_input_note_id
            # => [FEATURE_NOTE_ID, required]

            exec.sponsored_amount
            # => [sponsored, required]

            lte assert.err=ERR_FEE_MANAGER_INSUFFICIENT_SPONSORSHIP
            # => []
        end

        loc_load.5 dup neq.0
        # => [should_loop, note_idx]
    end
    # => [note_idx]

    drop
    # => []

    # sponsor the downstream note, if any, before emitting the FEE note
    loc_load.6
    # => [spawns_downstream_note]

    if.true
        loc_load.18 loc_load.17 loc_load.7 loc_load.16
        # => [fee_amount, child_note_idx, target_id_suffix, target_id_prefix]

        exec.sponsor_downstream_note
    end
    # => []

    loc_load.4 dup neq.0
    # => [has_protocol_fee, protocol_owed]

    if.true
        exec.emit_fee_note
        # => []
    else
        drop
        # => []
    end
end

#! Emits a single FEE note carrying `protocol_owed` of this account's fee asset, payable to whoever
#! builds the batch.
#!
#! The asset is taken out of the account vault, into which the sponsorship notes' scripts already
#! deposited it, so asset preservation holds.
#!
#! The serial number is `[account_id_suffix, account_id_prefix, nonce, 0]`, which is unique because
#! an account's nonce strictly increases with every transaction it authorises. It must therefore be
#! read before the nonce is incremented. A downstream sponsorship note created in the same
#! transaction uses `child_note_idx + 1` in that last felt, so the two never collide.
#!
#! Inputs:  [protocol_owed]
#! Outputs: []
#!
#! Invocation: exec
@locals(8)
proc emit_fee_note
    loc_store.4
    # => []

    procref.fee_note::main
    # => [FEE_NOTE_SCRIPT_ROOT]

    push.0 exec.active_account::get_nonce exec.active_account::get_id
    # => [SERIAL_NUM, FEE_NOTE_SCRIPT_ROOT]

    push.0 locaddr.0
    # => [storage_ptr, num_storage_items, SERIAL_NUM, FEE_NOTE_SCRIPT_ROOT]

    exec.note::compute_and_store_recipient
    # => [RECIPIENT]

    push.NOTE_TYPE_PUBLIC push.0
    # => [tag, note_type, RECIPIENT]

    exec.output_note::create
    # => [note_idx]

    loc_load.4
    # => [protocol_owed, note_idx]

    exec.fund_note_with_fee_asset
    # => []
end
