use miden::protocol::active_note
use miden::standards::access::rbac

# CONSTANTS
# =================================================================================================

# Memory base at which the note storage is written by `active_note::get_storage`.
const STORAGE_PTR = 0

# Memory addresses of the RbacConfig note storage. `ROLE_SYMBOL_PTR` is shared by every action;
# the remaining slots are reused per action (an account ID for grant / revoke, an admin role for
# set-role-admin).
const SELECTOR_PTR = STORAGE_PTR
const ROLE_SYMBOL_PTR = STORAGE_PTR + 1
const ACCOUNT_SUFFIX_PTR = STORAGE_PTR + 2
const ACCOUNT_PREFIX_PTR = STORAGE_PTR + 3
const ADMIN_ROLE_SYMBOL_PTR = STORAGE_PTR + 2

# Action selectors, stored in the first storage item. Keep in sync with `RbacConfig` on the Rust
# side.
const SELECTOR_GRANT_ROLE = 0
const SELECTOR_REVOKE_ROLE = 1
const SELECTOR_SET_ROLE_ADMIN = 2
const SELECTOR_RENOUNCE_ROLE = 3

# Expected note storage item count per action.
const NUM_ITEMS_GRANT_ROLE = 4
const NUM_ITEMS_REVOKE_ROLE = 4
const NUM_ITEMS_SET_ROLE_ADMIN = 3
const NUM_ITEMS_RENOUNCE_ROLE = 2

# ERRORS
# =================================================================================================

const ERR_RBAC_CONFIG_UNKNOWN_SELECTOR = "rbac config note selector does not match a known action"

const ERR_RBAC_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "rbac config note storage item count does not match the selected action"

# NOTE SCRIPT
# =================================================================================================

#! RbacConfig script: triggers a `RoleBasedAccessControl` management action against the consuming
#! account, dispatched on a selector stored in the first note storage item.
#!
#! The selected action and its arguments are read from the note storage (fixed at note creation,
#! so authorization is bound to the note sender):
#! - `0` GrantRole:    `[0, role_symbol, account_suffix, account_prefix]`.
#! - `1` RevokeRole:   `[1, role_symbol, account_suffix, account_prefix]`.
#! - `2` SetRoleAdmin: `[2, role_symbol, admin_role_symbol]`.
#! - `3` RenounceRole: `[3, role_symbol]`.
#!
#! All authorization is enforced by the called `rbac` procedures against the note sender
#! (`active_note::get_sender`); this script only loads the arguments and calls them.
#!
#! Requires that the account exposes:
#! - `miden::standards::access::rbac::{grant_role, revoke_role, set_role_admin, renounce_role}`
#!   (the `RoleBasedAccessControl` component).
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the selector is not a known action.
#! - the number of storage items does not match the selected action.
#! - the note sender is not authorized for the selected action (per the `rbac` procedures).
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # write the note storage to memory starting at STORAGE_PTR
    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_storage_items]

    mem_load.SELECTOR_PTR
    # => [selector, num_storage_items]

    # dispatch on the selector to the matching action procedure
    dup eq.SELECTOR_GRANT_ROLE
    # => [is_grant, selector, num_storage_items]

    if.true
        drop
        # => [num_storage_items]

        exec.execute_grant_role
    else
        dup eq.SELECTOR_REVOKE_ROLE
        # => [is_revoke, selector, num_storage_items]

        if.true
            drop
            # => [num_storage_items]

            exec.execute_revoke_role
        else
            dup eq.SELECTOR_SET_ROLE_ADMIN
            # => [is_set_role_admin, selector, num_storage_items]

            if.true
                drop
                # => [num_storage_items]

                exec.execute_set_role_admin
            else
                eq.SELECTOR_RENOUNCE_ROLE assert.err=ERR_RBAC_CONFIG_UNKNOWN_SELECTOR
                # => [num_storage_items]

                exec.execute_renounce_role
            end
        end
    end
    # => [pad(16)]
end

# HELPER PROCEDURES
# =================================================================================================

#! Executes the GrantRole action: grants `role_symbol` to the stored account.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_GRANT_ROLE.
#! - the note sender does not hold the role's effective admin role, the role symbol is zero, or the
#!   account ID is invalid (per `rbac::grant_role`).
#!
#! Invocation: exec
proc execute_grant_role
    eq.NUM_ITEMS_GRANT_ROLE
    assert.err=ERR_RBAC_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # build the `grant_role` input window: [role_symbol, account_suffix, account_prefix, pad(13)]
    padw padw padw push.0
    mem_load.ACCOUNT_PREFIX_PTR
    mem_load.ACCOUNT_SUFFIX_PTR
    mem_load.ROLE_SYMBOL_PTR
    # => [role_symbol, account_suffix, account_prefix, pad(13)]

    call.rbac::grant_role
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Executes the RevokeRole action: revokes `role_symbol` from the stored account.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_REVOKE_ROLE.
#! - the note sender does not hold the role's effective admin role, the role symbol is zero, or the
#!   account does not hold the role (per `rbac::revoke_role`).
#!
#! Invocation: exec
proc execute_revoke_role
    eq.NUM_ITEMS_REVOKE_ROLE
    assert.err=ERR_RBAC_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # build the `revoke_role` input window: [role_symbol, account_suffix, account_prefix, pad(13)]
    padw padw padw push.0
    mem_load.ACCOUNT_PREFIX_PTR
    mem_load.ACCOUNT_SUFFIX_PTR
    mem_load.ROLE_SYMBOL_PTR
    # => [role_symbol, account_suffix, account_prefix, pad(13)]

    call.rbac::revoke_role
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Executes the SetRoleAdmin action: sets `admin_role_symbol` as the admin role of `role_symbol`
#! (an admin role of zero reverts to management by the default `ADMIN` role).
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_SET_ROLE_ADMIN.
#! - the note sender does not hold the role's current effective admin role, or the role symbol is
#!   zero (per `rbac::set_role_admin`).
#!
#! Invocation: exec
proc execute_set_role_admin
    eq.NUM_ITEMS_SET_ROLE_ADMIN
    assert.err=ERR_RBAC_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # build the `set_role_admin` input window: [role_symbol, admin_role_symbol, pad(14)]
    padw padw padw push.0.0
    mem_load.ADMIN_ROLE_SYMBOL_PTR
    mem_load.ROLE_SYMBOL_PTR
    # => [role_symbol, admin_role_symbol, pad(14)]

    call.rbac::set_role_admin
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Executes the RenounceRole action: the note sender renounces `role_symbol`.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_RENOUNCE_ROLE.
#! - the role symbol is zero, or the note sender does not hold the role (per `rbac::renounce_role`).
#!
#! Invocation: exec
proc execute_renounce_role
    eq.NUM_ITEMS_RENOUNCE_ROLE
    assert.err=ERR_RBAC_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # build the `renounce_role` input window: [role_symbol, pad(15)]
    padw padw padw push.0.0.0
    mem_load.ROLE_SYMBOL_PTR
    # => [role_symbol, pad(15)]

    call.rbac::renounce_role
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end
