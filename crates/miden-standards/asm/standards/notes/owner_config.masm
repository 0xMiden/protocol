use miden::protocol::active_note
use miden::standards::access::ownable2step

# CONSTANTS
# =================================================================================================

# Memory base at which the note storage is written by `active_note::get_storage`.
const STORAGE_PTR = 0

# Memory addresses of the OwnerConfig note storage.
const SELECTOR_PTR = STORAGE_PTR
const NEW_OWNER_SUFFIX_PTR = STORAGE_PTR + 1
const NEW_OWNER_PREFIX_PTR = STORAGE_PTR + 2

# Action selectors, stored in the first storage item. Keep in sync with `OwnerConfig` on the Rust
# side.
const SELECTOR_TRANSFER_OWNERSHIP = 0
const SELECTOR_ACCEPT_OWNERSHIP = 1
const SELECTOR_RENOUNCE_OWNERSHIP = 2

# Expected note storage item count per action.
const NUM_ITEMS_TRANSFER_OWNERSHIP = 3
const NUM_ITEMS_ACCEPT_OWNERSHIP = 1
const NUM_ITEMS_RENOUNCE_OWNERSHIP = 1

# ERRORS
# =================================================================================================

const ERR_OWNER_CONFIG_UNKNOWN_SELECTOR = "owner config note selector does not match a known action"

const ERR_OWNER_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "owner config note storage item count does not match the selected action"

# NOTE SCRIPT
# =================================================================================================

#! OwnerConfig script: triggers an `Ownable2Step` management action against the consuming account,
#! dispatched on a selector stored in the first note storage item.
#!
#! The selected action and its arguments are read from the note storage (fixed at note creation,
#! so authorization is bound to the note sender):
#! - `0` TransferOwnership: `[0, new_owner_suffix, new_owner_prefix]`. A new owner of `(0, 0)`
#!   cancels any pending nomination.
#! - `1` AcceptOwnership:   `[1]`.
#! - `2` RenounceOwnership: `[2]`.
#!
#! All authorization is enforced by the called `Ownable2Step` procedures against the note sender
#! (`active_note::get_sender`); this script only loads the arguments and calls them.
#!
#! Requires that the account exposes:
#! - `miden::standards::access::ownable2step::{transfer_ownership, accept_ownership,
#!   renounce_ownership}` (the `Ownable2Step` component).
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the selector is not a known action.
#! - the number of storage items does not match the selected action.
#! - the note sender is not authorized for the selected action (per the `Ownable2Step` procedures).
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # write the note storage to memory starting at STORAGE_PTR
    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_storage_items]

    mem_load.SELECTOR_PTR
    # => [selector, num_storage_items]

    # dispatch on the selector to the matching action procedure
    dup eq.SELECTOR_TRANSFER_OWNERSHIP
    # => [is_transfer, selector, num_storage_items]

    if.true
        drop
        # => [num_storage_items]

        exec.execute_transfer_ownership
    else
        dup eq.SELECTOR_ACCEPT_OWNERSHIP
        # => [is_accept, selector, num_storage_items]

        if.true
            drop
            # => [num_storage_items]

            exec.execute_accept_ownership
        else
            eq.SELECTOR_RENOUNCE_OWNERSHIP assert.err=ERR_OWNER_CONFIG_UNKNOWN_SELECTOR
            # => [num_storage_items]

            exec.execute_renounce_ownership
        end
    end
    # => [pad(16)]
end

# HELPER PROCEDURES
# =================================================================================================

#! Executes the TransferOwnership action: nominates a new owner (or cancels a pending nomination
#! when the stored new owner is the zero address).
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_TRANSFER_OWNERSHIP.
#! - the note sender is not the owner (per `ownable2step::transfer_ownership`).
#!
#! Invocation: exec
proc execute_transfer_ownership
    eq.NUM_ITEMS_TRANSFER_OWNERSHIP
    assert.err=ERR_OWNER_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # pad to the `transfer_ownership` input window [new_owner_suffix, new_owner_prefix, pad(14)]
    padw padw padw push.0.0
    mem_load.NEW_OWNER_PREFIX_PTR
    mem_load.NEW_OWNER_SUFFIX_PTR
    # => [new_owner_suffix, new_owner_prefix, pad(14)]

    call.ownable2step::transfer_ownership
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Executes the AcceptOwnership action: the nominated owner accepts the pending transfer.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_ACCEPT_OWNERSHIP.
#! - the note sender is not the nominated owner (per `ownable2step::accept_ownership`).
#!
#! Invocation: exec
proc execute_accept_ownership
    eq.NUM_ITEMS_ACCEPT_OWNERSHIP
    assert.err=ERR_OWNER_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # pad to the empty `accept_ownership` input window [pad(16)]
    padw padw padw padw
    # => [pad(16)]

    call.ownable2step::accept_ownership
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Executes the RenounceOwnership action: the owner renounces ownership.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_RENOUNCE_OWNERSHIP.
#! - the note sender is not the owner (per `ownable2step::renounce_ownership`).
#!
#! Invocation: exec
proc execute_renounce_ownership
    eq.NUM_ITEMS_RENOUNCE_OWNERSHIP
    assert.err=ERR_OWNER_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # pad to the empty `renounce_ownership` input window [pad(16)]
    padw padw padw padw
    # => [pad(16)]

    call.ownable2step::renounce_ownership
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end
