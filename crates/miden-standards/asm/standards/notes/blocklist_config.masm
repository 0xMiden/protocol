use miden::protocol::active_note
use miden::standards::attachments::network_account_target
use miden::standards::faucets::policies::transfer::blocklist::manager

# CONSTANTS
# =================================================================================================

# Memory base at which the note storage is written by `active_note::get_storage`.
const STORAGE_PTR = 0

# Memory addresses of the BlocklistConfig note storage. Both actions carry the same arguments: the
# ID of the account being blocked or unblocked.
const SELECTOR_PTR = STORAGE_PTR
const ACCOUNT_SUFFIX_PTR = STORAGE_PTR + 1
const ACCOUNT_PREFIX_PTR = STORAGE_PTR + 2

# Config note selectors, stored in the first storage item. Keep in sync with `BlocklistConfig` on
# the Rust side.
const SELECTOR_BLOCK_ACCOUNT = 0
const SELECTOR_UNBLOCK_ACCOUNT = 1

# Expected note storage item count per action.
const NUM_ITEMS_BLOCK_ACCOUNT = 3
const NUM_ITEMS_UNBLOCK_ACCOUNT = 3

# ERRORS
# =================================================================================================

const ERR_BLOCKLIST_CONFIG_TARGET_ACCOUNT_MISMATCH = "blocklist config note attachment target account does not match the consuming account"

const ERR_BLOCKLIST_CONFIG_UNKNOWN_SELECTOR = "blocklist config note selector does not match a known action"

const ERR_BLOCKLIST_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "blocklist config note storage item count does not match the selected action"

# NOTE SCRIPT
# =================================================================================================

#! BlocklistConfig script: triggers a `BlocklistManager` admin action against the consuming
#! account, dispatched on a selector stored in the first note storage item.
#!
#! The selected action and its arguments are read from the note storage and are fixed at note
#! creation:
#! - `0` BlockAccount:   `[0, account_suffix, account_prefix]`.
#! - `1` UnblockAccount: `[1, account_suffix, account_prefix]`.
#!
#! Authorization is enforced by the called `BlocklistManager` procedures via the account-wide
#! `Authority` component (`assert_authorized`); this script only loads the arguments and calls
#! them.
#!
#! Requires that the account exposes:
#! - `miden::standards::faucets::policies::transfer::blocklist::manager::{block_account,
#!   unblock_account}` (the `BlocklistManager` component), backed by the `Authority` component and
#!   a component that installs the `blocked_accounts` storage slot (typically `BasicBlocklist`).
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the consuming account is not the note's target account, or the target attachment is missing.
#! - the selector is not a known action.
#! - the number of storage items does not match the selected action.
#! - the caller is not authorized for the selected action per the installed `Authority` component.
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # bind consumption to the targeted account: reject if the consuming account is not the note's
    # target account
    exec.network_account_target::active_account_matches_target_account
    assert.err=ERR_BLOCKLIST_CONFIG_TARGET_ACCOUNT_MISMATCH
    # => [pad(16)]

    # write the note storage to memory starting at STORAGE_PTR
    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_storage_items]

    mem_load.SELECTOR_PTR
    # => [selector, num_storage_items]

    # dispatch on the selector to the matching action procedure
    dup eq.SELECTOR_BLOCK_ACCOUNT
    # => [is_block, selector, num_storage_items]

    if.true
        drop
        # => [num_storage_items]

        exec.execute_block_account
    else
        eq.SELECTOR_UNBLOCK_ACCOUNT assert.err=ERR_BLOCKLIST_CONFIG_UNKNOWN_SELECTOR
        # => [num_storage_items]

        exec.execute_unblock_account
    end
    # => [pad(16)]
end

# HELPER PROCEDURES
# =================================================================================================

#! Executes the BlockAccount action: adds the stored account to the blocklist.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_BLOCK_ACCOUNT.
#! - the caller is not authorized per the installed `Authority` component.
#!
#! Invocation: exec
proc execute_block_account
    eq.NUM_ITEMS_BLOCK_ACCOUNT
    assert.err=ERR_BLOCKLIST_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # build the `block_account` input window: [account_suffix, account_prefix, pad(14)]
    padw padw padw push.0.0
    mem_load.ACCOUNT_PREFIX_PTR
    mem_load.ACCOUNT_SUFFIX_PTR
    # => [account_suffix, account_prefix, pad(14)]

    call.manager::block_account
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Executes the UnblockAccount action: removes the stored account from the blocklist.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_UNBLOCK_ACCOUNT.
#! - the caller is not authorized per the installed `Authority` component.
#!
#! Invocation: exec
proc execute_unblock_account
    eq.NUM_ITEMS_UNBLOCK_ACCOUNT
    assert.err=ERR_BLOCKLIST_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # build the `unblock_account` input window: [account_suffix, account_prefix, pad(14)]
    padw padw padw push.0.0
    mem_load.ACCOUNT_PREFIX_PTR
    mem_load.ACCOUNT_SUFFIX_PTR
    # => [account_suffix, account_prefix, pad(14)]

    call.manager::unblock_account
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end
