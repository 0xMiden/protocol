use {MetadataStringCommitment} from miden::standards::faucets
use {NoteArgs} from miden::protocol::types
use miden::core::crypto::hashes::eidos
use miden::protocol::active_note
use miden::standards::faucets
use miden::standards::faucets::fungible
use miden::standards::faucets::non_fungible::token_base_uri
use miden::standards::note::note_target

# CONSTANTS
# =================================================================================================

# Memory base at which the note storage is written by `active_note::get_bounded_storage`.
const STORAGE_PTR = 0

# Memory addresses of the FaucetMetadataConfig note storage. The variant is one felt padded out to
# a full word with three zeros, so the 7-Word string payload of the metadata actions starts
# word-aligned, as `eidos::hash_elements` requires.
const VARIANT_PTR = STORAGE_PTR
const MAX_SUPPLY_PTR = STORAGE_PTR + 1
const STRING_PTR = STORAGE_PTR + 4
const STRING_END_PTR = STORAGE_PTR + 32
const STRING_FULL_BLOCK_END_PTR = STRING_PTR + 24
const STRING_PARTIAL_BLOCK_NUM_ELEMENTS = 4

const STRING_INIT_CV = [
    13503953893947607553,
    11912009168875159580,
    11170449401267093504,
    6620516959492505600
]

# Config note variants, stored in the first storage item. Keep in sync with
# `FaucetMetadataConfig` on the Rust side.
const VARIANT_SET_MAX_SUPPLY = 0
const VARIANT_SET_DESCRIPTION = 1
const VARIANT_SET_LOGO_URI = 2
const VARIANT_SET_EXTERNAL_URI = 3
const VARIANT_SET_TOKEN_BASE_URI = 4

# Expected note storage item count per action.
const NUM_ITEMS_SET_MAX_SUPPLY = 2
const NUM_ITEMS_SET_STRING = 32

# Largest storage item count any action uses
const MAX_NUM_ITEMS = NUM_ITEMS_SET_STRING

# ERRORS
# =================================================================================================

const ERR_FAUCET_METADATA_CONFIG_UNKNOWN_VARIANT = "faucet metadata config note variant does not match a known action"

const ERR_FAUCET_METADATA_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "faucet metadata config note storage item count does not match the selected action"

const ERR_FAUCET_METADATA_CONFIG_NOTE_IS_NOT_PUBLIC = "faucet metadata config note must be public"

# NOTE SCRIPT
# =================================================================================================

#! FaucetMetadataConfig script: triggers a token metadata admin action against the consuming
#! faucet, dispatched on the note variant in its storage.
#!
#! The description, logo URI and external URI setters live in the shared
#! `miden::standards::faucets` module, which both the `FungibleFaucet` and `NonFungibleFaucet`
#! components re-export, so those variants work on either kind of faucet. The two remaining
#! variants are bound to one faucet kind: `SetMaxSupply` calls
#! `miden::standards::faucets::fungible::set_max_supply`, which a non-fungible faucet does not
#! expose, and `SetTokenBaseUri` calls
#! `miden::standards::faucets::non_fungible::token_base_uri::set_token_base_uri`, which a fungible
#! faucet does not expose. Each aborts on the other kind of faucet.
#!
#! The selected action and its arguments are read from the note storage and are fixed at note
#! creation:
#! - `0` SetMaxSupply:     `[0, new_max_supply]`.
#! - `1` SetDescription:   `[1, 0, 0, 0, description(28)]`.
#! - `2` SetLogoUri:       `[2, 0, 0, 0, logo_uri(28)]`.
#! - `3` SetExternalUri:   `[3, 0, 0, 0, external_uri(28)]`.
#! - `4` SetTokenBaseUri:  `[4, 0, 0, 0, token_base_uri(28)]`.
#!
#! The four string setters take the Eidos commitment of their new value on the operand stack
#! and read the preimage from the advice map. This script commits to the payload `get_bounded_storage` wrote
#! to memory and inserts it into the advice map under that commitment, so the value is bound into
#! the note commitment through the note storage and needs no out-of-band advice inputs.
#!
#! Authorization is enforced by the called setters via the account-wide `Authority` component
#! (`assert_authorized`); this script only loads the arguments and calls them.
#!
#! Requires that the account exposes:
#! - `miden::standards::faucets::{set_description, set_logo_uri, set_external_uri}` for the shared
#!   string actions, `miden::standards::faucets::fungible::set_max_supply` for `SetMaxSupply`, and
#!   `miden::standards::faucets::non_fungible::token_base_uri::set_token_base_uri` for
#!   `SetTokenBaseUri`, backed by the `Authority` and `Pausable` companion components.
#!
#! Consumers: target account (attachment)
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note is not public.
#! - the consuming account is not the note's target account, or the target attachment is missing.
#! - the number of storage items exceeds MAX_NUM_ITEMS.
#! - the variant is not a known action.
#! - the number of storage items does not match the selected action.
#! - the selected field's mutability flag is not set, or the account is paused.
#! - the selected action is `SetTokenBaseUri` and the faucet's token metadata is private.
#! - the caller is not authorized for the selected action per the installed `Authority` component.
@note_script
pub proc main(args: NoteArgs)
    dropw
    # => [pad(16)]

    exec.active_note::is_public
    assert.err=ERR_FAUCET_METADATA_CONFIG_NOTE_IS_NOT_PUBLIC
    # => [pad(16)]

    # bind consumption to the targeted account: reject if the consuming account is not the note's
    # target account
    exec.note_target::assert_active_account_is_network_target_account
    # => [pad(16)]

    # write the note storage to memory starting at STORAGE_PTR
    push.MAX_NUM_ITEMS push.STORAGE_PTR exec.active_note::get_bounded_storage
    # => [num_storage_items]

    mem_load.VARIANT_PTR
    # => [variant, num_storage_items]

    # dispatch on the variant to the matching action procedure
    dup eq.VARIANT_SET_MAX_SUPPLY
    # => [is_set_max_supply, variant, num_storage_items]

    if.true
        drop
        # => [num_storage_items]

        exec.execute_set_max_supply
    else
        dup eq.VARIANT_SET_DESCRIPTION
        # => [is_set_description, variant, num_storage_items]

        if.true
            drop
            # => [num_storage_items]

            exec.execute_set_description
        else
            dup eq.VARIANT_SET_LOGO_URI
            # => [is_set_logo_uri, variant, num_storage_items]

            if.true
                drop
                # => [num_storage_items]

                exec.execute_set_logo_uri
            else
                dup eq.VARIANT_SET_EXTERNAL_URI
                # => [is_set_external_uri, variant, num_storage_items]

                if.true
                    drop
                    # => [num_storage_items]

                    exec.execute_set_external_uri
                else
                    eq.VARIANT_SET_TOKEN_BASE_URI
                    assert.err=ERR_FAUCET_METADATA_CONFIG_UNKNOWN_VARIANT
                    # => [num_storage_items]

                    exec.execute_set_token_base_uri
                end
            end
        end
    end
    # => [pad(16)]
end

# HELPER PROCEDURES
# =================================================================================================

#! Executes the SetMaxSupply action: sets the faucet's maximum supply.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_SET_MAX_SUPPLY.
#! - the max supply mutability flag is not set, the account is paused, the new cap exceeds the
#!   maximum representable fungible asset amount, or it is below the current token supply (per
#!   `fungible::set_max_supply`).
#!
#! Invocation: exec
proc execute_set_max_supply(num_storage_items: u32)
    eq.NUM_ITEMS_SET_MAX_SUPPLY
    assert.err=ERR_FAUCET_METADATA_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # build the `set_max_supply` input window: [new_max_supply, pad(15)]
    padw padw padw push.0.0.0
    mem_load.MAX_SUPPLY_PTR
    # => [new_max_supply, pad(15)]

    call.fungible::set_max_supply
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Builds the input window the three string setters expect: pads the stack, commits to the stored
#! string payload, and inserts the payload into the advice map under that commitment so the called
#! setter can pipe it back out.
#!
#! The commitment uses the Eidos Felt-sequence encoding expected by
#! `mem::pipe_preimage_to_memory` inside the setter.
#!
#! Inputs:
#!   Operand stack: [num_storage_items]
#! Outputs:
#!   Operand stack: [STRING_COMMITMENT, pad(12)]
#!   Advice map:    { STRING_COMMITMENT: [string_elements] }
#!
#! Where:
#! - string_elements are the 28 felts (7 Words) encoding the new metadata string.
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_SET_STRING.
#!
#! Invocation: exec
proc prepare_string_call(num_storage_items: u32) -> (MetadataStringCommitment, [felt; 12])
    eq.NUM_ITEMS_SET_STRING
    assert.err=ERR_FAUCET_METADATA_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # pad the window the setter expects below the commitment
    padw padw padw
    # => [pad(12)]

    push.STRING_PARTIAL_BLOCK_NUM_ELEMENTS push.STRING_FULL_BLOCK_END_PTR push.STRING_PTR
    push.STRING_INIT_CV padw padw
    exec.eidos::hash_elements_with_state
    # => [STRING_COMMITMENT, pad(12)]

    push.STRING_END_PTR push.STRING_PTR
    movdn.5 movdn.5
    # => [STRING_COMMITMENT, start_ptr, end_ptr, pad(12)]

    adv.insert_mem
    # OS => [STRING_COMMITMENT, start_ptr, end_ptr, pad(12)]
    # AM => { STRING_COMMITMENT: mem[STRING_PTR..STRING_END_PTR] }

    movup.4 drop movup.4 drop
    # => [STRING_COMMITMENT, pad(12)]
end

#! Executes the SetDescription action: sets the faucet's token description.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_SET_STRING.
#! - the description mutability flag is not set, or the account is paused (per
#!   `faucets::set_description`).
#!
#! Invocation: exec
proc execute_set_description(num_storage_items: u32)
    exec.prepare_string_call
    # => [DESCRIPTION_COMMITMENT, pad(12)]

    call.faucets::set_description
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Executes the SetLogoUri action: sets the faucet's token logo URI.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_SET_STRING.
#! - the logo URI mutability flag is not set, or the account is paused (per
#!   `faucets::set_logo_uri`).
#!
#! Invocation: exec
proc execute_set_logo_uri(num_storage_items: u32)
    exec.prepare_string_call
    # => [LOGO_URI_COMMITMENT, pad(12)]

    call.faucets::set_logo_uri
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Executes the SetExternalUri action: sets the faucet's token external URI.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_SET_STRING.
#! - the external URI mutability flag is not set, or the account is paused (per
#!   `faucets::set_external_uri`).
#!
#! Invocation: exec
proc execute_set_external_uri(num_storage_items: u32)
    exec.prepare_string_call
    # => [EXTERNAL_URI_COMMITMENT, pad(12)]

    call.faucets::set_external_uri
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Executes the SetTokenBaseUri action: sets the non-fungible faucet's token base URI.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_SET_STRING.
#! - the token base URI mutability flag is not set, the account is paused, or the faucet's token
#!   metadata is private (per `token_base_uri::set_token_base_uri`).
#!
#! Invocation: exec
proc execute_set_token_base_uri(num_storage_items: u32)
    exec.prepare_string_call
    # => [TOKEN_BASE_URI_COMMITMENT, pad(12)]

    call.token_base_uri::set_token_base_uri
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end
