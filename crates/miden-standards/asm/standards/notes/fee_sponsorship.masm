use miden::core::word

use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::tx

use miden::standards::note::note_id
use miden::standards::wallets::basic as basic_wallet

# CONSTANTS
# =================================================================================================

#! The memory address at which the note storage is written.
const STORAGE_PTR = 0

# Note storage layout (7 items, loaded at STORAGE_PTR by get_storage):
# - FEATURE_NOTE_ID       [0..3] : ID of the feature note this sponsorship pays for
# - reclaimer_suffix      [4]    : suffix of the account allowed to reclaim the note
# - reclaimer_prefix      [5]    : prefix of the account allowed to reclaim the note
# - reclaim_block_height  [6]    : block height at or after which the reclaimer may reclaim (0 = disabled)
const FEATURE_NOTE_ID_ITEM = STORAGE_PTR
const RECLAIMER_SUFFIX_ITEM = STORAGE_PTR + 4
const RECLAIMER_PREFIX_ITEM = STORAGE_PTR + 5
const RECLAIM_HEIGHT_ITEM = STORAGE_PTR + 6

#! The number of storage items of a FEE_SPONSORSHIP note.
const NUM_STORAGE_ITEMS = 7

#! Local memory offset at which is_bound_feature_note_present stages the bound note ID.
const BOUND_NOTE_ID_LOC = 0

# ERRORS
# =================================================================================================

const ERR_FEE_SPONSORSHIP_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "FEE_SPONSORSHIP note expects exactly 7 note storage items"

const ERR_FEE_SPONSORSHIP_RECLAIM_DISABLED = "FEE_SPONSORSHIP reclaim is disabled"

const ERR_FEE_SPONSORSHIP_RECLAIM_HEIGHT_NOT_REACHED = "failed to reclaim FEE_SPONSORSHIP note because the reclaim block height is not reached yet"

const ERR_FEE_SPONSORSHIP_RECLAIM_ACCT_IS_NOT_RECLAIMER = "failed to reclaim FEE_SPONSORSHIP note because the reclaiming account is not the reclaimer"

# HELPER PROCEDURES
# =================================================================================================

#! Returns whether the feature note bound by the note storage is among the transaction's input
#! notes.
#!
#! This check is what stops a sponsorship note from being consumed on its own. It lives in the
#! note's own script rather than in the consuming account, because the sponsor trusts neither the
#! consuming account nor the transaction builder; they do, however, choose the note's script root.
#!
#! Every input note's ID is recomputed and compared against the bound ID. No index hint is taken
#! from the note arguments: those are chosen by the consumer, and an incorrect hint would revert a
#! transaction whose feature note is in fact present, handing the builder a griefing vector.
#!
#! Inputs:  [FEATURE_NOTE_ID]
#! Outputs: [is_found]
#!
#! Where:
#! - FEATURE_NOTE_ID is the ID of the feature note to look for.
#! - is_found is 1 if the feature note is among the transaction's input notes, 0 otherwise.
@locals(4)
proc is_bound_feature_note_present
    loc_storew_le.BOUND_NOTE_ID_LOC dropw
    # => []

    push.0
    # => [is_found]

    exec.tx::get_num_input_notes
    # => [note_idx, is_found]

    dup neq.0
    # => [should_loop, note_idx, is_found]

    while.true
        sub.1
        # => [note_idx, is_found]

        dup exec.note_id::compute_input_note_id
        # => [NOTE_ID, note_idx, is_found]

        padw loc_loadw_le.BOUND_NOTE_ID_LOC
        # => [BOUND_NOTE_ID, NOTE_ID, note_idx, is_found]

        exec.word::eq
        # => [is_match, note_idx, is_found]

        movup.2 or
        # => [is_found, note_idx]

        swap
        # => [note_idx, is_found]

        dup neq.0
        # => [should_loop, note_idx, is_found]
    end
    # => [note_idx, is_found]

    drop
    # => [is_found]
end

#! Returns the sponsorship assets to the reclaimer, provided reclaim is enabled and its block height
#! has been reached.
#!
#! Inputs:  [reclaim_block_height, reclaimer_id_suffix, reclaimer_id_prefix]
#! Outputs: []
#!
#! Where:
#! - reclaim_block_height is the block height at or after which the reclaimer may reclaim the note.
#!   A value of 0 means reclaim is disabled.
#! - reclaimer_id_{suffix,prefix} are the suffix and prefix felts of the account ID allowed to
#!   reclaim the note.
#!
#! Panics if:
#! - reclaim is disabled.
#! - the reclaim block height has not been reached.
#! - the active account is not the note's reclaimer.
proc reclaim_note
    dup neq.0 assert.err=ERR_FEE_SPONSORSHIP_RECLAIM_DISABLED
    # => [reclaim_block_height, reclaimer_id_suffix, reclaimer_id_prefix]

    exec.tx::get_block_number
    # => [current_block_height, reclaim_block_height, reclaimer_id_suffix, reclaimer_id_prefix]

    lte assert.err=ERR_FEE_SPONSORSHIP_RECLAIM_HEIGHT_NOT_REACHED
    # => [reclaimer_id_suffix, reclaimer_id_prefix]

    exec.active_account::get_id
    # => [account_id_suffix, account_id_prefix, reclaimer_id_suffix, reclaimer_id_prefix]

    exec.account_id::eq assert.err=ERR_FEE_SPONSORSHIP_RECLAIM_ACCT_IS_NOT_RECLAIMER
    # => []

    exec.basic_wallet::add_assets_to_account
    # => []
end

# NOTE SCRIPT
# =================================================================================================

#! FEE_SPONSORSHIP script: verifies that the feature note this note sponsors is consumed by the
#! same transaction, leaving the note's assets in place; otherwise it attempts a reclaim.
#!
#! The note carries the fee for exactly one feature note, named by the note ID in its storage. The
#! feature note itself stays entirely fee-unaware, and the sponsorship carries no attachments.
#!
#! The note does not restrict who may consume it; it only requires the bound feature note to be
#! consumed alongside it. Consumption rights are thereby inherited from the feature note: whoever
#! may consume the feature note may take its sponsorship in the same transaction.
#!
#! The sponsorship and the feature note it sponsors must be consumed together. Two checks enforce
#! this, and each sits with the party it protects:
#! - Consuming the sponsorship without its feature note costs the *sponsor*, so this script rejects
#!   it.
#! - Consuming a feature note without sponsorship costs the *account*, so the account's auth
#!   procedure rejects that. It is not this script's concern.
#!
#! On the sponsorship path the script leaves the note's assets untouched: collecting them is the
#! consuming account's job (for a network account, typically its auth procedure). This keeps the
#! note free of any wallet-interface requirement on the account it sponsors.
#!
#! If the note is never consumed alongside its feature note, the reclaimer may reclaim it once the
#! reclaim block height is reached. Once the bound feature note is consumed by some other
#! transaction, the presence check can never pass again and reclaim is the only way to recover the
#! assets. The reclaimer is named in the note storage; the creator sets it, defaulting to the
#! sender.
#!
#! Only the reclaim path moves assets, so only reclaiming requires that the consuming account
#! exposes:
#! - miden::standards::wallets::basic::receive_asset procedure.
#!
#! Inputs:  [NOTE_ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - NOTE_ARGS are the note arguments, which this script ignores.
#!
#! Note storage is assumed to be as follows:
#! - FEATURE_NOTE_ID is the ID of the feature note this sponsorship pays for.
#! - reclaimer_{suffix, prefix} identify the account allowed to reclaim the note.
#! - reclaim_block_height is the block height at or after which the reclaimer may reclaim the note,
#!   or 0 if reclaim is disabled.
#!
#! Panics if:
#! - the number of note storage items is not 7.
#! - the bound feature note is not consumed by this transaction, and the note cannot be reclaimed
#!   (reclaim is disabled, the reclaim block height is not reached, or the active account is not
#!   the reclaimer).
#! - the note is reclaimed and the reclaiming account does not expose the
#!   miden::standards::wallets::basic::receive_asset procedure.
@note_script
pub proc main
    dropw
    # => [pad(16)]

    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_storage_items, pad(16)]

    eq.NUM_STORAGE_ITEMS assert.err=ERR_FEE_SPONSORSHIP_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => [pad(16)]

    padw mem_loadw_le.FEATURE_NOTE_ID_ITEM
    # => [FEATURE_NOTE_ID, pad(16)]

    exec.is_bound_feature_note_present
    # => [is_present, pad(16)]

    # with the feature note present, the sponsorship path is a no-op: the assets stay in the note
    # for the consuming account to collect, and who may get here is decided by the feature note's
    # own consumption rules. Invert the flag so the branch below handles the absent case (reclaim).
    not
    # => [is_absent, pad(16)]

    if.true
        # reclaim path: without the feature note the assets may only return to the reclaimer named
        # in the note storage
        mem_load.RECLAIMER_PREFIX_ITEM mem_load.RECLAIMER_SUFFIX_ITEM mem_load.RECLAIM_HEIGHT_ITEM
        # => [reclaim_block_height, reclaimer_id_suffix, reclaimer_id_prefix, pad(16)]

        exec.reclaim_note
        # => [pad(16)]
    end
    # => [pad(16)]
end
