use miden::protocol::active_note
use miden::standards::attachments::network_account_target
use miden::standards::fees::policies::constant_fee_manager

# CONSTANTS
# =================================================================================================

# Memory base at which the note storage is written by `active_note::get_bounded_storage`.
const STORAGE_PTR = 0

# Memory addresses of the ConstantFeePolicyConfig note storage: the note script root word
# (offsets 0..4), followed by the fee asset as its ID word (offsets 4..8) and value word
# (offsets 8..12).
const SCRIPT_ROOT_PTR = STORAGE_PTR
const FEE_ASSET_ID_PTR = STORAGE_PTR + 4
const FEE_ASSET_VALUE_PTR = STORAGE_PTR + 8

# Expected note storage item count: the note script root word plus the fee asset (ID and value).
const NUM_STORAGE_ITEMS = 12

# ERRORS
# =================================================================================================

const ERR_CONSTANT_FEE_POLICY_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "constant fee policy config note storage item count is not the expected count"

const ERR_CONSTANT_FEE_POLICY_CONFIG_ACCOUNT_MISMATCH = "constant fee policy config note is not targeted at the consuming account"

const ERR_CONSTANT_FEE_POLICY_CONFIG_NOTE_IS_NOT_PUBLIC = "constant fee policy config note must be public"

# NOTE SCRIPT
# =================================================================================================

#! ConstantFeePolicyConfig script: schedules a fee for a note script root against the consuming
#! account by calling the `ConstantFeeManager`'s `set_note_fee` procedure.
#!
#! The note script root and fee asset are read from the note storage and are fixed at note creation:
#! - `[NOTE_SCRIPT_ROOT, FEE_ASSET_ID, FEE_ASSET_VALUE]`.
#!
#! The note is bound to a specific target account by a `NetworkAccountTarget` attachment: this
#! script asserts the consuming account matches that target before doing anything else, so the note
#! cannot be consumed by any other account that happens to accept its sender.
#!
#! Authorization is enforced by the called `set_note_fee` procedure via the account-wide
#! `Authority` component; this script only forwards the stored payload to it. The fee asset's ID
#! must match the account's configured fee asset ID (also enforced by `set_note_fee`).
#!
#! Requires that the consuming account:
#! - exposes `miden::standards::fees::policies::constant_fee_manager::set_note_fee`, installed on an
#!   `AuthNetworkAccount` whose active fee policy is a constant-fee policy, backed by an `Authority`
#!   companion component gating `set_note_fee` to the owner or a role.
#! - allowlists this note's own script root and already has a set-marked fee schedule entry for it,
#!   so the network account can price and consume this note.
#!
#! Consumption is restricted to public notes: the management action must remain publicly auditable,
#! so a private note carrying the same script and storage is rejected.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note is not public.
#! - the note is missing its `NetworkAccountTarget` attachment or carries a malformed one (e.g. a
#!   hand-crafted note reusing this script), or the consuming account is not the target account.
#! - the number of storage items is not NUM_STORAGE_ITEMS.
#! - the caller is not authorized per the installed `Authority` component, or the fee asset ID does
#!   not match (per `set_note_fee`).
@note_script
pub proc main
    # drop the note script args
    dropw
    # => [pad(16)]

    # restrict consumption to public notes: the management action must remain publicly auditable
    exec.active_note::is_public
    assert.err=ERR_CONSTANT_FEE_POLICY_CONFIG_NOTE_IS_NOT_PUBLIC
    # => [pad(16)]

    # assert the consuming account is the account the note is targeted at, so it cannot be consumed
    # and by an unrelated account (the note's `set_note_fee` call only checks the sender)
    exec.network_account_target::active_account_matches_target_account
    assert.err=ERR_CONSTANT_FEE_POLICY_CONFIG_ACCOUNT_MISMATCH
    # => [pad(16)]

    # write the note storage to memory starting at STORAGE_PTR
    push.NUM_STORAGE_ITEMS push.STORAGE_PTR exec.active_note::get_bounded_storage
    # => [num_storage_items, pad(16)]

    eq.NUM_STORAGE_ITEMS
    assert.err=ERR_CONSTANT_FEE_POLICY_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => [pad(16)]

    # rebuild the `set_note_fee` input [NOTE_SCRIPT_ROOT, FEE_ASSET_ID, FEE_ASSET_VALUE, pad(4)]
    mem_loadw_le.FEE_ASSET_VALUE_PTR movdnw.2
    mem_loadw_le.FEE_ASSET_ID_PTR swapw
    mem_loadw_le.SCRIPT_ROOT_PTR
    # => [NOTE_SCRIPT_ROOT, FEE_ASSET_ID, FEE_ASSET_VALUE, pad(4)]

    call.constant_fee_manager::set_note_fee
    # => [pad(16)]
end
