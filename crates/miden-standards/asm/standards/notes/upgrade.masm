use miden::protocol::active_note
use miden::standards::extensions::account_upgrade

# CONSTANTS
# =================================================================================================

#! Memory base at which the note storage is written by `active_note::get_storage`.
const STORAGE_PTR = 0

#! Memory addresses of the Upgrade note storage
const CODE_COMMITMENT_PTR = STORAGE_PTR + 0
const STORAGE_COMMITMENT_PTR = STORAGE_PTR + 4

#! Expected note storage item count: the two commitment words.
const NUM_STORAGE_ITEMS = 8

# ERRORS
# =================================================================================================

const ERR_UPGRADE_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS =
    "upgrade note storage item count does not match the expected count"

# NOTE SCRIPT
# =================================================================================================

#! Invokes the `upgrade_manager::upgrade` procedure on the consuming account, recording the code
#! and storage upgrade commitments carried in the note storage.
#!
#! Authorization is enforced by the called `upgrade` procedure via the account-wide `Authority`
#! component.
#!
#! Requires that the account exposes:
#! - `miden::standards::extensions::account_upgrade::upgrade`.
#!
#! Inputs:  [NOTE_ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the number of storage items does not match the expected count.
#! - the note sender is not authorized (per the `Authority` component).
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # write the note storage to memory starting at STORAGE_PTR
    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_storage_items, pad(16)]

    eq.NUM_STORAGE_ITEMS
    assert.err=ERR_UPGRADE_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => [pad(16)]

    mem_loadw_le.STORAGE_COMMITMENT_PTR
    swapw
    mem_loadw_le.CODE_COMMITMENT_PTR
    # => [CODE_UPGRADE_COMMITMENT, STORAGE_UPGRADE_COMMITMENT, pad(8)]

    call.account_upgrade::upgrade
    # => [pad(16)]
end
