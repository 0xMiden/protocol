use miden::standards::faucets::fungible as fungible
use miden::standards::faucets::non_fungible as non_fungible
use miden::standards::inspection::code_inspection
use miden::standards::notes::mint_fungible
use miden::standards::notes::mint_non_fungible

# ERRORS
# =================================================================================================

const ERR_MINT_UNSUPPORTED_FAUCET = "the consuming account exposes neither a fungible nor a non-fungible faucet mint_and_send procedure"

#! MINT script: mints the asset stored in the note by calling the consuming faucet's
#! `mint_and_send` procedure. Works against both fungible and non-fungible faucets.
#!
#! The faucet kind is determined by reflection: the script asks the account (via the
#! `CodeInspection` component's `has_procedure`) whether it exposes the fungible `mint_and_send`;
#! if so the fungible mint path runs (see `mint_fungible`), otherwise the non-fungible path runs
#! (see `mint_non_fungible`) after asserting the account exposes the non-fungible `mint_and_send`.
#!
#! This note is intended to be executed against a network faucet account. Both faucet kinds share
#! the same storage layout, documented on `mint_fungible::mint` and `mint_non_fungible::mint`.
#!
#! Requires that the account exposes:
#! - `miden::standards::inspection::code_inspection::has_procedure` (the `CodeInspection` component).
#! - either `miden::standards::faucets::fungible::mint_and_send` or
#!   `miden::standards::faucets::non_fungible::mint_and_send`.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the account does not expose the `has_procedure` procedure.
#! - the account exposes neither faucet's `mint_and_send` procedure.
#! - the number of storage items does not match the detected faucet kind.
#! - the asset stored in the note does not belong to the consuming faucet.
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # Determine the faucet kind.
    procref.fungible::mint_and_send
    # => [FUNGIBLE_MINT_AND_SEND_ROOT, pad(16)]

    call.code_inspection::has_procedure
    # => [is_fungible, pad(19)]

    movdn.4 dropw
    # => [is_fungible, pad(15)]

    if.true
        exec.mint_fungible::mint
        # => [pad(16)]
    else
        # require that the account exposes the non-fungible mint_and_send.
        procref.non_fungible::mint_and_send
        # => [NON_FUNGIBLE_MINT_AND_SEND_ROOT, pad(16)]

        call.code_inspection::has_procedure
        # => [is_non_fungible, pad(19)]

        movdn.4 dropw
        # => [is_non_fungible, pad(15)]

        assert.err=ERR_MINT_UNSUPPORTED_FAUCET
        # => [pad(16)]

        exec.mint_non_fungible::mint
        # => [pad(16)]
    end
    # => [pad(16)]
end
