use miden::protocol::active_note
use miden::protocol::note
use miden::standards::faucets::fungible as fungible
use miden::standards::faucets::non_fungible as non_fungible
use miden::standards::inspection::code_inspection

# CONSTANTS
# =================================================================================================

use {NOTE_TYPE_PUBLIC} from miden::protocol::note
use {NOTE_TYPE_PRIVATE} from miden::protocol::note

# Memory base at which the note storage is written by `active_note::get_storage`. The fungible and
# non-fungible branches are mutually exclusive at runtime, so they reuse the same memory region.
const STORAGE_PTR = 0

# Fungible MINT note storage item counts.
const FUNGIBLE_NUM_STORAGE_ITEMS_PRIVATE = 13
const FUNGIBLE_MIN_NUM_STORAGE_ITEMS_PUBLIC = 20

# Memory addresses of the fungible MINT note storage (private mode, 13 items total).
const FUNGIBLE_PRIVATE_RECIPIENT_PTR = STORAGE_PTR
const FUNGIBLE_PRIVATE_ASSET_ID_PTR = STORAGE_PTR + 4
const FUNGIBLE_PRIVATE_ASSET_VALUE_PTR = STORAGE_PTR + 8
const FUNGIBLE_PRIVATE_TAG_PTR = STORAGE_PTR + 12

# Memory addresses of the fungible MINT note storage (public mode, 20+ items total).
const FUNGIBLE_PUBLIC_SCRIPT_ROOT_PTR = STORAGE_PTR
const FUNGIBLE_PUBLIC_SERIAL_NUM_PTR = STORAGE_PTR + 4
const FUNGIBLE_PUBLIC_ASSET_ID_PTR = STORAGE_PTR + 8
const FUNGIBLE_PUBLIC_ASSET_VALUE_PTR = STORAGE_PTR + 12
const FUNGIBLE_PUBLIC_TAG_PTR = STORAGE_PTR + 16
const FUNGIBLE_PUBLIC_OUTPUT_NOTE_STORAGE_PTR = STORAGE_PTR + 20

# Non-fungible MINT note storage item counts.
const NFT_NUM_STORAGE_ITEMS_PRIVATE = 9
const NFT_MIN_NUM_STORAGE_ITEMS_PUBLIC = 16

# Memory addresses of the non-fungible MINT note storage (private mode, 9 items total).
const NFT_PRIVATE_RECIPIENT_PTR = STORAGE_PTR
const NFT_PRIVATE_ASSET_VALUE_PTR = STORAGE_PTR + 4
const NFT_PRIVATE_TAG_PTR = STORAGE_PTR + 8

# Memory addresses of the non-fungible MINT note storage (public mode, 16+ items total).
const NFT_PUBLIC_SCRIPT_ROOT_PTR = STORAGE_PTR
const NFT_PUBLIC_SERIAL_NUM_PTR = STORAGE_PTR + 4
const NFT_PUBLIC_ASSET_VALUE_PTR = STORAGE_PTR + 8
const NFT_PUBLIC_TAG_PTR = STORAGE_PTR + 12
const NFT_PUBLIC_OUTPUT_NOTE_STORAGE_PTR = STORAGE_PTR + 16

# ERRORS
# =================================================================================================

const ERR_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "fungible MINT script expects exactly 13 storage items for private or 20+ storage items for public output notes"
const ERR_NON_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "non-fungible MINT script expects exactly 9 storage items for private or 16+ storage items for public output notes"
const ERR_MINT_UNSUPPORTED_FAUCET = "the consuming account exposes neither a fungible nor a non-fungible faucet mint_and_send procedure"

#! MINT script: mints the asset stored in the note by calling the consuming faucet's
#! `mint_and_send` procedure. Works against both fungible and non-fungible faucets.
#!
#! The faucet kind is determined by reflection: the script asks the account (via the
#! `CodeInspection` component's `has_procedure`) whether it exposes the fungible `mint_and_send`;
#! if so the fungible mint path runs, otherwise the non-fungible path runs after asserting the
#! account exposes the non-fungible `mint_and_send`.
#!
#! This note is intended to be executed against a network faucet account.
#!
#! Requires that the account exposes:
#! - `miden::standards::inspection::code_inspection::has_procedure` (the `CodeInspection` component).
#! - either `miden::standards::faucets::fungible::mint_and_send` or
#!   `miden::standards::faucets::non_fungible::mint_and_send`.
#!
#! Note storage supports two modes per faucet kind. Depending on the number of note storage items,
#! a private or public output note is created on consumption of the MINT note:
#!
#! Fungible private mode (13 storage items) - creates a private note:
#! - RECIPIENT:   The recipient digest (4 elements, word 0)
#! - ASSET_ID:    The asset ID of the asset to mint (4 elements, word 1)
#! - ASSET_VALUE: The value word of the asset to mint (4 elements, word 2)
#! - tag:         Note tag for the output note (1 element)
#!
#! Fungible public mode (20+ storage items) - creates a public note with variable-length storage:
#! - SCRIPT_ROOT: Script root of the output note (4 elements, word 0)
#! - SERIAL_NUM:  Serial number of the output note (4 elements, word 1)
#! - ASSET_ID:    The asset ID of the asset to mint (4 elements, word 2)
#! - ASSET_VALUE: The value word of the asset to mint (4 elements, word 3)
#! - tag:         Note tag for the output note (1 element)
#! - padding:     3 elements so the variable storage starts at a word boundary
#! - [STORAGE]:   Variable-length storage for the output note (num items = total - 20)
#!
#! Non-fungible private mode (9 storage items) - creates a private note:
#! - RECIPIENT:   The recipient digest (4 elements, word 0)
#! - ASSET_VALUE: The asset commitment `hash(user_data, salt)` (4 elements, word 1)
#! - tag:         Note tag for the output note (1 element)
#!
#! Non-fungible public mode (16+ storage items) - creates a public note with variable-length
#! storage:
#! - SCRIPT_ROOT: Script root of the output note (4 elements, word 0)
#! - SERIAL_NUM:  Serial number of the output note (4 elements, word 1)
#! - ASSET_VALUE: The asset commitment (4 elements, word 2)
#! - tag:         Note tag for the output note (1 element)
#! - padding:     3 elements so the variable storage starts at a word boundary
#! - [STORAGE]:   Variable-length storage for the output note (num items = total - 16)
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the account does not expose the `has_procedure` procedure.
#! - the account exposes neither faucet's `mint_and_send` procedure.
#! - the number of storage items does not match the detected faucet kind (13 / 20+ for fungible,
#!   9 / 16+ for non-fungible).
#! - the asset stored in the note does not belong to the consuming faucet.
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # Determine the faucet kind.
    procref.fungible::mint_and_send
    # => [FUNGIBLE_MINT_AND_SEND_ROOT, pad(16)]

    call.code_inspection::has_procedure
    # => [is_fungible, pad(19)]

    movdn.4 dropw
    # => [is_fungible, pad(15)]

    if.true
        # =========================================================================================
        # FUNGIBLE MINT
        # =========================================================================================

        push.STORAGE_PTR exec.active_note::get_storage
        # => [num_storage_items, pad(16)]

        dup
        # => [num_storage_items, num_storage_items, pad(16)]

        u32assert2.err=ERR_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
        u32gte.FUNGIBLE_MIN_NUM_STORAGE_ITEMS_PUBLIC
        # => [is_public_output_note, num_storage_items, pad(16)]

        if.true
            # public output note creation
            # => [num_storage_items, pad(16)]

            movdn.8
            # => [EMPTY_WORD, EMPTY_WORD, num_storage_items, pad(8)]

            mem_loadw_le.FUNGIBLE_PUBLIC_SCRIPT_ROOT_PTR
            # => [SCRIPT_ROOT, EMPTY_WORD, num_storage_items, pad(8)]

            swapw mem_loadw_le.FUNGIBLE_PUBLIC_SERIAL_NUM_PTR
            # => [SERIAL_NUM, SCRIPT_ROOT, num_storage_items, pad(8)]

            # compute variable length note storage for the output note
            movup.8 sub.FUNGIBLE_MIN_NUM_STORAGE_ITEMS_PUBLIC
            # => [num_output_note_storage, SERIAL_NUM, SCRIPT_ROOT, pad(8)]

            push.FUNGIBLE_PUBLIC_OUTPUT_NOTE_STORAGE_PTR
            # => [storage_ptr, num_output_note_storage, SERIAL_NUM, SCRIPT_ROOT, pad(8)]

            exec.note::compute_and_store_recipient
            # => [RECIPIENT, pad(12)]

            # push note_type and tag, then ASSET_VALUE and ASSET_ID on top
            push.NOTE_TYPE_PUBLIC
            # => [note_type, RECIPIENT, pad(12)]

            mem_load.FUNGIBLE_PUBLIC_TAG_PTR
            # => [tag, note_type, RECIPIENT, pad(12)]

            padw mem_loadw_le.FUNGIBLE_PUBLIC_ASSET_VALUE_PTR
            # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]

            padw mem_loadw_le.FUNGIBLE_PUBLIC_ASSET_ID_PTR
            # => [ASSET_ID, ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]
        else
            # private output note creation

            eq.FUNGIBLE_NUM_STORAGE_ITEMS_PRIVATE assert.err=ERR_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
            # => [pad(16)]

            mem_loadw_le.FUNGIBLE_PRIVATE_RECIPIENT_PTR
            # => [RECIPIENT, pad(12)]

            # push note_type and tag, then ASSET_VALUE and ASSET_ID on top
            push.NOTE_TYPE_PRIVATE
            # => [note_type, RECIPIENT, pad(12)]

            mem_load.FUNGIBLE_PRIVATE_TAG_PTR
            # => [tag, note_type, RECIPIENT, pad(12)]

            padw mem_loadw_le.FUNGIBLE_PRIVATE_ASSET_VALUE_PTR
            # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]

            padw mem_loadw_le.FUNGIBLE_PRIVATE_ASSET_ID_PTR
            # => [ASSET_ID, ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]
        end
        # => [ASSET_ID, ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]

        call.fungible::mint_and_send
        # => [note_idx, pad(25)]

        dropw dropw drop drop
        # => [pad(16)]
    else
        # =========================================================================================
        # NON-FUNGIBLE MINT
        # =========================================================================================

        # require that the account exposes the non-fungible mint_and_send.
        procref.non_fungible::mint_and_send
        # => [NON_FUNGIBLE_MINT_AND_SEND_ROOT, pad(16)]

        call.code_inspection::has_procedure
        # => [is_non_fungible, pad(19)]

        movdn.4 dropw
        # => [is_non_fungible, pad(15)]

        assert.err=ERR_MINT_UNSUPPORTED_FAUCET
        # => [pad(16)]

        push.STORAGE_PTR exec.active_note::get_storage
        # => [num_storage_items, pad(16)]

        dup
        # => [num_storage_items, num_storage_items, pad(16)]

        u32assert2.err=ERR_NON_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
        u32gte.NFT_MIN_NUM_STORAGE_ITEMS_PUBLIC
        # => [is_public_output_note, num_storage_items, pad(16)]

        if.true
            # public output note creation
            # => [num_storage_items, pad(16)]

            movdn.8
            # => [EMPTY_WORD, EMPTY_WORD, num_storage_items, pad(8)]

            mem_loadw_le.NFT_PUBLIC_SCRIPT_ROOT_PTR
            # => [SCRIPT_ROOT, EMPTY_WORD, num_storage_items, pad(8)]

            swapw mem_loadw_le.NFT_PUBLIC_SERIAL_NUM_PTR
            # => [SERIAL_NUM, SCRIPT_ROOT, num_storage_items, pad(8)]

            movup.8 sub.NFT_MIN_NUM_STORAGE_ITEMS_PUBLIC
            # => [num_output_note_storage, SERIAL_NUM, SCRIPT_ROOT, pad(8)]

            push.NFT_PUBLIC_OUTPUT_NOTE_STORAGE_PTR
            # => [storage_ptr, num_output_note_storage, SERIAL_NUM, SCRIPT_ROOT, pad(8)]

            exec.note::compute_and_store_recipient
            # => [RECIPIENT, pad(12)]

            push.NOTE_TYPE_PUBLIC
            # => [note_type, RECIPIENT, pad(12)]

            mem_load.NFT_PUBLIC_TAG_PTR
            # => [tag, note_type, RECIPIENT, pad(12)]

            padw mem_loadw_le.NFT_PUBLIC_ASSET_VALUE_PTR
            # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]
        else
            # private output note creation

            eq.NFT_NUM_STORAGE_ITEMS_PRIVATE assert.err=ERR_NON_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
            # => [pad(16)]

            mem_loadw_le.NFT_PRIVATE_RECIPIENT_PTR
            # => [RECIPIENT, pad(12)]

            push.NOTE_TYPE_PRIVATE
            # => [note_type, RECIPIENT, pad(12)]

            mem_load.NFT_PRIVATE_TAG_PTR
            # => [tag, note_type, RECIPIENT, pad(12)]

            padw mem_loadw_le.NFT_PRIVATE_ASSET_VALUE_PTR
            # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]
        end
        # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]

        call.non_fungible::mint_and_send
        # => [note_idx, pad(21)]

        dropw drop drop
        # => [pad(16)]
    end
    # => [pad(16)]
end
