use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::note
use miden::standards::faucets::non_fungible as non_fungible

# CONSTANTS
# =================================================================================================

use {NOTE_TYPE_PUBLIC} from miden::protocol::note
use {NOTE_TYPE_PRIVATE} from miden::protocol::note

# Memory base at which the note storage is written by `active_note::get_storage`.
const STORAGE_PTR = 0

# Non-fungible MINT note storage item counts.
const NFT_NUM_STORAGE_ITEMS_PRIVATE = 11
const NFT_MIN_NUM_STORAGE_ITEMS_PUBLIC = 16

# Memory addresses of the non-fungible MINT note storage (private mode, 11 items total).
const NFT_PRIVATE_RECIPIENT_PTR = STORAGE_PTR
const NFT_PRIVATE_ASSET_VALUE_PTR = STORAGE_PTR + 4
const NFT_PRIVATE_TAG_PTR = STORAGE_PTR + 8
const NFT_PRIVATE_FAUCET_ID_SUFFIX_PTR = STORAGE_PTR + 9
const NFT_PRIVATE_FAUCET_ID_PREFIX_PTR = STORAGE_PTR + 10

# Memory addresses of the non-fungible MINT note storage (public mode, 16+ items total).
# The faucet ID occupies two of the three felts that pad the tag out to a word boundary, so the
# variable output-note storage still starts word-aligned at offset 16.
const NFT_PUBLIC_SCRIPT_ROOT_PTR = STORAGE_PTR
const NFT_PUBLIC_SERIAL_NUM_PTR = STORAGE_PTR + 4
const NFT_PUBLIC_ASSET_VALUE_PTR = STORAGE_PTR + 8
const NFT_PUBLIC_TAG_PTR = STORAGE_PTR + 12
const NFT_PUBLIC_FAUCET_ID_SUFFIX_PTR = STORAGE_PTR + 13
const NFT_PUBLIC_FAUCET_ID_PREFIX_PTR = STORAGE_PTR + 14
const NFT_PUBLIC_OUTPUT_NOTE_STORAGE_PTR = STORAGE_PTR + 16

# ERRORS
# =================================================================================================

const ERR_NON_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "non-fungible MINT script expects exactly 11 storage items for private or 16+ storage items for public output notes"
const ERR_NON_FUNGIBLE_MINT_NOTE_ASSET_NOT_FROM_THIS_FAUCET = "the asset stored in the non-fungible MINT note does not belong to this faucet"

#! Asserts that the faucet ID stored in the note is the account consuming it.
#!
#! A non-fungible `ASSET_ID` is derived from the consuming account at mint time, so it matches any
#! faucet and cannot bind the note the way the fungible path's stored `ASSET_ID` does. The stored
#! faucet ID supplies that bind, mirroring the fungible comparison.
#!
#! Inputs:  [faucet_id_suffix, faucet_id_prefix]
#! Outputs: []
#!
#! Panics if:
#! - the stored faucet ID is not the consuming account.
#!
#! Invocation: exec
proc assert_faucet_id_is_active_account
    exec.active_account::get_id
    # => [active_id_suffix, active_id_prefix, faucet_id_suffix, faucet_id_prefix]

    exec.account_id::eq
    # => [is_equal]

    assert.err=ERR_NON_FUNGIBLE_MINT_NOTE_ASSET_NOT_FROM_THIS_FAUCET
    # => []
end

#! Builds the non-fungible mint arguments for a PUBLIC output note from the note storage.
#!
#! Inputs:  [num_storage_items, pad(16)]
#! Outputs: [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]
#!
#! Panics if:
#! - the stored faucet ID is not the consuming account.
#!
#! Invocation: exec
proc mint_public
    # bind the mint to the faucet the note was created for
    mem_load.NFT_PUBLIC_FAUCET_ID_PREFIX_PTR mem_load.NFT_PUBLIC_FAUCET_ID_SUFFIX_PTR
    # => [faucet_id_suffix, faucet_id_prefix, num_storage_items, pad(16)]

    exec.assert_faucet_id_is_active_account
    # => [num_storage_items, pad(16)]

    movdn.8
    # => [EMPTY_WORD, EMPTY_WORD, num_storage_items, pad(8)]

    mem_loadw_le.NFT_PUBLIC_SCRIPT_ROOT_PTR
    # => [SCRIPT_ROOT, EMPTY_WORD, num_storage_items, pad(8)]

    swapw mem_loadw_le.NFT_PUBLIC_SERIAL_NUM_PTR
    # => [SERIAL_NUM, SCRIPT_ROOT, num_storage_items, pad(8)]

    movup.8 sub.NFT_MIN_NUM_STORAGE_ITEMS_PUBLIC
    # => [num_output_note_storage, SERIAL_NUM, SCRIPT_ROOT, pad(8)]

    push.NFT_PUBLIC_OUTPUT_NOTE_STORAGE_PTR
    # => [storage_ptr, num_output_note_storage, SERIAL_NUM, SCRIPT_ROOT, pad(8)]

    exec.note::compute_and_store_recipient
    # => [RECIPIENT, pad(12)]

    push.NOTE_TYPE_PUBLIC
    # => [note_type, RECIPIENT, pad(12)]

    mem_load.NFT_PUBLIC_TAG_PTR
    # => [tag, note_type, RECIPIENT, pad(12)]

    padw mem_loadw_le.NFT_PUBLIC_ASSET_VALUE_PTR
    # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]
end

#! Builds the non-fungible mint arguments for a PRIVATE output note from the note storage.
#!
#! Inputs:  [num_storage_items, pad(16)]
#! Outputs: [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]
#!
#! Panics if:
#! - the number of storage items is not exactly 11.
#! - the stored faucet ID is not the consuming account.
#!
#! Invocation: exec
proc mint_private
    eq.NFT_NUM_STORAGE_ITEMS_PRIVATE assert.err=ERR_NON_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => [pad(16)]

    # bind the mint to the faucet the note was created for
    mem_load.NFT_PRIVATE_FAUCET_ID_PREFIX_PTR mem_load.NFT_PRIVATE_FAUCET_ID_SUFFIX_PTR
    # => [faucet_id_suffix, faucet_id_prefix, pad(16)]

    exec.assert_faucet_id_is_active_account
    # => [pad(16)]

    mem_loadw_le.NFT_PRIVATE_RECIPIENT_PTR
    # => [RECIPIENT, pad(12)]

    push.NOTE_TYPE_PRIVATE
    # => [note_type, RECIPIENT, pad(12)]

    mem_load.NFT_PRIVATE_TAG_PTR
    # => [tag, note_type, RECIPIENT, pad(12)]

    padw mem_loadw_le.NFT_PRIVATE_ASSET_VALUE_PTR
    # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]
end

#! Mints the non-fungible asset stored in the active note by calling the consuming faucet's
#! `mint_and_send` procedure. Selects the public or private output-note layout based on the number
#! of note storage items (see `mint_public` / `mint_private`).
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the number of storage items is not exactly 11 for private or less than 16 for public output
#!   notes.
#! - the consuming account is not the faucet ID stored in the note, which is what binds the note to
#!   its faucet.
#!
#! Invocation: exec
pub proc mint
    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_storage_items, pad(16)]

    dup
    # => [num_storage_items, num_storage_items, pad(16)]

    u32assert2.err=ERR_NON_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    u32gte.NFT_MIN_NUM_STORAGE_ITEMS_PUBLIC
    # => [is_public_output_note, num_storage_items, pad(16)]

    if.true
        exec.mint_public
    else
        exec.mint_private
    end
    # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]

    call.non_fungible::mint_and_send
    # => [note_idx, pad(21)]

    dropw drop drop
    # => [pad(16)]
end
