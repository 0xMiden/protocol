use miden::protocol::active_note
use miden::protocol::note
use miden::standards::faucets::non_fungible as non_fungible

# CONSTANTS
# =================================================================================================

use {NOTE_TYPE_PUBLIC} from miden::protocol::note
use {NOTE_TYPE_PRIVATE} from miden::protocol::note

# Memory base at which the note storage is written by `active_note::get_storage`.
const STORAGE_PTR = 0

# Non-fungible MINT note storage item counts.
const NFT_NUM_STORAGE_ITEMS_PRIVATE = 9
const NFT_MIN_NUM_STORAGE_ITEMS_PUBLIC = 16

# Memory addresses of the non-fungible MINT note storage (private mode, 9 items total).
const NFT_PRIVATE_RECIPIENT_PTR = STORAGE_PTR
const NFT_PRIVATE_ASSET_VALUE_PTR = STORAGE_PTR + 4
const NFT_PRIVATE_TAG_PTR = STORAGE_PTR + 8

# Memory addresses of the non-fungible MINT note storage (public mode, 16+ items total).
const NFT_PUBLIC_SCRIPT_ROOT_PTR = STORAGE_PTR
const NFT_PUBLIC_SERIAL_NUM_PTR = STORAGE_PTR + 4
const NFT_PUBLIC_ASSET_VALUE_PTR = STORAGE_PTR + 8
const NFT_PUBLIC_TAG_PTR = STORAGE_PTR + 12
const NFT_PUBLIC_OUTPUT_NOTE_STORAGE_PTR = STORAGE_PTR + 16

# ERRORS
# =================================================================================================

const ERR_NON_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "non-fungible MINT script expects exactly 9 storage items for private or 16+ storage items for public output notes"

#! Mints the non-fungible asset stored in the active note by calling the consuming faucet's
#! `mint_and_send` procedure.
#!
#! Note storage supports two modes. Depending on the number of note storage items, a private or
#! public output note is created on consumption of the MINT note:
#!
#! Private mode (9 storage items) - creates a private note:
#! - RECIPIENT:   The recipient digest (4 elements, word 0)
#! - ASSET_VALUE: The asset commitment `hash(user_data, salt)` (4 elements, word 1)
#! - tag:         Note tag for the output note (1 element)
#!
#! Public mode (16+ storage items) - creates a public note with variable-length storage:
#! - SCRIPT_ROOT: Script root of the output note (4 elements, word 0)
#! - SERIAL_NUM:  Serial number of the output note (4 elements, word 1)
#! - ASSET_VALUE: The asset commitment (4 elements, word 2)
#! - tag:         Note tag for the output note (1 element)
#! - padding:     3 elements so the variable storage starts at a word boundary
#! - [STORAGE]:   Variable-length storage for the output note (num items = total - 16)
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the number of storage items is not exactly 9 for private or less than 16 for public output
#!   notes.
#! - the asset stored in the note does not belong to the consuming faucet.
#!
#! Invocation: exec
pub proc mint
    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_storage_items, pad(16)]

    dup
    # => [num_storage_items, num_storage_items, pad(16)]

    u32assert2.err=ERR_NON_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    u32gte.NFT_MIN_NUM_STORAGE_ITEMS_PUBLIC
    # => [is_public_output_note, num_storage_items, pad(16)]

    if.true
        # public output note creation
        # => [num_storage_items, pad(16)]

        movdn.8
        # => [EMPTY_WORD, EMPTY_WORD, num_storage_items, pad(8)]

        mem_loadw_le.NFT_PUBLIC_SCRIPT_ROOT_PTR
        # => [SCRIPT_ROOT, EMPTY_WORD, num_storage_items, pad(8)]

        swapw mem_loadw_le.NFT_PUBLIC_SERIAL_NUM_PTR
        # => [SERIAL_NUM, SCRIPT_ROOT, num_storage_items, pad(8)]

        movup.8 sub.NFT_MIN_NUM_STORAGE_ITEMS_PUBLIC
        # => [num_output_note_storage, SERIAL_NUM, SCRIPT_ROOT, pad(8)]

        push.NFT_PUBLIC_OUTPUT_NOTE_STORAGE_PTR
        # => [storage_ptr, num_output_note_storage, SERIAL_NUM, SCRIPT_ROOT, pad(8)]

        exec.note::compute_and_store_recipient
        # => [RECIPIENT, pad(12)]

        push.NOTE_TYPE_PUBLIC
        # => [note_type, RECIPIENT, pad(12)]

        mem_load.NFT_PUBLIC_TAG_PTR
        # => [tag, note_type, RECIPIENT, pad(12)]

        padw mem_loadw_le.NFT_PUBLIC_ASSET_VALUE_PTR
        # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]
    else
        # private output note creation

        eq.NFT_NUM_STORAGE_ITEMS_PRIVATE assert.err=ERR_NON_FUNGIBLE_MINT_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
        # => [pad(16)]

        mem_loadw_le.NFT_PRIVATE_RECIPIENT_PTR
        # => [RECIPIENT, pad(12)]

        push.NOTE_TYPE_PRIVATE
        # => [note_type, RECIPIENT, pad(12)]

        mem_load.NFT_PRIVATE_TAG_PTR
        # => [tag, note_type, RECIPIENT, pad(12)]

        padw mem_loadw_le.NFT_PRIVATE_ASSET_VALUE_PTR
        # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]
    end
    # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(12)]

    call.non_fungible::mint_and_send
    # => [note_idx, pad(21)]

    dropw drop drop
    # => [pad(16)]
end
