use {NoteArgs, OutputNoteIndex} from miden::protocol::types
use miden::protocol::active_note
use miden::protocol::asset
use miden::protocol::note
use miden::protocol::output_note
use {MAX_NOTE_STORAGE_ITEMS, NOTE_TYPE_PRIVATE} from miden::protocol::note
use miden::standards::wallets::basic as wallet

# CONSTANTS
# =================================================================================================

# Note storage layout (loaded at STORAGE_PTR, so a storage offset is also its memory address):
# - requested_asset_id         [0..4]
# - requested_asset_value      [4..8]
# - payback_recipient          [8..12]   (private mode)
#   payback_script_root        [8..12]   (public mode)
# - payback_serial_num         [12..16]  (public mode; zero in private mode)
# - payback_note_type          [16]
# - payback_tag                [17]
# - num_payback_storage_items  [18]      (public mode; zero in private mode)
# - num_payback_attachments    [19]
# - payback_storage            [20..20+num_payback_storage_items]  (public mode)
# - zero padding               up to the next word boundary, ATTACHMENTS_START
# - payback_attachments        [ATTACHMENTS_START..]  (each: a [scheme, num_words, 0, 0] header
#                                                      word, then num_words content words)
#
# Every region starts on a word boundary, so the payback storage and each attachment's content
# are passed to APIs straight from the loaded storage.
const STORAGE_PTR=0
const REQUESTED_ASSET_PTR=STORAGE_PTR
const PAYBACK_RECIPIENT_PTR=STORAGE_PTR + 8
const PAYBACK_SCRIPT_ROOT_PTR=STORAGE_PTR + 8
const PAYBACK_SERIAL_NUM_PTR=STORAGE_PTR + 12
const PAYBACK_NOTE_TYPE_PTR=STORAGE_PTR + 16
const PAYBACK_TAG_PTR=STORAGE_PTR + 17
const NUM_PAYBACK_STORAGE_ITEMS_PTR=STORAGE_PTR + 18
const NUM_PAYBACK_ATTACHMENTS_PTR=STORAGE_PTR + 19
const PAYBACK_STORAGE_PTR=STORAGE_PTR + 20

# Offsets within an attachment, relative to its header word. The scheme is at offset 0.
const ATTACHMENT_NUM_WORDS_OFFSET=1
const ATTACHMENT_CONTENT_OFFSET=4

const WORD_SIZE=4
# Rounding a u32 up to a multiple of WORD_SIZE adds WORD_ROUND_UP, then masks out the two least
# significant bits with WORD_ALIGNMENT_MASK.
const WORD_ROUND_UP=WORD_SIZE - 1
const WORD_ALIGNMENT_MASK=0xFFFFFFFC

# The note asset region starts after the largest possible storage.
const ASSET_PTR=STORAGE_PTR + MAX_NOTE_STORAGE_ITEMS

# ERRORS
# =================================================================================================

const ERR_SWAP_STORAGE_LENGTH_MISMATCH="SWAP note storage length does not match the declared payback storage and attachments"

const ERR_SWAP_NUM_PAYBACK_STORAGE_ITEMS_NOT_U32="SWAP number of payback storage items is not a u32"

const ERR_SWAP_WRONG_NUMBER_OF_ASSETS="SWAP script requires exactly 1 note asset"

# HELPER PROCEDURES
# =================================================================================================

#! Adds the payback attachments declared in the note storage to the payback note.
#!
#! Inputs:  [note_idx]
#! Outputs: [storage_end_ptr]
#!
#! Where:
#! - note_idx is the index of the payback note.
#! - storage_end_ptr is the address right after the last attachment, i.e. the length of the note
#!   storage as declared by the payback storage and attachments.
#!
#! Panics if:
#! - the number of payback storage items is not a u32.
#! - any attachment violates the kernel's attachment limits.
#!
#! Invocation: exec
proc add_payback_attachments(note_idx: OutputNoteIndex) -> u32
    mem_load.NUM_PAYBACK_ATTACHMENTS_PTR
    # => [num_attachments, note_idx]

    # The attachments start after the payback storage, padded to a word boundary.
    mem_load.NUM_PAYBACK_STORAGE_ITEMS_PTR
    u32assert.err=ERR_SWAP_NUM_PAYBACK_STORAGE_ITEMS_NOT_U32
    add.WORD_ROUND_UP u32and.WORD_ALIGNMENT_MASK add.PAYBACK_STORAGE_PTR
    # => [attachment_ptr, num_attachments, note_idx]

    dup.1 neq.0
    # => [has_remaining_attachments, attachment_ptr, num_attachments, note_idx]

    while.true
        dup add.ATTACHMENT_NUM_WORDS_OFFSET mem_load
        # => [num_words, attachment_ptr, num_attachments, note_idx]

        dup.3 dup.2 add.ATTACHMENT_CONTENT_OFFSET
        # => [content_ptr, note_idx, num_words, attachment_ptr, num_attachments, note_idx]

        # The scheme is the first element of the attachment header.
        dup.2 dup.4 mem_load
        # => [attachment_scheme, num_words, content_ptr, note_idx,
        #     num_words, attachment_ptr, num_attachments, note_idx]

        exec.output_note::add_attachment_from_memory
        # => [num_words, attachment_ptr, num_attachments, note_idx]

        # The kernel bounds num_words, so this cannot wrap around.
        mul.WORD_SIZE add add.ATTACHMENT_CONTENT_OFFSET
        # => [next_attachment_ptr, num_attachments, note_idx]

        swap sub.1 swap
        # => [attachment_ptr, num_attachments, note_idx]

        dup.1 neq.0
        # => [has_remaining_attachments, attachment_ptr, num_attachments, note_idx]
    end
    # => [storage_end_ptr, 0, note_idx]

    movdn.2 drop drop
    # => [storage_end_ptr]
end

# NOTE SCRIPT
# =================================================================================================

#! Swap script: adds the note's remaining offered asset into the consumer's account and creates a
#! sealed payback note carrying the requested asset.
#!
#! The payback note type (selected by the creator) determines how the payback recipient is
#! derived: private uses an opaque precomputed digest, public builds it from the payback script
#! root, serial number and storage embedded in the note storage. In both modes, the payback note
#! gets the attachments embedded in the note storage.
#!
#! Requires that the account exposes:
#! - `miden::standards::wallets::basic::receive_asset` procedure.
#! - `miden::standards::wallets::basic::move_asset_to_note` procedure.
#! - `miden::standards::note::note_creator::create_note` procedure.
#!
#! Consumers: unrestricted - any account may take the offered asset in exchange for the requested
#!   one
#!
#! Inputs:  [ARGS]
#! Outputs: []
#!
#! Panics if:
#! - account does not expose the required wallet procedures.
#! - the note storage length does not match the declared payback storage and attachments.
#! - the payback recipient or attachments are rejected by the kernel.
#! - the note does not hold exactly one asset at consumption time.
#! - account vault does not contain the requested asset.
#! - adding a fungible asset would result in amount overflow, i.e., the total amount would be
#!   greater than 2^63.
@note_script
pub proc main(args: NoteArgs)
    # drop note args
    dropw
    # => []

    # store note storage into memory starting at STORAGE_PTR
    push.MAX_NOTE_STORAGE_ITEMS push.STORAGE_PTR exec.active_note::get_bounded_storage
    # => [num_storage_items]

    # --- create payback note ---

    # Branch on payback note type.
    mem_load.PAYBACK_NOTE_TYPE_PTR
    eq.NOTE_TYPE_PRIVATE
    # => [is_private, num_storage_items]

    if.true
        # --- PRIVATE PAYBACK ---
        # Load the precomputed payback recipient.
        padw mem_loadw_le.PAYBACK_RECIPIENT_PTR
        # => [PAYBACK_RECIPIENT, num_storage_items]
    else
        # --- PUBLIC PAYBACK ---
        padw mem_loadw_le.PAYBACK_SCRIPT_ROOT_PTR
        # => [SCRIPT_ROOT, num_storage_items]

        padw mem_loadw_le.PAYBACK_SERIAL_NUM_PTR
        # => [SERIAL_NUM, SCRIPT_ROOT, num_storage_items]

        mem_load.NUM_PAYBACK_STORAGE_ITEMS_PTR push.PAYBACK_STORAGE_PTR
        # => [storage_ptr, num_payback_storage_items, SERIAL_NUM, SCRIPT_ROOT, num_storage_items]

        exec.note::compute_and_store_recipient
        # => [PAYBACK_RECIPIENT, num_storage_items]
    end
    # => [PAYBACK_RECIPIENT, num_storage_items]

    mem_load.PAYBACK_NOTE_TYPE_PTR
    mem_load.PAYBACK_TAG_PTR
    # => [tag, note_type, PAYBACK_RECIPIENT, num_storage_items]

    # Note creation must originate from the account context, so route through the account's
    # `create_note` procedure. Pad the stack for the `call` convention.
    push.0 movdn.6 push.0 movdn.6 padw padw swapdw
    # => [tag, note_type, PAYBACK_RECIPIENT, pad(10), num_storage_items]

    call.wallet::create_note
    # => [note_idx, pad(15), num_storage_items]

    movdn.15 dropw dropw dropw drop drop drop
    # => [note_idx, num_storage_items]

    # --- add the payback attachments and check that they end exactly at the storage end

    dup exec.add_payback_attachments
    # => [storage_end_ptr, note_idx, num_storage_items]

    # STORAGE_PTR is 0, so we can assert storage_end_ptr == num_storage_items
    movup.2 assert_eq.err=ERR_SWAP_STORAGE_LENGTH_MISMATCH
    # => [note_idx]

    # --- move requested asset into the payback note

    dup padw push.0.0.0 movup.7
    # => [note_idx, pad(7), note_idx]

    push.REQUESTED_ASSET_PTR exec.asset::load
    # => [REQUESTED_ASSET_ID, REQUESTED_ASSET_VALUE, note_idx, pad(7), note_idx]

    # move asset to the note
    call.wallet::move_asset_to_note
    # => [pad(16), note_idx]

    dropw dropw
    # => [pad(8), note_idx]

    # the payback note holds the requested asset and is final
    movup.8 exec.output_note::seal
    # => [pad(8)]

    # --- move offered asset from the SWAP note into the consumer's account

    # store the number of note assets to memory starting at address ASSET_PTR
    push.ASSET_PTR exec.active_note::remove_all_assets
    # => [num_assets, pad(8)]

    # make sure the number of assets is 1
    assert.err=ERR_SWAP_WRONG_NUMBER_OF_ASSETS
    # => [pad(8)]

    # load asset
    push.ASSET_PTR exec.asset::load
    # => [ASSET_ID, ASSET_VALUE, pad(8)]

    # add the asset to the account
    call.wallet::receive_asset
    # => [pad(16)]

    # clearing the stack of padded 0s
    repeat.4
        dropw
    end
    # => []
end
