use {AccountProcedureRoot, NoteArgs} from miden::protocol::types
use {WORD_NUM_ELEMENTS} from miden::protocol::constants
use {
    MAX_NUM_ACTIVE_TRANSFER_POLICIES,
    PolicyRootsCommitment,
} from miden::standards::faucets::policies::policy_manager
use miden::core::crypto::hashes::eidos
use miden::protocol::active_note
use miden::standards::faucets::policies::policy_manager
use miden::standards::note::note_target

# CONSTANTS
# =================================================================================================

# Memory base at which the note storage is written by `active_note::get_bounded_storage`.
const STORAGE_PTR = 0

# Memory addresses of the FaucetPolicyConfig note storage. The variant is padded to a word, so the
# policy roots are word-aligned, as `eidos::hash_elements` requires.
const VARIANT_PTR = STORAGE_PTR
const POLICY_ROOTS_PTR = STORAGE_PTR + WORD_NUM_ELEMENTS

# Config note variants, stored in the first storage item. Keep in sync with
# `FaucetPolicyConfig` on the Rust side.
const VARIANT_SET_MINT_POLICY = 0
const VARIANT_SET_BURN_POLICY = 1
const VARIANT_SET_SEND_POLICY_ROOTS = 2
const VARIANT_SET_RECEIVE_POLICY_ROOTS = 3

# The number of storage items of the padded variant.
const NUM_ITEMS_VARIANT = WORD_NUM_ELEMENTS

# Expected note storage item count of the mint and burn actions, which take a single policy root.
const NUM_ITEMS_SINGLE_POLICY_ROOT = NUM_ITEMS_VARIANT + WORD_NUM_ELEMENTS

# Largest storage item count any action uses
const MAX_NUM_ITEMS = NUM_ITEMS_VARIANT + MAX_NUM_ACTIVE_TRANSFER_POLICIES * WORD_NUM_ELEMENTS

# ERRORS
# =================================================================================================

const ERR_FAUCET_POLICY_CONFIG_UNKNOWN_VARIANT = "faucet policy config note variant does not match a known action"

const ERR_FAUCET_POLICY_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "faucet policy config note storage item count does not match the selected action"

const ERR_FAUCET_POLICY_CONFIG_NOTE_IS_NOT_PUBLIC = "faucet policy config note must be public"

# NOTE SCRIPT
# =================================================================================================

#! FaucetPolicyConfig script: triggers a `TokenPolicyManager` policy-switch action against the
#! consuming faucet, dispatched on the note variant in its storage.
#!
#! The selected action and its policy roots are read from the note storage and are fixed at note
#! creation:
#! - `0` SetMintPolicy:         `[0, 0, 0, 0, POLICY_ROOT]`.
#! - `1` SetBurnPolicy:         `[1, 0, 0, 0, POLICY_ROOT]`.
#! - `2` SetSendPolicyRoots:    `[2, 0, 0, 0, [POLICY_ROOT]]`.
#! - `3` SetReceivePolicyRoots: `[3, 0, 0, 0, [POLICY_ROOT]]`.
#!
#! The send and receive setters take the commitment to the policy roots on the operand stack and
#! read the roots from the advice map. This script inserts the roots into the advice map, so they
#! need no out-of-band advice inputs.
#!
#! Authorization is enforced by the called `TokenPolicyManager` procedures via the account-wide
#! `Authority` component (`assert_authorized`); this script only dispatches to them. Each procedure
#! additionally rejects a policy root that is not registered as an allowed alternative for its kind.
#!
#! Requires that the account exposes:
#! - `miden::standards::faucets::policies::policy_manager::{set_mint_policy, set_burn_policy,
#!   set_send_policy_roots_commitment, set_receive_policy_roots_commitment}` (the
#!   `TokenPolicyManager` component), backed by the `Authority` companion component.
#!
#! Consumers: target account (attachment)
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note is not public.
#! - the consuming account is not the note's target account, or the target attachment is missing.
#! - the number of storage items exceeds MAX_NUM_ITEMS.
#! - the variant is not a known action.
#! - the number of storage items does not match the selected action.
#! - the caller is not authorized per the installed `Authority` component, or a policy root is not
#!   an allowed alternative (per the `TokenPolicyManager` procedures).
@note_script
pub proc main(args: NoteArgs)
    dropw
    # => [pad(16)]

    exec.active_note::is_public
    assert.err=ERR_FAUCET_POLICY_CONFIG_NOTE_IS_NOT_PUBLIC
    # => [pad(16)]

    # bind consumption to the targeted account: reject if the consuming account is not the note's
    # target account
    exec.note_target::assert_active_account_is_network_target_account
    # => [pad(16)]

    # write the note storage to memory starting at STORAGE_PTR
    push.MAX_NUM_ITEMS push.STORAGE_PTR exec.active_note::get_bounded_storage
    # => [num_storage_items, pad(16)]

    mem_load.VARIANT_PTR
    # => [variant, num_storage_items]

    # dispatch on the variant to the matching action procedure
    dup eq.VARIANT_SET_MINT_POLICY
    # => [is_set_mint, variant, num_storage_items]

    if.true
        drop
        # => [num_storage_items]

        exec.execute_set_mint_policy
    else
        dup eq.VARIANT_SET_BURN_POLICY
        # => [is_set_burn, variant, num_storage_items]

        if.true
            drop
            # => [num_storage_items]

            exec.execute_set_burn_policy
        else
            dup eq.VARIANT_SET_SEND_POLICY_ROOTS
            # => [is_set_send, variant, num_storage_items]

            if.true
                drop
                # => [num_storage_items]

                exec.execute_set_send_policy_roots
            else
                eq.VARIANT_SET_RECEIVE_POLICY_ROOTS
                assert.err=ERR_FAUCET_POLICY_CONFIG_UNKNOWN_VARIANT
                # => [num_storage_items]

                exec.execute_set_receive_policy_roots
            end
        end
    end
    # => [pad(16)]
end

# HELPER PROCEDURES
# =================================================================================================

#! Builds the call frame of the mint and burn policy setters, which take a single policy root.
#!
#! Inputs:  [num_storage_items]
#! Outputs: [NEW_POLICY_ROOT, pad(12)]
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_SINGLE_POLICY_ROOT.
#!
#! Invocation: exec
proc prepare_policy_root_call_frame(num_storage_items: u16) -> (AccountProcedureRoot, [felt; 12])
    eq.NUM_ITEMS_SINGLE_POLICY_ROOT
    assert.err=ERR_FAUCET_POLICY_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # load the policy root on top of a pad(12) tail, overwriting the topmost pad word
    padw padw padw padw
    mem_loadw_le.POLICY_ROOTS_PTR
    # => [NEW_POLICY_ROOT, pad(12)]
end

#! Builds the call frame of the send and receive policy setters, which take the commitment to the
#! list of policy roots, and inserts the list into the advice map.
#!
#! Inputs:
#!   Operand stack: [num_storage_items]
#! Outputs:
#!   Operand stack: [PROC_ROOTS_COMMITMENT, pad(12)]
#!   Advice map: {
#!     PROC_ROOTS_COMMITMENT: [[POLICY_ROOT]]
#!   }
#!
#! Panics if:
#! - the number of storage items is not the padded variant plus a non-empty list of policy roots.
#!
#! Invocation: exec
proc prepare_policy_roots_call_frame(num_storage_items: u16) -> (PolicyRootsCommitment, [felt; 12])
    dup u32gt.NUM_ITEMS_VARIANT
    assert.err=ERR_FAUCET_POLICY_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => [num_storage_items]

    dup u32mod.WORD_NUM_ELEMENTS eq.0
    assert.err=ERR_FAUCET_POLICY_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => [num_storage_items]

    # pad the call frame below the commitment
    padw padw padw movup.12
    # => [num_storage_items, pad(12)]

    dup add.STORAGE_PTR
    # => [roots_end_ptr, num_storage_items, pad(12)]

    swap sub.NUM_ITEMS_VARIANT
    # => [num_elements, roots_end_ptr, pad(12)]

    push.POLICY_ROOTS_PTR dup movdn.2
    # => [roots_ptr, num_elements, roots_ptr, roots_end_ptr, pad(12)]

    exec.eidos::hash_elements
    # => [PROC_ROOTS_COMMITMENT, roots_ptr, roots_end_ptr, pad(12)]

    adv.insert_mem
    # OS => [PROC_ROOTS_COMMITMENT, roots_ptr, roots_end_ptr, pad(12)]
    # AM => { PROC_ROOTS_COMMITMENT: mem[roots_ptr..roots_end_ptr] }

    movup.4 drop movup.4 drop
    # => [PROC_ROOTS_COMMITMENT, pad(12)]
end

#! Executes the SetMintPolicy action: switches the active mint policy to the stored root.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_SINGLE_POLICY_ROOT.
#! - the caller is not authorized per the installed `Authority` component, or the root is not an
#!   allowed mint policy (per `policy_manager::set_mint_policy`).
#!
#! Invocation: exec
proc execute_set_mint_policy(num_storage_items: u16)
    exec.prepare_policy_root_call_frame
    # => [NEW_POLICY_ROOT, pad(12)]

    call.policy_manager::set_mint_policy
    # => [pad(16)]

    dropw dropw dropw dropw
    # => []
end

#! Executes the SetBurnPolicy action: switches the active burn policy to the stored root.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_SINGLE_POLICY_ROOT.
#! - the caller is not authorized per the installed `Authority` component, or the root is not an
#!   allowed burn policy (per `policy_manager::set_burn_policy`).
#!
#! Invocation: exec
proc execute_set_burn_policy(num_storage_items: u16)
    exec.prepare_policy_root_call_frame
    # => [NEW_POLICY_ROOT, pad(12)]

    call.policy_manager::set_burn_policy
    # => [pad(16)]

    dropw dropw dropw dropw
    # => []
end

#! Executes the SetSendPolicyRoots action: switches the active send policies to the stored roots.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - the number of storage items is not the padded variant plus a non-empty list of policy roots.
#! - the caller is not authorized per the installed `Authority` component, or any root is not an
#!   allowed send policy (per `policy_manager::set_send_policy_roots_commitment`).
#!
#! Invocation: exec
proc execute_set_send_policy_roots(num_storage_items: u16)
    exec.prepare_policy_roots_call_frame
    # => [PROC_ROOTS_COMMITMENT, pad(12)]

    call.policy_manager::set_send_policy_roots_commitment
    # => [pad(16)]

    dropw dropw dropw dropw
    # => []
end

#! Executes the SetReceivePolicyRoots action: switches the active receive policies to the stored
#! roots.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - the number of storage items is not the padded variant plus a non-empty list of policy roots.
#! - the caller is not authorized per the installed `Authority` component, or any root is not an
#!   allowed receive policy (per `policy_manager::set_receive_policy_roots_commitment`).
#!
#! Invocation: exec
proc execute_set_receive_policy_roots(num_storage_items: u16)
    exec.prepare_policy_roots_call_frame
    # => [PROC_ROOTS_COMMITMENT, pad(12)]

    call.policy_manager::set_receive_policy_roots_commitment
    # => [pad(16)]

    dropw dropw dropw dropw
    # => []
end
