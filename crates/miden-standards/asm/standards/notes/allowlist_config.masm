use miden::protocol::active_note
use miden::standards::faucets::policies::transfer::allowlist::manager

# CONSTANTS
# =================================================================================================

# Memory base at which the note storage is written by `active_note::get_storage`.
const STORAGE_PTR = 0

# Memory addresses of the AllowlistConfig note storage. Both actions carry the same arguments: the
# ID of the account being allowed or disallowed.
const SELECTOR_PTR = STORAGE_PTR
const ACCOUNT_SUFFIX_PTR = STORAGE_PTR + 1
const ACCOUNT_PREFIX_PTR = STORAGE_PTR + 2

# Config note selectors, stored in the first storage item. Keep in sync with `AllowlistConfig` on
# the Rust side.
const SELECTOR_ALLOW_ACCOUNT = 0
const SELECTOR_DISALLOW_ACCOUNT = 1

# Expected note storage item count per action.
const NUM_ITEMS_ALLOW_ACCOUNT = 3
const NUM_ITEMS_DISALLOW_ACCOUNT = 3

# ERRORS
# =================================================================================================

const ERR_ALLOWLIST_CONFIG_UNKNOWN_SELECTOR = "allowlist config note selector does not match a known action"

const ERR_ALLOWLIST_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "allowlist config note storage item count does not match the selected action"

# NOTE SCRIPT
# =================================================================================================

#! AllowlistConfig script: triggers an `AllowlistManager` admin action against the consuming
#! account, dispatched on a selector stored in the first note storage item.
#!
#! The selected action and its arguments are read from the note storage (fixed at note creation,
#! so authorization is bound to the note sender):
#! - `0` AllowAccount:    `[0, account_suffix, account_prefix]`.
#! - `1` DisallowAccount: `[1, account_suffix, account_prefix]`.
#!
#! Authorization is enforced by the called `AllowlistManager` procedures via the account-wide
#! `Authority` component (`assert_authorized`), which resolves the note sender against the
#! configured owner or role; this script only loads the arguments and calls them.
#!
#! Requires that the account exposes:
#! - `miden::standards::faucets::policies::transfer::allowlist::manager::{allow_account,
#!   disallow_account}` (the `AllowlistManager` component), backed by the `Authority` component and
#!   a component that installs the `allowed_accounts` storage slot (typically `BasicAllowlist`).
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the selector is not a known action.
#! - the number of storage items does not match the selected action.
#! - the note sender is not authorized for the selected action (per the `Authority` component).
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # write the note storage to memory starting at STORAGE_PTR
    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_storage_items]

    mem_load.SELECTOR_PTR
    # => [selector, num_storage_items]

    # dispatch on the selector to the matching action procedure
    dup eq.SELECTOR_ALLOW_ACCOUNT
    # => [is_allow, selector, num_storage_items]

    if.true
        drop
        # => [num_storage_items]

        exec.execute_allow_account
    else
        eq.SELECTOR_DISALLOW_ACCOUNT assert.err=ERR_ALLOWLIST_CONFIG_UNKNOWN_SELECTOR
        # => [num_storage_items]

        exec.execute_disallow_account
    end
    # => [pad(16)]
end

# HELPER PROCEDURES
# =================================================================================================

#! Executes the AllowAccount action: adds the stored account to the allowlist.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_ALLOW_ACCOUNT.
#! - the note sender is not authorized (per the `Authority` component).
#!
#! Invocation: exec
proc execute_allow_account
    eq.NUM_ITEMS_ALLOW_ACCOUNT
    assert.err=ERR_ALLOWLIST_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # build the `allow_account` input window: [account_suffix, account_prefix, pad(14)]
    padw padw padw push.0.0
    mem_load.ACCOUNT_PREFIX_PTR
    mem_load.ACCOUNT_SUFFIX_PTR
    # => [account_suffix, account_prefix, pad(14)]

    call.manager::allow_account
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Executes the DisallowAccount action: removes the stored account from the allowlist.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_DISALLOW_ACCOUNT.
#! - the note sender is not authorized (per the `Authority` component).
#!
#! Invocation: exec
proc execute_disallow_account
    eq.NUM_ITEMS_DISALLOW_ACCOUNT
    assert.err=ERR_ALLOWLIST_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # build the `disallow_account` input window: [account_suffix, account_prefix, pad(14)]
    padw padw padw push.0.0
    mem_load.ACCOUNT_PREFIX_PTR
    mem_load.ACCOUNT_SUFFIX_PTR
    # => [account_suffix, account_prefix, pad(14)]

    call.manager::disallow_account
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end
