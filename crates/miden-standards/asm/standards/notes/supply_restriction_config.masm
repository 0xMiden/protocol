use {NoteArgs} from miden::protocol::types
use miden::protocol::active_note
use miden::standards::faucets::supply_restriction::manager
use miden::standards::note::note_target

# CONSTANTS
# =================================================================================================

# Memory base at which the note storage is written by `active_note::get_bounded_storage`.
const STORAGE_PTR = 0

# Memory addresses of the SupplyRestrictionConfig note storage. All actions carry the same
# arguments.
const VARIANT_PTR = STORAGE_PTR
const ACCOUNT_SUFFIX_PTR = STORAGE_PTR + 1
const ACCOUNT_PREFIX_PTR = STORAGE_PTR + 2
const AMOUNT_PTR = STORAGE_PTR + 3

# Config note variants, stored in the first storage item.
const VARIANT_FREEZE = 0
const VARIANT_UNFREEZE = 1
const VARIANT_CONFISCATE = 2

# Expected note storage item count, shared by all actions.
const NUM_STORAGE_ITEMS = 4

# ERRORS
# =================================================================================================

const ERR_SUPPLY_RESTRICTION_CONFIG_UNKNOWN_VARIANT = "supply restriction config note variant does not match a known action"

const ERR_SUPPLY_RESTRICTION_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "supply restriction config note storage item count does not match the expected count"

const ERR_SUPPLY_RESTRICTION_CONFIG_NOTE_IS_NOT_PUBLIC = "supply restriction config note must be public"

# NOTE SCRIPT
# =================================================================================================

#! SupplyRestrictionConfig script: triggers a `TokenSupplyRestriction` admin action against the
#! consuming account, dispatched on the note variant in its storage.
#!
#! The selected action and its arguments are read from the note storage and are fixed at note
#! creation:
#! - Freeze:     `[0, account_suffix, account_prefix, amount]`.
#! - Unfreeze:   `[1, account_suffix, account_prefix, amount]`.
#! - Confiscate: `[2, account_suffix, account_prefix, amount]`.
#!
#! Authorization is enforced by the called `TokenSupplyRestriction` procedures.
#!
#! Requires that the account exposes:
#! - `miden::standards::faucets::supply_restriction::manager::{freeze, unfreeze, confiscate}`
#!
#! Consumers: target account (attachment)
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note is not public.
#! - the consuming account is not the note's target account, or the target attachment is missing.
#! - the number of storage items is not NUM_STORAGE_ITEMS.
#! - the variant is not a known action.
#! - the caller is not authorized for the selected action per the installed `Authority` component.
#! - the selected action panics (see the `TokenSupplyRestriction` procedures).
@note_script
pub proc main(args: NoteArgs)
    dropw
    # => [pad(16)]

    exec.active_note::is_public
    assert.err=ERR_SUPPLY_RESTRICTION_CONFIG_NOTE_IS_NOT_PUBLIC
    # => [pad(16)]

    # bind consumption to the targeted account: reject if the consuming account is not the note's
    # target account
    exec.note_target::assert_active_account_is_network_target_account
    # => [pad(16)]

    # write the note storage to memory starting at STORAGE_PTR
    push.NUM_STORAGE_ITEMS push.STORAGE_PTR exec.active_note::get_bounded_storage
    # => [num_storage_items, pad(16)]

    eq.NUM_STORAGE_ITEMS
    assert.err=ERR_SUPPLY_RESTRICTION_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => [pad(16)]

    # build the shared action input window: [account_suffix, account_prefix, amount, pad(13)]
    padw padw padw push.0
    mem_load.AMOUNT_PTR
    mem_load.ACCOUNT_PREFIX_PTR
    mem_load.ACCOUNT_SUFFIX_PTR
    # => [account_suffix, account_prefix, amount, pad(13), pad(16)]

    # dispatch on the variant to the matching action procedure
    mem_load.VARIANT_PTR
    # => [variant, account_suffix, account_prefix, amount, pad(13), pad(16)]

    dup eq.VARIANT_FREEZE
    # => [is_freeze, variant, account_suffix, account_prefix, amount, pad(13), pad(16)]

    if.true
        drop
        call.manager::freeze
        # => [pad(16), pad(16)]
    else
        dup eq.VARIANT_UNFREEZE
        # => [is_unfreeze, variant, account_suffix, account_prefix, amount, pad(13), pad(16)]

        if.true
            drop
            call.manager::unfreeze
            # => [pad(16), pad(16)]
        else
            eq.VARIANT_CONFISCATE assert.err=ERR_SUPPLY_RESTRICTION_CONFIG_UNKNOWN_VARIANT
            call.manager::confiscate
            # => [pad(16), pad(16)]
        end
    end
    # => [pad(16), pad(16)]

    # truncate stack
    dropw dropw dropw dropw
    # => [pad(16)]
end
