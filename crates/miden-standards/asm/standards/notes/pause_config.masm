use miden::protocol::active_note
use miden::standards::access::pausable::manager
use miden::standards::attachments::network_account_target

# CONSTANTS
# =================================================================================================

# Memory base at which the note storage is written by `active_note::get_bounded_storage`.
const STORAGE_PTR = 0

# Memory address of the PauseConfig note storage selector.
const SELECTOR_PTR = STORAGE_PTR

# Config note selectors, stored in the first storage item. Keep in sync with `PauseConfig` on the
# Rust side.
const SELECTOR_PAUSE = 0
const SELECTOR_UNPAUSE = 1

# Expected note storage item count per action.
const NUM_ITEMS_PAUSE = 1
const NUM_ITEMS_UNPAUSE = 1

# Largest storage item count any action uses
const MAX_NUM_ITEMS = NUM_ITEMS_PAUSE

# ERRORS
# =================================================================================================

const ERR_PAUSE_CONFIG_TARGET_ACCOUNT_MISMATCH = "pause config note attachment target account does not match the consuming account"

const ERR_PAUSE_CONFIG_UNKNOWN_SELECTOR = "pause config note selector does not match a known action"

const ERR_PAUSE_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS = "pause config note storage item count does not match the selected action"

# NOTE SCRIPT
# =================================================================================================

#! PauseConfig script: triggers a `PausableManager` admin action against the consuming account,
#! dispatched on a selector stored in the first note storage item.
#!
#! The selected action is read from the note storage and is fixed at note creation:
#! - `0` Pause:   `[0]`.
#! - `1` Unpause: `[1]`.
#!
#! Authorization is enforced by the called `PausableManager` procedures via the account-wide
#! `Authority` component (`assert_authorized`); this script only dispatches to them.
#!
#! Requires that the account exposes:
#! - `miden::standards::access::pausable::manager::{pause, unpause}` (the `PausableManager`
#!   component), backed by the `Pausable` and `Authority` companion components.
#!
#! Inputs:  [ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the consuming account is not the note's target account, or the target attachment is missing.
#! - the number of storage items exceeds MAX_NUM_ITEMS.
#! - the selector is not a known action.
#! - the number of storage items does not match the selected action.
#! - the caller is not authorized for the selected action per the installed `Authority` component.
@note_script
pub proc main
    dropw
    # => [pad(16)]

    # bind consumption to the targeted account: reject if the consuming account is not the note's
    # target account
    exec.network_account_target::active_account_matches_target_account
    assert.err=ERR_PAUSE_CONFIG_TARGET_ACCOUNT_MISMATCH
    # => [pad(16)]

    # write the note storage to memory starting at STORAGE_PTR
    push.MAX_NUM_ITEMS push.STORAGE_PTR exec.active_note::get_bounded_storage
    # => [num_storage_items]

    mem_load.SELECTOR_PTR
    # => [selector, num_storage_items]

    # dispatch on the selector to the matching action procedure
    dup eq.SELECTOR_PAUSE
    # => [is_pause, selector, num_storage_items]

    if.true
        drop
        # => [num_storage_items]

        exec.execute_pause
    else
        eq.SELECTOR_UNPAUSE assert.err=ERR_PAUSE_CONFIG_UNKNOWN_SELECTOR
        # => [num_storage_items]

        exec.execute_unpause
    end
    # => [pad(16)]
end

# HELPER PROCEDURES
# =================================================================================================

#! Executes the Pause action: pauses the account.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_PAUSE.
#! - the caller is not authorized per the installed `Authority` component.
#!
#! Invocation: exec
proc execute_pause
    eq.NUM_ITEMS_PAUSE
    assert.err=ERR_PAUSE_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # pad to the empty `pause` input window [pad(16)]
    padw padw padw padw
    # => [pad(16)]

    call.manager::pause
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end

#! Executes the Unpause action: unpauses the account.
#!
#! Inputs:  [num_storage_items]
#! Outputs: []
#!
#! Panics if:
#! - num_storage_items is not NUM_ITEMS_UNPAUSE.
#! - the caller is not authorized per the installed `Authority` component.
#!
#! Invocation: exec
proc execute_unpause
    eq.NUM_ITEMS_UNPAUSE
    assert.err=ERR_PAUSE_CONFIG_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # pad to the empty `unpause` input window [pad(16)]
    padw padw padw padw
    # => [pad(16)]

    call.manager::unpause
    # => [pad(16)]

    # truncate the called procedure's output window, restoring the base stack
    dropw dropw dropw dropw
    # => []
end
