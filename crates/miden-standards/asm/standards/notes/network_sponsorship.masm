use miden::core::word

use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::tx

use miden::standards::attachments::fee_sponsorship
use miden::standards::attachments::network_account_target
use miden::standards::note::note_id
use miden::standards::wallets::basic as basic_wallet

# CONSTANTS
# =================================================================================================

#! The memory address at which the note storage is written.
const STORAGE_PTR = 0

# Note storage layout (3 items, loaded at STORAGE_PTR by get_storage):
# - reclaimer_suffix      [0] : suffix of the account allowed to reclaim the note
# - reclaimer_prefix      [1] : prefix of the account allowed to reclaim the note
# - reclaim_block_height  [2] : block height at or after which the reclaimer may reclaim (0 = disabled)
const RECLAIMER_SUFFIX_ITEM = STORAGE_PTR
const RECLAIMER_PREFIX_ITEM = STORAGE_PTR + 1
const RECLAIM_HEIGHT_ITEM = STORAGE_PTR + 2

#! The number of storage items of a NETWORK_SPONSORSHIP note.
const NUM_STORAGE_ITEMS = 3

#! Local memory offset at which is_bound_feature_note_present stages the bound note ID.
const BOUND_NOTE_ID_LOC = 0

# ERRORS
# =================================================================================================

const ERR_NETWORK_SPONSORSHIP_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS="NETWORK_SPONSORSHIP note expects exactly 3 note storage items"

const ERR_NETWORK_SPONSORSHIP_RECLAIM_DISABLED="NETWORK_SPONSORSHIP reclaim is disabled"

const ERR_NETWORK_SPONSORSHIP_RECLAIM_HEIGHT_NOT_REACHED="failed to reclaim NETWORK_SPONSORSHIP note because the reclaim block height is not reached yet"

const ERR_NETWORK_SPONSORSHIP_RECLAIM_ACCT_IS_NOT_RECLAIMER="failed to reclaim NETWORK_SPONSORSHIP note because the reclaiming account is not the reclaimer"

# HELPER PROCEDURES
# =================================================================================================

#! Returns whether the feature note bound by the active note's fee sponsorship attachment is among
#! the transaction's input notes.
#!
#! This check is what stops a sponsorship note from being consumed on its own. It lives in the
#! note's own script rather than in the consuming account, because the sponsor trusts neither the
#! network account nor the transaction builder; they do, however, choose the note's script root.
#!
#! Every input note's ID is recomputed and compared against the bound ID. No index hint is taken
#! from the note arguments: those are chosen by the consumer, and an incorrect hint would revert a
#! transaction whose feature note is in fact present, handing the builder a griefing vector.
#!
#! Inputs:  []
#! Outputs: [is_found]
#!
#! Panics if:
#! - the active note carries no fee sponsorship attachment.
@locals(4)
proc is_bound_feature_note_present
    exec.fee_sponsorship::active_note_bound_note_id
    loc_storew_le.BOUND_NOTE_ID_LOC dropw
    # => []

    push.0
    # => [is_found]

    exec.tx::get_num_input_notes
    # => [note_idx, is_found]

    dup neq.0
    # => [should_loop, note_idx, is_found]

    while.true
        sub.1
        # => [note_idx, is_found]

        dup exec.note_id::compute_input_note_id
        # => [NOTE_ID, note_idx, is_found]

        padw loc_loadw_le.BOUND_NOTE_ID_LOC
        # => [BOUND_NOTE_ID, NOTE_ID, note_idx, is_found]

        exec.word::eq
        # => [is_match, note_idx, is_found]

        movup.2 or
        # => [is_found, note_idx]

        swap
        # => [note_idx, is_found]

        dup neq.0
        # => [should_loop, note_idx, is_found]
    end
    # => [note_idx, is_found]

    drop
    # => [is_found]
end

#! Returns the sponsorship assets to the reclaimer, provided reclaim is enabled and its block height
#! has been reached.
#!
#! Inputs:  [reclaim_block_height]
#! Outputs: []
#!
#! Where:
#! - reclaim_block_height is the block height at or after which the reclaimer may reclaim the note.
#!   A value of 0 means reclaim is disabled.
#!
#! Panics if:
#! - reclaim is disabled.
#! - the reclaim block height has not been reached.
#! - the active account is not the note's reclaimer.
proc reclaim_note
    dup neq.0 assert.err=ERR_NETWORK_SPONSORSHIP_RECLAIM_DISABLED
    # => [reclaim_block_height]

    exec.tx::get_block_number
    # => [current_block_height, reclaim_block_height]

    lte assert.err=ERR_NETWORK_SPONSORSHIP_RECLAIM_HEIGHT_NOT_REACHED
    # => []

    # only the reclaimer named in the note storage may reclaim it; the creator sets this, defaulting
    # to the sender
    mem_load.RECLAIMER_PREFIX_ITEM mem_load.RECLAIMER_SUFFIX_ITEM
    # => [reclaimer_id_suffix, reclaimer_id_prefix]

    exec.active_account::get_id
    # => [account_id_suffix, account_id_prefix, reclaimer_id_suffix, reclaimer_id_prefix]

    exec.account_id::eq assert.err=ERR_NETWORK_SPONSORSHIP_RECLAIM_ACCT_IS_NOT_RECLAIMER
    # => []

    exec.basic_wallet::add_assets_to_account
    # => []
end

# NOTE SCRIPT
# =================================================================================================

#! NETWORK_SPONSORSHIP script: hands the note's assets to the network account it targets, provided
#! the feature note it sponsors is consumed by the same transaction.
#!
#! The note carries the fee for exactly one feature note, named by the note ID in its fee
#! sponsorship attachment. The feature note itself stays entirely fee-unaware.
#!
#! The sponsorship and the feature note it sponsors must be consumed together. Two checks enforce
#! this, and each sits with the party it protects:
#! - Consuming the sponsorship without its feature note costs the *sponsor*, so this script rejects
#!   it.
#! - Consuming a feature note without sponsorship costs the *account*, so the account's auth
#!   procedure rejects that. It is not this script's concern.
#!
#! If the target account never consumes the note, the reclaimer may reclaim it once the reclaim
#! block height is reached. Once the bound feature note is consumed by some other transaction, the
#! presence check can never pass again and reclaim is the only way to recover the assets. When the
#! reclaimer is also the target (a self-spawning chain sponsoring its own next hop), the same
#! reclaim applies once the feature note can no longer be presented. The reclaimer is named in the
#! note storage; the creator sets it, defaulting to the sender.
#!
#! Requires that the account exposes:
#! - miden::standards::wallets::basic::receive_asset procedure.
#!
#! Inputs:  [NOTE_ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - NOTE_ARGS are the note arguments, which this script ignores.
#!
#! Note storage is assumed to be as follows:
#! - reclaimer_{suffix, prefix} identify the account allowed to reclaim the note.
#! - reclaim_block_height is the block height at or after which the reclaimer may reclaim the note,
#!   or 0 if reclaim is disabled.
#!
#! Panics if:
#! - the number of note storage items is not 3.
#! - the note carries no network account target attachment or no fee sponsorship attachment.
#! - the bound feature note is not consumed alongside the note by its target, and the note cannot
#!   be reclaimed (reclaim is disabled, the reclaim block height is not reached, or the active
#!   account is not the reclaimer).
#! - Account does not expose miden::standards::wallets::basic::receive_asset procedure.
@note_script
pub proc main
    dropw
    # => [pad(16)]

    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_storage_items, pad(16)]

    eq.NUM_STORAGE_ITEMS assert.err=ERR_NETWORK_SPONSORSHIP_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => [pad(16)]

    exec.network_account_target::active_account_matches_target_account
    # => [is_target, pad(16)]

    # only the target scans the input notes for the bound feature note; for anyone else the
    # sponsorship path is closed
    if.true
        exec.is_bound_feature_note_present
        # => [is_present, pad(16)]
    else
        push.0
        # => [is_present = 0, pad(16)]
    end
    # => [is_sponsorship = is_target AND is_present, pad(16)]

    # sponsorship path: the target keeps the assets alongside the feature note it pays for
    if.true
        exec.basic_wallet::add_assets_to_account
        # => [pad(16)]
    else
        # reclaim path: everyone else, including the target without the feature note, may only
        # reclaim the note back to its reclaimer
        mem_load.RECLAIM_HEIGHT_ITEM
        # => [reclaim_block_height, pad(16)]

        exec.reclaim_note
        # => [pad(16)]
    end
    # => [pad(16)]
end
