use miden::protocol::active_account
use miden::protocol::account_id
use miden::protocol::active_note
use miden::protocol::tx
use miden::standards::wallets::basic as basic_wallet

# CONSTANTS
# =================================================================================================

const NUM_STORAGE_ITEMS=6

# Note storage layout (6 felts, loaded at STORAGE_PTR by get_storage):
# - reclaim_authority_suffix  [0]  : suffix of the account allowed to reclaim the note
# - reclaim_authority_prefix  [1]  : prefix of the account allowed to reclaim the note
# - target_suffix             [2]  : suffix of the account for which the note is intended
# - target_prefix             [3]  : prefix of the account for which the note is intended
# - reclaim_block_height      [4]  : block height at which the reclaim authority may reclaim (0 = disabled)
# - timelock_block_height     [5]  : block height before which the note cannot be consumed (0 = none)
#
# The reclaim authority is the account allowed to reclaim the note.
const STORAGE_PTR = 0
const RECLAIM_AUTHORITY_SUFFIX_ITEM = STORAGE_PTR
const RECLAIM_AUTHORITY_PREFIX_ITEM = STORAGE_PTR + 1
const TARGET_SUFFIX_ITEM = STORAGE_PTR + 2
const TARGET_PREFIX_ITEM = STORAGE_PTR + 3
const RECLAIM_HEIGHT_ITEM = STORAGE_PTR + 4
const TIMELOCK_HEIGHT_ITEM = STORAGE_PTR + 5

# ERRORS
# =================================================================================================

const ERR_P2IDE_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS="P2IDE note expects exactly 6 note storage items"

const ERR_P2IDE_RECLAIM_ACCT_IS_NOT_RECLAIM_AUTHORITY="failed to reclaim P2IDE note because the reclaiming account is not the reclaim authority"

const ERR_P2IDE_RECLAIM_HEIGHT_NOT_REACHED="failed to reclaim P2IDE note because the reclaim block height is not reached yet"

const ERR_P2IDE_RECLAIM_DISABLED="P2IDE reclaim is disabled"

const ERR_P2IDE_TIMELOCK_HEIGHT_NOT_REACHED="failed to consume P2IDE note because the note is still timelocked"

# HELPER PROCEDURES
# =================================================================================================

#! Helper procedure to check if the P2IDE note is unlocked.
#!
#! Inputs:  [current_block_height, timelock_block_height]
#! Outputs: [current_block_height]
proc assert_unlocked
    dup movdn.2
    # => [current_block_height, timelock_block_height, current_block_height]

    # check timelock_block_height <= current_block_height
    lte assert.err=ERR_P2IDE_TIMELOCK_HEIGHT_NOT_REACHED
    # => [current_block_height]
end

#! Helper procedure which adds the note assets to the reclaim authority account.
#!
#! Checks if P2IDE reclaim is enabled and if true, if reclaim height has been reached, and that
#! the active account is the note's reclaim authority.
#!
#! Inputs:  [account_id_suffix, account_id_prefix, current_block_height, reclaim_block_height, reclaim_authority_id_suffix, reclaim_authority_id_prefix]
#! Outputs: []
#!
#! Where:
#! - account_id_{suffix,prefix} are the suffix and prefix felts of the active account ID.
#! - current_block_height is the transaction's reference block number.
#! - reclaim_block_height is the block height at which the note becomes reclaimable (0 = reclaim disabled).
#! - reclaim_authority_id_{suffix,prefix} are the suffix and prefix felts of the account ID allowed to reclaim the note.
#!
#! Panics if:
#! - the reclaim of the active note is disabled.
#! - the reclaim block height is not reached yet.
#! - the account attempting to reclaim the note is not the reclaim authority account.
proc reclaim_note
    # check that the reclaim of the active note is enabled
    movup.3 dup neq.0 assert.err=ERR_P2IDE_RECLAIM_DISABLED
    # => [reclaim_block_height, account_id_suffix, account_id_prefix, current_block_height, reclaim_authority_id_suffix, reclaim_authority_id_prefix]

    # now check that reclaim authority is allowed to reclaim, reclaim block height <= current block height
    movup.3
    # => [current_block_height, reclaim_block_height, account_id_suffix, account_id_prefix, reclaim_authority_id_suffix, reclaim_authority_id_prefix]

    lte assert.err=ERR_P2IDE_RECLAIM_HEIGHT_NOT_REACHED
    # => [account_id_suffix, account_id_prefix, reclaim_authority_id_suffix, reclaim_authority_id_prefix]

    # ensure active account ID = reclaim authority account ID
    exec.account_id::eq assert.err=ERR_P2IDE_RECLAIM_ACCT_IS_NOT_RECLAIM_AUTHORITY
    # => []

    # add note assets to account
    exec.basic_wallet::add_assets_to_account
    # => []
end

#! Extended Pay-to-ID note script (Reclaimable & Timelockable)
#!
#! Adds all assets from the note to the account if all of the following conditions are true:
#! - The transaction's reference block number is greater than or equal to the note's timelock block height.
#! - Any of the following conditions is true:
#!   - The account ID against which the transaction is executed matches the note's target account id.
#!   - The account ID against which the transaction is executed matches the note's reclaim authority account id
#!     and the transaction's reference block number is greater than or equal to the note's reclaim block height.
#!
#! Requires that the account exposes:
#! - miden::standards::wallets::basic::receive_asset procedure.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Note storage is assumed to be as follows:
#! - reclaim_authority_account_id is the ID of the account allowed to reclaim the note.
#! - target_account_id is the ID of the account for which the note is intended.
#! - reclaim_block_height is the block height at which the note can be reclaimed by the reclaim authority.
#! - timelock_block_height is the block height at which the note can be consumed by the target.
#!
#! Panics if:
#! - The account does not expose miden::standards::wallets::basic::receive_asset procedure.
#! - The note is consumed before the timelock expired, i.e. the transaction's reference block
#!   number is less than the timelock block height.
#! - Before reclaim block height: the account ID of the executing account is not equal to the target
#!   account ID.
#! - At and after reclaim block height: the account ID of the executing account is not equal to
#!   the target account ID or reclaim authority account ID.
#! - The same non-fungible asset already exists in the account.
#! - Adding a fungible asset would result in an amount overflow, i.e., the total amount would be
#!   greater than 2^63.
@note_script
pub proc main
    # store the note storage to memory starting at STORAGE_PTR
    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_storage_items]

    # make sure the number of storage items is 6
    eq.NUM_STORAGE_ITEMS assert.err=ERR_P2IDE_UNEXPECTED_NUMBER_OF_STORAGE_ITEMS
    # => []

    # read the timelock block height and the current block number, then assert note is unlocked
    mem_load.TIMELOCK_HEIGHT_ITEM exec.tx::get_block_number
    # => [current_block_height, timelock_block_height]

    exec.assert_unlocked
    # => [current_block_height]

    # get active account id
    exec.active_account::get_id
    # => [account_id_suffix, account_id_prefix, current_block_height]

    # duplicate the active account id and load the target account id to compare against
    dup.1 dup.1 mem_load.TARGET_PREFIX_ITEM mem_load.TARGET_SUFFIX_ITEM
    # => [target_account_id_suffix, target_account_id_prefix, account_id_suffix, account_id_prefix, account_id_suffix, account_id_prefix, current_block_height]

    # determine if the active account is the target account
    exec.account_id::eq
    # => [is_target, account_id_suffix, account_id_prefix, current_block_height]

    if.true
        # we can safely consume the note since the active account is the target of the note
        drop drop drop exec.basic_wallet::add_assets_to_account
        # => []

    else
        # load the reclaim authority account ID from note storage
        mem_load.RECLAIM_AUTHORITY_PREFIX_ITEM movdn.3 mem_load.RECLAIM_AUTHORITY_SUFFIX_ITEM movdn.3
        # => [account_id_suffix, account_id_prefix, current_block_height, reclaim_authority_id_suffix, reclaim_authority_id_prefix]

        # load the reclaim block height from note storage
        mem_load.RECLAIM_HEIGHT_ITEM movdn.3
        # => [account_id_suffix, account_id_prefix, current_block_height, reclaim_block_height, reclaim_authority_id_suffix, reclaim_authority_id_prefix]

        # checks if active account is the reclaim authority and if reclaim is enabled
        exec.reclaim_note
        # => []
    end

    # => []
end
