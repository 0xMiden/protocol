use {Uint64} from miden::standards::types
use {AccountId, Asset, AssetAmount, Bool, NoteArgs, NoteRecipient, NoteTag, NoteType} from miden::protocol::types
use miden::core::crypto::hashes::poseidon2
use miden::core::math::u64
use miden::core::math::u128
use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::asset
use {ASSET_SIZE, ASSET_VALUE_MEMORY_OFFSET} from miden::protocol::asset
use {WORD_NUM_ELEMENTS} from miden::protocol::constants
use miden::protocol::note
use {NOTE_TYPE_PRIVATE, NOTE_TYPE_PUBLIC} from miden::protocol::note
use miden::protocol::output_note
use miden::protocol::tx
use miden::standards::assets::fungible_asset
use {MAX_AMOUNT as FUNGIBLE_ASSET_MAX_AMOUNT} from miden::standards::assets::fungible_asset
use miden::standards::note as std_note
use miden::standards::notes::p2id
use miden::standards::notes::tx_fee
use miden::standards::wallets::basic as wallet

# CONSTANTS
# =================================================================================================

const PRIVATE_NUM_STORAGE_ITEMS=13
const PUBLIC_NUM_STORAGE_ITEMS=15
const MAX_NUM_ASSETS = 2
# Outputs without a separate cancellation reserve carry one asset.
const NUM_ASSETS = 1
# P2ID payback storage is [target_id_suffix, target_id_prefix].
const P2ID_NUM_STORAGE_ITEMS = 2
const MAX_U32=0x0000000100000000

# Actions encoded in the note arguments. Public paybacks only accept ACTION_FILL, with
# automatic reclaim when the original creator consumes the order.
const ACTION_FILL = 0
const ACTION_CANCEL = 1

# Attachment scheme used by both PSWAP output notes (payback P2ID + remainder PSWAP).
# Carries the word [amount, order_id, depth, 0]. Mirrors
# StandardNoteAttachment::PswapAttachment in the Rust standards crate.
const PSWAP_ATTACHMENT_SCHEME = 3

# The number of words in the PswapAttachment.
const PSWAP_ATTACHMENT_NUM_WORDS = 1

# Note storage is loaded at STORAGE_PTR by get_bounded_storage. Its layout depends on the
# payback note type, independently of the PSWAP note's own visibility.
#
# Common fields (9 felts):
# - requested_faucet_suffix    [0]  : 1 felt
# - requested_faucet_prefix    [1]  : 1 felt
# - min_requested_amount      [2]  : 1 felt
# - min_fill_step             [3]  : 1 felt
# - payback_note_type         [4]  : 1 felt
# - cancellation_fee_suffix   [5]  : 1 felt
# - cancellation_fee_prefix   [6]  : 1 felt
# - cancellation_fee_amount   [7]  : 1 felt
# - payback_tag               [8]  : 1 felt
#
# Public payback fields (15 felts total):
# - creator_id_suffix         [9]  : 1 felt
# - creator_id_prefix        [10]  : 1 felt
# - fixed_payback_serial  [11..15)  : 4 felts
#
# Private payback fields (13 felts total):
# - payback_recipient     [9..13)  : 4 felts
#
# Where:
# - requested_faucet_suffix: Suffix of the requested asset's faucet AccountId (Felt)
# - requested_faucet_prefix: Prefix of the requested asset's faucet AccountId
#   (AccountIdPrefix as Felt)
# - min_requested_amount: Minimum amount of the requested fungible asset (Felt)
# - min_fill_step: Minimum per-fill amount of the requested asset (Felt); 0 disables the floor
# - payback_note_type: The NoteType used for the P2ID payback note (0 = private, 1 = public)
# - cancellation_fee_{suffix,prefix,amount}: Native fee reserve; all zero when absent
# - creator_id_suffix: The suffix of the original creator's AccountId (Felt)
# - creator_id_prefix: The prefix of the original creator's AccountId (AccountIdPrefix as Felt)
# - fixed_payback_serial: Serial number of the fixed public P2ID recipient (Word)
# - payback_recipient: Digest of the fixed private P2ID recipient (Word); its preimage is
#   retained by the owner and supplied privately for cancellation
# - payback_tag: Explicit discovery tag for payback notes (NoteTag as Felt, fits in u32)
#
# The remainder PSWAP note's own tag is copied from the active note's
# metadata at remainder-creation time (same asset pair, same tag), saving one storage slot.
#
# Shared note-storage buffer, initialized and validated by load_storage before use.
const STORAGE_PTR = 0
const REQUESTED_FAUCET_SUFFIX_ITEM = STORAGE_PTR
const REQUESTED_FAUCET_PREFIX_ITEM = STORAGE_PTR + 1
const MIN_REQUESTED_AMOUNT_ITEM = STORAGE_PTR + 2
const MIN_FILL_STEP_ITEM = STORAGE_PTR + 3
const PAYBACK_NOTE_TYPE_ITEM = STORAGE_PTR + 4
const CANCELLATION_FEE_SUFFIX_ITEM = STORAGE_PTR + 5
const CANCELLATION_FEE_PREFIX_ITEM = STORAGE_PTR + 6
const CANCELLATION_FEE_AMOUNT_ITEM = STORAGE_PTR + 7
const PAYBACK_TAG_ITEM = STORAGE_PTR + 8
const PUBLIC_CREATOR_SUFFIX_ITEM = STORAGE_PTR + 9
const PUBLIC_CREATOR_PREFIX_ITEM = STORAGE_PTR + 10
const PUBLIC_SERIAL_0_ITEM = STORAGE_PTR + 11
const PUBLIC_SERIAL_1_ITEM = PUBLIC_SERIAL_0_ITEM + 1
const PUBLIC_SERIAL_2_ITEM = PUBLIC_SERIAL_0_ITEM + 2
const PUBLIC_SERIAL_3_ITEM = PUBLIC_SERIAL_0_ITEM + 3
const PRIVATE_RECIPIENT_0_ITEM = STORAGE_PTR + 9
const PRIVATE_RECIPIENT_1_ITEM = PRIVATE_RECIPIENT_0_ITEM + 1
const PRIVATE_RECIPIENT_2_ITEM = PRIVATE_RECIPIENT_0_ITEM + 2
const PRIVATE_RECIPIENT_3_ITEM = PRIVATE_RECIPIENT_0_ITEM + 3

# The storage length is retained for remainder creation.
const STORAGE_LENGTH_PTR = STORAGE_PTR + 4 * WORD_NUM_ELEMENTS

# Local memory offsets
# =================================================================================================

# pipe_target_preimage locals (eight elements including storage padding)
const TARGET_PREIMAGE_PTR = 0
const TARGET_PREIMAGE_SUFFIX_LOC = TARGET_PREIMAGE_PTR
const TARGET_PREIMAGE_PREFIX_LOC = TARGET_PREIMAGE_PTR + 1

# calculate_output_amount locals
const CALC_FILL_AMOUNT = 0
const CALC_FILL_REFERENCE = 1

# Procedure locals of load_offered_asset
const OFFERED_ASSETS_PTR = 0
const OFFERED_ASSET_COUNT = MAX_NUM_ASSETS * ASSET_SIZE

# add_cancellation_fee_and_seal_output locals
const EXPECTED_PRIMARY_PTR = 0
const EXPECTED_FEE_PTR = EXPECTED_PRIMARY_PTR + ASSET_SIZE
const EXPECTED_PRIMARY_VALUE_PTR = EXPECTED_PRIMARY_PTR + ASSET_VALUE_MEMORY_OFFSET
const EXPECTED_FEE_VALUE_PTR = EXPECTED_FEE_PTR + ASSET_VALUE_MEMORY_OFFSET
const EXPECTED_NOTE_IDX = EXPECTED_FEE_PTR + ASSET_SIZE

# pay_cancellation_fee locals
const PAY_CANCELLATION_FEE_PTR = 0

# create_payback_note locals
const PAYBACK_NOTE_IDX = 0
const PAYBACK_REQUESTED_FAUCET_SUFFIX = 1
const PAYBACK_REQUESTED_FAUCET_PREFIX = 2
const PAYBACK_AMT_ACCOUNT_FILL = 3
const PAYBACK_AMT_NOTE_FILL = 4

# create_remainder_note locals
const REMAINDER_NOTE_IDX = 0
const REMAINDER_OFFERED_FAUCET_PREFIX = 1
const REMAINDER_OFFERED_FAUCET_SUFFIX = 2
const REMAINDER_AMT_PAYOUT = 3
const REMAINDER_AMT_OFFERED = 4

# execute_pswap locals
const EXEC_AMT_OFFERED = 0
const EXEC_AMT_MIN_REQUESTED = 1
const EXEC_AMT_PAYOUT_TOTAL = 2
const EXEC_AMT_PAYOUT_ACCOUNT_FILL = 3
const EXEC_AMT_PAYOUT_NOTE_FILL = 4
const EXEC_OFFERED_FAUCET_SUFFIX = 5
const EXEC_OFFERED_FAUCET_PREFIX = 6
const EXEC_AMT_REQUESTED_ACCOUNT_FILL = 7
const EXEC_AMT_REQUESTED_NOTE_FILL = 8
const EXEC_AMT_FILL_REFERENCE = 9

# Local memory for the parent's PswapAttachment word [amount, order_id, depth, 0]:
# write the word at PARENT_ATTACHMENT_PTR, read back only the depth at DEPTH_OFFSET.
const PARENT_ATTACHMENT_PTR = 0
const PARENT_ATTACHMENT_DEPTH_OFFSET = 2

# ERRORS
# =================================================================================================

const ERR_PSWAP_WRONG_NUMBER_OF_STORAGE_ITEMS="PSWAP storage length does not match payback visibility"
const ERR_PSWAP_INVALID_PAYBACK_TYPE="PSWAP payback type must be public or private"
const ERR_PSWAP_INVALID_ACTION="PSWAP note arguments contain an invalid action or reserved value"
const ERR_PSWAP_INVALID_PAYBACK_PREIMAGE="PSWAP cancellation preimage does not match the payback recipient"
const ERR_PSWAP_WRONG_NUMBER_OF_ASSETS="PSWAP requires one offered asset and an optional native cancellation reserve"
const ERR_PSWAP_INVALID_CANCELLATION_FEE="PSWAP cancellation reserve is invalid or underfunded"
const ERR_PSWAP_CANCELLATION_FEE_NOT_NATIVE="PSWAP cancellation reserve must use the native fee asset"
const ERR_PSWAP_OFFERED_ASSET_ALTERED="PSWAP offered asset differs from the asset the note was created with"
const ERR_PSWAP_OUTPUT_ALTERED="PSWAP output was altered before sealing"
const ERR_PSWAP_FILL_SUM_OVERFLOW="PSWAP account_fill + note_fill overflows u64"
const ERR_PSWAP_NOT_VALID_ASSET_AMOUNT="PSWAP computed amount exceeds max fungible asset amount"
const ERR_PSWAP_PAYOUT_OVERFLOW="PSWAP payout quotient does not fit in u64"
const ERR_PSWAP_FILL_BELOW_MINIMUM="PSWAP fill amount is below the minimum fill step"
const ERR_PSWAP_ATTACHMENT_INCORRECT_NUMBER_OF_WORDS="PSWAP attachment must consist of exactly one word"
const ERR_PSWAP_PARENT_DEPTH_NOT_U32="PSWAP parent depth carried in the consumed note attachment is not a u32"
const ERR_PSWAP_DEPTH_OVERFLOW="PSWAP lineage depth exceeds u32"

# U64 VALIDATION
# =================================================================================================

#! Asserts that the u64 value represented by [lo, hi] on the stack is a valid fungible asset
#! amount, i.e. <= FUNGIBLE_ASSET_MAX_AMOUNT (2^63 - 2^31).
#!
#! Inputs:  [lo, hi]
#! Outputs: [lo, hi]
#!
#! Panics if the value exceeds FUNGIBLE_ASSET_MAX_AMOUNT.
proc assert_valid_asset_amount(value: Uint64) -> Uint64
    dup.1 dup.1
    # => [lo, hi, lo, hi]

    push.FUNGIBLE_ASSET_MAX_AMOUNT u32split
    # => [max_lo, max_hi, lo, hi, lo, hi]

    exec.u64::lte
    # => [is_lte, lo, hi]

    assert.err=ERR_PSWAP_NOT_VALID_ASSET_AMOUNT
    # => [lo, hi]
end

# PRICE CALCULATION
# =================================================================================================

#! Computes the proportional amount of offered tokens for a given fill amount.
#!
#! Formula: `payout = floor((offered * fill_amount) / fill_reference)`, where the caller passes
#! `fill_reference = max(total_fill, min_requested_amount)` so an over-fill divides by the fill
#! itself (whole offered side) rather than `min_requested_amount` (see `execute_pswap`).
#!
#! The intermediate product `offered * fill_amount` is computed as a full
#! u128 via `u64::widening_mul`, then divided by `fill_reference` (extended to
#! u128) via `u128::div`. This gives exact integer precision with one floor
#! division at the end, each input is safe
#! up to `FungibleAsset::MAX ≈ 2^63`, and the resulting quotient
#! `payout ≤ offered` always fits back in u64 (asserted via the upper-half
#! limb check below).
#!
#! Inputs:  [offered, fill_reference, fill_amount] (offered on top)
#! Outputs: [payout_amount]
#!
@locals(2)
# CALC_FILL_AMOUNT:      this leg's fill amount
# CALC_FILL_REFERENCE: max(total_fill, min_requested_amount) — the fill that maps to the whole offered side
proc calculate_output_amount(
    offered: AssetAmount,
    fill_reference: AssetAmount,
    fill_amount: AssetAmount
) -> AssetAmount
    movup.2 loc_store.CALC_FILL_AMOUNT
    # => [offered, fill_reference]

    swap loc_store.CALC_FILL_REFERENCE
    # => [offered]

    u32split
    # => [off_lo, off_hi]

    loc_load.CALC_FILL_AMOUNT u32split
    # => [fill_lo, fill_hi, off_lo, off_hi]

    exec.u64::widening_mul
    # => [p0, p1, p2, p3]

    loc_load.CALC_FILL_REFERENCE u32split
    # => [fill_ref_lo, fill_ref_hi, p0, p1, p2, p3]

    push.0 movdn.2 push.0 movdn.3
    # => [fill_ref_lo, fill_ref_hi, 0, 0, p0, p1, p2, p3]

    exec.u128::div
    # => [q0, q1, q2, q3]  (quotient, little-endian limbs)

    # assert whether the output fits in u64
    movup.3 eq.0 assert.err=ERR_PSWAP_PAYOUT_OVERFLOW
    # => [q0, q1, q2]

    movup.2 eq.0 assert.err=ERR_PSWAP_PAYOUT_OVERFLOW
    # => [q0, q1]

    exec.assert_valid_asset_amount
    # => [q0, q1]

    # Reconstruct the u64 quotient as a single felt: `q0 + q1 * 2^32`.
    swap mul.MAX_U32 add
    # => [payout_amount]
end

#! Returns the larger of two field elements, compared as unsigned integers. Callers must pass
#! values below the field modulus; asset amounts (<= FUNGIBLE_ASSET_MAX_AMOUNT) always satisfy this.
#!
#! Inputs:  [a, b]
#! Outputs: [max(a, b)]
proc max(a: felt, b: felt) -> felt
    dup.1 dup.1 lt
    # => [b_lt_a, a, b]
    cdrop
    # => [max(a, b)]
end

#! Returns the smaller of two field elements, compared as unsigned integers.
#!
#! Inputs:  [a, b]
#! Outputs: [min(a, b)]
proc min(a: felt, b: felt) -> felt
    dup dup.2 lt
    # => [a_lt_b, a, b]
    cdrop
    # => [min(a, b)]
end

# PAYBACK PREPARATION
# =================================================================================================

#! Loads and validates either storage layout at STORAGE_PTR and saves its length at
#! STORAGE_LENGTH_PTR. Private recipient digests remain opaque.
#!
#! Inputs:  []
#! Outputs: []
proc load_storage()
    push.PUBLIC_NUM_STORAGE_ITEMS push.STORAGE_PTR exec.active_note::get_bounded_storage
    # => [num_storage_items]

    dup u32assert u32gte.PRIVATE_NUM_STORAGE_ITEMS
    assert.err=ERR_PSWAP_WRONG_NUMBER_OF_STORAGE_ITEMS
    dup mem_store.STORAGE_LENGTH_PTR
    # => [num_storage_items]

    mem_load.PAYBACK_NOTE_TYPE_ITEM
    dup eq.NOTE_TYPE_PRIVATE dup.1 eq.NOTE_TYPE_PUBLIC or
    # => [is_valid_payback_type, payback_note_type, num_storage_items]

    assert.err=ERR_PSWAP_INVALID_PAYBACK_TYPE
    # => [payback_note_type, num_storage_items]

    # Validate the selected layout. P2ID preparation commits the creator ID as storage
    # without checking its structure, so output creation does not replace this check.
    # Payback tags are validated by output_note::create.
    if.true
        eq.PUBLIC_NUM_STORAGE_ITEMS assert.err=ERR_PSWAP_WRONG_NUMBER_OF_STORAGE_ITEMS
        # => []

        mem_load.PUBLIC_CREATOR_PREFIX_ITEM mem_load.PUBLIC_CREATOR_SUFFIX_ITEM
        # => [creator_suffix, creator_prefix]

        exec.account_id::validate_structure
        # => []
    else
        eq.PRIVATE_NUM_STORAGE_ITEMS assert.err=ERR_PSWAP_WRONG_NUMBER_OF_STORAGE_ITEMS
        # => []
    end
    # => []

    # Validate the raw faucet ID before create_id adds asset metadata to its suffix.
    # Validating the encoded asset does not validate the original storage field.
    mem_load.REQUESTED_FAUCET_PREFIX_ITEM mem_load.REQUESTED_FAUCET_SUFFIX_ITEM
    # => [requested_faucet_suffix, requested_faucet_prefix]

    exec.account_id::validate_structure
    # => []

    mem_load.MIN_REQUESTED_AMOUNT_ITEM lte.FUNGIBLE_ASSET_MAX_AMOUNT
    # => [is_valid_min_requested_amount]

    assert.err=ERR_PSWAP_NOT_VALID_ASSET_AMOUNT
    # => []

    mem_load.MIN_FILL_STEP_ITEM lte.FUNGIBLE_ASSET_MAX_AMOUNT
    # => [is_valid_min_fill_step]

    assert.err=ERR_PSWAP_NOT_VALID_ASSET_AMOUNT
    # => []

    # Check whether the PSWAP has a prepaid cancellation fee and validate its native asset.
    mem_load.CANCELLATION_FEE_AMOUNT_ITEM neq.0
    # => [has_cancellation_fee]

    if.true
        mem_load.CANCELLATION_FEE_PREFIX_ITEM mem_load.CANCELLATION_FEE_SUFFIX_ITEM
        # => [fee_faucet_suffix, fee_faucet_prefix]

        exec.account_id::validate_structure
        # => []

        exec.load_cancellation_fee
        # => [FEE_ASSET_ID, FEE_ASSET_VALUE]

        exec.tx::get_fee_asset_id assert_eqw.err=ERR_PSWAP_CANCELLATION_FEE_NOT_NATIVE
        # => [FEE_ASSET_VALUE]

        dropw
        # => []
    else
        mem_load.CANCELLATION_FEE_SUFFIX_ITEM assertz.err=ERR_PSWAP_INVALID_CANCELLATION_FEE
        mem_load.CANCELLATION_FEE_PREFIX_ITEM assertz.err=ERR_PSWAP_INVALID_CANCELLATION_FEE
        # => []
    end
    # => []
end

#! Returns creation arguments for the active order's public or private payback.
#! Only public mode registers full recipient details for output creation.
#! Must run after load_storage has populated and validated the active order's storage.
#!
#! Inputs:  []
#! Outputs: [tag, note_type, RECIPIENT]
proc prepare_payback() -> (NoteTag, NoteType, NoteRecipient)
    mem_load.PAYBACK_NOTE_TYPE_ITEM
    # => [payback_note_type]

    if.true
        # Register the fixed public recipient; fill attachments distinguish its outputs.
        mem_load.PUBLIC_SERIAL_3_ITEM mem_load.PUBLIC_SERIAL_2_ITEM
        mem_load.PUBLIC_SERIAL_1_ITEM mem_load.PUBLIC_SERIAL_0_ITEM
        # => [P2ID_SERIAL_NUM]

        mem_load.PAYBACK_NOTE_TYPE_ITEM
        mem_load.PAYBACK_TAG_ITEM
        # => [tag, note_type, P2ID_SERIAL_NUM]

        mem_load.PUBLIC_CREATOR_PREFIX_ITEM mem_load.PUBLIC_CREATOR_SUFFIX_ITEM
        # => [creator_suffix, creator_prefix, tag, note_type, P2ID_SERIAL_NUM]

        exec.p2id::prepare_note
        # => [tag, note_type, RECIPIENT]
    else
        # The recipient starts at an unaligned storage offset.
        mem_load.PRIVATE_RECIPIENT_3_ITEM mem_load.PRIVATE_RECIPIENT_2_ITEM
        mem_load.PRIVATE_RECIPIENT_1_ITEM mem_load.PRIVATE_RECIPIENT_0_ITEM
        # => [RECIPIENT]

        mem_load.PAYBACK_NOTE_TYPE_ITEM mem_load.PAYBACK_TAG_ITEM
        # => [tag, note_type, RECIPIENT]
    end
    # => [tag, note_type, RECIPIENT]
end

# OUTPUT NOTE VALIDATION AND SEALING
# =================================================================================================

#! Checks the completed output's asset, then seals it. Call after all asset callbacks finish.
#! Callbacks cannot replace the asset argument today, but a native issuer's
#! callback can add to the output's balance without changing its asset count, so the full asset
#! commitment must still be checked.
#!
#! The PSWAP attachment is added before callbacks and cannot be replaced or removed.
#! Additional public attachments are allowed before sealing.
#!
#! Inputs:  [EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]
#! Outputs: []
proc validate_and_seal_output_note(expected_asset: Asset, note_idx: u16)
    exec.poseidon2::merge
    # => [EXPECTED_ASSETS_COMMITMENT, note_idx]

    movup.4
    # => [note_idx, EXPECTED_ASSETS_COMMITMENT]

    dup exec.output_note::get_assets_info
    # => [ASSETS_COMMITMENT, num_assets, note_idx, EXPECTED_ASSETS_COMMITMENT]

    movup.4 eq.NUM_ASSETS assert.err=ERR_PSWAP_OUTPUT_ALTERED
    # => [ASSETS_COMMITMENT, note_idx, EXPECTED_ASSETS_COMMITMENT]

    movup.4 movdn.8
    # => [ASSETS_COMMITMENT, EXPECTED_ASSETS_COMMITMENT, note_idx]

    assert_eqw.err=ERR_PSWAP_OUTPUT_ALTERED
    # => [note_idx]

    exec.output_note::seal
    # => []
end

#! Returns the cancellation reserve asset.
#! Reads the reserve fields at STORAGE_PTR. An absent reserve produces a zero-valued asset.
#!
#! Inputs:  []
#! Outputs: [FEE_ASSET_ID, FEE_ASSET_VALUE]
proc load_cancellation_fee() -> Asset
    mem_load.CANCELLATION_FEE_AMOUNT_ITEM
    mem_load.CANCELLATION_FEE_PREFIX_ITEM mem_load.CANCELLATION_FEE_SUFFIX_ITEM
    # => [fee_faucet_suffix, fee_faucet_prefix, fee_amount]

    exec.fungible_asset::create
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE]
end

#! Adds the reserve to an already funded output and checks both assets after callbacks.
#! A zero fee amount skips adding the reserve. Matching faucets merge into one asset.
#!
#! Inputs:  [FEE_ASSET_ID, FEE_ASSET_VALUE, EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]
#! Outputs: []
@locals(17)
proc add_cancellation_fee_and_seal_output(
    fee_asset: Asset,
    expected_asset: Asset,
    note_idx: u16
)
    dup.4 neq.0
    # => [has_cancellation_fee, FEE_ASSET_ID, FEE_ASSET_VALUE,
    #     EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]

    if.true
        locaddr.EXPECTED_FEE_PTR exec.asset::store
        # => [EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]

        locaddr.EXPECTED_PRIMARY_PTR exec.asset::store
        # => [note_idx]

        loc_store.EXPECTED_NOTE_IDX
        # => []

        loc_load.EXPECTED_NOTE_IDX locaddr.EXPECTED_FEE_PTR exec.asset::load
        # => [FEE_ASSET_ID, FEE_ASSET_VALUE, note_idx]

        exec.output_note::add_asset
        # => []

        # Mirror the output's merging of fungible assets from the same faucet.
        padw locaddr.EXPECTED_PRIMARY_PTR mem_loadw_le exec.asset::id_into_faucet_id
        # => [primary_faucet_suffix, primary_faucet_prefix]

        padw locaddr.EXPECTED_FEE_PTR mem_loadw_le exec.asset::id_into_faucet_id
        # => [fee_faucet_suffix, fee_faucet_prefix, primary_faucet_suffix, primary_faucet_prefix]

        exec.account_id::eq
        # => [is_same_faucet]

        if.true
            padw loc_loadw_le.EXPECTED_PRIMARY_VALUE_PTR
            padw loc_loadw_le.EXPECTED_FEE_VALUE_PTR
            # => [FEE_ASSET_VALUE, PRIMARY_ASSET_VALUE]

            exec.fungible_asset::merge
            # => [COMBINED_ASSET_VALUE]

            loc_storew_le.EXPECTED_PRIMARY_VALUE_PTR dropw
            push.NUM_ASSETS
            # => [expected_asset_count = 1]
        else
            push.MAX_NUM_ASSETS
            # => [expected_asset_count = 2]
        end
        # => [expected_asset_count]

        dup mul.ASSET_SIZE locaddr.EXPECTED_PRIMARY_PTR
        # => [expected_assets_ptr, num_elements, expected_asset_count]

        exec.poseidon2::hash_elements
        # => [EXPECTED_ASSETS_COMMITMENT, expected_asset_count]

        loc_load.EXPECTED_NOTE_IDX exec.output_note::get_assets_info
        # => [ASSETS_COMMITMENT, num_assets, EXPECTED_ASSETS_COMMITMENT, expected_asset_count]

        movup.4 movup.9 assert_eq.err=ERR_PSWAP_OUTPUT_ALTERED
        # => [ASSETS_COMMITMENT, EXPECTED_ASSETS_COMMITMENT]

        assert_eqw.err=ERR_PSWAP_OUTPUT_ALTERED
        # => []

        loc_load.EXPECTED_NOTE_IDX exec.output_note::seal
        # => []
    else
        dropw dropw
        # => [EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]

        exec.validate_and_seal_output_note
        # => []
    end
    # => []
end

#! Pays the reserve in full without checking transaction fee sufficiency.
#! A zero fee amount creates no output.
#!
#! Inputs:  [fee_faucet_suffix, fee_faucet_prefix, fee_amount]
#! Outputs: []
@locals(8)
proc pay_cancellation_fee(fee_faucet: AccountId, fee_amount: AssetAmount)
    dup.2 neq.0
    # => [has_cancellation_fee, fee_faucet_suffix, fee_faucet_prefix, fee_amount]

    if.true
        exec.fungible_asset::create
        # => [FEE_ASSET_ID, FEE_ASSET_VALUE]

        locaddr.PAY_CANCELLATION_FEE_PTR exec.asset::store
        # => []

        # Remainders increment serial[3]; paybacks use an independent fixed recipient.
        # Increment serial[2] for the cancellation fee, preserving the remainder's serial[3].
        exec.active_note::get_serial_number
        # => [s0, s1, s2, s3]

        movup.2 add.1 movdn.2
        # => [s0, s1, s2+1, s3]

        exec.tx_fee::create_output_note
        # => [note_idx]

        dup locaddr.PAY_CANCELLATION_FEE_PTR exec.asset::load
        # => [FEE_ASSET_ID, FEE_ASSET_VALUE, note_idx, note_idx]

        exec.output_note::add_asset
        # => [note_idx]

        locaddr.PAY_CANCELLATION_FEE_PTR exec.asset::load
        # => [FEE_ASSET_ID, FEE_ASSET_VALUE, note_idx]

        exec.validate_and_seal_output_note
        # => []
    else
        drop drop drop
        # => []
    end
    # => []
end

# PAYBACK NOTE CREATION PROCEDURE
# =================================================================================================

#! Creates the public or private payback note.
#!
#! Inputs:  [faucet_suffix, faucet_prefix, amt_account_fill, amt_note_fill]
#! Outputs: []
@locals(5)
# PAYBACK_NOTE_IDX                : note_idx
# PAYBACK_REQUESTED_FAUCET_SUFFIX : faucet_suffix
# PAYBACK_REQUESTED_FAUCET_PREFIX : faucet_prefix
# PAYBACK_AMT_ACCOUNT_FILL        : amt_account_fill
# PAYBACK_AMT_NOTE_FILL           : amt_note_fill
proc create_payback_note(
    faucet: AccountId,
    amt_account_fill: AssetAmount,
    amt_note_fill: AssetAmount
)
    loc_store.PAYBACK_REQUESTED_FAUCET_SUFFIX
    loc_store.PAYBACK_REQUESTED_FAUCET_PREFIX
    loc_store.PAYBACK_AMT_ACCOUNT_FILL
    loc_store.PAYBACK_AMT_NOTE_FILL
    # => []

    exec.prepare_payback
    # => [tag, note_type, RECIPIENT]

    push.0 movdn.6 push.0 movdn.6 padw padw swapdw
    # => [tag, note_type, RECIPIENT, pad(10)]

    call.wallet::create_note
    # => [note_idx, pad(15)]

    movdn.15 dropw dropw dropw drop drop drop
    # => [note_idx]

    loc_store.PAYBACK_NOTE_IDX
    # => []

    # The add cannot overflow: `execute_pswap` overflow-checks and validates the fill sum first.
    loc_load.PAYBACK_NOTE_IDX
    # => [note_idx]

    push.0
    # => [0, note_idx]

    exec.get_current_depth
    # => [depth, 0, note_idx]

    exec.get_order_id
    # => [order_id, depth, 0, note_idx]

    loc_load.PAYBACK_AMT_ACCOUNT_FILL loc_load.PAYBACK_AMT_NOTE_FILL add
    # => [total_fill, order_id, depth, 0, note_idx]

    push.PSWAP_ATTACHMENT_SCHEME
    # => [PSWAP_ATTACHMENT_SCHEME, total_fill, order_id, depth, 0, note_idx]

    exec.output_note::add_word_attachment
    # => []

    # Move account_fill_amount from the consumer's vault to the payback note (if > 0)
    loc_load.PAYBACK_AMT_ACCOUNT_FILL neq.0
    # => [has_account_fill]

    if.true
        # create the asset
        loc_load.PAYBACK_AMT_ACCOUNT_FILL
        loc_load.PAYBACK_REQUESTED_FAUCET_PREFIX
        loc_load.PAYBACK_REQUESTED_FAUCET_SUFFIX
        # => [faucet_suffix, faucet_prefix, amt_account_fill]

        exec.fungible_asset::create
        # => [ASSET_ID, ASSET_VALUE]

        # pad the stack for the call
        padw push.0.0.0 loc_load.PAYBACK_NOTE_IDX swapdw
        # => [ASSET_ID, ASSET_VALUE, note_idx, pad(7)]

        call.wallet::move_asset_to_note
        # => [pad(16)]

        dropw dropw dropw dropw
        # => []
    end
    # => []

    # Add note_fill_amount directly to the payback note (no vault debit, if > 0)
    loc_load.PAYBACK_AMT_NOTE_FILL neq.0
    # => [has_note_fill]

    if.true
        loc_load.PAYBACK_NOTE_IDX
        # => [note_idx]

        # create the asset
        loc_load.PAYBACK_AMT_NOTE_FILL
        loc_load.PAYBACK_REQUESTED_FAUCET_PREFIX
        loc_load.PAYBACK_REQUESTED_FAUCET_SUFFIX
        # => [faucet_suffix, faucet_prefix, amt_note_fill, note_idx]

        exec.fungible_asset::create
        # => [ASSET_ID, ASSET_VALUE, note_idx]

        exec.output_note::add_asset
        # => []
    end
    # => []

    loc_load.PAYBACK_NOTE_IDX
    # => [note_idx]

    loc_load.PAYBACK_AMT_ACCOUNT_FILL loc_load.PAYBACK_AMT_NOTE_FILL add
    # => [total_fill, note_idx]

    loc_load.PAYBACK_REQUESTED_FAUCET_PREFIX loc_load.PAYBACK_REQUESTED_FAUCET_SUFFIX
    # => [requested_faucet_suffix, requested_faucet_prefix, total_fill, note_idx]

    exec.fungible_asset::create
    # => [EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]

    loc_load.PAYBACK_AMT_ACCOUNT_FILL loc_load.PAYBACK_AMT_NOTE_FILL add
    # => [total_fill, EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]

    mem_load.MIN_REQUESTED_AMOUNT_ITEM gte
    # => [is_full_fill, EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]

    if.true
        exec.load_cancellation_fee
        # => [FEE_ASSET_ID, FEE_ASSET_VALUE, EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]

        exec.add_cancellation_fee_and_seal_output
        # => []
    else
        exec.validate_and_seal_output_note
        # => []
    end
    # => []
end

# REMAINDER NOTE CREATION PROCEDURE
# =================================================================================================

#! Creates a PSWAP remainder output note for partial fills.
#!
#! Updates the requested amount in note storage, builds a new remainder recipient
#! (using the active note's script root and a serial derived by incrementing the
#! most significant element of the active note's serial number), creates the output
#! note, sets the attachment, adds the remaining offered asset, then verifies and seals the output.
#!
#! Inputs:  [offered_faucet_suffix, offered_faucet_prefix,
#!           amt_payout, amt_offered,
#!           remaining_requested, note_type, tag]
#! Outputs: []
@locals(5)
# REMAINDER_NOTE_IDX             : note_idx
# REMAINDER_OFFERED_FAUCET_SUFFIX : offered_faucet_suffix
# REMAINDER_OFFERED_FAUCET_PREFIX : offered_faucet_prefix
# REMAINDER_AMT_PAYOUT            : amt_payout
# REMAINDER_AMT_OFFERED           : amt_offered
proc create_remainder_note(
    offered_faucet: AccountId,
    amt_payout: AssetAmount,
    amt_offered: AssetAmount,
    remaining_requested: AssetAmount,
    note_type: NoteType,
    tag: NoteTag
)
    # Store offered asset info to locals (top element stored first)
    loc_store.REMAINDER_OFFERED_FAUCET_SUFFIX
    loc_store.REMAINDER_OFFERED_FAUCET_PREFIX
    loc_store.REMAINDER_AMT_PAYOUT
    loc_store.REMAINDER_AMT_OFFERED
    # => [remaining_requested, note_type, tag]

    # Update note storage with new requested amount (needed by compute_and_store_recipient)
    mem_store.MIN_REQUESTED_AMOUNT_ITEM
    # => [note_type, tag]

    # Build PSWAP remainder recipient using the same script as the active note.
    exec.active_note::get_script_root
    # => [SCRIPT_ROOT, note_type, tag]

    # Derive remainder serial: increment most significant element
    exec.active_note::get_serial_number
    # => [s0, s1, s2, s3, SCRIPT_ROOT, note_type, tag]

    movup.3 add.1 movdn.3
    # => [s0, s1, s2, s3+1, SCRIPT_ROOT, note_type, tag]

    # Build recipient from all note storage items (now with updated requested amount)
    mem_load.STORAGE_LENGTH_PTR push.STORAGE_PTR
    # => [storage_ptr, num_storage_items, SERIAL_NUM', SCRIPT_ROOT, note_type, tag]

    exec.note::compute_and_store_recipient
    # => [RECIPIENT, note_type, tag]

    movup.4 movup.5
    # => [tag, note_type, RECIPIENT]

    # Note creation must originate from the account context, so route through the account's
    # `create_note` procedure. Pad the stack for the `call` convention.
    push.0 movdn.6 push.0 movdn.6 padw padw swapdw
    # => [tag, note_type, RECIPIENT, pad(10)]

    call.wallet::create_note
    # => [note_idx, pad(15)]

    movdn.15 dropw dropw dropw drop drop drop
    # => [note_idx]

    dup loc_store.REMAINDER_NOTE_IDX
    # => [note_idx]

    push.0
    # => [0, note_idx]

    exec.get_current_depth
    # => [depth, 0, note_idx]

    exec.get_order_id
    # => [order_id, depth, 0, note_idx]

    loc_load.REMAINDER_AMT_PAYOUT
    # => [amt_payout, order_id, depth, 0, note_idx]

    push.PSWAP_ATTACHMENT_SCHEME
    # => [PSWAP_ATTACHMENT_SCHEME, amt_payout, order_id, depth, 0, note_idx]

    exec.output_note::add_word_attachment
    # => []

    # Add remaining offered asset: remainder_amount = amt_offered - amt_payout.
    # Sub cannot underflow: amt_payout <= amt_offered by construction in
    # `calculate_output_amount`.
    loc_load.REMAINDER_NOTE_IDX
    # => [note_idx]

    loc_load.REMAINDER_AMT_OFFERED loc_load.REMAINDER_AMT_PAYOUT sub
    # => [remainder_amount, note_idx]

    loc_load.REMAINDER_OFFERED_FAUCET_PREFIX
    loc_load.REMAINDER_OFFERED_FAUCET_SUFFIX
    # => [offered_faucet_suffix, offered_faucet_prefix, remainder_amount, note_idx]

    exec.fungible_asset::create
    # => [ASSET_ID, ASSET_VALUE, note_idx]

    exec.output_note::add_asset
    # => []

    loc_load.REMAINDER_NOTE_IDX
    # => [note_idx]

    loc_load.REMAINDER_AMT_OFFERED loc_load.REMAINDER_AMT_PAYOUT sub
    # => [remainder_amount, note_idx]

    loc_load.REMAINDER_OFFERED_FAUCET_PREFIX loc_load.REMAINDER_OFFERED_FAUCET_SUFFIX
    # => [offered_faucet_suffix, offered_faucet_prefix, remainder_amount, note_idx]

    exec.fungible_asset::create
    # => [EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]

    exec.load_cancellation_fee
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]

    exec.add_cancellation_fee_and_seal_output
    # => []
end

#! Recovers and validates the target account ID from a P2ID storage commitment.
#!
#! Inputs:  [STORAGE_COMMITMENT]
#! Outputs: [target_id_suffix, target_id_prefix]
#!
#! Panics if:
#! - the advice map does not contain the two-item storage preimage.
#! - the storage preimage does not match its commitment.
#! - the target account ID has an invalid structure.
#!
#! Invocation: exec
@locals(8)
proc pipe_target_preimage(storage_commitment: word) -> AccountId
    # The storage loader writes eight elements, including padding for the two storage items.
    locaddr.TARGET_PREIMAGE_PTR movdn.4 push.P2ID_NUM_STORAGE_ITEMS movdn.4
    # => [STORAGE_COMMITMENT, num_storage_items, storage_ptr]

    exec.active_note::write_storage_to_memory
    # => []

    loc_load.TARGET_PREIMAGE_PREFIX_LOC loc_load.TARGET_PREIMAGE_SUFFIX_LOC
    # => [target_id_suffix, target_id_prefix]

    dup.1 dup.1 exec.account_id::validate_structure
    # => [target_id_suffix, target_id_prefix]
end

#! Authorizes cancellation using the private P2ID recipient preimage.
#!
#! Inputs:  [EXPECTED_RECIPIENT]
#! Outputs: []
proc authenticate_cancellation(recipient: NoteRecipient)
    # Knowledge of the secret serial authorizes cancellation; the target may be another account.
    exec.std_note::get_recipient_preimage
    # => [SERIAL_NUM, SCRIPT_ROOT, STORAGE_COMMITMENT]

    dropw procref.p2id::main assert_eqw.err=ERR_PSWAP_INVALID_PAYBACK_PREIMAGE
    # => [STORAGE_COMMITMENT]

    exec.pipe_target_preimage
    # => [target_id_suffix, target_id_prefix]

    drop drop
    # => []
end

#! Returns the full remaining order balance in a private P2ID to its committed recipient.
#! Does not add a fill attachment. The reserve funds a separate TX_FEE output.
#!
#! Inputs:  [RECIPIENT, tag]
#! Outputs: []
proc refund_private(recipient: NoteRecipient, tag: NoteTag)
    push.NOTE_TYPE_PRIVATE movup.5
    # => [tag, private_type, RECIPIENT]

    push.0 movdn.6 push.0 movdn.6 padw padw swapdw
    # => [tag, private_type, RECIPIENT, pad(10)]

    call.wallet::create_note
    # => [note_idx, pad(15)]

    movdn.15 dropw dropw dropw drop drop drop
    # => [note_idx]

    exec.load_offered_asset
    # => [ASSET_ID, ASSET_VALUE, note_idx]

    repeat.9
        dup.8
    end
    # => [ASSET_ID, ASSET_VALUE, note_idx, EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]

    exec.output_note::add_asset
    # => [EXPECTED_ASSET_ID, EXPECTED_ASSET_VALUE, note_idx]

    exec.validate_and_seal_output_note
    # => []

    mem_load.CANCELLATION_FEE_AMOUNT_ITEM
    mem_load.CANCELLATION_FEE_PREFIX_ITEM mem_load.CANCELLATION_FEE_SUFFIX_ITEM
    # => [fee_faucet_suffix, fee_faucet_prefix, fee_amount]

    exec.pay_cancellation_fee
    # => []
end

#! Loads the sole input asset and subtracts any cancellation reserve from its amount.
#! The reserve fields at STORAGE_PTR must already be validated. If a reserve is present,
#! the asset must be the native fee asset and leave a positive offered principal.
#!
#! Inputs:  [asset_ptr]
#! Outputs: [ASSET_ID, ASSET_VALUE]
proc load_single_offered_asset(asset_ptr: ptr<Asset>) -> Asset
    exec.asset::load
    # => [ASSET_ID, ASSET_VALUE]

    mem_load.CANCELLATION_FEE_AMOUNT_ITEM neq.0
    # => [has_cancellation_fee, ASSET_ID, ASSET_VALUE]

    if.true
        dupw exec.tx::get_fee_asset_id assert_eqw.err=ERR_PSWAP_INVALID_CANCELLATION_FEE
        # => [ASSET_ID, ASSET_VALUE]

        movup.4 mem_load.CANCELLATION_FEE_AMOUNT_ITEM
        # => [fee_amount, combined_amount, ASSET_ID, value_padding(3)]

        dup.1 dup.1 gt assert.err=ERR_PSWAP_INVALID_CANCELLATION_FEE
        # => [fee_amount, combined_amount, ASSET_ID, value_padding(3)]

        sub movdn.4
        # => [ASSET_ID, ASSET_VALUE]
    end
    # => [ASSET_ID, ASSET_VALUE]
end

#! Loads the offered principal from two input assets after checking the separate reserve.
#! The assets must be stored consecutively at assets_ptr, and the reserve fields at STORAGE_PTR
#! must already be validated.
#!
#! Inputs:  [assets_ptr]
#! Outputs: [ASSET_ID, ASSET_VALUE]
proc load_offered_asset_with_separate_fee(assets_ptr: ptr<Asset>) -> Asset
    mem_load.CANCELLATION_FEE_AMOUNT_ITEM neq.0 assert.err=ERR_PSWAP_WRONG_NUMBER_OF_ASSETS
    # => [assets_ptr]

    dup add.ASSET_SIZE swap
    # => [first_asset_ptr, second_asset_ptr]

    padw dup.4 mem_loadw_le exec.asset::id_into_faucet_id
    # => [first_faucet_suffix, first_faucet_prefix, first_asset_ptr, second_asset_ptr]

    mem_load.CANCELLATION_FEE_PREFIX_ITEM mem_load.CANCELLATION_FEE_SUFFIX_ITEM
    # => [fee_faucet_suffix, fee_faucet_prefix, first_faucet_suffix, first_faucet_prefix,
    #     first_asset_ptr, second_asset_ptr]

    exec.account_id::eq
    # => [is_fee_first, first_asset_ptr, second_asset_ptr]

    if.false
        swap
        # => [fee_asset_ptr, principal_ptr]
    end
    # => [fee_asset_ptr, principal_ptr]

    exec.asset::load exec.load_cancellation_fee
    # => [FEE_ASSET_ID, FEE_ASSET_VALUE, ACTUAL_FEE_ID, ACTUAL_FEE_VALUE, principal_ptr]

    movupw.2 assert_eqw.err=ERR_PSWAP_INVALID_CANCELLATION_FEE
    # => [FEE_ASSET_VALUE, ACTUAL_FEE_VALUE, principal_ptr]

    assert_eqw.err=ERR_PSWAP_INVALID_CANCELLATION_FEE
    # => [principal_ptr]

    exec.asset::load
    # => [ASSET_ID, ASSET_VALUE]
end

#! Verifies the input assets and separates the offered principal from the cancellation reserve.
#!
#! Inputs:  []
#! Outputs: [ASSET_ID, ASSET_VALUE]
@locals(17)
proc load_offered_asset() -> Asset
    exec.active_note::get_initial_assets_info
    # => [INITIAL_ASSETS_COMMITMENT, num_initial_assets]

    movup.4 dup neq.0 assert.err=ERR_PSWAP_WRONG_NUMBER_OF_ASSETS
    dup lte.MAX_NUM_ASSETS assert.err=ERR_PSWAP_WRONG_NUMBER_OF_ASSETS
    # => [num_initial_assets, INITIAL_ASSETS_COMMITMENT]

    loc_store.OFFERED_ASSET_COUNT
    # => [INITIAL_ASSETS_COMMITMENT]

    locaddr.OFFERED_ASSETS_PTR exec.active_note::remove_all_assets
    # => [num_assets, INITIAL_ASSETS_COMMITMENT]

    loc_load.OFFERED_ASSET_COUNT assert_eq.err=ERR_PSWAP_OFFERED_ASSET_ALTERED
    # => [INITIAL_ASSETS_COMMITMENT]

    loc_load.OFFERED_ASSET_COUNT mul.ASSET_SIZE locaddr.OFFERED_ASSETS_PTR
    # => [assets_ptr, num_elements, INITIAL_ASSETS_COMMITMENT]

    exec.poseidon2::hash_elements
    # => [ASSETS_COMMITMENT, INITIAL_ASSETS_COMMITMENT]

    assert_eqw.err=ERR_PSWAP_OFFERED_ASSET_ALTERED
    # => []

    locaddr.OFFERED_ASSETS_PTR
    # => [assets_ptr]

    loc_load.OFFERED_ASSET_COUNT eq.NUM_ASSETS
    # => [is_single_asset, assets_ptr]

    if.true
        exec.load_single_offered_asset
        # => [ASSET_ID, ASSET_VALUE]
    else
        exec.load_offered_asset_with_separate_fee
        # => [ASSET_ID, ASSET_VALUE]
    end
    # => [ASSET_ID, ASSET_VALUE]
end

#! Reclaims a public-payback order into the original creator's vault.
#!
#! Called only after the executing account matches the stored public creator.
#!
#! Inputs:  []
#! Outputs: []
proc handle_reclaim()
    exec.load_offered_asset
    # => [ASSET_ID, ASSET_VALUE]

    # Build 16-element call frame: [ASSET_ID, ASSET_VALUE, pad(8)]
    padw padw swapdw
    # => [ASSET_ID, ASSET_VALUE, pad(8)]

    call.wallet::receive_asset
    # => [pad(16)]

    dropw dropw dropw dropw
    # => []

    mem_load.CANCELLATION_FEE_AMOUNT_ITEM neq.0
    # => [has_cancellation_fee]

    if.true
        exec.load_cancellation_fee
        # => [FEE_ASSET_ID, FEE_ASSET_VALUE]

        padw padw swapdw
        # => [FEE_ASSET_ID, FEE_ASSET_VALUE, pad(8)]

        call.wallet::receive_asset
        # => [pad(16)]

        dropw dropw dropw dropw
        # => []
    end
    # => []
end

#! Returns the PSWAP order_id, taken from the active note's serial[1].
#!
#! serial[1] is stable across PSWAP remainders, which only bump serial[3]. Private paybacks use
#! an independent fixed serial; their attachments carry this order ID.
#!
#! Inputs:  []
#! Outputs: [order_id]
proc get_order_id() -> felt
    exec.active_note::get_serial_number
    # => [s0, s1, s2, s3]

    drop
    # => [s1, s2, s3]

    movdn.2
    # => [s2, s3, s1]

    drop drop
    # => [s1]
end

#! Returns current_depth = parent_depth + 1, where parent_depth is the depth carried in the
#! consumed PSWAP note's PswapAttachment word at offset PARENT_ATTACHMENT_DEPTH_OFFSET if such an
#! attachment exists, or 0 if not (i.e., the parent is the original PSWAP, with scheme none()
#! or NetworkAccountTarget).
#!
#! Inputs:  []
#! Outputs: [current_depth]
#!
#! Panics if:
#! - the PswapAttachment does not consist of exactly PSWAP_ATTACHMENT_NUM_WORDS words.
#! - the parent depth is not a u32.
#! - the incremented depth overflows a u32.
@locals(4)
proc get_current_depth() -> u32
    push.PSWAP_ATTACHMENT_SCHEME
    # => [PSWAP_ATTACHMENT_SCHEME]

    exec.active_note::find_attachment
    # => [is_found, attachment_idx]

    if.true
        locaddr.PARENT_ATTACHMENT_PTR
        # => [dest_ptr, attachment_idx]

        exec.active_note::write_attachment_to_memory
        # => [num_words]

        eq.PSWAP_ATTACHMENT_NUM_WORDS
        assert.err=ERR_PSWAP_ATTACHMENT_INCORRECT_NUMBER_OF_WORDS
        # => []

        loc_load.PARENT_ATTACHMENT_DEPTH_OFFSET
        # => [parent_depth]
    else
        drop push.0
        # => [0]
    end
    # => [parent_depth]

    u32assert.err=ERR_PSWAP_PARENT_DEPTH_NOT_U32
    # => [parent_depth]

    u32overflowing_add.1
    # => [is_overflow, current_depth]

    assertz.err=ERR_PSWAP_DEPTH_OVERFLOW
    # => [current_depth]
end

#! Executes the partially-fillable swap.
#!
#! Sends offered tokens to consumer, requested tokens to the configured P2ID recipient,
#! and creates a remainder note if partially filled.
#!
#! `min_requested_amount` is a minimum, not an exact target. With `total_fill = account_fill +
#! note_fill`:
#! - `total_fill < min_requested_amount`: the consumer takes a proportional share of the offered
#!   side, and a remainder note carries the unfilled balance.
#! - `total_fill >= min_requested_amount`: the whole offered side is paid out and no
#!   remainder is created. The consumer takes the `account_fill` share; any `note_fill` share
#!   goes to the cross-swap counterparty that supplied it. Either way the creator banks the
#!   surplus requested tokens.
#!
#! A per-fill floor rejects any fill below `min(min_fill_step, min_requested_amount)`. Clamping to
#! `min_requested_amount` keeps a shrinking remainder completable, and `min_fill_step == 0` disables
#! the floor.
#!
#! Account fill and note fill payouts are computed separately (rather than summing
#! first) because the account fill portion must be credited to the consumer's vault
#! on its own, while the combined total is needed to size the remainder note.
#!
#! Inputs:  [account_fill_amount, note_fill_amount]
#! Outputs: []
@locals(10)
# EXEC_AMT_OFFERED                : amt_offered
# EXEC_AMT_MIN_REQUESTED          : amt_min_requested
# EXEC_AMT_PAYOUT_TOTAL           : amt_payout (total)
# EXEC_AMT_PAYOUT_ACCOUNT_FILL    : amt_payout_account_fill
# EXEC_AMT_PAYOUT_NOTE_FILL       : amt_payout_note_fill
# EXEC_OFFERED_FAUCET_SUFFIX      : offered_faucet_suffix
# EXEC_OFFERED_FAUCET_PREFIX      : offered_faucet_prefix
# EXEC_AMT_REQUESTED_ACCOUNT_FILL : amt_requested_account_fill
# EXEC_AMT_REQUESTED_NOTE_FILL    : amt_requested_note_fill
# EXEC_AMT_FILL_REFERENCE         : max(total_fill, min_requested_amount)
proc execute_pswap(account_fill_amount: AssetAmount, note_fill_amount: AssetAmount)
    loc_store.EXEC_AMT_REQUESTED_ACCOUNT_FILL
    loc_store.EXEC_AMT_REQUESTED_NOTE_FILL
    # => []

    exec.load_offered_asset
    # => [ASSET_ID, ASSET_VALUE]

    # Extract offered amount
    exec.fungible_asset::to_amount_unchecked
    # => [amount, ASSET_ID, ASSET_VALUE]

    loc_store.EXEC_AMT_OFFERED
    # => [ASSET_ID, ASSET_VALUE]

    # Extract and store offered faucet info from ASSET_ID
    exec.asset::id_into_faucet_id
    # => [faucet_id_suffix, faucet_id_prefix, ASSET_VALUE]

    loc_store.EXEC_OFFERED_FAUCET_SUFFIX loc_store.EXEC_OFFERED_FAUCET_PREFIX
    # => [ASSET_VALUE]

    dropw
    # => []

    # Read the requested minimum directly from note storage
    mem_load.MIN_REQUESTED_AMOUNT_ITEM
    loc_store.EXEC_AMT_MIN_REQUESTED
    # => []

    # Total fill = account_fill + note_fill; user-provided, so overflow-check and validate it.
    loc_load.EXEC_AMT_REQUESTED_ACCOUNT_FILL u32split
    loc_load.EXEC_AMT_REQUESTED_NOTE_FILL u32split
    # => [nf_lo, nf_hi, af_lo, af_hi]

    exec.u64::overflowing_add
    # => [overflow, sum_lo, sum_hi]

    eq.0 assert.err=ERR_PSWAP_FILL_SUM_OVERFLOW
    # => [sum_lo, sum_hi]

    exec.assert_valid_asset_amount
    # => [sum_lo, sum_hi]

    swap mul.MAX_U32 add
    # => [fill_amount]

    # Reject fills below the effective per-fill floor (see the proc doc comment).
    dup
    # => [fill_amount, fill_amount]

    mem_load.MIN_FILL_STEP_ITEM loc_load.EXEC_AMT_MIN_REQUESTED exec.min
    # => [effective_floor, fill_amount, fill_amount]

    lt
    # => [fill_below_floor, fill_amount]

    assertz.err=ERR_PSWAP_FILL_BELOW_MINIMUM
    # => [fill_amount]

    # fill_reference = max(fill, min_requested_amount).
    loc_load.EXEC_AMT_MIN_REQUESTED
    # => [min_requested, fill_amount]

    exec.max
    # => [fill_reference]

    loc_store.EXEC_AMT_FILL_REFERENCE
    # => []

    # Payout for account_fill_amount
    loc_load.EXEC_AMT_REQUESTED_ACCOUNT_FILL
    loc_load.EXEC_AMT_FILL_REFERENCE
    loc_load.EXEC_AMT_OFFERED
    # => [offered, fill_reference, account_fill_amount]

    exec.calculate_output_amount
    # => [account_fill_payout]

    loc_store.EXEC_AMT_PAYOUT_ACCOUNT_FILL
    # => []

    # Payout for note_fill_amount
    loc_load.EXEC_AMT_REQUESTED_NOTE_FILL
    loc_load.EXEC_AMT_FILL_REFERENCE
    loc_load.EXEC_AMT_OFFERED
    # => [offered, fill_reference, note_fill_amount]

    exec.calculate_output_amount
    # => [note_fill_payout]

    loc_store.EXEC_AMT_PAYOUT_NOTE_FILL
    # => []

    # total_payout = account_fill_payout + note_fill_payout
    loc_load.EXEC_AMT_PAYOUT_ACCOUNT_FILL loc_load.EXEC_AMT_PAYOUT_NOTE_FILL add
    # => [total_payout]

    loc_store.EXEC_AMT_PAYOUT_TOTAL
    # => []

    # Create P2ID note carrying the requested asset to the configured recipient. The note's
    # assets are derived from the requested fill amounts (`account_fill +
    # note_fill`), not from `total_payout` (which is the offered asset owed to
    # the consumer). All-zero fill arguments select the requested amount in `fill`.
    loc_load.EXEC_AMT_REQUESTED_NOTE_FILL
    loc_load.EXEC_AMT_REQUESTED_ACCOUNT_FILL
    mem_load.REQUESTED_FAUCET_PREFIX_ITEM
    mem_load.REQUESTED_FAUCET_SUFFIX_ITEM
    # => [faucet_suffix, faucet_prefix, amt_account_fill, amt_note_fill]

    exec.create_payback_note
    # => []

    # Consumer receives only account_fill_payout into vault (not the note_fill portion, if > 0)
    loc_load.EXEC_AMT_PAYOUT_ACCOUNT_FILL neq.0
    # => [has_account_fill_payout]

    if.true
        padw padw
        # => [pad(8)]

        loc_load.EXEC_AMT_PAYOUT_ACCOUNT_FILL
        loc_load.EXEC_OFFERED_FAUCET_PREFIX
        loc_load.EXEC_OFFERED_FAUCET_SUFFIX
        # => [faucet_suffix, faucet_prefix, amt_payout_account_fill, pad(8)]

        exec.fungible_asset::create
        # => [ASSET_ID, ASSET_VALUE, pad(8)]

        call.wallet::receive_asset
        # => [pad(16)]

        dropw dropw dropw dropw
        # => []
    end
    # => []

    # Check if partial fill.
    loc_load.EXEC_AMT_REQUESTED_ACCOUNT_FILL loc_load.EXEC_AMT_REQUESTED_NOTE_FILL add
    loc_load.EXEC_AMT_MIN_REQUESTED
    # => [min_requested, total_in]

    dup.1 dup.1 lt
    # => [is_partial, min_requested, total_in]

    if.true
        # remaining_requested = min_requested - total_in
        swap sub
        # => [remaining_requested]

        exec.active_note::get_metadata
        # => [METADATA, remaining_requested]

        dupw
        # => [METADATA, METADATA, remaining_requested]

        exec.note::metadata_into_tag
        # => [tag, METADATA, remaining_requested]

        movdn.4
        # => [METADATA, tag, remaining_requested]

        exec.note::metadata_into_note_type
        # => [note_type, tag, remaining_requested]

        movup.2
        # => [remaining_requested, note_type, tag]

        loc_load.EXEC_AMT_OFFERED
        loc_load.EXEC_AMT_PAYOUT_TOTAL
        loc_load.EXEC_OFFERED_FAUCET_PREFIX
        loc_load.EXEC_OFFERED_FAUCET_SUFFIX
        # => [offered_faucet_suffix, offered_faucet_prefix,
        #     amt_payout, amt_offered,
        #     remaining_requested, note_type, tag]

        exec.create_remainder_note
        # => []
    else
        drop drop
        # => []
    end
    # => []
end

# ACTION SELECTION
# =================================================================================================

#! Returns whether the executing account is the public payback's creator.
proc is_consumer_creator(creator_id: AccountId) -> Bool
    exec.active_account::get_id
    # => [account_suffix, account_prefix, creator_suffix, creator_prefix]

    exec.account_id::eq
    # => [is_creator]
end

#! Validates the note arguments and returns the action followed by the two fill amounts.
#! The reserved element must be zero, and the action must be ACTION_FILL or ACTION_CANCEL.
#!
#! Inputs:  [action, account_fill, note_fill, reserved]
#! Outputs: [action, account_fill, note_fill]
proc parse_note_args(note_args: NoteArgs) -> (u32, AssetAmount, AssetAmount)
    movup.3
    # => [reserved, action, account_fill, note_fill]

    eq.0 assert.err=ERR_PSWAP_INVALID_ACTION
    # => [action, account_fill, note_fill]

    dup eq.ACTION_FILL dup.1 eq.ACTION_CANCEL or
    # => [is_valid_action, action, account_fill, note_fill]

    assert.err=ERR_PSWAP_INVALID_ACTION
    # => [action, account_fill, note_fill]
end

#! Fills an order using the supplied amounts, with all-zero amounts selecting a full fill.
#!
#! Inputs:  [account_fill, note_fill]
#! Outputs: []
proc fill(account_fill: AssetAmount, note_fill: AssetAmount)
    dup.1 eq.0 dup.1 eq.0 and
    # => [both_zero, account_fill, note_fill]

    if.true
        drop mem_load.MIN_REQUESTED_AMOUNT_ITEM
        # => [account_fill, note_fill]
    end
    # => [account_fill, note_fill]

    exec.execute_pswap
    # => []
end

#! Partially-fillable swap with public creator paybacks or fixed private P2ID paybacks.
#!
#! NOTE_ARGS are [action, account_fill, note_fill, reserved].
#! Action 0 fills; orders with public paybacks retain automatic creator-account reclaim.
#! All-zero amounts select a full fill for other callers. Action 1 cancels orders with private
#! paybacks using a secret P2ID preimage and refunds the full remaining balance to that recipient.
#! The reserved element is zero. Private cancellation requires zero fill amounts.
#!
#! Filling requires basic-wallet create_note, move_asset_to_note and receive_asset procedures.
#! Private cancellation requires create_note; public reclaim requires receive_asset.
#! Consumers: any compatible account may fill or prove a private cancellation preimage.
@note_script
pub proc main(note_args: NoteArgs)
    exec.parse_note_args
    # => [action, account_fill, note_fill]

    exec.load_storage
    # => [action, account_fill, note_fill]

    mem_load.PAYBACK_NOTE_TYPE_ITEM
    # => [payback_note_type, action, account_fill, note_fill]

    if.true
        # Public paybacks only accept the fill action. The original creator reclaims the
        # order; other accounts fill it.
        eq.ACTION_FILL assert.err=ERR_PSWAP_INVALID_ACTION
        # => [account_fill, note_fill]

        mem_load.PUBLIC_CREATOR_PREFIX_ITEM mem_load.PUBLIC_CREATOR_SUFFIX_ITEM
        # => [creator_suffix, creator_prefix, account_fill, note_fill]

        exec.is_consumer_creator
        # => [is_creator, account_fill, note_fill]

        if.true
            drop drop
            # => []

            exec.handle_reclaim
            # => []
        else
            exec.fill
            # => []
        end
        # => []
    else
        eq.ACTION_CANCEL
        # => [is_cancel, account_fill, note_fill]

        if.true
            # Cancellation uses no fill amounts; require their canonical zero encoding.
            eq.0 assert.err=ERR_PSWAP_INVALID_ACTION
            eq.0 assert.err=ERR_PSWAP_INVALID_ACTION
            # => []

            exec.prepare_payback
            # => [tag, private_type, RECIPIENT]

            swap drop movdn.4
            # => [RECIPIENT, tag]

            dupw
            exec.authenticate_cancellation
            # => [RECIPIENT, tag]

            exec.refund_private
            # => []
        else
            exec.fill
            # => []
        end
        # => []
    end
    # => []
end
