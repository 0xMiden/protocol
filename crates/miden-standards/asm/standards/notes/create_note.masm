use {Asset, NoteArgs} from miden::protocol::types
use miden::core::crypto::hashes::poseidon2
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::asset
use miden::protocol::output_note
use miden::protocol::tx
use miden::standards::note::note_reclaim
use miden::standards::note::note_target
use miden::standards::notes::tx_fee
use miden::standards::wallets::basic as wallet

# CONSTANTS
# =================================================================================================

# A zero fee asset disables fee creation.
const NUM_STORAGE_ITEMS = 33
const ACTION_RECLAIM = 1
const STORAGE_PTR = 0
const OUTPUT_RECIPIENT_PTR = 0
const OUTPUT_ID_PTR = 4
const OUTPUT_ASSET_PTR = 8
const INPUT_ASSETS_PTR = 16
const FEE_ASSET_PTR = 20
const FEE_AMOUNT_PTR = 24
const TARGET_SUFFIX_PTR = 28
const TARGET_PREFIX_PTR = 29
const TAG_PTR = 30
const TYPE_PTR = 31
const RECLAIM_HEIGHT_PTR = 32
const PRIMARY_IDX_PTR = 36
const FEE_IDX_PTR = 37
const REMAINING_ASSETS_PTR = 40
# "CREATEFE" separates these serials from other fee note derivations.
const CREATE_NOTE_FEE_DOMAIN = 0x4352454154454645

# ERRORS
# =================================================================================================

const ERR_CREATE_NOTE_WRONG_NUMBER_OF_STORAGE_ITEMS = "CREATE_NOTE storage must contain exactly 33 items"
const ERR_CREATE_NOTE_INVALID_ACTION = "CREATE_NOTE expects create or reclaim with zero reserved arguments"
const ERR_CREATE_NOTE_FUNDING_MISMATCH = "CREATE_NOTE assets do not match the committed funding"
const ERR_CREATE_NOTE_OUTPUT_ALTERED = "CREATE_NOTE output differs from the committed note"
const ERR_CREATE_NOTE_FEE_ASSET_NOT_NATIVE = "CREATE_NOTE fee must use the native fee asset"

# HELPER PROCEDURES
# =================================================================================================

#! Moves a committed asset from the active input to an output.
#!
#! Inputs:  [asset_ptr, note_idx]
#! Outputs: []
#!
#! Invocation: exec
proc fund_output(asset_ptr: ptr<Asset>, note_idx: u16)
    exec.asset::load
    # => [ASSET_ID, ASSET_VALUE, note_idx]
    dupw.1 dupw.1 exec.active_note::remove_asset dropw
    # => [ASSET_ID, ASSET_VALUE, note_idx]
    exec.output_note::add_asset
end

# NOTE SCRIPT
# =================================================================================================

#! Creates one committed output and, when funded, a public TX_FEE output. Both are sealed.
#!
#! Consumers: the committed public account; the original sender may reclaim after its deadline.
#!
#! Inputs:  [action, pad(15)]
#! Outputs: [pad(16)]
#!
#! Action 0 creates the output; action 1 reclaims the request. Reserved arguments must be zero.
@note_script
pub proc main(note_args: NoteArgs)
    movup.3 assertz.err=ERR_CREATE_NOTE_INVALID_ACTION
    movup.2 assertz.err=ERR_CREATE_NOTE_INVALID_ACTION
    swap assertz.err=ERR_CREATE_NOTE_INVALID_ACTION
    dup u32lte.ACTION_RECLAIM assert.err=ERR_CREATE_NOTE_INVALID_ACTION
    # => [action, pad(12)]

    push.NUM_STORAGE_ITEMS push.STORAGE_PTR exec.active_note::get_bounded_storage
    eq.NUM_STORAGE_ITEMS assert.err=ERR_CREATE_NOTE_WRONG_NUMBER_OF_STORAGE_ITEMS
    # => [action, pad(12)]

    if.true
        exec.active_note::get_sender mem_load.RECLAIM_HEIGHT_PTR
        exec.note_reclaim::assert_reclaimable
        exec.wallet::move_note_assets_to_account
    else
        mem_load.TARGET_PREFIX_PTR mem_load.TARGET_SUFFIX_PTR
        exec.note_target::assert_active_account_is_target_account

        exec.active_note::get_initial_assets_info
        # => [ASSETS_COMMITMENT, num_assets, pad(12)]

        movup.4 drop
        padw mem_loadw_le.INPUT_ASSETS_PTR assert_eqw.err=ERR_CREATE_NOTE_FUNDING_MISMATCH

        padw mem_loadw_le.OUTPUT_RECIPIENT_PTR
        mem_load.TYPE_PTR mem_load.TAG_PTR
        # => [tag, note_type, RECIPIENT, pad(12)]

        push.0 movdn.6 push.0 movdn.6 padw padw swapdw
        # => [tag, note_type, RECIPIENT, pad(10), pad(12)]

        call.wallet::create_note
        # => [note_idx, pad(15), pad(12)]

        movdn.15 dropw dropw dropw drop drop drop
        # => [note_idx, pad(12)]

        dup mem_store.PRIMARY_IDX_PTR push.OUTPUT_ASSET_PTR exec.fund_output

        mem_load.FEE_AMOUNT_PTR neq.0
        if.true
            padw mem_loadw_le.FEE_ASSET_PTR exec.tx::get_fee_asset_id
            assert_eqw.err=ERR_CREATE_NOTE_FEE_ASSET_NOT_NATIVE

            # Distinguish requests and output positions without disclosing private request IDs.
            exec.active_account::get_id exec.tx::get_num_output_notes push.CREATE_NOTE_FEE_DOMAIN
            exec.tx::get_input_notes_commitment
            # => [INPUT_NOTES_COMMITMENT, domain, note_idx, account_suffix, account_prefix, pad(12)]

            exec.poseidon2::merge
            # => [FEE_SERIAL, pad(12)]

            exec.tx_fee::create_output_note
            dup mem_store.FEE_IDX_PTR push.FEE_ASSET_PTR exec.fund_output
        end

        push.REMAINING_ASSETS_PTR exec.active_note::remove_all_assets
        assertz.err=ERR_CREATE_NOTE_FUNDING_MISMATCH

        # Validate after all asset callbacks, then seal both outputs against later changes.
        mem_load.PRIMARY_IDX_PTR exec.output_note::compute_note_id
        padw mem_loadw_le.OUTPUT_ID_PTR assert_eqw.err=ERR_CREATE_NOTE_OUTPUT_ALTERED
        mem_load.PRIMARY_IDX_PTR exec.output_note::seal

        mem_load.FEE_AMOUNT_PTR neq.0
        if.true
            mem_load.FEE_IDX_PTR exec.output_note::get_assets_info
            movup.4 eq.1 assert.err=ERR_CREATE_NOTE_OUTPUT_ALTERED
            # => [ASSETS_COMMITMENT, pad(12)]

            push.FEE_ASSET_PTR exec.asset::load exec.poseidon2::merge
            # => [EXPECTED_ASSETS_COMMITMENT, ASSETS_COMMITMENT, pad(12)]

            assert_eqw.err=ERR_CREATE_NOTE_OUTPUT_ALTERED
            mem_load.FEE_IDX_PTR exec.output_note::get_attachments_commitment
            padw assert_eqw.err=ERR_CREATE_NOTE_OUTPUT_ALTERED
            mem_load.FEE_IDX_PTR exec.output_note::seal
        end
    end
end
