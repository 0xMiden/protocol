#! miden::standards::note::note_id
#!
#! Computes output note IDs and finds input notes by ID.
#!
#! Input and active note IDs are exposed directly by `miden::protocol::input_note::get_note_id` and
#! `miden::protocol::active_note::get_note_id`. Output notes have no such accessor, so their ID is
#! computed from the four commitments the kernel exposes, mirroring the kernel's own derivation.

use miden::core::crypto::hashes::poseidon2
use miden::core::word

use miden::protocol::input_note
use miden::protocol::output_note
use miden::protocol::tx

# CONSTANTS
# ================================================================================================

#! Local memory offset at which find_input_note_by_id stages the note ID it searches for.
const TARGET_NOTE_ID_LOC = 0

#! Local memory offset at which find_input_note_by_id stages the index of the matched note.
const MATCHED_INDEX_LOC = 4

# PROCEDURES
# ================================================================================================

#! Computes the note ID from the four note commitments.
#!
#! The note ID is computed as:
#! - NOTE_METADATA_COMMITMENT = hash(METADATA || ATTACHMENTS_COMMITMENT)
#! - NOTE_DETAILS_COMMITMENT  = hash(RECIPIENT || ASSETS_COMMITMENT)
#! - NOTE_ID                  = hash(NOTE_DETAILS_COMMITMENT || NOTE_METADATA_COMMITMENT)
#!
#! Inputs:  [METADATA, ATTACHMENTS_COMMITMENT, RECIPIENT, ASSETS_COMMITMENT]
#! Outputs: [NOTE_ID]
#!
#! Where:
#! - METADATA is the note's metadata word.
#! - ATTACHMENTS_COMMITMENT is the commitment to the note's attachments.
#! - RECIPIENT is the commitment to the note's serial number, script root and storage.
#! - ASSETS_COMMITMENT is the commitment to the note's assets.
#! - NOTE_ID is the resulting note ID.
#!
#! Invocation: exec
proc compute_note_id
    exec.poseidon2::merge
    # => [NOTE_METADATA_COMMITMENT, RECIPIENT, ASSETS_COMMITMENT]

    movdnw.2
    # => [RECIPIENT, ASSETS_COMMITMENT, NOTE_METADATA_COMMITMENT]

    exec.poseidon2::merge
    # => [NOTE_DETAILS_COMMITMENT, NOTE_METADATA_COMMITMENT]

    exec.poseidon2::merge
    # => [NOTE_ID]
end

#! Computes the ID of the output note at the provided index.
#!
#! The returned ID is only final once the note has been fully constructed, that is, once all of its
#! assets and attachments have been added.
#!
#! Inputs:  [note_idx]
#! Outputs: [NOTE_ID]
#!
#! Where:
#! - note_idx is the index of the output note whose ID should be computed.
#! - NOTE_ID is the ID of the specified output note.
#!
#! Panics if:
#! - the note index is greater or equal to the total number of output notes.
#!
#! Invocation: exec
pub proc compute_output_note_id
    dup exec.output_note::get_assets_info
    # => [ASSETS_COMMITMENT, num_assets, note_idx]

    movup.4 drop movup.4
    # => [note_idx, ASSETS_COMMITMENT]

    dup exec.output_note::get_recipient movup.4
    # => [note_idx, RECIPIENT, ASSETS_COMMITMENT]

    dup exec.output_note::get_attachments_commitment movup.4
    # => [note_idx, ATTACHMENTS_COMMITMENT, RECIPIENT, ASSETS_COMMITMENT]

    exec.output_note::get_metadata
    # => [METADATA, ATTACHMENTS_COMMITMENT, RECIPIENT, ASSETS_COMMITMENT]

    exec.compute_note_id
    # => [NOTE_ID]
end

#! Finds the input note with the specified ID among the transaction's input notes.
#!
#! Every input note's ID is compared against the provided ID.
#!
#! Inputs:  [NOTE_ID]
#! Outputs: [is_found, note_idx]
#!
#! Where:
#! - NOTE_ID is the ID of the input note to look for.
#! - is_found is 1 if an input note with the specified ID exists, 0 otherwise.
#! - note_idx is the index of the matching input note; it is only meaningful if is_found is 1.
#!
#! Invocation: exec
@locals(8)
pub proc find_input_note_by_id
    loc_storew_le.TARGET_NOTE_ID_LOC dropw
    # => []

    push.0 loc_store.MATCHED_INDEX_LOC
    # => []

    push.0
    # => [is_found]

    exec.tx::get_num_input_notes
    # => [num_notes, is_found]

    dup neq.0
    # => [should_loop, num_notes, is_found]

    while.true
        # the counter holds the number of notes not yet inspected; the note at counter - 1 is
        # inspected next, so after sub.1 the value doubles as that note's index
        sub.1
        # => [note_idx, is_found]

        dup exec.input_note::get_note_id
        # => [NOTE_ID, note_idx, is_found]

        padw loc_loadw_le.TARGET_NOTE_ID_LOC
        # => [TARGET_NOTE_ID, NOTE_ID, note_idx, is_found]

        exec.word::eq
        # => [is_match, note_idx, is_found]

        if.true
            dup loc_store.MATCHED_INDEX_LOC
            push.1
        else
            push.0
        end
        # => [is_match, note_idx, is_found]

        movup.2 or
        # => [is_found, note_idx]

        swap
        # => [note_idx, is_found]

        dup neq.0
        # => [should_loop, note_idx, is_found]
    end
    # => [note_idx, is_found]

    drop
    # => [is_found]

    loc_load.MATCHED_INDEX_LOC swap
    # => [is_found, note_idx]
end
