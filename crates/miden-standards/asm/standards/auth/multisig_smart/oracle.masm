use miden::core::sys
use miden::protocol::active_account
use miden::protocol::native_account
use miden::protocol::tx

# CONSTANTS
# =================================================================================================

# [oracle_id_prefix, oracle_id_suffix, 0, 0]
const ORACLE_CONFIG_SLOT = word("miden::standards::auth::multisig_smart::oracle_config")

# Procedure root for the configured oracle price reader.
# [proc_root]
const GET_PRICE_PROC_ROOT_SLOT = word("miden::standards::auth::multisig_smart::get_price_proc_root")

#! Updates the oracle account id and the foreign procedure root used by
#! `get_price`.
#!
#! - Stores the oracle id in ORACLE_CONFIG_SLOT as
#!   [oracle_id_prefix, oracle_id_suffix, 0, 0]
#! - Stores the configured foreign price-read procedure root in
#!   GET_PRICE_PROC_ROOT_SLOT as [get_price_proc_root]
#!
#! Inputs:  [oracle_id_prefix, oracle_id_suffix, GET_PRICE_PROC_ROOT]
#! Outputs: []
#!
#! Side effects:
#!   - Writes ORACLE_CONFIG_SLOT
#!   - Writes GET_PRICE_PROC_ROOT_SLOT
#!
#! Locals:
#!
#! 0: oracle_id_prefix
#! 1: oracle_id_suffix
#! 2: get_price_root_w3
#! 3: get_price_root_w2
#! 4: get_price_root_w1
#! 5: get_price_root_w0
@locals(6)
pub proc update_oracle_config_and_proc_root(get_price_proc_root: word)
    # Store `oracle_id_prefix`
    loc_store.0 loc_store.1
    # => [get_price_root_w3, get_price_root_w2, get_price_root_w1, get_price_root_w0]

    # Store the four limbs of `get_price_proc_root` in locals 2..5.
    loc_store.2 loc_store.3 loc_store.4 loc_store.5
    # => []

    # Reconstruct [0, 0, oracle_id_suffix, oracle_id_prefix] for ORACLE_CONFIG_SLOT.
    loc_load.0
    # => [oracle_id_prefix]

    loc_load.1
    # => [oracle_id_suffix, oracle_id_prefix]

    push.0 push.0
    # => [0, 0, oracle_id_suffix, oracle_id_prefix]

    push.ORACLE_CONFIG_SLOT[0..2]
    # => [slot_prefix, slot_suffix, 0, 0, oracle_id_suffix, oracle_id_prefix]

    exec.native_account::set_item
    # => [OLD_WORD]

    dropw
    # => []

    loc_load.5 loc_load.4 loc_load.3 loc_load.2
    # => [get_price_root_w3, get_price_root_w2, get_price_root_w1, get_price_root_w0]

    push.GET_PRICE_PROC_ROOT_SLOT[0..2]
    # => [slot_prefix, slot_suffix, get_price_root_w3, get_price_root_w2, get_price_root_w1, get_price_root_w0]

    exec.native_account::set_item
    # => [OLD_WORD]

    dropw
    # => []
end

#! Reads the configured oracle account id from storage and reorders it into the
#! suffix/prefix layout expected by `tx::execute_foreign_procedure`.
#!
#! Inputs:  []
#! Outputs: [oracle_id_suffix, oracle_id_prefix]
proc get_oracle_id
    push.ORACLE_CONFIG_SLOT[0..2]
    # => [slot_prefix, slot_suffix]

    exec.active_account::get_item
    # => [oracle_id_prefix, oracle_id_suffix, 0, 0]

    movdn.3
    # => [oracle_id_suffix, 0, 0, oracle_id_prefix]

    movdn.3
    # => [0, 0, oracle_id_prefix, oracle_id_suffix]

    drop
    # => [0, oracle_id_prefix, oracle_id_suffix]

    drop
    # => [oracle_id_prefix, oracle_id_suffix]

    swap
    # => [oracle_id_suffix, oracle_id_prefix]
end

#! Reads the configured foreign price-read procedure root from storage.
#!
#! Inputs:  []
#! Outputs: [get_price_proc_root]
proc get_oracle_price_proc_root
    push.GET_PRICE_PROC_ROOT_SLOT[0..2]
    # => [slot_prefix, slot_suffix]

    exec.active_account::get_item
    # => [get_price_proc_root]
end

#! Calls the configured foreign oracle price reader.
#!
#! The foreign procedure is expected to expose a get price interface:
#!   Inputs:  [faucet_id_suffix, faucet_id_prefix, amount]
#!   Outputs: [is_tracked, amount_in_usd]
#! The FPI kernel returns a full 16-element output, and we truncate it
#! back to the logical result shape expected by the spending limit code.
#! 
#! Inputs:  [faucet_id_suffix, faucet_id_prefix, amount]
#! Outputs: [is_tracked, amount_in_usd]
pub proc get_price
    exec.get_oracle_price_proc_root
    # => [get_price_proc_root, faucet_id_suffix, faucet_id_prefix, amount]

    exec.get_oracle_id
    # => [oracle_id_suffix, oracle_id_prefix, get_price_proc_root, faucet_id_suffix, faucet_id_prefix, amount]

    exec.tx::execute_foreign_procedure
    # => [is_tracked, amount_in_usd, foreign_pad(14)]

    exec.sys::truncate_stack
    # => [is_tracked, amount_in_usd]
end
