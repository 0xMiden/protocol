use miden::protocol::active_account
use miden::protocol::tx

# ERRORS
# =================================================================================================

const ERR_U32 = "value is not a u32"
const ERR_EXPIRATION_DELTA_ZERO = "expiration_delta must be non-zero"
const ERR_TX_EXPIRATION_DELTA_NOT_SET = "tx expiration delta must be set"
const ERR_INVALID_NOTE_RESTRICTIONS = "procedure policy note restrictions must be between 0 and 3"

# STORAGE SLOTS
# =================================================================================================

const PROCEDURE_POLICIES_SLOT = word("miden::standards::auth::multisig_smart::procedure_policies")

#! Inputs:  []
#! Outputs: [current_timestamp]
pub proc get_current_timestamp
    exec.tx::get_block_timestamp
    # => [current_timestamp]

    u32assert.err=ERR_U32
    # => [current_timestamp]
end

#! Gets the procedure policy entry for PROC_ROOT from the account's initial state.
#!
#! Inputs:  [PROC_ROOT]
#! Outputs: [immediate_threshold, delayed_threshold, note_restrictions, 0]
#!
#! Where:
#! - PROC_ROOT is the root of the account procedure whose smart policy is being read.
#!
#! Invocation: exec
pub proc get_procedure_policy
    push.PROCEDURE_POLICIES_SLOT[0..2]
    exec.active_account::get_initial_map_item
end

#! Validates that note_restrictions is within the supported 0..=3 range.
#!
#! Inputs:  [note_restrictions]
#! Outputs: []
proc assert_valid_note_restrictions
    dup
    # => [note_restrictions, note_restrictions]

    u32assert.err=ERR_INVALID_NOTE_RESTRICTIONS
    # => [note_restrictions]

    dup u32lte.3
    # => [is_valid_note_restrictions, note_restrictions]

    assert.err=ERR_INVALID_NOTE_RESTRICTIONS
    # => [note_restrictions]

    drop
    # => []
end

#! Returns 1 if WORD == [0,0,0,0], else 0.
#!
#! Inputs:  [WORD]
#! Outputs: [is_empty]
pub proc is_empty_word
    push.0.0.0.0
    # => [0, 0, 0, 0, WORD]

    eqw

    movdn.8
    dropw dropw
    # => [is_empty]
end

#! Applies an expiration delta to the current transaction and verifies it was set.
#!
#! Inputs:  [expiration_delta]
#! Outputs: []
pub proc apply_expiration_delta
    u32assert.err=ERR_U32
    # => [expiration_delta]

    dup eq.0 assertz.err=ERR_EXPIRATION_DELTA_ZERO
    # => [expiration_delta]

    exec.tx::update_expiration_block_delta
    # => []

    exec.tx::get_expiration_block_delta
    # => [tx_expiration_delta]

    dup eq.0 assertz.err=ERR_TX_EXPIRATION_DELTA_NOT_SET
    # => [tx_expiration_delta]

    drop
    # => []
end
