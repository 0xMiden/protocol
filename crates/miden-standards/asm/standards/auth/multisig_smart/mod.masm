use {MAX_NUM_APPROVERS, SignatureThreshold} from miden::standards::auth::multisig
use {AccountProcedureRoot, BlockNumber} from miden::protocol::types
use miden::protocol::active_account
use miden::protocol::native_account
use {AUTH_UNAUTHORIZED_EVENT} from miden::protocol::auth
use miden::standards::auth
use miden::standards::auth::multisig
use {APPROVER_PUBLIC_KEYS_SLOT} from miden::standards::auth::multisig
use {APPROVER_SCHEME_ID_SLOT} from miden::standards::auth::multisig
use {THRESHOLD_CONFIG_SLOT} from miden::standards::auth::multisig
use miden::standards::auth::signature
use miden::standards::auth::tx_policy
use {TX_PROPOSALS_SLOT} from miden::standards::auth::multisig_smart::delayed_execution

pub mod delayed_execution

pub type ProcedurePolicy = struct {
    immediate: SignatureThreshold,
    delayed: SignatureThreshold,
    note_restrictions: u8
}

# STORAGE SLOTS
# =================================================================================================

# Map: PROC_ROOT => smart per-procedure policy word.
const PROCEDURE_POLICIES_SLOT = word("miden::standards::auth::multisig_smart::procedure_policies")

# UNREACHABLE THRESHOLD
# =================================================================================================

# A threshold no signature count can reach: the signer set holds at most MAX_NUM_APPROVERS
# approvers, so at most that many signatures verify. A called procedure contributes it for an
# execution path its policy does not allow, which closes that path through the ordinary threshold
# maximum without any extra flag.
pub const UNREACHABLE_THRESHOLD = MAX_NUM_APPROVERS + 1

# NOTE RESTRICTIONS
# =================================================================================================

# Bit-encoded ProcedurePolicyNoteRestriction enum:
#   0b00 = None, 0b01 = NoInputNotes, 0b10 = NoOutputNotes, 0b11 = NoInputOrOutputNotes.
# The bit-encoding lets us OR per-procedure restrictions together to compute their union.
const NOTE_RESTRICTION_INPUT_NOTES_MASK = 1

const NOTE_RESTRICTION_OUTPUT_NOTES_MASK = 2

# Highest valid note restriction enum value (NoInputOrOutputNotes = 0b11).
const NOTE_RESTRICTION_MAX = 3

# ERRORS
# =================================================================================================

const ERR_ZERO_IN_MULTISIG_CONFIG = "number of approvers or threshold must not be zero"

const ERR_PROC_POLICY_INVALID_MODE = "called procedures leave no execution path open"

const ERR_DELAYED_THRESHOLD_EXCEEDS_IMMEDIATE = "delayed threshold cannot exceed immediate threshold"

const ERR_NOTE_RESTRICTIONS_REQUIRE_THRESHOLD = "procedure policy note restrictions require an immediate or delayed threshold"

const ERR_NUM_APPROVERS_OR_PROC_THRESHOLD_NOT_U32 = "number of approvers and procedure threshold must be u32"

const ERR_PROC_THRESHOLD_EXCEEDS_NUM_APPROVERS = "procedure threshold exceeds new number of approvers"

const ERR_INVALID_NOTE_RESTRICTIONS = "procedure policy note restrictions must be between 0 and 3"

const ERR_INSUFFICIENT_SIGNATURES = "insufficient number of signatures"

const ERR_PROC_ROOT_NOT_IN_ACCOUNT = "procedure root is not one of the account's procedures"

const ERR_PROC_POLICY_ON_DELAY_ACTION = "procedure policies cannot be set on propose_transaction or cancel_transaction_proposal"

# LOCAL ADDRESSES (set_procedure_policy)
# =================================================================================================

const IMMEDIATE_THRESHOLD_LOC = 0
const DELAYED_THRESHOLD_LOC = 1
const NOTE_RESTRICTIONS_LOC = 2

# LOCAL ADDRESSES (compute_called_proc_policy)
# =================================================================================================

const DEFAULT_THRESHOLD_LOC = 0

# LOCAL ADDRESSES (update_signers_and_threshold)
# =================================================================================================

const NEW_NUM_OF_APPROVERS_LOC = 0
const INIT_NUM_OF_APPROVERS_LOC = 1

# LOCAL ADDRESSES (auth_tx)
# =================================================================================================

const AUTH_TX_IMMEDIATE_THRESHOLD_LOC = 0
const AUTH_TX_DELAYED_THRESHOLD_LOC = 1
const AUTH_TX_APPROVAL_EXPIRATION_LOC = 2

# PUBLIC INTERFACE
# =================================================================================================

#! Sets or clears a smart per-procedure policy.
#!
#! Rewriting a policy weakens whatever it protects, so this procedure should carry a policy at
#! least as strong as the strongest policy in the map. Left unpolicied, the default threshold
#! suffices to replace any stricter policy and then call its procedure at the default threshold.
#!
#! Inputs:  [immediate_threshold, delayed_threshold, note_restrictions, PROC_ROOT]
#! Outputs: []
#!
#! Where:
#! - immediate_threshold is the threshold for direct execution, or 0 when disabled.
#! - delayed_threshold is the threshold for delayed execution, or 0 when disabled.
#! - note_restrictions is the note restriction enum value in the 0..=NOTE_RESTRICTION_MAX range.
#! - PROC_ROOT is the root of the account procedure whose policy is being updated.
#!
#! Panics if:
#! - immediate_threshold or delayed_threshold is not a u32 value.
#! - note_restrictions is outside the supported range.
#! - either threshold exceeds the current number of approvers.
#! - delayed_threshold exceeds immediate_threshold when immediate_threshold is non-zero.
#! - note_restrictions is non-zero while both thresholds are zero.
#! - PROC_ROOT is not one of the account's procedures.
#! - PROC_ROOT is `propose_transaction` or `cancel_transaction_proposal`, whose policies the auth
#!   procedure would ignore (`ERR_PROC_POLICY_ON_DELAY_ACTION`).
#!
#! Invocation: call
@locals(3)
@account_procedure
pub proc set_procedure_policy(policy: ProcedurePolicy, proc_root: AccountProcedureRoot)
    loc_store.IMMEDIATE_THRESHOLD_LOC
    # => [delayed_threshold, note_restrictions, PROC_ROOT]

    loc_store.DELAYED_THRESHOLD_LOC
    # => [note_restrictions, PROC_ROOT]

    loc_store.NOTE_RESTRICTIONS_LOC
    # => [PROC_ROOT]

    # ----- Validate immediate_threshold <= num_approvers (preserving num_approvers for the
    # delayed check that follows). -----
    exec.get_current_num_approvers
    # => [num_approvers, PROC_ROOT]

    dup loc_load.IMMEDIATE_THRESHOLD_LOC swap
    # => [num_approvers, immediate_threshold, num_approvers, PROC_ROOT]

    u32assert2.err=ERR_NUM_APPROVERS_OR_PROC_THRESHOLD_NOT_U32
    u32gt assertz.err=ERR_PROC_THRESHOLD_EXCEEDS_NUM_APPROVERS
    # => [num_approvers, PROC_ROOT]

    # ----- Validate delayed_threshold <= num_approvers (consumes num_approvers). -----
    loc_load.DELAYED_THRESHOLD_LOC swap
    # => [num_approvers, delayed_threshold, PROC_ROOT]

    u32assert2.err=ERR_NUM_APPROVERS_OR_PROC_THRESHOLD_NOT_U32
    u32gt assertz.err=ERR_PROC_THRESHOLD_EXCEEDS_NUM_APPROVERS
    # => [PROC_ROOT]

    # ----- Validate note_restrictions is in 0..=NOTE_RESTRICTION_MAX. -----
    loc_load.NOTE_RESTRICTIONS_LOC
    exec.assert_valid_note_restrictions
    # => [PROC_ROOT]

    # ----- Validate (immediate, delayed, note_restrictions) shape. -----
    # `if.true` consumes its boolean condition, so the body branches operate on `[PROC_ROOT]`
    # without any leading `drop`.
    loc_load.IMMEDIATE_THRESHOLD_LOC eq.0
    # => [is_immediate_threshold_zero, PROC_ROOT]

    if.true
        # immediate is zero. With a delayed threshold this is a delay-only policy and restrictions
        # are fine. With neither threshold it is the cleared policy, which must not carry note
        # restrictions: there is no restrictions-only policy (a called procedure without thresholds
        # falls back to the default threshold), and the all-zero word is what marks an entry as
        # cleared.
        loc_load.DELAYED_THRESHOLD_LOC neq.0
        loc_load.NOTE_RESTRICTIONS_LOC eq.0
        or assert.err=ERR_NOTE_RESTRICTIONS_REQUIRE_THRESHOLD
        # => [PROC_ROOT]
    else
        # immediate is non-zero. Validate delayed_threshold <= immediate_threshold.
        loc_load.DELAYED_THRESHOLD_LOC loc_load.IMMEDIATE_THRESHOLD_LOC
        # => [immediate_threshold, delayed_threshold, PROC_ROOT]

        u32assert2.err=ERR_NUM_APPROVERS_OR_PROC_THRESHOLD_NOT_U32
        u32gt assertz.err=ERR_DELAYED_THRESHOLD_EXCEEDS_IMMEDIATE
        # => [PROC_ROOT]
    end

    # ----- Validate PROC_ROOT is one of the account's procedures. -----
    dupw exec.active_account::has_procedure
    assert.err=ERR_PROC_ROOT_NOT_IN_ACCOUNT
    # => [PROC_ROOT]

    # ----- Reject the delay actions: a propose/cancel transaction takes the dispatch branch of
    # `auth_tx` that never consults procedure policies, so a policy on these roots would be accepted
    # but silently ignored. -----
    procref.delayed_execution::propose_transaction eqw
    # => [is_propose, PROPOSE_ROOT, PROC_ROOT]

    movdn.4 dropw movdn.4
    # => [PROC_ROOT, is_propose]

    procref.delayed_execution::cancel_transaction_proposal eqw
    # => [is_cancel, CANCEL_ROOT, PROC_ROOT, is_propose]

    movdn.4 dropw
    # => [is_cancel, PROC_ROOT, is_propose]

    movup.5 or assertz.err=ERR_PROC_POLICY_ON_DELAY_ACTION
    # => [PROC_ROOT]

    # ----- Write [immediate, delayed, note_restrictions, 0] to PROCEDURE_POLICIES_SLOT[PROC_ROOT].
    push.0
    loc_load.NOTE_RESTRICTIONS_LOC
    loc_load.DELAYED_THRESHOLD_LOC
    loc_load.IMMEDIATE_THRESHOLD_LOC
    # => [immediate_threshold, delayed_threshold, note_restrictions, 0, PROC_ROOT]

    swapw
    # => [PROC_ROOT, immediate_threshold, delayed_threshold, note_restrictions, 0]

    push.PROCEDURE_POLICIES_SLOT[0..2]
    # => [procedure_policies_slot_suffix, procedure_policies_slot_prefix, PROC_ROOT, POLICY_WORD]

    exec.native_account::set_map_item
    # => [OLD_POLICY_WORD]

    dropw
    # => []
end

#! Updates threshold config, approvers, and approver scheme ids for smart multisig accounts.
#!
#! Same advice map and config layout as [`multisig::update_signers_and_threshold`]. Differs by
#! validating smart procedure policies ([`assert_proc_policies_lte_num_approvers`]) instead
#! of per-procedure threshold overrides.
#!
#! Note: like [`multisig::update_signers_and_threshold`], this procedure does NOT re-scale existing
#! smart procedure policies. Their immediate/delayed thresholds are absolute signature counts, not
#! ratios, and `assert_proc_policies_lte_num_approvers` only enforces the reachability bound
#! (`threshold <= num_approvers`). Growing the signer set silently lowers the effective signing ratio
#! of every policy; operators must re-evaluate and, where appropriate, raise the affected policies in
#! the same transaction that grows the signer set.
#!
#! Inputs:
#!   Operand stack: [MULTISIG_CONFIG_COMMITMENT, pad(12)]
#! Outputs:
#!   Operand stack: []
#!
#! Panics if:
#! - the new threshold exceeds the new number of approvers.
#! - the new threshold or number of approvers is zero.
#! - any existing smart procedure policy becomes unreachable under the new number of approvers.
#! - any provided scheme identifier word is malformed.
#!
#! Locals:
#! 0: new_num_of_approvers
#! 1: init_num_of_approvers
#!
#! Invocation: call
@locals(2)
@account_procedure
pub proc update_signers_and_threshold(multisig_config_commitment: word)
    # The signer configuration is read from the advice provider without an inline hash check. Every
    # value written below via set_item / set_map_item is folded into ACCOUNT_DELTA_COMMITMENT, which
    # is part of the TX_SUMMARY_COMMITMENT the current signers sign, so a substituted configuration
    # produces a different delta commitment and thus a summary the current signers never signed. The
    # same applies to the per-signer loads in the loop below.
    adv.push_mapval
    # => [MULTISIG_CONFIG_COMMITMENT, pad(12)]

    adv_loadw
    # => [MULTISIG_CONFIG, pad(12)]

    # store new_num_of_approvers for later
    exec.multisig_config_to_num_approvers loc_store.NEW_NUM_OF_APPROVERS_LOC
    # => [MULTISIG_CONFIG, pad(12)]

    dup dup.2
    # => [num_approvers, threshold, MULTISIG_CONFIG, pad(12)]

    # make sure that the threshold is reachable with the number of approvers
    exec.multisig::assert_threshold_is_reachable
    # => [MULTISIG_CONFIG, pad(12)]

    dup dup.2
    # => [num_approvers, threshold, MULTISIG_CONFIG, pad(12)]

    eq.0 assertz.err=ERR_ZERO_IN_MULTISIG_CONFIG
    eq.0 assertz.err=ERR_ZERO_IN_MULTISIG_CONFIG
    # => [MULTISIG_CONFIG, pad(12)]

    loc_load.NEW_NUM_OF_APPROVERS_LOC
    # => [num_approvers, MULTISIG_CONFIG, pad(12)]

    dup exec.multisig::assert_num_approvers_in_bounds
    # => [num_approvers, MULTISIG_CONFIG, pad(12)]

    exec.assert_proc_policies_lte_num_approvers
    # => [MULTISIG_CONFIG, pad(12)]

    push.THRESHOLD_CONFIG_SLOT[0..2]
    # => [config_slot_suffix, config_slot_prefix, MULTISIG_CONFIG, pad(12)]

    exec.native_account::set_item
    # => [OLD_THRESHOLD_CONFIG, pad(12)]

    # Save the old num_of_approvers for the post-loop scheme/pubkey cleanup, then drop the rest
    # of OLD_THRESHOLD_CONFIG.
    drop loc_store.INIT_NUM_OF_APPROVERS_LOC drop drop
    # => [pad(12)]

    loc_load.NEW_NUM_OF_APPROVERS_LOC
    # => [num_approvers, pad(12)]

    dup neq.0
    while.true
        sub.1
        # => [i-1, pad(12)]

        dup exec.signature::create_approver_map_key
        # => [APPROVER_MAP_KEY, i-1, pad(12)]

        padw adv_loadw
        # => [PUB_KEY, APPROVER_MAP_KEY, i-1, pad(12)]

        swapw
        # => [APPROVER_MAP_KEY, PUB_KEY, i-1, pad(12)]

        push.APPROVER_PUBLIC_KEYS_SLOT[0..2]
        # => [pub_key_slot_suffix, pub_key_slot_prefix, APPROVER_MAP_KEY, PUB_KEY, i-1, pad(12)]

        exec.native_account::set_map_item
        # => [OLD_VALUE, i-1, pad(12)]

        adv_loadw
        # => [SCHEME_ID_WORD, i-1, pad(12)]

        exec.auth::signature::assert_supported_scheme_word
        # => [SCHEME_ID_WORD, i-1, pad(12)]

        dup.4 exec.signature::create_approver_map_key
        # => [APPROVER_MAP_KEY, SCHEME_ID_WORD, i-1, pad(12)]

        push.APPROVER_SCHEME_ID_SLOT[0..2]
        # => [scheme_id_slot_id_suffix, scheme_id_slot_id_prefix, APPROVER_MAP_KEY, SCHEME_ID_WORD, i-1, pad(12)]

        exec.native_account::set_map_item
        # => [OLD_VALUE, i-1, pad(12)]

        dropw
        # => [i-1, pad(12)]

        dup neq.0
        # => [is_non_zero, i-1, pad(12)]
    end
    # => [pad(13)]

    drop
    # => [pad(12)]

    # assert all approver public keys are unique.
    loc_load.NEW_NUM_OF_APPROVERS_LOC
    exec.multisig::assert_unique_approver_public_keys
    # => [pad(12)]

    loc_load.NEW_NUM_OF_APPROVERS_LOC loc_load.INIT_NUM_OF_APPROVERS_LOC
    # => [init_num_of_approvers, new_num_of_approvers, pad(12)]

    exec.multisig::cleanup_pubkey_and_scheme_id_mapping
    # => [pad(12)]
end

# PUBLIC HELPERS
# =================================================================================================

#! Gets the procedure policy entry for PROC_ROOT from the account's initial state.
#!
#! Inputs:  [PROC_ROOT]
#! Outputs: [immediate_threshold, delayed_threshold, note_restrictions]
#!
#! Where:
#! - PROC_ROOT is the root of the account procedure whose smart policy is being read.
#! - immediate_threshold is the threshold for direct execution, or 0 when disabled.
#! - delayed_threshold is the threshold for delayed execution, or 0 when disabled.
#! - note_restrictions is the note restriction enum value in the 0..=NOTE_RESTRICTION_MAX range.
#!
#! Invocation: exec
pub proc get_procedure_policy(proc_root: AccountProcedureRoot) -> (SignatureThreshold, SignatureThreshold, u8)
    push.PROCEDURE_POLICIES_SLOT[0..2]
    exec.native_account::get_initial_map_item
    # => [immediate_threshold, delayed_threshold, note_restrictions, 0]

    movup.3 drop
    # => [immediate_threshold, delayed_threshold, note_restrictions]
end

#! Enforces note_restrictions against the current transaction.
#!
#! `note_restrictions` is treated as a bit set (see `NOTE_RESTRICTION_*_MASK`):
#! - bit 0 (mask 1) → forbid input notes
#! - bit 1 (mask 2) → forbid output notes
#!
#! Inputs:  [note_restrictions]
#! Outputs: []
#!
#! Invocation: exec
pub proc enforce_note_restrictions(note_restrictions: u8)
    dup u32and.NOTE_RESTRICTION_INPUT_NOTES_MASK eq.NOTE_RESTRICTION_INPUT_NOTES_MASK
    # => [has_input_note_restriction, note_restrictions]

    if.true
        exec.tx_policy::assert_no_input_notes
    end
    # => [note_restrictions]

    u32and.NOTE_RESTRICTION_OUTPUT_NOTES_MASK eq.NOTE_RESTRICTION_OUTPUT_NOTES_MASK
    # => [has_output_note_restriction]

    if.true
        exec.tx_policy::assert_no_output_notes
    end
    # => []
end

#! Authenticate a transaction using multisig smart-policy rules.
#!
#! The transaction summary this procedure builds has the layout documented on
#! `miden::standards::auth::multisig::auth_tx`.
#!
#! Inputs:
#!   Operand stack: [bound_block_num, approval_expiration_block_num, SALT]
#! Outputs:
#!   Operand stack: [TX_SUMMARY_COMMITMENT]
#!
#! Where:
#! - bound_block_num, approval_expiration_block_num and SALT are as described in
#!   `miden::standards::auth::multisig::auth_tx`.
#!
#! A propose/cancel transaction (delayed-execution timelock action) verifies its own signatures
#! inside the called procedure, so this procedure only asserts that nothing else was bundled with
#! it. Every other transaction is treated as an execution: the called procedures' policies yield one
#! threshold per execution path, the signatures are verified, and the path is selected from their
#! count. Signatures reaching the immediate threshold execute at once; otherwise signatures reaching
#! the delayed threshold execute through the timelock, which requires an unlocked proposal for this
#! transaction. A proposal can therefore only open the cheaper delayed path, never close the
#! immediate one: a transaction with enough signatures for immediate execution runs whether or not
#! someone proposed it.
#!
#! Locals:
#! 0: immediate_threshold
#! 1: delayed_threshold
#! 2: approval_expiration_block_num
#!
#! Invocation: exec
#!
#! NOTE: This procedure is a temporary form covering signer verification, per-procedure policy
#! enforcement, and delayed execution. The following section will be added:
#! - Spending Limits + Amount-Based Thresholds: a prologue that calls
#!   `exec.spending_limits::compute_spending_policy` to derive a spending-derived threshold and
#!   `spending_requires_delay` flag, and combines it via `u32max` with `policy_threshold` before
#!   the final `compute_tx_threshold` fallback.
@locals(3)
pub proc auth_tx(
    bound_block_num: BlockNumber,
    approval_expiration_block_num: BlockNumber,
    salt: word
)
    exec.native_account::incr_nonce drop
    # => [bound_block_num, approval_expiration_block_num, SALT]

    # The summary below consumes the approval deadline; keep it for the delayed-execution branch,
    # which requires one.
    dup.1 loc_store.AUTH_TX_APPROVAL_EXPIRATION_LOC
    # => [bound_block_num, approval_expiration_block_num, SALT]

    # ------ Computing transaction summary ------

    push.0 movdn.2
    # => [bound_block_num, approval_expiration_block_num, 0, SALT]

    # the commitment to the tx summary is the message that is signed; the preimage is inserted into
    # the advice map for extraction by the host. Binding a caller-chosen block (rather than the tx
    # reference block) keeps this commitment stable between the block a delayed action is proposed at
    # and the later block it is executed at, so the same commitment keys the proposal across both.
    exec.auth::get_tx_summary_commitment
    # => [TX_SUMMARY_COMMITMENT]

    # ------ Dispatch ------
    # A propose/cancel transaction verifies its own signatures inside the called procedure, so the
    # auth procedure only enforces that nothing else was bundled with it. Any other transaction is
    # treated as an execution and runs the full checks below.
    exec.delayed_execution::was_propose_or_cancel_called
    # => [was_propose_or_cancel, TX_SUMMARY_COMMITMENT]

    if.true
        # A delay action must be the only non-auth procedure called, otherwise it could be bundled
        # with a state-mutating procedure to bypass the timelock.
        exec.tx_policy::assert_only_one_non_auth_procedure_called
        # => [TX_SUMMARY_COMMITMENT]
    else
        # ------ Execution path ------
        # ------ Reading threshold config (default + num_approvers) ------
        exec.multisig::get_initial_threshold_and_num_approvers
        # => [default_threshold, num_of_approvers, TX_SUMMARY_COMMITMENT]

        # ------ Computing the per-path thresholds from the procedure policies ------
        # Each called procedure contributes a threshold per execution path, UNREACHABLE_THRESHOLD
        # for a path its policy does not allow, so the two maxima describe what every path costs
        # without first deciding which one the transaction takes.
        exec.compute_policy_thresholds
        # => [immediate_threshold, delayed_threshold, num_of_approvers, TX_SUMMARY_COMMITMENT]

        loc_store.AUTH_TX_IMMEDIATE_THRESHOLD_LOC
        # => [delayed_threshold, num_of_approvers, TX_SUMMARY_COMMITMENT]

        loc_store.AUTH_TX_DELAYED_THRESHOLD_LOC
        # => [num_of_approvers, TX_SUMMARY_COMMITMENT]

        # ------ Verifying approver signatures ------
        exec.multisig::verify_signatures
        # => [num_verified_signatures, TX_SUMMARY_COMMITMENT]

        # ------ Selecting the execution path ------
        # The immediate path is tried first: for a procedure allowing both paths it costs at least
        # as much as the delayed one, and it is the path a proposal must never be able to close. The
        # delayed path is the fallback; `consume_tx_proposal` is what makes it require an unlocked
        # proposal and an approval expiration.
        dup loc_load.AUTH_TX_IMMEDIATE_THRESHOLD_LOC
        # => [immediate_threshold, num_verified_signatures, num_verified_signatures, TX_SUMMARY_COMMITMENT]

        u32assert2 u32gte
        # => [reaches_immediate, num_verified_signatures, TX_SUMMARY_COMMITMENT]

        if.true
            drop
            # => [TX_SUMMARY_COMMITMENT]

            # ------ Immediate execution: drop a proposal for this transaction, if any ------
            # The executed-transactions set already prevents re-execution; this only keeps the
            # proposals map free of entries that can never be consumed.
            dupw push.TX_PROPOSALS_SLOT[0..2] exec.delayed_execution::remove_tx_proposal_if_present
            # => [TX_SUMMARY_COMMITMENT]
        else
            dup loc_load.AUTH_TX_DELAYED_THRESHOLD_LOC
            # => [delayed_threshold, num_verified_signatures, num_verified_signatures, TX_SUMMARY_COMMITMENT]

            u32assert2 u32gte
            # => [reaches_delayed, num_verified_signatures, TX_SUMMARY_COMMITMENT]

            if.true
                drop
                # => [TX_SUMMARY_COMMITMENT]

                # ------ Delayed execution: enforce the timelock and consume the proposal ------
                dupw loc_load.AUTH_TX_APPROVAL_EXPIRATION_LOC push.TX_PROPOSALS_SLOT[0..2]
                # => [proposals_slot_id, approval_expiration_block_num, TX_SUMMARY_COMMITMENT, TX_SUMMARY_COMMITMENT]

                exec.delayed_execution::consume_tx_proposal
                # => [TX_SUMMARY_COMMITMENT]
            else
                drop
                # => [TX_SUMMARY_COMMITMENT]

                # Neither path is reachable with these signatures. When the called procedures'
                # policies close both paths no signature count would help, so report the
                # misconfiguration rather than a signature shortfall.
                loc_load.AUTH_TX_IMMEDIATE_THRESHOLD_LOC eq.UNREACHABLE_THRESHOLD
                loc_load.AUTH_TX_DELAYED_THRESHOLD_LOC eq.UNREACHABLE_THRESHOLD
                and assertz.err=ERR_PROC_POLICY_INVALID_MODE
                # => [TX_SUMMARY_COMMITMENT]

                emit.AUTH_UNAUTHORIZED_EVENT
                push.0 assert.err=ERR_INSUFFICIENT_SIGNATURES
            end
        end
        # => [TX_SUMMARY_COMMITMENT]
    end
    # => [TX_SUMMARY_COMMITMENT]
end

# HELPER PROCEDURES
# =================================================================================================

#! Validates that note_restrictions is within the supported range.
#!
#! Inputs:  [note_restrictions]
#! Outputs: []
#!
#! Where:
#! - note_restrictions is the policy enum value to validate.
#!
#! Panics if:
#! - note_restrictions is not a u32 value.
#! - note_restrictions is greater than NOTE_RESTRICTION_MAX.
#!
#! Invocation: exec
proc assert_valid_note_restrictions(note_restrictions: u8)
    u32assert.err=ERR_INVALID_NOTE_RESTRICTIONS
    # => [note_restrictions]

    u32lte.NOTE_RESTRICTION_MAX
    # => [is_valid_note_restrictions]

    assert.err=ERR_INVALID_NOTE_RESTRICTIONS
    # => []
end

#! Returns the current number of approvers after any in-transaction signer update has been applied.
#!
#! Inputs:  []
#! Outputs: [num_approvers]
#!
#! Where:
#! - num_approvers is the current number of signers configured in the threshold config.
#!
#! Invocation: exec
proc get_current_num_approvers() -> u8
    push.THRESHOLD_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [threshold, num_approvers, 0, 0]

    movup.2 drop movup.2 drop
    # => [threshold, num_approvers]

    drop
    # => [num_approvers]
end

#! Extracts the `num_approvers` field out of a MULTISIG_CONFIG word.
#!
#! MULTISIG_CONFIG layout: [threshold, num_approvers, 0, 0].
#!
#! Inputs:  [MULTISIG_CONFIG]
#! Outputs: [num_approvers, MULTISIG_CONFIG]
#!
#! Where:
#! - MULTISIG_CONFIG is the multisig configuration word.
#! - num_approvers is the second felt of MULTISIG_CONFIG.
#!
#! Invocation: exec
proc multisig_config_to_num_approvers(
    threshold: SignatureThreshold,
    num_approvers: u8,
    padding: [felt; 2],
) -> (u8, SignatureThreshold, u8, [felt; 2])
    dup.1
    # => [num_approvers, MULTISIG_CONFIG]
end

#! Computes the effective transaction threshold for one execution path.
#!
#! Used by `compute_policy_thresholds` as a fallback layer on top of `compute_called_proc_policy`:
#! when no non-auth procedure was called (policy_threshold is 0), the tx still needs to require at
#! least `default_threshold` signatures. When any non-auth procedure was called, `compute_called_proc_policy` has already
#! folded `default_threshold` into the max for every unpolicied procedure, so `policy_threshold`
#! alone reflects the correct requirement and is returned as-is.
#!
#! Inputs:  [default_threshold, policy_threshold]
#! Outputs: [transaction_threshold]
#!
#! Where:
#! - policy_threshold is the max contribution across all called non-auth procedures on this path
#!   (each contributes its policy threshold for the path, UNREACHABLE_THRESHOLD when its policy
#!   closes the path, or `default_threshold` when unpolicied); it is 0 only when no non-auth
#!   procedure was called.
#! - default_threshold is the account's configured default multisig threshold.
#! - transaction_threshold is the effective minimum number of signatures required on this path.
#!
#! Invocation: exec
pub proc compute_tx_threshold(default_threshold: u32, policy_threshold: u32) -> u32
    dup.1 eq.0
    # => [is_policy_zero, default_threshold, policy_threshold]

    cdrop
    # => [effective_transaction_threshold]
end

#! Replaces a zero threshold with UNREACHABLE_THRESHOLD.
#!
#! A policy stores 0 for an execution path it does not allow; contributing UNREACHABLE_THRESHOLD
#! for it instead closes the path through the ordinary threshold maximum.
#!
#! Inputs:  [threshold]
#! Outputs: [threshold_or_unreachable]
#!
#! Invocation: exec
pub proc unreachable_if_zero(threshold: SignatureThreshold) -> SignatureThreshold
    push.UNREACHABLE_THRESHOLD
    # => [unreachable_threshold, threshold]

    dup.1 eq.0
    # => [is_zero, unreachable_threshold, threshold]

    cdrop
    # => [threshold_or_unreachable]
end

#! Computes a single procedure's contributions to the per-path threshold max-accumulators, given
#! that procedure's policy thresholds.
#!
#! Inputs:  [immediate, delayed, default_threshold]
#! Outputs: [immediate_contribution, delayed_contribution]
#!
#! Where:
#! - immediate is the procedure's immediate-path policy threshold (0 = path not allowed).
#! - delayed is the procedure's delayed-path policy threshold (0 = path not allowed).
#! - default_threshold is the account's configured default multisig threshold.
#! - immediate_contribution and delayed_contribution are what the procedure requires on each path:
#!
#!     no policy (0, 0)          -> (default_threshold,     default_threshold)
#!     immediate only (i, 0)     -> (i,                     UNREACHABLE_THRESHOLD)
#!     delayed only (0, d)       -> (UNREACHABLE_THRESHOLD, d)
#!     immediate or delay (i, d) -> (i,                     d)
#!
#! Invocation: exec
proc compute_proc_policy_contribution(
    immediate: SignatureThreshold,
    delayed: SignatureThreshold,
    default_threshold: SignatureThreshold
) -> (SignatureThreshold, SignatureThreshold)
    dup.1 dup.1 u32or eq.0
    # => [is_no_policy, immediate, delayed, default_threshold]

    if.true
        # No policy: the procedure costs the default threshold on either path.
        drop drop dup
        # => [default_threshold, default_threshold]
    else
        movup.2 drop
        # => [immediate, delayed]

        exec.unreachable_if_zero
        # => [immediate_contribution, delayed]

        swap exec.unreachable_if_zero swap
        # => [immediate_contribution, delayed_contribution]
    end
end

#! Computes the effective per-procedure policy for all called procedures.
#!
#! Iterates over all account procedures, and for those that were called in this transaction
#! accumulates:
#! - the highest required threshold on the immediate path (max),
#! - the highest required threshold on the delayed path (max),
#! - the union of their note restrictions (so if one proc forbids input notes and another forbids
#!   output notes, the transaction ends up forbidding both).
#!
#! Inputs:  [default_threshold]
#! Outputs: [immediate_threshold, delayed_threshold, note_restrictions]
#!
#! Where:
#! - default_threshold is the account's configured default multisig threshold; used as the
#!   per-procedure contribution on both paths for any *called* procedure that has no stored policy.
#!   This makes procedures-without-a-policy visible in the max accumulation, which closes a
#!   privilege escalation where a tx mixing a low-policy proc (e.g. receive_asset = 1) with an
#!   unpolicied high-impact proc (e.g. update_signers) could otherwise be authorized at the lower
#!   threshold.
#! - immediate_threshold and delayed_threshold are the max across all called non-auth procedures
#!   on each path, where each called procedure contributes its policy threshold for the path,
#!   UNREACHABLE_THRESHOLD when its policy closes the path, or default_threshold (no policy). A path
#!   whose max is UNREACHABLE_THRESHOLD is closed for this transaction.
#! - note_restrictions is the combined (union) note restriction enum across all called procedures.
#!
#! The auth procedure (procedure index 0) is excluded — it is the auth flow itself, not a
#! user-callable account procedure, and counting it would make the thresholds always include
#! `default_threshold`, breaking the override-down semantic for single-proc transactions.
#!
#! Example (default_threshold = 3):
#!
#!   receive_asset → ProcedurePolicy { immediate_threshold = 1 }
#!   update_signers_and_threshold → (no policy)
#!
#! A. Only `receive_asset` is called:
#!    - receive_asset:  policied → contribute (1, UNREACHABLE_THRESHOLD)
#!    - update_signers: not called → no contribution
#!    - immediate_acc = max(0, 1) = 1, delayed_acc = UNREACHABLE_THRESHOLD
#!    - Result: 1 signature required on the immediate path (override-down works for single-proc
#!      tx); the delayed path is closed.
#!
#! B. Both `receive_asset` and `update_signers_and_threshold` are called:
#!    - receive_asset:  policied → contribute (1, UNREACHABLE_THRESHOLD)
#!    - update_signers: called, no policy → contribute (3, 3)
#!    - immediate_acc = max(0, 1, 3) = 3, delayed_acc = UNREACHABLE_THRESHOLD
#!    - Result: 3 signatures required (privilege escalation prevented).
#!
#! Invocation: exec
#!
#! Locals:
#! - DEFAULT_THRESHOLD_LOC: default_threshold
@locals(1)
proc compute_called_proc_policy(default_threshold: u32)
    loc_store.DEFAULT_THRESHOLD_LOC
    # => []

    push.0 push.0 push.0 exec.active_account::get_num_procedures
    # => [proc_index, immediate_acc=0, delayed_acc=0, restrictions_acc=0]

    dup neq.0
    # => [should_continue, proc_index, immediate_acc, delayed_acc, restrictions_acc]
    while.true
        sub.1
        # => [proc_index, immediate_acc, delayed_acc, restrictions_acc]

        # Procedure index 0 is the auth procedure and must never contribute to the policy
        # thresholds, even if it appears as a called procedure during the auth flow itself.
        dup neq.0
        # => [is_non_auth, proc_index, immediate_acc, delayed_acc, restrictions_acc]

        dup.1 exec.active_account::get_procedure_root
        # => [PROC_ROOT, is_non_auth, proc_index, immediate_acc, delayed_acc, restrictions_acc]

        exec.native_account::was_procedure_called
        # => [was_called, is_non_auth, proc_index, immediate_acc, delayed_acc, restrictions_acc]

        and
        # => [should_process, proc_index, immediate_acc, delayed_acc, restrictions_acc]

        if.true
            dup exec.active_account::get_procedure_root
            # => [PROC_ROOT, proc_index, immediate_acc, delayed_acc, restrictions_acc]

            exec.get_procedure_policy
            # => [immediate, delayed, restr_proc, proc_index, immediate_acc, delayed_acc, restrictions_acc]

            # Fold per-proc note_restrictions into the accumulator via OR.
            # ProcedurePolicyNoteRestriction is bit-encoded (0=None, 1=NoInput, 2=NoOutput, 3=Both),
            # so bitwise OR is the union of constraints: e.g. NoInput (0b01) ∪ NoOutput (0b10) = Both (0b11).
            movup.6 movup.3 u32or movdn.5
            # => [immediate, delayed, proc_index, immediate_acc, delayed_acc, new_restrictions]

            loc_load.DEFAULT_THRESHOLD_LOC movdn.2
            # => [immediate, delayed, default_threshold, proc_index, immediate_acc, delayed_acc, new_restrictions]

            exec.compute_proc_policy_contribution
            # => [immediate_contribution, delayed_contribution, proc_index, immediate_acc, delayed_acc, new_restrictions]

            # immediate_acc' = max(immediate_acc, immediate_contribution)
            movup.3 u32max
            # => [new_immediate, delayed_contribution, proc_index, delayed_acc, new_restrictions]

            # delayed_acc' = max(delayed_acc, delayed_contribution)
            swap movup.3 u32max
            # => [new_delayed, new_immediate, proc_index, new_restrictions]

            swap movup.2
            # => [proc_index, new_immediate, new_delayed, new_restrictions]
        end

        dup neq.0
        # => [should_continue, proc_index, immediate_acc, delayed_acc, restrictions_acc]
    end

    drop
    # => [immediate_acc, delayed_acc, restrictions_acc]
end

#! Computes the signature threshold each execution path requires for the current transaction, and
#! enforces the union of the called procedures' note restrictions against the transaction's
#! input/output notes.
#!
#! Inputs:  [default_threshold]
#! Outputs: [immediate_threshold, delayed_threshold]
#!
#! Where:
#! - default_threshold is the account's configured default multisig threshold: the contribution of
#!   any called procedure without an explicit policy, and the threshold of a transaction that calls
#!   no non-auth procedure at all.
#! - immediate_threshold and delayed_threshold are the per-path maxima from
#!   [`compute_called_proc_policy`], or `default_threshold` when no non-auth procedure was called
#!   (see [`compute_tx_threshold`]); a path at UNREACHABLE_THRESHOLD is closed for this transaction.
#!
#! Invocation: exec
proc compute_policy_thresholds(default_threshold: u32) -> (SignatureThreshold, SignatureThreshold)
    dup exec.compute_called_proc_policy
    # => [immediate_policy_threshold, delayed_policy_threshold, note_restrictions, default_threshold]

    movup.2 exec.enforce_note_restrictions
    # => [immediate_policy_threshold, delayed_policy_threshold, default_threshold]

    dup.2 exec.compute_tx_threshold
    # => [immediate_threshold, delayed_policy_threshold, default_threshold]

    swap movup.2 exec.compute_tx_threshold
    # => [delayed_threshold, immediate_threshold]

    swap
    # => [immediate_threshold, delayed_threshold]
end

#! Asserts that all configured smart per-procedure policies are valid for num_approvers.
#!
#! Inputs:  [num_approvers]
#! Outputs: []
#!
#! Where:
#! - num_approvers is the number of approvers that all stored policies must remain reachable with.
#!
#! Panics if:
#! - any stored immediate or delayed threshold is not a u32 value.
#! - any stored immediate or delayed threshold exceeds num_approvers.
#!
#! Invocation: exec
proc assert_proc_policies_lte_num_approvers(num_approvers: u8)
    exec.active_account::get_num_procedures
    # => [num_procedures, num_approvers]

    dup neq.0
    # => [should_continue, num_procedures, num_approvers]
    while.true
        sub.1 dup
        # => [proc_index, proc_index, num_approvers]

        exec.active_account::get_procedure_root
        # => [PROC_ROOT, proc_index, num_approvers]

        push.PROCEDURE_POLICIES_SLOT[0..2]
        # => [policy_slot_suffix, policy_slot_prefix, PROC_ROOT, proc_index, num_approvers]

        # Use the *current* policy state, not the initial one. A `set_procedure_policy` earlier
        # in this transaction that raised a threshold above the new num_approvers would otherwise
        # be missed and the multisig could end up with an unreachable threshold.
        exec.active_account::get_map_item
        # => [immediate_threshold, delayed_threshold, note_restrictions, 0, proc_index, num_approvers]

        # Drop the trailing 0 (depth 3) without disturbing the three policy fields above it.
        movup.3 drop
        # => [immediate_threshold, delayed_threshold, note_restrictions, proc_index, num_approvers]

        # immediate_threshold <= num_approvers
        dup.4
        # => [num_approvers, immediate_threshold, delayed_threshold, note_restrictions, proc_index, num_approvers]

        u32assert2.err=ERR_NUM_APPROVERS_OR_PROC_THRESHOLD_NOT_U32
        u32gt assertz.err=ERR_PROC_THRESHOLD_EXCEEDS_NUM_APPROVERS
        # => [delayed_threshold, note_restrictions, proc_index, num_approvers]

        # delayed_threshold <= num_approvers
        dup.3
        # => [num_approvers, delayed_threshold, note_restrictions, proc_index, num_approvers]

        u32assert2.err=ERR_NUM_APPROVERS_OR_PROC_THRESHOLD_NOT_U32
        u32gt assertz.err=ERR_PROC_THRESHOLD_EXCEEDS_NUM_APPROVERS
        # => [note_restrictions, proc_index, num_approvers]

        drop
        # => [proc_index, num_approvers]

        dup neq.0
        # => [should_continue, proc_index, num_approvers]
    end

    drop drop
    # => []
end
