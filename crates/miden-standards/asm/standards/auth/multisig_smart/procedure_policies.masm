use miden::protocol::active_account
use miden::protocol::native_account
use miden::standards::auth::multisig
use miden::standards::auth::tx_policy
use miden::standards::auth::multisig_smart::common

# CONSTANTS
# =================================================================================================

# Map entries: PROC_ROOT => [immediate_threshold, delayed_threshold,
#                            requires_isolated_tx, requires_no_input_output_notes]
const PROC_POLICY_ROOTS_SLOT = word("miden::standards::auth::multisig_smart::procedure_policies")

# [threshold, num_approvers, 0, 0]
const THRESHOLD_CONFIG_SLOT = word("miden::standards::auth::multisig::threshold_config")

# [pending_execute_word]
const PENDING_EXECUTE_SLOT = word("miden::standards::auth::multisig_smart::pending_execute")

# ERRORS
# =================================================================================================

const ERR_U32 = "value is not a u32"
const ERR_POLICY_BOOL_NOT_BINARY = "procedure policy constraints must be 0 or 1"
const ERR_POLICY_THRESHOLD_EXCEEDS_NUM_APPROVERS =
    "procedure policy threshold exceeds number of approvers"
const ERR_POLICY_CONSTRAINTS_REQUIRE_THRESHOLD =
    "procedure policy constraints require an immediate or delayed threshold"
const ERR_DELAYED_THRESHOLD_EXCEEDS_IMMEDIATE =
    "delayed threshold cannot exceed immediate threshold"
const ERR_PROC_POLICY_INVALID_LANE = "called procedures do not support the selected execution lane"
const ERR_ISOLATED_POLICY_TX_INVALID = "isolated policy transaction has an invalid procedure count"
const ERR_EXECUTE_PATH_MISMATCH = "execute path must match delay requirement"

# HELPERS
# =================================================================================================

#! Inputs:  [value]
#! Outputs: []
proc assert_binary
    dup eq.0
    swap eq.1
    or
    assert.err=ERR_POLICY_BOOL_NOT_BINARY
end

#! Inputs:  [lhs, rhs]
#! Outputs: [max(lhs, rhs)]
proc max_threshold_pair
    dup.1 dup.1
    swap
    u32gt
    cdrop
end

#! Gets the policy entry for PROC_ROOT from the account's initial state.
#!
#! Inputs:  [proc_root]
#! Outputs: [immediate_threshold, delayed_threshold, requires_isolated_tx, requires_no_input_output_notes]
proc get_procedure_policy(proc_root: word)
    push.PROC_POLICY_ROOTS_SLOT[0..2]
    exec.active_account::get_initial_map_item
end

#! Returns the current number of approvers after any in-transaction signer update has been applied.
#!
#! Inputs:  []
#! Outputs: [num_approvers]
pub proc get_current_num_approvers
    push.THRESHOLD_CONFIG_SLOT[0..2]
    exec.active_account::get_item
    # => [threshold, num_approvers, 0, 0]

    movup.2 drop movup.2 drop
    # => [threshold, num_approvers]

    drop
    # => [num_approvers]
end

#! Returns 1 if `execute_proposed_transaction` was called in the current transaction, 0 otherwise.
#!
#! Inputs:  []
#! Outputs: [is_execute_path]
pub proc is_execute_path
    push.PENDING_EXECUTE_SLOT[0..2]
    exec.active_account::get_item
    exec.common::is_empty_word
    eq.0
end

#! Sets or clears a per-procedure smart policy.
#!
#! Inputs:
#!   [immediate_threshold, delayed_threshold, requires_isolated_tx,
#!    requires_no_input_output_notes, PROC_ROOT]
#! Outputs: []
#! Invocation: call
@locals(4)
pub proc set_procedure_policy
    loc_store.0
    # => [delayed_threshold, requires_isolated_tx, requires_no_input_output_notes, PROC_ROOT]

    loc_store.1
    # => [requires_isolated_tx, requires_no_input_output_notes, PROC_ROOT]

    loc_store.2
    # => [requires_no_input_output_notes, PROC_ROOT]

    loc_store.3
    # => [PROC_ROOT]

    exec.multisig::get_threshold_and_num_approvers
    # => [default_threshold, num_approvers, PROC_ROOT]

    drop
    # => [num_approvers, PROC_ROOT]

    loc_load.0
    swap
    # => [num_approvers, immediate_threshold, PROC_ROOT]

    dup.1 swap
    u32assert2.err=ERR_U32
    u32gt assertz.err=ERR_POLICY_THRESHOLD_EXCEEDS_NUM_APPROVERS
    # => [immediate_threshold, PROC_ROOT]

    drop
    # => [PROC_ROOT]

    exec.multisig::get_threshold_and_num_approvers
    # => [default_threshold, num_approvers, PROC_ROOT]

    drop
    # => [num_approvers, PROC_ROOT]

    loc_load.1
    swap
    # => [num_approvers, delayed_threshold, PROC_ROOT]

    dup.1 swap
    u32assert2.err=ERR_U32
    u32gt assertz.err=ERR_POLICY_THRESHOLD_EXCEEDS_NUM_APPROVERS
    # => [delayed_threshold, PROC_ROOT]

    drop
    # => [PROC_ROOT]

    loc_load.2 exec.assert_binary
    # => [PROC_ROOT]

    loc_load.3 exec.assert_binary
    # => [PROC_ROOT]

    loc_load.0 loc_load.1 add
    # => [immediate_plus_delayed, PROC_ROOT]

    dup eq.0
    # => [thresholds_are_zero, immediate_plus_delayed, PROC_ROOT]

    if.true
        drop
        # => [PROC_ROOT]

        loc_load.2 assertz.err=ERR_POLICY_CONSTRAINTS_REQUIRE_THRESHOLD
        loc_load.3 assertz.err=ERR_POLICY_CONSTRAINTS_REQUIRE_THRESHOLD
        # => [PROC_ROOT]
    else
        drop
        # => [PROC_ROOT]

        loc_load.0 eq.0
        # => [immediate_is_zero, PROC_ROOT]

        if.false
            loc_load.1
            loc_load.0
            dup.1 swap
            u32assert2.err=ERR_U32
            u32gt assertz.err=ERR_DELAYED_THRESHOLD_EXCEEDS_IMMEDIATE
            drop
            # => [PROC_ROOT]
        end
    end

    loc_load.3
    loc_load.2
    loc_load.1
    loc_load.0
    # => [immediate_threshold, delayed_threshold, requires_isolated_tx, requires_no_input_output_notes, PROC_ROOT]

    swapw
    # => [PROC_ROOT, immediate_threshold, delayed_threshold, requires_isolated_tx, requires_no_input_output_notes]

    push.PROC_POLICY_ROOTS_SLOT[0..2]
    exec.native_account::set_map_item
    dropw
end

#! Computes the effective per-procedure policy for all called procedures.
#!
#! Inputs:  [is_execute_path]
#! Outputs: [policy_threshold, policy_requires_delay, requires_isolated_tx, requires_no_input_output_notes]
@locals(9)
pub proc compute_called_proc_policy(is_execute_path: u32)
    loc_store.0
    # => []

    push.0 loc_store.1
    push.0 loc_store.2
    push.0 loc_store.3
    push.0 loc_store.4
    # => []

    exec.active_account::get_num_procedures
    # => [num_procedures]

    dup neq.0
    # => [should_continue, num_procedures]
    while.true
        sub.1 dup
        # => [proc_index, proc_index]

        exec.active_account::get_procedure_root dupw
        # => [PROC_ROOT, PROC_ROOT, proc_index]

        exec.native_account::was_procedure_called
        # => [was_called, PROC_ROOT, proc_index]

        if.true
            exec.get_procedure_policy
            # => [immediate_threshold, delayed_threshold, requires_isolated_tx, requires_no_input_output_notes, proc_index]

            loc_store.5
            loc_store.6
            loc_store.7
            loc_store.8
            # => [proc_index]

            loc_load.3
            loc_load.7
            or
            loc_store.3
            # => [proc_index]

            loc_load.4
            loc_load.8
            or
            loc_store.4
            # => [proc_index]

            loc_load.0 eq.1
            if.true
                loc_load.6
                dup eq.0
                if.true
                    drop
                    loc_load.5 eq.0 assert.err=ERR_PROC_POLICY_INVALID_LANE
                    # => [proc_index]
                else
                    drop
                    loc_load.1
                    loc_load.6
                    exec.max_threshold_pair
                    loc_store.1
                    # => [proc_index]

                    push.1
                    loc_store.2
                    # => [proc_index]
                end
            else
                loc_load.5
                dup eq.0
                if.true
                    drop
                    loc_load.6 eq.0 assert.err=ERR_PROC_POLICY_INVALID_LANE
                    # => [proc_index]
                else
                    drop
                    loc_load.1
                    loc_load.5
                    exec.max_threshold_pair
                    loc_store.1
                    # => [proc_index]
                end
            end
        else
            dropw
            # => [proc_index]
        end

        dup neq.0
        # => [should_continue, proc_index]
    end

    drop
    # => []

    loc_load.4
    loc_load.3
    loc_load.2
    loc_load.1
    # => [policy_threshold, policy_requires_delay, requires_isolated_tx, requires_no_input_output_notes]
end

#! Computes the effective procedure-policy context for the current transaction and enforces any
#! procedure-level note/isolation constraints immediately.
#!
#! Inputs:  [tx_summary_commitment]
#! Outputs: [policy_threshold, policy_requires_delay, requires_isolated_tx,
#!           requires_no_input_output_notes, is_execute_path, tx_summary_commitment]
pub proc compute_procedure_policy_context(tx_summary_commitment: word)
    exec.is_execute_path
    # => [is_execute_path, tx_summary_commitment]

    dup
    # => [is_execute_path, is_execute_path, tx_summary_commitment]

    exec.compute_called_proc_policy
    # => [policy_threshold, policy_requires_delay, requires_isolated_tx,
    #     requires_no_input_output_notes, is_execute_path, tx_summary_commitment]

    dup.3
    eq.1
    if.true
        exec.tx_policy::assert_no_input_or_output_notes
    end

    dup.2
    eq.1
    if.true
        dup.4
        exec.assert_isolated_policy_tx
    end
end

#! Asserts that all configured smart policies remain reachable under `num_approvers`.
#!
#! Inputs:  [num_approvers]
#! Outputs: []
@locals(5)
pub proc assert_proc_policies_lte_num_approvers(num_approvers: u32)
    loc_store.0
    # => []

    exec.active_account::get_num_procedures
    # => [num_procedures]

    dup neq.0
    # => [should_continue, num_procedures]
    while.true
        sub.1 dup
        # => [proc_index, proc_index]

        exec.active_account::get_procedure_root
        # => [PROC_ROOT, proc_index]

        push.PROC_POLICY_ROOTS_SLOT[0..2]
        exec.active_account::get_map_item
        # => [immediate_threshold, delayed_threshold, requires_isolated_tx, requires_no_input_output_notes, proc_index]

        loc_store.1
        loc_store.2
        loc_store.3
        loc_store.4
        # => [proc_index]

        loc_load.0
        loc_load.1
        swap
        # => [num_approvers, immediate_threshold, proc_index]

        dup.1 swap
        u32assert2.err=ERR_U32
        u32gt assertz.err=ERR_POLICY_THRESHOLD_EXCEEDS_NUM_APPROVERS
        # => [immediate_threshold, proc_index]

        drop
        # => [proc_index]

        loc_load.0
        loc_load.2
        swap
        # => [num_approvers, delayed_threshold, proc_index]

        dup.1 swap
        u32assert2.err=ERR_U32
        u32gt assertz.err=ERR_POLICY_THRESHOLD_EXCEEDS_NUM_APPROVERS
        # => [delayed_threshold, proc_index]

        drop
        # => [proc_index]

        loc_load.3 exec.assert_binary
        loc_load.4 exec.assert_binary
        # => [proc_index]

        loc_load.1
        loc_load.2
        add
        # => [immediate_plus_delayed, proc_index]

        dup eq.0
        if.true
            drop
            # => [proc_index]

            loc_load.3 assertz.err=ERR_POLICY_CONSTRAINTS_REQUIRE_THRESHOLD
            loc_load.4 assertz.err=ERR_POLICY_CONSTRAINTS_REQUIRE_THRESHOLD
            # => [proc_index]
        else
            drop
            # => [proc_index]

            loc_load.1 eq.0
            if.false
                loc_load.2
                loc_load.1
                dup.1 swap
                u32assert2.err=ERR_U32
                u32gt assertz.err=ERR_DELAYED_THRESHOLD_EXCEEDS_IMMEDIATE
                # => [immediate_threshold, proc_index]

                drop
                # => [proc_index]
            end
        end

        dup neq.0
        # => [should_continue, proc_index]
    end

    drop
    # => []
end

#! Asserts that isolated-policy transactions only call the allowed number of non-auth procedures.
#!
#! Inputs:  [is_execute_path]
#! Outputs: []
@locals(2)
pub proc assert_isolated_policy_tx(is_execute_path: u32)
    loc_store.0
    # => []

    push.0
    loc_store.1
    # => []

    exec.active_account::get_num_procedures
    # => [num_procedures]

    dup neq.0
    # => [should_continue, num_procedures]
    while.true
        sub.1 dup
        # => [proc_index, proc_index]

        exec.active_account::get_procedure_root dupw
        # => [PROC_ROOT, PROC_ROOT, proc_index]

        exec.native_account::was_procedure_called
        # => [was_called, PROC_ROOT, proc_index]

        if.true
            dropw
            # => [proc_index]

            dup neq.0
            # => [is_not_auth_proc, proc_index]

            if.true
                loc_load.1 add.1 loc_store.1
                # => [proc_index]
            end
        else
            dropw
            # => [proc_index]
        end

        dup neq.0
        # => [should_continue, proc_index]
    end

    drop
    # => []

    loc_load.0 eq.1
    if.true
        loc_load.1 eq.2 assert.err=ERR_ISOLATED_POLICY_TX_INVALID
    else
        loc_load.1 eq.1 assert.err=ERR_ISOLATED_POLICY_TX_INVALID
    end
end

#! Asserts that delayed-only procedure policies are executed exclusively via the execute lane.
#!
#! Inputs:  [policy_requires_delay, is_execute_path]
#! Outputs: []
pub proc assert_execute_path_for_delay(policy_requires_delay: u32, is_execute_path: u32)
    if.true
        assert.err=ERR_EXECUTE_PATH_MISMATCH
    else
        drop
    end
end
