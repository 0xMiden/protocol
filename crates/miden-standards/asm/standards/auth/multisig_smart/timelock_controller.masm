use miden::core::word
use miden::protocol::active_account
use miden::protocol::native_account
use miden::protocol::tx

# CONSTANTS
# =================================================================================================

# [min_delay, propose_expiration_delta, 0, 0]
const TIMELOCK_CONTROLLER_SLOT = word("miden::standards::auth::multisig_smart::timelock_controller")

# Map entries: [tx_summary_hash] -> [unlock_timestamp, proposal_timestamp, min_cancel_sigs, 1]
const TX_PROPOSALS_SLOT = word("miden::standards::auth::multisig_smart::tx_proposals")

# Pending action slots
const PENDING_PROPOSE_SLOT = word("miden::standards::auth::multisig_smart::pending_propose")
const PENDING_CANCEL_SLOT = word("miden::standards::auth::multisig_smart::pending_cancel")
const PENDING_EXECUTE_SLOT = word("miden::standards::auth::multisig_smart::pending_execute")

# ERRORS
# =================================================================================================

const ERR_U32 = "value is not a u32"
const ERR_MIN_DELAY_ZERO = "min_delay must be non-zero"
const ERR_PROPOSE_EXPIRATION_DELTA_ZERO = "propose_expiration_delta must be non-zero"
const ERR_TX_ALREADY_PROPOSED = "tx already proposed"
const ERR_TX_NOT_PROPOSED = "tx not proposed"
const ERR_TX_STILL_TIMELOCKED = "tx still timelocked"
const ERR_PENDING_ALREADY_SET = "pending action already set"
const ERR_PROPOSE_ZERO_SIGNATURES = "num_verified_signatures cannot be zero"
const ERR_CANCEL_INSUFFICIENT_SIGNATURES = "insufficient signatures for cancel"
const ERR_EXECUTE_PATH_MISMATCH = "execute path must match delay requirement"

const ERR_EXPIRATION_DELTA_ZERO = "expiration_delta must be non-zero"

const ERR_TX_EXPIRATION_DELTA_NOT_SET = "tx expiration delta must be set"

#! High-impact action.
#!
#! Sets the timelock controller used by proposal lifecycle checks.
#!
#! Inputs:  [min_delay, propose_expiration_delta]
#! Outputs: []
#!
#! Side effects:
#!   - Writes TIMELOCK_CONTROLLER_SLOT.
#! 0: min_delay
#! 1: propose_expiration_delta
@locals(2)
pub proc update_timelock_controller
    u32assert.err=ERR_U32
    dup eq.0 assertz.err=ERR_MIN_DELAY_ZERO
    loc_store.0
    # => [propose_expiration_delta]

    u32assert.err=ERR_U32
    dup eq.0 assertz.err=ERR_PROPOSE_EXPIRATION_DELTA_ZERO
    loc_store.1
    # => []

    loc_load.0
    loc_load.1
    push.0 push.0
    # => [0, 0, propose_expiration_delta, min_delay]

    push.TIMELOCK_CONTROLLER_SLOT[0..2]
    # => [slot_prefix, slot_suffix, 0, 0, propose_expiration_delta, min_delay]

    exec.native_account::set_item
    # => [OLD_WORD]

    dropw
    # => []
end

# TIMELOCK CONTROLLER HELPERS
# =================================================================================================

#! Loads the timelock controller configuration.
#!
#! Inputs:  []
#! Outputs: [min_delay, propose_expiration_delta, 0, 0]
proc get_timelock_controller
    push.TIMELOCK_CONTROLLER_SLOT[0..2]
    # => [slot_prefix, slot_suffix]

    exec.active_account::get_initial_item
    # => [min_delay, propose_expiration_delta, 0, 0]
end

#! Returns 1 if `execute_proposed_transaction` was called in the current transaction, 0 otherwise.
#!
#! Inputs:  []
#! Outputs: [is_execute_path]
pub proc is_execute_path
    push.PENDING_EXECUTE_SLOT[0..2]
    exec.active_account::get_item
    exec.word::eqz
    eq.0
end

#! Inputs:  []
#! Outputs: [min_delay]
proc get_min_delay
    exec.get_timelock_controller
    # => [min_delay, propose_expiration_delta, 0, 0]

    movdn.3
    # => [propose_expiration_delta, 0, 0, min_delay]

    drop drop drop
    # => [min_delay]

    dup eq.0 assertz.err=ERR_MIN_DELAY_ZERO
    # => [min_delay]
end

#! Inputs:  []
#! Outputs: [propose_expiration_delta]
@locals(2)
proc get_propose_expiration_delta
    exec.get_timelock_controller
    # => [min_delay, propose_expiration_delta, 0, 0]

    loc_store.0
    # => [propose_expiration_delta, 0, 0]

    loc_store.1
    # => [0, 0]

    drop drop
    # => []

    loc_load.1
    # => [propose_expiration_delta]

    dup eq.0 assertz.err=ERR_PROPOSE_EXPIRATION_DELTA_ZERO
    # => [propose_expiration_delta]
end

#! Applies an expiration delta to the current transaction and verifies it was set.
#!
#! Inputs:  [expiration_delta]
#! Outputs: []
pub proc apply_expiration_delta
    u32assert.err=ERR_U32
    # => [expiration_delta]

    dup eq.0 assertz.err=ERR_EXPIRATION_DELTA_ZERO
    # => [expiration_delta]

    exec.tx::update_expiration_block_delta
    # => []

    exec.tx::get_expiration_block_delta
    # => [tx_expiration_delta]

    dup eq.0 assertz.err=ERR_TX_EXPIRATION_DELTA_NOT_SET
    # => [tx_expiration_delta]

    drop
    # => []
end

#! Inputs:  []
#! Outputs: []
proc apply_propose_expiration_delta
    exec.get_propose_expiration_delta
    # => [propose_expiration_delta]

    exec.apply_expiration_delta
    # => []
end

# TIMELOCK + PROPOSALS
# =================================================================================================

#! Gets proposal entry for a tx_summary_hash.
#!
#! Inputs:  [tx_summary_hash]
#! Outputs: [unlock_timestamp, proposal_timestamp, min_cancel_sigs, is_set]
proc get_tx_proposal(tx_summary_hash: word)
    push.TX_PROPOSALS_SLOT[0..2]
    # => [slot_prefix, slot_suffix, tx_summary_hash]

    exec.active_account::get_map_item
    # => [unlock_timestamp, proposal_timestamp, min_cancel_sigs, is_set]
end

#! Returns 1 if proposal exists, 0 otherwise.
#!
#! Inputs:  [tx_summary_hash]
#! Outputs: [is_proposed]
proc is_tx_proposed(tx_summary_hash: word) -> u32
    exec.get_tx_proposal
    # => [unlock_timestamp, proposal_timestamp, min_cancel_sigs, is_set]

    exec.word::eqz
    # => [is_empty_proposal]

    eq.0
    # => [is_proposed]
end

#! Deletes proposal entry by setting value to EMPTY_WORD.
#!
#! Inputs:  [tx_summary_hash]
#! Outputs: []
proc remove_tx_proposal(tx_summary_hash: word)
    padw
    # => [0, 0, 0, 0, tx_summary_hash]

    swapw
    # => [tx_summary_hash, 0, 0, 0, 0]

    push.TX_PROPOSALS_SLOT[0..2]
    # => [slot_prefix, slot_suffix, tx_summary_hash, 0, 0, 0, 0]

    exec.native_account::set_map_item
    # => [old_proposal_word]

    dropw
    # => []
end

#! Writes proposal entry:
#!   TX_HASH -> [unlock_timestamp, proposal_timestamp, min_cancel_sigs, 1]
#!
#! Inputs:  [unlock_timestamp, proposal_timestamp, min_cancel_sigs, tx_summary_hash]
#! Outputs: []
@locals(3)
proc write_tx_proposal
    loc_store.0
    # => [proposal_timestamp, min_cancel_sigs, tx_summary_hash]

    loc_store.1
    # => [min_cancel_sigs, tx_summary_hash]

    loc_store.2
    # => [tx_summary_hash]

    push.1
    # => [1, tx_summary_hash]

    loc_load.2
    # => [min_cancel_sigs, 1, tx_summary_hash]

    loc_load.1
    # => [proposal_timestamp, min_cancel_sigs, 1, tx_summary_hash]

    loc_load.0
    # => [unlock_timestamp, proposal_timestamp, min_cancel_sigs, 1, tx_summary_hash]

    swapw
    # => [tx_summary_hash, unlock_timestamp, proposal_timestamp, min_cancel_sigs, 1]

    push.TX_PROPOSALS_SLOT[0..2]
    # => [slot_prefix, slot_suffix, tx_summary_hash, unlock_timestamp, proposal_timestamp, min_cancel_sigs, 1]

    exec.native_account::set_map_item
    # => [old_proposal_word]

    dropw
    # => []
end

#! Computes the unlock timestamp for the current proposal.
#!
#! Inputs:  []
#! Outputs: [unlock_timestamp, proposal_timestamp]
proc compute_unlock_timestamp
    exec.tx::get_block_timestamp
    # => [proposal_timestamp]

    dup
    # => [proposal_timestamp, proposal_timestamp]

    exec.get_min_delay
    # => [min_delay, proposal_timestamp, proposal_timestamp]

    u32assert2.err=ERR_U32
    add
    # => [unlock_timestamp, proposal_timestamp]
end

#! Panics if current_timestamp < unlock_timestamp.
#!
#! Inputs:  [current_timestamp, unlock_timestamp]
#! Outputs: []
proc assert_unlock_reached
    u32assert2.err=ERR_U32
    # => [current_timestamp, unlock_timestamp]

    swap
    # => [unlock_timestamp, current_timestamp]

    u32lt
    # => [current_timestamp_lt_unlock_timestamp]

    assertz.err=ERR_TX_STILL_TIMELOCKED
    # => []
end

#! Asserts that delayed-only procedure policies are executed exclusively via the execute lane.
#!
#! Inputs:  [policy_requires_delay, is_execute_path]
#! Outputs: []
pub proc assert_execute_path_for_delay(policy_requires_delay: u32, is_execute_path: u32)
    if.true
        assert.err=ERR_EXECUTE_PATH_MISMATCH
    else
        drop
    end
end

#! Enforces that TX_HASH is proposed and the stored unlock timestamp has been reached.
#!
#! Inputs:  [tx_summary_hash]
#! Outputs: [min_cancel_sigs]
@locals(3)
proc enforce_tx_timelock
    dupw
    exec.get_tx_proposal
    # => [unlock_timestamp, proposal_timestamp, min_cancel_sigs, is_set, tx_summary_hash]

    dup.3 eq.1
    assert.err=ERR_TX_NOT_PROPOSED

    loc_store.0
    loc_store.1
    loc_store.2
    # => [tx_summary_hash]

    drop
    dropw
    # => []

    exec.tx::get_block_timestamp
    # => [current_timestamp]

    loc_load.0
    # => [unlock_timestamp, current_timestamp]

    swap
    # => [current_timestamp, unlock_timestamp]

    exec.assert_unlock_reached
    # => []

    loc_load.2
    # => [min_cancel_sigs]
end

#! Reads current pending propose hash (or EMPTY_WORD).
#!
#! Inputs:  []
#! Outputs: [WORD]
proc get_pending_propose
    push.PENDING_PROPOSE_SLOT[0..2]
    # => [slot_prefix, slot_suffix]

    exec.active_account::get_item
    # => [pending_propose_word]
end

#! Inputs:  []
#! Outputs: [WORD]
proc get_pending_cancel
    push.PENDING_CANCEL_SLOT[0..2]
    # => [slot_prefix, slot_suffix]

    exec.active_account::get_item
    # => [pending_cancel_word]
end

#! Inputs:  []
#! Outputs: [WORD]
proc get_pending_execute
    push.PENDING_EXECUTE_SLOT[0..2]
    # => [slot_prefix, slot_suffix]

    exec.active_account::get_item
    # => [pending_execute_word]
end

#! Asserts the given WORD is EMPTY_WORD.
#!
#! Inputs:  [WORD]
#! Outputs: []
proc assert_pending_empty
    exec.word::eqz
    # => [is_pending_empty]

    assert.err=ERR_PENDING_ALREADY_SET
    # => []
end

#! Sets pending propose to TX_HASH. Fails if already set.
#!
#! Inputs:  [tx_summary_hash]
#! Outputs: []
proc set_pending_propose
    exec.get_pending_propose
    # => [pending_propose_word, tx_summary_hash]

    exec.assert_pending_empty
    # => [tx_summary_hash]

    push.PENDING_PROPOSE_SLOT[0..2]
    # => [slot_prefix, slot_suffix, tx_summary_hash]

    exec.native_account::set_item
    # => [old_pending_propose_word]

    dropw
    # => []
end

#! Clears pending propose to EMPTY_WORD.
#!
#! Inputs:  []
#! Outputs: []
proc clear_pending_propose
    push.0 push.0 push.0 push.0
    # => [0, 0, 0, 0]

    push.PENDING_PROPOSE_SLOT[0..2]
    # => [slot_prefix, slot_suffix, 0, 0, 0, 0]

    exec.native_account::set_item
    # => [old_pending_propose_word]

    dropw
    # => []
end

#! Inputs:  [tx_summary_hash]
#! Outputs: []
proc set_pending_cancel
    exec.get_pending_cancel
    # => [pending_cancel_word, tx_summary_hash]

    exec.assert_pending_empty
    # => [tx_summary_hash]

    push.PENDING_CANCEL_SLOT[0..2]
    # => [slot_prefix, slot_suffix, tx_summary_hash]

    exec.native_account::set_item
    # => [old_pending_cancel_word]

    dropw
    # => []
end

#! Inputs:  []
#! Outputs: []
proc clear_pending_cancel
    push.0 push.0 push.0 push.0
    # => [0, 0, 0, 0]

    push.PENDING_CANCEL_SLOT[0..2]
    # => [slot_prefix, slot_suffix, 0, 0, 0, 0]

    exec.native_account::set_item
    # => [old_pending_cancel_word]

    dropw
    # => []
end

#! Sets pending execute flag to [1,0,0,0]. Fails if already set.
#!
#! Inputs:  []
#! Outputs: []
proc set_pending_execute
    exec.get_pending_execute
    # => [pending_execute_word]

    exec.assert_pending_empty
    # => []

    push.1 push.0 push.0 push.0
    # => [1, 0, 0, 0]

    push.PENDING_EXECUTE_SLOT[0..2]
    # => [slot_prefix, slot_suffix, 1, 0, 0, 0]

    exec.native_account::set_item
    # => [old_pending_execute_word]

    dropw
    # => []
end

#! Inputs:  []
#! Outputs: []
proc clear_pending_execute
    push.0 push.0 push.0 push.0
    # => [0, 0, 0, 0]

    push.PENDING_EXECUTE_SLOT[0..2]
    # => [slot_prefix, slot_suffix, 0, 0, 0, 0]

    exec.native_account::set_item
    # => [old_pending_execute_word]

    dropw
    # => []
end

#! Allows any signer to propose a transaction.
#! (Actual write happens in the auth finalizer.)
#!
#! Inputs:  [tx_summary_hash]
#! Outputs: []
pub proc propose_transaction
    exec.apply_propose_expiration_delta
    # => [tx_summary_hash]

    dupw
    # => [tx_summary_hash, tx_summary_hash]

    exec.is_tx_proposed
    # => [is_proposed, tx_summary_hash]

    eq.1
    # => [is_proposed_eq_1, tx_summary_hash]

    assertz.err=ERR_TX_ALREADY_PROPOSED
    # => [tx_summary_hash]

    exec.set_pending_propose
    # => []
end

#! Cancels an existing proposal (final delete happens in auth finalizer).
#!
#! Inputs:  [tx_summary_hash]
#! Outputs: []
pub proc cancel_transaction_proposal
    dupw
    # => [tx_summary_hash, tx_summary_hash]

    exec.is_tx_proposed
    # => [is_proposed, tx_summary_hash]

    eq.1
    # => [is_proposed_eq_1, tx_summary_hash]

    assert.err=ERR_TX_NOT_PROPOSED
    # => [tx_summary_hash]

    exec.set_pending_cancel
    # => []
end

#! Cancels old proposal and proposes new one in the same tx.
#!
#! Inputs:  [old_TX_HASH, new_TX_HASH]
#! Outputs: []
pub proc cancel_and_propose_new_transaction
    dupw
    # => [old_TX_HASH, old_TX_HASH, new_TX_HASH]

    exec.is_tx_proposed
    # => [is_old_proposed, old_TX_HASH, new_TX_HASH]

    eq.1
    # => [is_old_proposed_eq_1, old_TX_HASH, new_TX_HASH]

    assert.err=ERR_TX_NOT_PROPOSED
    # => [old_TX_HASH, new_TX_HASH]

    swapw
    # => [new_TX_HASH, old_TX_HASH]

    dupw
    # => [new_TX_HASH, new_TX_HASH, old_TX_HASH]

    exec.is_tx_proposed
    # => [is_new_proposed, new_TX_HASH, old_TX_HASH]

    eq.1
    # => [is_new_proposed_eq_1, new_TX_HASH, old_TX_HASH]

    assertz.err=ERR_TX_ALREADY_PROPOSED
    # => [new_TX_HASH, old_TX_HASH]

    swapw
    # => [old_TX_HASH, new_TX_HASH]

    exec.set_pending_cancel
    # => [new_TX_HASH]

    exec.apply_propose_expiration_delta
    # => [new_TX_HASH]

    exec.set_pending_propose
    # => []
end

#! Marks that this tx intends to execute a proposed action.
#!
#! Inputs:  []
#! Outputs: []
pub proc execute_proposed_transaction
    exec.set_pending_execute
    # => []
end

#! Finalizes pending propose/cancel/execute actions.
#!
#! Inputs:
#!   [num_verified_signatures, requires_delay, tx_summary_hash]
#! Outputs: []
#!
#! Locals:
#! 0: num_verified_signatures
#! 1: requires_delay
#! 2: min_cancel_sigs
#! 3: unlock_timestamp
#! 4: proposal_timestamp
@locals(5)
pub proc finalize_timelock_proposals
    loc_store.0
    # => [requires_delay, TX_HASH]

    loc_store.1
    # => [TX_HASH]

    exec.get_pending_execute
    # => [pending_execute_word, TX_HASH]

    exec.word::eqz
    # => [is_pending_execute_empty, TX_HASH]

    if.false
        loc_load.1
        # => [requires_delay, TX_HASH]

        eq.1
        # => [requires_delay_eq_1, TX_HASH]

        if.true
            dupw
            # => [TX_HASH, TX_HASH]

            exec.enforce_tx_timelock
            # => [min_cancel_sigs, TX_HASH]

            drop
            # => [TX_HASH]
        end

        dupw
        # => [TX_HASH, TX_HASH]

        exec.remove_tx_proposal
        # => [TX_HASH]
    end

    exec.clear_pending_execute
    # => [TX_HASH]

    exec.get_pending_cancel
    # => [pending_cancel_word, TX_HASH]

    exec.word::eqz
    # => [is_pending_cancel_empty, TX_HASH]

    if.false
        exec.get_pending_cancel
        # => [pending_cancel_hash, TX_HASH]

        dupw
        # => [pending_cancel_hash, pending_cancel_hash, TX_HASH]

        exec.get_tx_proposal
        # => [unlock_timestamp, proposal_timestamp, min_cancel_sigs, is_set, pending_cancel_hash, TX_HASH]

        dup.3 eq.1
        assert.err=ERR_TX_NOT_PROPOSED

        drop
        # => [proposal_timestamp, min_cancel_sigs, is_set, pending_cancel_hash, TX_HASH]

        drop
        # => [min_cancel_sigs, is_set, pending_cancel_hash, TX_HASH]

        loc_store.2
        # => [is_set, pending_cancel_hash, TX_HASH]

        drop
        # => [pending_cancel_hash, TX_HASH]

        loc_load.0
        # => [num_verified_signatures, pending_cancel_hash, TX_HASH]

        loc_load.2
        # => [min_cancel_sigs, num_verified_signatures, pending_cancel_hash, TX_HASH]

        u32assert2.err=ERR_U32
        u32lt
        # => [num_verified_lt_min_cancel, pending_cancel_hash, TX_HASH]

        assertz.err=ERR_CANCEL_INSUFFICIENT_SIGNATURES
        # => [pending_cancel_hash, TX_HASH]

        exec.remove_tx_proposal
        # => [TX_HASH]
    end

    exec.clear_pending_cancel
    # => [TX_HASH]

    exec.get_pending_propose
    # => [pending_propose_hash, TX_HASH]

    exec.word::eqz
    # => [is_pending_propose_empty, TX_HASH]

    if.false
        exec.get_pending_propose
        # => [pending_propose_hash, TX_HASH]

        dupw
        # => [pending_propose_hash, pending_propose_hash, TX_HASH]

        exec.is_tx_proposed
        # => [is_proposed, pending_propose_hash, TX_HASH]

        eq.1
        # => [is_proposed_eq_1, pending_propose_hash, TX_HASH]

        assertz.err=ERR_TX_ALREADY_PROPOSED
        # => [pending_propose_hash, TX_HASH]

        loc_load.0
        # => [num_verified_signatures, pending_propose_hash, TX_HASH]

        dup
        # => [num_verified_signatures, num_verified_signatures, pending_propose_hash, TX_HASH]

        u32assert.err=ERR_U32
        eq.0
        # => [num_verified_eq_0, num_verified_signatures, pending_propose_hash, TX_HASH]

        assertz.err=ERR_PROPOSE_ZERO_SIGNATURES
        # => [num_verified_signatures, pending_propose_hash, TX_HASH]

        loc_store.2
        # => [pending_propose_hash, TX_HASH]

        exec.apply_propose_expiration_delta
        # => [pending_propose_hash, TX_HASH]

        exec.compute_unlock_timestamp
        # => [unlock_timestamp, proposal_timestamp, pending_propose_hash, TX_HASH]

        loc_store.3
        # => [proposal_timestamp, pending_propose_hash, TX_HASH]

        loc_store.4
        # => [pending_propose_hash, TX_HASH]

        loc_load.2
        # => [min_cancel_sigs, pending_propose_hash, TX_HASH]

        loc_load.4
        # => [proposal_timestamp, min_cancel_sigs, pending_propose_hash, TX_HASH]

        loc_load.3
        # => [unlock_timestamp, proposal_timestamp, min_cancel_sigs, pending_propose_hash, TX_HASH]

        exec.write_tx_proposal
        # => [TX_HASH]
    end

    exec.clear_pending_propose
end
