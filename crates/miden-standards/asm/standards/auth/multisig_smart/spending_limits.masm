use miden::core::word
use miden::protocol::active_account
use miden::protocol::asset
use {ASSET_SIZE, COMPOSITION_FUNGIBLE, FUNGIBLE_ASSET_MAX_AMOUNT} from miden::protocol::asset
use {MAX_ASSETS_PER_NOTE} from miden::protocol::constants
use miden::protocol::native_account
use miden::protocol::output_note
use miden::protocol::tx
use {AccountId, AssetAmount, AssetId, AssetValue, Bool} from miden::protocol::types
use miden::standards::fee
use miden::standards::oracle::price_oracle

# Spending limits (a window budget in a base asset) for the multisig smart account.
#
# Every fungible asset a transaction sends out through an output note is priced into the base asset
# and charged to the account's budget. The base asset is charged one to one; any other asset is
# priced through the configured oracle and, without an oracle or without a rate for it, falls to
# the unpriced-asset policy. The budget resets at fixed window boundaries derived from the
# reference block number. A transaction that would push the budget over its limit fails regardless
# of how many approvers signed it. The policy never changes how many signatures a transaction
# needs, it only decides whether the transaction is allowed at all. Non-fungible assets are outside
# the policy.
#
# Window binding: while the policy is enabled, every transaction expires `window_blocks` blocks (at
# most 65535) after its reference block. A reference block is therefore at most one window old at
# inclusion, so an idle window cannot be reopened later by pointing an older reference block at it.
#
# Faulty oracle: an oracle without a rate makes the asset fall to the policy and an unavailable one
# fails the foreign call, so under `reject` every non-base asset stops until governance acts. The
# intended response is to unset the oracle with `update_spending_oracle`: the base asset keeps being
# charged under the limit and everything else falls to the policy. Switching to another oracle, or
# to `allow`, is only needed to move other assets.

# TYPE ALIASES
# =================================================================================================

# How a fungible asset the budget cannot price is treated. Mirrors the Rust `UnpricedAssetPolicy`:
# `UNPRICED_ASSET_ALLOW` leaves the asset unmetered, `UNPRICED_ASSET_REJECT` fails the transaction.
pub enum UnpricedAssetPolicy : u8 {
    UNPRICED_ASSET_ALLOW = 0,
    UNPRICED_ASSET_REJECT = 1,
}

# CONSTANTS
# =================================================================================================

# [window_blocks, unpriced_asset_policy, config_generation, 0]
# A zero window_blocks disables the policy for the account.
const SPENDING_CONFIG_SLOT = word("miden::standards::auth::multisig_smart::spending_config")

# [oracle_id_suffix, oracle_id_prefix, max_oracle_block_age, 0]
# The price oracle account non-base assets are priced through, and how many blocks after the
# reference block a transaction that read it stays includable. An all-zero word means no oracle:
# only the base asset is priced.
const SPENDING_ORACLE_SLOT = word("miden::standards::auth::multisig_smart::spending_oracle")

# [BASE_ASSET_ID]
# The asset the budget is denominated in.
const SPENDING_BASE_ASSET_SLOT = word("miden::standards::auth::multisig_smart::spending_base_asset")

# [limit, 0, 0, 0]
# A zero limit means the budget is not configured.
const SPENDING_LIMIT_SLOT = word("miden::standards::auth::multisig_smart::spending_limit")

# [spent_in_window, window_index, config_generation, 0]
const SPENDING_TRACKER_SLOT = word("miden::standards::auth::multisig_smart::spending_tracker")

const UNPRICED_ASSET_POLICY_MAX = UNPRICED_ASSET_REJECT

# Scratch area for the assets of one output note.
const NOTE_ASSETS_NUM_ELEMENTS = MAX_ASSETS_PER_NOTE * ASSET_SIZE

# Largest delta `tx::update_expiration_block_delta` accepts (u16).
const MAX_EXPIRATION_BLOCK_DELTA = 65535

# ERRORS
# =================================================================================================

const ERR_WINDOW_BLOCKS_NOT_U32 = "window_blocks must be u32"
const ERR_UNPRICED_ASSET_POLICY_INVALID = "unpriced_asset_policy must be 0 or 1"
const ERR_MAX_ORACLE_BLOCK_AGE_NOT_U32 = "max_oracle_block_age must be u32"
const ERR_MAX_ORACLE_BLOCK_AGE_NOT_U16 = "max_oracle_block_age must be u16"
const ERR_MAX_ORACLE_BLOCK_AGE_ZERO = "max_oracle_block_age must be non-zero"
const ERR_MAX_ORACLE_BLOCK_AGE_WITHOUT_ORACLE = "max_oracle_block_age must be zero without an oracle"
const ERR_BASE_ASSET_NOT_FUNGIBLE = "spending limit base asset must be fungible"
const ERR_SPENDING_LIMIT_REQUIRES_BASE_ASSET = "spending limit requires a configured base asset"
const ERR_UNPRICED_ASSET_REJECTED = "spent asset is not priced into the budget and the policy rejects it"
const ERR_SPENDING_LIMIT_EXCEEDED = "spending limit exceeded for the current window"

# LOCAL ADDRESSES (enforce_spending_limits)
# =================================================================================================

const ENFORCE_NOTE_ASSETS_LOC = 0
const ENFORCE_ASSET_PTR_LOC = ENFORCE_NOTE_ASSETS_LOC + NOTE_ASSETS_NUM_ELEMENTS
const ENFORCE_WINDOW_INDEX_LOC = ENFORCE_ASSET_PTR_LOC + 1
const ENFORCE_UNPRICED_POLICY_LOC = ENFORCE_WINDOW_INDEX_LOC + 1
const ENFORCE_GENERATION_LOC = ENFORCE_UNPRICED_POLICY_LOC + 1

# LOCAL ADDRESSES (convert_to_base_asset)
# =================================================================================================

const CONVERT_AMOUNT_LOC = 0
const CONVERT_MAX_BLOCK_AGE_LOC = 1
const CONVERT_ORACLE_ID_SUFFIX_LOC = 2
const CONVERT_ORACLE_ID_PREFIX_LOC = 3

# CONFIGURATION
# =================================================================================================

#! Sets the account-wide spending-limit policy: the window length and how unpriced assets are
#! treated.
#!
#! Lengthening the window or switching unpriced assets to `allow` weakens the budget, and changing
#! the window length resets the running total, so this procedure should carry a policy at least as
#! strong as the account wants its spending limit to be. Left unpolicied, the default threshold
#! suffices to reset the budget.
#!
#! Changing `window_blocks` bumps `config_generation`: window indices computed under different
#! lengths are not comparable, so a tracker written under the old generation is treated as the
#! start of a fresh window. The bump happens only when the length actually changes, so a call that
#! keeps it cannot be used as a budget reset.
#!
#! Inputs:  [window_blocks, unpriced_asset_policy]
#! Outputs: []
#!
#! Where:
#! - window_blocks is the length of one spending window in blocks; zero disables the policy.
#! - unpriced_asset_policy is UNPRICED_ASSET_ALLOW or UNPRICED_ASSET_REJECT.
#!
#! Panics if:
#! - `window_blocks` is not a valid `u32` field element (`ERR_WINDOW_BLOCKS_NOT_U32`).
#! - `unpriced_asset_policy` is not 0 or 1 (`ERR_UNPRICED_ASSET_POLICY_INVALID`).
#!
#! Invocation: call
@account_procedure
pub proc update_spending_limits_policy(window_blocks: u32, unpriced_asset_policy: UnpricedAssetPolicy)
    u32assert.err=ERR_WINDOW_BLOCKS_NOT_U32
    # => [window_blocks, unpriced_asset_policy]

    dup.1 u32assert.err=ERR_UNPRICED_ASSET_POLICY_INVALID
    # => [unpriced_asset_policy, window_blocks, unpriced_asset_policy]

    u32lte.UNPRICED_ASSET_POLICY_MAX assert.err=ERR_UNPRICED_ASSET_POLICY_INVALID
    # => [window_blocks, unpriced_asset_policy]

    # ----- Bump the generation only when the window length actually changes. -----
    exec.get_initial_spending_config
    # => [old_window_blocks, old_policy, old_generation, window_blocks, unpriced_asset_policy]

    swap drop
    # => [old_window_blocks, old_generation, window_blocks, unpriced_asset_policy]

    dup.2 neq
    # => [is_new_window_length, old_generation, window_blocks, unpriced_asset_policy]

    if.true
        add.1
    end
    # => [config_generation, window_blocks, unpriced_asset_policy]

    movdn.2 push.0 movdn.3
    # => [window_blocks, unpriced_asset_policy, config_generation, 0]

    push.SPENDING_CONFIG_SLOT[0..2]
    # => [slot_suffix, slot_prefix, window_blocks, unpriced_asset_policy, config_generation, 0]

    exec.native_account::set_item
    # => [OLD_CONFIG]

    dropw
    # => []
end

#! Sets the price oracle non-base assets are priced through, the asset the budget is denominated in
#! and the bound on how old the oracle state read may be.
#!
#! Pointing the budget at a different oracle or base asset, or loosening the block-age bound,
#! changes what every converted amount means, so this procedure should carry a policy at least as
#! strong as the account wants its budget to be.
#!
#! A zero oracle id unsets the oracle: the base asset keeps being charged one to one and every other
#! asset falls to the unpriced-asset policy. This is the intended response to a faulty oracle, as
#! it keeps the limit on the base asset in force.
#!
#! Inputs:  [oracle_id_suffix, oracle_id_prefix, max_oracle_block_age, BASE_ASSET_ID]
#! Outputs: []
#!
#! Where:
#! - oracle_id_{suffix, prefix} identify the account exposing `price_oracle::get_conversion_rate`,
#!   or are both zero for no oracle.
#! - max_oracle_block_age is how many blocks after its reference block a transaction that read the
#!   oracle stays includable, applied through `tx::update_expiration_block_delta` after every read.
#!   Foreign state is not revalidated at inclusion, so this is what keeps an executor from reading a
#!   price at an arbitrarily old block. It must be zero when no oracle is set.
#! - BASE_ASSET_ID is the asset the budget is denominated in.
#!
#! Panics if:
#! - `BASE_ASSET_ID` is not a fungible asset id (`ERR_BASE_ASSET_NOT_FUNGIBLE`).
#! - an oracle is set and `max_oracle_block_age` is not a valid `u32` field element
#!   (`ERR_MAX_ORACLE_BLOCK_AGE_NOT_U32`), is zero (`ERR_MAX_ORACLE_BLOCK_AGE_ZERO`) or exceeds the
#!   `u16` range `tx::update_expiration_block_delta` accepts (`ERR_MAX_ORACLE_BLOCK_AGE_NOT_U16`).
#! - no oracle is set and `max_oracle_block_age` is not zero
#!   (`ERR_MAX_ORACLE_BLOCK_AGE_WITHOUT_ORACLE`).
#!
#! Invocation: call
@account_procedure
pub proc update_spending_oracle(oracle_id: AccountId, max_oracle_block_age: u16, base_asset_id: AssetId)
    # ----- A budget in a non-fungible unit would be meaningless. -----
    movdn.6 movdn.6 movdn.6
    # => [BASE_ASSET_ID, oracle_id_suffix, oracle_id_prefix, max_oracle_block_age]

    dupw exec.asset::id_into_composition eq.COMPOSITION_FUNGIBLE
    # => [is_fungible, BASE_ASSET_ID, oracle_id_suffix, oracle_id_prefix, max_oracle_block_age]

    assert.err=ERR_BASE_ASSET_NOT_FUNGIBLE
    # => [BASE_ASSET_ID, oracle_id_suffix, oracle_id_prefix, max_oracle_block_age]

    movdn.6 movdn.6 movdn.6 movdn.6
    # => [oracle_id_suffix, oracle_id_prefix, max_oracle_block_age, BASE_ASSET_ID]

    movup.2
    # => [max_oracle_block_age, oracle_id_suffix, oracle_id_prefix, BASE_ASSET_ID]

    dup.1 eq.0 dup.3 eq.0 and
    # => [is_oracle_unset, max_oracle_block_age, oracle_id_suffix, oracle_id_prefix, BASE_ASSET_ID]

    if.true
        # ----- No oracle: the block-age bound has nothing to bound. -----
        dup eq.0 assert.err=ERR_MAX_ORACLE_BLOCK_AGE_WITHOUT_ORACLE
    else
        u32assert.err=ERR_MAX_ORACLE_BLOCK_AGE_NOT_U32
        dup eq.0 assertz.err=ERR_MAX_ORACLE_BLOCK_AGE_ZERO
        dup u32lte.MAX_EXPIRATION_BLOCK_DELTA assert.err=ERR_MAX_ORACLE_BLOCK_AGE_NOT_U16
    end
    # => [max_oracle_block_age, oracle_id_suffix, oracle_id_prefix, BASE_ASSET_ID]

    movdn.2 push.0 movdn.3
    # => [oracle_id_suffix, oracle_id_prefix, max_oracle_block_age, 0, BASE_ASSET_ID]

    push.SPENDING_ORACLE_SLOT[0..2]
    # => [slot_suffix, slot_prefix, ORACLE_CONFIG, BASE_ASSET_ID]

    exec.native_account::set_item dropw
    # => [BASE_ASSET_ID]

    push.SPENDING_BASE_ASSET_SLOT[0..2]
    # => [slot_suffix, slot_prefix, BASE_ASSET_ID]

    exec.native_account::set_item dropw
    # => []
end

#! Sets or clears the spending limit, in the base asset.
#!
#! Raising or clearing the limit weakens the protection it provides, so this procedure should carry
#! a policy at least as strong as the account wants its spending limit to be. Left unpolicied, the
#! default threshold suffices to lift it.
#!
#! A non-zero limit needs a base asset, set through `update_spending_oracle`, to give it a unit. A
#! zero limit clears the budget, after which every fungible asset falls to the unpriced-asset
#! policy. Changing the limit does not touch the running total: a lowered limit applies to what was
#! already spent in the current window.
#!
#! Inputs:  [limit]
#! Outputs: []
#!
#! Where:
#! - limit is the maximum amount, in the base asset, that may leave the account per window.
#!
#! Panics if:
#! - `limit` is non-zero and no base asset is configured (`ERR_SPENDING_LIMIT_REQUIRES_BASE_ASSET`).
#!
#! Invocation: call
@account_procedure
pub proc set_spending_limit(limit: AssetAmount)
    dup neq.0
    # => [is_update, limit]

    if.true
        push.SPENDING_BASE_ASSET_SLOT[0..2] exec.active_account::get_item
        # => [BASE_ASSET_ID, limit]

        exec.word::eqz
        # => [is_base_asset_unset, limit]

        assertz.err=ERR_SPENDING_LIMIT_REQUIRES_BASE_ASSET
        # => [limit]
    end

    push.0.0.0 movdn.3 movdn.3 movdn.3
    # => [limit, 0, 0, 0]

    push.SPENDING_LIMIT_SLOT[0..2]
    # => [slot_suffix, slot_prefix, limit, 0, 0, 0]

    exec.native_account::set_item dropw
    # => []
end

# ENFORCEMENT
# =================================================================================================

#! Charges every fungible asset this transaction sends out to the spending budget and fails the
#! transaction if the budget is exceeded.
#!
#! Iterates every output note and every asset in it. For each fungible asset, `meter_asset` prices
#! it into the base asset and charges the budget; an asset the budget cannot price falls to the
#! unpriced-asset policy. Non-fungible assets are skipped.
#!
#! A no-op when the policy is disabled (`window_blocks == 0`). With the policy enabled the
#! transaction's expiration is bound to the window even when it creates no output notes.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Side effects:
#! - Tightens the transaction expiration delta to `min(window_blocks, 65535)`, so the reference
#!   block is at most one window old at inclusion and an idle window cannot be reopened later.
#!
#! Panics if:
#! - `window_blocks` is not a valid `u32` field element (`ERR_WINDOW_BLOCKS_NOT_U32`).
#! - an asset is unpriced and the policy is UNPRICED_ASSET_REJECT
#!   (`ERR_UNPRICED_ASSET_REJECTED`).
#! - the budget's window total would exceed its limit (`ERR_SPENDING_LIMIT_EXCEEDED`).
#! - the oracle call fails (see `tx::execute_foreign_procedure`).
#!
#! Invocation: exec
@locals(132)
pub proc enforce_spending_limits()
    exec.get_initial_spending_config
    # => [window_blocks, unpriced_asset_policy, config_generation]

    dup eq.0
    # => [is_disabled, window_blocks, unpriced_asset_policy, config_generation]

    if.true
        drop drop drop
        # => []
    else
        u32assert.err=ERR_WINDOW_BLOCKS_NOT_U32
        # => [window_blocks, unpriced_asset_policy, config_generation]

        # ----- Bind the transaction to its window: a reference block more than one window old is
        # expired at inclusion, so an idle window cannot be reopened with it. -----
        dup push.MAX_EXPIRATION_BLOCK_DELTA u32min exec.tx::update_expiration_block_delta
        # => [window_blocks, unpriced_asset_policy, config_generation]

        exec.current_window_index
        # => [window_index, unpriced_asset_policy, config_generation]

        loc_store.ENFORCE_WINDOW_INDEX_LOC
        loc_store.ENFORCE_UNPRICED_POLICY_LOC
        loc_store.ENFORCE_GENERATION_LOC
        # => []

        exec.tx::get_num_output_notes
        # => [num_output_notes]

        dup neq.0
        # => [has_notes, num_output_notes]

        while.true
            # => [note_count]

            sub.1
            # => [note_index]

            dup locaddr.ENFORCE_NOTE_ASSETS_LOC
            # => [assets_ptr, note_index, note_index]

            dup loc_store.ENFORCE_ASSET_PTR_LOC
            # => [assets_ptr, note_index, note_index]

            exec.output_note::get_assets
            # => [num_assets, note_index]

            dup neq.0
            # => [has_assets, num_assets, note_index]

            while.true
                # => [num_assets, note_index]

                sub.1
                # => [remaining_assets, note_index]

                loc_load.ENFORCE_GENERATION_LOC
                loc_load.ENFORCE_UNPRICED_POLICY_LOC
                loc_load.ENFORCE_WINDOW_INDEX_LOC
                # => [window_index, unpriced_asset_policy, config_generation, remaining_assets,
                #     note_index]

                loc_load.ENFORCE_ASSET_PTR_LOC
                # => [asset_ptr, window_index, unpriced_asset_policy, config_generation,
                #     remaining_assets, note_index]

                dup add.ASSET_SIZE loc_store.ENFORCE_ASSET_PTR_LOC
                # => [asset_ptr, window_index, unpriced_asset_policy, config_generation,
                #     remaining_assets, note_index]

                exec.asset::load
                # => [ASSET_ID, ASSET_VALUE, window_index, unpriced_asset_policy,
                #     config_generation, remaining_assets, note_index]

                exec.meter_asset
                # => [remaining_assets, note_index]

                dup neq.0
                # => [has_assets, remaining_assets, note_index]
            end
            # => [remaining_assets, note_index]

            drop
            # => [note_index]

            dup neq.0
            # => [has_notes, note_index]
        end
        # => [note_index]

        drop
        # => []
    end
end

# HELPER PROCEDURES
# =================================================================================================

#! Loads the spending-limit policy from the initial `SPENDING_CONFIG_SLOT`.
#!
#! Reads the transaction's initial storage state, so a policy update earlier in the same
#! transaction does not affect how that transaction is metered.
#!
#! Inputs:  []
#! Outputs: [window_blocks, unpriced_asset_policy, config_generation]
#!
#! Invocation: exec
proc get_initial_spending_config() -> (u32, UnpricedAssetPolicy, felt)
    push.SPENDING_CONFIG_SLOT[0..2]
    # => [slot_suffix, slot_prefix]

    exec.native_account::get_initial_item
    # => [window_blocks, unpriced_asset_policy, config_generation, 0]

    movup.3 drop
    # => [window_blocks, unpriced_asset_policy, config_generation]
end

#! Reads the spending limit from the initial account state.
#!
#! Reads the initial state so a limit raised earlier in this transaction does not apply to it.
#!
#! Inputs:  []
#! Outputs: [limit]
#!
#! Where:
#! - limit is the configured limit in the base asset, or 0 when the budget is not configured.
#!
#! Invocation: exec
proc get_initial_spending_limit() -> AssetAmount
    push.SPENDING_LIMIT_SLOT[0..2]
    # => [slot_suffix, slot_prefix]

    exec.native_account::get_initial_item
    # => [limit, 0, 0, 0]

    movdn.3 drop drop drop
    # => [limit]
end

#! Returns the index of the spending window the transaction's reference block falls into.
#!
#! Inputs:  [window_blocks]
#! Outputs: [window_index]
#!
#! Where:
#! - window_blocks is the configured window length in blocks; the caller asserts it is a non-zero
#!   `u32`.
#! - window_index is floor(reference_block_num / window_blocks).
#!
#! Invocation: exec
proc current_window_index(window_blocks: u32) -> u32
    exec.tx::get_reference_block_number
    # => [reference_block_num, window_blocks]

    swap u32div
    # => [window_index]
end

#! Charges one asset to the spending budget.
#!
#! Only fungible assets are metered. A non-fungible asset has no amount to budget and is dropped
#! here unmetered; moving one is governed by the procedure policies alone, exactly as if the
#! spending-limit policy were disabled for it.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, window_index, unpriced_asset_policy, config_generation]
#! Outputs: []
#!
#! Where:
#! - ASSET_ID and ASSET_VALUE are the asset leaving the account.
#! - window_index, unpriced_asset_policy and config_generation are the policy state loaded by
#!   `enforce_spending_limits`.
#!
#! Side effects, panics: see `meter_fungible_asset`.
#!
#! Invocation: exec
proc meter_asset(
    asset_id: AssetId,
    asset_value: AssetValue,
    window_index: u32,
    unpriced_asset_policy: UnpricedAssetPolicy,
    config_generation: felt
)
    dupw exec.asset::id_into_composition
    # => [composition, ASSET_ID, ASSET_VALUE, window_index, unpriced_asset_policy,
    #     config_generation]

    eq.COMPOSITION_FUNGIBLE
    # => [is_fungible, ASSET_ID, ASSET_VALUE, window_index, unpriced_asset_policy,
    #     config_generation]

    if.true
        swapw exec.asset::fungible_value_into_amount_unchecked
        # => [amount, ASSET_ID, window_index, unpriced_asset_policy, config_generation]

        exec.meter_fungible_asset
        # => []
    else
        # Non-fungible: outside the policy.
        dropw dropw drop drop drop
        # => []
    end
end

#! Prices a fungible amount into the base asset and charges it to the spending budget.
#!
#! The asset is priced when the budget is configured and it is either the base asset or one the
#! oracle has a rate for; an unpriced asset falls to the unpriced-asset policy.
#!
#! Inputs:  [amount, ASSET_ID, window_index, unpriced_asset_policy, config_generation]
#! Outputs: []
#!
#! Side effects:
#! - Writes SPENDING_TRACKER_SLOT when the asset was charged.
#! - Tightens the transaction expiration delta when the oracle was read (`convert_to_base_asset`).
#!
#! Panics if:
#! - the asset is unpriced and the policy is UNPRICED_ASSET_REJECT
#!   (`ERR_UNPRICED_ASSET_REJECTED`).
#! - the budget's window total would exceed its limit (`ERR_SPENDING_LIMIT_EXCEEDED`).
#!
#! Invocation: exec
proc meter_fungible_asset(
    amount: AssetAmount,
    asset_id: AssetId,
    window_index: u32,
    unpriced_asset_policy: UnpricedAssetPolicy,
    config_generation: felt
)
    exec.get_initial_spending_limit
    # => [limit, amount, ASSET_ID, window_index, unpriced_asset_policy, config_generation]

    dup neq.0
    # => [is_configured, limit, amount, ASSET_ID, window_index, unpriced_asset_policy,
    #     config_generation]

    if.true
        movdn.5 movdn.4
        # => [ASSET_ID, amount, limit, window_index, unpriced_asset_policy, config_generation]

        exec.convert_to_base_asset
        # => [is_priced, converted_amount, limit, window_index, unpriced_asset_policy,
        #     config_generation]

        if.true
            movup.3 movdn.4
            # => [converted_amount, limit, window_index, config_generation, unpriced_asset_policy]

            exec.charge_budget
            # => [unpriced_asset_policy]

            push.1
            # => [is_charged = 1, unpriced_asset_policy]
        else
            # The oracle has no rate for the asset.
            drop drop drop swap drop
            # => [unpriced_asset_policy]

            push.0
            # => [is_charged = 0, unpriced_asset_policy]
        end
    else
        # No budget is configured, so nothing can be charged.
        drop drop dropw drop swap drop
        # => [unpriced_asset_policy]

        push.0
        # => [is_charged = 0, unpriced_asset_policy]
    end
    # => [is_charged, unpriced_asset_policy]

    swap eq.UNPRICED_ASSET_REJECT not or
    # => [is_allowed]

    assert.err=ERR_UNPRICED_ASSET_REJECTED
    # => []
end

#! Converts an amount of an asset into the base asset through the configured price oracle.
#!
#! The base asset itself converts one to one without a foreign call. Without an oracle every other
#! asset is unpriced. With one, the asset is priced by `price_oracle::get_conversion_rate` on the
#! oracle account, read at the transaction reference block. Right after the read the transaction's
#! expiration delta is tightened to `max_oracle_block_age`, so the reference block the price came
#! from cannot be older than that at inclusion. The rate is used only when the provider could price
#! the pair (`last_updated != 0`); the provider's own staleness rule is what makes it zero otherwise.
#!
#! Inputs:  [ASSET_ID, amount]
#! Outputs: [is_priced, converted_amount]
#!
#! Where:
#! - is_priced is 1 when a usable rate was found; converted_amount is then
#!   ceil(amount * num / den) in the base asset, else 0.
#!
#! Side effects:
#! - Tightens the transaction expiration delta to `max_oracle_block_age` when a foreign call was
#!   made.
#!
#! Panics if:
#! - the oracle account id is invalid or does not expose `get_conversion_rate` (see
#!   `tx::execute_foreign_procedure`).
#! - the rate provider aborts.
#! - the converted amount overflows a fungible asset amount (`fee::convert_amount`).
#!
#! Invocation: exec
@locals(4)
proc convert_to_base_asset(asset_id: AssetId, amount: AssetAmount) -> (Bool, AssetAmount)
    movup.4 loc_store.CONVERT_AMOUNT_LOC
    # => [ASSET_ID]

    push.SPENDING_BASE_ASSET_SLOT[0..2] exec.native_account::get_initial_item
    # => [BASE_ASSET_ID, ASSET_ID]

    dupw.1 dupw.1 exec.word::eq
    # => [is_base_asset, BASE_ASSET_ID, ASSET_ID]

    if.true
        dropw dropw
        # => []

        push.1 loc_load.CONVERT_AMOUNT_LOC swap
        # => [is_priced = 1, converted_amount = amount]
    else
        push.SPENDING_ORACLE_SLOT[0..2] exec.native_account::get_initial_item
        # => [oracle_id_suffix, oracle_id_prefix, max_oracle_block_age, 0, BASE_ASSET_ID, ASSET_ID]

        movup.3 drop movup.2 loc_store.CONVERT_MAX_BLOCK_AGE_LOC
        # => [oracle_id_suffix, oracle_id_prefix, BASE_ASSET_ID, ASSET_ID]

        dup eq.0 dup.2 eq.0 and
        # => [is_oracle_unset, oracle_id_suffix, oracle_id_prefix, BASE_ASSET_ID, ASSET_ID]

        if.true
            # ----- No oracle: nothing but the base asset can be priced. -----
            drop drop dropw dropw
            # => []

            push.0.0
            # => [is_priced = 0, converted_amount = 0]
        else
            loc_store.CONVERT_ORACLE_ID_SUFFIX_LOC loc_store.CONVERT_ORACLE_ID_PREFIX_LOC
            # => [BASE_ASSET_ID, ASSET_ID]

            # ----- Call the oracle: get_conversion_rate(SOURCE = ASSET_ID, TARGET = BASE_ASSET_ID). -----
            # The foreign procedure takes two words; the rest of its 16-element frame is padding.
            padw padw
            # => [pad(8), BASE_ASSET_ID, ASSET_ID]

            swapdw
            # => [BASE_ASSET_ID, ASSET_ID, pad(8)]

            swapw
            # => [ASSET_ID, BASE_ASSET_ID, pad(8)]

            procref.price_oracle::get_conversion_rate
            # => [GET_CONVERSION_RATE_ROOT, ASSET_ID, BASE_ASSET_ID, pad(8)]

            loc_load.CONVERT_ORACLE_ID_PREFIX_LOC loc_load.CONVERT_ORACLE_ID_SUFFIX_LOC
            # => [oracle_id_suffix, oracle_id_prefix, GET_CONVERSION_RATE_ROOT, ASSET_ID,
            #     BASE_ASSET_ID, pad(8)]

            exec.tx::execute_foreign_procedure
            # => [last_updated, num, den, pad(13)]

            swapw.3 dropw dropw dropw movup.3 drop
            # => [last_updated, num, den]

            # ----- Bound the age of the oracle state just read, in blocks. The kernel keeps the
            # minimum of all deltas set, so this can only tighten what the approval expiration set. -----
            loc_load.CONVERT_MAX_BLOCK_AGE_LOC exec.tx::update_expiration_block_delta
            # => [last_updated, num, den]

            # ----- A zero last_updated means the provider could not, or would not, price the pair. -----
            eq.0
            # => [is_unpriced, num, den]

            if.true
                drop drop
                # => []

                push.0.0
                # => [is_priced = 0, converted_amount = 0]
            else
                loc_load.CONVERT_AMOUNT_LOC movdn.2
                # => [num, den, amount]

                movup.2 exec.fee::convert_amount
                # => [converted_amount]

                push.1
                # => [is_priced = 1, converted_amount]
            end
        end
    end
end

#! Charges an amount to the budget: rolls the tracker over if needed, adds the amount, asserts the
#! limit and persists the tracker.
#!
#! Inputs:  [amount, limit, window_index, config_generation]
#! Outputs: []
#!
#! Side effects:
#! - Writes SPENDING_TRACKER_SLOT.
#!
#! Panics if:
#! - the budget's window total would exceed its limit (`ERR_SPENDING_LIMIT_EXCEEDED`).
#!
#! Invocation: exec
proc charge_budget(amount: AssetAmount, limit: AssetAmount, window_index: u32, config_generation: felt)
    movup.3 movup.3
    # => [window_index, config_generation, amount, limit]

    dup.1 movdn.4
    # => [window_index, config_generation, amount, limit, config_generation]

    exec.load_window_spend
    # => [spent, effective_window_index, amount, limit, config_generation]

    movup.2 add
    # => [total, effective_window_index, limit, config_generation]

    # Both operands are at most FUNGIBLE_ASSET_MAX_AMOUNT and 2 * FUNGIBLE_ASSET_MAX_AMOUNT is
    # p - 1, so the sum cannot wrap the field. Saturate it so the stored total keeps the next
    # charge's sum inside the same bound.
    push.FUNGIBLE_ASSET_MAX_AMOUNT swap
    # => [total, fungible_asset_max_amount, effective_window_index, limit, config_generation]

    dup dup.2 lt
    # => [is_below_max, total, fungible_asset_max_amount, effective_window_index, limit,
    #     config_generation]

    cdrop
    # => [total, effective_window_index, limit, config_generation]

    # ----- Assert total <= limit. -----
    dup dup.3 lte
    # => [is_within_limit, total, effective_window_index, limit, config_generation]

    assert.err=ERR_SPENDING_LIMIT_EXCEEDED
    # => [total, effective_window_index, limit, config_generation]

    movup.2 drop
    # => [total, effective_window_index, config_generation]

    exec.store_window_spend
    # => []
end

#! Returns the amount already spent in the current window.
#!
#! Reads the tracker from the *current* account state so that several assets in one transaction
#! accumulate instead of overwriting each other. Returns 0 when the tracker belongs to an earlier
#! window or an earlier configuration generation.
#!
#! A tracker ahead of the current window can only come from an executor that picked an older
#! reference block. Rather than failing the transaction, the spend is charged to the tracked window:
#! the budget is not reset, so the rollback buys nothing, and a client building against a slightly
#! stale reference block still goes through.
#!
#! Inputs:  [window_index, config_generation]
#! Outputs: [spent, effective_window_index]
#!
#! Invocation: exec
proc load_window_spend(window_index: u32, config_generation: felt) -> (AssetAmount, u32)
    push.SPENDING_TRACKER_SLOT[0..2]
    # => [slot_suffix, slot_prefix, window_index, config_generation]

    exec.active_account::get_item
    # => [spent, tracked_window_index, tracked_generation, 0, window_index, config_generation]

    movup.3 drop
    # => [spent, tracked_window_index, tracked_generation, window_index, config_generation]

    movup.2 movup.4 eq
    # => [is_current_generation, spent, tracked_window_index, window_index]

    if.true
        swap
        # => [tracked_window_index, spent, window_index]

        dup dup.3 lt
        # => [is_earlier_window, tracked_window_index, spent, window_index]

        if.true
            # The tracker is from a past window, so this transaction opens a fresh one.
            drop drop
            # => [window_index]

            push.0
            # => [spent, effective_window_index]
        else
            # The tracker is at, or ahead of, the current window; keep accumulating into it.
            movup.2 drop
            # => [tracked_window_index, spent]

            swap
            # => [spent, effective_window_index]
        end
    else
        # The tracker predates the current configuration, so it carries no usable total.
        drop drop
        # => [window_index]

        push.0
        # => [spent, effective_window_index]
    end
end

#! Persists the budget's tracker.
#!
#! Inputs:  [total, window_index, config_generation]
#! Outputs: []
#!
#! Side effects:
#! - Writes SPENDING_TRACKER_SLOT.
#!
#! Invocation: exec
proc store_window_spend(total: AssetAmount, window_index: u32, config_generation: felt)
    push.0 movdn.3
    # => [total, window_index, config_generation, 0]

    push.SPENDING_TRACKER_SLOT[0..2]
    # => [slot_suffix, slot_prefix, total, window_index, config_generation, 0]

    exec.native_account::set_item dropw
    # => []
end
