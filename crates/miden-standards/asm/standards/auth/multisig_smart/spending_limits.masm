use miden::core::word
use miden::protocol::active_account
use miden::protocol::asset
use {ASSET_SIZE, COMPOSITION_FUNGIBLE, FUNGIBLE_ASSET_MAX_AMOUNT} from miden::protocol::asset
use {MAX_ASSETS_PER_NOTE} from miden::protocol::constants
use miden::protocol::native_account
use miden::protocol::output_note
use miden::protocol::tx
use {AccountId, AssetAmount, AssetId, AssetValue, Bool, StorageMapKey} from miden::protocol::types
use miden::standards::fee
use miden::standards::oracle::price_oracle

# Spending limits (per-faucet and combined window budgets) for the multisig smart account.
#
# Every fungible asset a transaction sends out through an output note is charged to the budget of
# the faucet that issued it, in the asset's own unit, and, when it can be priced through the
# configured oracle, to the account's combined budget in the base asset. Budgets reset at fixed
# window boundaries derived from the reference block number. A transaction that would push any
# budget over its limit fails regardless of how many approvers signed it. The policy never changes
# how many signatures a transaction needs, it only decides whether the transaction is allowed at
# all. Non-fungible assets are outside the policy.

# CONSTANTS
# =================================================================================================

# [window_blocks, uncovered_asset_policy, config_generation, 0]
# A zero window_blocks disables the policy for the account.
const SPENDING_CONFIG_SLOT = word("miden::standards::auth::multisig_smart::spending_config")

# [oracle_id_suffix, oracle_id_prefix, max_oracle_block_age, 0]
# The price oracle account the combined budget converts through, and how many blocks after the
# reference block a transaction that read it stays includable.
const SPENDING_ORACLE_SLOT = word("miden::standards::auth::multisig_smart::spending_oracle")

# [BASE_ASSET_ID]
# The asset the combined budget is denominated in.
const SPENDING_BASE_ASSET_SLOT = word("miden::standards::auth::multisig_smart::spending_base_asset")

# Map entries: [BUDGET_KEY] -> [limit, 0, 0, 0]
# BUDGET_KEY is a faucet key [faucet_id_suffix, faucet_id_prefix, 0, 0] or COMBINED_BUDGET_KEY. An
# absent entry, equivalently a zero limit, means the budget is not configured.
const SPENDING_LIMITS_SLOT = word("miden::standards::auth::multisig_smart::spending_limits")

# Map entries: [BUDGET_KEY] -> [spent_in_window, window_index, config_generation, 0]
const SPENDING_TRACKERS_SLOT = word("miden::standards::auth::multisig_smart::spending_trackers")

# Budget key of the combined budget. An account id is never all zeros, so no faucet key equals it.
const COMBINED_BUDGET_KEY = [0, 0, 0, 0]

# Assets no budget charged are not metered.
const UNCOVERED_ASSET_ALLOW = 0

# Assets no budget charged fail the transaction.
const UNCOVERED_ASSET_REJECT = 1

const UNCOVERED_ASSET_POLICY_MAX = 1

# Scratch area for the assets of one output note.
const NOTE_ASSETS_NUM_ELEMENTS = MAX_ASSETS_PER_NOTE * ASSET_SIZE

# Largest delta `tx::update_expiration_block_delta` accepts (u16).
const MAX_EXPIRATION_BLOCK_DELTA = 65535

# ERRORS
# =================================================================================================

const ERR_WINDOW_BLOCKS_NOT_U32 = "window_blocks must be u32"
const ERR_UNCOVERED_ASSET_POLICY_INVALID = "uncovered_asset_policy must be 0 or 1"
const ERR_MAX_ORACLE_BLOCK_AGE_NOT_U32 = "max_oracle_block_age must be u32"
const ERR_MAX_ORACLE_BLOCK_AGE_NOT_U16 = "max_oracle_block_age must be u16"
const ERR_MAX_ORACLE_BLOCK_AGE_ZERO = "max_oracle_block_age must be non-zero"
const ERR_UNCOVERED_ASSET_REJECTED = "spent asset is covered by no spending budget"
const ERR_SPENDING_LIMIT_EXCEEDED = "spending limit exceeded for the current window"

# LOCAL ADDRESSES (enforce_spending_limits)
# =================================================================================================

const ENFORCE_NOTE_ASSETS_LOC = 0
const ENFORCE_ASSET_PTR_LOC = ENFORCE_NOTE_ASSETS_LOC + NOTE_ASSETS_NUM_ELEMENTS
const ENFORCE_WINDOW_INDEX_LOC = ENFORCE_ASSET_PTR_LOC + 1
const ENFORCE_UNCOVERED_POLICY_LOC = ENFORCE_WINDOW_INDEX_LOC + 1
const ENFORCE_GENERATION_LOC = ENFORCE_UNCOVERED_POLICY_LOC + 1

# LOCAL ADDRESSES (meter_fungible_asset)
# =================================================================================================

const METER_ASSET_ID_LOC = 0
const METER_FAUCET_KEY_LOC = 4
const METER_AMOUNT_LOC = 8
const METER_WINDOW_INDEX_LOC = 9
const METER_UNCOVERED_POLICY_LOC = 10
const METER_GENERATION_LOC = 11
const METER_IS_COVERED_LOC = 12

# LOCAL ADDRESSES (convert_to_base_asset)
# =================================================================================================

const CONVERT_AMOUNT_LOC = 0
const CONVERT_MAX_BLOCK_AGE_LOC = 1

# LOCAL ADDRESSES (charge_budget)
# =================================================================================================

const CHARGE_BUDGET_KEY_LOC = 0
const CHARGE_GENERATION_LOC = 4

# CONFIGURATION
# =================================================================================================

#! Sets the account-wide spending-limit policy: the window length and how uncovered assets are
#! treated.
#!
#! Lengthening the window or switching uncovered assets to `allow` weakens every budget, and
#! changing the window length resets every running total, so this procedure should carry a policy
#! at least as strong as the account wants its spending limits to be. Left unpolicied, the default
#! threshold suffices to reset every budget.
#!
#! Changing `window_blocks` bumps `config_generation`: window indices computed under different
#! lengths are not comparable, so every tracker written under the old generation is treated as the
#! start of a fresh window. The bump happens only when the length actually changes, so a call that
#! keeps it cannot be used as a budget reset.
#!
#! Inputs:  [window_blocks, uncovered_asset_policy]
#! Outputs: []
#!
#! Where:
#! - window_blocks is the length of one spending window in blocks; zero disables the policy.
#! - uncovered_asset_policy is UNCOVERED_ASSET_ALLOW or UNCOVERED_ASSET_REJECT.
#!
#! Panics if:
#! - `window_blocks` is not a valid `u32` field element (`ERR_WINDOW_BLOCKS_NOT_U32`).
#! - `uncovered_asset_policy` is not 0 or 1 (`ERR_UNCOVERED_ASSET_POLICY_INVALID`).
#!
#! Invocation: call
@account_procedure
pub proc update_spending_limits_policy(window_blocks: u32, uncovered_asset_policy: u8)
    u32assert.err=ERR_WINDOW_BLOCKS_NOT_U32
    # => [window_blocks, uncovered_asset_policy]

    dup.1 u32assert.err=ERR_UNCOVERED_ASSET_POLICY_INVALID
    # => [uncovered_asset_policy, window_blocks, uncovered_asset_policy]

    u32lte.UNCOVERED_ASSET_POLICY_MAX assert.err=ERR_UNCOVERED_ASSET_POLICY_INVALID
    # => [window_blocks, uncovered_asset_policy]

    # ----- Bump the generation only when the window length actually changes. -----
    exec.get_initial_spending_config
    # => [old_window_blocks, old_policy, old_generation, window_blocks, uncovered_asset_policy]

    swap drop
    # => [old_window_blocks, old_generation, window_blocks, uncovered_asset_policy]

    dup.2 neq
    # => [is_new_window_length, old_generation, window_blocks, uncovered_asset_policy]

    if.true
        add.1
    end
    # => [config_generation, window_blocks, uncovered_asset_policy]

    movdn.2 push.0 movdn.3
    # => [window_blocks, uncovered_asset_policy, config_generation, 0]

    push.SPENDING_CONFIG_SLOT[0..2]
    # => [slot_suffix, slot_prefix, window_blocks, uncovered_asset_policy, config_generation, 0]

    exec.native_account::set_item
    # => [OLD_CONFIG]

    dropw
    # => []
end

#! Sets the price oracle the combined budget converts through, the asset it is denominated in and
#! the bound on how old the oracle state read may be.
#!
#! Pointing the budget at a different oracle or base asset, or loosening the block-age bound,
#! changes what every converted amount means, so this procedure should carry a policy at least as
#! strong as the account wants its combined budget to be.
#!
#! Inputs:  [oracle_id_suffix, oracle_id_prefix, max_oracle_block_age, BASE_ASSET_ID]
#! Outputs: []
#!
#! Where:
#! - oracle_id_{suffix, prefix} identify the account exposing `price_oracle::get_conversion_rate`.
#! - max_oracle_block_age is how many blocks after its reference block a transaction that read the
#!   oracle stays includable, applied through `tx::update_expiration_block_delta` after every read.
#!   Foreign state is not revalidated at inclusion, so this is what keeps an executor from reading a
#!   price at an arbitrarily old block.
#! - BASE_ASSET_ID is the asset the combined budget is denominated in.
#!
#! Panics if:
#! - `max_oracle_block_age` is not a valid `u32` field element (`ERR_MAX_ORACLE_BLOCK_AGE_NOT_U32`).
#! - `max_oracle_block_age` is zero (`ERR_MAX_ORACLE_BLOCK_AGE_ZERO`).
#! - `max_oracle_block_age` exceeds the `u16` range `tx::update_expiration_block_delta` accepts
#!   (`ERR_MAX_ORACLE_BLOCK_AGE_NOT_U16`).
#!
#! Invocation: call
@account_procedure
pub proc update_spending_oracle(oracle_id: AccountId, max_oracle_block_age: u16, base_asset_id: AssetId)
    movup.2
    # => [max_oracle_block_age, oracle_id_suffix, oracle_id_prefix, BASE_ASSET_ID]

    u32assert.err=ERR_MAX_ORACLE_BLOCK_AGE_NOT_U32
    dup eq.0 assertz.err=ERR_MAX_ORACLE_BLOCK_AGE_ZERO
    dup u32lte.MAX_EXPIRATION_BLOCK_DELTA assert.err=ERR_MAX_ORACLE_BLOCK_AGE_NOT_U16
    # => [max_oracle_block_age, oracle_id_suffix, oracle_id_prefix, BASE_ASSET_ID]

    movdn.2 push.0 movdn.3
    # => [oracle_id_suffix, oracle_id_prefix, max_oracle_block_age, 0, BASE_ASSET_ID]

    push.SPENDING_ORACLE_SLOT[0..2]
    # => [slot_suffix, slot_prefix, ORACLE_CONFIG, BASE_ASSET_ID]

    exec.native_account::set_item dropw
    # => [BASE_ASSET_ID]

    push.SPENDING_BASE_ASSET_SLOT[0..2]
    # => [slot_suffix, slot_prefix, BASE_ASSET_ID]

    exec.native_account::set_item dropw
    # => []
end

#! Sets or clears the spending limit of one faucet, in the faucet's own unit.
#!
#! Raising or clearing a limit weakens the protection it provides, so this procedure should carry
#! a policy at least as strong as the account wants its spending limits to be. Left unpolicied, the
#! default threshold suffices to lift any limit.
#!
#! A zero limit clears the entry. Changing a limit does not touch the budget's running total: a
#! lowered limit applies to what was already spent in the current window.
#!
#! Inputs:  [faucet_id_suffix, faucet_id_prefix, limit]
#! Outputs: []
#!
#! Where:
#! - faucet_id_{suffix, prefix} identify the faucet whose assets the limit applies to.
#! - limit is the maximum amount of the faucet's assets that may leave the account per window.
#!   Only fungible assets are metered, so a limit on a non-fungible faucet has no effect.
#!
#! Invocation: call
@account_procedure
pub proc set_faucet_spending_limit(faucet_id: AccountId, limit: AssetAmount)
    push.0.0 movdn.3 movdn.3
    # => [FAUCET_KEY, limit]

    exec.set_budget_limit
    # => []
end

#! Sets or clears the combined spending limit, in the base asset.
#!
#! Same governance considerations as `set_faucet_spending_limit`. A non-zero combined limit needs
#! `update_spending_oracle` to have been called; otherwise the first priced asset fails the foreign
#! call against a zero oracle id.
#!
#! Inputs:  [limit]
#! Outputs: []
#!
#! Invocation: call
@account_procedure
pub proc set_combined_spending_limit(limit: AssetAmount)
    push.COMBINED_BUDGET_KEY
    # => [COMBINED_BUDGET_KEY, limit]

    exec.set_budget_limit
    # => []
end

# ENFORCEMENT
# =================================================================================================

#! Charges every fungible asset this transaction sends out against its faucet's budget and the
#! combined budget, and fails the transaction if any budget is exceeded.
#!
#! Iterates every output note and every asset in it. For each fungible asset, `meter_asset` charges
#! the faucet's budget when one is configured and the combined budget when the asset can be priced
#! into the base asset; an asset charged by neither falls to the uncovered-asset policy.
#! Non-fungible assets are skipped.
#!
#! A no-op when the policy is disabled (`window_blocks == 0`) or the transaction creates no output
#! notes.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Panics if:
#! - an asset is covered by no budget and the policy is UNCOVERED_ASSET_REJECT
#!   (`ERR_UNCOVERED_ASSET_REJECTED`).
#! - a budget's window total would exceed its limit (`ERR_SPENDING_LIMIT_EXCEEDED`).
#! - the combined budget is configured but the oracle call fails (see
#!   `tx::execute_foreign_procedure`).
#!
#! Invocation: exec
@locals(132)
pub proc enforce_spending_limits()
    exec.get_initial_spending_config
    # => [window_blocks, uncovered_asset_policy, config_generation]

    dup eq.0
    # => [is_disabled, window_blocks, uncovered_asset_policy, config_generation]

    if.true
        drop drop drop
        # => []
    else
        exec.current_window_index
        # => [window_index, uncovered_asset_policy, config_generation]

        loc_store.ENFORCE_WINDOW_INDEX_LOC
        loc_store.ENFORCE_UNCOVERED_POLICY_LOC
        loc_store.ENFORCE_GENERATION_LOC
        # => []

        exec.tx::get_num_output_notes
        # => [num_output_notes]

        dup neq.0
        # => [has_notes, num_output_notes]

        while.true
            # => [note_count]

            sub.1
            # => [note_index]

            dup locaddr.ENFORCE_NOTE_ASSETS_LOC
            # => [assets_ptr, note_index, note_index]

            dup loc_store.ENFORCE_ASSET_PTR_LOC
            # => [assets_ptr, note_index, note_index]

            exec.output_note::get_assets
            # => [num_assets, note_index]

            dup neq.0
            # => [has_assets, num_assets, note_index]

            while.true
                # => [num_assets, note_index]

                sub.1
                # => [remaining_assets, note_index]

                loc_load.ENFORCE_GENERATION_LOC
                loc_load.ENFORCE_UNCOVERED_POLICY_LOC
                loc_load.ENFORCE_WINDOW_INDEX_LOC
                # => [window_index, uncovered_asset_policy, config_generation, remaining_assets,
                #     note_index]

                loc_load.ENFORCE_ASSET_PTR_LOC
                # => [asset_ptr, window_index, uncovered_asset_policy, config_generation,
                #     remaining_assets, note_index]

                dup add.ASSET_SIZE loc_store.ENFORCE_ASSET_PTR_LOC
                # => [asset_ptr, window_index, uncovered_asset_policy, config_generation,
                #     remaining_assets, note_index]

                exec.asset::load
                # => [ASSET_ID, ASSET_VALUE, window_index, uncovered_asset_policy,
                #     config_generation, remaining_assets, note_index]

                exec.meter_asset
                # => [remaining_assets, note_index]

                dup neq.0
                # => [has_assets, remaining_assets, note_index]
            end
            # => [remaining_assets, note_index]

            drop
            # => [note_index]

            dup neq.0
            # => [has_notes, note_index]
        end
        # => [note_index]

        drop
        # => []
    end
end

# HELPER PROCEDURES
# =================================================================================================

#! Loads the spending-limit policy from the initial `SPENDING_CONFIG_SLOT`.
#!
#! Reads the transaction's initial storage state, so a policy update earlier in the same
#! transaction does not affect how that transaction is metered.
#!
#! Inputs:  []
#! Outputs: [window_blocks, uncovered_asset_policy, config_generation]
#!
#! Invocation: exec
proc get_initial_spending_config() -> (u32, u8, felt)
    push.SPENDING_CONFIG_SLOT[0..2]
    # => [slot_suffix, slot_prefix]

    exec.native_account::get_initial_item
    # => [window_blocks, uncovered_asset_policy, config_generation, 0]

    movup.3 drop
    # => [window_blocks, uncovered_asset_policy, config_generation]
end

#! Writes a budget's limit entry.
#!
#! Inputs:  [BUDGET_KEY, limit]
#! Outputs: []
#!
#! Invocation: exec
proc set_budget_limit(budget_key: StorageMapKey, limit: AssetAmount)
    push.0.0.0 movdn.7 movdn.7 movdn.7
    # => [BUDGET_KEY, limit, 0, 0, 0]

    push.SPENDING_LIMITS_SLOT[0..2]
    # => [slot_suffix, slot_prefix, BUDGET_KEY, LIMIT_ENTRY]

    exec.native_account::set_map_item
    # => [OLD_LIMIT_ENTRY]

    dropw
    # => []
end

#! Reads a budget's limit from the initial account state.
#!
#! Reads the initial state so a limit raised earlier in this transaction does not apply to it.
#!
#! Inputs:  [BUDGET_KEY]
#! Outputs: [limit]
#!
#! Where:
#! - limit is the budget's configured limit, or 0 when the budget is not configured.
#!
#! Invocation: exec
proc get_initial_budget_limit(budget_key: StorageMapKey) -> AssetAmount
    push.SPENDING_LIMITS_SLOT[0..2]
    # => [slot_suffix, slot_prefix, BUDGET_KEY]

    exec.native_account::get_initial_map_item
    # => [limit, 0, 0, 0]

    movdn.3 drop drop drop
    # => [limit]
end

#! Returns the index of the spending window the transaction's reference block falls into.
#!
#! Inputs:  [window_blocks]
#! Outputs: [window_index]
#!
#! Where:
#! - window_blocks is the configured window length in blocks; it must be non-zero.
#! - window_index is floor(reference_block_num / window_blocks).
#!
#! Panics if:
#! - `window_blocks` is not a valid `u32` field element (`ERR_WINDOW_BLOCKS_NOT_U32`).
#!
#! Invocation: exec
proc current_window_index(window_blocks: u32) -> u32
    u32assert.err=ERR_WINDOW_BLOCKS_NOT_U32
    # => [window_blocks]

    exec.tx::get_reference_block_number
    # => [reference_block_num, window_blocks]

    swap u32div
    # => [window_index]
end

#! Charges one asset against its faucet's budget and the combined budget.
#!
#! Only fungible assets are metered. A non-fungible asset has no amount to budget and is dropped
#! here unmetered; moving one is governed by the procedure policies alone, exactly as if the
#! spending-limit policy were disabled for it.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, window_index, uncovered_asset_policy, config_generation]
#! Outputs: []
#!
#! Where:
#! - ASSET_ID and ASSET_VALUE are the asset leaving the account.
#! - window_index, uncovered_asset_policy and config_generation are the policy state loaded by
#!   `enforce_spending_limits`.
#!
#! Side effects, panics: see `meter_fungible_asset`.
#!
#! Invocation: exec
proc meter_asset(
    asset_id: AssetId,
    asset_value: AssetValue,
    window_index: u32,
    uncovered_asset_policy: u8,
    config_generation: felt
)
    dupw exec.asset::id_into_composition
    # => [composition, ASSET_ID, ASSET_VALUE, window_index, uncovered_asset_policy,
    #     config_generation]

    eq.COMPOSITION_FUNGIBLE
    # => [is_fungible, ASSET_ID, ASSET_VALUE, window_index, uncovered_asset_policy,
    #     config_generation]

    if.true
        swapw exec.asset::fungible_value_into_amount_unchecked
        # => [amount, ASSET_ID, window_index, uncovered_asset_policy, config_generation]

        exec.meter_fungible_asset
        # => []
    else
        # Non-fungible: outside the policy.
        dropw dropw drop drop drop
        # => []
    end
end

#! Charges a fungible amount against its faucet's budget and the combined budget.
#!
#! Inputs:  [amount, ASSET_ID, window_index, uncovered_asset_policy, config_generation]
#! Outputs: []
#!
#! Side effects:
#! - Writes the faucet's and/or the combined budget's tracker entry in SPENDING_TRACKERS_SLOT.
#!
#! Panics if:
#! - no budget charged the asset and the policy is UNCOVERED_ASSET_REJECT
#!   (`ERR_UNCOVERED_ASSET_REJECTED`).
#! - a budget's window total would exceed its limit (`ERR_SPENDING_LIMIT_EXCEEDED`).
#!
#! Invocation: exec
@locals(13)
proc meter_fungible_asset(
    amount: AssetAmount,
    asset_id: AssetId,
    window_index: u32,
    uncovered_asset_policy: u8,
    config_generation: felt
)
    loc_store.METER_AMOUNT_LOC
    # => [ASSET_ID, window_index, uncovered_asset_policy, config_generation]

    loc_storew_le.METER_ASSET_ID_LOC
    # => [ASSET_ID, window_index, uncovered_asset_policy, config_generation]

    exec.asset::id_into_faucet_id
    # => [faucet_id_suffix, faucet_id_prefix, window_index, uncovered_asset_policy,
    #     config_generation]

    push.0.0 movdn.3 movdn.3
    # => [FAUCET_KEY, window_index, uncovered_asset_policy, config_generation]

    loc_storew_le.METER_FAUCET_KEY_LOC dropw
    # => [window_index, uncovered_asset_policy, config_generation]

    loc_store.METER_WINDOW_INDEX_LOC
    loc_store.METER_UNCOVERED_POLICY_LOC
    loc_store.METER_GENERATION_LOC
    # => []

    push.0 loc_store.METER_IS_COVERED_LOC
    # => []

    # ----- Layer 1: the faucet's own budget, in the asset's own unit. -----
    padw loc_loadw_le.METER_FAUCET_KEY_LOC exec.get_initial_budget_limit
    # => [limit]

    dup eq.0
    # => [is_unconfigured, limit]

    if.true
        drop
        # => []
    else
        loc_load.METER_GENERATION_LOC swap
        # => [limit, config_generation]

        loc_load.METER_WINDOW_INDEX_LOC swap
        # => [limit, window_index, config_generation]

        loc_load.METER_AMOUNT_LOC
        # => [amount, limit, window_index, config_generation]

        padw loc_loadw_le.METER_FAUCET_KEY_LOC
        # => [FAUCET_KEY, amount, limit, window_index, config_generation]

        exec.charge_budget
        # => []

        push.1 loc_store.METER_IS_COVERED_LOC
        # => []
    end

    # ----- Layer 2: the combined budget, in the base asset. -----
    push.COMBINED_BUDGET_KEY exec.get_initial_budget_limit
    # => [combined_limit]

    dup eq.0
    # => [is_unconfigured, combined_limit]

    if.true
        drop
        # => []
    else
        loc_load.METER_AMOUNT_LOC
        # => [amount, combined_limit]

        padw loc_loadw_le.METER_ASSET_ID_LOC
        # => [ASSET_ID, amount, combined_limit]

        exec.convert_to_base_asset
        # => [is_priced, converted_amount, combined_limit]

        if.true
            loc_load.METER_GENERATION_LOC movdn.2
            # => [converted_amount, combined_limit, config_generation]

            loc_load.METER_WINDOW_INDEX_LOC movdn.2
            # => [converted_amount, combined_limit, window_index, config_generation]

            push.COMBINED_BUDGET_KEY
            # => [COMBINED_BUDGET_KEY, converted_amount, combined_limit, window_index,
            #     config_generation]

            exec.charge_budget
            # => []

            push.1 loc_store.METER_IS_COVERED_LOC
            # => []
        else
            drop drop
            # => []
        end
    end

    # ----- Uncovered assets fall to the policy. -----
    loc_load.METER_IS_COVERED_LOC eq.0
    # => [is_uncovered]

    if.true
        loc_load.METER_UNCOVERED_POLICY_LOC eq.UNCOVERED_ASSET_REJECT
        # => [must_reject]

        assertz.err=ERR_UNCOVERED_ASSET_REJECTED
        # => []
    end
end

#! Converts an amount of an asset into the base asset through the configured price oracle.
#!
#! The base asset itself converts one to one without a foreign call. Any other asset is priced by
#! `price_oracle::get_conversion_rate` on the oracle account, read at the transaction reference
#! block. Right after the read the transaction's expiration delta is tightened to
#! `max_oracle_block_age`, so the reference block the price came from cannot be older than that at
#! inclusion. The rate is used only when the provider could price the pair (`last_updated != 0`);
#! the provider's own staleness rule is what makes it zero otherwise.
#!
#! Inputs:  [ASSET_ID, amount]
#! Outputs: [is_priced, converted_amount]
#!
#! Where:
#! - is_priced is 1 when a usable rate was found; converted_amount is then
#!   ceil(amount * num / den) in the base asset, else 0.
#!
#! Side effects:
#! - Tightens the transaction expiration delta to `max_oracle_block_age` when a foreign call was
#!   made.
#!
#! Panics if:
#! - the oracle account id is invalid or does not expose `get_conversion_rate` (see
#!   `tx::execute_foreign_procedure`).
#! - the rate provider aborts.
#! - the converted amount overflows a fungible asset amount (`fee::convert_amount`).
#!
#! Invocation: exec
@locals(2)
proc convert_to_base_asset(asset_id: AssetId, amount: AssetAmount) -> (Bool, AssetAmount)
    movup.4 loc_store.CONVERT_AMOUNT_LOC
    # => [ASSET_ID]

    push.SPENDING_BASE_ASSET_SLOT[0..2] exec.native_account::get_initial_item
    # => [BASE_ASSET_ID, ASSET_ID]

    dupw.1 dupw.1 exec.word::eq
    # => [is_base_asset, BASE_ASSET_ID, ASSET_ID]

    if.true
        dropw dropw
        # => []

        push.1 loc_load.CONVERT_AMOUNT_LOC swap
        # => [is_priced = 1, converted_amount = amount]
    else
        # ----- Call the oracle: get_conversion_rate(SOURCE = ASSET_ID, TARGET = BASE_ASSET_ID). -----
        # The foreign procedure takes two words; the rest of its 16-element frame is padding.
        padw padw
        # => [pad(8), BASE_ASSET_ID, ASSET_ID]

        swapdw
        # => [BASE_ASSET_ID, ASSET_ID, pad(8)]

        swapw
        # => [ASSET_ID, BASE_ASSET_ID, pad(8)]

        procref.price_oracle::get_conversion_rate
        # => [GET_CONVERSION_RATE_ROOT, ASSET_ID, BASE_ASSET_ID, pad(8)]

        push.SPENDING_ORACLE_SLOT[0..2] exec.native_account::get_initial_item
        # => [oracle_id_suffix, oracle_id_prefix, max_oracle_block_age, 0, GET_CONVERSION_RATE_ROOT,
        #     ASSET_ID, BASE_ASSET_ID, pad(8)]

        movup.3 drop movup.2 loc_store.CONVERT_MAX_BLOCK_AGE_LOC
        # => [oracle_id_suffix, oracle_id_prefix, GET_CONVERSION_RATE_ROOT, ASSET_ID, BASE_ASSET_ID,
        #     pad(8)]

        exec.tx::execute_foreign_procedure
        # => [last_updated, num, den, pad(13)]

        swapw.3 dropw dropw dropw movup.3 drop
        # => [last_updated, num, den]

        # ----- Bound the age of the oracle state just read, in blocks. The kernel keeps the minimum
        # of all deltas set, so this can only tighten what the approval expiration set. -----
        loc_load.CONVERT_MAX_BLOCK_AGE_LOC exec.tx::update_expiration_block_delta
        # => [last_updated, num, den]

        # ----- A zero last_updated means the provider could not, or would not, price the pair. -----
        eq.0
        # => [is_unpriced, num, den]

        if.true
            drop drop
            # => []

            push.0.0
            # => [is_priced = 0, converted_amount = 0]
        else
            loc_load.CONVERT_AMOUNT_LOC movdn.2
            # => [num, den, amount]

            movup.2 exec.fee::convert_amount
            # => [converted_amount]

            push.1
            # => [is_priced = 1, converted_amount]
        end
    end
end

#! Charges an amount to a budget: rolls the tracker over if needed, adds the amount, asserts the
#! limit and persists the tracker.
#!
#! Inputs:  [BUDGET_KEY, amount, limit, window_index, config_generation]
#! Outputs: []
#!
#! Panics if:
#! - the budget's window total would exceed its limit (`ERR_SPENDING_LIMIT_EXCEEDED`).
#!
#! Invocation: exec
@locals(5)
proc charge_budget(
    budget_key: StorageMapKey,
    amount: AssetAmount,
    limit: AssetAmount,
    window_index: u32,
    config_generation: felt
)
    # The key is needed for the read and again for the write; the generation for the write only.
    loc_storew_le.CHARGE_BUDGET_KEY_LOC dropw
    # => [amount, limit, window_index, config_generation]

    movup.3 dup loc_store.CHARGE_GENERATION_LOC
    # => [config_generation, amount, limit, window_index]

    movup.3
    # => [window_index, config_generation, amount, limit]

    padw loc_loadw_le.CHARGE_BUDGET_KEY_LOC
    # => [BUDGET_KEY, window_index, config_generation, amount, limit]

    exec.load_window_spend
    # => [spent, effective_window_index, amount, limit]

    movup.2 add
    # => [total, effective_window_index, limit]

    # Both operands are at most FUNGIBLE_ASSET_MAX_AMOUNT and 2 * FUNGIBLE_ASSET_MAX_AMOUNT is
    # p - 1, so the sum cannot wrap the field. Saturate it so the stored total keeps the next
    # transaction's sum inside the same bound.
    push.FUNGIBLE_ASSET_MAX_AMOUNT swap
    # => [total, FUNGIBLE_ASSET_MAX_AMOUNT, effective_window_index, limit]

    dup dup.2 lt
    # => [is_below_max, total, FUNGIBLE_ASSET_MAX_AMOUNT, effective_window_index, limit]

    cdrop
    # => [total, effective_window_index, limit]

    # ----- Assert total <= limit. -----
    dup dup.3 lte
    # => [is_within_limit, total, effective_window_index, limit]

    assert.err=ERR_SPENDING_LIMIT_EXCEEDED
    # => [total, effective_window_index, limit]

    movup.2 drop
    # => [total, effective_window_index]

    loc_load.CHARGE_GENERATION_LOC movdn.2
    # => [total, effective_window_index, config_generation]

    padw loc_loadw_le.CHARGE_BUDGET_KEY_LOC
    # => [BUDGET_KEY, total, effective_window_index, config_generation]

    exec.store_window_spend
    # => []
end

#! Returns the amount already spent for a budget in the current window.
#!
#! Reads the tracker from the *current* account state so that several assets of the same budget in
#! one transaction accumulate instead of overwriting each other. Returns 0 when the tracker belongs
#! to an earlier window or an earlier configuration generation.
#!
#! A tracker ahead of the current window can only come from an executor that picked an older
#! reference block. Rather than failing the transaction, the spend is charged to the tracked window:
#! the budget is not reset, so the rollback buys nothing, and a client building against a slightly
#! stale reference block still goes through.
#!
#! Inputs:  [BUDGET_KEY, window_index, config_generation]
#! Outputs: [spent, effective_window_index]
#!
#! Invocation: exec
proc load_window_spend(
    budget_key: StorageMapKey,
    window_index: u32,
    config_generation: felt
) -> (AssetAmount, u32)
    push.SPENDING_TRACKERS_SLOT[0..2]
    # => [slot_suffix, slot_prefix, BUDGET_KEY, window_index, config_generation]

    exec.active_account::get_map_item
    # => [spent, tracked_window_index, tracked_generation, 0, window_index, config_generation]

    movup.3 drop
    # => [spent, tracked_window_index, tracked_generation, window_index, config_generation]

    movup.2 movup.4 eq
    # => [is_current_generation, spent, tracked_window_index, window_index]

    if.true
        swap
        # => [tracked_window_index, spent, window_index]

        dup dup.3 lt
        # => [is_earlier_window, tracked_window_index, spent, window_index]

        if.true
            # The tracker is from a past window, so this transaction opens a fresh one.
            drop drop
            # => [window_index]

            push.0
            # => [spent, effective_window_index]
        else
            # The tracker is at, or ahead of, the current window; keep accumulating into it.
            movup.2 drop
            # => [tracked_window_index, spent]

            swap
            # => [spent, effective_window_index]
        end
    else
        # The tracker predates the current configuration, so it carries no usable total.
        drop drop
        # => [window_index]

        push.0
        # => [spent, effective_window_index]
    end
end

#! Persists a budget's tracker.
#!
#! Inputs:  [BUDGET_KEY, total, window_index, config_generation]
#! Outputs: []
#!
#! Side effects:
#! - Writes SPENDING_TRACKERS_SLOT at the given key.
#!
#! Invocation: exec
proc store_window_spend(
    budget_key: StorageMapKey,
    total: AssetAmount,
    window_index: u32,
    config_generation: felt
)
    push.0 movdn.7
    # => [BUDGET_KEY, total, window_index, config_generation, 0]

    push.SPENDING_TRACKERS_SLOT[0..2]
    # => [slot_suffix, slot_prefix, BUDGET_KEY, total, window_index, config_generation, 0]

    exec.native_account::set_map_item
    # => [OLD_TRACKER]

    dropw
    # => []
end
