use {BlockNumber} from miden::protocol::types
use miden::protocol::native_account
use miden::protocol::tx
use miden::core::crypto::hashes::poseidon2
use {WORD_NUM_ELEMENTS} from miden::protocol_utils::constants

pub mod eip712
pub mod eip712_transaction_summary
pub mod guardian
pub mod multisig
pub mod multisig_smart
pub mod network_account
pub mod note_script_allowlist
pub mod signature
pub mod tx_policy
pub mod tx_script_allowlist

# CONSTANTS
# =================================================================================================

# hash_and_insert_tx_summary locals: the seven words of the summary preimage in hashing order.
const SUMMARY_PARAMS_HEAD_LOC = 0
const SUMMARY_PARAMS_TAIL_LOC = SUMMARY_PARAMS_HEAD_LOC + WORD_NUM_ELEMENTS
const SUMMARY_ACCOUNT_DELTA_LOC = SUMMARY_PARAMS_TAIL_LOC + WORD_NUM_ELEMENTS
const SUMMARY_INPUT_NOTES_LOC = SUMMARY_ACCOUNT_DELTA_LOC + WORD_NUM_ELEMENTS
const SUMMARY_OUTPUT_NOTES_LOC = SUMMARY_INPUT_NOTES_LOC + WORD_NUM_ELEMENTS
const SUMMARY_BLOCK_COMMITMENT_LOC = SUMMARY_OUTPUT_NOTES_LOC + WORD_NUM_ELEMENTS
const SUMMARY_LOGS_LOC = SUMMARY_BLOCK_COMMITMENT_LOC + WORD_NUM_ELEMENTS

# Number of felts in the transaction summary preimage (7 words).
const TX_SUMMARY_NUM_ELEMENTS = SUMMARY_LOGS_LOC + WORD_NUM_ELEMENTS

# Layout version of the transaction summary preimage.
const TX_SUMMARY_VERSION = 2

# Multiplier placing the expiration delta above the block number in the metadata felt, i.e. a shift
# by 32 bits.
const TX_SUMMARY_EXPIRATION_DELTA_MULTIPLIER = 0x100000000

#! Creates the transaction summary bound to the provided block and returns it in the order in which
#! it will be hashed.
#!
#! See `create_tx_summary` to bind the transaction's reference block, which is the common case.
#!
#! Inputs:  [block_number, user_param0, user_param1, user_param2, user_param3, user_param4,
#!           user_param5]
#! Outputs: [PARAMS_HEAD, PARAMS_TAIL, ACCOUNT_DELTA_COMMITMENT, INPUT_NOTES_COMMITMENT,
#!           OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT, LOGS_COMMITMENT]
#!
#! Where:
#! - block_number is the number of the block the summary binds. It must not exceed the transaction
#!   reference block number.
#! - user_param0 through user_param5 are arbitrary, user-defined inputs which are bound by the
#!   transaction summary. They are opaque: binding them enforces no meaning, so any semantics (e.g.
#!   replay protection or a maximum fee) must be implemented by the calling component.
#! - PARAMS_HEAD is the word [version, metadata, user_param0, user_param1].
#! - PARAMS_TAIL is the word [user_param2, user_param3, user_param4, user_param5].
#! - version is the layout version of the summary preimage.
#! - metadata packs block_number and the transaction's expiration block delta into a single felt.
#! - BLOCK_COMMITMENT is the commitment to the block identified by block_number.
#! - LOGS_COMMITMENT binds all transaction logs emitted before this summary is constructed.
#! - OUTPUT_NOTES_COMMITMENT is the commitment to the transaction's output notes.
#! - INPUT_NOTES_COMMITMENT is the commitment to the transaction's inputs notes.
#! - ACCOUNT_DELTA_COMMITMENT is the commitment to the transaction's account delta.
#!
#! Panics if:
#! - block_number is not a u32 or exceeds the transaction reference block number.
#!
#! Invocation: exec
pub proc create_tx_summary_with_block(block_number: BlockNumber, user_params: [felt; 6])
    -> (word, word, word, word, word, word, word)
    # the expiration delta is bounded to a u16 by the kernel and the block number to a u32 by
    # tx::get_block_commitment below, so the packed felt stays below 2^48
    exec.tx::get_expiration_block_delta mul.TX_SUMMARY_EXPIRATION_DELTA_MULTIPLIER
    # => [expiration_delta_bits, block_number, user_params(6)]

    dup.1 add
    # => [metadata, block_number, user_params(6)]

    # the six user params below already form the tail of PARAMS_HEAD and all of PARAMS_TAIL, so
    # putting the version and the metadata in front of them completes both words
    push.TX_SUMMARY_VERSION movup.2
    # => [block_number, PARAMS_HEAD, PARAMS_TAIL]

    exec.tx::get_logs_commitment movup.4
    # => [block_number, LOGS_COMMITMENT, PARAMS_HEAD, PARAMS_TAIL]

    exec.tx::get_block_commitment
    swapdw
    # => [PARAMS_HEAD, PARAMS_TAIL, BLOCK_COMMITMENT, LOGS_COMMITMENT]

    exec.tx::get_output_notes_commitment movdnw.2
    # => [PARAMS_HEAD, PARAMS_TAIL, OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT, LOGS_COMMITMENT]

    exec.tx::get_input_notes_commitment movdnw.2
    # => [PARAMS_HEAD, PARAMS_TAIL, INPUT_NOTES_COMMITMENT, OUTPUT_NOTES_COMMITMENT,
    #     BLOCK_COMMITMENT, LOGS_COMMITMENT]

    exec.native_account::compute_delta_commitment movdnw.2
    # => [PARAMS_HEAD, PARAMS_TAIL, ACCOUNT_DELTA_COMMITMENT, INPUT_NOTES_COMMITMENT,
    #     OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT, LOGS_COMMITMENT]
end

#! Creates the transaction summary bound to the transaction's reference block and returns it in the
#! order in which it will be hashed.
#!
#! This is the common case; see `create_tx_summary_with_block` for binding an earlier block instead.
#!
#! Inputs:  [user_param0, user_param1, user_param2, user_param3, user_param4, user_param5]
#! Outputs: [PARAMS_HEAD, PARAMS_TAIL, ACCOUNT_DELTA_COMMITMENT, INPUT_NOTES_COMMITMENT,
#!           OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT, LOGS_COMMITMENT]
#!
#! Where:
#! - all inputs and outputs are as described in `create_tx_summary_with_block`.
#!
#! Invocation: exec
pub proc create_tx_summary(user_params: [felt; 6])
    -> (word, word, word, word, word, word, word)
    exec.tx::get_reference_block_number
    # => [reference_block_number, user_params(6)]

    exec.create_tx_summary_with_block
    # => [PARAMS_HEAD, PARAMS_TAIL, ACCOUNT_DELTA_COMMITMENT, INPUT_NOTES_COMMITMENT,
    #     OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT, LOGS_COMMITMENT]
end

#! Creates and hashes the reference block summary, retaining its preimage in the advice map.
#!
#! Inputs:  [user_params(6)]
#! Outputs: [TX_SUMMARY_COMMITMENT]
#!
#! Invocation: exec
pub proc get_tx_summary_commitment(user_params: [felt; 6]) -> word
    exec.create_tx_summary
    # => [PARAMS_HEAD, PARAMS_TAIL, ACCOUNT_DELTA_COMMITMENT, INPUT_NOTES_COMMITMENT,
    #     OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT, LOGS_COMMITMENT]

    exec.hash_and_insert_tx_summary
    # => [TX_SUMMARY_COMMITMENT]
end

#! Creates and hashes a summary bound to `block_number`, retaining its preimage in the advice map.
#! The block must not exceed the transaction reference block.
#!
#! Inputs:  [block_number, user_params(6)]
#! Outputs: [TX_SUMMARY_COMMITMENT]
#!
#! Invocation: exec
pub proc get_tx_summary_commitment_with_block(block_number: BlockNumber, user_params: [felt; 6]) -> word
    exec.create_tx_summary_with_block
    # => [PARAMS_HEAD, PARAMS_TAIL, ACCOUNT_DELTA_COMMITMENT, INPUT_NOTES_COMMITMENT,
    #     OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT, LOGS_COMMITMENT]

    exec.hash_and_insert_tx_summary
    # => [TX_SUMMARY_COMMITMENT]
end

#! Hashes the provided transaction summary, inserts its preimage into the advice map keyed by the
#! resulting commitment, and returns the commitment.
#!
#! The preimage is saved to the advice map so that the host can extract the transaction summary
#! when handling authentication events.
#!
#! Inputs:
#!   Operand stack: [PARAMS_HEAD, PARAMS_TAIL, ACCOUNT_DELTA_COMMITMENT, INPUT_NOTES_COMMITMENT,
#!                   OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT, LOGS_COMMITMENT]
#! Outputs:
#!   Operand stack: [TX_SUMMARY_COMMITMENT]
#!   Advice map: {
#!     TX_SUMMARY_COMMITMENT: [PARAMS_HEAD, PARAMS_TAIL, ACCOUNT_DELTA_COMMITMENT,
#!                             INPUT_NOTES_COMMITMENT, OUTPUT_NOTES_COMMITMENT,
#!                             BLOCK_COMMITMENT, LOGS_COMMITMENT]
#!   }
#!
#! Where:
#! - PARAMS_HEAD is the word [version, metadata, user_param0, user_param1] and PARAMS_TAIL the word
#!   [user_param2, user_param3, user_param4, user_param5], together binding the summary metadata and
#!   the six user-defined parameters. See `create_tx_summary_with_block` for the metadata felt.
#! - BLOCK_COMMITMENT is the commitment to the block bound by the summary.
#! - LOGS_COMMITMENT binds all transaction logs emitted before this summary is constructed.
#! - OUTPUT_NOTES_COMMITMENT is the commitment to the transaction's output notes.
#! - INPUT_NOTES_COMMITMENT is the commitment to the transaction's inputs notes.
#! - ACCOUNT_DELTA_COMMITMENT is the commitment to the transaction's account delta.
#! - TX_SUMMARY_COMMITMENT is the commitment to the transaction summary.
#!
#! Locals (in hashing order):
#! - 0..4: PARAMS_HEAD
#! - 4..8: PARAMS_TAIL
#! - 8..12: ACCOUNT_DELTA_COMMITMENT
#! - 12..16: INPUT_NOTES_COMMITMENT
#! - 16..20: OUTPUT_NOTES_COMMITMENT
#! - 20..24: BLOCK_COMMITMENT
#! - 24..28: LOGS_COMMITMENT
#! - 28..32: padding for the final double word read by hash_elements
#!
#! Invocation: exec
@locals(32)
pub proc hash_and_insert_tx_summary(
    params_head: word,
    params_tail: word,
    account_delta_commitment: word,
    input_notes_commitment: word,
    output_notes_commitment: word,
    block_commitment: word,
    logs_commitment: word
) -> word
    # Save the seven words in hashing order, keeping the preimage for the advice map.
    loc_storew_le.SUMMARY_PARAMS_HEAD_LOC dropw
    # => [PARAMS_TAIL, ACCOUNT_DELTA_COMMITMENT, INPUT_NOTES_COMMITMENT, OUTPUT_NOTES_COMMITMENT,
    #     BLOCK_COMMITMENT, LOGS_COMMITMENT]

    loc_storew_le.SUMMARY_PARAMS_TAIL_LOC dropw
    # => [ACCOUNT_DELTA_COMMITMENT, INPUT_NOTES_COMMITMENT, OUTPUT_NOTES_COMMITMENT,
    #     BLOCK_COMMITMENT, LOGS_COMMITMENT]

    loc_storew_le.SUMMARY_ACCOUNT_DELTA_LOC dropw
    # => [INPUT_NOTES_COMMITMENT, OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT, LOGS_COMMITMENT]

    loc_storew_le.SUMMARY_INPUT_NOTES_LOC dropw
    # => [OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT, LOGS_COMMITMENT]

    loc_storew_le.SUMMARY_OUTPUT_NOTES_LOC dropw
    # => [BLOCK_COMMITMENT, LOGS_COMMITMENT]

    loc_storew_le.SUMMARY_BLOCK_COMMITMENT_LOC dropw
    # => [LOGS_COMMITMENT]

    loc_storew_le.SUMMARY_LOGS_LOC dropw
    # => []

    # The preimage has 28 elements. hash_elements sets capacity to 28 % 8 and pads the last
    # rate block, matching the Rust transaction summary commitment.
    push.TX_SUMMARY_NUM_ELEMENTS locaddr.SUMMARY_PARAMS_HEAD_LOC
    # => [start_ptr, num_elements]

    exec.poseidon2::hash_elements
    # => [TX_SUMMARY_COMMITMENT]

    # insert the preimage stored in the locals into the advice map keyed by the commitment
    locaddr.SUMMARY_PARAMS_HEAD_LOC dup add.TX_SUMMARY_NUM_ELEMENTS
    # => [end_ptr, start_ptr, TX_SUMMARY_COMMITMENT]

    movdn.5 movdn.4
    # => [TX_SUMMARY_COMMITMENT, start_ptr, end_ptr]

    adv.insert_mem
    # => [TX_SUMMARY_COMMITMENT, start_ptr, end_ptr]

    movup.4 drop movup.4 drop
    # => [TX_SUMMARY_COMMITMENT]
end
