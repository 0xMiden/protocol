use miden::core::crypto::hashes::poseidon2
use miden::core::math::u64
use miden::protocol::active_account
use miden::protocol::native_account
use miden::protocol::output_note
use miden::protocol::tx
use miden::standards::assets::fungible_asset
use miden::standards::notes::batch_fee

# CONSTANTS
# =================================================================================================

# Estimated upper bound on the number of cycles this module spends after the kernel's compute_fee
# call returns: the payment-info advice load, commitment check and u64 rate math, fee-asset
# construction, serial-number derivation, recipient computation, note creation and funding.
# Guarded by the fee-payment regression tests.
const PAY_FEE_CYCLES = 8192

# Estimated upper bounds on the number of kernel epilogue cycles spent after the auth procedure
# returns: output vault build, output notes commitment, account patch and final account
# commitments. The cost scales with the number of output notes (measured ~330 cycles per
# asset-less note; ~1k-2k base for note-less transactions), so the estimate is computed as
# BASE + PER_NOTE * (num_output_notes + 1), counting the fee note itself. Note that the per-note
# figure is measured on asset-less notes; notes carrying many assets cost more, so asset-heavy
# transactions may slightly under-estimate the fee (which fails closed: the batch builder may
# reject the underpaying note). Guarded by the fee-payment regression tests.
const POST_AUTH_EPILOGUE_BASE_CYCLES = 4096
const POST_AUTH_EPILOGUE_PER_NOTE_CYCLES = 512

# Exclusive upper bound of the high u32 limb of a converted fee amount. Bounding the high limb
# by 2^31 bounds the recombined amount by 2^63, so it can be recombined into a felt without
# field overflow before fungible_asset::create validates it against the maximum asset amount.
const MAX_CONVERTED_AMOUNT_HI_LIMB = 0x80000000

# Multiplier recombining the u64 limbs of the converted amount into a felt (2^32).
const U32_LIMB_MULTIPLIER = 0x0000000100000000

# load_payment_info locals: the payment info word loaded from the advice map.
const LOAD_PAYMENT_INFO_PAYMENT_INFO_LOC = 0

# ERRORS
# =================================================================================================

const ERR_FEE_PAYMENT_INFO_MISSING = "the advice map has no fee payment info entry for the auth args commitment"

const ERR_FEE_PAYMENT_INFO_COMMITMENT_MISMATCH = "payment info loaded from the advice map does not match the commitment provided via the auth args"

const ERR_FEE_CONVERSION_RATE_NOT_U32 = "fee conversion rate numerator and denominator must be u32 values"

const ERR_FEE_CONVERSION_RATE_DENOMINATOR_ZERO = "fee conversion rate denominator must be non-zero"

const ERR_FEE_CONVERSION_RATE_NUMERATOR_ZERO = "fee conversion rate numerator must be non-zero"

const ERR_FEE_CONVERTED_AMOUNT_OVERFLOW = "converted fee amount does not fit into a fungible asset amount"

# PROCEDURES
# =================================================================================================

#! Computes the transaction fee and pays it by creating and funding a public BATCH_FEE note.
#!
#! This procedure is intended to be invoked from an account's authentication procedure BEFORE the
#! transaction summary is created, so that the BATCH_FEE note and the vault withdrawal funding it
#! are covered by the signed summary.
#!
#! The fee amount is computed via the compute_fee kernel procedure. num_extra_cycles only needs to
#! cover the number of cycles the authentication procedure spends after this procedure returns
#! (e.g. transaction summary creation, hashing and signature verification, see
#! signature::estimate_authentication_cycles); this procedure adds its own tail cycles and the
#! post-authentication kernel epilogue cycles internally.
#!
#! The payment asset is specified via the auth args: the advice map must contain an entry
#! AUTH_ARGS => [SALT, PAYMENT_INFO], where AUTH_ARGS is the commitment
#! hash(PAYMENT_INFO || SALT). PAYMENT_INFO specifies the fungible faucet of the payment asset and
#! a conversion rate; the paid amount is ceil(fee_amount * rate_num / rate_den) of that asset. To
#! pay in the native fee asset, commit to the native fee faucet at rate 1/1. The SALT preimage
#! slot keeps AUTH_ARGS usable as a unique salt for replay protection while committing to the
#! payment info.
#!
#! If the computed fee is zero (e.g. the reference block's verification base fee is zero), no note
#! is created, no payment info is required and the account vault is left untouched.
#!
#! The BATCH_FEE note's serial number is derived as [ref_block_num, initial_nonce,
#! account_id_suffix, account_id_prefix] (from the top of the stack), making it deterministic and
#! client-precomputable.
#!
#! Inputs:  [num_extra_cycles, AUTH_ARGS]
#! Outputs: []
#!
#! Where:
#! - num_extra_cycles is the estimated number of cycles the caller spends after this call until
#!   the end of the authentication procedure.
#! - AUTH_ARGS are the authentication procedure's arguments, interpreted as the commitment to the
#!   fee payment info.
#!
#! Panics if:
#! - num_extra_cycles (plus internal margins) is not a u32 or the total cycle count exceeds the
#!   maximum cycle count.
#! - the advice map has no payment info entry for the auth args commitment.
#! - the payment info loaded from the advice map does not match the AUTH_ARGS commitment.
#! - the conversion rate is malformed or the converted amount overflows.
#! - the account vault holds less of the payment asset than the amount to be paid.
#! - the maximum number of output notes is exceeded.
#!
#! Invocation: exec
pub proc pay_fee
    # account for this procedure's own tail and the post-auth kernel epilogue base cost
    add.PAY_FEE_CYCLES add.POST_AUTH_EPILOGUE_BASE_CYCLES
    # => [num_partial_extra_cycles, AUTH_ARGS]

    # the epilogue cost scales with the number of output notes; all output notes except the fee
    # note itself exist at this point, so scale the estimate by their count plus one
    exec.tx::get_num_output_notes add.1 mul.POST_AUTH_EPILOGUE_PER_NOTE_CYCLES add
    # => [num_estimated_extra_cycles, AUTH_ARGS]

    # no output notes are excluded from the fee computation
    padw movup.4
    # => [num_estimated_extra_cycles, EXCLUDE_NOTES_COMMITMENT, AUTH_ARGS]

    exec.tx::compute_fee
    # => [fee_amount, AUTH_ARGS]

    dup eq.0
    if.true
        # a zero fee requires no fee note
        drop dropw
        # => []
    else
        movdn.4
        # => [AUTH_ARGS, fee_amount]

        # a non-zero fee requires payment info committed to by the auth args
        adv.has_mapkey adv_push
        assert.err=ERR_FEE_PAYMENT_INFO_MISSING
        # => [AUTH_ARGS, fee_amount]

        exec.load_payment_info
        # => [faucet_id_suffix, faucet_id_prefix, payment_amount]

        exec.fungible_asset::create
        # => [ASSET_ID, ASSET_VALUE]

        exec.create_and_fund_fee_note
        # => []
    end
end

# HELPER PROCEDURES
# =================================================================================================

#! Loads and verifies the fee payment info committed to by the auth args and converts the fee
#! amount into the payment asset's amount.
#!
#! The payment info word is laid out as [faucet_id_prefix, faucet_id_suffix, rate_num, rate_den]
#! (in memory order) and the payment amount is ceil(fee_amount * rate_num / rate_den).
#!
#! Inputs:
#!   Operand stack: [AUTH_ARGS, fee_amount]
#!   Advice map: { AUTH_ARGS: [SALT, PAYMENT_INFO] }
#! Outputs:
#!   Operand stack: [faucet_id_suffix, faucet_id_prefix, payment_amount]
#!
#! Where:
#! - AUTH_ARGS is the commitment hash(PAYMENT_INFO || SALT) to the payment info.
#! - SALT is an arbitrary word (e.g. used for replay protection by the caller).
#! - PAYMENT_INFO specifies the fungible faucet of the payment asset and the conversion rate.
#! - fee_amount is the transaction fee denominated in the native fee asset.
#! - payment_amount is the fee amount converted into the payment asset.
#!
#! Panics if:
#! - the loaded payment info does not match the AUTH_ARGS commitment.
#! - rate_num or rate_den is not a u32, or either of them is zero.
#! - the converted amount overflows a fungible asset amount.
#!
#! Invocation: exec
@locals(4)
proc load_payment_info
    adv.push_mapval
    # OS => [AUTH_ARGS, fee_amount]
    # AS => [SALT, PAYMENT_INFO]

    padw adv_loadw
    # => [SALT, AUTH_ARGS, fee_amount]

    padw adv_loadw
    # => [PAYMENT_INFO, SALT, AUTH_ARGS, fee_amount]

    # keep the payment info around for after the commitment check
    loc_storew_le.LOAD_PAYMENT_INFO_PAYMENT_INFO_LOC
    # => [PAYMENT_INFO, SALT, AUTH_ARGS, fee_amount]

    exec.poseidon2::merge
    # => [COMMITMENT, AUTH_ARGS, fee_amount]

    assert_eqw.err=ERR_FEE_PAYMENT_INFO_COMMITMENT_MISMATCH
    # => [fee_amount]

    padw loc_loadw_le.LOAD_PAYMENT_INFO_PAYMENT_INFO_LOC
    # => [faucet_id_prefix, faucet_id_suffix, rate_num, rate_den, fee_amount]

    movup.2 movup.3
    # => [rate_den, rate_num, faucet_id_prefix, faucet_id_suffix, fee_amount]

    # validate the conversion rate
    u32assert2.err=ERR_FEE_CONVERSION_RATE_NOT_U32
    dup neq.0 assert.err=ERR_FEE_CONVERSION_RATE_DENOMINATOR_ZERO
    swap
    # => [rate_num, rate_den, faucet_id_prefix, faucet_id_suffix, fee_amount]

    dup neq.0 assert.err=ERR_FEE_CONVERSION_RATE_NUMERATOR_ZERO
    # => [rate_num, rate_den, faucet_id_prefix, faucet_id_suffix, fee_amount]

    # compute fee_amount * rate_num as a u64 product
    movup.4 u32split
    # => [fee_lo, fee_hi, rate_num, rate_den, faucet_id_prefix, faucet_id_suffix]

    movup.2 push.0 swap
    # => [rate_num, 0, fee_lo, fee_hi, rate_den, faucet_id_prefix, faucet_id_suffix]

    exec.u64::overflowing_mul
    # => [overflow, prod_lo, prod_hi, rate_den, faucet_id_prefix, faucet_id_suffix]

    assertz.err=ERR_FEE_CONVERTED_AMOUNT_OVERFLOW
    # => [prod_lo, prod_hi, rate_den, faucet_id_prefix, faucet_id_suffix]

    # divide by rate_den, rounding up
    movup.2 push.0 swap
    # => [rate_den, 0, prod_lo, prod_hi, faucet_id_prefix, faucet_id_suffix]

    exec.u64::divmod
    # => [rem_lo, rem_hi, quot_lo, quot_hi, faucet_id_prefix, faucet_id_suffix]

    u32or neq.0
    # => [round_up, quot_lo, quot_hi, faucet_id_prefix, faucet_id_suffix]

    push.0 swap
    # => [round_up, 0, quot_lo, quot_hi, faucet_id_prefix, faucet_id_suffix]

    exec.u64::overflowing_add
    # => [overflow, amount_lo, amount_hi, faucet_id_prefix, faucet_id_suffix]

    assertz.err=ERR_FEE_CONVERTED_AMOUNT_OVERFLOW
    # => [amount_lo, amount_hi, faucet_id_prefix, faucet_id_suffix]

    # bound the high limb so the recombined amount stays below 2^63
    dup.1 push.MAX_CONVERTED_AMOUNT_HI_LIMB u32lt
    assert.err=ERR_FEE_CONVERTED_AMOUNT_OVERFLOW
    # => [amount_lo, amount_hi, faucet_id_prefix, faucet_id_suffix]

    # recombine the limbs into a felt amount
    swap mul.U32_LIMB_MULTIPLIER add
    # => [payment_amount, faucet_id_prefix, faucet_id_suffix]

    movdn.2 swap
    # => [faucet_id_suffix, faucet_id_prefix, payment_amount]
end

#! Creates a new BATCH_FEE output note and funds it with the provided asset from the native
#! account's vault.
#!
#! The note's serial number is derived from the native account ID, the account's initial nonce
#! and the reference block number, making it deterministic and client-precomputable.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE]
#! Outputs: []
#!
#! Where:
#! - ASSET_ID is the asset ID of the fee payment asset.
#! - ASSET_VALUE is the value of the fee payment asset.
#!
#! Panics if:
#! - the account vault holds less of the payment asset than the amount to be paid.
#! - the maximum number of output notes is exceeded.
#!
#! Invocation: exec
proc create_and_fund_fee_note
    # derive the note's serial number
    exec.native_account::get_id
    # => [account_id_suffix, account_id_prefix, ASSET_ID, ASSET_VALUE]

    exec.active_account::get_nonce
    # => [initial_nonce, account_id_suffix, account_id_prefix, ASSET_ID, ASSET_VALUE]

    exec.tx::get_block_number
    # => [ref_block_num, initial_nonce, account_id_suffix, account_id_prefix, ASSET_ID, ASSET_VALUE]

    # the top four elements form the note's serial number
    # => [SERIAL_NUM, ASSET_ID, ASSET_VALUE]

    exec.batch_fee::prepare_note
    # => [tag, note_type, RECIPIENT, ASSET_ID, ASSET_VALUE]

    exec.output_note::create
    # => [note_idx, ASSET_ID, ASSET_VALUE]

    movdn.8
    # => [ASSET_ID, ASSET_VALUE, note_idx]

    # move the fee asset from the vault into the note
    # (see basic_wallet::move_asset_to_note for the same sequence in call form)
    dupw.1 dupw.1
    # => [ASSET_ID, ASSET_VALUE, ASSET_ID, ASSET_VALUE, note_idx]

    exec.native_account::remove_asset dropw
    # => [ASSET_ID, ASSET_VALUE, note_idx]

    exec.output_note::add_asset
    # => []
end
