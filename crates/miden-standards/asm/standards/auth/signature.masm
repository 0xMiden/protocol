use miden::core::crypto::dsa::falcon512_poseidon2
use miden::core::crypto::hashes::poseidon2
use miden::core::crypto::dsa::ecdsa_k256_keccak
use {AUTH_REQUEST_EVENT} from miden::protocol::auth
use miden::protocol::native_account
use miden::standards::auth

# CONSTANTS
# =================================================================================================

# Auth Scheme ID Structure
const ECDSA_K256_KECCAK_SCHEME_ID=1
const FALCON_512_POSEIDON2_SCHEME_ID=2

# Estimated upper bounds on the number of cycles authenticate_transaction takes per signature
# scheme, for use as the num_extra_cycles input of fee::pay_fee. Measured values (see
# bin/bench-transaction/bench-tx.json): ECDSA ~3.7k-4.1k, Falcon ~71.6k-72k. Overestimation is
# cheap: the fee grows with ilog2 of the cycle count, so a <2x overshoot costs at most one
# verification_base_fee unit. Guarded by the fee-payment regression tests.
const ECDSA_K256_KECCAK_AUTH_CYCLES = 8000
const FALCON_512_POSEIDON2_AUTH_CYCLES = 80000

# Estimated upper bound on the number of cycles a multisig authentication flow spends outside of
# per-signature verification: transaction summary creation and hashing, threshold config reads,
# the per-procedure threshold/policy scans and replay-protection recording. The per-procedure
# scans grow with the account's procedure count (bounded by the kernel's maximum), so accounts
# with very many procedures may slightly under-estimate the fee; that fails closed (the batch
# builder may reject the underpaying note) and is largely absorbed by the ilog2-domain fee
# formula. Guarded by the fee-payment regression tests.
const MULTISIG_AUTH_BASE_CYCLES = 8192

# Local Memory Addresses for multisig operations
const APPROVER_PUB_KEY_SLOT_ID_SUFFIX_LOC=0
const APPROVER_PUB_KEY_SLOT_ID_PREFIX_LOC=1
const APPROVER_SCHEME_ID_SLOT_ID_SUFFIX_LOC=2
const APPROVER_SCHEME_ID_SLOT_ID_PREFIX_LOC=3
const SUCCESSFUL_VERIFICATIONS_LOC=4

# ERRORS
# =================================================================================================
const ERR_INVALID_SCHEME_ID = "invalid signature scheme id: expected 2 for falcon512_poseidon2, 1 for ecdsa_k256_keccak"
const ERR_INVALID_SCHEME_ID_WORD = "invalid scheme ID word format expected three zero values followed by the scheme ID"

#! Authenticate a transaction using the signature scheme specified by scheme_id.
#!
#! Supported schemes:
#! - 1 => ecdsa_k256_keccak
#! - 2 => falcon512_poseidon2
#!
#! It first increments the nonce of the account, independent of whether the account's state has
#! changed or not. Then it computes and signs the following message (in memory order):
#! [[metadata, final_nonce, 0, 0], [0, 0, 0, 0], ACCOUNT_DELTA_COMMITMENT,
#!  INPUT_NOTES_COMMITMENT, OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT]
#!
#! Including the final_nonce is necessary for replay protection. The block commitment is included to
#! commit to the transaction creator's intended reference block of the transaction which determines
#! the fee parameters and therefore the fee amount that is deducted. The metadata felt is included to
#! commit to the summary layout version, the bound block number and the transaction's expiration
#! delta; see `auth::create_tx_summary`.
#!
#! Inputs:  [PK_COMM, scheme_id]
#! Outputs: []
#!
#! Invocation: exec
pub proc authenticate_transaction
    # Increment the account's nonce.
    # ---------------------------------------------------------------------------------------------
    # This has to happen before computing the delta commitment, otherwise that procedure will abort
    exec.native_account::incr_nonce
    # => [final_nonce, PK_COMM, scheme_id]

    # Pass the final nonce as the first user param and zero the remaining ones.
    push.0.0.0.0.0.0 movup.6
    # => [user_params(7), PK_COMM, scheme_id]

    # Compute the message that is signed. The summary preimage is inserted into the advice map
    # for extraction by the host.
    # ---------------------------------------------------------------------------------------------
    exec.auth::create_tx_summary_with_ref_block
    # => [PARAMS_HEAD, PARAMS_TAIL, ACCOUNT_DELTA_COMMITMENT, INPUT_NOTES_COMMITMENT, OUTPUT_NOTES_COMMITMENT, BLOCK_COMMITMENT, PK_COMM, scheme_id]

    exec.auth::hash_and_insert_tx_summary
    # OS => [MESSAGE, PK_COMM, scheme_id]
    # AS => []

    # Fetch signature from advice provider and verify.
    # ---------------------------------------------------------------------------------------------
    # Emit the authentication request event that pushes a signature for the message to the advice stack
    emit.AUTH_REQUEST_EVENT
    swapw
    # OS => [PK_COMM, MESSAGE, scheme_id]
    # AS => [SIGNATURE]

    movup.8
    # OS => [scheme_id, PK_COMM, MESSAGE]
    # AS => [SIGNATURE]

    # Verify the signature against the public key and the message. The procedure gets as inputs the
    # hash of the public key and the message via the operand stack. The signature is provided via
    # the advice stack. The signature is valid if and only if the procedure returns.
    exec.verify_signature_by_scheme
    # OS => []
    # AS => []
end

# Verify signature using scheme_id:
#   1 => ECDSA (ecdsa_k256_keccak)
#   2 => Falcon (falcon512_poseidon2)
#
# Inputs:  [scheme_id, PK_COMM, MSG]
# Outputs: []
proc verify_signature_by_scheme
    dup eq.ECDSA_K256_KECCAK_SCHEME_ID
    # => [is_one, scheme_id, PK_COMM, MESSAGE]

    if.true
        drop
        # OS => [PK_COMM, MESSAGE]

        exec.ecdsa_k256_keccak::verify
        # OS => []
        # AS => []
    else
        eq.FALCON_512_POSEIDON2_SCHEME_ID
        # => [is_2, PK_COMM, MESSAGE]

        if.true
            # OS => [PK_COMM, MESSAGE]

            exec.falcon512_poseidon2::verify
            # OS => []
            # AS => []
        else
            # ------ Invalid Scheme ID ------
            push.0 assert.err=ERR_INVALID_SCHEME_ID
        end
    end
end

#! Returns a conservative upper bound on the number of cycles authenticate_transaction takes for
#! the given signature scheme.
#!
#! Intended to be passed as the num_extra_cycles input of fee::pay_fee when fee payment happens
#! right before authenticate_transaction. Unknown scheme ids return the largest bound; the
#! authentication itself aborts on them later.
#!
#! Inputs:  [scheme_id]
#! Outputs: [num_cycles]
#!
#! Where:
#! - scheme_id is the signature scheme id (1 for ecdsa_k256_keccak, 2 for falcon512_poseidon2).
#! - num_cycles is the estimated upper bound on authenticate_transaction's cycle count.
#!
#! Invocation: exec
pub proc estimate_authentication_cycles
    eq.ECDSA_K256_KECCAK_SCHEME_ID
    # => [is_ecdsa]

    push.FALCON_512_POSEIDON2_AUTH_CYCLES push.ECDSA_K256_KECCAK_AUTH_CYCLES
    # => [ecdsa_cycles, falcon_cycles, is_ecdsa]

    movup.2 cdrop
    # => [num_cycles]
end

#! Returns a conservative upper bound on the number of cycles a multisig authentication flow
#! takes when up to num_of_signers signatures are verified.
#!
#! Intended to be passed as the num_extra_cycles input of fee::pay_fee when fee payment happens
#! right before the multisig authentication flow (summary creation, signature verification and
#! replay-protection recording). Signature verification runs at most once per signer and every
#! supported scheme's verification cost is bounded by the Falcon estimate (the most expensive
#! scheme), so the bound is num_of_signers * FALCON_512_POSEIDON2_AUTH_CYCLES plus a base margin
#! covering the rest of the flow.
#!
#! Approvers within one account may use different schemes (hybrid multisig): each approver's
#! scheme id lives in a per-signer storage map that verify_signatures reads inside its loop, so
#! there is no single per-account scheme to parameterize the estimate with (unlike
#! estimate_authentication_cycles for singlesig). Summing per-signer estimates upfront would
#! duplicate those map reads at a cost that itself grows with the approver count, so the bound
#! conservatively assumes the most expensive scheme for every signer instead. This is a
#! per-signer worst case: a multisig with many approvers but a low threshold, or one using the
#! cheaper ECDSA scheme, only verifies a few (cheaper) signatures, so the estimate can overshoot
#! the real cost by roughly the approver-to-verified ratio. Overestimation only ever raises the
#! fee, and because the fee grows with ilog2 of the cycle count each doubling of the overshoot
#! costs at most one extra verification_base_fee unit, so even a 10x overshoot costs only a few
#! fee units.
#!
#! Inputs:  [num_of_signers]
#! Outputs: [num_cycles]
#!
#! Where:
#! - num_of_signers is the maximum number of signature verifications the authentication flow can
#!   perform (e.g. the number of approvers).
#! - num_cycles is the estimated upper bound on the authentication flow's cycle count.
#!
#! Invocation: exec
pub proc estimate_multisig_authentication_cycles
    mul.FALCON_512_POSEIDON2_AUTH_CYCLES add.MULTISIG_AUTH_BASE_CYCLES
    # => [num_cycles]
end

#! Returns 1 if scheme_id is supported, else 0.
#! Inputs:  [scheme_id]
#! Outputs: [is_supported]
#!
#! Invocation: exec
pub proc is_supported_scheme
    dup eq.ECDSA_K256_KECCAK_SCHEME_ID
    # => [is_1, scheme_id]

    swap eq.FALCON_512_POSEIDON2_SCHEME_ID
    # => [is_2, is_1]

    or
    # => [is_supported]
end

#! Reverts if scheme_id is not supported.
#! Inputs:  [scheme_id]
#! Outputs: []
#!
#! Invocation: exec
pub proc assert_supported_scheme
    exec.is_supported_scheme
    # => [is_supported]

    assert.err=ERR_INVALID_SCHEME_ID
    # => []
end


#! Validates scheme id word shape: [scheme_id, 0, 0, 0]
#! Inputs:  [SCHEME_ID_WORD]
#! Outputs: [SCHEME_ID_WORD]
#!
#! Invocation: exec
pub proc assert_supported_scheme_word
    dupw exec.assert_supported_scheme
    # => [0, 0, 0, SCHEME_ID_WORD]

    assertz.err=ERR_INVALID_SCHEME_ID_WORD
    assertz.err=ERR_INVALID_SCHEME_ID_WORD
    assertz.err=ERR_INVALID_SCHEME_ID_WORD
    # => [SCHEME_ID_WORD]
end


#! Verify signatures for all required signers in a loop.
#!
#! This procedure iterates through the required number of signers, fetches their public keys from
#! the provided account storage map slot, verifies their signatures against the transaction message,
#! and returns the number of successfully verified signatures.
#!
#! Note: Calls `native_account::get_initial_map_item` to access the transaction's initial storage
#! state rather than the current state. This is crucial when validating transactions that update
#! the owner public key mapping - the previous signers must authorize the change to the new signers,
#! not the new signers authorizing themselves.
#!
#! Inputs:  [approver_scheme_id_slot_id_suffix, approver_scheme_id_slot_id_prefix,
#!           approver_pub_key_slot_id_suffix, approver_pub_key_slot_id_prefix,
#!           num_of_approvers, MSG]
#! Outputs: [num_verified_signatures, MSG]
#!
#! Invocation: exec
@locals(5)
pub proc verify_signatures
    loc_store.APPROVER_SCHEME_ID_SLOT_ID_SUFFIX_LOC
    loc_store.APPROVER_SCHEME_ID_SLOT_ID_PREFIX_LOC
    # => [approver_pub_key_slot_id_suffix, approver_pub_key_slot_id_prefix, num_of_approvers, MSG]

    loc_store.APPROVER_PUB_KEY_SLOT_ID_SUFFIX_LOC
    loc_store.APPROVER_PUB_KEY_SLOT_ID_PREFIX_LOC
    # => [num_of_approvers, MSG]

    # Initializing SUCCESSFUL_VERIFICATIONS local memory address to 0
    push.0 loc_store.SUCCESSFUL_VERIFICATIONS_LOC
    # => [num_of_approvers, MSG]

    # Counter `i` starts at `num_of_approvers` and counts down to 0
    # => [i, MSG]

    # Loop through required signers and verify signatures.
    # ---------------------------------------------------------------------------------------------

    dup neq.0
    while.true
        # => [i, MSG]

        # Fetch public key from storage map.
        # -----------------------------------------------------------------------------------------

        sub.1 dup
        # => [signer_idx, signer_idx, MSG]

        exec.create_approver_map_key
        # => [APPROVER_MAP_KEY, signer_idx, MSG]

        # Get public key from initial storage state
        loc_load.APPROVER_PUB_KEY_SLOT_ID_PREFIX_LOC
        loc_load.APPROVER_PUB_KEY_SLOT_ID_SUFFIX_LOC
        exec.native_account::get_initial_map_item
        # => [PK_COMM, signer_idx, MSG]

        # Check if signature exists for this signer.
        # -----------------------------------------------------------------------------------------

        movup.4 movdn.8
        # => [PK_COMM, MSG, signer_idx]

        dupw.1 dupw.1
        # => [PK_COMM, MSG, PK_COMM, MSG, signer_idx]

        exec.poseidon2::merge
        # => [SIG_KEY, PK_COMM, MSG, signer_idx]

        adv.has_mapkey
        # => [SIG_KEY, PK_COMM, MSG, signer_idx]

        dropw
        # => [PK_COMM, MSG, signer_idx]

        adv_push
        # => [has_signature, PK_COMM, MSG, signer_idx]

        # if a signature for this signer exists in the advice map, verify it
        if.true
            # => [PK_COMM, MSG, signer_idx]

            dupw.1
            # => [MSG, PK_COMM, MSG, signer_idx]

            # Verify the signature against the public key and message.
            # -----------------------------------------------------------------------------------------

            # Emit the authentication request event that pushes a signature for the message to the advice stack.
            emit.AUTH_REQUEST_EVENT
            # => [MSG, PK_COMM, MSG, signer_idx]

            swapw
            # => [PK_COMM, MSG, MSG, signer_idx]

            dup.12 exec.create_approver_map_key
            # => [APPROVER_MAP_KEY, PK_COMM, MSG, MSG, signer_idx]

            loc_load.APPROVER_SCHEME_ID_SLOT_ID_PREFIX_LOC loc_load.APPROVER_SCHEME_ID_SLOT_ID_SUFFIX_LOC
            # => [scheme_slot_id_suffix, scheme_slot_id_prefix, APPROVER_MAP_KEY, PK_COMM, MSG, MSG, signer_idx]

            # Get scheme_id for the signer index from initial storage state.
            exec.native_account::get_initial_map_item
            # => [[scheme_id, 0, 0, 0], PK_COMM, MSG, MSG, signer_idx]

            movdn.3 drop drop drop
            # OS => [scheme_id, PK_COMM, MSG, MSG, signer_idx]
            # AS => [SIGNATURE]

            exec.verify_signature_by_scheme
            # => [MSG, signer_idx]

            loc_load.SUCCESSFUL_VERIFICATIONS_LOC
            add.1
            loc_store.SUCCESSFUL_VERIFICATIONS_LOC
            # => [MSG, signer_idx]
        else
            dropw
            # => [MSG, signer_idx]
        end
        # => [MSG, signer_idx]

        movup.4
        # => [signer_idx, MSG]

        dup neq.0
        # => [should_continue, signer_idx, MSG]
    end
    # => [signer_idx, MSG]

    # Return successful signature verifications along with MSG
    # -----------------------------------------------------------------------------------------

    drop
    # => [MSG]

    loc_load.SUCCESSFUL_VERIFICATIONS_LOC
    # => [num_verified_signatures, MSG]
end

#! Builds the storage map key for a signer index.
#!
#! Inputs: [key_index]
#! Outputs: [APPROVER_MAP_KEY]
#!
#! Invocation: exec
pub proc create_approver_map_key
    push.0.0.0 movup.3
    # => [APPROVER_MAP_KEY]
end
