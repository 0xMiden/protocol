use miden::core::crypto::hashes::eidos
use miden::core::math::u64
use miden::core::math::u128
use miden::core::word
use miden::protocol::asset
use miden::protocol::native_account
use miden::protocol::output_note
use miden::protocol::tx
use {Asset, AssetAmount, BlockNumber} from miden::protocol::types
use {FUNGIBLE_ASSET_MAX_AMOUNT} from miden::protocol::asset
use miden::standards::assets::fungible_asset
use miden::standards::fees
use miden::standards::notes::tx_fee

# TYPE ALIASES
# =================================================================================================

#! A fee conversion rate, applied to an amount as ceil(amount * num / den). The numerator and
#! denominator are arbitrary non-zero field elements.
pub type ConversionRate = struct { num: felt, den: felt }

#! Fee conversion info: the fungible faucet of the payment asset and the conversion rate from the
#! native fee asset, laid out as [faucet_id_suffix, faucet_id_prefix, rate_num, rate_den].
#! The empty word indicates that no conversion info was committed.
pub type ConversionInfo = word

# CONSTANTS
# =================================================================================================

# Estimated upper bound on the number of cycles a pay_fee flow spends after the kernel's
# compute_fee call returns: rate conversion, fee-asset construction, serial-number derivation,
# recipient computation, note creation and funding. Guarded by the fee-payment regression tests.
const PAY_FEE_CYCLES = 8192

# Estimated upper bounds on the number of kernel epilogue cycles spent after the auth procedure
# returns: output vault build, output notes commitment, account patch and final account
# commitments. The cost scales with the number of output notes (measured ~330 cycles per
# asset-less note; ~1k-2k base for note-less transactions), so the estimate is computed as
# BASE + PER_NOTE * (num_output_notes + 1), counting the fee note itself. Note that the per-note
# figure is measured on asset-less notes; notes carrying many assets cost more, so asset-heavy
# transactions may slightly under-estimate the fee (which fails closed: the batch builder may
# reject the underpaying note). Guarded by the fee-payment regression tests.
const POST_AUTH_EPILOGUE_BASE_CYCLES = 4096
const POST_AUTH_EPILOGUE_PER_NOTE_CYCLES = 512

# Estimated upper bound on the number of cycles a pay_fee flow spends per sponsorship note it
# creates (serial number derivation, note creation, vault withdrawal and funding) plus that note's
# share of the epilogue, charged by estimate_fee for the notes a later pay_fee flow would create.
# The pricing of the network notes, which pay_fee repeats, is not part of it: estimate_fee
# measures its own pricing and charges that instead.
const SPONSORSHIP_NOTE_CYCLES = 4096

# Exclusive upper bound of the high u32 limb of a converted fee amount. Bounding the high limb
# by 2^31 bounds the recombined amount by 2^63, so it can be recombined into a felt without
# field overflow before fungible_asset::create validates it against the maximum asset amount.
const MAX_CONVERTED_AMOUNT_HI_LIMB = 0x80000000

# Multiplier recombining the u64 limbs of the converted amount into a felt (2^32).
const U32_LIMB_MULTIPLIER = 0x0000000100000000

# Domain-separation tag for the fee note's serial number ("fee" in hex): the serial number is
# derived as hash(FEE_DOMAIN || [serial_number_block, initial_nonce, account_id_suffix,
# account_id_prefix]) with FEE_DOMAIN = [FEE_DOMAIN_TAG, 0, 0, 0], so a fee note's serial number
# cannot collide with serial numbers derived from similar tuples in other contexts.
const FEE_DOMAIN_TAG = 0xFEE

# ERRORS
# =================================================================================================

const ERR_FEE_CONVERSION_INFO_COMMITMENT_MISMATCH = "conversion info loaded from the advice map does not match the commitment provided via the auth args"

const ERR_FEE_CONVERSION_INFO_MISSING = "paying a non-zero fee requires conversion info committed via the auth args"

const ERR_FEE_CONVERSION_INFO_NOT_NATIVE = "the transaction fee must be paid in the native fee asset at rate 1/1"

const ERR_FEE_CONVERSION_RATE_DENOMINATOR_ZERO = "fee conversion rate denominator must be non-zero"

const ERR_FEE_CONVERSION_RATE_NUMERATOR_ZERO = "fee conversion rate numerator must be non-zero"

const ERR_FEE_CONVERTED_AMOUNT_OVERFLOW = "converted fee amount does not fit into a fungible asset amount"

const ERR_FEE_EXCEEDS_MAX_FEE = "the transaction fee and the sponsored fees exceed the max fee"

# PROCEDURES
# =================================================================================================

#! Loads and verifies the fee conversion info committed to by the auth args.
#!
#! If the advice map contains an entry for the auth args, the entry must be the preimage
#! [SALT, CONVERSION_INFO] of the commitment AUTH_ARGS = hash(CONVERSION_INFO || SALT); the
#! verified conversion info is returned. If no entry exists, the empty word is returned to
#! indicate that no conversion info was committed.
#!
#! For now this procedure only decodes the auth args; in the future it could also make an FPI
#! call to an oracle to obtain the conversion rate.
#!
#! Inputs:
#!   Operand stack: [AUTH_ARGS]
#!   Advice map: { AUTH_ARGS: [SALT, CONVERSION_INFO] }
#! Outputs:
#!   Operand stack: [CONVERSION_INFO]
#!
#! Where:
#! - AUTH_ARGS is the commitment hash(CONVERSION_INFO || SALT) to the conversion info.
#! - SALT is an arbitrary word (e.g. used for replay protection by the caller).
#! - CONVERSION_INFO is [faucet_id_suffix, faucet_id_prefix, rate_num, rate_den], or the empty
#!   word if no conversion info was committed.
#!
#! Panics if:
#! - the loaded conversion info does not match the AUTH_ARGS commitment.
#!
#! Invocation: exec
pub proc load_conversion_info(auth_args: word) -> ConversionInfo
    # empty auth args carry no commitment; return the empty word
    exec.word::testz not
    # => [has_commitment, AUTH_ARGS]

    if.true
        # check whether conversion info was provided for the auth args commitment
        adv.has_mapkey adv_push
        # => [has_conversion_info, AUTH_ARGS]

        if.true
            adv.push_mapval
            # OS => [AUTH_ARGS]
            # AS => [SALT, CONVERSION_INFO]

            padw adv_loadw
            # => [SALT, AUTH_ARGS]

            padw adv_loadw
            # => [CONVERSION_INFO, SALT, AUTH_ARGS]

            # keep a copy of the conversion info around for after the commitment check
            dupw movdnw.3
            # => [CONVERSION_INFO, SALT, AUTH_ARGS, CONVERSION_INFO]

            exec.eidos::hash_double_word
            # => [COMMITMENT, AUTH_ARGS, CONVERSION_INFO]

            assert_eqw.err=ERR_FEE_CONVERSION_INFO_COMMITMENT_MISMATCH
            # => [CONVERSION_INFO]
        else
            # no conversion info was committed; return the empty word
            dropw padw
            # => [EMPTY_WORD]
        end
    end
end

#! Returns conversion info paying the fee in the native fee asset at rate 1/1.
#!
#! The fee asset is read from the transaction's reference block.
#!
#! Inputs:  []
#! Outputs: [CONVERSION_INFO]
#!
#! Where:
#! - CONVERSION_INFO is [fee_faucet_id_suffix, fee_faucet_id_prefix, 1, 1].
#!
#! Invocation: exec
pub proc native_conversion_info() -> ConversionInfo
    push.1.1
    # => [rate_num, rate_den]

    exec.tx::get_fee_asset_id
    # => [FEE_ASSET_ID, rate_num, rate_den]

    exec.asset::id_into_faucet_id
    # => [CONVERSION_INFO]
end

#! Converts an amount at the given conversion rate, rounding up.
#!
#! The converted amount is ceil(amount * rate_num / rate_den). The intermediate product is
#! computed with 128-bit precision, so it may exceed a u64 (e.g. for rates scaling between
#! decimal conventions, like 10^12 for an 18-decimals vs 6-decimals asset pair) as long as the
#! final converted amount fits into a fungible asset amount.
#!
#! Inputs:  [amount, rate_num, rate_den]
#! Outputs: [converted_amount]
#!
#! Where:
#! - amount is the amount to convert.
#! - rate_num and rate_den are the numerator and denominator of the conversion rate, as
#!   arbitrary non-zero field elements.
#! - converted_amount is the converted amount.
#!
#! Panics if:
#! - rate_num or rate_den is zero.
#! - the converted amount overflows a fungible asset amount.
#!
#! Invocation: exec
pub proc convert_amount(amount: felt, rate: ConversionRate) -> felt
    # validate the conversion rate
    movdn.2
    # => [rate_num, rate_den, amount]

    dup neq.0 assert.err=ERR_FEE_CONVERSION_RATE_NUMERATOR_ZERO
    dup.1 neq.0 assert.err=ERR_FEE_CONVERSION_RATE_DENOMINATOR_ZERO
    # => [rate_num, rate_den, amount]

    # compute amount * rate_num as a 128-bit product
    movup.2 u32split
    # => [amount_lo, amount_hi, rate_num, rate_den]

    movup.2 u32split
    # => [num_lo, num_hi, amount_lo, amount_hi, rate_den]

    exec.u64::widening_mul
    # => [prod0, prod1, prod2, prod3, rate_den]

    # divide by rate_den as a u128, rounding up
    push.0.0 movup.6 u32split
    # => [den_lo, den_hi, 0, 0, prod0, prod1, prod2, prod3]

    exec.u128::divmod
    # => [rem0, rem1, rem2, rem3, quot0, quot1, quot2, quot3]

    # round up if the remainder is non-zero; the limbs are u32s, so the felt sum cannot wrap
    add add add neq.0
    # => [round_up, quot0, quot1, quot2, quot3]

    # the quotient must fit into a u64
    movup.3 movup.4 add assertz.err=ERR_FEE_CONVERTED_AMOUNT_OVERFLOW
    # => [round_up, quot0, quot1]

    push.0 swap
    # => [round_up, 0, quot0, quot1]

    exec.u64::overflowing_add
    # => [overflow, converted_lo, converted_hi]

    assertz.err=ERR_FEE_CONVERTED_AMOUNT_OVERFLOW
    # => [converted_lo, converted_hi]

    # bound the high limb so the limbs recombine into a felt without wrapping
    dup.1 push.MAX_CONVERTED_AMOUNT_HI_LIMB u32lt
    assert.err=ERR_FEE_CONVERTED_AMOUNT_OVERFLOW
    # => [converted_lo, converted_hi]

    # recombine the limbs into a felt amount
    swap mul.U32_LIMB_MULTIPLIER add
    # => [converted_amount]

    # ensure the converted amount is a valid fungible asset amount
    dup lte.FUNGIBLE_ASSET_MAX_AMOUNT assert.err=ERR_FEE_CONVERTED_AMOUNT_OVERFLOW
    # => [converted_amount]
end

#! Adds the internal cycle margins of a pay_fee flow to the caller's estimate of remaining
#! authentication cycles.
#!
#! The margins cover the pay_fee tail (everything after the compute_fee call) and the post-auth
#! kernel epilogue, whose cost scales with the number of output notes. All output notes except
#! the fee note itself exist by the time a pay_fee flow runs, so the estimate is scaled by their
#! count plus one.
#!
#! Inputs:  [num_extra_cycles]
#! Outputs: [num_estimated_extra_cycles]
#!
#! Where:
#! - num_extra_cycles is the estimated number of cycles the authentication procedure spends after
#!   the pay_fee flow returns.
#! - num_estimated_extra_cycles is the total estimate to pass to compute_fee.
#!
#! Invocation: exec
pub proc apply_cycle_margins(num_extra_cycles: felt) -> felt
    add.PAY_FEE_CYCLES add.POST_AUTH_EPILOGUE_BASE_CYCLES
    # => [num_partial_extra_cycles]

    exec.tx::get_num_output_notes add.1 mul.POST_AUTH_EPILOGUE_PER_NOTE_CYCLES add
    # => [num_estimated_extra_cycles]
end

#! Creates a new TX_FEE output note and funds it with the provided asset from the
#! account's vault.
#!
#! The note's serial number is derived as hash(FEE_DOMAIN || [serial_number_block, initial_nonce,
#! account_id_suffix, account_id_prefix]).
#!
#! Inputs:  [serial_number_block, initial_nonce, ASSET_ID, ASSET_VALUE]
#! Outputs: []
#!
#! Where:
#! - serial_number_block is the block number used to derive the note's serial number.
#! - initial_nonce is the account's nonce at the start of the transaction, used to derive the
#!   note's serial number.
#! - ASSET_ID is the asset ID of the fee payment asset.
#! - ASSET_VALUE is the value of the fee payment asset.
#!
#! Panics if:
#! - serial_number_block is not a u32.
#! - the account vault holds less of the payment asset than the amount to be paid.
#! - the maximum number of output notes is exceeded.
#!
#! Invocation: exec
pub proc create_and_fund_fee_note(serial_number_block: BlockNumber, initial_nonce: felt, asset: Asset)
    u32assert
    # => [serial_number_block, initial_nonce, ASSET_ID, ASSET_VALUE]

    # derive the note's serial number
    exec.native_account::get_id
    # => [account_id_suffix, account_id_prefix, serial_number_block, initial_nonce, ASSET_ID, ASSET_VALUE]

    movup.3 movup.3
    # => [serial_number_block, initial_nonce, account_id_suffix, account_id_prefix, ASSET_ID, ASSET_VALUE]

    # domain-separate the serial number by hashing the tuple with the FEE domain tag
    push.0.0.0 push.FEE_DOMAIN_TAG
    # => [FEE_DOMAIN, [serial_number_block, initial_nonce, account_id_suffix, account_id_prefix],
    #     ASSET_ID, ASSET_VALUE]

    exec.eidos::hash_double_word
    # => [SERIAL_NUM, ASSET_ID, ASSET_VALUE]

    exec.tx_fee::prepare_note
    # => [tag, note_type, RECIPIENT, ASSET_ID, ASSET_VALUE]

    exec.output_note::create
    # => [note_idx, ASSET_ID, ASSET_VALUE]

    movdn.8
    # => [ASSET_ID, ASSET_VALUE, note_idx]

    # move the fee asset from the vault into the note
    # (see basic_wallet::move_asset_to_note for the same sequence in call form)
    dupw.1 dupw.1
    # => [ASSET_ID, ASSET_VALUE, ASSET_ID, ASSET_VALUE, note_idx]

    exec.native_account::remove_asset dropw
    # => [ASSET_ID, ASSET_VALUE, note_idx]

    exec.output_note::add_asset
    # => []
end

#! Estimates the fee a pay_fee flow would pay for this transaction without creating any note.
#!
#! Prices the network output notes the way pay_fee sponsors them (see
#! fees::estimate_network_note_sponsorships) and computes the transaction fee via compute_fee,
#! charging on top of num_extra_cycles the cycles pay_fee would spend pricing the notes again,
#! measured on the pricing this procedure performs, creating the sponsorship notes, and the
#! margins pay_fee applies. The estimate is an upper bound of what pay_fee pays as long as the
#! caller's num_extra_cycles bounds the cycles spent between this call and the pay_fee flow and
#! the targets' fee policies cost the same when pay_fee prices the notes again, which holds for
#! policies whose cost depends only on state the transaction cannot change in between.
#!
#! Inputs:  [num_extra_cycles]
#! Outputs: [fee_amount, total_sponsored_fee_amount]
#!
#! Where:
#! - num_extra_cycles is the estimated number of cycles the caller spends after this call until
#!   the pay_fee flow computes the fee, e.g. signature verification, plus what it would pass to
#!   pay_fee.
#! - fee_amount is the estimated transaction fee.
#! - total_sponsored_fee_amount is the estimated total amount of the sponsorship notes.
#!
#! Panics if:
#! - the sponsorship pricing fails (propagates the panics of
#!   fees::estimate_network_note_sponsorships).
#! - num_extra_cycles (plus internal margins) is not a u32 or the total cycle count exceeds the
#!   maximum cycle count.
#!
#! Invocation: exec
pub proc estimate_fee(num_extra_cycles: u32) -> (AssetAmount, AssetAmount)
    clk
    # => [clk_before_pricing, num_extra_cycles]

    exec.fees::estimate_network_note_sponsorships
    # => [num_sponsored_notes, total_sponsored_fee_amount, clk_before_pricing, num_extra_cycles]

    # charge the creation of the sponsorship notes a pay_fee flow would perform
    mul.SPONSORSHIP_NOTE_CYCLES
    # => [creation_cycles, total_sponsored_fee_amount, clk_before_pricing, num_extra_cycles]

    # pay_fee prices the notes again, so charge what the pricing above cost once more
    clk movup.3 sub add
    # => [pricing_and_creation_cycles, total_sponsored_fee_amount, num_extra_cycles]

    movup.2 add
    # => [num_extra_cycles, total_sponsored_fee_amount]

    exec.apply_cycle_margins
    # => [num_estimated_extra_cycles, total_sponsored_fee_amount]

    # no output notes are excluded from the fee computation
    padw movup.4
    # => [num_estimated_extra_cycles, EXCLUDE_NOTES_COMMITMENT, total_sponsored_fee_amount]

    exec.tx::compute_fee
    # => [fee_amount, total_sponsored_fee_amount]
end

#! Computes the transaction fee and pays it by creating and funding a public TX_FEE note.
#!
#! This is the fee payment flow for all account types: the caller supplies the decoded
#! conversion info and invokes this procedure from the authentication procedure BEFORE any
#! transaction summary is created, so that the TX_FEE note and the vault withdrawal funding
#! it are covered by a signature where one exists. Signature-based components (e.g. singlesig,
#! multisig) obtain the conversion info from the auth args via load_conversion_info; network
#! accounts obtain it via native_conversion_info, which needs no commitment since it is read
#! from the reference block.
#!
#! The fee amount is computed via the compute_fee kernel procedure. num_extra_cycles only needs
#! to cover the number of cycles the authentication procedure spends after this procedure
#! returns (e.g. transaction summary creation, hashing and signature verification, see
#! signature::estimate_authentication_cycles); this procedure adds its own tail cycles and the
#! post-authentication kernel epilogue cycles internally.
#!
#! The conversion info must equal native_conversion_info, so the paid amount is the computed
#! fee.
#!
#! If the computed fee is zero (e.g. the reference block's verification base fee is zero), no
#! fee note is created and no conversion info is required (the empty word is accepted). Note that
#! the sponsorship step above may still have created notes and withdrawn from the vault.
#!
#! Before computing the fee, this creates a FEE_SPONSORSHIP note for every network output note
#! of the transaction (see fees::create_network_note_sponsorships), so those notes are included
#! in the cycle estimate and the fee. This prices each network note through its target account's
#! fee policy via an FPI call, which requires that target to be provisioned as a foreign account.
#!
#! Inputs:  [num_extra_cycles, CONVERSION_INFO, serial_number_block, initial_nonce]
#! Outputs: [fee_amount, total_sponsored_fee_amount]
#!
#! Where:
#! - num_extra_cycles is the estimated number of cycles the caller spends after this call until
#!   the end of the authentication procedure.
#! - CONVERSION_INFO is [faucet_id_suffix, faucet_id_prefix, rate_num, rate_den], or the empty
#!   word if no conversion info was committed (only accepted when the computed fee is zero).
#! - serial_number_block is the block number used to derive the fee note's serial number.
#! - initial_nonce is the account's nonce at the start of the transaction, used to derive the fee
#!   note's serial number. A caller running after the nonce was incremented must have read it
#!   before.
#! - fee_amount is the amount paid into the TX_FEE note, or zero if no note was created.
#! - total_sponsored_fee_amount is the total amount the sponsorship step moved into sponsorship
#!   notes.
#!
#! Panics if:
#! - the sponsorship step fails (propagates the panics of
#!   fees::create_network_note_sponsorships, e.g. a target's fee policy is unset/unreachable or
#!   the vault underfunds a sponsored amount).
#! - num_extra_cycles (plus internal margins) is not a u32 or the total cycle count exceeds the
#!   maximum cycle count.
#! - the computed fee is non-zero and CONVERSION_INFO is the empty word.
#! - the computed fee is non-zero and CONVERSION_INFO is not the native conversion info.
#! - the computed fee is non-zero and serial_number_block is not a u32.
#! - the account vault holds less of the fee asset than the amount to be paid.
#! - the maximum number of output notes is exceeded.
#!
#! Invocation: exec
pub proc pay_fee(
    num_extra_cycles: u32,
    conversion_info: ConversionInfo,
    serial_number_block: BlockNumber,
    initial_nonce: felt
) -> (AssetAmount, AssetAmount)
    # sponsor any network output notes before the fee is computed, so the sponsorship notes
    # this creates are counted by both the cycle estimate and compute_fee.
    exec.tx::get_fee_asset_id
    # => [FEE_ASSET_ID, num_extra_cycles, CONVERSION_INFO, serial_number_block, initial_nonce]

    exec.fees::create_network_note_sponsorships
    # => [total_sponsored_fee_amount, num_extra_cycles, CONVERSION_INFO, serial_number_block,
    #     initial_nonce]

    movdn.7
    # => [num_extra_cycles, CONVERSION_INFO, serial_number_block, initial_nonce,
    #     total_sponsored_fee_amount]

    exec.apply_cycle_margins
    # => [num_estimated_extra_cycles, CONVERSION_INFO, serial_number_block, initial_nonce,
    #     total_sponsored_fee_amount]

    # no exclusion preimage is supplied, so pass the EMPTY_WORD absence sentinel
    padw movup.4
    # => [num_estimated_extra_cycles, EXCLUDE_NOTES_COMMITMENT, CONVERSION_INFO,
    #     serial_number_block, initial_nonce, total_sponsored_fee_amount]

    exec.tx::compute_fee
    # => [fee_amount, CONVERSION_INFO, serial_number_block, initial_nonce, total_sponsored_fee_amount]

    dup eq.0
    if.true
        # a zero fee requires no fee note
        movdn.6 dropw drop drop
        # => [fee_amount, total_sponsored_fee_amount]
    else
        # keep the paid amount for the output
        dup movdn.7
        # => [fee_amount, CONVERSION_INFO, serial_number_block, initial_nonce, fee_amount,
        #     total_sponsored_fee_amount]

        movdn.4
        # => [CONVERSION_INFO, fee_amount, serial_number_block, initial_nonce, fee_amount,
        #     total_sponsored_fee_amount]

        # a non-zero fee requires committed conversion info
        exec.word::testz assertz.err=ERR_FEE_CONVERSION_INFO_MISSING
        # => [CONVERSION_INFO, fee_amount, serial_number_block, initial_nonce, fee_amount,
        #     total_sponsored_fee_amount]

        # pin the payment to the native fee asset at 1-to-1 rate
        dupw exec.native_conversion_info assert_eqw.err=ERR_FEE_CONVERSION_INFO_NOT_NATIVE
        # => [CONVERSION_INFO, fee_amount, serial_number_block, initial_nonce, fee_amount,
        #     total_sponsored_fee_amount]

        # convert the fee amount into the payment asset's amount
        # (CONVERSION_INFO reads [faucet_id_suffix, faucet_id_prefix, rate_num, rate_den])
        movup.2 movup.3 movup.4
        # => [fee_amount, rate_den, rate_num, faucet_id_suffix, faucet_id_prefix,
        #     serial_number_block, initial_nonce, fee_amount, total_sponsored_fee_amount]

        movup.2 swap
        # => [fee_amount, rate_num, rate_den, faucet_id_suffix, faucet_id_prefix,
        #     serial_number_block, initial_nonce, fee_amount, total_sponsored_fee_amount]

        exec.convert_amount
        # => [payment_amount, faucet_id_suffix, faucet_id_prefix, serial_number_block,
        #     initial_nonce, fee_amount, total_sponsored_fee_amount]

        movdn.2
        # => [faucet_id_suffix, faucet_id_prefix, payment_amount, serial_number_block,
        #     initial_nonce, fee_amount, total_sponsored_fee_amount]

        exec.fungible_asset::create
        # => [ASSET_ID, ASSET_VALUE, serial_number_block, initial_nonce, fee_amount,
        #     total_sponsored_fee_amount]

        movup.9 movup.9
        # => [serial_number_block, initial_nonce, ASSET_ID, ASSET_VALUE, fee_amount,
        #     total_sponsored_fee_amount]

        exec.create_and_fund_fee_note
        # => [fee_amount, total_sponsored_fee_amount]
    end
end

#! Pays the transaction fee like pay_fee and asserts that the paid fee and the sponsored fees
#! together do not exceed max_fee.
#!
#! This lets an authentication procedure pay the fee after the transaction was authorized against
#! a fee cap rather than the exact fee: the TX_FEE note and the sponsorship notes are then not
#! covered by the authorization, so the sum of what they carry is checked against the cap instead.
#!
#! Inputs:  [num_extra_cycles, CONVERSION_INFO, serial_number_block, initial_nonce, max_fee]
#! Outputs: []
#!
#! Where:
#! - num_extra_cycles, CONVERSION_INFO, serial_number_block and initial_nonce are as described in
#!   pay_fee.
#! - max_fee is the maximum amount the fee and the sponsorships may total, in the native fee asset.
#!
#! Panics if:
#! - the fee payment fails (propagates the panics of pay_fee).
#! - the paid fee and the sponsored fees together exceed max_fee.
#!
#! Invocation: exec
pub proc pay_bounded_fee(
    num_extra_cycles: u32,
    conversion_info: ConversionInfo,
    serial_number_block: BlockNumber,
    initial_nonce: felt,
    max_fee: AssetAmount
)
    exec.pay_fee
    # => [fee_amount, total_sponsored_fee_amount, max_fee]

    exec.fungible_asset::saturating_add_amount
    # => [total_fee_amount, max_fee]

    gte assert.err=ERR_FEE_EXCEEDS_MAX_FEE
    # => []
end
