use miden::protocol::tx
use {ConversionInfo} from miden::standards::fee
use miden::standards::assets::fungible_asset
use miden::standards::fee

# ERRORS
# =================================================================================================

const ERR_FEE_CONVERSION_INFO_MISSING = "paying a non-zero fee requires conversion info committed via the auth args"

# PROCEDURES
# =================================================================================================

#! Computes the transaction fee and pays it by creating and funding a public BATCH_FEE note.
#!
#! This is the fee payment flow for singlesig-style authentication: the caller decodes the
#! conversion info (e.g. via fee::load_conversion_info on the auth args) and invokes this
#! procedure BEFORE the transaction summary is created, so that the BATCH_FEE note and the vault
#! withdrawal funding it are covered by the signed summary. Multisig and network accounts will
#! use different pay_fee variants (e.g. network accounts read the payment faucet from storage and
#! obtain the conversion rate from an oracle).
#!
#! The fee amount is computed via the compute_fee kernel procedure. num_extra_cycles only needs
#! to cover the number of cycles the authentication procedure spends after this procedure returns
#! (e.g. transaction summary creation, hashing and signature verification, see
#! signature::estimate_authentication_cycles); this procedure adds its own tail cycles and the
#! post-authentication kernel epilogue cycles internally.
#!
#! The paid amount is ceil(fee_amount * rate_num / rate_den) of the asset issued by the faucet in
#! the conversion info. To pay in the native fee asset, commit to the native fee faucet at rate
#! 1/1.
#!
#! If the computed fee is zero (e.g. the reference block's verification base fee is zero), no
#! note is created, no conversion info is required (the empty-word sentinel is accepted) and the
#! account vault is left untouched.
#!
#! Inputs:  [num_extra_cycles, CONVERSION_INFO]
#! Outputs: []
#!
#! Where:
#! - num_extra_cycles is the estimated number of cycles the caller spends after this call until
#!   the end of the authentication procedure.
#! - CONVERSION_INFO is [faucet_id_prefix, faucet_id_suffix, rate_num, rate_den] (in memory
#!   order), or the empty word if no conversion info was committed.
#!
#! Panics if:
#! - num_extra_cycles (plus internal margins) is not a u32 or the total cycle count exceeds the
#!   maximum cycle count.
#! - the computed fee is non-zero and CONVERSION_INFO is the empty word.
#! - the conversion rate is malformed or the converted amount overflows.
#! - the account vault holds less of the payment asset than the amount to be paid.
#! - the maximum number of output notes is exceeded.
#!
#! Invocation: exec
pub proc pay_fee(num_extra_cycles: felt, conversion_info: ConversionInfo)
    exec.fee::apply_cycle_margins
    # => [num_estimated_extra_cycles, CONVERSION_INFO]

    # no output notes are excluded from the fee computation
    padw movup.4
    # => [num_estimated_extra_cycles, EXCLUDE_NOTES_COMMITMENT, CONVERSION_INFO]

    exec.tx::compute_fee
    # => [fee_amount, CONVERSION_INFO]

    dup eq.0
    if.true
        # a zero fee requires no fee note
        drop dropw
        # => []
    else
        movdn.4
        # => [CONVERSION_INFO, fee_amount]

        # a non-zero fee requires committed conversion info
        padw eqw
        # => [is_empty, EMPTY_WORD, CONVERSION_INFO, fee_amount]

        assertz.err=ERR_FEE_CONVERSION_INFO_MISSING dropw
        # => [CONVERSION_INFO, fee_amount]

        # convert the fee amount into the payment asset's amount
        # (CONVERSION_INFO reads [faucet_id_prefix, faucet_id_suffix, rate_num, rate_den])
        movup.2 movup.3 movup.4
        # => [fee_amount, rate_den, rate_num, faucet_id_prefix, faucet_id_suffix]

        movup.2 swap
        # => [fee_amount, rate_num, rate_den, faucet_id_prefix, faucet_id_suffix]

        exec.fee::convert_amount
        # => [payment_amount, faucet_id_prefix, faucet_id_suffix]

        movdn.2 swap
        # => [faucet_id_suffix, faucet_id_prefix, payment_amount]

        exec.fungible_asset::create
        # => [ASSET_ID, ASSET_VALUE]

        exec.fee::create_and_fund_fee_note
        # => []
    end
end
