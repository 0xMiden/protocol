# miden::standards::access::warden
#
# Provides a standalone "warden" actor for account components: a single warden account ID
# stored in one value slot, and account-ID equality authorization primitives.
#
# The warden is a second privileged actor, distinct from the owner, intended as a safety brake:
# other components consult `assert_sender_is_warden` / `is_sender_warden` to authorize
# some actions (e.g. an emergency freeze, or cancelling a scheduled operation). The warden
# can never grant roles, move assets, or perform owner-only actions. It is purely an authorization
# subject checked by the procedures that opt into it.
#
# Authorization is a plain account-ID equality check, so this component needs no RBAC
# infrastructure and behaves the same across all authority modes. If no warden is assigned the
# stored ID is the zero address `(0, 0)`, and the equality check returns 0 for every real sender,
# yielding "no warden => nobody passes the warden check" for free.
#
# Storage layout (single slot):
#   Word:  [warden_suffix, warden_prefix, 0, 0]

use miden::protocol::active_account
use miden::protocol::account_id
use miden::protocol::active_note
use miden::protocol::native_account
use miden::standards::access::authority

# CONSTANTS
# ================================================================================================

# The slot in this component's storage layout where the warden account ID is stored.
const WARDEN_SLOT = word("miden::standards::access::warden::warden_id")

# ERRORS
# ================================================================================================

const ERR_SENDER_NOT_WARDEN = "note sender is not the warden"

# PUBLIC INTERFACE
# ================================================================================================

#! Returns the warden account ID.
#!
#! Inputs:  [pad(16)]
#! Outputs: [warden_suffix, warden_prefix, pad(14)]
#!
#! Where:
#! - warden_{suffix, prefix} are the suffix and prefix felts of the warden account ID. Both
#!   are zero if no warden is assigned.
#!
#! Invocation: call
@account_procedure
pub proc get_warden
    exec.get_warden_internal
    # => [warden_suffix, warden_prefix, pad(16)]

    movup.2 drop movup.2 drop
    # => [warden_suffix, warden_prefix, pad(14)]
end

#! Sets or clears the warden account ID.
#!
#! Authorized through `authority::assert_authorized`, so the gate is mode-aware. The owner under
#! `OwnerControlled`, the configured role (or the owner fallback) under `RbacControlled`, and the
#! account's auth component under `AuthControlled`. Requires the [`Authority`] component to be
#! installed on the account.
#!
#! Clearing behaviour:
#! - If `new_warden` is the zero address `(0, 0)`, the warden is cleared. The zero address is
#!   treated as a clear value and is not validated as an account ID.
#! - Otherwise, `new_warden` is validated and stored as the warden.
#!
#! Inputs:  [new_warden_suffix, new_warden_prefix, pad(14)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the sender is not authorized.
#! - new_warden is non-zero and the account ID is invalid.
#!
#! Invocation: call
@account_procedure
pub proc set_warden
    exec.authority::assert_authorized
    # => [new_warden_suffix, new_warden_prefix, pad(14)]

    # Detect explicit clear via the zero address. The zero address is not a valid account ID, so
    # we must check for it before validating.
    exec.account_id::testz
    # => [is_zero_address, new_warden_suffix, new_warden_prefix, pad(14)]

    if.false
        # Non-zero new warden: validate before storing.
        dup.1 dup.1 exec.account_id::validate
    end
    # => [new_warden_suffix, new_warden_prefix, pad(14)]

    exec.save_warden_info
    # => [pad(16)]
end

# PUBLIC HELPERS
# ================================================================================================

#! Returns 1 if the note sender is the warden, otherwise 0.
#!
#! Inputs:  []
#! Outputs: [is_sender_warden]
#!
#! Where:
#! - is_sender_warden is 1 if the note sender is the warden, otherwise 0.
#!
#! Invocation: exec
pub proc is_sender_warden
    exec.active_note::get_sender
    # => [sender_suffix, sender_prefix]

    exec.is_warden_internal
    # => [is_sender_warden]
end

#! Asserts that the note sender is the warden.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Panics if:
#! - the note sender is not the warden.
#!
#! Invocation: exec
pub proc assert_sender_is_warden
    exec.is_sender_warden
    # => [is_sender_warden]

    assert.err=ERR_SENDER_NOT_WARDEN
    # => []
end

# HELPER PROCEDURES
# ================================================================================================

#! Returns the warden account ID from storage.
#!
#! Inputs:  []
#! Outputs: [warden_suffix, warden_prefix]
#!
#! Where:
#! - warden_{suffix, prefix} are the suffix and prefix felts of the warden account ID. Both
#!   are zero if no warden is assigned.
proc get_warden_internal
    push.WARDEN_SLOT[0..2] exec.active_account::get_item
    # => [warden_suffix, warden_prefix, 0, 0]

    movup.2 drop movup.2 drop
    # => [warden_suffix, warden_prefix]
end

#! Builds the warden word, writes it to storage and drops the old value.
#!
#! Inputs:  [warden_suffix, warden_prefix]
#! Outputs: []
proc save_warden_info
    push.0.0 movup.3 movup.3
    # => [warden_suffix, warden_prefix, 0, 0]

    push.WARDEN_SLOT[0..2]
    # => [slot_suffix, slot_prefix, warden_suffix, warden_prefix, 0, 0]

    exec.native_account::set_item
    # => [OLD_WARDEN_WORD]

    dropw
    # => []
end

#! Checks if the given account ID is the warden.
#!
#! Inputs:  [account_id_suffix, account_id_prefix]
#! Outputs: [is_warden]
#!
#! Where:
#! - account_id_{suffix, prefix} are the suffix and prefix felts of the account ID to check.
#! - is_warden is 1 if the account is the warden, 0 otherwise.
proc is_warden_internal
    exec.get_warden_internal
    # => [warden_suffix, warden_prefix, account_id_suffix, account_id_prefix]

    exec.account_id::eq
    # => [is_warden]
end
