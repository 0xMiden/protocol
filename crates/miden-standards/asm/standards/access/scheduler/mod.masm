use {AccountProcedureRoot, Bool, NoteId} from miden::protocol::types
# miden::standards::access::scheduler
#
# Operation scheduler: a mandatory waiting period in front of selected authority-gated procedures.
#
# Administrative actions arrive as notes, so the note is the operation. A proposal records "note X
# may be consumed no earlier than T" in the account's storage; the gated procedure, when its root
# is flagged as scheduled, looks the note it is consuming up in that ledger and proceeds only once
# T has passed. Cancelling removes the proposal. The note id binds script, arguments, serial
# number, assets and sender, so what was proposed and what is consumed are provably the same note.
#
# This module holds the storage and the exec-only primitives. It performs NO authorization; the
# `call` entrypoints (`schedule`, `cancel`, `set_min_delay`, `set_procedure_scheduling`) live in
# [`scheduler::manager`] and are gated by `authority::assert_authorized`.
#
# Storage layout (3 slots):
#
# Slot 1 (`SCHEDULER_CONFIG_SLOT`):
#   Value: [min_delay, 0, 0, 0]
#
# Slot 2 (`SCHEDULED_PROCEDURES_SLOT`):
#   Map: [PROCEDURE_ROOT] -> [is_scheduled, 0, 0, 0]
#
# Slot 3 (`PROPOSALS_SLOT`):
#   Map: [NOTE_ID] -> [ready_at, proposer_suffix, proposer_prefix, 0]
#
# `min_delay` lives here, not in the note: a note that declared its own delay would let its author
# choose zero. Staleness of a proposed-but-never-consumed note is left to the note's own expiry.

use miden::core::word
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::native_account
use miden::protocol::tx
use {ONE_WORD, ZERO_WORD} from miden::standards::utils

pub mod manager

# Reference block timestamp, in seconds.
pub type Timestamp = u32
# Waiting period between a proposal and its readiness, in seconds.
pub type MinDelay = u32
pub type Proposal = struct {
    ready_at: Timestamp,
    proposer_suffix: felt,
    proposer_prefix: felt
}

# CONSTANTS
# =================================================================================================

# Value slot holding the waiting period: [min_delay, 0, 0, 0].
pub const SCHEDULER_CONFIG_SLOT = word("miden::standards::access::scheduler::config")

# Map slot flagging which authority-gated procedures require a proposal.
# Map entries: [PROCEDURE_ROOT] -> [is_scheduled, 0, 0, 0].
pub const SCHEDULED_PROCEDURES_SLOT = word("miden::standards::access::scheduler::scheduled_procedures")

# Map slot holding the proposals.
# Map entries: [NOTE_ID] -> [ready_at, proposer_suffix, proposer_prefix, 0].
pub const PROPOSALS_SLOT = word("miden::standards::access::scheduler::proposals")

const SCHEDULED_WORD = ONE_WORD
const NOT_SCHEDULED_WORD = ZERO_WORD

# ERRORS
# =================================================================================================

const ERR_SCHEDULER_NOT_PROPOSED = "operation was not proposed"
const ERR_SCHEDULER_NOT_READY = "operation is still timelocked"

# PUBLIC INTERFACE
# =================================================================================================

#! Returns the waiting period.
#!
#! Inputs:  [pad(16)]
#! Outputs: [min_delay, pad(15)]
#!
#! Invocation: call
@account_procedure
pub proc get_min_delay() -> MinDelay
    push.SCHEDULER_CONFIG_SLOT[0..2] exec.active_account::get_item
    # => [min_delay, 0, 0, 0, pad(16)]

    movdn.4 dropw
    # => [min_delay, pad(15)]
end

# PUBLIC HELPERS
# =================================================================================================

#! Asserts the calling procedure's proposal is ready, if the procedure requires one.
#!
#! A no-op when the scheduler is not installed or the calling procedure is not flagged as
#! scheduled, so accounts that schedule nothing pay only the slot-existence check. When the flag is
#! set, the operation is the note being consumed: its proposal must exist and be ready, and it is
#! consumed so it cannot serve twice. A flagged procedure can therefore only be invoked from a note.
#!
#! Because the calling procedure is identified via `caller`, this MUST be `exec`'d from within a
#! `call` entrypoint, directly or through `authority::assert_authorized`.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Panics if:
#! - the calling procedure is scheduled and the active note was not proposed or is not ready yet.
#!
#! Invocation: exec
pub proc assert_ready_if_scheduled()
    push.SCHEDULED_PROCEDURES_SLOT[0..2] exec.active_account::has_storage_slot
    # => [has_scheduler]

    if.true
        padw caller exec.is_scheduled_procedure
        # => [is_scheduled]

        if.true
            exec.active_note::get_note_id exec.consume_scheduled
            # => []
        end
    end
    # => []
end

#! Consumes the proposal for an operation: asserts it exists and its waiting period has elapsed,
#! then removes it so it cannot be used twice.
#!
#! `now` is the reference block timestamp. An executor picking an older reference block only makes
#! this check stricter, so no expiration bound is needed here.
#!
#! Inputs:  [NOTE_ID]
#! Outputs: []
#!
#! Panics if:
#! - NOTE_ID was never proposed, or its proposal was cancelled.
#! - the proposal's ready_at has not passed.
#!
#! Invocation: exec
pub proc consume_scheduled(note_id: NoteId)
    dupw exec.get_ready_at
    # => [ready_at, NOTE_ID]

    dup neq.0 assert.err=ERR_SCHEDULER_NOT_PROPOSED
    # => [ready_at, NOTE_ID]

    exec.tx::get_block_timestamp u32lte assert.err=ERR_SCHEDULER_NOT_READY
    # => [NOTE_ID]

    exec.clear_proposal
    # => []
end

#! Removes the proposal of an operation, if any. Performs no authorization.
#!
#! Inputs:  [NOTE_ID]
#! Outputs: []
#!
#! Invocation: exec
pub proc clear_proposal(note_id: NoteId)
    push.ZERO_WORD swapw
    # => [NOTE_ID, ZERO_WORD]

    exec.write_proposal_word
    # => []
end

#! Returns whether a procedure requires a proposal.
#!
#! Inputs:  [PROCEDURE_ROOT]
#! Outputs: [is_scheduled]
#!
#! Invocation: exec
pub proc is_scheduled_procedure(procedure_root: AccountProcedureRoot) -> Bool
    push.SCHEDULED_PROCEDURES_SLOT[0..2] exec.active_account::get_map_item
    # => [is_scheduled, 0, 0, 0]

    exec.word::eqz not
    # => [is_scheduled]
end

#! Returns the waiting period.
#!
#! Inputs:  []
#! Outputs: [min_delay]
#!
#! Invocation: exec
pub proc get_min_delay_internal() -> MinDelay
    push.SCHEDULER_CONFIG_SLOT[0..2] exec.active_account::get_item
    # => [min_delay, 0, 0, 0]

    movdn.3 drop drop drop
    # => [min_delay]
end

#! Returns the proposal recorded for an operation, or zeros if none.
#!
#! Inputs:  [NOTE_ID]
#! Outputs: [ready_at, proposer_suffix, proposer_prefix]
#!
#! Invocation: exec
pub proc get_proposal(note_id: NoteId) -> Proposal
    push.PROPOSALS_SLOT[0..2] exec.active_account::get_map_item
    # => [ready_at, proposer_suffix, proposer_prefix, 0]

    movup.3 drop
    # => [ready_at, proposer_suffix, proposer_prefix]
end

#! Returns the readiness timestamp of an operation's proposal, or 0 if none.
#!
#! Inputs:  [NOTE_ID]
#! Outputs: [ready_at]
#!
#! Invocation: exec
pub proc get_ready_at(note_id: NoteId) -> Timestamp
    exec.get_proposal
    # => [ready_at, proposer_suffix, proposer_prefix]

    swap drop swap drop
    # => [ready_at]
end

#! Records a proposal. Performs no authorization.
#!
#! Inputs:  [ready_at, proposer_suffix, proposer_prefix, NOTE_ID]
#! Outputs: []
#!
#! Invocation: exec
pub proc write_proposal(proposal: Proposal, note_id: NoteId)
    push.0 movdn.3
    # => [ready_at, proposer_suffix, proposer_prefix, 0, NOTE_ID]

    swapw
    # => [NOTE_ID, ready_at, proposer_suffix, proposer_prefix, 0]

    exec.write_proposal_word
    # => []
end

#! Sets or clears the scheduled flag of a procedure. Performs no authorization.
#!
#! Inputs:  [is_scheduled, PROCEDURE_ROOT]
#! Outputs: []
#!
#! Invocation: exec
pub proc write_scheduled_flag(is_scheduled: Bool, procedure_root: AccountProcedureRoot)
    push.NOT_SCHEDULED_WORD push.SCHEDULED_WORD
    # => [SCHEDULED_WORD, NOT_SCHEDULED_WORD, is_scheduled, PROCEDURE_ROOT]

    # cdropw keeps the word directly under the condition when it is 1.
    movup.8 cdropw
    # => [FLAG_WORD, PROCEDURE_ROOT]

    swapw
    # => [PROCEDURE_ROOT, FLAG_WORD]

    push.SCHEDULED_PROCEDURES_SLOT[0..2] exec.native_account::set_map_item
    # => [OLD_FLAG_WORD]

    dropw
    # => []
end

#! Writes the waiting period. Performs no authorization.
#!
#! Inputs:  [min_delay]
#! Outputs: []
#!
#! Invocation: exec
pub proc write_min_delay(min_delay: MinDelay)
    push.0.0.0 movup.3
    # => [min_delay, 0, 0, 0]

    push.SCHEDULER_CONFIG_SLOT[0..2] exec.native_account::set_item
    # => [OLD_CONFIG_WORD]

    dropw
    # => []
end

# HELPER PROCEDURES
# =================================================================================================

#! Writes a raw proposal word for an operation.
#!
#! Inputs:  [NOTE_ID, PROPOSAL_WORD]
#! Outputs: []
#!
#! Invocation: exec
proc write_proposal_word(note_id: NoteId, proposal_word: word)
    push.PROPOSALS_SLOT[0..2] exec.native_account::set_map_item
    # => [OLD_PROPOSAL_WORD]

    dropw
    # => []
end
