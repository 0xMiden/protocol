use {RoleSymbol} from miden::standards::access::role_symbol
use {AccountId, Bool} from miden::protocol::types
# miden::standards::access::rbac
#
# Role-based access control for account components.
#
# Provides per-role membership tracking with delegated role admins. Members are tracked
# with a boolean flag, an activation timestamp and a per-role member count. Role administration is
# fully role-based.
#
# Storage layout (2 slots):
#
# Slot 1 (`ROLE_CONFIG_SLOT`):
#   Map: [0, 0, 0, role_symbol] -> [member_count, admin_role_symbol, grant_delay, 0]
#
# Slot 2 (`ROLE_MEMBERSHIP_SLOT`):
#   Map: [0, role_symbol, account_suffix, account_prefix] -> [is_member, active_since, 0, 0]
#
# Grant delays:
# - Each role carries a `grant_delay` in seconds, set by `ADMIN` via `set_grant_delay`. A grant
#   records `active_since = now + grant_delay`; the membership counts only once that timestamp has
#   passed, so a suspicious grant can be revoked before the new member can act.
# - Zero is the default and means "active immediately", which is exactly the behaviour of a member
#   written without a delay, so accounts and seeds that never set a delay are unaffected.
# - `now` is the reference block timestamp, which the executor may choose from the past. A grant
#   with a non-zero delay therefore bounds the reference block's age with the default expiration
#   delta, so the delay can be shortened by at most that window. The membership check needs no
#   such bound: an older reference block can only make it stricter.
#
# Authority model:
# - Every role has an effective admin role. It is the role's configured
#   `admin_role_symbol` when set, otherwise the built-in `ADMIN` role. Only members of a
#   role's effective admin role may grant, revoke, or re-point (`set_role_admin`) that role.
# - Delegation is exclusive while the delegated admin role is populated: the `ADMIN` role then has
#   no authority over the delegated role. This lets a role be placed exclusively under a dedicated
#   admin role and kept out of reach of the general administrator.
# - Delegation is not a one-way door: a memberless role can authorize nothing, so authority over
#   the roles a memberless role administers falls back to the `ADMIN` role. Delegating to a dead
#   role therefore cannot orphan a role permanently, and only emptying `ADMIN` itself is final.
# - The `ADMIN` role administers itself (its own effective admin is `ADMIN`), so `ADMIN`
#   membership can be granted, revoked, and renounced through the standard API.
# - A role is considered to "exist" when it has at least one member. Role admin
#   relationships set via `set_role_admin` are stored in the config but do not, by
#   themselves, make the role exist.
#
# Security model:
# Access control is based on the note sender (`active_note::get_sender`), i.e. the account ID
# that created the note, not the code that ran when it was created. It is meaningful only when
# every account registered as a role member enforces strong authentication. Registering a
# permissionless account (for example one using the `no_auth` component) as a role member
# provides no protection: anyone can make such an account emit a note carrying an arbitrary script
# root with that account's ID as sender, defeating the sender check.

use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::native_account
use miden::protocol::tx
use miden::standards::access::role_symbol
use miden::standards::expiration

# Membership counts are field elements; the role map does not impose a u32 bound.
pub type RoleMemberCount = felt
# Delay between a grant and its activation, in seconds.
pub type GrantDelay = u32
# Reference block timestamp, in seconds.
pub type Timestamp = u32
pub type RoleConfig = struct {
    member_count: RoleMemberCount,
    admin: RoleSymbol,
    grant_delay: GrantDelay
}
pub type Membership = struct {
    is_member: Bool,
    active_since: Timestamp
}

# CONSTANTS
# =================================================================================================

# Per-role config map slot.
# Map entries: [0, 0, 0, role_symbol] -> [member_count, admin_role_symbol, grant_delay, 0]
const ROLE_CONFIG_SLOT = word("miden::standards::access::rbac::role_config")

# Per-role membership map slot.
# Map entries: [0, role_symbol, account_suffix, account_prefix] -> [is_member, active_since, 0, 0]
const ROLE_MEMBERSHIP_SLOT = word("miden::standards::access::rbac::role_membership")

# Procedure-local slots used by `set_membership_internal`.
const MEMBERSHIP_FLAG_LOC = 0
const ROLE_SYMBOL_LOC = 1
const ACTIVE_SINCE_LOC = 2

# The built-in default admin role. A role whose `admin_role_symbol` is unset (0) is
# administered by members of this role. Encodes the role symbol "ADMIN".
# Keep in sync with `RoleBasedAccessControl::ADMIN_ROLE` on the Rust side.
const ADMIN_ROLE = 1836707

# ERRORS
# =================================================================================================

const ERR_SENDER_LACKS_ROLE = "note sender does not hold the required role"
const ERR_SENDER_NOT_ROLE_ADMIN = "note sender does not hold the role's admin role"
const ERR_ACCOUNT_NOT_IN_ROLE = "account does not hold the role"
const ERR_MEMBER_COUNT_OVERFLOW = "role member count overflowed u32"
const ERR_GRANT_DELAY_NOT_U32 = "role grant delay must be a u32"
const ERR_ACTIVATION_TIMESTAMP_OVERFLOW = "role activation timestamp overflowed u32"

# PUBLIC INTERFACE
# =================================================================================================

#! Returns whether an account holds a role.
#!
#! Returns `0` if the role does not exist, the account is not a member, or the account's grant has
#! not activated yet (see `grant_role`).
#!
#! Inputs:  [role_symbol, account_suffix, account_prefix, pad(13)]
#! Outputs: [has_role, pad(15)]
#!
#! Where:
#! - role_symbol is the encoded role symbol.
#! - account_{suffix,prefix} are the suffix and prefix felts of the account ID.
#! - has_role is 1 if the account holds the role, otherwise 0.
#!
#! Invocation: call
@account_procedure
pub proc has_role(role_symbol: RoleSymbol, account: AccountId) -> Bool
    exec.has_role_internal
    # => [has_role, pad(15)]
end

#! Returns the delegated admin role for a role.
#!
#! Returns `0` when the role is owner-managed or when no role config exists for
#! `role_symbol`.
#!
#! Inputs:  [role_symbol, pad(15)]
#! Outputs: [admin_role_symbol, pad(15)]
#!
#! Where:
#! - role_symbol is the encoded role symbol.
#! - admin_role_symbol is the encoded admin role symbol, or 0 if the role is managed
#!   by the owner.
#!
#! Invocation: call
@account_procedure
pub proc get_role_admin(role_symbol: RoleSymbol) -> RoleSymbol
    exec.get_role_admin_internal
    # => [admin_role_symbol, pad(15)]
end

#! Returns the number of accounts assigned to a given role.
#!
#! If the role does not exist (i.e. has never had a member, or had its last member
#! revoked), this returns `0` — the underlying role config map returns `Word::ZERO`
#! for missing keys.
#!
#! Inputs:  [role_symbol, pad(15)]
#! Outputs: [member_count, pad(15)]
#!
#! Where:
#! - role_symbol is the encoded role symbol.
#! - member_count is the number of accounts currently assigned to the given role, or
#!   `0` if no such role exists.
#!
#! Invocation: call
@account_procedure
pub proc get_role_member_count(role_symbol: RoleSymbol) -> RoleMemberCount
    exec.get_role_member_count_internal
    # => [member_count, pad(15)]
end

#! Sets or updates the delegated admin role for a role.
#!
#! The role does not need to exist (have members) when this is called: the admin
#! relationship is recorded in the role's config so it takes effect as soon as the
#! role gains its first member. Calling this on a role that has no members does not
#! make the role exist.
#!
#! Pass `admin_role_symbol = 0` to clear the delegation and revert the role to
#! management by the default `ADMIN` role.
#!
#! Delegating to a memberless role does not put the role out of reach: authority over it falls
#! back to the `ADMIN` role for as long as the delegate stays memberless.
#!
#! Inputs:  [role_symbol, admin_role_symbol, pad(14)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - role_symbol is the encoded role symbol to configure.
#! - admin_role_symbol is the encoded delegated admin role symbol, or 0 to revert to
#!   management by the default `ADMIN` role.
#!
#! Panics if:
#! - role_symbol is not a valid role symbol encoding.
#! - admin_role_symbol is non-zero and is not a valid role symbol encoding.
#! - the note sender is not authorized to administer the role (see
#!   `assert_sender_is_role_admin`).
#!
#! Invocation: call
@account_procedure
pub proc set_role_admin(role_symbol: RoleSymbol, admin_role_symbol: RoleSymbol)
    dup exec.role_symbol::validate_encoding
    # => [role_symbol, new_admin_role_symbol, pad(14)]

    dup.1 exec.role_symbol::validate_admin_role_symbol
    # => [role_symbol, new_admin_role_symbol, pad(14)]

    dup exec.assert_sender_is_role_admin
    # => [role_symbol, new_admin_role_symbol, pad(14)]

    dup exec.get_role_config
    # => [member_count, old_admin_role_symbol, grant_delay, role_symbol, new_admin_role_symbol,
    #     pad(14)]

    swap drop
    # => [member_count, grant_delay, role_symbol, new_admin_role_symbol, pad(14)]

    movup.3 movup.3
    # => [role_symbol, new_admin_role_symbol, member_count, grant_delay, pad(14)]

    movup.2 swap
    # => [role_symbol, member_count, new_admin_role_symbol, grant_delay, pad(14)]

    exec.set_role_config
    # => [pad(16)]
end

#! Grants a role to an account.
#!
#! If the role does not yet exist, it is created (made existing) by this grant. The membership
#! activates at `now + grant_delay` (see `set_grant_delay`); with the default delay of zero it is
#! active immediately. Until then the account is counted as a member but `has_role` returns `0`,
#! so the grant can be revoked before it takes effect.
#!
#! If the account is already a member of the role, active or pending, this is a no-op: in
#! particular it does not reset a pending member's activation.
#!
#! When the delay is non-zero the transaction's expiration delta is capped to the default, so the
#! reference block, and with it `now`, cannot be chosen from far in the past to shorten the delay.
#!
#! Inputs:  [role_symbol, account_suffix, account_prefix, pad(13)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - role_symbol is the encoded role symbol to grant.
#! - account_{suffix,prefix} are the suffix and prefix felts of the account ID.
#!
#! Panics if:
#! - role_symbol is not a valid role symbol encoding.
#! - the note sender is not authorized to administer the role (see
#!   `assert_sender_is_role_admin`).
#! - the account ID is invalid.
#! - the activation timestamp overflows u32.
#!
#! Invocation: call
@account_procedure
pub proc grant_role(role_symbol: RoleSymbol, account: AccountId)
    dup exec.role_symbol::validate_encoding
    # => [role_symbol, account_suffix, account_prefix, pad(13)]

    dup exec.assert_sender_is_role_admin
    # => [role_symbol, account_suffix, account_prefix, pad(13)]

    # Validate the account ID. Grant is the sole writer of the membership map, so validating
    # here guarantees every stored key is valid; revoke and renounce therefore skip the check,
    # since an invalid ID can never match a stored key.
    dup.2 dup.2 exec.account_id::validate_structure
    # => [role_symbol, account_suffix, account_prefix, pad(13)]

    # Re-granting an existing or pending member is a no-op; writing again would reset its
    # activation timestamp.
    dup.2 dup.2 dup.2 exec.get_membership_internal
    # => [is_member, active_since, role_symbol, account_suffix, account_prefix, pad(13)]

    swap drop
    # => [is_member, role_symbol, account_suffix, account_prefix, pad(13)]

    if.true
        drop drop drop
        # => [pad(13)]
    else
        dup exec.get_grant_delay_internal
        # => [grant_delay, role_symbol, account_suffix, account_prefix, pad(13)]

        exec.compute_active_since
        # => [active_since, role_symbol, account_suffix, account_prefix, pad(13)]

        push.1
        # => [is_member=1, active_since, role_symbol, account_suffix, account_prefix, pad(13)]

        exec.set_membership_internal
        # => [pad(13)]
    end
    # => [pad(16)]
end

#! Revokes a role from an account.
#!
#! Decrements the role's member count. If the removed account was the last member,
#! the role becomes non-existent (member_count = 0).
#!
#! Inputs:  [role_symbol, account_suffix, account_prefix, pad(13)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - role_symbol is the encoded role symbol to revoke.
#! - account_{suffix,prefix} are the suffix and prefix felts of the account ID.
#!
#! Panics if:
#! - role_symbol is not a valid role symbol encoding.
#! - the note sender is not authorized to administer the role (see
#!   `assert_sender_is_role_admin`).
#! - the account does not hold the role.
#!
#! Invocation: call
@account_procedure
pub proc revoke_role(role_symbol: RoleSymbol, account: AccountId)
    dup exec.role_symbol::validate_encoding
    # => [role_symbol, account_suffix, account_prefix, pad(13)]

    dup exec.assert_sender_is_role_admin
    # => [role_symbol, account_suffix, account_prefix, pad(13)]

    push.0.0
    # => [is_member=0, active_since=0, role_symbol, account_suffix, account_prefix, pad(13)]

    exec.set_membership_internal
    # => [pad(16)]
end

#! Renounces a role held by the note sender.
#!
#! Inputs:  [role_symbol, pad(15)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - role_symbol is the encoded role symbol to renounce.
#!
#! Panics if:
#! - role_symbol is not a valid role symbol encoding.
#! - the note sender does not hold the role.
#!
#! Invocation: call
@account_procedure
pub proc renounce_role(role_symbol: RoleSymbol)
    dup exec.role_symbol::validate_encoding
    # => [role_symbol, pad(15)]

    exec.active_note::get_sender
    # => [sender_suffix, sender_prefix, role_symbol, pad(15)]

    movup.2
    # => [role_symbol, sender_suffix, sender_prefix, pad(13)]

    push.0.0
    # => [is_member=0, active_since=0, role_symbol, sender_suffix, sender_prefix, pad(13)]

    exec.set_membership_internal
    # => [pad(16)]
end

#! Sets the delay between granting a role and the grant becoming active.
#!
#! Applies to grants made after this call; pending and active members keep their activation
#! timestamps. The role does not need to exist. Pass `0` to make grants active immediately.
#!
#! Only the built-in `ADMIN` role may set grant delays, including for roles it does not
#! administer: a delegated admin can grant a role but cannot shorten the delay its grants are
#! subject to.
#!
#! Inputs:  [role_symbol, grant_delay, pad(14)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - role_symbol is the encoded role symbol to configure.
#! - grant_delay is the delay in seconds, or 0 for immediate activation.
#!
#! Panics if:
#! - role_symbol is not a valid role symbol encoding.
#! - the note sender does not hold the `ADMIN` role.
#! - grant_delay is not a u32.
#!
#! Invocation: call
@account_procedure
pub proc set_grant_delay(role_symbol: RoleSymbol, grant_delay: GrantDelay)
    dup exec.role_symbol::validate_encoding
    # => [role_symbol, grant_delay, pad(14)]

    exec.assert_sender_is_admin
    # => [role_symbol, grant_delay, pad(14)]

    # `u32assert` leaves its operand on the stack, so check a copy and discard it.
    dup.1 u32assert.err=ERR_GRANT_DELAY_NOT_U32 drop
    # => [role_symbol, grant_delay, pad(14)]

    dup exec.get_role_config
    # => [member_count, admin_role_symbol, old_grant_delay, role_symbol, grant_delay, pad(14)]

    movup.2 drop
    # => [member_count, admin_role_symbol, role_symbol, grant_delay, pad(14)]

    movup.2
    # => [role_symbol, member_count, admin_role_symbol, grant_delay, pad(14)]

    exec.set_role_config
    # => [pad(16)]
end

#! Returns the grant delay of a role.
#!
#! Returns `0` if the role has no config or no delay.
#!
#! Inputs:  [role_symbol, pad(15)]
#! Outputs: [grant_delay, pad(15)]
#!
#! Where:
#! - role_symbol is the encoded role symbol.
#! - grant_delay is the delay in seconds between a grant and its activation.
#!
#! Invocation: call
@account_procedure
pub proc get_grant_delay(role_symbol: RoleSymbol) -> GrantDelay
    exec.get_grant_delay_internal
    # => [grant_delay, pad(15)]
end

# PUBLIC HELPERS
# =================================================================================================

#! Checks that the note sender holds the given role.
#!
#! Inputs:  [role_symbol]
#! Outputs: []
#!
#! Where:
#! - role_symbol is the encoded role symbol.
#!
#! The symbol is not validated here. Callers pass either a compile-time constant or a value they
#! have already validated, and a non-canonical symbol can match no stored membership anyway, so it
#! fails the assertion below. `authority::assert_authorized_rbac`, the one caller that forwards a
#! symbol read from unvalidated storage, validates it before calling.
#!
#! Panics if:
#! - the note sender does not hold the given role.
#!
#! Invocation: exec
pub proc assert_sender_has_role(role_symbol: RoleSymbol)
    exec.is_sender_in_role
    # => [has_role]

    assert.err=ERR_SENDER_LACKS_ROLE
    # => []
end

#! Asserts the note sender holds the built-in ADMIN role.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Panics if:
#! - the note sender does not hold the ADMIN role.
#!
#! Invocation: exec
pub proc assert_sender_is_admin()
    push.ADMIN_ROLE exec.assert_sender_has_role
    # => []
end

# HELPER PROCEDURES
# =================================================================================================


#! Returns the config for a role.
#!
#! Inputs:  [role_symbol]
#! Outputs: [member_count, admin_role_symbol, grant_delay]
#!
#! Invocation: exec
proc get_role_config(role_symbol: RoleSymbol) -> RoleConfig
    push.0.0.0
    # => [0, 0, 0, role_symbol]

    push.ROLE_CONFIG_SLOT[0..2]
    # => [slot_suffix, slot_prefix, 0, 0, 0, role_symbol]

    exec.active_account::get_map_item
    # => [member_count, admin_role_symbol, grant_delay, 0]

    movup.3 drop
    # => [member_count, admin_role_symbol, grant_delay]
end

#! Returns the membership record of an account for a role.
#!
#! Inputs:  [role_symbol, account_suffix, account_prefix]
#! Outputs: [is_member, active_since]
#!
#! Where:
#! - is_member is 1 if the account has been granted the role (active or pending), otherwise 0.
#! - active_since is the reference block timestamp from which the membership counts.
#!
#! Invocation: exec
proc get_membership_internal(role_symbol: RoleSymbol, account: AccountId) -> Membership
    push.0
    # => [0, role_symbol, account_suffix, account_prefix]

    push.ROLE_MEMBERSHIP_SLOT[0..2]
    # => [slot_suffix, slot_prefix, 0, role_symbol, account_suffix, account_prefix]

    exec.active_account::get_map_item
    # => [is_member, active_since, 0, 0]

    movup.2 drop movup.2 drop
    # => [is_member, active_since]
end

#! Returns whether an account holds a role.
#!
#! A granted membership counts only once its activation timestamp has passed. `now` is the
#! reference block timestamp; an executor picking an older reference block can only make this
#! check stricter, so no expiration bound is needed here.
#!
#! Inputs:  [role_symbol, account_suffix, account_prefix]
#! Outputs: [has_role]
#!
#! Invocation: exec
proc has_role_internal(role_symbol: RoleSymbol, account: AccountId) -> Bool
    exec.get_membership_internal
    # => [is_member, active_since]

    swap exec.tx::get_block_timestamp
    # => [now, active_since, is_member]

    u32lte
    # => [is_active, is_member]

    and
    # => [has_role]
end

#! Returns the number of accounts assigned to a role.
#!
#! Inputs:  [role_symbol]
#! Outputs: [member_count]
#!
#! Invocation: exec
proc get_role_member_count_internal(role_symbol: RoleSymbol) -> RoleMemberCount
    exec.get_role_config
    # => [member_count, admin_role_symbol, grant_delay]

    swap drop swap drop
    # => [member_count]
end

#! Returns the delegated admin role for a role (0 if none).
#!
#! Inputs:  [role_symbol]
#! Outputs: [admin_role_symbol]
#!
#! Invocation: exec
proc get_role_admin_internal(role_symbol: RoleSymbol) -> RoleSymbol
    exec.get_role_config
    # => [member_count, admin_role_symbol, grant_delay]

    drop swap drop
    # => [admin_role_symbol]
end

#! Returns the grant delay of a role (0 if none).
#!
#! Inputs:  [role_symbol]
#! Outputs: [grant_delay]
#!
#! Invocation: exec
proc get_grant_delay_internal(role_symbol: RoleSymbol) -> GrantDelay
    exec.get_role_config
    # => [member_count, admin_role_symbol, grant_delay]

    drop drop
    # => [grant_delay]
end

#! Returns the timestamp from which a grant made in this transaction is active.
#!
#! When the delay is non-zero, caps the transaction's expiration delta to the default so the
#! reference block, and with it `now`, is at most that many blocks old. Without the cap an executor
#! could reference an old block and shorten the delay by an arbitrary amount.
#!
#! Inputs:  [grant_delay]
#! Outputs: [active_since]
#!
#! Panics if:
#! - `now + grant_delay` overflows u32.
#!
#! Invocation: exec
proc compute_active_since(grant_delay: GrantDelay) -> Timestamp
    dup neq.0
    if.true
        exec.expiration::apply_default
    end
    # => [grant_delay]

    exec.tx::get_block_timestamp add
    # => [active_since]

    u32assert.err=ERR_ACTIVATION_TIMESTAMP_OVERFLOW
    # => [active_since]
end

#! Returns whether the note sender holds a role.
#!
#! Inputs:  [role_symbol]
#! Outputs: [has_role]
#!
#! Invocation: exec
proc is_sender_in_role(role_symbol: RoleSymbol) -> Bool
    exec.active_note::get_sender
    # => [sender_suffix, sender_prefix, role_symbol]

    movup.2
    # => [role_symbol, sender_suffix, sender_prefix]

    exec.has_role_internal
    # => [has_role]
end

#! Returns the effective admin role for a role.
#!
#! The effective admin is the role's configured delegated admin (`admin_role_symbol`) when
#! set, otherwise the built-in `ADMIN` role.
#!
#! Inputs:  [role_symbol]
#! Outputs: [effective_admin_role_symbol]
#!
#! Invocation: exec
proc get_effective_role_admin(role_symbol: RoleSymbol) -> RoleSymbol
    exec.get_role_admin_internal
    # => [admin_role_symbol]

    dup eq.0
    # => [is_unset, admin_role_symbol]

    push.ADMIN_ROLE swap
    # => [is_unset, ADMIN_ROLE, admin_role_symbol]

    cdrop
    # => [effective_admin_role_symbol]
end

#! Asserts that the note sender is authorized to administer a role.
#!
#! Authority rests with the role's effective admin role: its configured delegated admin, or the
#! built-in `ADMIN` role when none is configured.
#!
#! A role whose only members are pending (granted, not yet active) counts as populated: `ADMIN`
#! is then locked out of the roles it administers until a grant activates. Nobody can act in that
#! window; revoking the pending grant restores the `ADMIN` fallback at any time.
#!
#! Inputs:  [role_symbol]
#! Outputs: []
#!
#! Panics if:
#! - the note sender holds neither the role's effective admin role nor, when that role is
#!   memberless, the `ADMIN` role.
#!
#! Invocation: exec
proc assert_sender_is_role_admin(role_symbol: RoleSymbol)
    exec.get_effective_role_admin
    # => [effective_admin_role_symbol]

    push.ADMIN_ROLE
    dup.1 exec.get_role_member_count_internal eq.0
    # => [is_memberless, admin_role, effective_admin_role_symbol]

    # A memberless effective admin cannot authorize anything, so fall back to the `ADMIN` role.
    cdrop
    # => [authorizing_role_symbol]

    exec.is_sender_in_role
    # => [has_admin_role]

    assert.err=ERR_SENDER_NOT_ROLE_ADMIN
    # => []
end

#! Writes the config word for a role.
#!
#! The trailing zero of the stored config word is appended internally so callers do not need to
#! push it themselves.
#!
#! Inputs:  [role_symbol, member_count, admin_role_symbol, grant_delay]
#! Outputs: []
#!
#! Invocation: exec
proc set_role_config(role_symbol: RoleSymbol, config: RoleConfig)
    push.0 movdn.4
    # => [role_symbol, member_count, admin_role_symbol, grant_delay, 0]

    push.0.0.0
    # => [0, 0, 0, role_symbol, member_count, admin_role_symbol, grant_delay, 0]

    push.ROLE_CONFIG_SLOT[0..2]
    # => [slot_suffix, slot_prefix, 0, 0, 0, role_symbol,
    #     member_count, admin_role_symbol, grant_delay, 0]

    exec.native_account::set_map_item
    # => [OLD_ROLE_CONFIG]

    dropw
    # => []
end

#! Internal helper shared by `grant_role`, `revoke_role`, and `renounce_role` to set or clear
#! an account's membership of a role and adjust the role's member count.
#!
#! The account ID is not validated here: `grant_role` (the only caller that adds a membership)
#! validates before calling, so every stored membership key is already valid, and a revoke of
#! an unknown key fails the membership assertion below regardless.
#!
#! Inputs:  [is_member, active_since, role_symbol, account_suffix, account_prefix]
#! Outputs: []
#!
#! Where:
#! - is_member is 1 to grant the role (the membership assertion is a no-op) or 0 to revoke it
#!   (the account must currently hold the role).
#! - active_since is the timestamp from which the granted membership counts; pass 0 when revoking.
#!
#! Panics if:
#! - is_member is 0 and the account does not currently hold the role.
#! - granting overflows the role's u32 member count.
#!
#! Invocation: exec
@locals(3)
proc set_membership_internal(
    is_member: Bool,
    active_since: Timestamp,
    role_symbol: RoleSymbol,
    account: AccountId
)
    # => [is_member, active_since, role_symbol, account_suffix, account_prefix]

    # Stash the membership record and role_symbol; all are needed after the map write.
    loc_store.MEMBERSHIP_FLAG_LOC
    # => [active_since, role_symbol, account_suffix, account_prefix]

    loc_store.ACTIVE_SINCE_LOC
    # => [role_symbol, account_suffix, account_prefix]

    dup loc_store.ROLE_SYMBOL_LOC
    # => [role_symbol, account_suffix, account_prefix]

    # Form the value word [is_member, active_since, 0, 0] on top of the key's leading zero.
    push.0.0 loc_load.ACTIVE_SINCE_LOC loc_load.MEMBERSHIP_FLAG_LOC
    # => [is_member, active_since, 0, 0, role_symbol, account_suffix, account_prefix]

    push.0 movdn.4
    # => [[is_member, active_since, 0, 0], 0, role_symbol, account_suffix, account_prefix]

    swapw
    # => [0, role_symbol, account_suffix, account_prefix, [is_member, active_since, 0, 0]]

    push.ROLE_MEMBERSHIP_SLOT[0..2]
    # => [slot_suffix, slot_prefix, 0, role_symbol, account_suffix, account_prefix,
    #     [is_member, active_since, 0, 0]]

    exec.native_account::set_map_item
    # => [OLD_MEMBERSHIP_WORD]

    # Reduce OLD_MEMBERSHIP_WORD to its first element, the previous membership flag.
    movdn.3 drop drop drop
    # => [old_is_member]

    # Branchless membership assertion: a no-op when granting (is_member = 1); when revoking
    # (is_member = 0) it requires that the account previously held the role.
    dup loc_load.MEMBERSHIP_FLAG_LOC or
    assert.err=ERR_ACCOUNT_NOT_IN_ROLE
    # => [old_is_member]

    # Membership delta = is_member - old_is_member: +1 on a fresh grant, 0 on a redundant
    # grant, -1 on a revoke. Computing the delta first means the redundant-grant case adds 0
    # and cannot spuriously trip the overflow assertion.
    neg loc_load.MEMBERSHIP_FLAG_LOC add
    # => [delta]

    loc_load.ROLE_SYMBOL_LOC exec.get_role_config
    # => [member_count, admin_role_symbol, grant_delay, delta]

    movup.3 add u32assert.err=ERR_MEMBER_COUNT_OVERFLOW
    # => [new_member_count, admin_role_symbol, grant_delay]

    loc_load.ROLE_SYMBOL_LOC
    # => [role_symbol, new_member_count, admin_role_symbol, grant_delay]

    exec.set_role_config
    # => []
end
