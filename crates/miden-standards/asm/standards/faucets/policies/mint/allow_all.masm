# Generic mint policy procedures shared by policy manager flows.

# POLICY PROCEDURES
# ================================================================================================

#! Mint policy that accepts every mint request.
#!
#! Invoked as the active mint policy via `TokenPolicyManager`, which applies the account-wide
#! pause check.
#!
#! Inputs:  [ASSET_VALUE, tag, note_type, RECIPIENT, pad(6)]
#! Outputs: [ASSET_VALUE, tag, note_type, RECIPIENT, pad(6)]
#!
#! Invocation: call
@account_procedure
pub proc check_policy
    push.0 drop
end
