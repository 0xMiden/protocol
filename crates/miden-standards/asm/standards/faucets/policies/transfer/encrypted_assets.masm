# miden::standards::faucets::policies::transfer::encrypted_assets
#
# Encrypted assets send policy: returns the encrypted asset attachment of each private output note
# holding the issuing faucet's assets, built by `miden::standards::attachments::encrypted_assets`.

use {
    NoteAttachmentCommitment,
    NoteAttachmentCount,
    NoteAttachmentListCommitment,
    NoteAttachmentScheme,
} from miden::protocol::types
use miden::core::crypto::hashes::eidos
use miden::standards::attachments::encrypted_assets

# POLICY PROCEDURES
# ================================================================================================

#! Send policy that returns the encrypted asset attachment of the output note.
#!
#! Returns no attachment for a public note. For a private note, encrypts the note's details to the
#! issuer key in the issuing faucet's storage (see `encrypted_assets::build_attachment`) and limits
#! the transaction's expiration to [`expiration::DEFAULT_EXPIRATION_BLOCK_DELTA`] blocks after the
#! reference block. A send policy that combines other checks with the attachment executes its
#! checks and then `exec`s this procedure with its own inputs, i.e. with the stack exactly
#! `[note_idx, pad(15)]`.
#!
#! Inputs:  [note_idx, pad(15)]
#! Outputs: [num_attachments, ATTACHMENT_LIST_COMMITMENT, pad(11)]
#!
#! Where:
#! - note_idx is the index of the output note being sealed.
#! - num_attachments is 1 for a private note, whose attachment list holds the encrypted asset
#!   attachment, and 0 for a public note.
#! - ATTACHMENT_LIST_COMMITMENT is the commitment to the attachment list for a private note and the
#!   empty word for a public note.
#!
#! Panics if:
#! - the note is private and its attachment cannot be built, e.g. because the advice map has no
#!   preimage for its recipient or the issuing faucet has no issuer key.
#!
#! Invocation: call
@account_procedure
pub proc check_send_policy(note_idx: u16) -> (NoteAttachmentCount, NoteAttachmentListCommitment)
    exec.encrypted_assets::build_attachment
    # => [attachment_scheme, ATTACHMENT_COMMITMENT, pad(15)]

    exec.single_attachment_list
    # => [num_attachments, ATTACHMENT_LIST_COMMITMENT, pad(15)]

    movupw.3 dropw
    # => [num_attachments, ATTACHMENT_LIST_COMMITMENT, pad(11)]
end

# HELPER PROCEDURES
# ================================================================================================

# TODO: replace with `miden::protocol::output_note::single_attachment_list` once it is available.
#! Returns the attachment list that holds the provided attachment and inserts the list into the
#! advice map under its commitment.
#!
#! The list holds the single entry `[attachment_scheme, 0, 0, 0, ATTACHMENT_COMMITMENT]`. Attachment
#! scheme 0 with the empty word, which `build_attachment` returns for a public note, represents no
#! attachment, for which the procedure returns 0 attachments and the empty word.
#!
#! Inputs:  [attachment_scheme, ATTACHMENT_COMMITMENT]
#! Outputs: [num_attachments, ATTACHMENT_LIST_COMMITMENT]
#!
#! Invocation: exec
proc single_attachment_list(
    attachment_scheme: NoteAttachmentScheme,
    attachment_commitment: NoteAttachmentCommitment
) -> (NoteAttachmentCount, NoteAttachmentListCommitment)
    dup neq.0
    # => [has_attachment, attachment_scheme, ATTACHMENT_COMMITMENT]

    if.true
        # the list entry is the attachment scheme padded to a word, followed by the commitment
        push.0.0.0 movup.3
        # => [attachment_scheme, 0, 0, 0, ATTACHMENT_COMMITMENT]

        adv.insert_hdword exec.eidos::hash_double_word
        # => [ATTACHMENT_LIST_COMMITMENT]

        push.1
        # => [num_attachments, ATTACHMENT_LIST_COMMITMENT]
    end
    # => [num_attachments, ATTACHMENT_LIST_COMMITMENT]
end
