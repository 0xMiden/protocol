# miden::standards::faucets::policies::transfer::encrypted_assets
#
# Encrypted assets send policy: returns the encrypted asset attachment of each private output note
# holding the issuing faucet's assets, built by `miden::standards::attachments::encrypted_assets`,
# and rejects a private note that holds more than one asset.

use {NoteAttachmentCount, NoteAttachmentListCommitment} from miden::protocol::types
use {ENCRYPTED_ASSETS_ATTACHMENT_SCHEME} from miden::standards::attachments::encrypted_assets
use miden::protocol::output_note
use miden::standards::attachments::encrypted_assets

# ERRORS
# ================================================================================================

const ERR_ENCRYPTED_ASSETS_NOTE_HAS_MULTIPLE_ASSETS = "private note with an encrypted asset attachment cannot hold more than one asset"

# POLICY PROCEDURES
# ================================================================================================

#! Send policy that returns the encrypted asset attachment of the output note.
#!
#! Returns no attachment for a public note. For a private note, encrypts the note's details to the
#! issuer key in the issuing faucet's storage (see `encrypted_assets::build_attachment`) and limits
#! the transaction's expiration to [`expiration::DEFAULT_EXPIRATION_BLOCK_DELTA`] blocks after the
#! reference block. A private note may hold only one asset, since the attachment holds all of the
#! note's assets and would show the assets of other faucets to the issuer. A send policy that
#! combines other checks with the attachment executes its checks and then `exec`s this procedure
#! with its own inputs, i.e. with the stack exactly `[note_idx, pad(15)]`.
#!
#! Inputs:  [note_idx, pad(15)]
#! Outputs: [num_attachments, ATTACHMENT_LIST_COMMITMENT, pad(11)]
#!
#! Where:
#! - note_idx is the index of the output note being sealed.
#! - num_attachments is 1 for a private note, whose attachment list holds the encrypted asset
#!   attachment, and 0 for a public note.
#! - ATTACHMENT_LIST_COMMITMENT is the commitment to the attachment list for a private note and the
#!   empty word for a public note.
#!
#! Panics if:
#! - the note is private and its attachment cannot be built, e.g. because the advice map has no
#!   preimage for its recipient or the issuing faucet has no issuer key.
#! - the note is private and holds more than one asset.
#!
#! Invocation: call
@account_procedure
pub proc check_send_policy(note_idx: u16) -> (NoteAttachmentCount, NoteAttachmentListCommitment)
    dup exec.encrypted_assets::build_attachment
    # => [attachment_scheme, ATTACHMENT_COMMITMENT, note_idx, pad(15)]

    # only a private note gets the attachment
    dup eq.ENCRYPTED_ASSETS_ATTACHMENT_SCHEME
    # => [has_attachment, attachment_scheme, ATTACHMENT_COMMITMENT, note_idx, pad(15)]

    if.true
        dup.5 exec.output_note::get_assets_info dropw
        # => [num_assets, attachment_scheme, ATTACHMENT_COMMITMENT, note_idx, pad(15)]

        u32lte.1 assert.err=ERR_ENCRYPTED_ASSETS_NOTE_HAS_MULTIPLE_ASSETS
        # => [attachment_scheme, ATTACHMENT_COMMITMENT, note_idx, pad(15)]
    end
    # => [attachment_scheme, ATTACHMENT_COMMITMENT, note_idx, pad(15)]

    exec.output_note::single_attachment_list
    # => [num_attachments, ATTACHMENT_LIST_COMMITMENT, note_idx, pad(15)]

    movup.5 drop movupw.3 dropw
    # => [num_attachments, ATTACHMENT_LIST_COMMITMENT, pad(11)]
end
