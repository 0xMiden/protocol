use miden::protocol::native_account
use miden::standards::faucets::restrictions::blocklist

# POLICY PROCEDURES
# ================================================================================================

#! Transfer policy that rejects transfers whose native account is blocked on the issuing faucet.
#!
#! Reads the native account ID via `native_account::get_id` (the asset recipient when invoked
#! from `on_before_asset_added_to_account`, or the note creator when invoked from
#! `on_before_asset_added_to_note`) and asserts it is not blocked using the issuing faucet's
#! own `blocklist` storage.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Panics if:
#! - the native account is blocked on the issuing faucet.
#!
#! Invocation: dynexec
pub proc check_policy
    exec.native_account::get_id
    # => [account_id_suffix, account_id_prefix]

    exec.blocklist::assert_not_blocked
    # => []
end
