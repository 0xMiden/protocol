use {Asset, NoteAttachmentCommitment, NoteAttachmentScheme} from miden::protocol::types
# Generic transfer policy procedures shared by policy manager flows.

# POLICY PROCEDURES
# ================================================================================================

#! Send policy that accepts every output note and returns no attachment for it.
#!
#! Invoked as the active send policy via `TokenPolicyManager`, which limits the transaction's
#! expiration and applies the account-wide pause check.
#!
#! Inputs:  [note_idx, pad(15)]
#! Outputs: [attachment_reserved_scheme, EMPTY_WORD, pad(11)]
#!
#! Where:
#! - note_idx is the index of the output note being sealed.
#! - attachment_reserved_scheme is 0, the attachment scheme the kernel reserves to signal that no
#!   attachment is returned.
#!
#! Invocation: call
@account_procedure
pub proc check_send_policy(note_idx: u16) -> (NoteAttachmentScheme, NoteAttachmentCommitment)
    drop
    # => [attachment_reserved_scheme, EMPTY_WORD, pad(11)]
end

#! Receive policy that accepts every asset.
#!
#! Invoked as the active receive policy via `TokenPolicyManager`, which limits the transaction's
#! expiration and applies the account-wide pause check.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, pad(8)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ASSET_ID and ASSET_VALUE are the ID and value of the asset being added to the native
#!   account's vault.
#!
#! Invocation: call
@account_procedure
pub proc check_receive_policy(asset: Asset)
    dropw dropw
    # => [pad(16)]
end
