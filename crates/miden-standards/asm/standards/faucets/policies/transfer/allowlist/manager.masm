# miden::standards::faucets::policies::transfer::allowlist::manager
#
# Authority-gated allowlist admin: wraps the `Invocation: exec` helpers from
# `miden::standards::faucets::policies::transfer::allowlist` with the account-wide `Authority`
# component via `exec.authority::assert_authorized` — the same pattern that `PausableManager` and
# `TokenPolicyManager::set_*_policy` use. This makes a single manager work uniformly with
# `Authority::OwnerControlled` (Ownable2Step owner), `Authority::AuthControlled` (account auth
# scheme), and `Authority::RbacControlled` (per-procedure roles: `allow_account` and
# `disallow_account` can share one role, e.g. an ALLOWLISTER role, or be gated by distinct roles).
#
# Companion components required on the faucet:
# - `Authority` — provides the auth dispatch the body calls into.
# - `BasicAllowlist` (or any other component that installs the `allowed_accounts` storage slot)
#   — provides the storage that `allow_account` / `disallow_account` write to.

use miden::standards::access::authority
use miden::standards::faucets::policies::transfer::allowlist

# PUBLIC INTERFACE
# ================================================================================================

#! Allow an account, gated by the account-wide `Authority` component.
#!
#! Inputs:  [account_id_suffix, account_id_prefix, pad(14)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the caller is not authorized per the installed `Authority` component.
#!
#! Invocation: call
@account_procedure
pub proc allow_account
    exec.authority::assert_authorized
    # => [account_id_suffix, account_id_prefix, pad(14)]

    exec.allowlist::allow_account
    # => [pad(16)]
end

#! Disallow an account, gated by the account-wide `Authority` component.
#!
#! Inputs:  [account_id_suffix, account_id_prefix, pad(14)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the caller is not authorized per the installed `Authority` component.
#!
#! Invocation: call
@account_procedure
pub proc disallow_account
    exec.authority::assert_authorized
    # => [account_id_suffix, account_id_prefix, pad(14)]

    exec.allowlist::disallow_account
    # => [pad(16)]
end
