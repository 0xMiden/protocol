use {Asset} from miden::protocol::types
# miden::standards::faucets::policies::transfer::basic_allowlist
#
# Basic allowlist transfer policy: rejects transfers whose native account is not allowed on the
# issuing faucet. Delegates the per-account state to the sibling `allowlist` primitive
# (storage + helpers).
#
# The issuing faucet is exempt from its own allowlist, so the list only ever governs third-party
# transfers.

use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::native_account
use miden::standards::faucets::policies::transfer::allowlist
use miden::standards::expiration

# POLICY PROCEDURES
# ================================================================================================

#! Send policy that rejects output notes created by an account that is not allowed on the
#! issuing faucet.
#!
#! Limits the transaction's expiration to [`expiration::DEFAULT_EXPIRATION_BLOCK_DELTA`] blocks
#! after the reference block.
#!
#! Inputs:  [note_idx, pad(15)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - note_idx is the index of the output note being sealed.
#!
#! Panics if:
#! - the native account is not allowed on the issuing faucet and is not the issuing faucet
#!   itself.
#!
#! Invocation: call
@account_procedure
pub proc check_send_policy(note_idx: u16)
    exec.expiration::apply_default
    # => [note_idx, pad(15)]

    exec.assert_native_account_allowed
    # => [note_idx, pad(15)]

    drop
    # => [pad(16)]
end

#! Receive policy that rejects assets added to the vault of an account that is not allowed on the
#! issuing faucet.
#!
#! Limits the transaction's expiration to [`expiration::DEFAULT_EXPIRATION_BLOCK_DELTA`] blocks
#! after the reference block.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, pad(8)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ASSET_ID and ASSET_VALUE are the ID and value of the asset being added to the native
#!   account's vault.
#!
#! Panics if:
#! - the native account is not allowed on the issuing faucet and is not the issuing faucet
#!   itself.
#!
#! Invocation: call
@account_procedure
pub proc check_receive_policy(asset: Asset)
    exec.expiration::apply_default
    # => [ASSET_ID, ASSET_VALUE, pad(8)]

    exec.assert_native_account_allowed
    # => [ASSET_ID, ASSET_VALUE, pad(8)]

    dropw dropw
    # => [pad(16)]
end

# HELPER PROCEDURES
# ================================================================================================

#! Asserts that the native account is allowed on the issuing faucet, which is the active
#! account while an asset callback runs. The issuing faucet itself is exempt.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Panics if:
#! - the native account is not allowed on the issuing faucet and is not the issuing faucet
#!   itself.
#!
#! Invocation: exec
proc assert_native_account_allowed
    exec.native_account::get_id
    # => [account_id_suffix, account_id_prefix]

    dup.1 dup.1 exec.active_account::get_id exec.account_id::eq
    # => [is_issuer, account_id_suffix, account_id_prefix]

    # the issuing faucet is exempt
    if.true
        drop drop
        # => []
    else
        exec.allowlist::assert_allowed
        # => []
    end
end
