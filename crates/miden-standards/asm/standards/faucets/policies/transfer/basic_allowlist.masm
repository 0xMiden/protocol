# miden::standards::faucets::policies::transfer::basic_allowlist
#
# Basic allowlist transfer policy: rejects transfers whose native account is not allowed on the
# issuing faucet. Delegates the per-account state to the sibling `allowlist` primitive
# (storage + helpers).
#
# The issuing faucet is exempt from its own allowlist, so the list only ever governs third-party
# transfers.

use miden::protocol::account_id
use miden::protocol::asset
use miden::protocol::native_account
use miden::standards::faucets::policies::transfer::allowlist
use miden::standards::fpi
use {DEFAULT_EXPIRATION_BLOCK_DELTA} from miden::standards::fpi

# POLICY PROCEDURES
# ================================================================================================

#! Transfer policy that rejects transfers whose native account is not allowed on the issuing
#! faucet.
#!
#! The same procedure root is reusable as both send and receive policy because it does not depend
#! on custom_data.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, custom_data, pad(7)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - custom_data is `0` for the receive (account) callback and the output note index for the
#!   send (note) callback. This policy does not inspect it.
#!
#! Panics if:
#! - the native account is not allowed on the issuing faucet and is not the issuing faucet
#!   itself.
#!
#! Invocation: call
@account_procedure
@fpi
pub proc check_policy
    push.DEFAULT_EXPIRATION_BLOCK_DELTA exec.fpi::enforce_expiration_block_delta

    exec.asset::id_into_faucet_id
    # => [faucet_id_suffix, faucet_id_prefix, ASSET_VALUE, custom_data, pad(7)]

    exec.native_account::get_id
    # => [account_id_suffix, account_id_prefix, faucet_id_suffix, faucet_id_prefix, ASSET_VALUE,
    #     custom_data, pad(7)]

    dupw exec.account_id::eq
    # => [is_issuer, account_id_suffix, account_id_prefix, faucet_id_suffix, faucet_id_prefix,
    #     ASSET_VALUE, custom_data, pad(7)]

    # the issuing faucet is exempt
    not
    # => [should_check_allowlist, account_id_suffix, account_id_prefix, faucet_id_suffix,
    #     faucet_id_prefix, ASSET_VALUE, custom_data, pad(7)]

    if.true
        # drop the faucet ID, keeping the native account ID for the allowlist lookup
        movup.3 drop movup.2 drop
        # => [account_id_suffix, account_id_prefix, ASSET_VALUE, custom_data, pad(7)]

        exec.allowlist::assert_allowed
        # => [ASSET_VALUE, custom_data, pad(7)]
    else
        dropw
        # => [ASSET_VALUE, custom_data, pad(7)]
    end
    # => [ASSET_VALUE, custom_data, pad(7)]

    dropw drop
    # => [pad(16)]
end
