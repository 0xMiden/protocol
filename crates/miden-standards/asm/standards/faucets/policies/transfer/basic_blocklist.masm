use {Asset, NoteAttachmentCount, NoteAttachmentListCommitment} from miden::protocol::types
# miden::standards::faucets::policies::transfer::basic_blocklist
#
# Basic blocklist transfer policy: rejects transfers whose native account is blocked on the
# issuing faucet. Delegates the per-account state to the sibling `blocklist` primitive
# (storage + helpers).
#
# The issuing faucet is exempt from its own blocklist, so the list only ever governs third-party
# transfers.

use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::native_account
use miden::standards::faucets::policies::transfer::blocklist
use miden::standards::expiration

# POLICY PROCEDURES
# ================================================================================================

#! Send policy that rejects output notes created by an account that is blocked on the issuing
#! faucet, and returns no attachment for the accepted ones.
#!
#! Limits the transaction's expiration to [`expiration::DEFAULT_EXPIRATION_BLOCK_DELTA`] blocks
#! after the reference block.
#!
#! Inputs:  [note_idx, pad(15)]
#! Outputs: [0, EMPTY_WORD, pad(11)]
#!
#! Where:
#! - note_idx is the index of the output note being sealed.
#! - 0 is the number of attachments returned for the note, so the attachment list commitment is
#!   EMPTY_WORD.
#!
#! Panics if:
#! - the native account is blocked on the issuing faucet and is not the issuing faucet itself.
#!
#! Invocation: call
@account_procedure
pub proc check_send_policy(note_idx: u16) -> (NoteAttachmentCount, NoteAttachmentListCommitment)
    exec.check_native_account
    # => [note_idx, pad(15)]

    drop
    # => [0, EMPTY_WORD, pad(11)]
end

#! Receive policy that rejects assets added to the vault of an account that is blocked on the
#! issuing faucet.
#!
#! Limits the transaction's expiration to [`expiration::DEFAULT_EXPIRATION_BLOCK_DELTA`] blocks
#! after the reference block.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, pad(8)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ASSET_ID and ASSET_VALUE are the ID and value of the asset being added to the native
#!   account's vault.
#!
#! Panics if:
#! - the native account is blocked on the issuing faucet and is not the issuing faucet itself.
#!
#! Invocation: call
@account_procedure
pub proc check_receive_policy(asset: Asset)
    exec.check_native_account
    # => [ASSET_ID, ASSET_VALUE, pad(8)]

    dropw dropw
    # => [pad(16)]
end

# PUBLIC HELPERS
# ================================================================================================

#! Limits the transaction's expiration to [`expiration::DEFAULT_EXPIRATION_BLOCK_DELTA`] blocks
#! after the reference block and asserts that the native account is not blocked on the issuing
#! faucet.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Panics if:
#! - the native account is blocked on the issuing faucet and is not the issuing faucet itself.
#!
#! Invocation: exec
proc check_native_account
    exec.expiration::apply_default
    # => []

    exec.assert_native_account_not_blocked
    # => []
end

#! Asserts that the native account is not blocked on the issuing faucet, which is the active
#! account while an asset callback runs. The issuing faucet itself is exempt.
#!
#! The send and receive policies run this check, and a send policy that combines it with other
#! checks can `exec` it. It does not limit the transaction's expiration, so such a policy applies
#! [`expiration::apply_default`] first, as the send and receive policies do.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Panics if:
#! - the native account is blocked on the issuing faucet and is not the issuing faucet itself.
#!
#! Invocation: exec
pub proc assert_native_account_not_blocked()
    exec.native_account::get_id
    # => [account_id_suffix, account_id_prefix]

    dup.1 dup.1 exec.active_account::get_id exec.account_id::eq
    # => [is_issuer, account_id_suffix, account_id_prefix]

    # the issuing faucet is exempt
    if.true
        drop drop
        # => []
    else
        exec.blocklist::assert_not_blocked
        # => []
    end
end
