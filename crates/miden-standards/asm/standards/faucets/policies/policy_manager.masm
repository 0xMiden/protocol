    dupw
    push.ALLOWED_BURN_POLICY_PROC_ROOTS_SLOT[0..2]
    exec.active_account::get_map_item
    # => [ALLOWED_FLAG, BURN_POLICY_ROOT]

    exec.word::eqz
    assertz.err=ERR_BURN_POLICY_ROOT_NOT_ALLOWED
    # => [BURN_POLICY_ROOT]
