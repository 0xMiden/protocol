use {MetadataStringCommitment, TokenSymbol} from miden::standards::faucets
use {Asset, Bool, NoteRecipient, NoteTag, NoteType, StorageMapKey} from miden::protocol::types
# miden::standards::faucets::non_fungible
#
# Non-fungible (NFT) faucet logic: the token symbol slot and accessor, an asset-status registry
# keyed by the token ID, the token base URI and its setter, and the `mint_and_send` /
# `receive_and_burn` procedures wrapping the active mint/burn policies from the
# `TokenPolicyManager`.
#
# Identity model (an off-chain convention, not an enforced property): the asset value is an opaque
# word supplied by the caller, expected to be the off-chain commitment `hash(user_data, salt)`.
# The faucet never sees `user_data` or `salt` and validates nothing about the value: it is not
# checked to be a hash output, to have been salted, or to be backed by a preimage the caller
# knows. A value copied from another party's published commitment is accepted identically to a
# correctly constructed one. The binding between a value and its `user_data` must be verified
# off-chain by whoever relies on it; a minted asset value is not an attestation the faucet has
# validated.
#
# The protocol derives the asset ID's asset class from the value's first two elements. For an NFT
# faucet every asset has a unique class, so that class is really a unique identifier of each NFT
# within the faucet - its token ID. This file therefore calls those two elements
# (token_id_suffix, token_id_prefix).
#
# What the faucet does enforce is token ID uniqueness, via the status registry keyed by
# `[token_id_suffix, token_id_prefix, 0, 0]`: a token ID can be issued at most once and, once
# burned, is permanently consumed. The key covers only the first two elements, so two values
# differing only in elements 2 and 3 share a token ID and only the first can ever be issued.
# Deciding which values may be issued is the mint policy's job: the policy hook receives the full
# asset value, so a faucet that needs issuance restricted must install a policy that enforces it.
# Under a permissive policy such as `allow_all`, any caller can claim any token ID, permanently
# consuming a commitment another party intended to mint.
#
# Shared token metadata (name, description, logo_uri, external_link) lives in the parent
# `miden::standards::faucets` namespace. The token base URI is specific to non-fungible faucets: a
# non-empty value makes the faucet's token metadata public, an empty one private, and the setter
# cannot switch between the two.

use miden::core::mem
use miden::core::word
use miden::protocol::active_account
use miden::protocol::faucet
use miden::protocol::native_account
use miden::protocol::output_note
use miden::standards::access::authority
use miden::standards::access::pausable
use miden::standards::assets::non_fungible_asset
use miden::standards::faucets::policies::policy_manager

pub type TokenId = struct { suffix: felt, prefix: felt }
pub type TokenStatus = u8
pub type TokenStatusValue = struct {
    status: TokenStatus,
    padding: [felt; 3]
}

# =================================================================================================
# CONSTANTS — slot names
# =================================================================================================

pub const SYMBOL_SLOT = word("miden::standards::faucets::non_fungible::symbol")
pub const ASSET_STATUS_SLOT = word("miden::standards::faucets::non_fungible::asset_status")
const MUTABILITY_CONFIG_SLOT = word("miden::standards::faucets::non_fungible::mutability_config")

const TOKEN_BASE_URI_0_SLOT = word("miden::standards::faucets::non_fungible::token_base_uri_0")
const TOKEN_BASE_URI_1_SLOT = word("miden::standards::faucets::non_fungible::token_base_uri_1")
const TOKEN_BASE_URI_2_SLOT = word("miden::standards::faucets::non_fungible::token_base_uri_2")
const TOKEN_BASE_URI_3_SLOT = word("miden::standards::faucets::non_fungible::token_base_uri_3")
const TOKEN_BASE_URI_4_SLOT = word("miden::standards::faucets::non_fungible::token_base_uri_4")
const TOKEN_BASE_URI_5_SLOT = word("miden::standards::faucets::non_fungible::token_base_uri_5")
const TOKEN_BASE_URI_6_SLOT = word("miden::standards::faucets::non_fungible::token_base_uri_6")

# =================================================================================================
# CONSTANTS — status values, memory & errors
# =================================================================================================

# Asset status codes stored at element 0 of the status registry value.
const STATUS_ISSUED = 1
const STATUS_BURNED = 2

# The local memory address holding the asset value across the mint flow.
const ASSET_VALUE_LOCAL = 0

# The local memory address at which the MINT note's ASSET_ID is held across the mint policy and
# status registry updates in `mint_and_send`. It is compared against the asset derived for the
# active faucet, which binds the mint to the faucet the MINT note was created for.
const MINT_ASSET_ID_LOCAL = 4

# The number of words a metadata string such as the token base URI is stored in.
const METADATA_STRING_NUM_WORDS = 7

# Masks the first byte of a metadata string's first element, which holds the string's byte length.
const STRING_LENGTH_MASK = 0xff

const ERR_NFT_ALREADY_ISSUED = "asset commitment has already been issued"
const ERR_NFT_NOT_ISSUED = "asset is not in the issued state"
const ERR_NFT_MINT_POLICY_MODIFIED_ASSET_VALUE = "mint policy must not modify the asset value"
const ERR_MINT_NOTE_ASSET_NOT_FROM_THIS_FAUCET = "the asset stored in the MINT note does not belong to this faucet"
const ERR_TOKEN_BASE_URI_NOT_MUTABLE = "token base URI is not mutable"
const ERR_TOKEN_METADATA_IS_PRIVATE = "token base URI cannot be set on a faucet with private token metadata"
const ERR_TOKEN_BASE_URI_CANNOT_BE_CLEARED = "token base URI cannot be cleared"

# =================================================================================================
# PRIVATE HELPERS
# =================================================================================================

#! Builds the asset-status registry key from a token ID.
#!
#! Inputs:  [token_id_suffix, token_id_prefix]
#! Outputs: [STATUS_KEY]
#!
#! Where:
#! - STATUS_KEY is `[token_id_suffix, token_id_prefix, 0, 0]`. The trailing zeros ensure two asset
#!   values that collide in their first two elements cannot produce two distinct status keys.
#!
#! Invocation: exec
proc create_status_key(token_id: TokenId) -> StorageMapKey
    push.0 push.0
    # => [0, 0, token_id_suffix, token_id_prefix]

    movdn.3 movdn.3
    # => [token_id_suffix, token_id_prefix, 0, 0]
end

#! Builds a status registry value word from a status code.
#!
#! Inputs:  [status]
#! Outputs: [STATUS_VALUE]
#!
#! Where:
#! - STATUS_VALUE is `[status, 0, 0, 0]`.
#!
#! Invocation: exec
proc build_status_value(status: TokenStatus) -> TokenStatusValue
    push.0 push.0 push.0
    # => [0, 0, 0, status]

    movup.3
    # => [status, 0, 0, 0]
end

#! Reads the status registered for a status key from the asset-status registry.
#!
#! Inputs:  [STATUS_KEY]
#! Outputs: [status]
#!
#! Where:
#! - status is the first element of the registry value word; the other elements are always zero.
#!
#! Invocation: exec
proc get_status_by_key(status_key: StorageMapKey) -> TokenStatus
    push.ASSET_STATUS_SLOT[0..2]
    exec.active_account::get_map_item
    # => [status, 0, 0, 0]

    movdn.3 drop drop drop
    # => [status]
end

#! Extracts the is_token_base_uri_mutable flag from the non-fungible faucet's mutability config
#! word.
#!
#! Inputs:  []
#! Outputs: [is_token_base_uri_mutable]
#!
#! Invocation: exec
proc is_token_base_uri_mutable_internal() -> Bool
    push.MUTABILITY_CONFIG_SLOT[0..2] exec.active_account::get_item
    # => [is_token_base_uri_mutable, 0, 0, 0]

    movdn.3 drop drop drop
    # => [is_token_base_uri_mutable]
end

#! Returns the byte length of a metadata string, read from the string's first element.
#!
#! Metadata strings are length-prefixed: the first byte of the first element is the length.
#!
#! Inputs:  [first_element]
#! Outputs: [length]
#!
#! Invocation: exec
proc get_string_length(first_element: felt) -> u8
    u32split
    # => [first_element_lo, first_element_hi]

    swap drop
    # => [first_element_lo]

    u32and.STRING_LENGTH_MASK
    # => [length]
end

# =================================================================================================
# PUBLIC API — SYMBOL
# =================================================================================================

#! Returns the token symbol (single felt).
#!
#! Inputs:  [pad(16)]
#! Outputs: [symbol, pad(15)]
#!
#! Invocation: call
@account_procedure
pub proc get_symbol() -> TokenSymbol
    push.SYMBOL_SLOT[0..2] exec.active_account::get_item
    # => [symbol, 0, 0, 0, pad(16)]

    movdn.4 dropw
    # => [symbol, pad(15)]
end

# =================================================================================================
# PUBLIC API — ASSET STATUS
# =================================================================================================

#! Returns the status registered for a token ID.
#!
#! Inputs:  [token_id_suffix, token_id_prefix, pad(14)]
#! Outputs: [status, pad(15)]
#!
#! Where:
#! - token_id_suffix, token_id_prefix are the first two elements of the asset value.
#! - status is 0 if not issued, 1 if issued, 2 if burned.
#!
#! Invocation: call
@account_procedure
pub proc get_asset_status(token_id: TokenId) -> TokenStatus
    exec.create_status_key
    # => [STATUS_KEY, pad(14)]

    exec.get_status_by_key
    # => [status, pad(15)]
end

# =================================================================================================
# PUBLIC API — TOKEN BASE URI
# =================================================================================================

#! Returns 1 if the token base URI is mutable, and 0 otherwise.
#!
#! Inputs:  [pad(16)]
#! Outputs: [is_token_base_uri_mutable, pad(15)]
#!
#! Invocation: call
@account_procedure
pub proc is_token_base_uri_mutable() -> Bool
    exec.is_token_base_uri_mutable_internal
    # => [is_token_base_uri_mutable, pad(16)]

    swap drop
    # => [is_token_base_uri_mutable, pad(15)]
end

#! Updates the token base URI (7 Words) if the token base URI mutability flag is 1 and the caller
#! satisfies the account-wide [`Authority`] configuration.
#!
#! Whether the faucet's token metadata is public (non-empty token base URI) or private (empty) is
#! fixed at creation, so both the current and the new token base URI must be non-empty.
#!
#! The caller passes the Poseidon2 hash of the new token base URI on the stack and provides the
#! actual 7 Words in the advice map under that hash. The hash is verified against the preimage
#! during loading.
#!
#! Inputs:
#!   Operand stack: [TOKEN_BASE_URI_HASH, pad(12)]
#!   Advice map: {
#!     TOKEN_BASE_URI_HASH: [token_base_uri_elements],
#!   }
#! Outputs:
#!   Operand stack: [pad(16)]
#!
#! Where:
#! - token_base_uri_elements are 28 felts (7 Words) encoding the token base URI.
#!
#! Panics if:
#! - the token base URI mutability flag is not 1.
#! - the caller is not authorized per the installed [`Authority`].
#! - the faucet is paused.
#! - the preimage does not match TOKEN_BASE_URI_HASH.
#! - the current token base URI is empty, i.e. the faucet's token metadata is private.
#! - the new token base URI is empty.
#!
#! Invocation: call
@locals(28)
@account_procedure
pub proc set_token_base_uri(token_base_uri_hash: MetadataStringCommitment)
    exec.is_token_base_uri_mutable_internal
    # => [is_token_base_uri_mutable, TOKEN_BASE_URI_HASH, pad(12)]

    assert.err=ERR_TOKEN_BASE_URI_NOT_MUTABLE
    # => [TOKEN_BASE_URI_HASH, pad(12)]

    exec.authority::assert_authorized
    # => [TOKEN_BASE_URI_HASH, pad(12)]

    exec.pausable::assert_not_paused
    # => [TOKEN_BASE_URI_HASH, pad(12)]

    # pipe the new value from the advice map into local words 0-6, validating the hash
    adv.push_mapval
    locaddr.0 push.METADATA_STRING_NUM_WORDS
    # => [num_words, write_ptr, TOKEN_BASE_URI_HASH, pad(12)]

    exec.mem::pipe_preimage_to_memory drop
    # => [pad(16)]

    # the token metadata mode is fixed at creation: the setter can neither make private token
    # metadata public nor clear the base URI of public token metadata
    push.TOKEN_BASE_URI_0_SLOT[0..2] exec.active_account::get_item
    # => [CURRENT_TOKEN_BASE_URI_0, pad(16)]

    movdn.3 drop drop drop
    # => [current_first_element, pad(16)]

    exec.get_string_length neq.0 assert.err=ERR_TOKEN_METADATA_IS_PRIVATE
    # => [pad(16)]

    loc_load.0
    # => [new_first_element, pad(16)]

    exec.get_string_length neq.0 assert.err=ERR_TOKEN_BASE_URI_CANNOT_BE_CLEARED
    # => [pad(16)]

    loc_loadw_le.0
    push.TOKEN_BASE_URI_0_SLOT[0..2]
    exec.native_account::set_item dropw

    loc_loadw_le.4
    push.TOKEN_BASE_URI_1_SLOT[0..2]
    exec.native_account::set_item dropw

    loc_loadw_le.8
    push.TOKEN_BASE_URI_2_SLOT[0..2]
    exec.native_account::set_item dropw

    loc_loadw_le.12
    push.TOKEN_BASE_URI_3_SLOT[0..2]
    exec.native_account::set_item dropw

    loc_loadw_le.16
    push.TOKEN_BASE_URI_4_SLOT[0..2]
    exec.native_account::set_item dropw

    loc_loadw_le.20
    push.TOKEN_BASE_URI_5_SLOT[0..2]
    exec.native_account::set_item dropw

    loc_loadw_le.24
    push.TOKEN_BASE_URI_6_SLOT[0..2]
    exec.native_account::set_item dropw
    # => [pad(16)]
end

# =================================================================================================
# MINT AND SEND
# =================================================================================================

#! Mints a non-fungible asset for the provided asset value and sends it to the recipient.
#!
#! ASSET_VALUE is accepted opaquely. The caller is expected to pass the off-chain commitment
#! `hash(user_data, salt)`, but this procedure validates neither that construction nor knowledge
#! of a preimage - any word is accepted. Restricting which values may be minted is the active
#! mint policy's responsibility; the policy receives the full asset value.
#!
#! The active mint policy runs over the asset value, the token ID derived from it is marked issued
#! in the status registry (asserting it was not already issued), and an output note carrying the
#! asset is created. The asset minted is derived for the active faucet; the `ASSET_ID` stored in
#! the MINT note must equal it, so a MINT note created for one faucet cannot be minted by another
#! faucet.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, tag, note_type, RECIPIENT, pad(2)]
#! Outputs: [note_idx, pad(15)]
#!
#! Where:
#! - ASSET_ID is the asset ID of the asset to mint. It must equal the ID derived for the active
#!   account from ASSET_VALUE, which implies its faucet ID is the active account.
#! - ASSET_VALUE is the asset value, by convention an off-chain commitment. It is validated only
#!   by the active mint policy.
#! - tag, note_type configure the output note.
#! - RECIPIENT is the recipient of the asset.
#! - note_idx is the index of the created note.
#!
#! Panics if:
#! - the active mint policy validation fails.
#! - the active mint policy modified the tag, note_type, or RECIPIENT.
#! - the faucet is paused.
#! - the token ID derived from ASSET_VALUE has already been issued.
#! - the asset stored in the MINT note does not belong to this faucet.
#!
#! Invocation: call
@locals(8)
@account_procedure
pub proc mint_and_send(
    asset: Asset,
    tag: NoteTag,
    note_type: NoteType,
    recipient: NoteRecipient
) -> u16
    # save the MINT note's ASSET_ID
    loc_storew_le.MINT_ASSET_ID_LOCAL dropw
    # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(6)]

    # save the asset value for the status key and the asset creation
    loc_storew_le.ASSET_VALUE_LOCAL
    # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(6)]

    # run the active mint policy over the asset value
    exec.policy_manager::execute_mint_policy
    # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(6)]

    # assert the policy did not modify the asset value: for an NFT the value must remain exactly
    padw loc_loadw_le.ASSET_VALUE_LOCAL
    # => [ORIG_ASSET_VALUE, ASSET_VALUE, tag, note_type, RECIPIENT, pad(6)]

    assert_eqw.err=ERR_NFT_MINT_POLICY_MODIFIED_ASSET_VALUE
    # => [tag, note_type, RECIPIENT, pad(10)]

    # build the status key from the token ID (asset value elements 0 and 1)
    padw loc_loadw_le.ASSET_VALUE_LOCAL
    # => [ASSET_VALUE, tag, note_type, RECIPIENT, pad(10)]

    exec.non_fungible_asset::value_into_asset_class
    # => [token_id_suffix, token_id_prefix, tag, note_type, RECIPIENT, pad(10)]

    exec.create_status_key
    # => [STATUS_KEY, tag, note_type, RECIPIENT, pad(10)]

    # build the ISSUED status value and write it, asserting the token ID was not already issued
    push.STATUS_ISSUED exec.build_status_value
    # => [STATUS_VALUE, STATUS_KEY, tag, note_type, RECIPIENT, pad(10)]

    swapw
    # => [STATUS_KEY, STATUS_VALUE, tag, note_type, RECIPIENT, pad(10)]

    push.ASSET_STATUS_SLOT[0..2] exec.native_account::set_map_item
    # => [OLD_STATUS_WORD, tag, note_type, RECIPIENT, pad(10)]

    exec.word::eqz assert.err=ERR_NFT_ALREADY_ISSUED
    # => [tag, note_type, RECIPIENT, pad(10)]

    # create the output note (keep a second note_idx for add_asset)
    exec.output_note::create dup
    # => [note_idx, note_idx, pad(15)]

    # build the asset from the asset value, mint it, add it to the note
    padw loc_loadw_le.ASSET_VALUE_LOCAL
    # => [ASSET_VALUE, note_idx, note_idx, pad(15)]

    exec.active_account::get_id
    # => [id_suffix, id_prefix, ASSET_VALUE, note_idx, note_idx, pad(15)]

    # the asset ID is derived from the value here (composition None, asset class copied from
    # the value's hash0/hash1), so the minted asset is well formed by construction and
    # non_fungible_asset::validate is deliberately skipped
    exec.non_fungible_asset::create
    # => [ASSET_ID, ASSET_VALUE, note_idx, note_idx, pad(15)]

    # bind the mint to the faucet the MINT note was created for
    padw loc_loadw_le.MINT_ASSET_ID_LOCAL dupw.1
    # => [ASSET_ID, NOTE_ASSET_ID, ASSET_ID, ASSET_VALUE, note_idx, note_idx, pad(15)]

    assert_eqw.err=ERR_MINT_NOTE_ASSET_NOT_FROM_THIS_FAUCET
    # => [ASSET_ID, ASSET_VALUE, note_idx, note_idx, pad(15)]

    dupw.1 dupw.1
    # => [ASSET_ID, ASSET_VALUE, ASSET_ID, ASSET_VALUE, note_idx, note_idx, pad(15)]

    exec.faucet::mint
    # => [ASSET_ID, ASSET_VALUE, note_idx, note_idx, pad(15)]

    exec.output_note::add_asset
    # => [note_idx, pad(15)]
end

# =================================================================================================
# RECEIVE AND BURN
# =================================================================================================

#! Burns the non-fungible asset supplied by the caller.
#!
#! Burning removes the asset from circulation and marks the asset's token ID BURNED in the status
#! registry (asserting it was ISSUED). A burned token ID is permanently consumed and can never be
#! issued again.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, pad(8)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the active burn policy validation fails.
#! - the asset was not issued by this faucet.
#! - the asset is not in the issued state.
#!
#! Invocation: call
@account_procedure
pub proc receive_and_burn(asset: Asset)
    # validate the asset to burn is well-formed before processing it
    # note that the asset's origin is validated by the kernel
    exec.non_fungible_asset::validate
    # => [ASSET_ID, ASSET_VALUE, pad(8)]

    # the burn policy consumes the asset, so keep a copy for the burn itself
    dupw.1 dupw.1 exec.policy_manager::execute_burn_policy
    # => [ASSET_ID, ASSET_VALUE, pad(8)]

    # build the status key from the token ID without disturbing [ASSET_ID, ASSET_VALUE]
    dupw.1
    # => [ASSET_VALUE, ASSET_ID, ASSET_VALUE, pad(8)]

    exec.non_fungible_asset::value_into_asset_class
    # => [token_id_suffix, token_id_prefix, ASSET_ID, ASSET_VALUE, pad(8)]

    exec.create_status_key
    # => [STATUS_KEY, ASSET_ID, ASSET_VALUE, pad(8)]

    # write BURNED and assert the token ID was ISSUED (old status element)
    push.STATUS_BURNED exec.build_status_value
    # => [STATUS_VALUE, STATUS_KEY, ASSET_ID, ASSET_VALUE, pad(8)]

    swapw
    # => [STATUS_KEY, STATUS_VALUE, ASSET_ID, ASSET_VALUE, pad(8)]

    push.ASSET_STATUS_SLOT[0..2] exec.native_account::set_map_item
    # => [OLD_STATUS_WORD, ASSET_ID, ASSET_VALUE, pad(8)]

    movdn.3 drop drop drop
    # => [old_status, ASSET_ID, ASSET_VALUE, pad(8)]

    eq.STATUS_ISSUED assert.err=ERR_NFT_NOT_ISSUED
    # => [ASSET_ID, ASSET_VALUE, pad(8)]

    # burn the asset (validates faucet origin), consuming [ASSET_ID, ASSET_VALUE]
    exec.faucet::burn
    # => [pad(16)]
end
