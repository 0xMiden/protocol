# miden::standards::faucets::restrictions::blocklist
#
# Per-faucet blocklist storage and `Invocation: exec` helper procedures. `block_user` and
# `unblock_user` perform NO authorization — they are low-level building blocks intended to be
# called by `Invocation: call` wrapper procedures inside auth-checking account components
# (e.g. Ownable2Step- or RBAC-gated wrappers).
#
# Tx scripts cannot invoke these procedures directly — they must go through a wrapper that is
# installed on the faucet as an account component.
#
# Asset-callback enforcement of "native account is not blocked" lives in the
# `if_not_blocklisted` transfer policy procedure (see
# `miden::standards::faucets::policies::transfer::if_not_blocklisted`). The policy manager owns
# the asset callbacks and dispatches to that procedure via `dynexec`.

use miden::core::word
use miden::protocol::active_account
use miden::protocol::native_account

# CONSTANTS
# ================================================================================================

# The slot where the per-faucet map of blocked users is stored.
# Map entries: [0, 0, account_id_suffix, account_id_prefix] => [is_blocked, 0, 0, 0]
const BLOCKED_USERS_SLOT = word("miden::standards::faucets::restrictions::blocklist::blocked_users")

const BLOCKED_WORD = [1, 0, 0, 0]

const UNBLOCKED_WORD = [0, 0, 0, 0]

# ERRORS
# ================================================================================================

const ERR_USER_IS_BLOCKED = "user is blocked"

const ERR_USER_ALREADY_BLOCKED = "user is already blocked"

const ERR_USER_NOT_BLOCKED = "user is not blocked"

# PUBLIC INTERFACE
# ================================================================================================

#! Returns whether the given user is currently blocked on this faucet.
#!
#! Reads [`BLOCKED_USERS_SLOT`] on the active account at the key derived from the account ID.
#! Returns `1` if the stored word is non-zero (blocked) or `0` if it is the zero word
#! (not blocked, including the default for never-set entries).
#!
#! Inputs:  [account_id_suffix, account_id_prefix]
#! Outputs: [is_blocked]
#!
#! Invocation: exec
pub proc is_blocked
    exec.build_blocked_users_map_key
    # => [KEY]

    push.BLOCKED_USERS_SLOT[0..2]
    # => [slot_suffix, slot_prefix, KEY]

    exec.active_account::get_map_item
    # => [VALUE]

    exec.word::eqz not
    # => [is_blocked]
end

#! Adds the given user to the blocklist. Fails if it is already blocked.
#!
#! This procedure performs NO authorization. Wrappers running in `Invocation: call` mode add
#! the auth check (e.g. `ownable2step::assert_sender_is_owner`) before delegating here via
#! `exec.blocklist::block_user`. Tx scripts cannot invoke this procedure directly — they go
#! through the wrapper component installed on the faucet.
#!
#! Inputs:  [account_id_suffix, account_id_prefix]
#! Outputs: []
#!
#! Panics if:
#! - the user is already blocked.
#!
#! Invocation: exec
pub proc block_user
    # copy the ID to check it is not already blocked.
    dup.1 dup.1
    # => [account_id_suffix, account_id_prefix, account_id_suffix, account_id_prefix]

    exec.is_blocked
    # => [is_blocked, account_id_suffix, account_id_prefix]

    not assert.err=ERR_USER_ALREADY_BLOCKED
    # => [account_id_suffix, account_id_prefix]

    exec.build_blocked_users_map_key
    # => [KEY]

    push.BLOCKED_USERS_SLOT[0..2]
    # => [slot_suffix, slot_prefix, KEY]

    push.BLOCKED_WORD
    # => [BLOCKED_WORD, slot_suffix, slot_prefix, KEY]

    # set_map_item expects: [slot_suffix, slot_prefix, KEY, VALUE]
    movdnw.2
    # => [slot_suffix, slot_prefix, KEY, BLOCKED_WORD]

    exec.native_account::set_map_item
    # => [OLD_VALUE]

    dropw
    # => []
end

#! Removes the given user from the blocklist. Fails if it is not currently blocked. See
#! [`block_user`] for the same authorization caveats.
#!
#! Inputs:  [account_id_suffix, account_id_prefix]
#! Outputs: []
#!
#! Panics if:
#! - the user is not currently blocked.
#!
#! Invocation: exec
pub proc unblock_user
    # copy the ID to check it is currently blocked.
    dup.1 dup.1
    # => [account_id_suffix, account_id_prefix, account_id_suffix, account_id_prefix]

    exec.is_blocked
    # => [is_blocked, account_id_suffix, account_id_prefix]

    assert.err=ERR_USER_NOT_BLOCKED
    # => [account_id_suffix, account_id_prefix]

    exec.build_blocked_users_map_key
    # => [KEY]

    push.BLOCKED_USERS_SLOT[0..2]
    # => [slot_suffix, slot_prefix, KEY]

    push.UNBLOCKED_WORD
    # => [UNBLOCKED_WORD, slot_suffix, slot_prefix, KEY]

    movdnw.2
    # => [slot_suffix, slot_prefix, KEY, UNBLOCKED_WORD]

    exec.native_account::set_map_item
    # => [OLD_VALUE]

    dropw
    # => []
end

#! Requires the given user to not be blocked.
#!
#! Delegates to [`is_blocked`] and inverts the result. If the user is blocked, panics
#! with [`ERR_USER_IS_BLOCKED`].
#!
#! Use from other modules or transaction scripts to guard logic that must not run for blocked
#! users. In asset callback foreign context, the active account is the issuing faucet.
#!
#! Inputs:  [account_id_suffix, account_id_prefix]
#! Outputs: []
#!
#! Panics if:
#! - the stored entry for this user is not the zero word.
#!
#! Invocation: exec
pub proc assert_not_blocked
    exec.is_blocked
    # => [is_blocked]

    not
    # => [is_not_blocked]

    assert.err=ERR_USER_IS_BLOCKED
    # => []
end

# HELPER PROCEDURES
# ================================================================================================

#! Builds the blocked-users map key for the given account ID.
#!
#! Inputs:  [account_id_suffix, account_id_prefix]
#! Outputs: [KEY]
#!
#! Where:
#! - KEY is [0, 0, account_id_suffix, account_id_prefix].
#!
#! Invocation: exec
proc build_blocked_users_map_key
    # => [account_id_suffix, account_id_prefix]

    push.0.0
    # => [0, 0, account_id_suffix, account_id_prefix] = KEY
end
