# miden::standards::utils::pausable::owner_controlled
#
# Owner-gated wrapper around `pausable::pause` / `pausable::unpause` / `pausable::is_paused`.
# Each public procedure asserts that the note sender is the current Ownable2Step owner before
# delegating to the pause primitive in `miden::standards::utils::pausable`.
#
# The wrapper is `Invocation: call`, so transaction scripts target it directly. Internally it
# composes `ownable2step::assert_sender_is_owner` via `exec.` to add the auth check before the
# stack-neutral pause primitive runs.

use miden::standards::access::ownable2step
use miden::standards::utils::pausable

# PUBLIC INTERFACE
# ================================================================================================

#! Pause the account, gated by the Ownable2Step owner.
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note sender is not the account owner.
#! - the account is already paused.
#!
#! Invocation: call
pub proc pause
    exec.ownable2step::assert_sender_is_owner
    # => [pad(16)]

    exec.pausable::pause
    # => [pad(16)]
end

#! Unpause the account, gated by the Ownable2Step owner.
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note sender is not the account owner.
#! - the account is not paused.
#!
#! Invocation: call
pub proc unpause
    exec.ownable2step::assert_sender_is_owner
    # => [pad(16)]

    exec.pausable::unpause
    # => [pad(16)]
end

#! Returns whether the account is currently paused. No authorization is required.
#!
#! Inputs:  [pad(16)]
#! Outputs: [is_paused, pad(15)]
#!
#! Invocation: call
pub proc is_paused
    exec.pausable::is_paused
    # => [is_paused, pad(15)]
end
