# miden::standards::utils::pausable::role_controlled
#
# Role-gated wrapper around `pausable::pause` / `pausable::unpause` / `pausable::is_paused`.
# Pause and unpause are gated by separate roles (`PAUSER` and `UNPAUSER`) in
# RoleBasedAccessControl, enabling separation of duties between the parties that can pause
# and those that can unpause.
#
# Role symbols are not hard-coded in MASM literals. They are encoded by the Rust component
# at install time using the canonical `RoleSymbol` encoder and stored in this component's
# storage slot. MASM then reads them from storage and passes them to RBAC. This keeps a
# single Rust source-of-truth for the role identifiers and avoids drift between the MASM
# literal encoding and the Rust encoding.
#
# Storage layout (single named word):
#     [pauser_role, unpauser_role, 0, 0]
# Where pauser_role and unpauser_role are encoded `RoleSymbol` felts (e.g. "PAUSER" /
# "UNPAUSER" packed into a single felt by the protocol's role-symbol encoder).

use miden::standards::access::rbac
use miden::standards::utils::pausable
use miden::protocol::active_account

# CONSTANTS
# ================================================================================================

# Named storage slot holding the role-symbols word.
const ROLES_SLOT = word("miden::standards::components::utils::pausable::role_controlled::roles")

# PUBLIC INTERFACE
# ================================================================================================

#! Pause the account, gated by the `PAUSER` role configured at install.
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note sender does not hold the `PAUSER` role.
#! - the configured pauser role is zero (`ERR_ROLE_SYMBOL_ZERO` from rbac).
#! - the account is already paused (`ERR_PAUSABLE_ENFORCED_PAUSE`).
#!
#! Invocation: call
pub proc pause
    push.ROLES_SLOT[0..2]
    exec.active_account::get_item
    # => [pauser_role, unpauser_role, 0, 0, pad(16)]

    # Keep only `pauser_role` on top; drop the rest of the roles word.
    movdn.3 drop drop drop
    # => [pauser_role, pad(16)]

    exec.rbac::assert_sender_has_role
    # => [pad(16)]

    exec.pausable::pause
    # => [pad(16)]
end

#! Unpause the account, gated by the `UNPAUSER` role configured at install.
#!
#! Inputs:  [pad(16)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note sender does not hold the `UNPAUSER` role.
#! - the configured unpauser role is zero (`ERR_ROLE_SYMBOL_ZERO` from rbac).
#! - the account is not paused (`ERR_PAUSABLE_EXPECTED_PAUSE`).
#!
#! Invocation: call
pub proc unpause
    push.ROLES_SLOT[0..2]
    exec.active_account::get_item
    # => [pauser_role, unpauser_role, 0, 0, pad(16)]

    # Keep only `unpauser_role` on top; drop pauser_role and the trailing zeros.
    swap movdn.3 drop drop drop
    # => [unpauser_role, pad(16)]

    exec.rbac::assert_sender_has_role
    # => [pad(16)]

    exec.pausable::unpause
    # => [pad(16)]
end

#! Returns whether the account is currently paused. No authorization is required.
#!
#! Inputs:  [pad(16)]
#! Outputs: [is_paused, pad(15)]
#!
#! Invocation: call
pub proc is_paused
    exec.pausable::is_paused
    # => [is_paused, pad(15)]
end
