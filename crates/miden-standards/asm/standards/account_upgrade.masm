# miden::standards::account_upgrade
#
# Account upgrade manager. Exposes `upgrade` as an `Invocation: call` procedure gated by the
# account-wide `Authority` component.
#
# Companion component required on the account:
# - `Authority` — provides the auth dispatch the body calls into.

use miden::standards::access::authority
use miden::protocol::native_account

pub type NewCodeCommitment = word
pub type StorageUpgradeCommitment = word

# PUBLIC INTERFACE
# =================================================================================================

#! Initializes an upgrade of the account's code, gated by the account-wide `Authority` component.
#!
#! See the protocol `native_account::upgrade` procedure for how the upgrade is applied.
#!
#! Inputs:  [NEW_CODE_COMMITMENT, STORAGE_UPGRADE_COMMITMENT, pad(8)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - NEW_CODE_COMMITMENT is the commitment to the new account code.
#! - STORAGE_UPGRADE_COMMITMENT is reserved for storage upgrades and must be empty.
#!
#! Panics if:
#! - the caller is not authorized per the installed `Authority` component.
#! - the invocation does not originate from the native account.
#! - the protocol `native_account::upgrade` procedure panics.
#!
#! Invocation: call
@account_procedure
pub proc upgrade(
    new_code_commitment: NewCodeCommitment,
    storage_upgrade_commitment: StorageUpgradeCommitment
)
    exec.authority::assert_authorized
    # => [NEW_CODE_COMMITMENT, STORAGE_UPGRADE_COMMITMENT, pad(8)]

    exec.native_account::upgrade
    # => [pad(16)]
end
