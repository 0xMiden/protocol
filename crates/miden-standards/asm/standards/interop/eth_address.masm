use miden::standards::utils
use miden::protocol::account_id

# TYPE ALIASES
# =================================================================================================

pub type EthereumAddressFormat = struct { a: felt, b: felt, c: felt, d: felt, e: felt }

# ERRORS
# =================================================================================================

const ERR_NOT_U32="address limb is not u32"
const ERR_MSB_NONZERO="most-significant 4 bytes must be zero for AccountId"

# PUBLIC INTERFACE
# =================================================================================================

#! Converts an Ethereum address format (address[5] type) back into an AccountId [prefix, suffix] type.
#!
#! The Ethereum address format is represented as 5 u32 limbs (20 bytes total) in *big-endian limb order*
#! (matching Solidity ABI encoding). Each limb encodes its 4 bytes in little-endian order:
#!   limb0 = bytes[0..4]   (most-significant 4 bytes, must be zero for AccountId)
#!   limb1 = bytes[4..8]
#!   limb2 = bytes[8..12]
#!   limb3 = bytes[12..16]
#!   limb4 = bytes[16..20] (least-significant 4 bytes)
#!
#! The most-significant 4 bytes must be zero for a valid AccountId conversion (be0 == 0).
#! The remaining 16 bytes are treated as two 8-byte words (conceptual u64 values):
#!   prefix = (bswap(limb1) << 32) | bswap(limb2)   # bytes[4..12]
#!   suffix = (bswap(limb3) << 32) | bswap(limb4)   # bytes[12..20]
#!
#! These 8-byte words are packed into field elements via build_felt.
#!
#! The decoded (suffix, prefix) is validated as a structurally valid AccountId. The ID version is
#! not constrained, so a destination carrying a structurally valid but currently unsupported
#! version is accepted and routes to an output that remains unspendable until that version is
#! supported.
#!
#! Inputs:  [limb0, limb1, limb2, limb3, limb4]
#! Outputs: [suffix, prefix]
#!
#! Panics if:
#! - the most-significant 4 bytes (limb0) are non-zero.
#! - any limb is not a valid u32, or a packed 8-byte word does not fit in the field.
#! - the decoded (suffix, prefix) is not a structurally valid AccountId.
#!
#! Invocation: exec
pub proc to_account_id
    # limb0 must be 0 (most-significant limb, on top)
    assertz.err=ERR_MSB_NONZERO
    # => [limb1, limb2, limb3, limb4]

    # Reorder for suffix = build_felt(limb4, limb3) where limb4=lo, limb3=hi
    movup.2 movup.3
    # => [limb4, limb3, limb1, limb2]

    exec.build_felt
    # => [suffix, limb1, limb2]

    # Reorder for prefix = build_felt(limb2, limb1) where limb2=lo, limb1=hi
    swap movup.2
    # => [limb2, limb1, suffix]

    exec.build_felt
    # => [prefix, suffix]

    swap
    # => [suffix, prefix]

    # Validate the decoded id is a structurally valid AccountId.
    dup.1 dup.1
    # => [suffix, prefix, suffix, prefix]

    exec.account_id::validate_structure
    # => [suffix, prefix]
end

# HELPER PROCEDURES
# =================================================================================================

#! Builds a single felt from two u32 limbs (little-endian limb order, little-endian bytes).
#!
#! The limbs are byte-swapped to big-endian numeric order and merged via
#! utils::merge_u32_limbs, which verifies the merged value was not reduced mod p.
#!
#! Inputs:  [lo, hi]
#! Outputs: [felt]
proc build_felt
    # --- validate u32 limbs ---
    u32assert2.err=ERR_NOT_U32
    # => [lo_be, hi_be]

    # limbs are little-endian bytes; swap to big-endian for building account ID
    exec.utils::swap_u32_bytes
    swap
    exec.utils::swap_u32_bytes
    swap
    # => [lo, hi]

    exec.utils::merge_u32_limbs
    # => [felt]
end
