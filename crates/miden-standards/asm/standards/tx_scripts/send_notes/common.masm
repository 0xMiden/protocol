# Shared payload handling for the canonical `send_notes` transaction scripts.
#
# This module is private to `send_notes`: it is the shared implementation behind the
# [`send_notes::wallet`], [`send_notes::fungible_faucet`] and [`send_notes::non_fungible_faucet`]
# scripts, and is not part of the standards library's public surface.
#
# The `send_notes` scripts receive a commitment to their parameters as `TX_SCRIPT_ARGS` and load
# the actual parameters (the payload) from the advice map, so a single script root covers every
# possible set of output notes.
#
# The payload is a word-aligned element stream with the following layout:
#
#   word 0 (header):            [num_notes, expiration_delta, 0, 0]
#   per note record:
#     word 0:                   RECIPIENT
#     word 1:                   [tag, note_type, num_assets, num_attachments]
#     num_assets * 2 words:     ASSET_ID, ASSET_VALUE
#     num_attachments * 2 words: [attachment_scheme, 0, 0, 0], ATTACHMENT_COMMITMENT
#
# An `expiration_delta` of 0 means the transaction's expiration delta is left unchanged.

use miden::core::mem
use miden::protocol::output_note
use miden::protocol::tx

# CONSTANTS
# =================================================================================================

# The number of field elements in a word. Replace with
# `miden::protocol::constants::WORD_NUM_ELEMENTS`, once
# https://github.com/0xMiden/miden-vm/issues/3429 is fixed.
pub const WORD_NUM_ELEMENTS = 4

# Memory addresses of the payload and of the two header elements it starts with.
const PAYLOAD_ADDR = 0
pub const NUM_NOTES_ADDR = PAYLOAD_ADDR
const EXPIRATION_DELTA_ADDR = PAYLOAD_ADDR + 1

# Memory address of the first note record, which starts right after the header word.
pub const NOTES_START_ADDR = PAYLOAD_ADDR + WORD_NUM_ELEMENTS

# Element offsets of the fields in a note record's second word, relative to the record start.
pub const TAG_OFFSET = WORD_NUM_ELEMENTS
pub const NOTE_TYPE_OFFSET = TAG_OFFSET + 1
pub const NUM_ASSETS_OFFSET = TAG_OFFSET + 2
pub const NUM_ATTACHMENTS_OFFSET = TAG_OFFSET + 3

# Element offset of the first asset or attachment item within a note record, and the number of
# elements a single such item occupies (two words).
pub const ITEMS_OFFSET = NUM_ATTACHMENTS_OFFSET + 1
pub const ITEM_NUM_ELEMENTS = WORD_NUM_ELEMENTS + WORD_NUM_ELEMENTS

# load_payload locals
const LOAD_PAYLOAD_NUM_WORDS_LOC = 0

# validate_note_records locals
const VALIDATE_RECORDS_READ_PTR_LOC = 0

# add_attachments locals
const ADD_ATTACHMENTS_NOTE_IDX_LOC = 0
const ADD_ATTACHMENTS_READ_PTR_LOC = 1

# ERRORS
# =================================================================================================

const ERR_SEND_NOTES_PAYLOAD_LENGTH_INVALID = "send notes payload length advice input is not a valid u32"

const ERR_SEND_NOTES_PAYLOAD_NOT_WORD_ALIGNED = "send notes payload length is not a multiple of the word size"

const ERR_SEND_NOTES_PAYLOAD_EMPTY = "send notes payload must not be empty"

const ERR_SEND_NOTES_NUM_NOTES_INVALID = "send notes payload note count is not a valid u32"

const ERR_SEND_NOTES_NUM_ASSETS_INVALID = "send notes payload asset count is not a valid u32"

const ERR_SEND_NOTES_NUM_ATTACHMENTS_INVALID = "send notes payload attachment count is not a valid u32"

const ERR_SEND_NOTES_RECORD_END_INVALID = "send notes payload note record extends past the payload"

const ERR_SEND_NOTES_RECORDS_LENGTH_MISMATCH = "send notes payload note records do not exactly fill the payload"

# PUBLIC INTERFACE
# =================================================================================================

#! Loads the payload committed to by the transaction script argument from the advice map into
#! memory at `PAYLOAD_ADDR` and sets the transaction expiration delta if requested.
#!
#! Inputs:
#!   Operand stack: [PAYLOAD_COMMITMENT, pad(12)]
#!   Advice map: {
#!     PAYLOAD_COMMITMENT: [[payload]]
#!   }
#! Outputs:
#!   Operand stack: [pad(16)]
#!
#! Where:
#! - PAYLOAD_COMMITMENT is the sequential hash of the payload elements.
#! - payload is the element stream described in the file header.
#!
#! Panics if:
#! - the advice map has no entry for PAYLOAD_COMMITMENT.
#! - the payload length is not a non-zero multiple of the word size.
#! - the payload does not hash to PAYLOAD_COMMITMENT.
#! - any note count in the payload is not a valid u32.
#! - the note records do not exactly fill the payload.
#! - the expiration delta is non-zero and not in the range 1..=0xFFFF.
#!
#! Locals:
#! 0: number of words in the payload
#!
#! Invocation: exec
@locals(1)
pub proc load_payload(payload_commitment: word)
    # push the payload from the advice map onto the advice stack, together with its length
    adv.push_mapvaln
    # OS => [PAYLOAD_COMMITMENT, pad(12)]
    # AS => [num_elements, [payload]]

    # SAFETY: if the provided num_elements is invalid, the commitment check would fail in
    # pipe_preimage_to_memory so we assume validity and only do basic checks to protect against
    # invalid advice inputs.
    adv_push u32assert.err=ERR_SEND_NOTES_PAYLOAD_LENGTH_INVALID
    # OS => [num_elements, PAYLOAD_COMMITMENT, pad(12)]
    # AS => [[payload]]

    u32divmod.WORD_NUM_ELEMENTS
    # => [remainder, num_words, PAYLOAD_COMMITMENT, pad(12)]

    eq.0 assert.err=ERR_SEND_NOTES_PAYLOAD_NOT_WORD_ALIGNED
    # => [num_words, PAYLOAD_COMMITMENT, pad(12)]

    dup neq.0 assert.err=ERR_SEND_NOTES_PAYLOAD_EMPTY
    # => [num_words, PAYLOAD_COMMITMENT, pad(12)]

    # keep the length around to bound the note records against it once the payload is in memory
    dup loc_store.LOAD_PAYLOAD_NUM_WORDS_LOC
    # => [num_words, PAYLOAD_COMMITMENT, pad(12)]

    # pipe the payload to memory and validate it matches the PAYLOAD_COMMITMENT
    push.PAYLOAD_ADDR swap
    # => [num_words, write_ptr, PAYLOAD_COMMITMENT, pad(12)]

    exec.mem::pipe_preimage_to_memory drop
    # => [pad(16)]

    # check the note records line up with the payload length before any consumer walks them
    loc_load.LOAD_PAYLOAD_NUM_WORDS_LOC mul.WORD_NUM_ELEMENTS
    # => [num_elements, pad(16)]

    exec.validate_note_records
    # => [pad(16)]

    # set the transaction expiration delta if one was provided
    mem_load.EXPIRATION_DELTA_ADDR
    # => [expiration_delta, pad(15)]

    dup neq.0
    if.true
        exec.tx::update_expiration_block_delta
    else
        drop
    end
    # => [pad(16)]
end

#! Adds the `num_attachments` attachments starting at `attachments_ptr` to the output note at
#! `note_idx`, and returns the element right after the last attachment.
#!
#! Every `send_notes` script shares this loop; the returned pointer is where the next note record
#! begins, since attachments are the last items in a record.
#!
#! Inputs:
#!   Operand stack: [note_idx, attachments_ptr, num_attachments]
#!   Advice map: {
#!     ATTACHMENT_COMMITMENT: [[ATTACHMENT_ELEMENTS]] for every attachment added
#!   }
#! Outputs:
#!   Operand stack: [end_ptr]
#!
#! Where:
#! - note_idx is the index of the output note to add the attachments to.
#! - attachments_ptr is the address of the first attachment item.
#! - num_attachments is the number of attachment items to add.
#! - end_ptr is `attachments_ptr` advanced past every attachment item.
#!
#! Panics if:
#! - an attachment's elements are missing from the advice map.
#!
#! Locals:
#! 0: index of the output note being added to
#! 1: pointer to the current attachment item
#!
#! Invocation: exec
@locals(2)
pub proc add_attachments(note_idx: u32, attachments_ptr: u32, num_attachments: u32) -> u32
    loc_store.ADD_ATTACHMENTS_NOTE_IDX_LOC
    # => [attachments_ptr, num_attachments]

    loc_store.ADD_ATTACHMENTS_READ_PTR_LOC
    # => [num_attachments]

    dup neq.0
    while.true
        # => [attachments_left]

        loc_load.ADD_ATTACHMENTS_NOTE_IDX_LOC
        # => [note_idx, attachments_left]

        padw loc_load.ADD_ATTACHMENTS_READ_PTR_LOC add.WORD_NUM_ELEMENTS mem_loadw_le
        # => [ATTACHMENT_COMMITMENT, note_idx, attachments_left]

        loc_load.ADD_ATTACHMENTS_READ_PTR_LOC mem_load
        # => [attachment_scheme, ATTACHMENT_COMMITMENT, note_idx, attachments_left]

        exec.output_note::add_attachment
        # => [attachments_left]

        # advance to the next attachment
        loc_load.ADD_ATTACHMENTS_READ_PTR_LOC add.ITEM_NUM_ELEMENTS
        loc_store.ADD_ATTACHMENTS_READ_PTR_LOC
        # => [attachments_left]

        sub.1 dup neq.0
        # => [attachments_left != 0, attachments_left]
    end
    drop
    # => []

    loc_load.ADD_ATTACHMENTS_READ_PTR_LOC
    # => [end_ptr]
end

# HELPER PROCEDURES
# =================================================================================================

#! Validates that the note records stored at `PAYLOAD_ADDR` exactly fill the `num_elements` the
#! payload claims to hold.
#!
#! Each record's length is implied by its own `num_assets` and `num_attachments`, so walking the
#! records and landing exactly on the end of the payload proves every count is in range. Consumers
#! can therefore drive their loops off those counts without re-validating them or reading past the
#! data that was piped into memory.
#!
#! Inputs:
#!   Operand stack: [num_elements]
#! Outputs:
#!   Operand stack: []
#!
#! Where:
#! - num_elements is the number of elements piped to memory at `PAYLOAD_ADDR`.
#!
#! Panics if:
#! - any note count in the payload is not a valid u32.
#! - a record extends past the end of the payload.
#! - the records end before the end of the payload.
#!
#! Locals:
#! 0: pointer to the current note record
#!
#! Invocation: exec
@locals(1)
proc validate_note_records(num_elements: u32)
    push.NOTES_START_ADDR loc_store.VALIDATE_RECORDS_READ_PTR_LOC
    # => [num_elements]

    mem_load.NUM_NOTES_ADDR u32assert.err=ERR_SEND_NOTES_NUM_NOTES_INVALID
    # => [notes_left, num_elements]

    dup neq.0
    while.true
        # => [notes_left, num_elements]

        loc_load.VALIDATE_RECORDS_READ_PTR_LOC add.NUM_ASSETS_OFFSET mem_load
        u32assert.err=ERR_SEND_NOTES_NUM_ASSETS_INVALID
        # => [num_assets, notes_left, num_elements]

        loc_load.VALIDATE_RECORDS_READ_PTR_LOC add.NUM_ATTACHMENTS_OFFSET mem_load
        u32assert.err=ERR_SEND_NOTES_NUM_ATTACHMENTS_INVALID
        # => [num_attachments, num_assets, notes_left, num_elements]

        # record length = ITEMS_OFFSET + (num_assets + num_attachments) * ITEM_NUM_ELEMENTS
        add mul.ITEM_NUM_ELEMENTS add.ITEMS_OFFSET
        # => [record_num_elements, notes_left, num_elements]

        # advance past this record, keeping the pointer a u32 so the walk cannot wrap around
        loc_load.VALIDATE_RECORDS_READ_PTR_LOC add
        u32assert.err=ERR_SEND_NOTES_RECORD_END_INVALID
        loc_store.VALIDATE_RECORDS_READ_PTR_LOC
        # => [notes_left, num_elements]

        sub.1 dup neq.0
        # => [notes_left != 0, notes_left, num_elements]
    end
    drop
    # => [num_elements]

    # the last record must end exactly at the end of the payload
    push.PAYLOAD_ADDR add
    # => [payload_end, ]

    loc_load.VALIDATE_RECORDS_READ_PTR_LOC
    # => [read_ptr, payload_end]

    eq assert.err=ERR_SEND_NOTES_RECORDS_LENGTH_MISMATCH
    # => []
end
