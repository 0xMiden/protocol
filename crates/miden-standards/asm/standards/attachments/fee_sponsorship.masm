#! miden::standards::attachments::fee_sponsorship
#!
#! Binds a fee sponsorship note to the feature note it pays for.
#!
#! The attachment carries a single word: the note ID of the bound feature note. The binding lives on
#! an attachment rather than in note storage because the kernel exposes no indexed accessor for an
#! input note's storage items, only its storage commitment. Attachments are readable by index, which
#! is what lets a network account's auth procedure inspect the sponsorship on every input note.

use miden::protocol::active_note
use miden::protocol::input_note

# CONSTANTS
# ================================================================================================

#! The attachment scheme for FeeSponsorship attachments.
const FEE_SPONSORSHIP_ATTACHMENT_SCHEME = 4

#! The number of words in the fee sponsorship attachment.
const FEE_SPONSORSHIP_ATTACHMENT_NUM_WORDS = 1

# ERRORS
# ================================================================================================

const ERR_FEE_SPONSORSHIP_MISSING = "fee sponsorship attachment is not present on the note"

const ERR_FEE_SPONSORSHIP_INCORRECT_NUMBER_OF_WORDS = "fee sponsorship attachment must consist of exactly one word"

# PROCEDURES
# ================================================================================================

#! Creates a new attachment of type FeeSponsorship binding the sponsorship to the feature note with
#! the provided ID.
#!
#! Inputs:  [FEATURE_NOTE_ID]
#! Outputs: [attachment_scheme, NOTE_ATTACHMENT]
#!
#! Where:
#! - FEATURE_NOTE_ID is the ID of the feature note this sponsorship pays for.
#! - attachment_scheme is the attachment scheme for use with `output_note::add_word_attachment`.
#!
#! Invocation: exec
pub proc new
    # => [FEATURE_NOTE_ID]
    push.FEE_SPONSORSHIP_ATTACHMENT_SCHEME
    # => [attachment_scheme, NOTE_ATTACHMENT]
end

#! Returns the feature note ID bound by the active note's fee sponsorship attachment.
#!
#! Inputs:  []
#! Outputs: [FEATURE_NOTE_ID]
#!
#! Where:
#! - FEATURE_NOTE_ID is the ID of the feature note the active note sponsors.
#!
#! Panics if:
#! - no note is currently active.
#! - the attachment is missing from the active note or the number of words is invalid.
#!
#! Invocation: exec
@locals(4)
pub proc active_note_bound_note_id
    # find the fee sponsorship attachment, if any
    # if there are multiple, we consider the first one the canonical one
    push.FEE_SPONSORSHIP_ATTACHMENT_SCHEME
    exec.active_note::find_attachment
    # => [is_found, attachment_idx]

    assert.err=ERR_FEE_SPONSORSHIP_MISSING
    # => [attachment_idx]

    # write the attachment data to local memory
    # we allocate one word of local memory matching FEE_SPONSORSHIP_ATTACHMENT_NUM_WORDS
    locaddr.0
    # => [dest_ptr, attachment_idx]

    exec.active_note::write_attachment_to_memory
    # => [num_words]

    eq.FEE_SPONSORSHIP_ATTACHMENT_NUM_WORDS
    assert.err=ERR_FEE_SPONSORSHIP_INCORRECT_NUMBER_OF_WORDS
    # => []

    padw loc_loadw_le.0
    # => [FEATURE_NOTE_ID]
end

#! Returns the feature note ID bound by the fee sponsorship attachment of the input note at the
#! provided index.
#!
#! Inputs:  [note_index]
#! Outputs: [FEATURE_NOTE_ID]
#!
#! Where:
#! - note_index is the index of the input note whose sponsorship binding should be read.
#! - FEATURE_NOTE_ID is the ID of the feature note that input note sponsors.
#!
#! Panics if:
#! - the note index is greater or equal to the total number of input notes.
#! - the attachment is missing from the note or the number of words is invalid.
#!
#! Invocation: exec
@locals(8)
pub proc input_note_bound_note_id
    # => [note_index]
    dup loc_store.4
    # => [note_index]

    push.FEE_SPONSORSHIP_ATTACHMENT_SCHEME
    # => [attachment_scheme, note_index]

    exec.input_note::find_attachment
    # => [is_found, attachment_idx]

    assert.err=ERR_FEE_SPONSORSHIP_MISSING
    # => [attachment_idx]

    loc_load.4 swap locaddr.0
    # => [dest_ptr, attachment_idx, note_index]

    exec.input_note::write_attachment_to_memory
    # => [num_words]

    eq.FEE_SPONSORSHIP_ATTACHMENT_NUM_WORDS
    assert.err=ERR_FEE_SPONSORSHIP_INCORRECT_NUMBER_OF_WORDS
    # => []

    padw loc_loadw_le.0
    # => [FEATURE_NOTE_ID]
end
