#! miden::standards::attachments::network_account_target
#!
#! Provides a standardized way to work with network account targets.

use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::tx
use {DEFAULT_EXPIRATION_BLOCK_DELTA} from miden::standards::expiration

# CONSTANTS
# ================================================================================================

#! The attachment scheme for NetworkAccountTarget attachments.
#! This is a valid u32 that can be compared against an extracted attachment scheme.
pub const NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME = 2

#! The number of words in the network account target attachment.
pub const NETWORK_ACCOUNT_TARGET_ATTACHMENT_NUM_WORDS = 1

#! The expiration block number that marks an attachment as never expiring.
pub const NETWORK_ACCOUNT_TARGET_NO_EXPIRATION = 0

# ERRORS
# ================================================================================================

const ERR_NETWORK_ACCOUNT_TARGET_MISSING = "network account target attachment is not present on active note"

const ERR_NETWORK_ACCOUNT_TARGET_INCORRECT_NUMBER_OF_WORDS = "network account target attachment must consist of exactly one word"

const ERR_NETWORK_ACCOUNT_TARGET_EXPIRATION_BLOCK_NUM_NOT_U32 = "network account target attachment expiration block number is not a u32"

const ERR_NETWORK_ACCOUNT_TARGET_EXPIRED = "network account target attachment expiration block number has passed"

# PROCEDURES
# ================================================================================================

#! Returns a boolean indicating whether the attachment scheme matches the expected
#! scheme for a NetworkAccountTarget attachment.
#!
#! Inputs:  [attachment_scheme]
#! Outputs: [is_network_account_target]
#!
#! Invocation: exec
pub proc is_network_account_target
    eq.NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME
    # => [is_network_account_target]
end

#! Returns the account ID encoded in the attachment.
#!
#! The attachment is expected to have the following layout:
#! [account_id_suffix, account_id_prefix, exec_hint_tag, expiration_block_num]
#!
#! WARNING: This procedure does not validate the attachment scheme. The caller
#! should validate it using `is_network_account_target` before calling this procedure.
#!
#! WARNING: This procedure does not validate that the returned account ID is well-formed.
#! The caller should validate the account ID if needed using `account_id::validate`.
#!
#! Inputs:  [NETWORK_ACCOUNT_TARGET_ATTACHMENT]
#! Outputs: [account_id_suffix, account_id_prefix]
#!
#! Where:
#! - account_id_{suffix,prefix} are the suffix and prefix felts of an account ID.
#!
#! Invocation: exec
pub proc into_target_id
    # => [NETWORK_ACCOUNT_TARGET_ATTACHMENT]
    # => [account_id_suffix, account_id_prefix, exec_hint_tag, expiration_block_num]

    movup.2 drop movup.2 drop
    # => [account_id_suffix, account_id_prefix]
end

#! Returns the expiration block number encoded in the attachment.
#!
#! Inputs:  [NETWORK_ACCOUNT_TARGET_ATTACHMENT]
#! Outputs: [expiration_block_num]
#!
#! Where:
#! - expiration_block_num is the last block at which the note may be included into the chain, or
#!   [`NETWORK_ACCOUNT_TARGET_NO_EXPIRATION`] if the note never expires.
#!
#! Invocation: exec
pub proc into_expiration_block_num
    # => [NETWORK_ACCOUNT_TARGET_ATTACHMENT]
    # => [account_id_suffix, account_id_prefix, exec_hint_tag, expiration_block_num]

    drop drop drop
    # => [expiration_block_num]
end

#! Creates a new attachment of type NetworkAccountTarget with the following layout:
#! [account_id_suffix, account_id_prefix, exec_hint_tag, NETWORK_ACCOUNT_TARGET_NO_EXPIRATION]
#!
#! The created attachment never expires. A note that should expire must build its attachment with
#! an expiration block number in the fourth felt; see [`assert_not_expired`].
#!
#! Inputs:  [account_id_suffix, account_id_prefix, exec_hint_tag]
#! Outputs: [attachment_scheme, NOTE_ATTACHMENT]
#!
#! Where:
#! - account_id_{suffix,prefix} are the suffix and prefix felts of an account ID.
#! - exec_hint_tag is the encoded execution hint for the note with its tag.
#! - attachment_scheme is the attachment scheme (1) for use with `output_note::add_word_attachment`.
#!
#! Invocation: exec
pub proc new
    # => [account_id_suffix, account_id_prefix, exec_hint_tag]
    push.NETWORK_ACCOUNT_TARGET_NO_EXPIRATION movdn.3
    # => [NOTE_ATTACHMENT]
    # => [account_id_suffix, account_id_prefix, exec_hint_tag, expiration_block_num]

    push.NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME
    # => [attachment_scheme, NOTE_ATTACHMENT]
end

#! Loads the active note's network account target attachment onto the stack.
#!
#! If there are multiple attachments of the scheme, the first one is considered canonical.
#!
#! Inputs:  []
#! Outputs: [NETWORK_ACCOUNT_TARGET_ATTACHMENT]
#!
#! Panics if:
#! - the attachment is missing from the active note or the number of words is invalid.
#!
#! Invocation: exec
@locals(4)
pub proc load_attachment
    # find the network account target attachment, if any
    push.NETWORK_ACCOUNT_TARGET_ATTACHMENT_SCHEME
    exec.active_note::find_attachment
    # => [is_found, attachment_idx]

    # network account target attachment must be present
    assert.err=ERR_NETWORK_ACCOUNT_TARGET_MISSING
    # => [attachment_idx]

    # write the attachment data to local memory
    # we allocate one word of local memory matching NETWORK_ACCOUNT_TARGET_ATTACHMENT_NUM_WORDS
    locaddr.0
    # => [dest_ptr, attachment_idx]

    exec.active_note::write_attachment_to_memory
    # => [num_words]

    eq.NETWORK_ACCOUNT_TARGET_ATTACHMENT_NUM_WORDS
    assert.err=ERR_NETWORK_ACCOUNT_TARGET_INCORRECT_NUMBER_OF_WORDS
    # => []

    padw loc_loadw_le.0
    # => [NETWORK_ACCOUNT_TARGET_ATTACHMENT]
    # => [target_id_suffix, target_id_prefix, exec_hint_tag, expiration_block_num]
end

#! Returns a boolean indicating whether the active account matches the target account
#! encoded in the provided attachment.
#!
#! The attachment is loaded with [`load_attachment`]. Callers that also need the expiration check
#! should load it once and run both checks on a copy of it.
#!
#! Inputs:  [NETWORK_ACCOUNT_TARGET_ATTACHMENT]
#! Outputs: [is_equal]
#!
#! Where:
#! - is_equal is a boolean indicating whether the active account matches the target account.
#!
#! Invocation: exec
pub proc active_account_matches_target_account
    # => [NETWORK_ACCOUNT_TARGET_ATTACHMENT]

    exec.into_target_id
    # => [target_id_suffix, target_id_prefix]

    exec.active_account::get_id
    # => [active_account_id_suffix, active_account_id_prefix, target_id_suffix, target_id_prefix]

    exec.account_id::eq
    # => [is_equal]
end

#! Requires that the active note has not passed the expiration block number encoded in the
#! provided attachment.
#!
#! An attachment carrying [`NETWORK_ACCOUNT_TARGET_NO_EXPIRATION`] never expires and this procedure
#! is a no-op for it.
#!
#! Otherwise the expiration is enforced by requiring the transaction's reference block to lie
#! strictly before the expiration block, so the note can still be consumed anywhere in the window
#! between the two.
#!
#! Proving the transaction within that window is not sufficient on its own, since a transaction can
#! be included into the chain long after its reference block. The procedure therefore also narrows
#! the transaction expiration block delta to the smaller of [`DEFAULT_EXPIRATION_BLOCK_DELTA`] and
#! the blocks left until the expiration block, which keeps the transaction from being included past
#! that block. The delta is deliberately not widened to the note's full remaining lifetime: a wider
#! inclusion window would let the note take effect against a more outdated view of the account, and
#! [`tx::update_expiration_block_delta`] accepts a delta of at most 65535 blocks anyway.
#!
#! The attachment is loaded with [`load_attachment`].
#!
#! Inputs:  [NETWORK_ACCOUNT_TARGET_ATTACHMENT]
#! Outputs: []
#!
#! Panics if:
#! - the encoded expiration block number is not a u32.
#! - the reference block is not strictly before the expiration block.
#!
#! Invocation: exec
pub proc assert_not_expired
    # => [NETWORK_ACCOUNT_TARGET_ATTACHMENT]

    exec.into_expiration_block_num
    # => [expiration_block_num]

    dup eq.NETWORK_ACCOUNT_TARGET_NO_EXPIRATION
    # => [never_expires, expiration_block_num]

    if.true
        drop
        # => []
    else
        u32assert.err=ERR_NETWORK_ACCOUNT_TARGET_EXPIRATION_BLOCK_NUM_NOT_U32
        # => [expiration_block_num]

        exec.tx::get_reference_block_number
        # => [reference_block, expiration_block_num]

        # the reference block must lie strictly before the expiration block, leaving at least one
        # block of inclusion window for the delta below
        dup dup.2 u32lt assert.err=ERR_NETWORK_ACCOUNT_TARGET_EXPIRED
        # => [reference_block, expiration_block_num]

        sub
        # => [blocks_until_expiration]

        # narrow the inclusion window so the transaction cannot be included past the expiration
        # block, bounded from above by the default delta
        push.DEFAULT_EXPIRATION_BLOCK_DELTA u32min
        # => [expiration_block_delta]

        exec.tx::update_expiration_block_delta
        # => []
    end
    # => []
end
